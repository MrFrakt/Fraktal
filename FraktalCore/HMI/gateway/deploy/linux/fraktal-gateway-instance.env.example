# One file per PLC. Install as /etc/fraktal/instances/<instance>.env, owned by
# root and mode 0640 with group fraktal-gateway, then
#   systemctl enable --now fraktal-gateway@<instance>
#
# <instance> is the name the gateway reports on /healthz and in every log line,
# so use the cell or line name the plant already uses.
#
# Credentials and PKI paths stay in the shared /etc/fraktal/fraktal-gateway.env
# unless one PLC needs its own identity, in which case repeat those variables
# here — this file is read second and wins.

# opc.tcp://<host>:4840 (TF6100 / multi-brand) or ads://<AmsNetId>:851.
FRAKTAL_PLC_ENDPOINT=opc.tcp://127.0.0.1:4840

# The loopback port this instance owns. Every instance needs its own, and the
# site reverse proxy publishes each on its own origin — the Web HMI derives its
# WebSocket endpoint from the page origin, so two PLCs cannot share one.
FRAKTAL_GATEWAY_PORT=8080
