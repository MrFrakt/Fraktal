# Install as /etc/fraktal/fraktal-gateway.env, owned by root and mode 0600.
# The application URI must exactly match the URI encoded in the client cert.
FRAKTAL_GATEWAY_APPLICATION_URI=urn:fraktal:gateway:replace-with-stable-device-id
FRAKTAL_GATEWAY_CLIENT_CERTIFICATE=/etc/fraktal/pki/own/certs/fraktal-gateway.der
FRAKTAL_GATEWAY_CLIENT_PRIVATE_KEY=/etc/fraktal/pki/own/private/fraktal-gateway.pem
FRAKTAL_GATEWAY_TRUST_LIST=/etc/fraktal/pki/trusted/certs
# Optional when the private key is encrypted. An ACL-protected unencrypted
# service key is also supported for unattended startup.
FRAKTAL_OPCUA_PRIVATE_KEY_PASSWORD=

# Production uses a dedicated TF6100 account. Do not use an operator's account.
FRAKTAL_OPCUA_USERNAME=fraktal_gateway
FRAKTAL_OPCUA_PASSWORD=replace-me
