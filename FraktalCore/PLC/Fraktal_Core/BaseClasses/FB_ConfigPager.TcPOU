<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_ConfigPager" Id="{d41f78e2-3b06-4c9a-b7d8-9156ea20cf35}" SpecialFunc="None">
    <Declaration><![CDATA[// Core §3.10.2 — windowed writer for the configuration manifest. QUERY_CONFIG
// re-walks the whole export enumeration each request; the pager counts every
// appended entry and stores only the requested page window into the published
// ST_ConfigPage, so no full manifest buffer ever exists in PLC memory and the
// walk order alone defines the paging. Exporters call M_Append*/ignore paging.
FUNCTION_BLOCK FB_ConfigPager
VAR
    {attribute 'OPC.UA.DA' := '0'}
    _pTarget : POINTER TO ST_ConfigPage;
    _cursor  : DINT;   // entries appended so far in this walk
    _first   : DINT;   // first cursor index stored in the window (0-based)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[; // stateless between requests — driven entirely by M_Setup/M_Append/M_Finish]]></ST>
    </Implementation>
    <Method Name="M_Setup" Id="{6a92cd10-84e7-4fb3-a1c9-73805d21be48}">
      <Declaration><![CDATA[// Begin one QUERY_CONFIG walk targeting the published page window.
METHOD M_Setup : BOOL
VAR_INPUT
    Target    : POINTER TO ST_ConfigPage;
    PageIndex : INT;
    Revision  : UDINT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_Setup := FALSE;
IF Target = 0 THEN
    RETURN;
END_IF
_pTarget := Target;
_cursor := 0;
IF PageIndex < 0 THEN
    _first := 0;
ELSE
    _first := TO_DINT(PageIndex) * TO_DINT(PL_Fraktal.MAX_CONFIG_PAGE);
END_IF
_pTarget^.Revision := Revision;
_pTarget^.PageIndex := SEL(PageIndex < 0, PageIndex, 0);
_pTarget^.PageCount := 0;
_pTarget^.EntryCount := 0;
M_Setup := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="M_Append" Id="{c3e5b1f7-2d84-49a0-9c61-08d7a4325e9b}">
      <Declaration><![CDATA[// Append one manifest entry; stored only when it falls inside the page window.
// Always returns TRUE so exporters can chain without branching.
METHOD M_Append : BOOL
VAR_INPUT
    Scope     : STRING(255);
    Item      : STRING(255);
    ValueText : STRING(255);
END_VAR
VAR
    slot : DINT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_Append := TRUE;
IF _pTarget = 0 THEN
    RETURN;
END_IF
slot := _cursor - _first;   // window-relative 0-based position
_cursor := _cursor + 1;
IF (slot < 0) OR (slot >= TO_DINT(PL_Fraktal.MAX_CONFIG_PAGE)) THEN
    RETURN;                 // outside the requested window — counted, not stored
END_IF
_pTarget^.Entries[TO_INT(slot) + 1].Scope := Scope;
_pTarget^.Entries[TO_INT(slot) + 1].Item := Item;
_pTarget^.Entries[TO_INT(slot) + 1].ValueText := ValueText;
_pTarget^.EntryCount := TO_INT(slot) + 1;]]></ST></Implementation>
    </Method>
    <Method Name="M_AppendNumber" Id="{f0b6c823-5a1d-4e97-8b40-1c9ea6d0742f}">
      <Declaration><![CDATA[METHOD M_AppendNumber : BOOL
VAR_INPUT
    Scope  : STRING(255);
    Item   : STRING(255);
    Number : DINT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_AppendNumber := M_Append(Scope := Scope, Item := Item,
    ValueText := TO_STRING(Number));]]></ST></Implementation>
    </Method>
    <Method Name="M_Finish" Id="{92cf5e48-71b3-4da6-a5f2-3e08b19dc271}">
      <Declaration><![CDATA[// Close the walk: publish the total page count for the HMI's fetch loop.
METHOD M_Finish : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[M_Finish := FALSE;
IF _pTarget = 0 THEN
    RETURN;
END_IF
_pTarget^.PageCount := TO_INT(
    (_cursor + TO_DINT(PL_Fraktal.MAX_CONFIG_PAGE) - 1)
    / TO_DINT(PL_Fraktal.MAX_CONFIG_PAGE));
M_Finish := TRUE;]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
