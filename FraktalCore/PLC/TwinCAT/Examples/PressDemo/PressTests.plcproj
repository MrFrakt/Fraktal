      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Fraktal_Press_Demo\01_PneumaticPress\PL_PressReasons.TcGVL">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Fraktal_Press_Demo\01_PneumaticPress\FB_PressDemoUnit.TcPOU">
