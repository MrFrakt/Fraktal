  <ItemGroup>
    <!-- Load this project in its OWN XAE solution, never beside
         Fraktal_Press_Demo: both link the same physical press objects and
         duplicate in-solution GUIDs make PLC Control rewrite the shared files.

         All Compile paths are DOWNWARD from this manifest. TwinCAT PLC Control
         rejects a raw Compile path containing '..' before it evaluates <Link>
         metadata ("'..' is not a valid folder name"), which is exactly why
         these two suites live here rather than in Tests/Fraktal_Tests/.

         The <Folder Include> list mirrors the Include directories, never the
         <Link> paths: XAE materialises those entries as real directories on
         disk relative to this manifest. -->
    <Compile Include="PressTests\PlcTask.TcTTO">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="PressTests\PRG_PressTestRunner.TcPOU">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="PressTests\FB_PressDemoUnit_Tests.TcPOU">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="PressTests\FB_FaultRecovery_Tests.TcPOU">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Fraktal_Press_Demo\01_PneumaticPress\DUTs\ST_PneumaticPressParCfg.TcDUT">
