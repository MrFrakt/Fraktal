    <Action Name="_aN250_active" Id="{e9062a97-9372-47cc-8883-bbf3472c86b6}">
      <Implementation>
        <ST><![CDATA[// N250 — leg 1 waits at the join. §6.12: the parallel divergence after A180 is
// drawn INSIDE this POU, so both legs share the FB and each leg step says which leg
// it is through `Branch` on its own step record - a leg can never be declared
// without recording a step.
//
// NEITHER leg is the main line. A simultaneous divergence has N equal legs, so
// numbering one of them 0 would have made it look subordinate on the §3.13 chart
// and left `_retVal` meaning two different things depending on where you were
// reading it. `_retVal` is the single-threaded line before and after the fork;
// inside it, leg 1 is `_conRetVal[1]` and leg 2 is `_conRetVal[2]`.
M_Step(StepNo := 250, StepName := 'project.step.pressAwaitParallelBranch', Awaits := 0,
    AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S,
    Branch := 1);
_conRetVal[1] := E_StepResult.ADVANCE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aN300_active" Id="{8e3b5f80-5775-49a4-abaf-864946c897a1}">
      <Implementation>
        <ST><![CDATA[// N300 — concurrent leg 1, first step. Everything a normal step does is available
// here; `Branch := 1` is what keeps this leg's issue latch, delay and message
// separate from the main line's, so both legs can command their own children in
// the same scan. This example commands nothing: the press has one work position,
// and inventing a second would change what the machine does. A real one goes here.
M_Step(StepNo := 300, StepName := 'project.step.pressParallelWork', Awaits := 0,
    AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S,
    Branch := 2);
_conRetVal[2] := E_StepResult.ADVANCE;   // leg 2's result; leg 1 uses _conRetVal[1]]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="_aN310_active" Id="{29ace85e-5f56-4c08-8548-8ef6b3640b1a}">
      <Implementation>
        <ST><![CDATA[// N310 — concurrent leg 1 waits at the join. A parallel divergence joins only when
// EVERY leg has reached its last step, so each leg needs a terminal step to sit in
// while the others finish; this is that step for leg 1, and A250 is the main
// line's.
M_Step(StepNo := 310, StepName := 'project.step.pressAwaitParallelJoin', Awaits := 0,
    AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S,
    Branch := 2);
_conRetVal[2] := E_StepResult.ADVANCE;]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="A000_Initialize" Id="{5278ae4b-f51c-49a1-b343-5a2c5c8d4974}">
      <Implementation>
        <ST><![CDATA[// N000 step action. SFC step `A000_Initialize` calls this; its transition reads
// `_retVal = E_StepResult.ADVANCE`. Body is the ST chart's branch verbatim,
// without M_Advance - the chart runtime owns the transition.
M_Step(StepNo := 0, StepName := 'project.step.pressAutoInitialize',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
_outCmd.CycleCompleted := FALSE;
_retVal := E_StepResult.ADVANCE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A100_AwaitTwoHand" Id="{46c6cb1b-aa99-45ba-90d9-296615402308}">
      <Implementation>
        <ST><![CDATA[// N100 step action. The §8.11.1 cycle-start marker; also the target of the
// N190 two-hand abort, which returns here with the same part still in place.
M_Step(StepNo := 100, StepName := 'project.step.pressAwaitTwoHand',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WAIT_OPERATOR, ExpectedTime := T#0S);
_outCmd.CycleCompleted := FALSE;
_partReady := M_Await(Idx := 1, Label := 'project.condition.partPresent',
    Ok := _partPresentSensor.OutImm.Value AND _partPresentSensor.OutImm.Quality);
_airReady := M_Await(Idx := 2, Label := 'project.condition.airPressureOk',
    Ok := _airPressureMonitor.OutImm.PressureOk);
IF _parCfg.RequireTwoHandStart THEN
    _startReady := M_Await(Idx := 3, Label := 'project.condition.twoHandStart', Ok := _startLatched);
ELSE
    _startReady := TRUE;
END_IF
IF M_StopPending() THEN
    M_StopNow();                       // stop accepted BETWEEN cycles: no phantom cycle
ELSIF _partReady AND _airReady AND _startReady THEN
    // §3.16.3 receive once per PHYSICAL part. The N180 two-hand abort returns
    // here with the same part still in the machine and nothing processed, so a
    // second M_PartReceived would open a duplicate record for one part.
    // M_PartStarted (N150) is deliberately NOT guarded: each pass is a genuine
    // processing attempt on that part.
    IF NOT _partInMachine THEN
        _traceAccepted := M_PartReceived();
        _partInMachine := TRUE;
    END_IF
    _retVal := E_StepResult.ADVANCE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A110_RamUp" Id="{f3372a07-b767-4485-8204-f39633d96a65}">
      <Implementation>
        <ST><![CDATA[// N110 step action. SFC step `A110_RamUp` calls this; its transition reads
// `_retVal = E_StepResult.ADVANCE`. Body is the ST chart's branch verbatim,
// without M_Advance - the chart runtime owns the transition.
M_Step(StepNo := 110, StepName := 'project.step.pressRamUp',
    Awaits := _pressRam, AwaitingLabel := 'PressRam.RETRACT', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
IF M_MayIssue(Steppable := TRUE) THEN
    _pressRam.Abort := FALSE; _pressRam.Command := E_CylinderCommand.RETRACT; _pressRam.Execute := TRUE;
END_IF
IF _pressRam.Done THEN _pressRam.Execute := FALSE; _retVal := E_StepResult.ADVANCE; END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A130_DoorOpen" Id="{d761cac6-2cd3-4eca-a422-18a983c9c274}">
      <Implementation>
        <ST><![CDATA[// N130 step action. SFC step `A130_DoorOpen` calls this; its transition reads
// `_retVal = E_StepResult.ADVANCE`. Body is the ST chart's branch verbatim,
// without M_Advance - the chart runtime owns the transition.
M_Step(StepNo := 130, StepName := 'project.step.pressDoorOpen',
    Awaits := _door, AwaitingLabel := 'Door.RETRACT', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
IF M_MayIssue(Steppable := TRUE) THEN
    _door.Abort := FALSE; _door.Command := E_CylinderCommand.RETRACT; _door.Execute := TRUE;
END_IF
IF _door.Done THEN _door.Execute := FALSE; _retVal := E_StepResult.ADVANCE; END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A150_SlideInside" Id="{ae27a0d5-db16-4e61-9945-d001da8e6fa3}">
      <Implementation>
        <ST><![CDATA[// N150 step action. SFC step `A150_SlideInside` calls this; its transition reads
// `_retVal = E_StepResult.ADVANCE`. Body is the ST chart's branch verbatim,
// without M_Advance - the chart runtime owns the transition.
M_Step(StepNo := 150, StepName := 'project.step.pressSlideInside',
    Awaits := _partSlide, AwaitingLabel := 'PartSlide.EXTEND', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
IF M_MayIssue(Steppable := TRUE) THEN
    M_PartStarted();
    _partSlide.Abort := FALSE; _partSlide.Command := E_CylinderCommand.EXTEND; _partSlide.Execute := TRUE;
END_IF
IF _partSlide.Done THEN _partSlide.Execute := FALSE; _retVal := E_StepResult.ADVANCE; END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A170_TransferSettle" Id="{7b373022-8fc7-41ee-a48d-ecadf8201667}">
      <Implementation>
        <ST><![CDATA[// N170 step action. SFC step `A170_TransferSettle` calls this; its transition reads
// `_retVal = E_StepResult.ADVANCE`. Body is the ST chart's branch verbatim,
// without M_Advance - the chart runtime owns the transition.
M_Step(StepNo := 170, StepName := 'project.step.pressTransferSettle',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := _parCfg.TransferSettleTime);
_retVal := M_Delay(PT := _parCfg.TransferSettleTime);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A180_DoorClose" Id="{c9727189-b85c-475d-9175-0585835695ec}">
      <Implementation>
        <ST><![CDATA[// N180 step action. Transition `_retVal = E_StepResult.ADVANCE` -> A200;
// the JUMP1 branch (`_retVal = E_StepResult.JUMP1`) -> A185.
//
// Releasing a two-hand button while the door is moving is an operator abort, not
// a fault: the door goes back up, the part slides out, and the cycle returns to
// the two-hand wait. Completion wins if the door finished in the same scan the
// button was released.
M_Step(StepNo := 180, StepName := 'project.step.pressDoorClose',
    Awaits := _door, AwaitingLabel := 'Door.EXTEND', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
_twoHandHeldDuringClose := M_Await(Idx := 1,
    Label := 'project.condition.twoHandHeldDuringDoorClose',
    Ok := _twoHand.OutImm.SafeActive OR NOT _parCfg.RequireTwoHandStart);
IF M_MayIssue(Steppable := TRUE) THEN
    _door.Abort := FALSE; _door.Command := E_CylinderCommand.EXTEND; _door.Execute := TRUE;
END_IF
IF _door.Done THEN
    _door.Execute := FALSE;
    _retVal := E_StepResult.ADVANCE;
ELSIF NOT _twoHandHeldDuringClose THEN
    _door.Execute := FALSE;             // §6.1 Execute-drop reset releases the close
    // §6.9(e) — a WARNING, not a fault: nothing stops, the JUMP1 branch below is
    // the recovery. Recorded because a cycle was abandoned with the part still in
    // the machine. Raised once per visit however many scans this action runs.
    _closeAbortWarned := M_RaiseWarning(
        Reason := PL_PressReasons.PRESS_TWO_HAND_RELEASED,
        DescriptionKey := 'project.warning.twoHandReleasedDuringDoorClose',
        Severity := E_Severity.LOW, Category := E_Category.PROCESS);
    _retVal := E_StepResult.JUMP1;      // released -> reopen and clear the part
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A185_DoorReopen" Id="{e2efc55a-397e-46af-bda8-843ecc5d3e62}">
      <Implementation>
        <ST><![CDATA[// N185 step action. Reached from A180 by JUMP1 when a two-hand button is
// released while the door closes. Advances to A190.
M_Step(StepNo := 185, StepName := 'project.step.pressDoorReopen',
    Awaits := _door, AwaitingLabel := 'Door.RETRACT', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
IF M_MayIssue(Steppable := TRUE) THEN
    _door.Abort := FALSE; _door.Command := E_CylinderCommand.RETRACT; _door.Execute := TRUE;
END_IF
IF _door.Done THEN _door.Execute := FALSE; _retVal := E_StepResult.ADVANCE; END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A190_SlideOutsideAfterAbort" Id="{115525f3-ab5b-433a-8938-7490f4dd475d}">
      <Implementation>
        <ST><![CDATA[// N190 step action. Slides the part out and drops the start latch, then its
// transition jumps back to A100, the two-hand wait. The start latch is dropped
// so the cycle cannot resume without a fresh two-hand press.
M_Step(StepNo := 190, StepName := 'project.step.pressSlideOutsideAfterAbort',
    Awaits := _partSlide, AwaitingLabel := 'PartSlide.RETRACT', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
IF M_MayIssue(Steppable := TRUE) THEN
    _partSlide.Abort := FALSE; _partSlide.Command := E_CylinderCommand.RETRACT; _partSlide.Execute := TRUE;
END_IF
IF _partSlide.Done THEN
    _partSlide.Execute := FALSE;
    _startLatched := FALSE;
    _retVal := E_StepResult.ADVANCE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A200_RamDown" Id="{7d4a678c-d470-4782-a227-8cadaeb0464e}">
      <Implementation>
        <ST><![CDATA[// N200 step action. Transition `_retVal = E_StepResult.ADVANCE` -> A220;
// the JUMP1 branch (`_retVal = E_StepResult.JUMP1`) -> A210.
// the ram to the §6.9 auto-rollup: an awaited child fault is adopted by the
// Unit (ERROR, _step := 0) before _M_Dispatch runs, and the chain would stop
// before it could ask the operator anything. The wait is still named (§6.9(b))
// and the cylinder still raises its own CYL_NOT_EXTENDED alarm.
M_Step(StepNo := 200, StepName := 'project.step.pressRamDown',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S,
    Branch := 1);
_ramReached := M_Await(Idx := 1, Label := 'project.condition.pressRamExtended',
    Ok := _pressRam.Done);
IF M_MayIssue(Steppable := TRUE) THEN
    _pressRam.Abort := FALSE; _pressRam.Command := E_CylinderCommand.EXTEND; _pressRam.Execute := TRUE;
END_IF
IF _pressRam.Done THEN
    _pressRam.Execute := FALSE;
    _conRetVal[1] := E_StepResult.ADVANCE;
ELSIF _pressRam.Error THEN
    // §6.9(e) — publish the ram's own first-out on the Unit and on this row of the
    // §3.13 chart without adopting it: the confirmation + scrap below IS the
    // handling, so a fault here would replace a designed recovery.
    _ramFailureReported := M_ReportFromChild(Source := _pressRam);
    _pressRam.Execute := FALSE;         // §6.1 Execute-drop reset returns the ram to READY
    _conRetVal[1] := E_StepResult.JUMP1;      // did not reach -> operator confirmation
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A210_ConfirmPressFailure" Id="{dd0fa8fa-e742-47df-80da-303bf0e5a7ac}">
      <Implementation>
        <ST><![CDATA[// N210 step action. Reached from A200 by JUMP1; advances to A215.
// scrapped. A scrap is deliberate, so there is no timeout default (§6.11).
M_Step(StepNo := 210, StepName := 'project.step.pressNotReachedConfirm',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WAIT_OPERATOR, ExpectedTime := T#0S,
    Branch := 1);
_decisionRequest.Prompt := 'project.decision.pressNotReached';
_decisionRequest.Options[1] := 'project.decision.confirmScrapAndReturn';
_decisionRequest.Default := 0;
_decisionRequest.Timeout := T#0S;
M_AskDecision(Req := _decisionRequest);
_answer := M_TakeDecision();
IF _answer = 1 THEN
    _conRetVal[1] := E_StepResult.ADVANCE;
ELSE
    _failureConfirmed := M_Await(Idx := 1,
        Label := 'project.condition.pressFailureConfirmation', Ok := FALSE);
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A215_ScrapPart" Id="{c0fe7836-35ee-45c5-b7cb-7eae218e5a72}">
      <Implementation>
        <ST><![CDATA[// N215 step action. Sets the part NOK and releases it, then rejoins A240.
M_Step(StepNo := 215, StepName := 'project.step.pressScrapPart',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S,
    Branch := 1);
_partProcessed := M_PartProcessed(Verdict := E_Verdict.NOK,
    Reason := PL_ModuleReasons.CYL_NOT_EXTENDED);
_partDispositioned := TRUE;             // N999 must not also count it good
_partInMachine := FALSE;                // dispositioned: the next one is a new part
_outCmd.CycleCompleted := FALSE;
_conRetVal[1] := E_StepResult.ADVANCE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A220_PressDwell" Id="{af119666-88c9-40e5-a14b-7e0ff7e26224}">
      <Implementation>
        <ST><![CDATA[// N220 step action. SFC step `A220_PressDwell` calls this; its transition reads
// `_retVal = E_StepResult.ADVANCE`. Body is the ST chart's branch verbatim,
// without M_Advance - the chart runtime owns the transition.
M_Step(StepNo := 220, StepName := 'project.step.pressDwell',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := _parCfg.PressSettleTime,
    Branch := 1);
// Releasing the button mid-dwell is the designed way to stop pressing, so it
// is a named wait (§6.9(b)), not a fault: the ram's outputs come off, the
// dwell timer freezes where it is because M_Delay is not called, and pressing
// again restores the force and finishes the remaining dwell. Faulting here
// charged an unrecoverable downtime event for normal operator behaviour.
_dwellTwoHandHeld := M_Await(Idx := 1, Label := 'project.condition.twoHandHeldDuringPress',
    Ok := _twoHand.OutImm.SafeActive OR NOT _parCfg.RequireTwoHandStart);
IF NOT _dwellTwoHandHeld THEN
    _pressRam.WithdrawOutputs();
ELSE
    // The press force is the valve latched by the EXTEND that step 200 already
    // completed, so after a withdraw only this call re-energizes it — and the
    // ram re-checks its own extend permit before it does (§7.2).
    _pressRam.RestoreOutputs();
    _conRetVal[1] := M_Delay(PT := _parCfg.PressSettleTime);
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A230_RecordResult" Id="{67615e2a-a244-4064-a084-9649e0b078c9}">
      <Implementation>
        <ST><![CDATA[// N230 step action. SFC step `A230_RecordResult` calls this; its transition reads
// `_retVal = E_StepResult.ADVANCE`. Body is the ST chart's branch verbatim,
// without M_Advance - the chart runtime owns the transition.
M_Step(StepNo := 230, StepName := 'project.step.pressRecordResult',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S,
    Branch := 1);
_recordAccepted := M_PartRecord(RecordName := 'PressDwell',
    Value := DINT_TO_LREAL(TIME_TO_DINT(_parCfg.PressSettleTime)),
    Minimum := 0, Maximum := 30000,
    Target := DINT_TO_LREAL(TIME_TO_DINT(_parCfg.PressSettleTime)), EngUnit := 'ms');
_conRetVal[1] := E_StepResult.ADVANCE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A240_ReturnToLoadPosition" Id="{fd07a0a1-ebb6-4b74-ad4c-6298c814ee64}">
      <Implementation>
        <ST><![CDATA[// N240 step action, on concurrent leg 1. Its transition reads
// `_conRetVal[1] = E_StepResult.ADVANCE`. Body is the ST chart's branch verbatim,
// without M_Advance - the chart runtime owns the transition.
//
// The sub-chain needs no leg argument: M_RunSub inherits the leg of the step that
// runs it (§6.12), so the load-position steps publish as leg 1 too.
_conRetVal[1] := M_RunSub(Chain := _loadPosition, BaseStepNo := 240);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A999_CycleComplete" Id="{0252dfdd-9d58-4bc9-a434-44b0046e8466}">
      <Implementation>
        <ST><![CDATA[// N999 step action. Transition `_retVal = E_StepResult.ADVANCE` loops to A100.
M_Step(StepNo := 999, StepName := 'project.step.pressAutoComplete',
    Awaits := 0, AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
_outCmd.CycleCompleted := TRUE;
IF _partDispositioned THEN
    _partDispositioned := FALSE;       // N260 already set the NOK verdict
ELSE
    _partProcessed := M_PartProcessed(Verdict := E_Verdict.OK, Reason := E_Reason.NONE);
    IF NOT _partProcessed THEN
        M_CountGood();                 // §3.9: no carrier configured — count directly
    END_IF
END_IF
_partInMachine := FALSE;               // processed: the next one is a new part
_startLatched := FALSE;
IF M_EndOfCycle() THEN
    _retVal := E_StepResult.ADVANCE;   // stop NOT requested: loop to N100
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="M_Reset" Id="{df77d1ac-86e0-4afa-892c-37a2a5945628}">
      <Declaration><![CDATA[METHOD M_Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_ResetBase(0);
// A chart reset abandons whatever the cycle was holding: the part record is
// closed by N215/N999, never by a reset, so both trackers start clean.
_partDispositioned := FALSE;
_partInMachine := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Setup" Id="{7572a4b5-57a8-498e-ad52-3ffdf4e35212}">
      <Declaration><![CDATA[METHOD Setup : BOOL
VAR_INPUT
    Host : I_SequenceHost;
END_VAR
VAR_IN_OUT
    PressRam : FB_CylinderCM;
    Door : FB_CylinderCM;
    PartSlide : FB_CylinderCM;
    TwoHand : FB_TwoHandStartCM;
    PartPresentSensor : FB_DigitalInputCM;
    AirPressureMonitor : FB_AirPressureMonitorCM;
    ParCfg : ST_PneumaticPressParCfg;
    OutCmd : ST_PneumaticPressOutCmd;
    StartLatched : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_pressRam REF= PressRam;
_door REF= Door;
_partSlide REF= PartSlide;
_twoHand REF= TwoHand;
_partPresentSensor REF= PartPresentSensor;
_airPressureMonitor REF= AirPressureMonitor;
_parCfg REF= ParCfg;
_outCmd REF= OutCmd;
_startLatched REF= StartLatched;
Setup := M_Attach(Host := Host) AND __ISVALIDREF(_pressRam) AND __ISVALIDREF(_door)
    AND __ISVALIDREF(_partSlide) AND __ISVALIDREF(_twoHand)
    AND __ISVALIDREF(_partPresentSensor) AND __ISVALIDREF(_airPressureMonitor)
    AND __ISVALIDREF(_parCfg) AND __ISVALIDREF(_outCmd) AND __ISVALIDREF(_startLatched)
    AND _loadPosition.Setup(Host := Host, PressRam := PressRam, Door := Door, PartSlide := PartSlide);]]></ST>
      </Implementation>
    </Method>
