    <Declaration><![CDATA[FUNCTION_BLOCK FB_LD_PressDemoAuto EXTENDS FB_SequenceBase
VAR
    _partReady, _airReady, _startReady, _stop, _doStep, _processed, _endCycle, _dummy : BOOL;
    _dwellTwoHandHeld : BOOL;          // N220 named wait: two-hand held through the dwell
    _decisionRequest : ST_DecisionRequest;   // §6.11 not-reached confirmation
    _answer : INT;
    _ramReached, _failureConfirmed : BOOL;   // N200/N210 named waits
    _twoHandHeldDuringClose : BOOL;          // N180 named wait
    _closeAbortWarned : BOOL;                // N180 §6.9(e) message result
    _ramFailureReported : BOOL;              // N200 §6.9(e) message result
    _partInMachine : BOOL;                   // §3.16.3 the part is already received
    _partDispositioned : BOOL;               // N260 already set the verdict
    _traceAccepted, _recordAccepted, _partProcessed : BOOL;
    {attribute 'OPC.UA.DA' := '0'}
    _pressRam : REFERENCE TO FB_CylinderCM;
    {attribute 'OPC.UA.DA' := '0'}
    _door : REFERENCE TO FB_CylinderCM;
    {attribute 'OPC.UA.DA' := '0'}
    _partSlide : REFERENCE TO FB_CylinderCM;
    {attribute 'OPC.UA.DA' := '0'}
    _twoHand : REFERENCE TO FB_TwoHandStartCM;
    {attribute 'OPC.UA.DA' := '0'}
    _partPresentSensor : REFERENCE TO FB_DigitalInputCM;
    {attribute 'OPC.UA.DA' := '0'}
    _airPressureMonitor : REFERENCE TO FB_AirPressureMonitorCM;
    {attribute 'OPC.UA.DA' := '0'}
    _parCfg : REFERENCE TO ST_PneumaticPressParCfg;
    {attribute 'OPC.UA.DA' := '0'}
    _outCmd : REFERENCE TO ST_PneumaticPressOutCmd;
    {attribute 'OPC.UA.DA' := '0'}
    _startLatched : REFERENCE TO BOOL;
    {attribute 'OPC.UA.DA' := '0'}
    _loadPosition : FB_PressDemoLoadPosition;
END_VAR]]></Declaration>
