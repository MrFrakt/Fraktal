<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_PressDemoUnit" Id="{5f21a307-9147-4e56-a693-b78707df35d5}" SpecialFunc="None">
    <Declaration><![CDATA[// Project-owned Unit: pneumatic press + access door + transfer slide + two-hand request.
// Cylinder interlocks prevent the two documented collisions in AUTO and MANUAL.
// Certified E-stop, two-hand evaluation and safe valve outputs remain external.
FUNCTION_BLOCK FB_PressDemoUnit EXTENDS FB_UnitBase
VAR_INPUT
    ParCfg : ST_PneumaticPressParCfg;
    ParCmd : ST_PneumaticPressParCmd;
END_VAR
VAR_OUTPUT
    PressRam      : FB_CylinderCM;
    Door          : FB_CylinderCM;
    PartSlide     : FB_CylinderCM;
    TwoHand       : FB_TwoHandStartCM;
    PneumaticPower: FB_PowerGroupCM;
    PartPresentSensor : FB_DigitalInputCM;
    AirPressureMonitor : FB_AirPressureMonitorCM;
    ReleaseConditions : FB_PressDemoRelease; // project-owned, browseable condition state
    OutCmd        : ST_PneumaticPressOutCmd;
    OutImm        : ST_PneumaticPressOutImm;
END_VAR
VAR
    {attribute 'OPC.UA.DA' := '0'}
    _recipe : I_RecipeProvider;
    _parCfgStaged : ST_PneumaticPressParCfg;
    _recipePrepared : BOOL;
    _startLatched : BOOL;
    _powerRequestPending : BOOL;
    _powerTargetOn : BOOL;
    {attribute 'OPC.UA.DA' := '0'}
    _homeSequence : FB_PressDemoHome;       // §6.8 ST chain on FB_SequenceBase owns HOME steps
    {attribute 'OPC.UA.DA' := '0'}
    _changeoverSequence : FB_PressDemoChangeover;
    // §6.8 / O2 — the SAME AUTO chain in all three permitted languages. This is a
    // demo bench: carrying three renditions is the point (O2 says sequences and
    // interlocks may be ST, SFC or Ladder), not something a real project would do.
    // AUTO_SEQUENCE_LANGUAGE below picks which one the Unit binds and runs; the
    // other two are inert. They are excluded from OPC UA for the same reason the
    // bound one is: a chain is not a module and publishes no Status.
    {attribute 'OPC.UA.DA' := '0'}
    _autoSequence : FB_PressDemoAuto;
    {attribute 'OPC.UA.DA' := '0'}
    _sfcAutoSequence : FB_SFC_PressDemoAuto;
    {attribute 'OPC.UA.DA' := '0'}
    _ldAutoSequence : FB_LD_PressDemoAuto;
    // §7.2 / O2 — the SAME release engineering in a second language. Only the
    // rendition RELEASE_LANGUAGE selects is set up, evaluated, and allowed to
    // write the directional permits and the release report; the other is inert.
    // The ST one stays the PUBLISHED one (ReleaseConditions, a VAR_OUTPUT
    // above): a browseable second copy that nothing evaluates would show the
    // operator a set of named conditions that is simply not a claim (§3.12).
    // Selecting LD therefore trades the browseable condition state for the
    // demonstration — a bench limitation, not a pattern.
    {attribute 'OPC.UA.DA' := '0'}
    _ldReleaseConditions : FB_LD_PressDemoRelease;
END_VAR
VAR CONSTANT
    // Which rendition of the AUTO chain runs. VAR CONSTANT on purpose, like the
    // §6.0 commissioning gates in MAIN: switching language is a source edit plus a
    // download, never an online write. The compiler folds the unselected branches.
    //   STRUCTURED_TEXT           -> FB_PressDemoAuto
    //   SEQUENTIAL_FUNCTION_CHART -> FB_SFC_PressDemoAuto
    //   LADDER_DIAGRAM            -> FB_LD_PressDemoAuto
    AUTO_SEQUENCE_LANGUAGE : E_RenditionLanguage := E_RenditionLanguage.LADDER_DIAGRAM;
    // Which rendition of the release/interlock logic is evaluated, on the same
    // terms and from the same type, so a value means the same language in both
    // selections. There is no SEQUENTIAL_FUNCTION_CHART rendition here: SFC is a
    // sequence language and has nothing to say about a permissive, so that
    // member is simply never selected rather than being given a second meaning.
    //   STRUCTURED_TEXT -> FB_PressDemoRelease
    //   LADDER_DIAGRAM  -> FB_LD_PressDemoRelease
    RELEASE_LANGUAGE : E_RenditionLanguage := E_RenditionLanguage.LADDER_DIAGRAM;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Cyclic();]]></ST>
    </Implementation>
    <Method Name="_M_AppendInterlocks" Id="{9d306c75-af96-45fa-b6f4-fc1be7a8f3a0}">
      <Declaration><![CDATA[// §7.8 mode-entry release owned by this Unit. The base Start method consumes the
// same report the HMI displays, so this condition cannot become explanation-only.
METHOD PROTECTED _M_AppendInterlocks
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF RELEASE_LANGUAGE = E_RenditionLanguage.LADDER_DIAGRAM THEN
    _ldReleaseConditions.M_AppendStart(Report := Report);
ELSE
    ReleaseConditions.M_AppendStart(Report := Report);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_AppendManualInterlocks" Id="{35af721a-a6ca-4323-a3cf-ed754f60575f}">
      <Declaration><![CDATA[METHOD PROTECTED _M_AppendManualInterlocks
VAR_INPUT
    TargetPath : STRING(255);
    Value : DINT;
END_VAR
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF RELEASE_LANGUAGE = E_RenditionLanguage.LADDER_DIAGRAM THEN
    _ldReleaseConditions.M_AppendManual(TargetPath := TargetPath, Value := Value,
        PressRam := PressRam, Door := Door, PartSlide := PartSlide, Report := Report);
ELSE
    ReleaseConditions.M_AppendManual(TargetPath := TargetPath, Value := Value,
        PressRam := PressRam, Door := Door, PartSlide := PartSlide, Report := Report);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_ClearModeTransitionState" Id="{f103e8ba-b0dd-4270-929c-47b3482c2e72}">
      <Declaration><![CDATA[// Clear state that must not survive init, mode entry, or either abort path.
// OnCommandStart deliberately does not call this: a physical start pulse may have
// been latched one scan before the inherited Execute edge is consumed.
METHOD PROTECTED _M_ClearModeTransitionState]]></Declaration>
      <Implementation>
        <ST><![CDATA[Decision.Prompt := '';
DecisionAnswer := 0;
_startLatched := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_Dispatch" Id="{cc2817fc-d9b1-4ed1-bbfd-50983067ea35}">
      <Declaration><![CDATA[// Thin mode router. Each supported sequence is a named method in the Unit tree.
METHOD PROTECTED _M_Dispatch]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE ModeActive OF
    E_Mode.AUTO:
        _M_SequenceAuto();
    E_Mode.HOME:
        _M_SequenceHome();
    E_Mode.CHANGEOVER:
        _M_SequenceChangeover();
    E_Mode.MANUAL:
        _M_Fault(E_Reason.UNSUPPORTED_COMMAND, 'project.error.pressManualHasNoSequence');
ELSE
    _M_Fault(E_Reason.UNSUPPORTED_COMMAND, 'project.error.pressModeHasNoSequence');
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PublishStatus" Id="{0aec4f4a-7433-497b-8fb9-a69b8a633711}">
      <Declaration><![CDATA[METHOD PROTECTED _M_PublishStatus]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^._M_PublishStatus();
OutImm.Diagnostic := Status.Diagnostic;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_ResetModeSequences" Id="{8efbdb11-9d7a-451c-b659-dc3c9334eca7}">
      <Declaration><![CDATA[// Reset application-owned chain plumbing at lifecycle transitions. The chains'
// N000/N999 steps remain the only owners of process initialization/completion.
METHOD PROTECTED _M_ResetModeSequences]]></Declaration>
      <Implementation>
        <ST><![CDATA[_homeSequence.M_Reset();
_changeoverSequence.M_Reset();
// Reset all three unconditionally: an unattached chain's M_Reset is harmless, and
// this way the reset cannot go stale if AUTO_SEQUENCE_LANGUAGE changes.
_autoSequence.M_Reset();
_sfcAutoSequence.M_Reset();
_ldAutoSequence.M_Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_RouteManual" Id="{653016fc-4fc6-4987-b1a0-1cd3e2828844}">
      <Declaration><![CDATA[METHOD PROTECTED _M_RouteManual : BOOL
VAR_INPUT
    TargetPath : STRING(255);
    Value : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_RouteManual := FALSE;
IF TargetPath = PressRam.Name THEN
    _M_RouteManual := PressRam.ManualCommand(Value := Value);
ELSIF TargetPath = Door.Name THEN
    _M_RouteManual := Door.ManualCommand(Value := Value);
ELSIF TargetPath = PartSlide.Name THEN
    _M_RouteManual := PartSlide.ManualCommand(Value := Value);
ELSE
    _M_RouteManual := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_SequenceAuto" Id="{b1aa9e5f-1282-4e96-92a6-ed37b454daaa}">
      <Declaration><![CDATA[// Wiring-only AUTO adapter. Every production command, wait, timer, decision,
// traceability action, and transition lives in the §6.8 chain.
METHOD PROTECTED _M_SequenceAuto]]></Declaration>
      <Implementation>
        <ST><![CDATA[// An ST chain's body is a method (M_Run); an SFC or LD chain's body IS the chart,
// so the instance itself is the call. That asymmetry is the language difference,
// not an inconsistency to normalise away.
IF AUTO_SEQUENCE_LANGUAGE = E_RenditionLanguage.LADDER_DIAGRAM THEN
    _ldAutoSequence();
ELSIF AUTO_SEQUENCE_LANGUAGE = E_RenditionLanguage.SEQUENTIAL_FUNCTION_CHART THEN
    _sfcAutoSequence();
ELSE
    _autoSequence.M_Run();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_SequenceChangeover" Id="{b1464a9c-e4ea-4d66-8478-3947059ff94c}">
      <Declaration><![CDATA[// Wiring-only CHANGEOVER adapter. The §6.8 chain owns model validation, safe
// positioning, the operator decision, and completion logic.
METHOD PROTECTED _M_SequenceChangeover]]></Declaration>
      <Implementation>
        <ST><![CDATA[_changeoverSequence.M_Run();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_SequenceHome" Id="{ed834a64-57bd-4fe5-a5c0-ce16cdd2143a}">
      <Declaration><![CDATA[// Wiring-only HOME adapter. OnCommandStart owns the reset edge; the sequence POU
// owns every process step and terminal action.
METHOD PROTECTED _M_SequenceHome]]></Declaration>
      <Implementation>
        <ST><![CDATA[_homeSequence.M_Run();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_Supports" Id="{51b90e84-71fd-47fb-a133-d29df50af97d}">
      <Declaration><![CDATA[METHOD PROTECTED _M_Supports : BOOL
VAR_INPUT
    Mode : E_Mode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_Supports := (Mode = E_Mode.AUTO) OR (Mode = E_Mode.MANUAL)
    OR (Mode = E_Mode.HOME) OR (Mode = E_Mode.CHANGEOVER);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_SupportsRunStyle" Id="{3d92c7a1-64b8-4f5e-8a20-c1e57b30d846}">
      <Declaration><![CDATA[// §3.4.2 — the press paces every motion boundary through _M_StepGate, so
// SINGLE_STEP and HOLD_TO_RUN are supported (NON-SAFETY pacing; interlocks
// and the certified safety layer are unaffected).
METHOD PROTECTED _M_SupportsRunStyle : BOOL
VAR_INPUT
    Style : E_RunStyle;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_SupportsRunStyle := (Style = E_RunStyle.CONTINUOUS)
    OR (Style = E_RunStyle.SINGLE_STEP) OR (Style = E_RunStyle.HOLD_TO_RUN);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_WithdrawSequenceOutputs" Id="{68f19385-fb7e-4871-be65-efc68591af5f}">
      <Declaration><![CDATA[// One safe-stop wiring point shared by normal and error-state abort transitions.
METHOD PROTECTED _M_WithdrawSequenceOutputs]]></Declaration>
      <Implementation>
        <ST><![CDATA[PressRam.WithdrawOutputs();
Door.WithdrawOutputs();
PartSlide.WithdrawOutputs();
PressRam.Execute := FALSE;
Door.Execute := FALSE;
PartSlide.Execute := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="AbortRecipe" Id="{a113eb9d-e81d-4099-a6a9-7426558bed78}">
      <Declaration><![CDATA[METHOD AbortRecipe]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.AbortRecipe();
_recipePrepared := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CommitRecipe" Id="{f0ca16c3-542f-49c8-a671-1b9e899cb831}">
      <Declaration><![CDATA[METHOD CommitRecipe]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.CommitRecipe();
IF _recipePrepared THEN
    ParCfg := _parCfgStaged;
    // §8.11 performance references follow the model: OEE Performance denominator
    // and the WORK-time degradation baseline are per-recipe engineering data.
    Oee.IdealCycleMs := ParCfg.IdealCycleMs;
    Profiler.M_SetBaselineWork(WorkMs := ParCfg.BaselineWorkMs);
END_IF
_recipePrepared := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_AppendConfig" Id="{6d1b3a97-2e50-48cf-b1a4-95c07de8f312}">
      <Declaration><![CDATA[// §3.10.2 — base walk (Unit facets + all child modules), then the project-owned
// fieldbus topology identity: static members of GVL_PressFieldbus.Topology are
// OPC.UA.DA=0 and reach the HMI only through this manifest.
METHOD M_AppendConfig : BOOL
VAR_INPUT
    Pager : REFERENCE TO FB_ConfigPager;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_AppendConfig := SUPER^.M_AppendConfig(Pager := Pager);
F_AppendTopologyConfig(Topology := GVL_PressFieldbus.Topology, Pager := Pager);]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAbort" Id="{946299b7-20f3-4f8e-8bce-a4a3c6398824}">
      <Declaration><![CDATA[METHOD PROTECTED OnAbort : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnAbort := SUPER^.OnAbort();
_M_PartAborted();                    // §3.16.3: the part leaves without a valid result
_M_WithdrawSequenceOutputs();
_M_ResetModeSequences();
_M_ClearModeTransitionState();
_powerTargetOn := FALSE;
_powerRequestPending := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnAbortInError" Id="{a64227ef-33d3-4cdd-8492-93149de02dd5}">
      <Declaration><![CDATA[// Error-state Abort is a deliberate recovery action but does not clear ERROR.
METHOD PROTECTED OnAbortInError : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnAbortInError := SUPER^.OnAbortInError();
_M_WithdrawSequenceOutputs();
_M_ResetModeSequences();
_M_ClearModeTransitionState();
_powerTargetOn := FALSE;
_powerRequestPending := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCommandStart" Id="{e5e79728-ee71-460d-95c2-7d77c9c488b4}">
      <Declaration><![CDATA[// Every accepted Unit Start gets a fresh mode chain, including a repeated
// HOME/CHANGEOVER run that does not pass through another mode change.
METHOD PROTECTED OnCommandStart : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnCommandStart := SUPER^.OnCommandStart();
_M_ResetModeSequences();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCyclic" Id="{f9b92ad7-f0eb-4fb6-b68a-ce349991589d}">
      <Declaration><![CDATA[METHOD PROTECTED OnCyclic : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnCyclic := SUPER^.OnCyclic();
// Project release engineering is a separate visible component. It owns the
// functional collision permits and mode-entry conditions consumed below.
IF RELEASE_LANGUAGE = E_RenditionLanguage.LADDER_DIAGRAM THEN
    _ldReleaseConditions.M_Evaluate(PressRam := PressRam, Door := Door, PartSlide := PartSlide,
        TwoHand := TwoHand, PneumaticPower := PneumaticPower,
        AirPressure := AirPressureMonitor);
ELSE
    ReleaseConditions.M_Evaluate(PressRam := PressRam, Door := Door, PartSlide := PartSlide,
        TwoHand := TwoHand, PneumaticPower := PneumaticPower,
        AirPressure := AirPressureMonitor);
END_IF

// Latch access-gated Unit requests, then observe one full Execute-low scan before
// starting another power-group command (PLCopen edge discipline).
IF ControlOffRequest THEN
    _powerTargetOn := FALSE;
    _powerRequestPending := TRUE;
ELSIF ControlOnRequest THEN
    _powerTargetOn := TRUE;
    _powerRequestPending := TRUE;
END_IF
IF PneumaticPower.Done OR PneumaticPower.Error OR PneumaticPower.Aborted THEN
    PneumaticPower.Execute := FALSE;
ELSIF _powerRequestPending AND NOT PneumaticPower.Execute
AND (PneumaticPower.State = E_ExecState.READY) THEN
    PneumaticPower.Abort := FALSE;
    IF _powerTargetOn THEN
        PneumaticPower.Command := E_PowerGroupCommand.POWER_ON;
    ELSE
        PneumaticPower.Command := E_PowerGroupCommand.POWER_OFF;
    END_IF
    PneumaticPower.Execute := TRUE;
    _powerRequestPending := FALSE;
END_IF

// A physical two-hand edge may start AUTO from READY, or release an already
// running Unit's wait step. It never bypasses domain readiness or access policy.
IF TwoHand.OutImm.StartPulse
AND PartPresentSensor.OutImm.Value AND PartPresentSensor.OutImm.Quality
AND AirPressureMonitor.OutImm.PressureOk THEN
    IF (State = E_ExecState.BUSY) AND (ModeActive = E_Mode.AUTO) THEN
        _startLatched := TRUE;
    ELSIF (ModeActive = E_Mode.AUTO) AND Start() THEN
        _startLatched := TRUE;
    END_IF
ELSIF TwoHand.OutImm.StartPulse THEN
    _startLatched := FALSE;
END_IF
IF PneumaticPower.Error AND (State = E_ExecState.BUSY) THEN
    _M_RollupFault();
END_IF
IF (State = E_ExecState.BUSY)
AND NOT AirPressureMonitor.OutImm.PressureOk THEN
    PressRam.WithdrawOutputs();
    Door.WithdrawOutputs();
    PartSlide.WithdrawOutputs();
    _M_Fault(E_Reason.PERMISSIVE_NOT_MET, 'project.error.pressAirPressureLost');
END_IF
OutImm.PressRetracted := PressRam.OutImm.Retracted;
OutImm.DoorOpen := Door.OutImm.Retracted;
OutImm.DoorClosed := Door.OutImm.Extended;
OutImm.SlideInside := PartSlide.OutImm.Extended;
OutImm.SlideOutside := PartSlide.OutImm.Retracted;
OutImm.TwoHandArmed := TwoHand.OutImm.Armed;
OutImm.TwoHandActive := TwoHand.OutImm.SafeActive;
OutImm.PartPresent := PartPresentSensor.OutImm.Value AND PartPresentSensor.OutImm.Quality;
OutImm.AirPressureOk := AirPressureMonitor.OutImm.PressureOk;
// §3.12 — ONE derivation, published under the name the operator knows and read
// by everything that needs the fact (§1.1 O9: derived, never duplicated). It is a
// state, not a command result: it stops being true the moment a cylinder leaves
// the position, including in MANUAL where no sequence runs to clear anything.
// _M_State publishes it on the generic flag table with the moment it last changed,
// so the HMI can render it without knowing this module type.
OutImm.Homed := _M_State(Idx := 1, Key := 'project.state.pressAtLoadPosition',
    Ok := Door.OutImm.Retracted AND NOT Door.OutImm.Extended
      AND PartSlide.OutImm.Retracted AND NOT PartSlide.OutImm.Extended
      AND PressRam.OutImm.Retracted AND NOT PressRam.OutImm.Extended);
OutImm.ReadyForLoad := OutImm.Homed;   // same fact; the load gate's name for it
OutImm.ActiveSettleTime := ParCfg.PressSettleTime;
OutImm.Diagnostic := Status.Diagnostic;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnInit" Id="{0246d731-6bad-4eaa-b1dc-60466cc43590}">
      <Declaration><![CDATA[// First operational scan: initialize application-owned mode-chain state.
METHOD PROTECTED OnInit : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnInit := SUPER^.OnInit();
_M_ResetModeSequences();
_M_ClearModeTransitionState();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnModeChanged" Id="{dd856305-e2af-4daa-b43b-cdcb22828a57}">
      <Declaration><![CDATA[// Mode-entry wiring only. Step behavior remains in the selected sequence POU.
METHOD PROTECTED OnModeChanged : DINT
VAR_INPUT
    NewMode : E_Mode;
    OldMode : E_Mode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnModeChanged := SUPER^.OnModeChanged(
    NewMode := NewMode, OldMode := OldMode);
_M_ResetModeSequences();
_M_ClearModeTransitionState();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnOperatorReset" Id="{8eee6488-397f-4e1f-8c40-dc9a83fe8214}">
      <Declaration><![CDATA[// An operator reset is recovering this Unit: put the application back to the same
// safe wiring an error-state abort establishes, so the reset the operator presses at
// the panel needs no separate Stop/Abort first. The base then releases the run
// command and the children's commands, so the next HOME gets a genuine command edge.
// Unlike the abort paths this does NOT touch control power in either direction: it
// never requests Control On (§9.8 forbids self-resume), and it must not request
// Control Off either — powering down a healthy control circuit would make the
// operator re-enable it before HOME could run, i.e. reintroduce the multi-action
// recovery this reset exists to remove. Power stays where the operator put it.
METHOD PROTECTED OnOperatorReset : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnOperatorReset := SUPER^.OnOperatorReset();
_M_WithdrawSequenceOutputs();
_M_ResetModeSequences();
_M_ClearModeTransitionState();]]></ST>
      </Implementation>
    </Method>
    <Method Name="PrepareRecipe" Id="{26cc04a2-9628-4f16-837b-581094bb7ca0}">
      <Declaration><![CDATA[METHOD PrepareRecipe : BOOL
VAR_INPUT
    Model : ST_ModelId;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _recipe = 0 THEN
    _parCfgStaged := ParCfg;
    _recipePrepared := TRUE;
ELSIF _recipe.Load(ModelCode := Model.ModelCode, RecipeKey := 'PneumaticPressUnit', pParCfg := ADR(_parCfgStaged), Size := SIZEOF(_parCfgStaged)) THEN
    IF (_parCfgStaged.PressSettleTime > T#30S) OR (_parCfgStaged.TransferSettleTime > T#5S) THEN
        _M_Fault(E_Reason.RECIPE_INVALID, 'project.error.pressRecipeInvalid');
        _recipePrepared := FALSE;
        PrepareRecipe := FALSE;
        RETURN;
    END_IF
    _recipePrepared := TRUE;
ELSE
    _M_Fault(E_Reason.RECIPE_INVALID, 'std.error.recipeSchemaInvalid');
    _recipePrepared := FALSE;
    PrepareRecipe := FALSE;
    RETURN;
END_IF
PrepareRecipe := SUPER^.PrepareRecipe(Model := Model);
IF NOT PrepareRecipe THEN _recipePrepared := FALSE; END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestLocalControl" Id="{97203594-7e58-492f-b019-18924525747e}">
      <Declaration><![CDATA[// Application-only seam for ordinary hardwired Control On/Off buttons.
// It is a method (not OPC UA data), so HMI writes still use the access-gated
// ReqControlOn/ReqControlOff contract. The power CM rechecks safety and health.
METHOD RequestLocalControl : BOOL
VAR_INPUT
    ControlOn : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_powerTargetOn := ControlOn;
_powerRequestPending := TRUE;
RequestLocalControl := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Setup" Id="{c48eb9f5-2cef-457b-90cd-aa7b557e955a}">
      <Declaration><![CDATA[METHOD Setup : BOOL
VAR_INPUT
    Name : STRING(80);
    PressHal : REFERENCE TO ST_CylinderHal;
    DoorHal : REFERENCE TO ST_CylinderHal;
    SlideHal : REFERENCE TO ST_CylinderHal;
    TwoHandHal : REFERENCE TO ST_TwoHandHal;
    PowerHal : REFERENCE TO ST_PowerGroupHal;
    PartPresentHal : REFERENCE TO ST_DigitalInputHal;
    AirPressureHal : REFERENCE TO ST_AirPressureHal;
    Recipe : I_RecipeProvider;
END_VAR
VAR
    InitialModel : ST_ModelId;
    Ok : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_SetName(Name);
_M_SetPresentation(DisplayNameKey := 'project.module.pneumaticPress.name', DescriptionKey := 'project.module.pneumaticPress.description');
_recipe := Recipe;
Ok := PressRam.Setup(Name := CONCAT(Name, '.PressRam'), HalRef := PressHal, Recipe := 0);
Ok := Door.Setup(Name := CONCAT(Name, '.Door'), HalRef := DoorHal, Recipe := 0) AND Ok;
Ok := PartSlide.Setup(Name := CONCAT(Name, '.PartSlide'), HalRef := SlideHal, Recipe := 0) AND Ok;
Ok := TwoHand.Setup(Name := CONCAT(Name, '.TwoHand'), HalRef := TwoHandHal) AND Ok;
Ok := PneumaticPower.Setup(Name := CONCAT(Name, '.PneumaticPower'), HalRef := PowerHal) AND Ok;
Ok := PartPresentSensor.Setup(Name := CONCAT(Name, '.PartPresentSensor'),
    HalRef := PartPresentHal, DisplayNameKey := 'project.module.partPresentSensor.name',
    DescriptionKey := 'project.module.partPresentSensor.description') AND Ok;
Ok := AirPressureMonitor.Setup(Name := CONCAT(Name, '.AirPressureMonitor'),
    HalRef := AirPressureHal) AND Ok;
IF RELEASE_LANGUAGE = E_RenditionLanguage.LADDER_DIAGRAM THEN
    Ok := _ldReleaseConditions.Setup(UnitPath := Name) AND Ok;
ELSE
    Ok := ReleaseConditions.Setup(UnitPath := Name) AND Ok;
END_IF
Ok := _homeSequence.Setup(Host := THIS^, PressRam := PressRam, Door := Door,
    PartSlide := PartSlide, OutCmd := OutCmd) AND Ok;
Ok := _changeoverSequence.Setup(Host := THIS^, PressRam := PressRam, Door := Door,
    PartSlide := PartSlide, OutCmd := OutCmd, Model := Model) AND Ok;
// Only the selected rendition is attached: M_Attach registers the chain with the
// Unit, so attaching all three would put three chains on one step pointer.
IF AUTO_SEQUENCE_LANGUAGE = E_RenditionLanguage.LADDER_DIAGRAM THEN
    Ok := _ldAutoSequence.Setup(Host := THIS^, PressRam := PressRam, Door := Door,
        PartSlide := PartSlide, TwoHand := TwoHand, PartPresentSensor := PartPresentSensor,
        AirPressureMonitor := AirPressureMonitor, ParCfg := ParCfg, OutCmd := OutCmd,
        StartLatched := _startLatched) AND Ok;
ELSIF AUTO_SEQUENCE_LANGUAGE = E_RenditionLanguage.SEQUENTIAL_FUNCTION_CHART THEN
    Ok := _sfcAutoSequence.Setup(Host := THIS^, PressRam := PressRam, Door := Door,
        PartSlide := PartSlide, TwoHand := TwoHand, PartPresentSensor := PartPresentSensor,
        AirPressureMonitor := AirPressureMonitor, ParCfg := ParCfg, OutCmd := OutCmd,
        StartLatched := _startLatched) AND Ok;
ELSE
    Ok := _autoSequence.Setup(Host := THIS^, PressRam := PressRam, Door := Door,
        PartSlide := PartSlide, TwoHand := TwoHand, PartPresentSensor := PartPresentSensor,
        AirPressureMonitor := AirPressureMonitor, ParCfg := ParCfg, OutCmd := OutCmd,
        StartLatched := _startLatched) AND Ok;
END_IF
PneumaticPower.ParCfg.Kind := E_PowerGroupKind.VALVE_ZONE;
PneumaticPower.ParCfg.RequiredForControl := TRUE;
PneumaticPower.ParCfg.FieldbusLossReaction := E_FieldbusLossReaction.CONTROL_OFF;
Ok := _M_Register(PressRam) AND Ok;
Ok := _M_Register(Door) AND Ok;
Ok := _M_Register(PartSlide) AND Ok;
Ok := _M_Register(TwoHand) AND Ok;
Ok := _M_Register(PneumaticPower) AND Ok;
Ok := _M_Register(PartPresentSensor) AND Ok;
Ok := _M_Register(AirPressureMonitor) AND Ok;
Setup := Ok AND PrepareRecipe(Model := InitialModel);
IF Setup THEN CommitRecipe(); END_IF]]></ST>
      </Implementation>
    </Method>
