<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_LD_PressDemoRelease" Id="{6b17f0c4-4d29-4b8e-9c31-2e5a7d40b911}" SpecialFunc="None">
    <Declaration><![CDATA[// Project-owned release engineering for the pneumatic press, authored in LADDER.
//
// This is an O2 DEMONSTRATION IN THE BENCH, not a per-project pattern. Core
// §6.8/§7.2 permit a sequence or an interlock to be authored in ST, SFC or LD,
// and the only way that claim is testable is to carry a rendition and compile
// it. Two renditions of one interlock is duplication §1.1 O9 would otherwise
// forbid outright - it is justified here, and ONLY here, because demonstrating
// the language choice IS this project's purpose, exactly as the three AUTO
// chain renditions are. A real project writes this once, in one language.
// FB_PressDemoUnit.RELEASE_LANGUAGE selects which one is evaluated.
//
// Same public surface as FB_PressDemoRelease so the Unit binds either without
// any other difference, and like it this is not a Fraktal module: it exposes
// named condition state and fills the Unit's authoritative release reports
// without adding an OPC UA tree node.
FUNCTION_BLOCK FB_LD_PressDemoRelease
VAR_OUTPUT
    ModeStart : FB_PermIntlk;
    ModeStartAirPressureOk : BOOL;
    // Ram-extend permissive, split into individually named conditions. A single
    // composite permit could only ever report one composite key, so releasing
    // the two-hand button - the NORMAL way an operator stops a stroke - was
    // indistinguishable from a guard fault, an air loss or a power loss.
    RamGuardClosed   : BOOL;
    RamSlideInside   : BOOL;
    RamDevicesHealthy: BOOL;
    RamAirPressureOk : BOOL;
    RamTwoHandHeld   : BOOL;
    RamControlPowerOn: BOOL;
END_VAR
VAR
    _unitPath : STRING(255);
    _ramExtendOk : BOOL;
    _ramExtendKey : STRING(255);
    // AppendFailed returns the new report count. ST may discard a return value;
    // a rung has to land it somewhere, and the ENO slot is not that somewhere.
    _appendCount : INT;
END_VAR]]></Declaration>
    <Implementation><ST><![CDATA[; // Evaluated explicitly by the owning Unit after child cyclic status is available.]]></ST></Implementation>
