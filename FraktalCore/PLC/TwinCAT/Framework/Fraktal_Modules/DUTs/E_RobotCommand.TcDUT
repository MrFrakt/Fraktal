<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_RobotCommand" Id="{5c574dea-39dd-4afb-b643-b343bcf026c3}">
    <Declaration><![CDATA[// Annex I I.4 - the robot CM's command vocabulary. A point, a taught path, a
// generated route or a pallet nest is ONE command that runs to completion, so the
// robot looks identical to any other CM (S6.1). IDs are the only addressing.
{attribute 'qualified_only'}
TYPE E_RobotCommand :
(
    NONE           := 0,
    POWER_ON       := 1,
    POWER_OFF      := 2,
    HOME           := 3,
    MOVE_TO        := 4,   // one taught point, by ID
    RUN_PATH       := 5,   // a stored list, by ID and optional sub-range
    RUN_PALLET     := 6,   // one nest of a generated pallet grid
    MOVE_TEMPLATE  := 7,   // route generated by the help/nest graph (I.9)
    MOVE_FROM_AREA := 8,   // start resolved live from the current area (I.11)
    SET_TOOL       := 9,
    SET_FRAME      := 10,
    RECONNECT      := 11,  // §3.15.4 deliberate reconnect; never resumes a command
    REQUEST_MODE   := 12,  // ask the controller for ParCmd.Mode; Done when it REPORTS it (I.4a(a))
    SET_PAYLOAD    := 13,  // select the active load case by ID (ParCmd.TargetId), as SET_TOOL (I.3)
    JOG_POS        := 14,  // HELD manual command only (RequestHeldCommand), never Execute (§7.6.1)
    JOG_NEG        := 15,
    BRAKE_TEST     := 16,  // run the controller's own brake test; passed when it withdraws its demand
    SAFE_REFERENCE := 17   // run the controller's own safe reference run; likewise
) DINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>