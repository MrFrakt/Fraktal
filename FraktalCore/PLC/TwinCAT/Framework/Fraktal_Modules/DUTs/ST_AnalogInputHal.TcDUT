<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_AnalogInputHal" Id="{f0f0deb9-ef0b-4bbd-bbe1-73af615534c5}">
    <Declaration><![CDATA[// HAL boundary for one analog input channel. The composition root maps the
// raw process value here; identity is injected separately (S10.2.1).
TYPE ST_AnalogInputHal :
STRUCT
    Raw     : LREAL;
    Quality : BOOL := TRUE;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
