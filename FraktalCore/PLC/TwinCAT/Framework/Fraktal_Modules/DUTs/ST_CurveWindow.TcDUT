<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_CurveWindow" Id="{26f121d1-ab16-46d3-8d14-a072af2bb68b}">
    <Declaration><![CDATA[// A window the curve must pass through: some sample inside the rectangle, entered
// through EntryEdge and left through ExitEdge (bounds inclusive; XMin < XMax, YMin < YMax).
TYPE ST_CurveWindow :
STRUCT
    XMin  : LREAL;
    XMax  : LREAL;
    YMin  : LREAL;
    YMax  : LREAL;
    EntryEdge : E_CurveEdge;
    ExitEdge  : E_CurveEdge;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
