<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_AxisTeachCfg" Id="{46ff7147-f11c-4f49-824a-2e81d1d40b7b}">
    <Declaration><![CDATA[// Core S3.8a/S3.8b - the axis's SECOND retained image: the named taught
// positions and the manual step. Position 1 is StationCfg.TaughtPosition
// (kept unchanged so no deployed image is lost); this image holds 2..N and
// a first boot of the upgrade (version 0) initializes silently. SchemaVersion
// first (S3.8b): 0 = never written, 1 = this layout.
TYPE ST_AxisTeachCfg :
STRUCT
    SchemaVersion : UINT;
    ManualStep    : LREAL;                          // one manual STEP_POS / STEP_NEG
    Positions     : ARRAY[2..PL_Axis.MAX_POSITIONS] OF LREAL;   // 1 = TaughtPosition
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
