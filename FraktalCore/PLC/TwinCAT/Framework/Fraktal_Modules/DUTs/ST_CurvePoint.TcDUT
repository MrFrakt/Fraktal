<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_CurvePoint" Id="{1abe4191-4edc-439d-a710-ac8208aacdaa}">
    <Declaration><![CDATA[// One point of a measured curve or of an envelope: X is the abscissa the curve
// advances along (stroke, time), Y the measured value (force, pressure).
TYPE ST_CurvePoint :
STRUCT
    X : LREAL;
    Y : LREAL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
