  <DUT Name="ST_AnalogInputParCmd" Id="{0cf04542-4553-4e17-8da2-9fca8d904aa6}">
    <Declaration><![CDATA[// Core S3.12 - the command parameter block. MEASURE has no parameter: the
// accepted window is ParCfg's (band, time, timeout), so the struct exists to
// keep the contract shape, not to carry a value.
TYPE ST_AnalogInputParCmd :
STRUCT
    Reserved : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
