<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_CurveEdge" Id="{65d15924-37d6-42c4-8413-1974342434db}">
    <Declaration><![CDATA[// The edge of a curve window a curve must cross: ANY_EDGE accepts every edge (and,
// for an exit, a curve that ends inside the window).
{attribute 'qualified_only'}
TYPE E_CurveEdge : (ANY_EDGE := 0, LEFT := 1, RIGHT := 2, BOTTOM := 3, TOP := 4) INT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
