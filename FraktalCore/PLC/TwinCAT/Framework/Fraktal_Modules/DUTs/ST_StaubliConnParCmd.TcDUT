<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_StaubliConnParCmd" Id="{0bc82715-f7bd-48af-b5d2-acbf3d6ba223}">
    <Declaration><![CDATA[// Latched by the base on the Execute rising edge (S6.1). The connector's OWN
// command surface is the service action of Annex I I.15 - reconnect the link -
// not robot motion, which the robot CM commands through I_RobotConnector.
TYPE ST_StaubliConnParCmd :
STRUCT
    AcknowledgeController : BOOL;   // also clear the robot's own fault on reconnect
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>