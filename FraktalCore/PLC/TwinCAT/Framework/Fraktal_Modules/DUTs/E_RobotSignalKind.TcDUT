<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_RobotSignalKind" Id="{eb6c07bb-8896-4a16-b02f-64d437172f9f}">
    <Declaration><![CDATA[// Annex I I.3 - what a declared user signal holds. Every kind travels as an
// LREAL; the kind is what a write is checked against (0/1, a whole number).
{attribute 'qualified_only'}
TYPE E_RobotSignalKind :
(
    BOOL_SIGNAL := 0,
    INT_SIGNAL  := 1,
    REAL_SIGNAL := 2
) DINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
