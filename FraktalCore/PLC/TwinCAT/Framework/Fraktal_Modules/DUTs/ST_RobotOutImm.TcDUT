<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_RobotOutImm" Id="{defdeb7d-be4a-4822-95c3-71b0d2a24669}">
    <Declaration><![CDATA[// Cyclic live status mirrored from the connector, plus the first-out diagnostic.
TYPE ST_RobotOutImm :
STRUCT
    Linked         : BOOL;
    Referenced     : BOOL;
    MotionBusy     : BOOL;           // the ARM is moving - not the command handshake
    ActualMode     : E_RobotOpMode;  // what the controller REPORTS (I.4a(a))
    CurrentArea    : DWORD;          // 0 = none/undefined (I.11)
    ProtectiveStop : BOOL;           // process protection, NOT S9 safety (I.4a(c))
    Resumable      : BOOL;           // resume still valid on the retained path (I.4b)
    SpeedScale     : REAL;           // scale last sent: MIN(mode ceiling, recipe scale) (I.4a(b))
    RequestedMode  : E_RobotOpMode;  // what the PLC last REQUESTED, beside the report (I.4a(a))
    ArmPowerOn     : BOOL;           // the controller reports its drives powered (I.4)
    PathIndex      : DINT;           // last completed point of the current/last RUN_PATH; -1 = none
    SafetyPermit   : BOOL;           // the S9 alias as supplied - read-only status, never a grant
    Jogging        : BOOL;           // a held jog is driving the arm (S7.6.1)
    JogStopReason  : DINT;           // why the last jog stopped or was refused; 0 = released
    JogMode        : E_RobotJogMode;
    JogAxis        : INT;
    UserSignals    : ARRAY[1..PL_Robot.MAX_USER_SIGNALS] OF ST_RobotUserSignal;   // declared slots only (I.3)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>