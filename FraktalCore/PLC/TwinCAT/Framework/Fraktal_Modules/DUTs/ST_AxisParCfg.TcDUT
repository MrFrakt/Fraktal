<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_AxisParCfg" Id="{2d7c7acb-8469-4180-9e90-3497a2d9d678}">
    <Declaration><![CDATA[// Core S3.8: SchemaVersion FIRST. Soft limits and dynamics are recipe/config,
// never sequence literals (S10.3) - scaling and hard limits stay in the axis
// configuration where the drive integrator owns them.
TYPE ST_AxisParCfg :
STRUCT
    SchemaVersion : UINT := 1;
    SoftMin       : LREAL := 0.0;
    SoftMax       : LREAL := 100.0;
    Velocity      : LREAL := 50.0;
    Acceleration  : LREAL := 500.0;
    Deceleration  : LREAL := 500.0;
    MoveTimeout   : TIME := T#10S;
    HomeTimeout   : TIME := T#30S;
    // Teach jog (§7.6.1). JogVelocity is DEFENCE IN DEPTH, not the protection:
    // the safety-rated reduced speed is the drive's own SLS or the cell's safe
    // speed monitor, because a scan overrun or a download must not be able to
    // remove the limit that keeps a person safe (§9).
    JogVelocity     : LREAL := 5.0;
    JogAcceleration : LREAL := 100.0;
    // How long a held request may go unheard before the axis stops. This is the
    // backstop for a stalled transport, NOT the normal stop: releasing the
    // control sends Dir=0 and stops immediately (O10).
    JogTimeout      : TIME := T#200MS;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>