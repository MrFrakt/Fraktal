<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <GVL Name="PL_ModuleReasons" Id="{05d79b8d-9fe0-414a-9d75-af70b0ad83de}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
// Core §8.8 band constants (band-extensibility rule): cylinder CM 10100-10199,
// clamp EM 11000-11999 — registered in the Core §8.8 registry.
VAR_GLOBAL CONSTANT
    CYL_NOT_EXTENDED    : DINT := 10101;
    CYL_NOT_RETRACTED   : DINT := 10102;
    CYL_BOTH_SENSORS    : DINT := 10103;
    CLAMP_NOT_CONFIRMED : DINT := 11001;
    // basic cylinder 10110-10119
    CYL_HOME_NOT_REACHED : DINT := 10111;   // timeout moving to home
    CYL_WORK_NOT_REACHED : DINT := 10112;   // timeout moving to work
    CYL_POS_IMPLAUSIBLE  : DINT := 10113;   // home AND work sensor confirmed at once (implausible)
    CYL_SENSOR_LOST      : DINT := 10114;   // confirmed position sensor dropped while holding
    CYL_DISCREPANCY      : DINT := 10116;   // redundant sensors for one position disagree > DiscrepancyTime
    CYL_CFG_INVALID      : DINT := 10115;   // TravelTime >= MoveTimeout, or no sensor+no travel
    // axis CM 10201-10204 (Annex G)
    AXIS_TARGET_OOR   : DINT := 10201;   // target outside soft limits (rejected)
    AXIS_MOVE_TIMEOUT : DINT := 10202;   // MC move did not complete within the timeout
    AXIS_DRIVE_FAULT  : DINT := 10203;   // MC_* .Error / drive fault
    AXIS_NOT_HOMED    : DINT := 10204;   // MOVE_TO before a valid home
    // power-group CM 10500-10599
    POWER_ENABLE_WITHHELD : DINT := 10501;
    POWER_FEEDBACK_TIMEOUT: DINT := 10502;
    // separator/stopper CM 10001-10005 (Annex A)
    SEP_NO_CARRIER_AT       : DINT := 10001;   // carrier never present at the separator
    SEP_CARRIER_NOT_CLEARED : DINT := 10002;   // CarrierAt did not clear after opening
    SEP_CARRIER_NOT_ARRIVED : DINT := 10003;   // CarrierAfter did not arrive in time
    SEP_NOT_OPENED_FB       : DINT := 10004;   // open feedback missing
    SEP_SON_NOT_CLEARED     : DINT := 10005;   // CarrierAfter did not clear after close
    // robot route planner 10301-10315 (Annex I) - only what the planner raises today
    ROBOT_NO_ROUTE         : DINT := 10308;   // help graph defines no path between the two positions
    ROBOT_NO_HELP_FOR_NEST : DINT := 10310;   // no help point resolves for a nest given the move endpoints
    // air-pressure monitor CM 10600-10699
    AIR_SWITCH_CONFLICT    : DINT := 10601;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
