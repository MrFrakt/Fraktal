        <Get Name="Get" Id="{38701abd-11a5-4f3a-aee5-9ac5b1a85382}">
          <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
          <Implementation>
            <ST><![CDATA[Capabilities.Reported    := Linked;   // the simulated controller answers as soon as it is reachable
Capabilities.Commands    := Offered;
Capabilities.JogAxes     := JogAxes;
Capabilities.UserSignals := PL_Robot.MAX_USER_SIGNALS;]]></ST>
