<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="F_ManualEnable" Id="{29f80a2b-2422-4d64-b630-f802293ea5ef}" SpecialFunc="None">
    <Declaration><![CDATA[// Core §9 — derive the manual-enable fact from the published safety devices.
// Pure, bounded, and fail-closed: no enabling device mirrored means NOT held,
// so a cell that never wired one cannot jog with its guards open by omission.
//
// Grepping for calls to this function lists every place in a codebase where
// motion is authorised by an enabling device. That auditability is the point of
// deriving it here rather than letting each station assemble the condition.
FUNCTION F_ManualEnable : ST_ManualEnableStatus
VAR_INPUT
    Safety : ST_SafetyStatus;
END_VAR
VAR
    i : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Fail-closed defaults (§5.6, O10): every early return leaves Held FALSE.
F_ManualEnable.Present    := FALSE;
F_ManualEnable.Held       := FALSE;
F_ManualEnable.DeviceName := '';

IF NOT Safety.Present THEN
    RETURN;                       // no safety facet at all -> nothing to permit with
END_IF

FOR i := 1 TO PL_Fraktal.MAX_SAFETY_DEVICES DO
    IF Safety.Devices[i].Present AND (Safety.Devices[i].Kind = E_SafetyDeviceKind.ENABLE_SWITCH) THEN
        F_ManualEnable.Present := TRUE;
        // Permitting is the POSITIVE state, exactly as an E-stop that is not
        // pressed publishes Ready/NOT DemandActive (§9). A released or
        // panic-squeezed enabling device demands the safe state like any other
        // device, so it fails every one of these tests.
        IF Safety.Devices[i].Ready
            AND NOT Safety.Devices[i].DemandActive
            AND NOT Safety.Devices[i].SafeStateActive
            AND NOT Safety.Devices[i].FaultActive
            AND Safety.Devices[i].FieldbusHealthy
            AND (Safety.Devices[i].State = E_SafetyState.READY) THEN
            F_ManualEnable.Held       := TRUE;
            F_ManualEnable.DeviceName := Safety.Devices[i].Name;
            RETURN;                   // first permitting device wins and names itself
        END_IF
    END_IF
END_FOR

// A device-level fault anywhere in the safety facet withdraws the permission
// even if some other enabling device still reads as held: a safety system
// reporting a fault is not a safety system to take permission from (O10).
IF Safety.FaultActive THEN
    F_ManualEnable.Held       := FALSE;
    F_ManualEnable.DeviceName := '';
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>