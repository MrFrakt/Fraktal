<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_NokPolicyParCfg" Id="{42669dd9-42df-4342-a614-5e7083cf8e61}">
    <Declaration><![CDATA[// Core §3.16.5 - a Unit's NOK-part limit, given by the composition root through
// FB_UnitBase.SetNokPolicy. Each rule is off at zero; the default is no limit.
TYPE ST_NokPolicyParCfg :
STRUCT
    SchemaVersion : UINT := 1;
    InSeries      : INT := 0;   // trip on this many NOK parts in a row
    WindowCount   : INT := 0;   // ...or on WindowNok NOK among the last WindowCount judged parts
    WindowNok     : INT := 0;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
