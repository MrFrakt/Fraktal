<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_HmiRequestKind" Id="{e9df710a-6a5f-49af-945f-afb6beea62aa}">
    <Declaration><![CDATA[// Core §3.10/§14 — generic OPC UA request mailbox operation.
// Append-only: ordinal values are a transport contract with every HMI adapter.
{attribute 'qualified_only'}
TYPE E_HmiRequestKind :
(
    NONE             := 0,
    LOGIN            := 1,
    LOGOUT           := 2,
    SET_MODE         := 3,
    SET_MODEL        := 4,
    START            := 5,
    STOP             := 6,
    CONTROL_ON       := 7,
    CONTROL_OFF      := 8,
    OPERATOR_RESET   := 9,
    DECISION_ANSWER  := 10,
    MANUAL_COMMAND   := 11,
    SET_RUN_STYLE    := 12,
    STEP_REQUEST     := 13,
    SET_HOLD_RUN     := 14,
    RELEASE_START    := 15,
    RELEASE_MANUAL   := 16,
    RELEASE_ACTION   := 17,
    RESET_OEE        := 18,
    WRITE_CONFIG     := 19,
    SHELVE_ALARM     := 20,
    UNSHELVE_ALARM   := 21,
    FORCE_CHANNEL    := 22,
    QUERY_CONFIG     := 23,   // §3.10.2 config-manifest page request (IntValue = page)
    SET_ACCESS_LEVEL := 24,   // §7.7 policy: IntValue=gate, TextValue=level ordinal
    SET_SESSION_TIMEOUT := 25, // §7.7 policy: DurationMs, 0 = never
    LAMP_TEST        := 26,    // §8.13 bounded signal-tower test
    // §3.8c — a capture is a write whose value comes from the machine. The root
    // already owned CaptureConfig; without a request kind no client could reach
    // it, and §3.8c(a) requires a capture to be routed through this same
    // acknowledged mailbox. TargetPath=Scope, NameValue=WriteKey, IntValue=rev.
    CAPTURE_CONFIG   := 27,
    // §3.8b parameter sets. TextValue = set name; IntValue = E_ConfigKind for a
    // save (which class of records the set carries). All three are CONFIG_SET,
    // separately from the DATA_WRITE that edits one value.
    SAVE_CONFIG_SET  := 28,
    LOAD_CONFIG_SET  := 29,
    LIST_CONFIG_SETS := 30,
    // §3.8b — an ENGINEER-level operator accepts a restore loss. Under
    // BLOCK_UNTIL_ACKNOWLEDGED this is what releases START_STOP again.
    ACK_CONFIG_RESTORE := 31,
    // §3.8b — move a set as TEXT. Export serves one JSON line per request
    // (IntValue = line; 0 = header), import takes one back (TextValue = the line,
    // BoolValue = this is the last one). Paged for the same reason QUERY_CONFIG
    // is: no full set document ever has to exist in PLC memory.
    EXPORT_CONFIG_SET := 32,
    IMPORT_CONFIG_SET := 33,
    // §7.6.1a hold-to-run. TargetPath = module, IntValue = command value,
    // BoolValue = TRUE while the operator holds it. The client REFRESHES this
    // while held; the root drops the hold on its own if refreshes stop, so a
    // closed HMI or a dead link stops the motion rather than latching it.
    MANUAL_HELD := 34
) DINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
