<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_SequenceStep" Id="{0c3ae940-6c38-44e3-872b-4eb8cc092beb}">
    <Declaration><![CDATA[// Core §6.5/§3.13 — the per-row LIVE state of one flow-chart row: 7 bytes.
//
// Everything static about a row (its number, leg, time class, guard and text) is in
// ST_SequenceStepDef, served once through the §3.10.2 manifest. Everything about
// which row is running RIGHT NOW is in ST_SequenceCursor, one entry per concurrent
// leg. What is left here is the small set that is per-row AND changes over time,
// and that the HMI could not reconstruct by watching: a poll at a few Hz against a
// task at kHz cannot see a step shorter than its own interval, so a chart that
// accumulated these client-side would silently skip fast steps and lose transient
// errors. The chart shows what the chain DID, not what someone happened to catch.
TYPE ST_SequenceStep :
STRUCT
    Visited       : BOOL;          // reached at least once since the chain reset
    LastDuration  : TIME;          // how long it ran on its last visit
    // §6.9(d)/(e) marks. The text and the drill-down link are in the annotation
    // table; these say only that the row has one, which is all the chart needs to
    // colour it - so a row stays correctly marked even if that table is full.
    ErrorActive   : BOOL;
    WarningActive : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
