<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SequenceBaseLd" Id="{51d493b2-6a80-40fc-8489-9750a75237bc}" SpecialFunc="None">
    <Declaration><![CDATA[// Core §6.8 — the ladder face of FB_SequenceBase.
//
// A ladder rung has no statement context: a box runs because power reaches it.
// Every step-facing method therefore takes `Run : BOOL` as its FIRST input, wired
// to the rung, and is a no-op when Run is FALSE (a value-returning call yields its
// fail-closed default). That is the only difference from the ST face; the logic
// itself stays in FB_SequenceBase and is reached through SUPER^.
//
// Chains built on this are integer-based state machines: one rung per state,
// gated by EQ(_step, N), with the boxes chained left to right so power flows
// MOVE -> M_Step -> ... -> M_Advance. The rungs dispatch; they do not evaluate
// transitions, so each rung still ends in M_Advance and the OnJump1..3 mapping
// keeps jumps declarative (§6.10).
FUNCTION_BLOCK ABSTRACT FB_SequenceBaseLd EXTENDS FB_SequenceBase
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="M_AdvanceLd" Id="{347fdf6b-3850-4913-b001-cdea4e2197f1}">
      <Declaration><![CDATA[// §6.8 ST-skeleton progression: at the END of a `CASE _step OF` body, commit the
// step's shared transition result. On ADVANCE (or a declared JUMPn) go to the
// mapped next step and clear the step-scoped latches so the new step re-arms — the
// exact guarantee the SFC exit action gave, in one call. NONE stays put. The caller
// passes its successor map; an unmapped result holds the step (safe, visible).
METHOD M_AdvanceLd
VAR_INPUT
	Run : BOOL;
    OnAdvance : INT;               // next step for E_StepResult.ADVANCE
    // Jump targets default to "not used" so the common case reads
    // `M_Advance(OnAdvance := 100);` instead of repeating `OnJump1..3 := -1`.
    // Defaulted METHOD inputs need TwinCAT >= 3.1.4026, so on the legacy 4024
    // target (FRAKTAL_TC3_4024 defined) they are declared without defaults and
    // every argument is passed explicitly. See Params/PL_FraktalCompat.TcGVL.
    {IF defined (FRAKTAL_TC3_4024)}
    OnJump1   : INT;               // next step for JUMP1 (-1 = not used)
    OnJump2   : INT;               // next step for JUMP2 (-1 = not used)
    OnJump3   : INT;               // next step for JUMP3 (-1 = not used)
    {ELSE}
    OnJump1   : INT := -1;         // next step for JUMP1 (-1 = not used)
    OnJump2   : INT := -1;         // next step for JUMP2 (-1 = not used)
    OnJump3   : INT := -1;         // next step for JUMP3 (-1 = not used)
    {END_IF}
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Run THEN
	SUPER^.M_Advance(OnAdvance := OnAdvance, OnJump1 := OnJump1, OnJump2 := OnJump2, OnJump3 := OnJump3);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StepLd" Id="{eb1b6a4d-878c-4792-a3b6-96b46f1f3886}">
      <Declaration><![CDATA[// §6.5 step record + the chart-local ActiveStep mirror, one call.
METHOD M_StepLd
VAR_INPUT
	Run : BOOL;
    StepNo : INT;
    StepName : STRING(120);
    Awaits : I_Module;
    AwaitingLabel : STRING(120);
    TimeClass : E_TimeClass;
    ExpectedTime : TIME;
    // §6.12 concurrent leg; 0 = this chain's own. Required here because a ladder
    // box has no defaulted inputs to omit.
    Branch : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Run THEN
	SUPER^.M_Step(StepNo := StepNo, StepName := StepName, Awaits := Awaits, AwaitingLabel := AwaitingLabel, TimeClass := TimeClass, ExpectedTime := ExpectedTime, Branch := Branch);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_AwaitLd" Id="{0ab4f7c1-c6cf-445f-8254-00f9b09accae}">
      <Declaration><![CDATA[// §6.9(b) named plain-condition wait — ladder form: `Run` is the rung's power flow.
// FALSE makes the call a no-op and returns FALSE.
METHOD M_AwaitLd : BOOL
VAR_INPUT
    Run : BOOL;
    Idx : INT;
    Label : STRING(120);
    Ok : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_AwaitLd := FALSE;
IF Run THEN
    M_AwaitLd := SUPER^.M_Await(Idx := Idx, Label := Label, Ok := Ok);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_MayIssueLd" Id="{d31c61df-3ef5-4878-a4b4-37693736d3c6}">
      <Declaration><![CDATA[// §6.1 issue+await one-shot; FALSE when the rung is not powered — ladder form: `Run` is the rung's power flow.
// FALSE makes the call a no-op and returns FALSE.
