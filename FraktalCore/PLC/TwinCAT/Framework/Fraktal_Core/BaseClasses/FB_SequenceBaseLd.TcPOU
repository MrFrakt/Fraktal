    </Method>
    <Method Name="M_Delay" Id="{4bf1443b-1271-424b-981d-a7492d5e9705}">
      <Declaration><![CDATA[// declared process wait; NONE holds the step — ladder form: `Run` is the rung's power flow.
// FALSE makes the call a no-op and returns E_StepResult.NONE.
METHOD M_Delay : E_StepResult
VAR_INPUT
    Run : BOOL;
    PT : TIME;
END_VAR]]></Declaration>
