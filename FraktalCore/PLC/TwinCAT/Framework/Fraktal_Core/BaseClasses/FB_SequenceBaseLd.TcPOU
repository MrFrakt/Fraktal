        <ST><![CDATA[M_MayIssue := FALSE;
IF Run THEN
    M_MayIssue := SUPER^.M_MayIssue(Steppable := Steppable);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Gate" Id="{3a185ff4-e128-4750-afb7-5cb87585f867}">
      <Declaration><![CDATA[// §3.4.2 run-style pacing gate — ladder form: `Run` is the rung's power flow.
