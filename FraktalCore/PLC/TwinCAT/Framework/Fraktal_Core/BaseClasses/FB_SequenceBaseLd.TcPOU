END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_MayIssueLd := FALSE;
IF Run THEN
    M_MayIssueLd := SUPER^.M_MayIssue(Steppable := Steppable);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GateLd" Id="{3a185ff4-e128-4750-afb7-5cb87585f867}">
