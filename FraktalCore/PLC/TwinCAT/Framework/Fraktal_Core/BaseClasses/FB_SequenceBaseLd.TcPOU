END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RunSub" Id="{ff5366eb-e63d-42b4-9cd8-8aa89d688138}">
      <Declaration><![CDATA[// §6.8 run another chain as ONE composite step — ladder form: `Run` is the rung's power flow.
// FALSE makes the call a no-op and returns E_StepResult.NONE.
METHOD M_RunSub : E_StepResult
VAR_INPUT
    Run : BOOL;
    Chain : REFERENCE TO FB_SequenceBase;
    BaseStepNo : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_RunSub := E_StepResult.NONE;
IF Run THEN
    M_RunSub := SUPER^.M_RunSub(Chain := Chain, BaseStepNo := BaseStepNo);
END_IF]]></ST>
      </Implementation>
    </Method>
