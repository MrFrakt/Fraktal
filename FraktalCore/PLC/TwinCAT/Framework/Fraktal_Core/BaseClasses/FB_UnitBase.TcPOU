    <Method Name="M_SequenceRegister" Id="{9c12e1e0-2b54-4710-a719-b7dbb939da2c}">
      <Declaration><![CDATA[// §6.8 register an attached chain (idempotent, bounded). Called from
// FB_SequenceBase.M_Attach, never by project code.
METHOD M_SequenceRegister : BOOL
VAR_INPUT
    Seq : I_Sequence;
END_VAR
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_SequenceRegister := FALSE;
IF Seq = 0 THEN
    RETURN;
END_IF
FOR i := 1 TO _sequenceCount DO
    IF _sequences[i] = Seq THEN
        M_SequenceRegister := TRUE;        // already attached: Setup ran again
        RETURN;
    END_IF
END_FOR
IF _sequenceCount >= PL_Fraktal.MAX_SEQUENCES THEN
    RETURN;                                // bounded; refused, never silently dropped
END_IF
_sequenceCount := _sequenceCount + 1;
_sequences[_sequenceCount] := Seq;
M_SequenceRegister := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_BeginSequenceScan" Id="{90d173ad-1ac7-44ea-8963-773d827fd02e}">
      <Declaration><![CDATA[// §6.10 — reset every attached chain's shared transition result once per
// PLC cycle, before _M_Dispatch drives any step action. This is why a project
// never calls M_BeginScan itself, and why an SFC/LD/FBD chart needs no wiring
// to be safe against a stale ADVANCE (O1).
METHOD PROTECTED _M_BeginSequenceScan
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// §6.12 — close out the legs the previous scan's dispatch stopped recording. A step
// is live exactly while its action keeps calling M_Step, which is the same fact the
// chart draws, so nothing has to be deregistered when a leg finishes. Sweeping legs
// rather than rows makes this ~10 iterations however long the chain is.
FOR i := 0 TO PL_Fraktal.MAX_PARALLEL_BRANCHES DO
    IF (ActiveSteps[i].RowIdx > 0) AND NOT _branchTouched[i] THEN
        // The row keeps how long it ran: the HMI polls too slowly to have timed it.
        SequenceSteps[ActiveSteps[i].RowIdx].LastDuration := ActiveSteps[i].Elapsed;
        ActiveSteps[i].RowIdx := 0;
        ActiveSteps[i].TimedOut := FALSE;
    END_IF
    _branchTouched[i] := FALSE;
END_FOR
FOR i := 1 TO _sequenceCount DO
    IF _sequences[i] <> 0 THEN
        _sequences[i].M_BeginScan();
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SequenceWarn" Id="{75ce463f-f749-4a05-8c5e-fea3607d380d}">
      <Declaration><![CDATA[// §6.9(e) — a step said something worth recording that is not a failure.
// Deliberately does NOT touch _exec: no fault is adopted, _M_Dispatch keeps
// running, and the chain follows its own recovery path. The ring entry is
// AUTO_RESET come+gone (§8.3(c)) so it can never block the next Start.
METHOD M_SequenceWarn : BOOL
VAR_INPUT
    Diag : ST_Diagnostic;
END_VAR
VAR
    d    : ST_Diagnostic;
    slot : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[d := Diag;
IF d.SourcePath = '' THEN
    d.SourcePath := _name;
END_IF
F_RationalizeDiagnostic(Diag := d);   // §8.8 owns a registered reason's level
IF (_seqIndex >= 1) AND (_seqIndex <= SequenceStepCount) THEN
    SequenceSteps[_seqIndex].WarningActive := TRUE;
    // A message about THIS Unit has nowhere to drill; one about a child keeps the
    // child's path, so the chart links to the module the message is about.
    IF d.SourcePath = _name THEN
        _M_SequenceAnnotate(RowIdx := _seqIndex, IsError := FALSE,
            Key := d.Description, SourcePath := '');
    ELSE
        _M_SequenceAnnotate(RowIdx := _seqIndex, IsError := FALSE,
            Key := d.Description, SourcePath := d.SourcePath);
    END_IF
END_IF
slot := AlarmLog.Raise(Reason := d.ReasonCode, Text := d.Description,
    Source := d.SourcePath, Severity := d.Severity, Category := d.Category,
    ResetClass := E_ResetClass.AUTO_RESET);
IF slot > 0 THEN
    AlarmLog.Gone(Slot := slot);       // an occurrence, not a standing condition
END_IF
M_SequenceWarn := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SequenceRaise" Id="{0bee2dd9-d8a8-4946-b400-dc31452b748f}">
      <Declaration><![CDATA[// §6.9 — a step raised a first-out itself. Stamp the flow-chart row with the
// error and its link before adopting the diagnostic, so the §3.13 chart can mark
// the step red and drill into the module that actually failed even when the step
// passed Awaits := 0. Adopting the diagnostic stops the chain: _M_FaultDiag puts
// the Unit in ERROR and _M_Dispatch no longer runs.
METHOD M_SequenceRaise : BOOL
VAR_INPUT
    Diag     : ST_Diagnostic;
    LinkPath : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_SequenceRaise := FALSE;
IF (_seqIndex >= 1) AND (_seqIndex <= SequenceStepCount) THEN
    SequenceSteps[_seqIndex].ErrorActive := TRUE;
    _M_SequenceAnnotate(RowIdx := _seqIndex, IsError := TRUE,
        Key := Diag.Description, SourcePath := LinkPath);
END_IF
_M_FaultDiag(Diag := Diag);
M_SequenceRaise := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_ResumeSequencesAfterError" Id="{f331535e-fb67-4439-a403-97a206176d31}">
      <Declaration><![CDATA[// §6.9 — the ERROR state ended: clear the flow-chart error marks and re-arm
// every attached chain so the step that raised the fault re-evaluates its
// command. A project writes nothing for this (§1.1 O1).
METHOD PROTECTED _M_ResumeSequencesAfterError
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO SequenceStepCount DO
    SequenceSteps[i].ErrorActive := FALSE;
END_FOR
_M_SequenceAnnotationClear(RowIdx := 0, IsError := TRUE);
FOR i := 1 TO _sequenceCount DO
    IF _sequences[i] <> 0 THEN
        _sequences[i].M_ResumeAfterError();
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SequenceSetStep" Id="{cd33b52b-b93d-4827-921b-0507be840f66}">
      <Declaration><![CDATA[// I_SequenceHost (§6.7/§6.8) — step record for a separately-compiled chain.
METHOD M_SequenceSetStep
VAR_INPUT
    StepNo : INT;
    StepName : STRING(120);
    Awaits : I_Module;
    AwaitingLabel : STRING(120);
    TimeClass : E_TimeClass;
    ExpectedTime : TIME;
    Branch : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// §6.12 — a step on a concurrent LEG publishes its own row and nothing else. The
// Unit's CurrentStep, the §6.9 stall walk and the §8.11.4 profiler are singular by
// definition; letting a leg write them would make the walk report whichever leg
// happened to run last. A leg is timed and guarded on its own row instead, so
// _M_SetStep keeps the signature every inline chain already calls (§1.1 O1).
IF Branch > 0 THEN
    _M_RecordSequenceStep(StepNo := StepNo, StepName := StepName, Awaits := Awaits,
        AwaitingLabel := AwaitingLabel, TimeClass := TimeClass, ExpectedTime := ExpectedTime,
        Branch := Branch);
    RETURN;
END_IF
_M_SetStep(StepNo := StepNo, StepName := StepName,
    Awaits := Awaits, AwaitingLabel := AwaitingLabel, TimeClass := TimeClass,
    ExpectedTime := ExpectedTime);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SequenceStepGate" Id="{4300b99e-dada-4558-9a7d-f357bb3b59db}">
      <Declaration><![CDATA[METHOD M_SequenceStepGate : BOOL
VAR_INPUT
    Steppable : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_SequenceStepGate := _M_StepGate(Steppable := Steppable);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SequenceStopNow" Id="{5e2a91d7-38c4-4b0f-a6e8-74d19c2b50f3}">
      <Declaration><![CDATA[// §3.4/§8.11 — accept a pending Stop BETWEEN cycles: the open profile fragment
// (just the wait step) is abandoned, not published as a production cycle.
METHOD M_SequenceStopNow]]></Declaration>
      <Implementation>
        <ST><![CDATA[Profiler.CycleAbandon();
_stopReq := FALSE;
Execute := FALSE;
_M_Complete();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SequenceStopPending" Id="{9b04e7c1-52d8-4f36-8a92-1c65fd83a247}">
      <Declaration><![CDATA[// §3.4 — a chain polls this at its between-cycles wait step.
METHOD M_SequenceStopPending : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_SequenceStopPending := _stopReq AND (_exec = E_ExecState.BUSY);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SequenceTakeDecision" Id="{a0cad3a5-90f7-4b63-9dfc-d75845d8e702}">
      <Declaration><![CDATA[METHOD M_SequenceTakeDecision : INT]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_SequenceTakeDecision := _M_TakeDecision();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ManualCommandTo" Id="{4de99325-2725-4710-8292-b2f11cd5c61c}">
      <Declaration><![CDATA[// §7.6.1 — single gated manual-command entry for the HMI. Accepts ONLY when this
// Unit is in MANUAL (§3.4) AND the user holds MANUAL access (§7.7). Routes to the
// target module's ManualCommand (through the command surface — defended, not
// bypassed). Logs every accept/reject as a §8.3 event. Concrete Units override
// _M_RouteManual to map TargetPath -> the child module.
METHOD ManualCommandTo : BOOL
VAR_INPUT
    TargetPath : STRING(255);
    Value : DINT;
END_VAR
VAR
    auditSlot : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ManualCommandTo := FALSE;
IF _mode <> E_Mode.MANUAL THEN
    auditSlot := AlarmLog.Raise(Reason := E_Reason.NONE,
        Text := 'std.audit.manualCommandWrongMode', Source := TargetPath,
        Severity := E_Severity.LOW, Category := E_Category.SYSTEM, ResetClass := E_ResetClass.AUTO_RESET);
    IF auditSlot > 0 THEN AlarmLog.Gone(Slot := auditSlot); END_IF
    RETURN;
END_IF
IF NOT Access.PermitsLogged(Gate := E_GatedAction.MANUAL) THEN
    RETURN;                              // §7.7 denial already audited
END_IF
ManualCommandTo := _M_RouteManual(TargetPath := TargetPath, Value := Value);
IF ManualCommandTo THEN
    auditSlot := AlarmLog.Raise(Reason := E_Reason.NONE,
        Text := 'std.audit.manualCommandAccepted', Source := TargetPath,
        Severity := E_Severity.LOW, Category := E_Category.SYSTEM, ResetClass := E_ResetClass.AUTO_RESET);
ELSE
    auditSlot := AlarmLog.Raise(Reason := E_Reason.UNSUPPORTED_COMMAND,
        Text := 'std.audit.manualCommandRejected', Source := TargetPath,
        Severity := E_Severity.LOW, Category := E_Category.SYSTEM, ResetClass := E_ResetClass.AUTO_RESET);
END_IF
IF auditSlot > 0 THEN AlarmLog.Gone(Slot := auditSlot); END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ModeActive" Id="{cadd011f-36e9-480f-9687-f764db6a93a1}">
      <Declaration><![CDATA[PROPERTY ModeActive : E_Mode]]></Declaration>
      <Get Name="Get" Id="{480f723e-9802-4414-9cf5-b9bf28538b7e}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ModeActive := _mode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ModelCode" Id="{52be901d-358c-42d1-8de9-24cabf037285}">
      <Declaration><![CDATA[PROPERTY ModelCode : STRING(64)]]></Declaration>
      <Get Name="Get" Id="{d1228112-dc00-4a78-8d96-06a0aa3db5e2}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ModelCode := Model.ModelCode;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ModuleType" Id="{19c4f994-fbe0-4e50-80d5-d89b1a1fb1fa}">
      <Declaration><![CDATA[PROPERTY ModuleType : E_ModuleType]]></Declaration>
      <Get Name="Get" Id="{e694d09e-29b1-48cc-b1e6-0d26ae208150}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ModuleType := E_ModuleType.UNIT;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnCyclic" Id="{833bee58-3464-412f-8fa3-37fa398fef55}">
      <Declaration><![CDATA[// base first (§3.14.2); then children, one-shot init, mode transition, stall watch
METHOD PROTECTED OnCyclic : DINT
VAR
    publishIdx : INT;
    modeIdx    : E_Mode;
    styleIdx   : E_RunStyle;
    previousMode : E_Mode;
    modeExitResult : DINT;
    highestSeverity : E_Severity;
    alarmActive : BOOL;
    heldReported : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnCyclic := SUPER^.OnCyclic();
_M_BeginSequenceScan();                               // §6.10 one-scan result reset for every attached chain
_M_TickChildren();
_M_OeeUpdate();                                       // §8.5.1 time accounting + sampling
AlarmLog.Cyclic();                                    // §8.10 shelf auto-expiry
_M_EngineeringCyclic();                               // §7.5.2 standing gate annunciation
_healthPublisher.Cyclic(Input := _healthInput, ParCfg := _healthParCfg,
    Configured := _healthConfigured);                 // §2.7/§8.12 alarm edges + values
SystemHealth := _healthPublisher.Status;
_M_HandleHmiRequest();                                // §3.10 request mailbox
_M_DecisionCyclic();                                  // §6.11 timeout/default/overlap resolver
Access.Cyclic();
alarmActive := _M_HighestSeverity(Highest := highestSeverity);
_towerMapper.Cyclic(MachineState := MachineState, AlarmActive := alarmActive,
    HighestSeverity := highestSeverity,
    OperatorActionRequired := (Decision.Prompt <> ''),
    LampTestRequest := _lampTestRequest, ParCfg := _towerParCfg);
_lampTestRequest := FALSE;
SignalTower := _towerMapper.Status;
// §9.8 data-driven Control On/Off request endpoint. Off wins if both arrive;
// the domain/power-group implementation still validates safety, health and rearm.
ControlOnRequest := FALSE;
ControlOffRequest := FALSE;
IF ReqControlOff THEN
    ReqControlOff := FALSE;
    ReqControlOn := FALSE;
    IF Access.PermitsLogged(Gate := E_GatedAction.POWER_CONTROL) THEN
        ControlOffRequest := TRUE;
    END_IF
ELSIF ReqControlOn THEN
    ReqControlOn := FALSE;
    IF Access.PermitsLogged(Gate := E_GatedAction.POWER_CONTROL) THEN
        ControlOnRequest := TRUE;
    END_IF
END_IF
// §3.14.4 — pending mode change; §3.4.1 style decides graceful vs immediate
IF _modePend THEN
    IF _exec = E_ExecState.BUSY THEN
        IF ModePolicy[TO_INT(_mode)].Style = E_ModeSwitchStyle.GRACEFUL THEN
            _stopReq := TRUE;                             // finish the cycle at its stop point
        ELSE
            modeExitResult := OnModeExit(FirstCall := _modeExitFirst,
                RequestedMode := _modeReq);
            _modeExitFirst := FALSE;
            IF modeExitResult = 0 THEN
                OnAbort();                                // IMMEDIATE: cancel now (override may defer)
            END_IF
        END_IF
    ELSE
        IF _exec <> E_ExecState.READY THEN
            Execute := FALSE;                             // release the run command (§6.1 reset)
        ELSE
            previousMode := _mode;
            _mode := _modeReq;
            _modePend := FALSE;
            _modeExitFirst := FALSE;
            _M_CascadeMode(_mode);                        // §3.7 cascade [TC3]
            OnModeChanged(NewMode := _mode, OldMode := previousMode);
        END_IF
    END_IF
END_IF
// §8.3(c) — automatic fault capture: ERROR entry raises, ERROR exit marks gone
IF (_exec = E_ExecState.ERROR) AND (_faultEvt = 0) THEN
    _faultEvt := AlarmLog.RaiseDiag(D := _diag, ResetClass := E_ResetClass.MANUAL_RESET);
    _M_PartAborted();                  // §3.16.3: a faulted part leaves without a valid result
ELSIF (_exec <> E_ExecState.ERROR) AND (_faultEvt > 0) THEN
    AlarmLog.Gone(Slot := _faultEvt);                            // -> WAIT_RESET (blocking)
    _faultEvt := 0;
END_IF
// §6.9 — instant rollup on awaited Error; adopt a HELD child; stall as PENDING otherwise
IF _exec = E_ExecState.BUSY THEN
    IF (_awaits <> 0) AND_THEN _awaits.FaultActive THEN
        _M_FaultDiag(_awaits.GetFaultSummary());
    ELSE
        // §6.1 HELD — the held module is waiting on a condition it can name, so
        // report THAT instead of letting StallTime expire into a generic stall. A
        // declared wait is not a stall, so the watchdog stays disarmed while it lasts.
        //
        // The hold rolls up whether or not the step awaits the child (§1.1 O1: the
        // project must not have to remember a call to stay correct). `Awaits := 0`
        // says "this step owns the child's FAULT disposition" (§6.9, press AUTO
        // N200 offering scrap/return) - it does not say "stay silent while the ram
        // is HELD". A hold is recoverable information that clears itself and never
        // blocks a restart, so suppressing it only produced a Unit that sat BUSY
        // with an empty diagnostic while its own child correctly reported Held.
        // Prefer the awaited module: when a step named one it is the most specific
        // source. _M_RollupHold is called on exactly the scans the awaited branch
        // did not fire, because TwinCAT does not short-circuit and calling both
        // would let a second held child overwrite the named one.
        heldReported := FALSE;
        IF (_awaits <> 0) AND_THEN _awaits.HoldActive THEN
            _M_HoldDiag(Diag := _awaits.GetFaultSummary());
            heldReported := TRUE;
        ELSE
            heldReported := _M_RollupHold();   // §8.2 first held registered child
        END_IF
        IF heldReported THEN
            _tStall(IN := FALSE);
        ELSE
            IF Held THEN
                _M_ClearPending();     // the hold ended: drop any stall text it outlived
            END_IF
            _tStall(IN := TRUE, PT := SEL(CurrentStep.ExpectedTime > T#0S, StallTime, CurrentStep.ExpectedTime));
            IF _tStall.Q THEN
                _M_StallWalk();
            END_IF
        END_IF
    END_IF
ELSE
    _tStall(IN := FALSE);
END_IF
// §6.9(a) — every new fault joins the shift-change ring, no historian needed
_fTrig(CLK := (_exec = E_ExecState.ERROR));
_errClr(CLK := (_exec <> E_ExecState.ERROR));
IF _errClr.Q THEN
    _M_ResumeSequencesAfterError();   // §6.9 re-evaluate, do not resume blind
END_IF
IF _fTrig.Q THEN
    _M_PushHistory(_diag);
END_IF
// §8.11.4(d) — creeping WORK time is a MAINTENANCE event (Low), not downtime:
// the profiler pulses once per excursion past the configured baseline band.
IF Profiler.DegradedTrig THEN
    _M_RaiseMaintenance(Reason := E_Reason.CYCLE_TIME_DEGRADED,
        Text := 'std.maintenance.cycleTimeDegraded');
END_IF
ModeActivePublished := _mode;
RunningPublished := (_exec = E_ExecState.BUSY);
StopPendingPublished := _stopReq AND (_exec = E_ExecState.BUSY);
FOR publishIdx := 0 TO PL_Fraktal.MODE_COUNT - 1 DO
    modeIdx := publishIdx;
    SupportedModesPublished[publishIdx] := _M_Supports(Mode := modeIdx);
END_FOR
FOR publishIdx := 0 TO 2 DO
    styleIdx := publishIdx;
    SupportedRunStylesPublished[publishIdx] := _M_SupportsRunStyle(Style := styleIdx);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_HighestSeverity" Id="{06beeb70-94f2-4095-9daa-a1af1fd36a20}">
      <Declaration><![CDATA[// §8.13 — derive the tower input from the authoritative active-event table.
METHOD PRIVATE _M_HighestSeverity : BOOL
VAR_IN_OUT
    Highest : E_Severity;
END_VAR
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[_M_HighestSeverity := FALSE;
Highest := E_Severity.LOW;
FOR i := 1 TO PL_Fraktal.MAX_ALARM_ACTIVE DO
    IF AlarmLog.Active[i].State <> E_AlarmState.CLOSED THEN
        IF NOT _M_HighestSeverity OR (AlarmLog.Active[i].Severity > Highest) THEN
            Highest := AlarmLog.Active[i].Severity;
        ELSE
            ;
        END_IF
        _M_HighestSeverity := TRUE;
    ELSE
        ;
    END_IF
END_FOR]]></ST></Implementation>
    </Method>
    <Method Name="RequestLampTest" Id="{0a1df30a-092c-4f3f-91a5-1af799e7cb11}">
      <Declaration><![CDATA[// §8.13 — remote request is MANUAL-gated and starts only while the Unit is idle.
METHOD RequestLampTest : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[RequestLampTest := FALSE;
IF _exec = E_ExecState.BUSY THEN
    RETURN;
END_IF
IF NOT Access.PermitsLogged(Gate := E_GatedAction.MANUAL) THEN
    RETURN;
END_IF
_lampTestRequest := TRUE;
RequestLampTest := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="SetSignalTowerConfig" Id="{93bf4461-f32d-446c-ac46-8d0b800f56d9}">
      <Declaration><![CDATA[// Startup station-convention seam. Runtime config writes require a registered
// typed capability; this method is not published by OPC UA.
METHOD SetSignalTowerConfig : BOOL
VAR_INPUT
    ParCfg : ST_SignalTowerParCfg;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[IF (ParCfg.SchemaVersion <> 1) OR (ParCfg.LampTestDuration <= T#0S) THEN
    SetSignalTowerConfig := FALSE;
    RETURN;
END_IF
_towerParCfg := ParCfg;
SetSignalTowerConfig := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="SetSystemHealth" Id="{f544458e-b3ee-4aad-ac8d-2565c5120fa3}">
      <Declaration><![CDATA[// TC3/platform adapter injection. Raw probe values remain OPC-UA-hidden; the
// health publisher validates and republishes the bounded status surface.
METHOD SetSystemHealth : BOOL
VAR_INPUT
    Input  : ST_SystemHealthInput;
    ParCfg : ST_SystemHealthParCfg;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[IF ParCfg.SchemaVersion <> 1 THEN
    SetSystemHealth := FALSE;
    RETURN;
END_IF
_healthInput := Input;
_healthParCfg := ParCfg;
_healthConfigured := TRUE;
SetSystemHealth := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="OnInit" Id="{c11afaa2-3957-4d40-8695-293ff272dfc1}">
      <Declaration><![CDATA[// §3.14 hook — one-shot after first operational scan
METHOD PROTECTED OnInit : DINT
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnInit := SUPER^.OnInit();
SequenceViewEnabled := TRUE;   // §3.13 a Unit has a chain worth drawing;
                               // a concrete Unit may vary this per mode
Access.Setup(Provider := 0, pAlarmLog := ADR(AlarmLog)); // preserves an injected provider
_healthPublisher.Setup(SourcePath := CONCAT(Status.Name, '.SystemHealth'),
    pAlarmLog := ADR(AlarmLog));
IF _modePolicyVersion <> 1 THEN
    _M_InitModePolicy();
    FOR i := 0 TO PL_Fraktal.MODE_COUNT - 1 DO
        _modePolicyStored[i] := ModePolicy[i];
    END_FOR
    _modePolicyVersion := 1;
ELSE
    FOR i := 0 TO PL_Fraktal.MODE_COUNT - 1 DO
        ModePolicy[i] := _modePolicyStored[i];
    END_FOR
END_IF
// §3.10.2 — seed the manifest revision from boot time so every PLC restart or
// re-activation yields a NEW value (a plain counter would repeat after reboot
// and an HMI could keep a stale manifest undetected). Config writes increment.
ConfigRev := DT_TO_UDINT(F_Now());]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnModeChanged" Id="{4307796c-f352-4515-b104-1671ef41b10c}">
      <Declaration><![CDATA[// §3.14 hook — after the new mode is committed
METHOD PROTECTED OnModeChanged : DINT
VAR_INPUT
    NewMode : E_Mode;
    OldMode : E_Mode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_HostEvent(Kind := E_HostEventKind.MODE_CHANGED, PartUid := '',
    Subject := 'Mode', Value := TO_STRING(TO_DINT(NewMode)),
    Verdict := E_Verdict.NONE, ReasonCode := E_Reason.NONE);
// §3.13 — the chart belongs to the mode that is running. A project writes nothing
// for this: it lands in the base hook every override calls SUPER^ on first (§3.14.2).
_M_ResetSequenceRows();
OnModeChanged := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCommandStart" Id="{4698d7ce-6d4c-492c-9ead-e072c285ae34}">
      <Declaration><![CDATA[// Core §11.6: CHANGEOVER starts when its guided sequence actually starts, not
// merely when the operator selects the mode or transactionally loads a model.
METHOD PROTECTED OnCommandStart : DINT]]></Declaration>
      <Implementation><ST><![CDATA[OnCommandStart := SUPER^.OnCommandStart();
IF _mode = E_Mode.CHANGEOVER THEN
    _M_HostEvent(Kind := E_HostEventKind.CHANGEOVER_STARTED, PartUid := '',
        Subject := 'Model', Value := Model.ModelCode,
        Verdict := E_Verdict.NONE, ReasonCode := E_Reason.NONE);
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="OnModeExit" Id="{d824838b-6d6c-4575-ade3-00f3815d6c9e}">
      <Declaration><![CDATA[// §3.14.4 — called every scan while a mode request is pending and the Unit is BUSY.
// Return 0 = consent to immediate cancel (default); >0 = still stopping gracefully.
METHOD PROTECTED OnModeExit : DINT
VAR_INPUT
    FirstCall : BOOL;
    RequestedMode : E_Mode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnModeExit := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OperatorReset" Id="{86e0365e-0665-41e9-b6f4-1156fe1cf971}">
      <Declaration><![CDATA[// §8.3(b) — deliberate operator reset of blocking events (release-gated per §7.6/§14).
// ONE operator action has to make the Unit restartable, so this closes the blocking
// events AND clears the latched control state they were reporting: see _M_RecoverState.
METHOD OperatorReset : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.ALARM_RESET) THEN
    OperatorReset := FALSE;            // §7.7
    RETURN;
END_IF
OperatorReset := _M_RecoverState();
OperatorReset := AlarmLog.OperatorReset() OR OperatorReset;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_RecoverState" Id="{2d0b998f-abd6-473c-8cb5-b6b35c39d09a}">
      <Declaration><![CDATA[// §8.3(b)/§6.1 — the control-state half of a reset. Closing the alarm alone left the
// machine locked: the Unit's run command and the child commands its mode chain had
// issued both stayed asserted, and §6.1's Execute-drop reset — the only exit from a
// latched terminal state — needs them LOW. A frozen chain cannot drop them itself,
// because a Unit that is not BUSY never calls _M_Dispatch again, so the step holding
// `child.Execute := TRUE` never runs. Nothing else in the system clears it, and the
// next Start re-issues the same already-TRUE input: no rising edge, the child stays
// in ERROR, and the Unit re-adopts the fault through the §8.2 rollup. That is the
// press hard-lock. Returns TRUE when there was something to recover.
// Deliberately does NOT clear ERROR here: Cyclic keeps that ownership (§6.1), so a
// cause that is still live re-faults on the next command edge instead of vanishing.
METHOD PROTECTED _M_RecoverState : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_RecoverState := FALSE;
IF (_exec <> E_ExecState.ERROR) AND NOT AlarmLog.Blocking THEN
    RETURN;                            // nothing latched: a stray reset changes nothing
END_IF
OnOperatorReset();                     // §3.14 hook: withdraw outputs, reset mode chains
_M_ReleaseChildCommands();             // stranded child commands -> READY next scan
_M_ClearPending();
_stopReq := FALSE;
IF _exec = E_ExecState.BUSY THEN
    // Defined safe reaction (§5.6) for a blocking event raised by application code
    // while the mode chain still runs: a recovery reset cancels what was running
    // rather than leaving a chain we just reset still driving the machine.
    AbortCommand();
END_IF
Execute  := FALSE;                     // stale run command -> Unit READY next scan
_faultEvt := 0;                        // the event is closed here, not by a later Gone()
_M_RecoverState := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnOperatorReset" Id="{ad173c6c-fa19-47ee-a347-f5b5e0c7654a}">
      <Declaration><![CDATA[// §3.14 hook — an accepted operator reset is recovering this Unit. Override to
// withdraw application outputs and reset application-owned mode chains before the
// base releases the run command; call SUPER^.OnOperatorReset() first (§3.14.2).
// Called only when something was actually latched (ERROR or a blocking alarm), so an
// override may assume it is a recovery, not a routine poll.
METHOD PROTECTED OnOperatorReset : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnOperatorReset := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestLocalReset" Id="{2ac5c84b-a29d-437a-b5c9-0d4b5d278812}">
      <Declaration><![CDATA[// Application-only seam for an ordinary hardwired fault-reset/acknowledge button,
// mirroring RequestLocalControl (§9.8): it is a METHOD, not OPC UA data, so remote
// clients still go through the access-gated OPERATOR_RESET request and cannot reach
// this path. A cabinet button IS its own authorization (physical presence), so it
// carries no §7.7 session check — but the reset is still audited as a §8.3 event,
// and it recovers exactly the same state as an operator reset, never more.
// The composition root calls this from its hardware driver on the button's rising
// edge, once per root Unit it should clear.
METHOD RequestLocalReset : BOOL
VAR
    auditSlot : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[auditSlot := AlarmLog.Raise(Reason := E_Reason.NONE,
    Text := 'std.audit.localResetRequested', Source := _name,
    Severity := E_Severity.LOW, Category := E_Category.SYSTEM,
    ResetClass := E_ResetClass.AUTO_RESET);
IF auditSlot > 0 THEN AlarmLog.Gone(Slot := auditSlot); END_IF
RequestLocalReset := _M_RecoverState();
RequestLocalReset := AlarmLog.OperatorReset() OR RequestLocalReset;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterAvailableModel" Id="{651bb1e1-71c6-4fb4-a063-4ea057e752cf}">
      <Declaration><![CDATA[// §3.8 optional HMI/MES selection catalog. Recipe providers remain pluggable;
// the application registers only the model identities it deliberately exposes.
METHOD RegisterAvailableModel : BOOL
VAR_INPUT
    Id : ST_ModelId;
END_VAR
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RegisterAvailableModel := FALSE;
IF (Id.ModelCode = '') OR (AvailableModelCount >= PL_Fraktal.MAX_RECIPES) THEN
    RETURN;
END_IF
FOR i := 1 TO AvailableModelCount DO
    IF AvailableModels[i].ModelCode = Id.ModelCode THEN
        RETURN;
    END_IF
END_FOR
AvailableModelCount := AvailableModelCount + 1;
AvailableModels[AvailableModelCount] := Id;
ConfigRev := ConfigRev + 1;    // §3.10.2 — manifest changed
RegisterAvailableModel := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestControlPower" Id="{cb696b98-d3f2-48ed-8f23-09e45169ea5f}">
      <Declaration><![CDATA[// §9.8 remote control-domain request. The acknowledgement is the result of this
// authorization check; it is never reported accepted before POWER_CONTROL runs.
METHOD RequestControlPower : BOOL
VAR_INPUT
    ControlOn : BOOL;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[RequestControlPower := FALSE;
IF NOT Access.PermitsLogged(Gate := E_GatedAction.POWER_CONTROL) THEN
    RETURN;
END_IF
IF ControlOn THEN
    ReqControlOn := TRUE;
    ReqControlOff := FALSE;
ELSE
    ReqControlOff := TRUE;                         // Off wins if both were requested
    ReqControlOn := FALSE;
END_IF
RequestControlPower := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="SubmitDecision" Id="{70347f2b-2424-4514-beb7-8788c8d00fca}">
      <Declaration><![CDATA[// §6.11 authoritative decision entry. START_STOP is the access gate because the
// answer advances a running Unit chain; option-specific process releases append
// through _M_AppendDecisionInterlocks. A stale/invalid answer never latches.
METHOD SubmitDecision : BOOL
VAR_INPUT
    Option : INT;
END_VAR
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[Report.Count := 0;
Report.Released := FALSE;
SubmitDecision := FALSE;
IF NOT Access.PermitsLogged(Gate := E_GatedAction.START_STOP) THEN
    _M_AddReason(Report := Report, Text := 'std.release.insufficientStartStop',
        Reason := E_Reason.NONE, Kind := E_ReleaseKind.ACCESS);
END_IF
IF (_exec <> E_ExecState.BUSY) OR (Decision.Prompt = '') THEN
    _M_AddReason(Report := Report, Text := 'std.release.noActiveDecision',
        Reason := E_Reason.NONE, Kind := E_ReleaseKind.OTHER);
ELSIF (Option < 1) OR (Option > PL_Fraktal.MAX_OPTIONS) THEN
    _M_AddReason(Report := Report, Text := 'std.release.invalidDecisionOption',
        Reason := E_Reason.UNSUPPORTED_COMMAND, Kind := E_ReleaseKind.OTHER);
ELSIF Decision.Options[Option] = '' THEN
    _M_AddReason(Report := Report, Text := 'std.release.invalidDecisionOption',
        Reason := E_Reason.UNSUPPORTED_COMMAND, Kind := E_ReleaseKind.OTHER);
ELSE
    _M_AppendDecisionInterlocks(Option := Option, Report := Report);
END_IF
Report.Released := (Report.Count = 0);
IF Report.Released THEN
    DecisionAnswer := Option;
    SubmitDecision := TRUE;
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="SetAccessLevel" Id="{a2b5995c-ea0a-4911-83f3-0a5e24269563}">
      <Declaration><![CDATA[// §7.7 persistent per-root policy edit. The policy's own ACCESS_POLICY threshold
// is rechecked before any threshold — including itself — can change.
METHOD SetAccessLevel : BOOL
VAR_INPUT
    Gate : E_GatedAction;
    Level : E_AccessLevel;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[SetAccessLevel := FALSE;
IF NOT Access.PermitsLogged(Gate := E_GatedAction.ACCESS_POLICY) THEN
    RETURN;
END_IF
// Never allow an anonymous/lower session to raise the policy above itself and
// strand the retained station configuration without a usable administrator.
IF (Gate = E_GatedAction.ACCESS_POLICY) AND (Level > Access.CurrentLevel) THEN
    RETURN;
END_IF
SetAccessLevel := Access.ConfigureRequired(Gate := Gate, Level := Level);
IF SetAccessLevel THEN
    ConfigRev := ConfigRev + 1;
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="SetSessionTimeout" Id="{e8244b36-18c3-4b2a-8ef7-db39a1dfa257}">
      <Declaration><![CDATA[// §7.7 persistent idle timeout (0 = never), self-gated by ACCESS_POLICY.
METHOD SetSessionTimeout : BOOL
VAR_INPUT
    TimeoutMs : UDINT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[SetSessionTimeout := FALSE;
IF NOT Access.PermitsLogged(Gate := E_GatedAction.ACCESS_POLICY) THEN
    RETURN;
END_IF
SetSessionTimeout := Access.ConfigureSessionTimeout(TimeoutMs := TimeoutMs);
IF SetSessionTimeout THEN
    ConfigRev := ConfigRev + 1;
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="WriteConfig" Id="{3e40e571-e45f-4204-a5d3-c9907077e8b2}">
      <Declaration><![CDATA[// §3.8a/§7.7 centralized HMI configuration authority. Concrete overrides never
// need to remember DATA_WRITE or root ownership; they validate only their field.
METHOD WriteConfig : BOOL
VAR_INPUT
    TargetPath : STRING(255);
    WriteKey : STRING(160);
    Revision : DINT;
    TextValue : STRING(255);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[WriteConfig := FALSE;
IF NOT Access.PermitsLogged(Gate := E_GatedAction.DATA_WRITE) THEN
    RETURN;
END_IF
IF (WriteKey = '') OR (Revision <= 0)
OR NOT _M_OwnsModulePath(Path := TargetPath) THEN
    RETURN;
END_IF
WriteConfig := _M_WriteBaseConfig(TargetPath := TargetPath, WriteKey := WriteKey,
    Revision := TO_UDINT(Revision), TextValue := TextValue);
IF NOT WriteConfig THEN
    WriteConfig := _M_RouteConfigWrite(TargetPath := TargetPath,
        WriteKey := WriteKey, Revision := TO_UDINT(Revision), TextValue := TextValue);
END_IF
IF WriteConfig THEN
    ConfigRev := ConfigRev + 1;
END_IF]]></ST></Implementation>
    </Method>
          <Method Name="CaptureConfig" Id="{6657c29b-54a9-410f-b368-d4a1ad1bb646}">
        <Declaration><![CDATA[// §3.8c - the root authority for a capture. Deliberately the same gate, the same
// ownership check and the same ConfigRev bump as WriteConfig: a capture is a
// write whose value came from the machine, and it is no more and no less
// privileged than one the operator typed (§3.8c(d)).
METHOD CaptureConfig : BOOL
VAR_INPUT
    TargetPath : STRING(255);
    WriteKey   : STRING(160);
    Revision   : DINT;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[CaptureConfig := FALSE;
IF NOT Access.PermitsLogged(Gate := E_GatedAction.DATA_WRITE) THEN
    RETURN;
END_IF
IF (WriteKey = '') OR (Revision <= 0)
OR NOT _M_OwnsModulePath(Path := TargetPath) THEN
    RETURN;
END_IF
// Framework-owned keys offer no capture: they are policy, not measurements.
CaptureConfig := M_ApplyCapture(Scope := TargetPath, WriteKey := WriteKey,
    Revision := TO_UDINT(Revision), RootReady := (_exec = E_ExecState.READY));
IF CaptureConfig THEN
    ConfigRev := ConfigRev + 1;
END_IF]]></ST>
        </Implementation>
      </Method>
<Method Name="SetEngineeringMode" Id="{28e702f3-e7d8-4e5a-8206-7208a16b6696}">
      <Declaration><![CDATA[// Core §7.5.1 — inject the station's commissioning/engineering gate register at
// Setup, the same shape as SetPartCarrier. Wiring it is what makes the §7.5.2
// standing annunciation appear and what arms the §10.5.1 force surface; a Unit
// with no register is a production Unit and both are simply absent.
//
// Declaring the framework's OWN force gate happens here rather than in the
// project, so a composition root that wires the register cannot forget it
// (§1.1 O1) and cannot arm forcing without also annunciating it.
METHOD SetEngineeringMode
VAR_INPUT
    Mode : REFERENCE TO FB_EngineeringMode;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[_engineering REF= Mode;
IF __ISVALIDREF(_engineering) THEN
    _engineering.M_DeclareOutputForcing();
ELSE
    ;
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="M_ForcePermitted" Id="{b9d8bf79-0c6d-4741-99f8-f427bda243e9}">
      <Declaration><![CDATA[// Core §10.5.1 rules 1 and 3 — may a held force set-point be applied to this
// Unit's outputs right now? The project hardware driver passes the result to
// FB_IoTopologyPublisher.M_ApplyForces every scan, and ForceChannel gates the
// operator request on the identical predicate, so "accepted" and "applied" can
// never disagree. Everything else about a force (access, ownership, direction,
// mapping) is proved elsewhere; this is only the build gate and the mode/state.
METHOD M_ForcePermitted : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[M_ForcePermitted := FALSE;
IF NOT __ISVALIDREF(_engineering) THEN
    RETURN;
END_IF
IF NOT _engineering.ForcingActive THEN
    RETURN;
END_IF
// A running module reasserts its own outputs, so a force is only honest while
// the Unit is idle in MANUAL; leaving either withdraws every force (§10.5.1(3)).
M_ForcePermitted := (_mode = E_Mode.MANUAL) AND (_exec = E_ExecState.READY);]]></ST></Implementation>
    </Method>
    <Method Name="_M_EngineeringCyclic" Id="{0b6876ea-bb0c-4e77-ab09-61eab13a8627}">
      <Declaration><![CDATA[// Core §7.5.2 — the standing annunciation: one LOW/SYSTEM/AUTO_RESET event per
// registered gate, for as long as that gate is registered.
//
// Why each choice is the way it is, because every one of them is load-bearing:
//   AUTO_RESET  a MANUAL_RESET event refuses Start (§8.3(b)), which would make
//               commissioning gates block the commissioning they exist to serve;
//   LOW/SYSTEM  the lowest priority and the lowest risk class - this says how the
//               software was BUILT, not that the process or safety is impaired,
//               and a louder class would displace real alarms (§8.9);
//   unclearable OperatorReset only closes MANUAL_RESET events, so no operator
//               action reaches this one, and its §8.9 record is not shelvable, so
//               §8.10 cannot silence it either. It closes when the gate is gone -
//               which, gates being build constants, means a new download.
METHOD PRIVATE _M_EngineeringCyclic
VAR
    i : INT;
    gateCount : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[IF NOT __ISVALIDREF(_engineering) THEN
    RETURN;
END_IF
gateCount := _engineering.Count;
IF gateCount > PL_Fraktal.MAX_ENGINEERING_GATES THEN
    gateCount := PL_Fraktal.MAX_ENGINEERING_GATES;
END_IF
FOR i := 1 TO gateCount DO
    // Self-healing on purpose. If this slot were ever closed and reused by
    // another event, a remembered index would leave the annunciation silently
    // absent for the rest of the run - the one failure mode a non-clearable
    // message must not have. Re-verify identity, then re-raise.
    IF _engineeringEvt[i] > 0 THEN
        IF (AlarmLog.Active[_engineeringEvt[i]].State = E_AlarmState.CLOSED)
        OR (AlarmLog.Active[_engineeringEvt[i]].ReasonCode <> E_Reason.COMMISSIONING_GATE_ACTIVE) THEN
            _engineeringEvt[i] := 0;
        ELSE
            ;
        END_IF
    ELSE
        ;
    END_IF
    IF _engineeringEvt[i] = 0 THEN
        _engineeringEvt[i] := AlarmLog.Raise(Reason := E_Reason.COMMISSIONING_GATE_ACTIVE,
            Text := _engineering.Gates[i].DescriptionKey, Source := _name,
            Severity := E_Severity.LOW, Category := E_Category.SYSTEM,
            ResetClass := E_ResetClass.AUTO_RESET);
    ELSE
        ;
    END_IF
END_FOR]]></ST></Implementation>
    </Method>
    <Method Name="ForceChannel" Id="{8bf9fd9d-8084-4dbf-b41b-c60e5e0cc995}">
      <Declaration><![CDATA[// §10.5.1 centralized force authority. Only an idle MANUAL Unit may reach the
// application resolver; that resolver still proves root ownership, OUTPUT,
// non-safety identity, mapping and the channel-specific release.
METHOD ForceChannel : BOOL
VAR_INPUT
    ChannelPath : STRING(255);
    Force : BOOL;
    BoolText : STRING(255);
    AnalogText : STRING(160);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[ForceChannel := FALSE;
IF NOT Access.PermitsLogged(Gate := E_GatedAction.MANUAL) THEN
    RETURN;
END_IF
// §10.5.1 rules 1 and 3 in one predicate, the same one the hardware driver
// applies each scan - so the request can never be accepted under conditions
// under which the force would not actually be applied.
IF NOT M_ForcePermitted() OR (ChannelPath = '') THEN
    RETURN;
END_IF
ForceChannel := _M_RouteForceChannel(ChannelPath := ChannelPath, Force := Force,
    BoolText := BoolText, AnalogText := AnalogText);]]></ST></Implementation>
    </Method>
    <Method Name="ReleaseReportAction" Id="{b52c134c-be50-4c5c-b4df-ad025ff72931}">
      <Declaration><![CDATA[// Core §7.8 — full rollup for the simpler gated Unit actions (Stop, ALARM_RESET,
// CHANGEOVER, MODE_CHANGE, step). Same predicate the gates use. Start has its own
// richer ReleaseReportStart (interlocks); manual has ReleaseReportManual (target).
METHOD ReleaseReportAction : BOOL
VAR_INPUT
    Gate : E_GatedAction;
END_VAR
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Report.Count := 0;
Report.Released := FALSE;
// access is the common gate
IF NOT Access.Permits(Gate := Gate) THEN
    _M_AddReason(Report := Report, Text := 'std.release.insufficientAction', Reason := E_Reason.NONE, Kind := E_ReleaseKind.ACCESS);
END_IF
// per-action state preconditions
CASE Gate OF
    E_GatedAction.CHANGEOVER:
        IF _exec = E_ExecState.BUSY THEN
            _M_AddReason(Report := Report, Text := 'std.release.changeoverRunning', Reason := E_Reason.NONE, Kind := E_ReleaseKind.MODE);
        END_IF
    E_GatedAction.ALARM_RESET:
        IF NOT AlarmLog.Blocking THEN
            _M_AddReason(Report := Report, Text := 'std.release.noBlockingAlarm', Reason := E_Reason.NONE, Kind := E_ReleaseKind.OTHER);
        END_IF
    E_GatedAction.MODE_CHANGE:
        IF _modePend THEN
            _M_AddReason(Report := Report, Text := 'std.release.modeChangeAlreadyPending', Reason := E_Reason.NONE, Kind := E_ReleaseKind.MODE);
        ELSIF (_exec = E_ExecState.BUSY)
        AND (ModePolicy[TO_INT(_mode)].Shield = E_ModeSwitchShield.BLOCKED_WHILE_RUNNING) THEN
            _M_AddReason(Report := Report, Text := 'std.release.modeSwitchBlockedWhileRunning',
                Reason := E_Reason.NONE, Kind := E_ReleaseKind.MODE);
        ELSE
            ;
        END_IF
ELSE
    ;                                          // actions with no extra state predicate
END_CASE
Report.Released := (Report.Count = 0);
ReleaseReportAction := Report.Released;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseReportManual" Id="{9e9f491d-e5a8-435c-bc95-8f93e8c3530b}">
      <Declaration><![CDATA[// Core §7.8 — full rollup of why a manual command to Target would be refused (§7.6.1).
METHOD ReleaseReportManual : BOOL
VAR_INPUT
    TargetPath : STRING(255);
    Value : DINT;
END_VAR
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Report.Count := 0;
Report.Released := FALSE;
IF _mode <> E_Mode.MANUAL THEN
    _M_AddReason(Report := Report, Text := 'std.release.manualModeRequired', Reason := E_Reason.NONE, Kind := E_ReleaseKind.MODE);
END_IF
IF NOT Access.Permits(Gate := E_GatedAction.MANUAL) THEN
    _M_AddReason(Report := Report, Text := 'std.release.insufficientManual', Reason := E_Reason.NONE, Kind := E_ReleaseKind.ACCESS);
END_IF
_M_AppendManualInterlocks(TargetPath := TargetPath, Value := Value, Report := Report);  // §7.6, target+command-aware
Report.Released := (Report.Count = 0);
ReleaseReportManual := Report.Released;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseReportStart" Id="{c78c7568-83f2-4d9d-9ae3-f47850cbc022}">
      <Declaration><![CDATA[// Core §7.8 — pure query: the FULL rollup of why Start would be refused right now.
// This is the authoritative machine predicate consumed by Start (no drift).
// Released = TRUE means Start proceeds. Lists mode + access + blocking-alarm,
// control-domain, and concrete mode-entry release reasons. The caller owns the
// bounded report storage; returning this large record by value can overflow a
// TwinCAT task stack when Start consumes the result.
METHOD ReleaseReportStart : BOOL
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Report.Count := 0;
Report.Released := FALSE;
// access (§7.7)
IF NOT Access.Permits(Gate := E_GatedAction.START_STOP) THEN
    _M_AddReason(Report := Report, Text := 'std.release.insufficientStartStop', Reason := E_Reason.NONE, Kind := E_ReleaseKind.ACCESS);
END_IF
// mode / run state (§3.4)
IF _modePend THEN
    _M_AddReason(Report := Report, Text := 'std.release.modeChangePending', Reason := E_Reason.NONE, Kind := E_ReleaseKind.MODE);
END_IF
IF _mode = E_Mode.MANUAL THEN
    _M_AddReason(Report := Report, Text := 'std.release.manualHasNoAutoSequence', Reason := E_Reason.NONE, Kind := E_ReleaseKind.MODE);
END_IF
IF _exec <> E_ExecState.READY THEN
    _M_AddReason(Report := Report, Text := 'std.release.unitNotReady', Reason := E_Reason.NONE, Kind := E_ReleaseKind.MODE);
END_IF
// blocking alarm (§8.3)
IF AlarmLog.Blocking THEN
    _M_AddReason(Report := Report, Text := 'std.release.manualReset', Reason := E_Reason.NONE, Kind := E_ReleaseKind.ALARM);
END_IF
IF ControlDomain.Present AND NOT ControlDomain.ReadyForStart THEN
    _M_AddReason(Report := Report, Text := 'std.release.controlDomainNotReady', Reason := E_Reason.NONE, Kind := E_ReleaseKind.INTERLOCK);
END_IF
// active mode's immediate entry/frontier conditions (concrete override)
_M_AppendInterlocks(Report := Report);
Report.Released := (Report.Count = 0);
ReleaseReportStart := Report.Released;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetOee" Id="{76d2024b-e4e9-424e-bbf4-fcfd488c8439}">
      <Declaration><![CDATA[// §8.5.1 — clear accumulators + ring (shift start). Gated: §7.7 DATA_WRITE; audited §8.3.
METHOD ResetOee : BOOL
VAR
    i : INT;
    auditSlot : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.DATA_WRITE) THEN
    ResetOee := FALSE;
    RETURN;
END_IF
Oee.RunMs := 0; Oee.DownMs := 0; Oee.IdleMs := 0;
FOR i := 1 TO PL_Fraktal.MAX_OEE_SAMPLES DO
    OeeTrend[i].Oee := 0.0; OeeTrend[i].OeeValid := FALSE;
    OeeTrend[i].Availability := 0.0; OeeTrend[i].Performance := 0.0; OeeTrend[i].Quality := 0.0;
END_FOR
OeeTrendHead := 0;
_oeeSampMs := 0;
_M_OeeCompute();
auditSlot := AlarmLog.Raise(Reason := E_Reason.NONE,
    Text := 'std.audit.oeeReset', Source := _name,
    Severity := E_Severity.LOW, Category := E_Category.SYSTEM, ResetClass := E_ResetClass.AUTO_RESET);
IF auditSlot > 0 THEN AlarmLog.Gone(Slot := auditSlot); END_IF
ResetOee := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetHoldRun" Id="{fbc37d38-8939-4f18-83b4-eb1341e2b47b}">
      <Declaration><![CDATA[// §3.4.2 — HMI HOLD_TO_RUN input. NON-SAFETY (§9): never a dead-man; interlocks
// still apply at every step. TRUE only while the operator holds the button.
METHOD SetHoldRun : BOOL
VAR_INPUT
    Held : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Held AND (NOT Access.PermitsLogged(Gate := E_GatedAction.START_STOP)
OR (RunStyle <> E_RunStyle.HOLD_TO_RUN) OR (_exec <> E_ExecState.BUSY)) THEN
    SetHoldRun := FALSE;
    RETURN;
END_IF
_holdRun := Held;                     // FALSE is always accepted so a hold cannot stick
SetHoldRun := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetIdealCycle" Id="{21a43259-c0d5-420f-993f-704ffad3d187}">
      <Declaration><![CDATA[// §8.5.1 — configure the ideal cycle time (per model, §3.8). 0 disables Performance.
METHOD SetIdealCycle : BOOL
VAR_INPUT
    Ms : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Oee.IdealCycleMs := Ms;
SetIdealCycle := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetMode" Id="{7da8ba28-e926-421f-9272-a6c57a552866}">
      <Declaration><![CDATA[// §3.4/§3.7 — FALSE = unsupported (graceful rejection); TRUE = committed or pending
METHOD SetMode : BOOL
VAR_INPUT
    Mode : E_Mode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.MODE_CHANGE) THEN
    SetMode := FALSE;                  // §7.7(c): who-gate ANDs the machine gates
    RETURN;
END_IF
IF NOT _M_Supports(Mode) THEN
    SetMode := FALSE;
    RETURN;
END_IF
IF (Mode = _mode) AND NOT _modePend THEN
    SetMode := TRUE;
    RETURN;
END_IF
// §3.4.1 shield: policy of the mode being LEFT governs while its sequence runs
IF (_exec = E_ExecState.BUSY)
AND (ModePolicy[TO_INT(_mode)].Shield = E_ModeSwitchShield.BLOCKED_WHILE_RUNNING) THEN
    SetMode := FALSE;                  // must Stop first (graceful rejection, not a fault)
    RETURN;
END_IF
IF (NOT _modePend) OR (_modeReq <> Mode) THEN
    _modeExitFirst := TRUE;
END_IF
_modeReq := Mode;
_modePend := TRUE;
SetMode := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetModel" Id="{6a7ae71f-5111-44b3-bfc5-fd8bfdcd3719}">
      <Declaration><![CDATA[// §3.1b/§3.8 — transactional model change: prepare the whole subtree, then commit.
METHOD SetModel : BOOL
VAR_INPUT
    Id : ST_ModelId;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.CHANGEOVER) THEN
    SetModel := FALSE;                 // §7.7
    RETURN;
END_IF
IF _exec = E_ExecState.BUSY THEN
    SetModel := FALSE;                 // changeover is not mid-cycle (§3.8 loads at CHANGEOVER)
    RETURN;
END_IF
IF NOT PrepareRecipe(Model := Id) THEN
    AbortRecipe();
    SetModel := FALSE;
    RETURN;
END_IF
CommitRecipe();                         // infallible after successful preparation
Model := Id;                           // identity changes only after subtree commit
ConfigRev := ConfigRev + 1;            // §3.10.2 — recipe/config leaves changed
SetModel := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PublishMaterialChanged" Id="{27225091-fd15-48c0-a242-131de64ab93c}">
      <Declaration><![CDATA[// §11.6.1 internal composition seam; not a remote command surface.
METHOD M_PublishMaterialChanged : BOOL
VAR_INPUT
    Material : STRING(80);
    Value    : STRING(80);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_PublishMaterialChanged := _M_HostEvent(
    Kind := E_HostEventKind.MATERIAL_CHANGED, PartUid := '', Subject := Material,
    Value := Value, Verdict := E_Verdict.NONE, ReasonCode := E_Reason.NONE);]]></ST></Implementation>
    </Method>
    <Method Name="M_PublishToolChanged" Id="{cc18bd59-d3df-4af3-a8b4-e56788466431}">
      <Declaration><![CDATA[// §11.6.1 internal composition seam; not a remote command surface.
METHOD M_PublishToolChanged : BOOL
VAR_INPUT
    Tool  : STRING(80);
    Value : STRING(80);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_PublishToolChanged := _M_HostEvent(
    Kind := E_HostEventKind.TOOL_CHANGED, PartUid := '', Subject := Tool,
    Value := Value, Verdict := E_Verdict.NONE, ReasonCode := E_Reason.NONE);]]></ST></Implementation>
    </Method>
    <Method Name="M_SetHostEventSink" Id="{c075ef1c-ce1a-4aec-9cd4-f8cc578ba7b2}">
      <Declaration><![CDATA[// §11.6.2 inject an optional OPC UA/MES/REST/MQTT delivery adapter.
METHOD M_SetHostEventSink : BOOL
VAR_INPUT
    Sink : I_HostEventSink;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_SetHostEventSink := HostEvents.SetSink(Sink := Sink);]]></ST></Implementation>
    </Method>
    <Method Name="SetPartCarrier" Id="{6a3e9c15-2f84-4b0d-9c17-d84f5e21ab63}">
      <Declaration><![CDATA[// §3.16.2 — inject the part carrier at the composition root (0 = traceability off).
// Source-agnostic: BY_POSITION local, RFID, DataMatrix, or host, behind I_PartCarrier.
METHOD SetPartCarrier : BOOL
VAR_INPUT
    Carrier : I_PartCarrier;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_carrier := Carrier;
SetPartCarrier := (Carrier <> 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetRunStyle" Id="{f598b9ad-9cb8-47de-920d-91798ab2094a}">
      <Declaration><![CDATA[// §3.4.2 — HMI selects the run style for the active mode. Modes that don't opt in
// (see _M_SupportsRunStyle) reject non-CONTINUOUS. Access: MODE_CHANGE-gated (§7.7).
METHOD SetRunStyle : BOOL
VAR_INPUT
    Style : E_RunStyle;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.MODE_CHANGE) THEN
    SetRunStyle := FALSE;
    RETURN;
END_IF
IF (Style <> E_RunStyle.CONTINUOUS) AND NOT _M_SupportsRunStyle(Style := Style) THEN
    SetRunStyle := FALSE;               // mode didn't opt into stepping (graceful reject)
    RETURN;
END_IF
RunStyle := Style;
SetRunStyle := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ShelveAlarm" Id="{254b8716-80f2-462f-8e49-d89ea86b5224}">
      <Declaration><![CDATA[// §8.10 — gated HMI entry: shelve an active alarm's ANNUNCIATION (control untouched).
// §7.7 ALARM_SHELVE + audit; refuses SAFETY / unrationalized reasons (AlarmLog rules).
METHOD ShelveAlarm : BOOL
VAR_INPUT
    Slot      : INT;
    DurationS : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.ALARM_SHELVE) THEN
    ShelveAlarm := FALSE;
    RETURN;
END_IF
ShelveAlarm := AlarmLog.Shelve(Slot := Slot, DurationS := DurationS);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Start" Id="{cf23e563-6a38-441b-bf71-cf054a5930b3}">
      <Declaration><![CDATA[// §3.3/§6 intro — the run IS a §6.1 command.
// §7.8: ReleaseReportStart is the authoritative machine gate as well as the
// operator explanation, so a concrete Unit cannot report an interlock it ignores.
// Build directly into the published response storage: ST_ReleaseReport is too
// large for nested by-value/local copies on a small TwinCAT task stack.
METHOD Start : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.START_STOP) THEN
    Start := FALSE;                    // §7.7
    RETURN;
END_IF
IF ReleaseReportStart(Report := HmiResponse.Report) THEN
    _stopReq := FALSE;                 // §8.3(b): a MANUAL_RESET event blocks restart
    Execute := TRUE;
    Start := TRUE;
ELSE
    Start := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StepRequest" Id="{64e64e1a-0c5a-460b-882a-ab14da4420e6}">
      <Declaration><![CDATA[// §3.4.2 — HMI single-step: request advance of one step (edge-consumed by _M_StepGate).
METHOD StepRequest : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.START_STOP)
OR (RunStyle <> E_RunStyle.SINGLE_STEP) OR (_exec <> E_ExecState.BUSY) THEN
    StepRequest := FALSE;
    RETURN;
END_IF
_stepReq := TRUE;
StepRequest := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{a7c9b0f8-857c-458d-afc6-9746ac288208}">
      <Declaration><![CDATA[// §3.3 — stop after the current cycle
METHOD Stop : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.START_STOP) THEN
    Stop := FALSE;                     // §7.7
    RETURN;
END_IF
IF _exec = E_ExecState.BUSY THEN
    _stopReq := TRUE;
ELSE
    _stopReq := FALSE;
    Execute := FALSE;                  // release a terminal run command (ERROR/DONE/ABORTED)
END_IF
Stop := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="StopPending" Id="{f114fa1a-de45-4aa0-be5b-cf63c773b8b7}">
      <Declaration><![CDATA[// §3.4 — TRUE while a stop is requested but the sequence is still finishing
// (running -> stopping). HMI blinks the stop button on this.
PROPERTY StopPending : BOOL]]></Declaration>
      <Get Name="Get" Id="{135b3f46-0e90-48aa-8ac1-6493d51adeb3}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[StopPending := _stopReq AND (_exec = E_ExecState.BUSY);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="UnshelveAlarm" Id="{f39e65ca-0fee-42d8-be9a-7e2098b02e14}">
      <Declaration><![CDATA[// §8.10 — gated HMI entry: restore annunciation.
METHOD UnshelveAlarm : BOOL
VAR_INPUT
    Slot : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Access.PermitsLogged(Gate := E_GatedAction.ALARM_SHELVE) THEN
    UnshelveAlarm := FALSE;
    RETURN;
END_IF
UnshelveAlarm := AlarmLog.Unshelve(Slot := Slot);]]></ST>
      </Implementation>
    </Method>
