<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_UnitBase" Id="{116d9026-fbad-4cf8-8b52-50d17613c706}" SpecialFunc="None">
    <Declaration><![CDATA[// Core §2.2 lifecycle family, top tier: modes + cascade (§3.4/§3.7), Start/Stop
// mapped onto the §6.1 run command (§6 intro), the step chain (_M_SetStep/_M_Await,
// §6.5/§6.9(b)), the stall walk as a PENDING reason with instant rollup on an
// awaited module's Error (§6.9/§8.2), the §8.11.4 profiler wired in, and
// Starved/Blocked derived from the step's time class (§8.11.4(f)/§8.11.3).
// A Unit type overrides _M_Dispatch (its mode chain) + _M_Supports (+ §3.14 hooks).
FUNCTION_BLOCK ABSTRACT FB_UnitBase EXTENDS FB_CompositeModuleBase IMPLEMENTS I_Unit, I_SequenceHost
VAR_INPUT
    DecisionAnswer : INT;              // §6.11: chosen option index (0 = none yet)
    ReqControlOn   : BOOL;             // §9.8 HMI/data request; edge-consumed and access-gated
    ReqControlOff  : BOOL;
    HmiRequest     : ST_HmiRequest;     // §3.10/§14: arguments first, Sequence last
    {attribute 'OPC.UA.DA' := '0'}
    ControlDomain  : ST_ControlDomainStatus; // §9.8: optional shared cell/cage arrangement
END_VAR
VAR_OUTPUT
    Starved : BOOL;                    // §8.11.3 — derived from CurrentStep.TimeClass
    Blocked : BOOL;
    Domain  : ST_ControlDomainStatus;  // §9.8 read-only publication of the assigned domain
    ControlOnRequest  : BOOL;          // one-scan request to the owning domain coordinator
    ControlOffRequest : BOOL;
END_VAR
VAR_OUTPUT
    Profiler    : FB_CycleProfiler;    // §8.11.4 — HMI chart source
    CurrentStep : ST_StepRecord;       // §6.5 — feeds §6.9 walk AND the profiler
    // §3.13 sequence flow chart. Discovered from _M_SetStep, so a chain author
    // writes nothing; SequenceStepCount is the published length (§8.4 bounded).
    SequenceSteps : ARRAY[1..PL_Fraktal.MAX_SEQUENCE_STEPS] OF ST_SequenceStep;
    // §3.10.2 — the static half of each row: discovered once, never changes, so it
    // stays OFF the cyclic tree and is served through the config manifest under the
    // SAME browse paths as the live half (M_AppendConfig below).
    {attribute 'OPC.UA.DA' := '0'}
    SequenceStepDef : ARRAY[1..PL_Fraktal.MAX_SEQUENCE_STEPS] OF ST_SequenceStepDef;
    // §3.13 — which row each concurrent leg is running. Indexed by branch (0 = the
    // main line), so it is ~10 entries however long the chain is, and cheap enough
    // to stay in the cyclic read: the chart is right the moment its tab opens.
    ActiveSteps : ARRAY[0..PL_Fraktal.MAX_PARALLEL_BRANCHES] OF ST_SequenceCursor;
    // §6.9 — the errors and messages currently attached to rows. Sparse, so a small
    // table instead of 633 bytes reserved on every row for the usually-empty case.
    SequenceAnnotations : ARRAY[1..PL_Fraktal.MAX_SEQUENCE_ANNOTATIONS] OF ST_SequenceAnnotation;
    SequenceAnnotationCount : INT;
    SequenceStepCount : INT;
    CurrentStepElapsed : TIME;         // how long the active step has been running
    CurrentStepTimedOut : BOOL;        // active step outran its guard (§6.9 stall)

    Pending     : ST_Diagnostic;       // live stall reason (Low) — NOT a fault (§6.9)
    Decision    : ST_DecisionRequest;  // §6.11 active request ('' Prompt = none)
    {attribute 'OPC.UA.DA' := '0'}
    StallTime   : TIME := T#30S;       // guard when the step declares no ExpectedTime
    Model       : ST_ModelId;          // §3.1b active model identity (published for HMI/MES/trace)
    // §3.10.2 — static catalogs served via the QUERY_CONFIG manifest, not cyclically
    {attribute 'OPC.UA.DA' := '0'}
    AvailableModelCount : INT;         // §3.8 optional discoverable model/recipe catalog
    {attribute 'OPC.UA.DA' := '0'}
    AvailableModels : ARRAY[1..PL_Fraktal.MAX_RECIPES] OF ST_ModelId;
    Part        : ST_PartContext;      // §3.16.1 live part context (Present=FALSE, Uid='' = none)
    AlarmLog    : FB_AlarmLog;         // §8.3 — active list + closed ring + Blocking
    HostEvents  : FB_HostEventPublisher; // §11.6 fixed, bounded L3/MES projection
    Access      : FB_AccessManager;    // §7.7 — per-root session/policy (default: fully open)
    GoodCount   : UDINT;               // §8.11.2 — cycle verdict counters
    NokCount    : UDINT;
    ReworkCount : UDINT;
    NokReason   : E_Reason;            // §8.11.2 — last NOK's first-out attribution
    MachineState : E_MachineState;     // §8.11.3 — classified every scan (OEE/PackML/host)
    History     : ARRAY[1..PL_Fraktal.MAX_DIAG_RING] OF ST_Diagnostic;  // §6.9(a) ring (newest at HistoryHead)
    HistoryHead : INT;
    {attribute 'OPC.UA.DA' := '0'}
    ModePolicy  : ARRAY[0..PL_Fraktal.MODE_COUNT-1] OF ST_ModePolicy;    // §3.4.1 per-mode switch policy (station cfg; manifest-served)
    RunStyle    : E_RunStyle;          // §3.4.2 active run style (HMI-selectable; CONTINUOUS default)
    Oee         : ST_Oee;              // §8.5.1 accumulators + snapshot (published)
    OeeTrend    : ARRAY[1..PL_Fraktal.MAX_OEE_SAMPLES] OF ST_OeeSample; // §8.5.1 ring
    OeeTrendHead: INT;                 // newest sample index (0 = none yet)
    HmiResponse : ST_HmiResponse;
    ConfigRev   : UDINT;                // §3.10.2 manifest revision — HMI refetches on change
    ModeActivePublished : E_Mode;       // properties are not OPC UA-visible
    RunningPublished : BOOL;
    StopPendingPublished : BOOL;
    SupportedModesPublished : ARRAY[0..PL_Fraktal.MODE_COUNT-1] OF BOOL;
    SupportedRunStylesPublished : ARRAY[0..2] OF BOOL;
    SystemHealth : ST_SystemHealthStatus; // §2.7/§8.12 live, trendable health
    SignalTower  : ST_SignalTowerOut;     // §8.13 single reusable mapping
END_VAR
VAR PERSISTENT
    // §3.8a station-config backing for the manifest-served ModePolicy output.
    // Version 0/unrecognized initializes safe defaults exactly once.
    _modePolicyVersion : UINT;
    _modePolicyStored : ARRAY[0..PL_Fraktal.MODE_COUNT-1] OF ST_ModePolicy;
END_VAR
VAR
    _fTrig    : R_TRIG;
    _mode     : E_Mode;
    _modeReq  : E_Mode;
    _modePend : BOOL;
    _modeExitFirst : BOOL;
    _stopReq  : BOOL;
    {attribute 'OPC.UA.DA' := '0'}
    _awaits   : I_Module;              // module the current step awaits (0 = none)
    _faultEvt : INT;                   // open ERROR event slot in AlarmLog (0 = none)
    _tStall   : TON;
    _seqIndex : INT;                   // row recorded LAST, i.e. the step action running now
    _stepSinceMs : DWORD;              // monotonic start of the main-line step
    // §6.12 — per-row clock and liveness. With a parallel step several rows are
    // active at once, so one cursor is no longer enough to say what is running or
    // for how long. Bounded exactly like the row table itself (§1.1 O10).
    // Per-LEG, not per row: a leg has one active step, so the per-scan sweep is ~10
    // iterations instead of up to MAX_SEQUENCE_STEPS.
    _branchSinceMs : ARRAY[0..PL_Fraktal.MAX_PARALLEL_BRANCHES] OF DWORD;
    _branchTouched : ARRAY[0..PL_Fraktal.MAX_PARALLEL_BRANCHES] OF BOOL;
    _tDecision: TON;                   // §6.11 monotonic active-decision timeout
    _decisionConflictLogged : BOOL;    // one audit record per conflicting request
    _decisionResolutionLogged : BOOL;  // operator/timeout resolution logged once
    _stepReq  : BOOL;                  // §3.4.2 pending single-step request (edge-consumed)
    _holdRun  : BOOL;                  // §3.4.2 HOLD_TO_RUN input held (NON-SAFETY, §9)
    _stepArm  : R_TRIG;
    _errClr   : R_TRIG;                // §6.9 the ERROR state ended
    _oeeLast  : TIME;                  // §8.5.1 last accumulation stamp
    _oeeSampMs: UDINT;                 // ms since last trend sample
    _hmiLastSequence : UDINT;
    {attribute 'OPC.UA.DA' := '0'}
    _configPager : FB_ConfigPager;     // §3.10.2 QUERY_CONFIG window writer
    {attribute 'OPC.UA.DA' := '0'}
    _carrier  : I_PartCarrier;         // §3.16.2 injected part carrier (0 = traceability off)
    {attribute 'OPC.UA.DA' := '0'}
    _healthPublisher : FB_SystemHealthPublisher;
    {attribute 'OPC.UA.DA' := '0'}
    _healthInput : ST_SystemHealthInput;
    {attribute 'OPC.UA.DA' := '0'}
    _healthParCfg : ST_SystemHealthParCfg;
    _healthConfigured : BOOL;
    {attribute 'OPC.UA.DA' := '0'}
    _towerMapper : FB_SignalTower;
    {attribute 'OPC.UA.DA' := '0'}
    _towerParCfg : ST_SignalTowerParCfg;
    _lampTestRequest : BOOL;
    {attribute 'OPC.UA.DA' := '0'}
    _sequences : ARRAY[1..PL_Fraktal.MAX_SEQUENCES] OF I_Sequence;
    _sequenceCount : INT;
    // §7.5 commissioning/engineering gate register, injected by the composition
    // root. Absent (the shipped default) = a production image: no gate is
    // annunciated and ForceChannel refuses every request (fail closed).
    {attribute 'OPC.UA.DA' := '0'}
    _engineering : REFERENCE TO FB_EngineeringMode;
    // §7.5.2 open standing event per registered gate (0 = none open yet)
    _engineeringEvt : ARRAY[1..PL_Fraktal.MAX_ENGINEERING_GATES] OF INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Cyclic();]]></ST>
    </Implementation>
    <Method Name="_M_AddReason" Id="{63c5e93f-708a-4c3a-aa1b-ee43d815fb4a}">
      <Declaration><![CDATA[// Core §7.8 helper — append one non-interlock reason (bounds-checked).
METHOD PROTECTED _M_AddReason
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR
VAR_INPUT
    Text : STRING(255);
    Reason : E_Reason;
    Kind : E_ReleaseKind;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Report.Count >= PL_Fraktal.MAX_RELEASE_REASONS THEN
    RETURN;
END_IF
Report.Count := Report.Count + 1;
Report.Reasons[Report.Count].Description := Text;
Report.Reasons[Report.Count].ReasonCode  := Reason;
Report.Reasons[Report.Count].SourcePath  := _name;
Report.Reasons[Report.Count].Kind        := Kind;
Report.Reasons[Report.Count].Bypassable  := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_AppendInterlocks" Id="{2bc971ff-4cee-49e6-a29f-4f727818205b}">
      <Declaration><![CDATA[// Core §7.8 — concrete Units override to append the active mode's immediate
// entry/frontier records via PermIntlk.AppendFailed(SourcePath, Report). Future step waits
// stay in CurrentStep/Pending and are not blanket Start conditions. Base: nothing.
METHOD PROTECTED _M_AppendInterlocks
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_AppendManualInterlocks" Id="{c18caeb9-871a-4a4c-aad2-2711e3ced37a}">
      <Declaration><![CDATA[// Core §7.8 — target-aware hook for the MANUAL release rollup: a concrete Unit
// overrides to append the §7.6 Release<Function> conditions of the SPECIFIC target
// module. Base delegates to the Unit-level hook (non-breaking default).
METHOD PROTECTED _M_AppendManualInterlocks
VAR_INPUT
    TargetPath : STRING(255);
    Value : DINT;
END_VAR
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_AppendInterlocks(Report := Report);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_AppendDecisionInterlocks" Id="{bbac41d9-35ba-4800-af52-51cd30b49db7}">
      <Declaration><![CDATA[// §6.11 option-aware release seam. The base validates session, active prompt and
// option identity; a concrete Unit appends the ordinary process conditions that a
// "continue"-style option must satisfy. Safety and child interlocks still remain
// authoritative at their owning modules.
METHOD PROTECTED _M_AppendDecisionInterlocks
VAR_INPUT
    Option : INT;
END_VAR
VAR_IN_OUT
    Report : ST_ReleaseReport;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[;]]></ST></Implementation>
    </Method>
    <Method Name="_M_AskDecision" Id="{4e23ce8a-174c-4663-9cbe-be702ba37032}">
      <Declaration><![CDATA[// §6.11 — publish a typed decision request (single active slot)
METHOD PROTECTED _M_AskDecision
VAR_INPUT
    Req : ST_DecisionRequest;
END_VAR
VAR
    candidate : ST_DecisionRequest;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[candidate := Req;
IF candidate.SourcePath = '' THEN
    candidate.SourcePath := _name;
END_IF
// A sequence presents the same request every scan while its step waits. That is
// idempotent. A different producer never overwrites the visible active request.
IF Decision.Prompt <> '' THEN
    IF _M_DecisionMatches(Req := candidate) THEN
        RETURN;
    END_IF
    IF NOT _decisionConflictLogged THEN
        _M_LogDecision(EventKey := 'std.audit.decisionOverlapRejected',
            SourcePath := candidate.SourcePath, Option := 0);
        _decisionConflictLogged := TRUE;
    END_IF
    RETURN;
END_IF
IF NOT _M_ValidateDecision(Req := candidate) THEN
    _M_LogDecision(EventKey := 'std.audit.decisionInvalidRejected',
        SourcePath := candidate.SourcePath, Option := candidate.Default);
    _M_Fault(E_Reason.UNSUPPORTED_COMMAND, 'std.error.invalidDecisionRequest');
    RETURN;
END_IF
Decision := candidate;
DecisionAnswer := 0;
_decisionConflictLogged := FALSE;
_decisionResolutionLogged := FALSE;
_tDecision(IN := FALSE);
_M_LogDecision(EventKey := 'std.audit.decisionRequested',
    SourcePath := Decision.SourcePath, Option := 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_ClearDecisionState" Id="{db09e3d9-4427-4607-8a90-66b39812e37b}">
      <Declaration><![CDATA[// Clear the complete public slot and all private latches atomically.
METHOD PRIVATE _M_ClearDecisionState
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[_tDecision(IN := FALSE);
DecisionAnswer := 0;
Decision.Prompt := '';
Decision.Default := 0;
Decision.Timeout := T#0S;
Decision.SourcePath := '';
FOR i := 1 TO PL_Fraktal.MAX_OPTIONS DO
    Decision.Options[i] := '';
END_FOR
_decisionConflictLogged := FALSE;
_decisionResolutionLogged := FALSE;]]></ST></Implementation>
    </Method>
    <Method Name="_M_DecisionCyclic" Id="{ff058255-d664-4ce3-986d-8ad7a970388c}">
      <Declaration><![CDATA[// §6.11 one-slot resolver. Operator input wins if it is accepted in the same scan
// the timeout expires; _M_HandleHmiRequest runs immediately before this method.
METHOD PRIVATE _M_DecisionCyclic]]></Declaration>
      <Implementation><ST><![CDATA[IF _exec <> E_ExecState.BUSY THEN
    IF Decision.Prompt <> '' THEN
        _M_LogDecision(EventKey := 'std.audit.decisionWithdrawn',
            SourcePath := Decision.SourcePath, Option := 0);
        _M_ClearDecisionState();
    ELSE
        _tDecision(IN := FALSE);
    END_IF
    RETURN;
END_IF
IF Decision.Prompt = '' THEN
    _tDecision(IN := FALSE);
    RETURN;
END_IF
IF DecisionAnswer <> 0 THEN
    _tDecision(IN := FALSE);
    IF (DecisionAnswer < 1) OR (DecisionAnswer > PL_Fraktal.MAX_OPTIONS) THEN
        _M_LogDecision(EventKey := 'std.audit.decisionAnswerRejected',
            SourcePath := Decision.SourcePath, Option := DecisionAnswer);
        DecisionAnswer := 0;
        RETURN;
    END_IF
    IF Decision.Options[DecisionAnswer] = '' THEN
        _M_LogDecision(EventKey := 'std.audit.decisionAnswerRejected',
            SourcePath := Decision.SourcePath, Option := DecisionAnswer);
        DecisionAnswer := 0;
        RETURN;
    END_IF
    IF NOT _decisionResolutionLogged THEN
        _M_LogDecision(EventKey := 'std.audit.decisionOperatorResolved',
            SourcePath := Decision.SourcePath, Option := DecisionAnswer);
        _decisionResolutionLogged := TRUE;
    END_IF
    RETURN;
END_IF
IF Decision.Timeout <= T#0S THEN
    _tDecision(IN := FALSE);
    RETURN;
END_IF
_tDecision(IN := TRUE, PT := Decision.Timeout);
IF _tDecision.Q THEN
    DecisionAnswer := Decision.Default;             // validated when accepted
    _tDecision(IN := FALSE);
    _M_LogDecision(EventKey := 'std.audit.decisionTimeoutResolved',
        SourcePath := Decision.SourcePath, Option := DecisionAnswer);
    _decisionResolutionLogged := TRUE;
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="_M_DecisionMatches" Id="{2ca48458-620f-4a17-b6d1-b5680778bd4e}">
      <Declaration><![CDATA[// Full value comparison makes repeated presentation idempotent while treating a
// changed option/default/timeout as a different request that must not overwrite.
METHOD PRIVATE _M_DecisionMatches : BOOL
VAR_INPUT
    Req : ST_DecisionRequest;
END_VAR
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[_M_DecisionMatches := FALSE;
IF (Decision.Prompt <> Req.Prompt)
OR (Decision.Default <> Req.Default)
OR (Decision.Timeout <> Req.Timeout)
OR (Decision.SourcePath <> Req.SourcePath) THEN
    RETURN;
END_IF
FOR i := 1 TO PL_Fraktal.MAX_OPTIONS DO
    IF Decision.Options[i] <> Req.Options[i] THEN
        RETURN;
    END_IF
END_FOR
_M_DecisionMatches := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="_M_LogDecision" Id="{eb357477-2029-4b6d-8688-04dc5df5e04b}">
      <Declaration><![CDATA[// Domain audit: request, rejection and resolution are closed MESSAGE events.
METHOD PRIVATE _M_LogDecision
VAR_INPUT
    EventKey : STRING(160);
    SourcePath : STRING(255);
    Option : INT;
END_VAR
VAR
    slot : INT;
    textValue : STRING(255);
    sourceValue : STRING(255);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[textValue := EventKey;
IF Option <> 0 THEN
    textValue := CONCAT(textValue, ' option=');
    textValue := CONCAT(textValue, TO_STRING(Option));
END_IF
sourceValue := SourcePath;
IF sourceValue = '' THEN
    sourceValue := _name;
END_IF
slot := AlarmLog.Raise(Reason := E_Reason.NONE, Text := textValue,
    Source := sourceValue, Severity := E_Severity.LOW,
    Category := E_Category.PROCESS, ResetClass := E_ResetClass.AUTO_RESET);
IF slot > 0 THEN
    AlarmLog.Gone(Slot := slot);
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="_M_ValidateDecision" Id="{1229fbc9-7dc8-4907-b878-f6af733f2c09}">
      <Declaration><![CDATA[// A finite timeout requires a real safe default. An indefinite request may omit
// Default, but every published request still needs at least one selectable option.
METHOD PRIVATE _M_ValidateDecision : BOOL
VAR_INPUT
    Req : ST_DecisionRequest;
END_VAR
VAR
    i : INT;
    hasOption : BOOL;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[_M_ValidateDecision := FALSE;
IF (Req.Prompt = '') OR (Req.Timeout < T#0S) THEN
    RETURN;
END_IF
hasOption := FALSE;
FOR i := 1 TO PL_Fraktal.MAX_OPTIONS DO
    IF Req.Options[i] <> '' THEN
        hasOption := TRUE;
    END_IF
END_FOR
IF NOT hasOption THEN
    RETURN;
END_IF
IF (Req.Timeout > T#0S) OR (Req.Default <> 0) THEN
    IF (Req.Default < 1) OR (Req.Default > PL_Fraktal.MAX_OPTIONS) THEN
        RETURN;
    END_IF
    IF Req.Options[Req.Default] = '' THEN
        RETURN;
    END_IF
END_IF
_M_ValidateDecision := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="_M_Await" Id="{098638cb-fc78-4032-9954-0ceffe6b565c}">
      <Declaration><![CDATA[// §6.9(b) — named plain-condition wait; returns the condition so steps read naturally
METHOD PROTECTED _M_Await : BOOL
VAR_INPUT
    Idx   : INT;
    Label : STRING(120);
    Ok    : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (Idx >= 1) AND (Idx <= PL_Fraktal.MAX_STEP_CONDS) THEN
    CurrentStep.Conds[Idx].Label := Label;
    CurrentStep.Conds[Idx].Ok    := Ok;
END_IF
_M_Await := Ok;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_CascadeMode" Id="{3ac20481-72c5-4cd1-88e5-b9f7eb433162}">
      <Declaration><![CDATA[// §3.7 — offer the mode to child Units; a child may reject (graceful)
METHOD PROTECTED _M_CascadeMode
VAR_INPUT
    Mode : E_Mode;
END_VAR
VAR
    i  : INT;
    iu : I_Unit;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 THEN
        IF __QUERYINTERFACE(_children[i], iu) THEN   // [TC3] capability query — TC3 §3.2
            iu.SetMode(Mode);
        END_IF
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_ClearPending" Id="{cb01b1f4-f591-43f7-a826-970be7300b04}">
      <Declaration><![CDATA[METHOD PROTECTED _M_ClearPending]]></Declaration>
      <Implementation>
        <ST><![CDATA[Pending.ReasonCode  := E_Reason.NONE;
Pending.Description := '';
Pending.TimeSynchronized := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_AuditHmiAccepted" Id="{f8865f87-3ae7-472e-b775-3408513a4586}">
      <Declaration><![CDATA[// §14.3 security audit for accepted remote mutations. Operational methods may
// additionally emit their domain event (manual action, OEE reset, shelving); this
// record supplies the remote request kind and authenticated user without secrets.
METHOD PROTECTED _M_AuditHmiAccepted
VAR_INPUT
    Kind : E_HmiRequestKind;
    TargetPath : STRING(255);
    Accepted : BOOL;
END_VAR
VAR
    auditable : BOOL;
    auditSlot : INT;
    textValue : STRING(255);
    sourcePath : STRING(255);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[IF NOT Accepted THEN
    RETURN;
END_IF
CASE Kind OF
    E_HmiRequestKind.SET_MODE, E_HmiRequestKind.SET_MODEL,
    E_HmiRequestKind.START, E_HmiRequestKind.STOP,
    E_HmiRequestKind.CONTROL_ON, E_HmiRequestKind.CONTROL_OFF,
    E_HmiRequestKind.OPERATOR_RESET, E_HmiRequestKind.DECISION_ANSWER,
    E_HmiRequestKind.MANUAL_COMMAND, E_HmiRequestKind.SET_RUN_STYLE,
    E_HmiRequestKind.STEP_REQUEST, E_HmiRequestKind.SET_HOLD_RUN,
    E_HmiRequestKind.RESET_OEE, E_HmiRequestKind.WRITE_CONFIG,
    E_HmiRequestKind.SHELVE_ALARM, E_HmiRequestKind.UNSHELVE_ALARM,
    E_HmiRequestKind.FORCE_CHANNEL, E_HmiRequestKind.SET_ACCESS_LEVEL,
    E_HmiRequestKind.SET_SESSION_TIMEOUT, E_HmiRequestKind.LAMP_TEST:
        auditable := TRUE;
ELSE
    auditable := FALSE;
END_CASE
IF NOT auditable THEN
    RETURN;
END_IF
Access.RecordActivity();
textValue := CONCAT('std.audit.hmiAccepted kind=', TO_STRING(TO_DINT(Kind)));
textValue := CONCAT(textValue, ' user=');
textValue := CONCAT(textValue, Access.CurrentUser);
sourcePath := TargetPath;
IF sourcePath = '' THEN
    sourcePath := _name;
END_IF
auditSlot := AlarmLog.Raise(Reason := E_Reason.NONE, Text := textValue,
    Source := sourcePath, Severity := E_Severity.LOW, Category := E_Category.SYSTEM,
    ResetClass := E_ResetClass.AUTO_RESET);
IF auditSlot > 0 THEN AlarmLog.Gone(Slot := auditSlot); END_IF]]></ST></Implementation>
    </Method>
    <Method Name="_M_OwnsModulePath" Id="{9b8c6045-f404-4484-937e-b0a8f749d8fd}">
      <Declaration><![CDATA[// Module paths are qualified dotted Fraktal identities (§4.8). A request routed
// through this root may target the root itself or one descendant, never a peer.
METHOD PRIVATE _M_OwnsModulePath : BOOL
VAR_INPUT
    Path : STRING(255);
END_VAR
VAR
    prefix : STRING(255);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[prefix := CONCAT(_name, '.');
_M_OwnsModulePath := (Path = _name) OR (FIND(Path, prefix) = 1);]]></ST></Implementation>
    </Method>
    <Method Name="_M_EndOfCycle" Id="{9824e487-d8d3-4cb9-8c78-a6d2fc09a62d}">
      <Declaration><![CDATA[// call at the finish step (§8.11.1): publishes the profile; FALSE = stop granted
METHOD PROTECTED _M_EndOfCycle : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[Profiler.CycleComplete();
IF _stopReq THEN
    _stopReq := FALSE;
    Execute := FALSE;
    _M_Complete();
    _M_EndOfCycle := FALSE;
ELSE
    _M_EndOfCycle := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_HandleHmiRequest" Id="{63ae9d50-339f-4904-a8ec-81f853aed962}">
      <Declaration><![CDATA[// §3.10/§14 — consume one committed OPC UA request exactly once.
METHOD PROTECTED _M_HandleHmiRequest
VAR
    modelId  : ST_ModelId;
    modeReq  : E_Mode;
    styleReq : E_RunStyle;
    gateReq  : E_GatedAction;
    levelReq : E_AccessLevel;
    alarmSlot : INT;
    policyValueValid : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF HmiRequest.Sequence = _hmiLastSequence THEN
    RETURN;
ELSE
    _hmiLastSequence := HmiRequest.Sequence;
END_IF

HmiResponse.Accepted := FALSE;
HmiResponse.Diagnostic := '';
HmiResponse.Report.Count := 0;
HmiResponse.Report.Released := FALSE;

CASE HmiRequest.Kind OF
    E_HmiRequestKind.LOGIN:
        HmiResponse.Accepted := Access.RequestLogin(User := HmiRequest.User, Secret := HmiRequest.Secret);
    E_HmiRequestKind.LOGOUT:
        HmiResponse.Accepted := Access.RequestLogout();
    E_HmiRequestKind.SET_MODE:
        IF (HmiRequest.IntValue >= 0) AND (HmiRequest.IntValue < PL_Fraktal.MODE_COUNT) THEN
            modeReq := HmiRequest.IntValue;
            HmiResponse.Accepted := SetMode(Mode := modeReq);
        ELSE
            HmiResponse.Diagnostic := 'std.error.unsupportedModeRequest';
        END_IF
    E_HmiRequestKind.SET_MODEL:
        modelId.ModelCode := HmiRequest.TextValue;
        HmiResponse.Accepted := SetModel(Id := modelId);
    E_HmiRequestKind.START:
        HmiResponse.Accepted := Start();
    E_HmiRequestKind.STOP:
        HmiResponse.Accepted := Stop();
    E_HmiRequestKind.CONTROL_ON:
        HmiResponse.Accepted := RequestControlPower(ControlOn := TRUE);
    E_HmiRequestKind.CONTROL_OFF:
        HmiResponse.Accepted := RequestControlPower(ControlOn := FALSE);
    E_HmiRequestKind.OPERATOR_RESET:
        HmiResponse.Accepted := OperatorReset();
    E_HmiRequestKind.DECISION_ANSWER:
        HmiResponse.Accepted := SubmitDecision(Option := TO_INT(HmiRequest.IntValue),
            Report := HmiResponse.Report);
    E_HmiRequestKind.MANUAL_COMMAND:
        HmiResponse.Accepted := ManualCommandTo(TargetPath := HmiRequest.TargetPath, Value := HmiRequest.IntValue);
    E_HmiRequestKind.SET_RUN_STYLE:
        IF (HmiRequest.IntValue >= 0) AND (HmiRequest.IntValue <= 2) THEN
            styleReq := HmiRequest.IntValue;
            HmiResponse.Accepted := SetRunStyle(Style := styleReq);
        ELSE
            HmiResponse.Diagnostic := 'std.error.unsupportedRunStyleRequest';
        END_IF
    E_HmiRequestKind.STEP_REQUEST:
        HmiResponse.Accepted := StepRequest();
    E_HmiRequestKind.SET_HOLD_RUN:
        HmiResponse.Accepted := SetHoldRun(Held := HmiRequest.BoolValue);
    E_HmiRequestKind.RELEASE_START:
        ReleaseReportStart(Report := HmiResponse.Report);
        HmiResponse.Accepted := TRUE;
    E_HmiRequestKind.RELEASE_MANUAL:
        ReleaseReportManual(TargetPath := HmiRequest.TargetPath, Value := HmiRequest.IntValue,
            Report := HmiResponse.Report);
        HmiResponse.Accepted := TRUE;
    E_HmiRequestKind.RELEASE_ACTION:
        IF (HmiRequest.IntValue >= 0)
        AND (HmiRequest.IntValue <= TO_DINT(E_GatedAction.CONFIG_SET)) THEN
            gateReq := HmiRequest.IntValue;
            ReleaseReportAction(Gate := gateReq, Report := HmiResponse.Report);
            HmiResponse.Accepted := TRUE;
        ELSE
            HmiResponse.Diagnostic := 'std.error.unsupportedGatedActionRequest';
        END_IF
    E_HmiRequestKind.RESET_OEE:
        HmiResponse.Accepted := ResetOee();
    E_HmiRequestKind.WRITE_CONFIG:
        HmiResponse.Accepted := WriteConfig(TargetPath := HmiRequest.TargetPath,
            WriteKey := HmiRequest.NameValue, Revision := HmiRequest.IntValue,
            TextValue := HmiRequest.TextValue);
    E_HmiRequestKind.SHELVE_ALARM:
        alarmSlot := AlarmLog.FindActiveSlot(SourcePath := HmiRequest.TargetPath,
            Description := HmiRequest.TextValue);
        IF alarmSlot > 0 THEN
            HmiResponse.Accepted := ShelveAlarm(Slot := alarmSlot,
                DurationS := HmiRequest.DurationMs / 1000);
        ELSE
            HmiResponse.Diagnostic := 'std.error.alarmIdentityNotUnique';
        END_IF
    E_HmiRequestKind.UNSHELVE_ALARM:
        alarmSlot := AlarmLog.FindActiveSlot(SourcePath := HmiRequest.TargetPath,
            Description := HmiRequest.TextValue);
        IF alarmSlot > 0 THEN
            HmiResponse.Accepted := UnshelveAlarm(Slot := alarmSlot);
        ELSE
            HmiResponse.Diagnostic := 'std.error.alarmIdentityNotUnique';
        END_IF
    E_HmiRequestKind.FORCE_CHANNEL:
        HmiResponse.Accepted := ForceChannel(ChannelPath := HmiRequest.TargetPath,
            Force := HmiRequest.BoolValue, BoolText := HmiRequest.TextValue,
            AnalogText := HmiRequest.NameValue);
    E_HmiRequestKind.QUERY_CONFIG:
        // §3.10.2 — serve one manifest page: re-walk the deterministic export
        // enumeration, storing only the requested window (no full buffer).
        IF NOT Access.Permits(Gate := E_GatedAction.DATA_READ) THEN
            HmiResponse.Diagnostic := 'std.error.accessDenied';
        ELSIF _configPager.M_Setup(Target := ADR(HmiResponse.ConfigPage),
            PageIndex := TO_INT(HmiRequest.IntValue), Revision := ConfigRev) THEN
            M_AppendConfig(Pager := _configPager);
            _configPager.M_Finish();
            HmiResponse.Accepted := TRUE;
        ELSE
            HmiResponse.Diagnostic := 'std.error.hmiRequestRejected';
        END_IF
    E_HmiRequestKind.SET_ACCESS_LEVEL:
        policyValueValid := TRUE;
        IF HmiRequest.TextValue = '0' THEN
            levelReq := E_AccessLevel.NONE;
        ELSIF HmiRequest.TextValue = '1' THEN
            levelReq := E_AccessLevel.OPERATOR;
        ELSIF HmiRequest.TextValue = '2' THEN
            levelReq := E_AccessLevel.TECHNICIAN;
        ELSIF HmiRequest.TextValue = '3' THEN
            levelReq := E_AccessLevel.ENGINEER;
        ELSIF HmiRequest.TextValue = '4' THEN
            levelReq := E_AccessLevel.ADMIN;
        ELSE
            policyValueValid := FALSE;
        END_IF
        IF policyValueValid
        AND (HmiRequest.IntValue >= 0)
        AND (HmiRequest.IntValue <= TO_DINT(E_GatedAction.CONFIG_SET)) THEN
            gateReq := HmiRequest.IntValue;
            HmiResponse.Accepted := SetAccessLevel(Gate := gateReq, Level := levelReq);
        ELSE
            HmiResponse.Diagnostic := 'std.error.accessPolicyValueInvalid';
        END_IF
    E_HmiRequestKind.SET_SESSION_TIMEOUT:
        HmiResponse.Accepted := SetSessionTimeout(TimeoutMs := HmiRequest.DurationMs);
    E_HmiRequestKind.LAMP_TEST:
        HmiResponse.Accepted := RequestLampTest();
    E_HmiRequestKind.NONE:
        HmiResponse.Diagnostic := 'std.error.emptyHmiRequest';
ELSE
    HmiResponse.Diagnostic := 'std.error.unsupportedHmiRequest';
END_CASE

IF NOT HmiResponse.Accepted AND (HmiResponse.Diagnostic = '') THEN
    HmiResponse.Diagnostic := 'std.error.hmiRequestRejected';
ELSE
    HmiResponse.Diagnostic := HmiResponse.Diagnostic;
END_IF
_M_AuditHmiAccepted(Kind := HmiRequest.Kind, TargetPath := HmiRequest.TargetPath,
    Accepted := HmiResponse.Accepted);
HmiRequest.Secret := '';
HmiResponse.AckSequence := _hmiLastSequence;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_HostEvent" Id="{76fb49ac-f9ea-4e53-8db6-e7e4e756fd84}">
      <Declaration><![CDATA[// §11.6 one owning projection helper; callers supply only event-specific fields.
METHOD PRIVATE _M_HostEvent : BOOL
VAR_INPUT
    Kind          : E_HostEventKind;
    PartUid       : STRING(64);
    Subject       : STRING(80);
    Value         : STRING(80);
    Verdict       : E_Verdict;
    ReasonCode    : E_Reason;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[_M_HostEvent := HostEvents.Emit(Kind := Kind,
    StationPath := _name, PartUid := PartUid, Subject := Subject,
    Value := Value, Verdict := Verdict, ReasonCode := ReasonCode);]]></ST></Implementation>
    </Method>
    <Method Name="_M_InitModePolicy" Id="{df8ba8da-c8fa-411c-85c1-392b353d5cfd}">
      <Declaration><![CDATA[// §3.4.1/§3.14.4 — default per-mode switch policy. Station config (§3.8a) may
// overwrite ModePolicy[] after this. By FRAMEWORK DEFAULT a mode change while a
// sequence runs performs an IMMEDIATE software abort (E-stop-like, not a safety
// function, §3.14.4) — so Style defaults to IMMEDIATE. GRACEFUL completion is an
// opt-in: a Unit overrides OnModeExit to stop-after-cycle, or station config sets
// Style := GRACEFUL for a mode. Shield only governs acceptance while running.
METHOD PROTECTED _M_InitModePolicy
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO PL_Fraktal.MODE_COUNT-1 DO
    ModePolicy[i].Shield := E_ModeSwitchShield.CONFIRM;
    ModePolicy[i].Style  := E_ModeSwitchStyle.IMMEDIATE;
END_FOR
// Setup modes a running machine may not leave without an explicit Stop first.
ModePolicy[TO_INT(E_Mode.CHANGEOVER)].Shield := E_ModeSwitchShield.BLOCKED_WHILE_RUNNING;
ModePolicy[TO_INT(E_Mode.CALIBRATION)].Shield:= E_ModeSwitchShield.BLOCKED_WHILE_RUNNING;
// HOME and MANUAL are freely interruptible; both inherit the IMMEDIATE default.
ModePolicy[TO_INT(E_Mode.HOME)].Shield       := E_ModeSwitchShield.INTERRUPTIBLE;
ModePolicy[TO_INT(E_Mode.MANUAL)].Shield     := E_ModeSwitchShield.INTERRUPTIBLE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_OeeCompute" Id="{2991f1a8-70f1-48a9-aa83-352243818d0a}">
      <Declaration><![CDATA[// §8.5.1 — pure recompute of A/P/Q/OEE from the accumulators (testable in isolation).
// Invalid factors are OMITTED from the product, never assumed 100% (O7).
METHOD PROTECTED _M_OeeCompute
VAR
    total : UDINT;
    denomA: UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[denomA := Oee.RunMs + Oee.DownMs;
Oee.AvailValid := denomA > 0;
IF Oee.AvailValid THEN
    Oee.Availability := UDINT_TO_REAL(Oee.RunMs) / UDINT_TO_REAL(denomA);
ELSE
    Oee.Availability := 0.0;
END_IF
Oee.PerfValid := (Oee.IdealCycleMs > 0) AND (Oee.RunMs > 0);
IF Oee.PerfValid THEN
    Oee.Performance := UDINT_TO_REAL(Oee.IdealCycleMs) * UDINT_TO_REAL(GoodCount + NokCount)
                       / UDINT_TO_REAL(Oee.RunMs);
    IF Oee.Performance > 1.0 THEN
        Oee.Performance := 1.0;          // faster than ideal caps at 100% (standard practice)
    END_IF
ELSE
    Oee.Performance := 0.0;
END_IF
total := GoodCount + NokCount;
Oee.QualValid := total > 0;
IF Oee.QualValid THEN
    Oee.Quality := UDINT_TO_REAL(GoodCount) / UDINT_TO_REAL(total);
ELSE
    Oee.Quality := 0.0;
END_IF
// product of VALID factors only; OEE valid iff at least one factor is valid
Oee.Oee := 1.0;
Oee.OeeValid := FALSE;
IF Oee.AvailValid THEN Oee.Oee := Oee.Oee * Oee.Availability; Oee.OeeValid := TRUE; END_IF
IF Oee.PerfValid  THEN Oee.Oee := Oee.Oee * Oee.Performance;  Oee.OeeValid := TRUE; END_IF
IF Oee.QualValid  THEN Oee.Oee := Oee.Oee * Oee.Quality;      Oee.OeeValid := TRUE; END_IF
IF NOT Oee.OeeValid THEN
    Oee.Oee := 0.0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_OeeUpdate" Id="{8a4f011d-5d7a-4935-ad26-8a5fbcf63643}">
      <Declaration><![CDATA[// §8.5.1 — attribute elapsed time to run/down/idle, recompute factors, sample ring.
METHOD PROTECTED _M_OeeUpdate
VAR
    currentTime : TIME;
    deltaMs     : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[currentTime := TIME();                 // monotonic duration clock
IF _oeeLast = T#0S THEN
    _oeeLast := currentTime;
    RETURN;
END_IF
deltaMs := TIME_TO_UDINT(currentTime) - TIME_TO_UDINT(_oeeLast); // wrap-safe on UDINT subtraction
_oeeLast := currentTime;
IF _exec = E_ExecState.BUSY THEN
    Oee.RunMs := Oee.RunMs + deltaMs;
ELSIF (_exec = E_ExecState.ERROR) OR AlarmLog.Blocking THEN
    Oee.DownMs := Oee.DownMs + deltaMs;
ELSE
    Oee.IdleMs := Oee.IdleMs + deltaMs;
END_IF
_M_OeeCompute();
_oeeSampMs := _oeeSampMs + deltaMs;
IF _oeeSampMs >= PL_Fraktal.OEE_SAMPLE_MS THEN
    _oeeSampMs := 0;
    OeeTrendHead := (OeeTrendHead MOD PL_Fraktal.MAX_OEE_SAMPLES) + 1;
    OeeTrend[OeeTrendHead].Availability := Oee.Availability;
    OeeTrend[OeeTrendHead].Performance  := Oee.Performance;
    OeeTrend[OeeTrendHead].Quality      := Oee.Quality;
    OeeTrend[OeeTrendHead].Oee          := Oee.Oee;
    OeeTrend[OeeTrendHead].OeeValid     := Oee.OeeValid;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PartAborted" Id="{a55c31e8-06f9-4d10-8c26-4e83b7d5c1f2}">
      <Declaration><![CDATA[// §3.16.3 EVENT_PART_PROCESSING_ABORTED — the part leaves without a valid result
// (fault, abort, manual removal). Called automatically on Unit ERROR entry.
METHOD PROTECTED _M_PartAborted]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (_carrier = 0) OR NOT Part.Present THEN
    RETURN;
END_IF
Part.Result.Verdict := E_Verdict.NONE;
IF (_exec = E_ExecState.ERROR) AND (Part.Result.ReasonCode = E_Reason.NONE) THEN
    Part.Result.ReasonCode := _diag.ReasonCode;
END_IF
_M_PartEvent(Reason := E_Reason.EVENT_PART_PROCESSING_ABORTED,
    Text := 'std.event.partAborted: ');
_M_HostEvent(Kind := E_HostEventKind.PROCESSING_ABORTED, PartUid := Part.Uid,
    Subject := '', Value := '',
    Verdict := E_Verdict.NONE, ReasonCode := Part.Result.ReasonCode);
Part.Present := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PartEvent" Id="{f18c2d47-9b53-4e6a-8c02-3a71d5f0b429}">
      <Declaration><![CDATA[// §3.16.3 — one canonical part-lifecycle event: instant come+gone MESSAGE ring entry.
METHOD PRIVATE _M_PartEvent
VAR_INPUT
    Reason : E_Reason;
    Text : STRING(255);
END_VAR
VAR
    slot : INT;
    txt : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[txt := CONCAT(Text, Part.Uid);
slot := AlarmLog.Raise(Reason := Reason, Text := txt, Source := _name,
    Severity := E_Severity.LOW, Category := E_Category.PROCESS,
    ResetClass := E_ResetClass.AUTO_RESET);
IF slot > 0 THEN
    AlarmLog.Gone(Slot := slot);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PartProcessed" Id="{e91b5a02-73df-4f16-a8d4-1c30fe8a97d2}">
      <Declaration><![CDATA[// §3.16.3 EVENT_PART_PROCESSED — stamp the verdict, write the carrier FIRST
// (result-before-event contract), then raise the event. The Uid and result stay
// published until the next part so the HMI shows the last outcome.
METHOD PROTECTED _M_PartProcessed : BOOL
VAR_INPUT
    Verdict : E_Verdict;
    Reason : E_Reason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_PartProcessed := FALSE;
IF (_carrier = 0) OR NOT Part.Present THEN
    RETURN;
END_IF
// A reject without a first-out reason cannot satisfy the KPI or host contract.
// Reject it before writing the carrier so result-before-event remains atomic.
IF (Verdict = E_Verdict.NOK) AND (Reason = E_Reason.NONE) THEN
    _M_Fault(E_Reason.RESULT_RECORD_REJECTED, 'std.error.nokReasonRequired');
    RETURN;
END_IF
Part.Result.Verdict := Verdict;
Part.Result.ReasonCode := Reason;
Part.Result.StationPath := _name;
Part.Result.Stamp := F_Now();
Part.Result.TimeSynchronized := F_TimeSynchronized();
IF NOT _carrier.WriteResult(Ctx := Part) THEN
    _M_Fault(E_Reason.CARRIER_WRITE_FAILED, 'std.error.partCarrierWriteFailed');
    RETURN;
END_IF
// §8.11.2 — counters increment HERE, from the verdict; an NOK carries its
// first-out ReasonCode so scrap is analysable by cause (§8.8 vocabulary).
CASE Verdict OF
    E_Verdict.OK:     CountGood();
    E_Verdict.NOK:
        IF NOT CountNok(Reason := Reason) THEN
            RETURN;
        END_IF
    E_Verdict.REWORK: CountRework();
ELSE
    ;                                // NONE: no count — the part left unjudged
END_CASE
_M_PartEvent(Reason := E_Reason.EVENT_PART_PROCESSED, Text := 'std.event.partProcessed: ');
_M_HostEvent(Kind := E_HostEventKind.PROCESSED, PartUid := Part.Uid,
    Subject := '', Value := '',
    Verdict := Verdict, ReasonCode := Reason);
Part.Present := FALSE;
_M_PartProcessed := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PartReceived" Id="{58c0a7d9-14be-4f22-8d6a-9b2ef4c1e370}">
      <Declaration><![CDATA[// §3.16.3 EVENT_PART_RECEIVED — confirm identity at station entry via the carrier.
// FALSE with a CARRIER_READ_FAILED fault on a failed read (never silent), FALSE
// silently when no carrier is configured (§3.9 feature selectability).
METHOD PROTECTED _M_PartReceived : BOOL
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_PartReceived := FALSE;
IF _carrier = 0 THEN
    RETURN;
END_IF
Part.Uid := '';                              // station entry = fresh identity read
IF NOT _carrier.ReadContext(Ctx := Part) THEN
    _M_Fault(E_Reason.CARRIER_READ_FAILED, 'std.error.partCarrierReadFailed');
    RETURN;
END_IF
Part.Result.Verdict := E_Verdict.NONE;       // this station's outcome starts empty
Part.Result.ReasonCode := E_Reason.NONE;
Part.Result.StationPath := _name;
FOR i := 1 TO PL_Fraktal.MAX_RESULTS DO
    Part.Result.Records[i].Name := '';
END_FOR
_M_PartEvent(Reason := E_Reason.EVENT_PART_RECEIVED, Text := 'std.event.partReceived: ');
_M_HostEvent(Kind := E_HostEventKind.PART_RECEIVED, PartUid := Part.Uid,
    Subject := '', Value := '',
    Verdict := E_Verdict.NONE, ReasonCode := E_Reason.NONE);
_M_PartReceived := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PartRecord" Id="{7be4f6a3-1d20-4c8e-be55-f2a09318d67c}">
      <Declaration><![CDATA[// §3.16.1 — append one measured value to this part's result (test cells).
// FALSE when the bounded record table is full (RESULT_RECORD_REJECTED semantics).
METHOD PROTECTED _M_PartRecord : BOOL
VAR_INPUT
    RecordName : STRING(64);
    Value : LREAL;
    Minimum : LREAL;
    Maximum : LREAL;
    Target : LREAL;
    EngUnit : STRING(16);
END_VAR
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_PartRecord := FALSE;
IF NOT Part.Present THEN
    RETURN;
END_IF
FOR i := 1 TO PL_Fraktal.MAX_RESULTS DO
    IF Part.Result.Records[i].Name = '' THEN
        Part.Result.Records[i].Name := RecordName;
        Part.Result.Records[i].Value := Value;
        Part.Result.Records[i].Minimum := Minimum;
        Part.Result.Records[i].Maximum := Maximum;
        Part.Result.Records[i].Target := Target;
        Part.Result.Records[i].Unit := EngUnit;
        Part.Result.Records[i].InTol := (Maximum <= Minimum)
            OR ((Value >= Minimum) AND (Value <= Maximum));
        _M_PartRecord := TRUE;
        RETURN;
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PartStarted" Id="{02a97d1c-6bb5-4f80-9d34-c58b12f04ae6}">
      <Declaration><![CDATA[// §3.16.3 EVENT_PART_PROCESSING_STARTED — the value-adding sequence begins.
METHOD PROTECTED _M_PartStarted]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (_carrier = 0) OR NOT Part.Present THEN
    RETURN;
END_IF
_M_PartEvent(Reason := E_Reason.EVENT_PART_PROCESSING_STARTED,
    Text := 'std.event.partProcessingStarted: ');
_M_HostEvent(Kind := E_HostEventKind.PROCESSING_STARTED, PartUid := Part.Uid,
    Subject := '', Value := '',
    Verdict := E_Verdict.NONE, ReasonCode := E_Reason.NONE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PublishStatus" Id="{02d44270-09e8-4bc1-97fd-f43dd3fc44f2}">
      <Declaration><![CDATA[// §6.9/§3.10(a') — overlay the pending stall after the common mirror refresh.
METHOD PROTECTED _M_PublishStatus]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^._M_PublishStatus();
// §8.11.4(f)/§8.11.3 — one declaration, two views. Derived AFTER dispatch so the
// wait class reflects the step record this scan just set, not the previous one.
// §3.13 — live row state for the flow chart: how long the active step has run,
// and whether it outran its declared guard (the same watchdog §6.9 stalls on).
IF _exec = E_ExecState.BUSY THEN
    CurrentStepElapsed := DWORD_TO_TIME(TIME_TO_DWORD(TIME()) - _stepSinceMs);
ELSE
    CurrentStepElapsed := T#0S;
END_IF
CurrentStepTimedOut := _tStall.Q;
Starved := (_exec = E_ExecState.BUSY) AND (CurrentStep.TimeClass = E_TimeClass.WAIT_UPSTREAM);
Blocked := (_exec = E_ExecState.BUSY) AND (CurrentStep.TimeClass = E_TimeClass.WAIT_DOWNSTREAM);
// §8.11.3 — classify into the fixed machine-state set (priority: fault first,
// then planned states, then line attribution, then producing/idle).
IF (_exec = E_ExecState.ERROR) OR AlarmLog.Blocking THEN
    MachineState := E_MachineState.DOWN;
ELSIF _mode = E_Mode.CHANGEOVER THEN
    MachineState := E_MachineState.CHANGEOVER;
ELSIF Blocked THEN
    MachineState := E_MachineState.BLOCKED;
ELSIF Starved THEN
    MachineState := E_MachineState.STARVED;
ELSIF _exec = E_ExecState.BUSY THEN
    MachineState := E_MachineState.PRODUCING;
ELSIF _stopReq OR (_exec = E_ExecState.ABORTED) THEN
    MachineState := E_MachineState.STOPPED;
ELSE
    MachineState := E_MachineState.IDLE;
END_IF
Status.ControlDomainId := ControlDomain.Id;
Domain := ControlDomain;
Safety := ControlDomain.Safety;             // read-only HMI mirror; ownership stays in domain
ControlPower := ControlDomain.ControlPower;
IF (_exec <> E_ExecState.ERROR) AND (Pending.ReasonCode <> E_Reason.NONE) THEN
    Status.Diagnostic := Pending;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_PushHistory" Id="{3f9af757-7ef5-4499-8b8d-04dcd97acc93}">
      <Declaration><![CDATA[// §6.9(a) — fixed ring, newest at HistoryHead; never allocates
METHOD PROTECTED _M_PushHistory
VAR_INPUT
    D : ST_Diagnostic;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[HistoryHead := (HistoryHead MOD PL_Fraktal.MAX_DIAG_RING) + 1;
History[HistoryHead] := D;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_RaiseMaintenance" Id="{c92e4b71-6d05-4f88-9e3a-2b17d4c8a054}">
      <Declaration><![CDATA[// §8.11.4(d)/§8.12 — a Low-severity maintenance event: informs planning, does not
// stop the cycle. Instant come+gone ring entry (the trend data lives in Profiler).
METHOD PROTECTED _M_RaiseMaintenance
VAR_INPUT
    Reason : E_Reason;
    Text : STRING(255);
END_VAR
VAR
    slot : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[slot := AlarmLog.Raise(Reason := Reason, Text := Text, Source := _name,
    Severity := E_Severity.LOW, Category := E_Category.SYSTEM,
    ResetClass := E_ResetClass.AUTO_RESET);
IF slot > 0 THEN
    AlarmLog.Gone(Slot := slot);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_RouteConfigWrite" Id="{4e524daf-e482-4764-8639-e58c1f363aa3}">
      <Declaration><![CDATA[// §3.8b — route a published editable field to the module that registered it.
// WriteConfig already owns access and root-path checks; the recursive walk finds
// the owner by Scope, and that module rechecks revision, type, range, domain and
// its own invariants before storing. A type whose values are declared through
// M_RegisterConfig* therefore needs no override at all, which is the point: a new
// module type costs no routing code (§1.1 O1). Framework-owned keys never reach
// here — _M_WriteBaseConfig answers those first. An override that adds
// hand-written routing shall call SUPER^ first and keep its own answer only when
// the base declines.
METHOD PROTECTED _M_RouteConfigWrite : BOOL
VAR_INPUT
    TargetPath : STRING(255);
    WriteKey   : STRING(160);
    Revision   : UDINT;
    TextValue  : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// RequiresReady is a question about THIS root's state, which the owning child
// cannot see from where it sits, so the root answers it on the way down.
_M_RouteConfigWrite := M_ApplyConfigWrite(Scope := TargetPath,
    WriteKey := WriteKey, Revision := Revision, TextValue := TextValue,
    RootReady := (_exec = E_ExecState.READY));]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_WriteBaseConfig" Id="{c30f39b4-eae4-421d-a415-c6dc3b402679}">
      <Declaration><![CDATA[// Framework-owned typed handlers. Stable keys are independent of browse paths;
// capability revision 1 accepts exact enum ordinals and only while READY.
METHOD PRIVATE _M_WriteBaseConfig : BOOL
VAR_INPUT
    TargetPath : STRING(255);
    WriteKey   : STRING(160);
    Revision   : UDINT;
    TextValue  : STRING(255);
END_VAR
VAR
    i   : INT;
    key : STRING(160);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[_M_WriteBaseConfig := FALSE;
IF (TargetPath <> Status.Name) OR (Revision <> 1) OR (_exec <> E_ExecState.READY) THEN
    RETURN;
END_IF
FOR i := 0 TO PL_Fraktal.MODE_COUNT - 1 DO
    key := CONCAT('unit.modePolicy.', CONCAT(TO_STRING(i), '.shield'));
    IF WriteKey = key THEN
        IF TextValue = '0' THEN
            ModePolicy[i].Shield := E_ModeSwitchShield.INTERRUPTIBLE;
        ELSIF TextValue = '1' THEN
            ModePolicy[i].Shield := E_ModeSwitchShield.CONFIRM;
        ELSIF TextValue = '2' THEN
            ModePolicy[i].Shield := E_ModeSwitchShield.BLOCKED_WHILE_RUNNING;
        ELSE
            RETURN;
        END_IF
        _modePolicyStored[i].Shield := ModePolicy[i].Shield;
        _M_WriteBaseConfig := TRUE;
        RETURN;
    END_IF
    key := CONCAT('unit.modePolicy.', CONCAT(TO_STRING(i), '.style'));
    IF WriteKey = key THEN
        IF TextValue = '0' THEN
            ModePolicy[i].Style := E_ModeSwitchStyle.GRACEFUL;
        ELSIF TextValue = '1' THEN
            ModePolicy[i].Style := E_ModeSwitchStyle.IMMEDIATE;
        ELSE
            RETURN;
        END_IF
        _modePolicyStored[i].Style := ModePolicy[i].Style;
        _M_WriteBaseConfig := TRUE;
        RETURN;
    END_IF
END_FOR]]></ST></Implementation>
    </Method>
    <Method Name="_M_RouteForceChannel" Id="{301182d5-8822-451a-950c-49d23daf4640}">
      <Declaration><![CDATA[// Application override resolves ChannelPath in THIS root's approved I/O catalog,
// refuses input/safety/unmapped channels, applies its channel-specific §7.6 permit,
// and routes only an approved mapped output. ForceChannel already owns MANUAL,
// stopped/READY, access and audit. Base fails closed.
METHOD PROTECTED _M_RouteForceChannel : BOOL
VAR_INPUT
    ChannelPath : STRING(255);
    Force       : BOOL;
    BoolText    : STRING(255);
    AnalogText  : STRING(160);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_RouteForceChannel := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_RouteManual" Id="{9fa4e2c2-3f5f-4681-aed5-559f1df0d2c6}">
      <Declaration><![CDATA[// §7.6.1 — concrete Units override to map a target path to a child module and call
// its ManualCommand. Base returns FALSE (no commandable children).
METHOD PROTECTED _M_RouteManual : BOOL
VAR_INPUT
    TargetPath : STRING(255);
    Value : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_RouteManual := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_RecordSequenceStep" Id="{bae7334e-b67d-46db-a917-aa05f1522e0f}">
      <Declaration><![CDATA[// §3.13 — keep the published flow chart in step with the chain.
// Called only from _M_SetStep, so every step of every chain lands here exactly
// once per visit and a chain author writes nothing (§1.1 O1). Rows are matched by
// StepNo, appended on first sight and bounded: an overflowing chain publishes the
// first MAX_SEQUENCE_STEPS rows rather than dropping the chart.
METHOD PROTECTED _M_RecordSequenceStep
VAR_INPUT
    StepNo        : INT;
    StepName      : STRING(120);
    Awaits        : I_Module;
    AwaitingLabel : STRING(120);
    TimeClass     : E_TimeClass;
    ExpectedTime  : TIME;
    Branch        : INT;           // §6.12 concurrent leg, 0 = the chain's main line
END_VAR
VAR
    i    : INT;
    hit  : INT;
    path : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[hit := 0;
FOR i := 1 TO SequenceStepCount DO
    IF SequenceStepDef[i].StepNo = StepNo THEN
        hit := i;
        EXIT;
    END_IF
END_FOR
IF hit = 0 THEN
    IF SequenceStepCount >= PL_Fraktal.MAX_SEQUENCE_STEPS THEN
        RETURN;                        // bounded: publish what fits, never overrun
    END_IF
    SequenceStepCount := SequenceStepCount + 1;
    hit := SequenceStepCount;
    // §3.10.2 — the static half of this row (StepNo, StepName, the awaited path)
    // is served through the manifest, NOT cyclically, and the HMI refetches only
    // when ConfigRev changes. Rows are discovered by visit, so a chart that grows
    // after the HMI's fetch would render every new row with StepNo 0 and no text.
    // Only the append bumps it: a re-visit rewrites identical values.
    ConfigRev := ConfigRev + 1;
END_IF
// The drill-down target is the module the step DECLARES it commands. Reading it
// here is what makes the link unambiguous: no IF/CASE chose it (§3.13).
path := '';
IF Awaits <> 0 THEN
    path := Awaits.Name;
END_IF
// Static half: fixed from this first visit, published through the manifest.
SequenceStepDef[hit].StepNo        := StepNo;
SequenceStepDef[hit].Branch        := Branch;
SequenceStepDef[hit].TimeClass     := TimeClass;
SequenceStepDef[hit].ExpectedTime  := ExpectedTime;
SequenceStepDef[hit].StepName      := StepName;
SequenceStepDef[hit].AwaitingLabel := AwaitingLabel;
SequenceStepDef[hit].AwaitsPath    := path;
SequenceSteps[hit].Visited := TRUE;
// §6.12 — the LEG owns the clock, because a leg runs exactly one step at a time.
// A different row on this leg means the step just changed.
IF ActiveSteps[Branch].RowIdx <> hit THEN
    SequenceSteps[hit].WarningActive := FALSE;   // §6.9(e) this visit starts clean
    _M_SequenceAnnotationClear(RowIdx := hit, IsError := FALSE);
    _branchSinceMs[Branch] := TIME_TO_DWORD(TIME());
    ActiveSteps[Branch].RowIdx := hit;
    ActiveSteps[Branch].Elapsed := T#0S;
    ActiveSteps[Branch].TimedOut := FALSE;
    IF Branch = 0 THEN
        _stepSinceMs := _branchSinceMs[0];
        CurrentStepElapsed := T#0S;
    END_IF
END_IF
_branchTouched[Branch] := TRUE;
ActiveSteps[Branch].Elapsed :=
    DWORD_TO_TIME(TIME_TO_DWORD(TIME()) - _branchSinceMs[Branch]);
// A leg carries its own guard: the §6.9 stall watchdog is singular and follows the
// main line, so without this a leg could overrun for ever with nothing to show.
ActiveSteps[Branch].TimedOut := (ExpectedTime > T#0S)
    AND (ActiveSteps[Branch].Elapsed > ExpectedTime);
// The row recorded last IS the step action executing right now, which is what makes
// it the correct target for a §6.9 raise or a §6.9(e) message raised further down
// that same action - on the main line or on any leg.
_seqIndex := hit;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_ResetSequenceRows" Id="{3a7e979a-9c02-4e58-aa36-f0627902f8fb}">
      <Declaration><![CDATA[// §3.13 — drop the published flow chart so the next mode builds its own.
//
// The row table is DISCOVERED by visit (§6.5), which is what makes it free to
// author - but discovery has no end: without this the table becomes the union of
// every chain run since boot. After AUTO then HOME the operator would be shown
// AUTO's rows and HOME's together with only some of them live, and the union of
// the press demo's three modes is 29 rows against a bound of 32. A mode is the
// natural boundary: within one mode a re-run keeps its rows, so Visited and
// LastDuration stay meaningful across cycles.
//
// Bounded by the count actually in use, not by MAX_SEQUENCE_STEPS: clearing rows
// nobody published would cost the whole table on every mode change (§1.1 O10 -
// deterministic scan time).
METHOD PROTECTED _M_ResetSequenceRows
VAR
    i : INT;
    e : ST_SequenceStep;
    x : ST_SequenceStepDef;
    c : ST_SequenceCursor;
    a : ST_SequenceAnnotation;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF SequenceStepCount > 0 THEN
    // §3.10.2 — the rows this clears are published through the manifest, so the
    // HMI's cached copy is now describing a chart that no longer exists. Guarded
    // by the count: a mode change with nothing published changed no manifest and
    // must not cost a refetch.
    ConfigRev := ConfigRev + 1;
END_IF
FOR i := 1 TO SequenceStepCount DO
    SequenceSteps[i] := e;             // zero-initialized local: clears every field
    SequenceStepDef[i] := x;
END_FOR
SequenceStepCount := 0;
FOR i := 0 TO PL_Fraktal.MAX_PARALLEL_BRANCHES DO
    ActiveSteps[i] := c;
    _branchTouched[i] := FALSE;
END_FOR
FOR i := 1 TO SequenceAnnotationCount DO
    SequenceAnnotations[i] := a;
END_FOR
SequenceAnnotationCount := 0;
_seqIndex := 0;                        // nothing to stamp until the new chain steps
CurrentStepElapsed := T#0S;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_SequenceAnnotate" Id="{981fa92c-f12b-4972-9483-880edfae72c8}">
      <Declaration><![CDATA[// §6.9 — attach an error or a message to a flow-chart row.
//
// One slot per (row, kind): re-annotating the same row with the same kind
// overwrites rather than accumulating, which is what makes it safe for the
// per-visit message latch to call this without tracking slots.
//
// Returns FALSE when the table is full. The CALLER has already set the row flag
// by then, deliberately: a full table costs the text, never the mark, so the
// chart still shows that something happened here (§5.6 degrade, never mislead).
METHOD PROTECTED _M_SequenceAnnotate : BOOL
VAR_INPUT
    RowIdx     : INT;
    IsError    : BOOL;
    Key        : STRING(120);
    SourcePath : STRING(80);
END_VAR
VAR
    i    : INT;
    slot : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_SequenceAnnotate := FALSE;
IF (RowIdx < 1) OR (RowIdx > SequenceStepCount) THEN
    RETURN;
END_IF
slot := 0;
FOR i := 1 TO SequenceAnnotationCount DO
    IF (SequenceAnnotations[i].RowIdx = RowIdx)
    AND (SequenceAnnotations[i].IsError = IsError) THEN
        slot := i;
        EXIT;
    END_IF
END_FOR
IF slot = 0 THEN
    FOR i := 1 TO SequenceAnnotationCount DO
        IF SequenceAnnotations[i].RowIdx = 0 THEN     // freed by a clear
            slot := i;
            EXIT;
        END_IF
    END_FOR
END_IF
IF slot = 0 THEN
    IF SequenceAnnotationCount >= PL_Fraktal.MAX_SEQUENCE_ANNOTATIONS THEN
        RETURN;                                       // full: the mark stands, the text does not
    END_IF
    SequenceAnnotationCount := SequenceAnnotationCount + 1;
    slot := SequenceAnnotationCount;
END_IF
SequenceAnnotations[slot].RowIdx     := RowIdx;
SequenceAnnotations[slot].IsError    := IsError;
SequenceAnnotations[slot].Key        := Key;
SequenceAnnotations[slot].SourcePath := SourcePath;
_M_SequenceAnnotate := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_SequenceAnnotationClear" Id="{7256d50d-cf16-4906-8e35-fd394563602f}">
      <Declaration><![CDATA[// §6.9 — release annotations. RowIdx 0 means "every row" (the ERROR-cleared edge
// drops all error notes at once); otherwise just that row's note of that kind.
// Freed slots are reused before the table grows, so a chain that warns on many
// steps over many cycles does not exhaust it.
METHOD PROTECTED _M_SequenceAnnotationClear
VAR_INPUT
    RowIdx  : INT;
    IsError : BOOL;
END_VAR
VAR
    i : INT;
    e : ST_SequenceAnnotation;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO SequenceAnnotationCount DO
    IF (SequenceAnnotations[i].IsError = IsError)
    AND ((RowIdx = 0) OR (SequenceAnnotations[i].RowIdx = RowIdx)) THEN
        SequenceAnnotations[i] := e;                  // RowIdx 0 marks the slot free
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_SetStep" Id="{1066dd3c-baf2-43ea-91d5-309ad4ca7878}">
      <Declaration><![CDATA[// §6.5 — the ONE line per step: record for the §6.9 walk AND the §8.11.4 profiler
METHOD PROTECTED _M_SetStep
VAR_INPUT
    StepNo        : INT;
    StepName      : STRING(120);
    Awaits        : I_Module;
    AwaitingLabel : STRING(120);
    TimeClass     : E_TimeClass;
    ExpectedTime  : TIME;
END_VAR
VAR
    i : INT;
    e : ST_CondRecord;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF StepNo <> CurrentStep.StepNo THEN
    _tStall(IN := FALSE);
    _M_ClearPending();
    FOR i := 1 TO PL_Fraktal.MAX_STEP_CONDS DO
        CurrentStep.Conds[i] := e;
    END_FOR
END_IF
CurrentStep.StepNo        := StepNo;
CurrentStep.StepName      := StepName;
CurrentStep.AwaitingLabel := AwaitingLabel;
CurrentStep.TimeClass     := TimeClass;
CurrentStep.ExpectedTime  := ExpectedTime;
_awaits := Awaits;
_M_RecordSequenceStep(StepNo := StepNo, StepName := StepName, Awaits := Awaits,
    AwaitingLabel := AwaitingLabel, TimeClass := TimeClass, ExpectedTime := ExpectedTime,
    Branch := 0);
Profiler.StepChanged(StepNo := StepNo, StepName := StepName, TimeClass := TimeClass,
    Expected := ExpectedTime);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_StallWalk" Id="{ee453cd4-7027-4207-b43e-f1a12367922c}">
      <Declaration><![CDATA[// §6.9 — build the pending stall reason: step -> awaited command -> first FALSE condition
METHOD PROTECTED _M_StallWalk]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Pending.ReasonCode = E_Reason.NONE THEN
    Pending.Since := F_Now();
    Pending.TimeSynchronized := F_TimeSynchronized();
END_IF
Pending.ReasonCode := E_Reason.STEP_STALLED;
Pending.Severity   := E_Severity.LOW;
Pending.Category   := E_Category.PROCESS;
Pending.SourcePath := _name;
Pending.Description := 'std.diagnostic.stepStalled';]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_StepGate" Id="{853d1e75-22c1-46fb-9a92-007882839a98}">
      <Declaration><![CDATA[// §3.4.2 — the sequence author calls this at each step boundary; returns TRUE when
// the sequence may advance. Steppable (default TRUE) is the PER-STEP stop-point flag:
// a step with Steppable := FALSE runs straight through even in SINGLE_STEP/HOLD_TO_RUN
// (group several motions into one operator step, or a step unsafe to pause mid-way).
// CONTINUOUS: always TRUE. SINGLE_STEP: TRUE once per StepRequest edge (only if
// Steppable). HOLD_TO_RUN: TRUE while held (only if Steppable). Interlocks are
// enforced by the modules regardless (this only paces the sequence).
METHOD PROTECTED _M_StepGate : BOOL
VAR_INPUT
    Steppable : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Steppable THEN
    _M_StepGate := TRUE;               // not a stop point: advance regardless of run style
    RETURN;
END_IF
CASE RunStyle OF
    E_RunStyle.SINGLE_STEP:
        _stepArm(CLK := _stepReq);
        _stepReq := FALSE;
        _M_StepGate := _stepArm.Q;      // one advance per request edge
    E_RunStyle.HOLD_TO_RUN:
        _M_StepGate := _holdRun;        // advance only while held (NON-SAFETY)
ELSE
    _M_StepGate := TRUE;                // CONTINUOUS
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_Supports" Id="{5285aa9e-3e18-4090-bed9-0119293228bb}">
      <Declaration><![CDATA[// §3.4 — override to declare the type's mode set (baseline: AUTO + MANUAL)
METHOD PROTECTED _M_Supports : BOOL
VAR_INPUT
    Mode : E_Mode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_Supports := (Mode = E_Mode.AUTO) OR (Mode = E_Mode.MANUAL);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_SupportsRunStyle" Id="{f4e81ed4-d8b0-494c-bd7a-6b417d6219cf}">
      <Declaration><![CDATA[// §3.4.2 — a concrete Unit overrides to opt a mode into SINGLE_STEP/HOLD_TO_RUN.
// Base: only CONTINUOUS.
METHOD PROTECTED _M_SupportsRunStyle : BOOL
VAR_INPUT
    Style : E_RunStyle;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_SupportsRunStyle := (Style = E_RunStyle.CONTINUOUS);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_TakeDecision" Id="{e2e1443d-0421-4608-8ae5-b7bb44177b3c}">
      <Declaration><![CDATA[// §6.11 — returns the chosen option once and clears the request (0 = none yet)
METHOD PROTECTED _M_TakeDecision : INT]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF DecisionAnswer > 0 THEN
    _M_TakeDecision := DecisionAnswer;
    IF NOT _decisionResolutionLogged THEN
        _M_LogDecision(EventKey := 'std.audit.decisionOperatorResolved',
            SourcePath := Decision.SourcePath, Option := DecisionAnswer);
    END_IF
    _M_ClearDecisionState();
ELSE
    _M_TakeDecision := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CountGood" Id="{852e951b-039f-45bd-80a3-6417310e2406}">
      <Declaration><![CDATA[// §8.11 — called by the chain/verdict glue at part completion
METHOD CountGood : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[GoodCount := GoodCount + 1;
CountGood := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CountNok" Id="{a686f5b6-4c90-4e12-9d98-fa111d14dfe8}">
      <Declaration><![CDATA[// Sections 8.11.2 and 11.6: one authoritative NOK outcome path.
// Part.Uid is empty when the optional traceability carrier is not configured.
METHOD CountNok : BOOL
VAR_INPUT
    Reason : E_Reason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CountNok := FALSE;
IF Reason = E_Reason.NONE THEN
    _M_Fault(E_Reason.RESULT_RECORD_REJECTED, 'std.error.nokReasonRequired');
    RETURN;
END_IF
IF NOT _M_HostEvent(Kind := E_HostEventKind.NOK, PartUid := Part.Uid,
        Subject := '', Value := '', Verdict := E_Verdict.NOK,
        ReasonCode := Reason) THEN
    _M_Fault(E_Reason.RESULT_RECORD_REJECTED, 'std.error.hostEventRejected');
    RETURN;
END_IF
NokCount := NokCount + 1;
NokReason := Reason;
CountNok := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CountRework" Id="{5c8e02d7-9a41-4f36-8b52-e04a71c6d983}">
      <Declaration><![CDATA[// §8.11.2 — REWORK verdict counter (see CountGood)
METHOD CountRework : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReworkCount := ReworkCount + 1;
CountRework := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_AppendConfig" Id="{29c7f5d4-0b81-4ae3-9762-84f6d013ba58}">
      <Declaration><![CDATA[// §3.10.2 — Unit facets after the composite walk (own catalog + children):
// model catalog and per-mode switch policy, both static between config edits.
METHOD M_AppendConfig : BOOL
VAR_INPUT
    Pager : REFERENCE TO FB_ConfigPager;
END_VAR
VAR
    i        : INT;
    metaIndex: INT;
    item     : STRING(255);
    writeKey : STRING(160);
    meta     : ST_AlarmMeta;
    seqIdx   : INT;
    seqBase  : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_AppendConfig := SUPER^.M_AppendConfig(Pager := Pager);
Pager.M_AppendNumber(Scope := Status.Name, Item := 'StallTime',
    Number := TIME_TO_DINT(StallTime));
Pager.M_AppendNumber(Scope := Status.Name, Item := 'AvailableModelCount',
    Number := TO_DINT(AvailableModelCount));
FOR i := 1 TO AvailableModelCount DO
    item := CONCAT('AvailableModels/AvailableModels[',
        CONCAT(TO_STRING(i), ']/ModelCode'));
    Pager.M_Append(Scope := Status.Name, Item := item,
        ValueText := AvailableModels[i].ModelCode);
END_FOR
FOR i := 0 TO PL_Fraktal.MODE_COUNT - 1 DO
    item := CONCAT('ModePolicy/ModePolicy[', CONCAT(TO_STRING(i), ']/Shield'));
    writeKey := CONCAT('unit.modePolicy.', CONCAT(TO_STRING(i), '.shield'));
    Pager.M_AppendCapability(Scope := Status.Name, Item := item,
        ValueText := TO_STRING(TO_DINT(ModePolicy[i].Shield)), WriteKey := writeKey,
        WriteRevision := 1, ConfigKind := E_ConfigKind.STATION_CFG,
        ValueType := E_ConfigValueType.NUMBER, Writable := TRUE,
        RequiresReady := TRUE, HasMinimum := TRUE, HasMaximum := TRUE,
        Minimum := 0.0, Maximum := 2.0, Unit := '', LabelKey := '',
        EnumDomain := '0|1|2');
    item := CONCAT('ModePolicy/ModePolicy[', CONCAT(TO_STRING(i), ']/Style'));
    writeKey := CONCAT('unit.modePolicy.', CONCAT(TO_STRING(i), '.style'));
    Pager.M_AppendCapability(Scope := Status.Name, Item := item,
        ValueText := TO_STRING(TO_DINT(ModePolicy[i].Style)), WriteKey := writeKey,
        WriteRevision := 1, ConfigKind := E_ConfigKind.STATION_CFG,
        ValueType := E_ConfigValueType.NUMBER, Writable := TRUE,
        RequiresReady := TRUE, HasMinimum := TRUE, HasMaximum := TRUE,
        Minimum := 0.0, Maximum := 1.0, Unit := '', LabelKey := '',
        EnumDomain := '0|1');
END_FOR
Pager.M_AppendNumber(Scope := Status.Name, Item := 'AlarmLog/MetaCount',
    Number := TO_DINT(PL_ReasonCatalog.COUNT + AlarmLog.MetaCount));
// §8.8/§8.9: the standard catalog is generated from the numeric sources plus
// one symbol-keyed rationalization registry. Static metadata stays manifest-only.
FOR i := 1 TO PL_ReasonCatalog.COUNT DO
    IF NOT F_ReasonMetaByIndex(Index := i, Meta := meta) THEN
        EXIT;
    END_IF
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(i), ']/ReasonCode'));
    Pager.M_AppendNumber(Scope := Status.Name, Item := item,
        Number := TO_DINT(meta.ReasonCode));
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(i), ']/OperatorAction'));
    Pager.M_Append(Scope := Status.Name, Item := item,
        ValueText := meta.OperatorAction);
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(i), ']/Consequence'));
    Pager.M_Append(Scope := Status.Name, Item := item,
        ValueText := meta.Consequence);
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(i), ']/Priority'));
    Pager.M_AppendNumber(Scope := Status.Name, Item := item,
        Number := TO_DINT(meta.Priority));
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(i), ']/Category'));
    Pager.M_AppendNumber(Scope := Status.Name, Item := item,
        Number := TO_DINT(meta.Category));
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(i), ']/Shelvable'));
    IF meta.Shelvable THEN
        Pager.M_Append(Scope := Status.Name, Item := item, ValueText := 'TRUE');
    ELSE
        Pager.M_Append(Scope := Status.Name, Item := item, ValueText := 'FALSE');
    END_IF
END_FOR
// External/application libraries may append rationalized reasons not present in
// the shipped registry. RegisterMetaFull enforces their complete record.
FOR i := 1 TO AlarmLog.MetaCount DO
    metaIndex := PL_ReasonCatalog.COUNT + i;
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(metaIndex), ']/ReasonCode'));
    Pager.M_AppendNumber(Scope := Status.Name, Item := item,
        Number := TO_DINT(AlarmLog.Meta[i].ReasonCode));
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(metaIndex), ']/OperatorAction'));
    Pager.M_Append(Scope := Status.Name, Item := item,
        ValueText := AlarmLog.Meta[i].OperatorAction);
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(metaIndex), ']/Consequence'));
    Pager.M_Append(Scope := Status.Name, Item := item,
        ValueText := AlarmLog.Meta[i].Consequence);
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(metaIndex), ']/Priority'));
    Pager.M_AppendNumber(Scope := Status.Name, Item := item,
        Number := TO_DINT(AlarmLog.Meta[i].Priority));
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(metaIndex), ']/Category'));
    Pager.M_AppendNumber(Scope := Status.Name, Item := item,
        Number := TO_DINT(AlarmLog.Meta[i].Category));
    item := CONCAT('AlarmLog/Meta/Meta[', CONCAT(TO_STRING(metaIndex), ']/Shelvable'));
    IF AlarmLog.Meta[i].Shelvable THEN
        Pager.M_Append(Scope := Status.Name, Item := item, ValueText := 'TRUE');
    ELSE
        Pager.M_Append(Scope := Status.Name, Item := item, ValueText := 'FALSE');
    END_IF
END_FOR
// §3.13/§3.10.2 — the static definition of each flow-chart row. The Item fragment
// reproduces the browse path the LIVE half is published under, so the HMI mapper
// reads `SequenceSteps[i]/StepName` without knowing it arrived by a different
// route: one row structure, half of it live, half fetched once and cached.
// Bounded by the discovered count, so an empty chain appends nothing.
FOR seqIdx := 1 TO SequenceStepCount DO
    seqBase := CONCAT('SequenceSteps/SequenceSteps[', CONCAT(TO_STRING(seqIdx), ']/'));
    Pager.M_AppendNumber(Scope := Status.Name, Item := CONCAT(seqBase, 'StepNo'),
        Number := TO_DINT(SequenceStepDef[seqIdx].StepNo));
    Pager.M_AppendNumber(Scope := Status.Name, Item := CONCAT(seqBase, 'Branch'),
        Number := TO_DINT(SequenceStepDef[seqIdx].Branch));
    Pager.M_AppendNumber(Scope := Status.Name, Item := CONCAT(seqBase, 'TimeClass'),
        Number := TO_DINT(SequenceStepDef[seqIdx].TimeClass));
    Pager.M_AppendNumber(Scope := Status.Name, Item := CONCAT(seqBase, 'ExpectedTime'),
        Number := TIME_TO_DINT(SequenceStepDef[seqIdx].ExpectedTime));
    Pager.M_Append(Scope := Status.Name, Item := CONCAT(seqBase, 'StepName'),
        ValueText := SequenceStepDef[seqIdx].StepName);
    Pager.M_Append(Scope := Status.Name, Item := CONCAT(seqBase, 'AwaitingLabel'),
        ValueText := SequenceStepDef[seqIdx].AwaitingLabel);
    Pager.M_Append(Scope := Status.Name, Item := CONCAT(seqBase, 'AwaitsPath'),
        ValueText := SequenceStepDef[seqIdx].AwaitsPath);
END_FOR]]></ST>
      </Implementation>
    </Method>
