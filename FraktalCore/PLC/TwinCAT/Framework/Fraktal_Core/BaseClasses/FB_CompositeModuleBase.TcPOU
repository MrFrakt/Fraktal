<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_CompositeModuleBase" Id="{63098d21-8fd7-4883-9a89-b8cb22e5ae0c}" SpecialFunc="None">
    <Declaration><![CDATA[// Core §2.2 / §8.2 — CM lifecycle + child registry + first-out rollup.
// An EM type registers its children in Setup (_M_Register), ticks them every scan
// (_M_TickChildren, so status stays live whether or not a command runs — Annex B),
// and adopts the first faulted child's diagnostic verbatim (_M_RollupFault).
FUNCTION_BLOCK ABSTRACT FB_CompositeModuleBase EXTENDS FB_ModuleBase
VAR
    {attribute 'OPC.UA.DA' := '0'}
    _children : ARRAY[1..PL_Fraktal.MAX_EM_CHILDREN] OF I_Module;
    _nChild   : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Cyclic();]]></ST>
    </Implementation>
    <Method Name="_M_Register" Id="{f4ee4a09-9702-4f84-aaec-2532ff317d62}">
      <Declaration><![CDATA[// called from the type's Setup (Core §3.11); bounds-checked per Core §5.6
METHOD PROTECTED _M_Register : BOOL
VAR_INPUT
    Child : I_Module;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (Child = 0) OR (_nChild >= PL_Fraktal.MAX_EM_CHILDREN) THEN
    _M_Register := FALSE;
    RETURN;
END_IF
_nChild := _nChild + 1;
_children[_nChild] := Child;
_M_Register := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="PrepareRecipe" Id="{b24475ae-9df9-45e0-bb10-84e166982c23}">
      <Declaration><![CDATA[METHOD PrepareRecipe : BOOL
VAR_INPUT
    Model : ST_ModelId;
END_VAR
VAR
    i, j : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[PrepareRecipe := TRUE;
FOR i := 1 TO _nChild DO
    IF (_children[i] <> 0) AND_THEN NOT _children[i].PrepareRecipe(Model := Model) THEN
        PrepareRecipe := FALSE;
        FOR j := 1 TO i DO
            IF _children[j] <> 0 THEN _children[j].AbortRecipe(); END_IF
        END_FOR
        RETURN;
    END_IF
END_FOR]]></ST></Implementation>
    </Method>
    <Method Name="CommitRecipe" Id="{026d831c-c810-4d30-b879-6b6636faeb5d}">
      <Declaration><![CDATA[METHOD CommitRecipe
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 THEN _children[i].CommitRecipe(); END_IF
END_FOR]]></ST></Implementation>
    </Method>
    <Method Name="AbortRecipe" Id="{80b7b053-1b4b-41c5-a245-9f018f707104}">
      <Declaration><![CDATA[METHOD AbortRecipe
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 THEN _children[i].AbortRecipe(); END_IF
END_FOR]]></ST></Implementation>
    </Method>
    <Method Name="_M_RollupFault" Id="{9ae3a09a-bf2d-4c4c-8a41-3c1afda50f85}">
      <Declaration><![CDATA[// Core §8.2 — adopt the FIRST faulted child's first-out (reason + child SourcePath)
METHOD PROTECTED _M_RollupFault : BOOL
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_RollupFault := FALSE;
FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 AND_THEN _children[i].FaultActive THEN
        _M_FaultDiag(_children[i].GetFaultSummary());
        _M_RollupFault := TRUE;
        RETURN;
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_RollupHold" Id="{06969723-8571-4eb0-9e4d-6f369085d2ae}">
      <Declaration><![CDATA[// Core §8.2/§6.1 HELD — the hold analogue of _M_RollupFault: adopt the FIRST held
// child's declared-wait reason (with the child's SourcePath) so this composite is
// held-and-explained rather than silently BUSY. No ERROR, no alarm: a hold rolls up
// as information, and clears itself when the child resumes.
METHOD PROTECTED _M_RollupHold : BOOL
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_RollupHold := FALSE;
FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 AND_THEN _children[i].HoldActive THEN
        _M_HoldDiag(Diag := _children[i].GetFaultSummary());
        _M_RollupHold := TRUE;
        RETURN;
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ReleaseCommand" Id="{36fcafe9-7481-497a-8437-77422adbf6a4}">
      <Declaration><![CDATA[// Core §6.1/§8.3(b) — releasing a composite's command releases the whole subtree:
// a frozen chain leaves commands asserted at every tier it had reached, and any one
// of them left high blocks that module's next command edge. Recursive by
// construction, so a nested EM needs no per-type recovery code.
METHOD M_ReleaseCommand : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_ReleaseCommand := SUPER^.M_ReleaseCommand();
_M_ReleaseChildCommands();]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_ReleaseChildCommands" Id="{68fd6c1d-71d8-4c50-a854-2f1a119ab5b0}">
      <Declaration><![CDATA[// Core §6.1/§8.3(b) — drop every registered child's command latch (recursively).
// Used by the recovery reset: the mode chain that issued those commands is no longer
// running, so nothing else will ever clear them (Core §6.8 chains hold the child's
// Execute in the step that issued it).
METHOD PROTECTED _M_ReleaseChildCommands
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 THEN
        _children[i].M_ReleaseCommand();
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_TickChildren" Id="{ceb9196c-607c-4188-a830-316778464529}">
      <Declaration><![CDATA[// children always tick so their status stays live (Annex B §B.3)
METHOD PROTECTED _M_TickChildren
VAR
    i : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 THEN
        _children[i].Cyclic();
    END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="ModuleType" Id="{0d310480-7927-4488-9b81-b21d73233d7f}">
      <Declaration><![CDATA[PROPERTY ModuleType : E_ModuleType]]></Declaration>
      <Get Name="Get" Id="{1e89d76a-b9b8-4104-bcec-5ece6d0ad554}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ModuleType := E_ModuleType.NONE;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="M_AppendConfig" Id="{07d3f6a9-84b2-4e01-bc57-2df19c60e843}">
      <Declaration><![CDATA[// §3.10.2 — own facets first, then every registered child, depth-first in
// registration order so the manifest walk is deterministic across requests.
METHOD M_AppendConfig : BOOL
VAR_INPUT
    Pager : REFERENCE TO FB_ConfigPager;
END_VAR
VAR
    i    : INT;
    iCfg : I_ConfigSource;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_AppendConfig := SUPER^.M_AppendConfig(Pager := Pager);
FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 THEN
        IF __QUERYINTERFACE(_children[i], iCfg) THEN
            iCfg.M_AppendConfig(Pager := Pager);
        END_IF
    END_IF
END_FOR]]></ST></Implementation>
    </Method>
    <Method Name="M_ApplyConfigWrite" Id="{a70d3e91-6c28-4b5d-83f7-92e10bd4c576}">
      <Declaration><![CDATA[// §3.8b — own registrations first, then every registered child, in the same
// depth-first order as M_AppendConfig. Scope makes the walk unambiguous: at most
// one module answers, and the first TRUE ends it.
METHOD M_ApplyConfigWrite : BOOL
VAR_INPUT
    Scope     : STRING(255);
    WriteKey  : STRING(160);
    Revision  : UDINT;
    TextValue : STRING(255);
    RootReady : BOOL;
END_VAR
VAR
    i    : INT;
    iCfg : I_ConfigSource;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_ApplyConfigWrite := SUPER^.M_ApplyConfigWrite(Scope := Scope,
    WriteKey := WriteKey, Revision := Revision, TextValue := TextValue,
    RootReady := RootReady);
IF M_ApplyConfigWrite THEN
    RETURN;
END_IF
FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 THEN
        IF __QUERYINTERFACE(_children[i], iCfg) THEN
            IF iCfg.M_ApplyConfigWrite(Scope := Scope, WriteKey := WriteKey,
                    Revision := Revision, TextValue := TextValue,
                    RootReady := RootReady) THEN
                M_ApplyConfigWrite := TRUE;
                RETURN;
            END_IF
        END_IF
    END_IF
END_FOR]]></ST></Implementation>
    </Method>
        <Method Name="M_ApplyCapture" Id="{c0b4cd5b-84d7-416b-bdf4-d6788138d8ab}">
        <Declaration><![CDATA[// §3.8c - the capture walk is the write walk. Same order, same "first owner
// answers TRUE" rule, so a capture reaches exactly the module a write would.
METHOD M_ApplyCapture : BOOL
VAR_INPUT
    Scope     : STRING(255);
    WriteKey  : STRING(160);
    Revision  : UDINT;
    RootReady : BOOL;
END_VAR
VAR
    i    : INT;
    iCfg : I_ConfigSource;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[M_ApplyCapture := SUPER^.M_ApplyCapture(Scope := Scope, WriteKey := WriteKey,
    Revision := Revision, RootReady := RootReady);
IF M_ApplyCapture THEN
    RETURN;
END_IF
FOR i := 1 TO _nChild DO
    IF _children[i] <> 0 THEN
        IF __QUERYINTERFACE(_children[i], iCfg) THEN
            IF iCfg.M_ApplyCapture(Scope := Scope, WriteKey := WriteKey,
                    Revision := Revision, RootReady := RootReady) THEN
                M_ApplyCapture := TRUE;
                RETURN;
            END_IF
        END_IF
    END_IF
END_FOR]]></ST>
        </Implementation>
      </Method>
</POU>
</TcPlcObject>
