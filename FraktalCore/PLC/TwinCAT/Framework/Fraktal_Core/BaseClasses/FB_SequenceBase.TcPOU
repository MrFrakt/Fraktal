<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_SequenceBase" Id="{6c2f91a4-3e87-4b5d-a1f0-58d24c7be093}" SpecialFunc="None">
    <Declaration><![CDATA[// Core §6.8 — THE provided step-chain base: an SFC/ST/LD sequence POU extends
// this and gets the step record, condition waits, run-style pacing, the child
// PLCopen drive, delays, and the shared transition result — without re-declaring
// host plumbing per chain. The derived chart's actions are the only writers of
// _retVal; every chart transition reads it; one shared exit action calls
// M_ClearTransition. Framework flow-control lives here ONCE (§6.8(a)); the
// application's command/wait/decision logic stays visible in each step action.
FUNCTION_BLOCK ABSTRACT FB_SequenceBase IMPLEMENTS I_Sequence
VAR_OUTPUT
    ActiveStep : INT;              // §6.5 mirror of the step record (chart-local view)
    Done : BOOL;                   // finite chains: TRUE at their finish step
END_VAR
VAR
    _step    : INT;                // §6.5 active step index (the ST `CASE _step OF` token)
    // Shared transition result (§6.10). ONE-SCAN signal: the active step's action
    // is its only writer, every chart transition reads it, and it is cleared before
    // the next scan's actions run - by M_Advance on commit in an ST chart, or by
    // M_BeginScan when the chart runtime owns the transition (SFC/LD/FBD).
    _retVal  : E_StepResult;
    _restart : BOOL;               // a step may request a chart restart (M_Run applies it)
    {attribute 'OPC.UA.DA' := '0'}
    _host : I_SequenceHost;        // owning module's framework services (§6.7)
    _attached : BOOL;
    _delay : TON;                  // M_Delay's timer (cleared with the transition)
    _driveIssued : BOOL;           // M_MayIssue's per-step issue latch (cleared on commit)
    _subRunning : BOOL;            // M_RunSub's per-step latch (cleared on commit)
    _baseStepNo : INT;             // §6.5 step-record offset when run as a sub-chain
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[;]]></ST>
    </Implementation>
    <Method Name="M_Advance" Id="{a71c4d38-52e9-4b06-9f81-3d0e6c25a704}">
      <Declaration><![CDATA[// §6.8 ST-skeleton progression: at the END of a `CASE _step OF` body, commit the
// step's shared transition result. On ADVANCE (or a declared JUMPn) go to the
// mapped next step and clear the step-scoped latches so the new step re-arms — the
// exact guarantee the SFC exit action gave, in one call. NONE stays put. The caller
// passes its successor map; an unmapped result holds the step (safe, visible).
METHOD M_Advance
VAR_INPUT
    OnAdvance : INT;               // next step for E_StepResult.ADVANCE
    // Jump targets default to "not used" so the common case reads
    // `M_Advance(OnAdvance := 100);` instead of repeating `OnJump1..3 := -1`.
    // Defaulted METHOD inputs need TwinCAT >= 3.1.4026, so on the legacy 4024
    // target (FRAKTAL_TC3_4024 defined) they are declared without defaults and
    // every argument is passed explicitly. See Params/PL_FraktalCompat.TcGVL.
    {IF defined (FRAKTAL_TC3_4024)}
    OnJump1   : INT;               // next step for JUMP1 (-1 = not used)
    OnJump2   : INT;               // next step for JUMP2 (-1 = not used)
    OnJump3   : INT;               // next step for JUMP3 (-1 = not used)
    {ELSE}
    OnJump1   : INT := -1;         // next step for JUMP1 (-1 = not used)
    OnJump2   : INT := -1;         // next step for JUMP2 (-1 = not used)
    OnJump3   : INT := -1;         // next step for JUMP3 (-1 = not used)
    {END_IF}
END_VAR
VAR
    target : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[target := -1;
CASE _retVal OF
    E_StepResult.ADVANCE: target := OnAdvance;
    E_StepResult.JUMP1:   target := OnJump1;
    E_StepResult.JUMP2:   target := OnJump2;
    E_StepResult.JUMP3:   target := OnJump3;
END_CASE
IF target >= 0 THEN
    _step := target;
    ActiveStep := target;
    M_ClearTransition();           // §6.10: a completed result never leaks into the next step
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_AskDecision" Id="{c60f93b2-1e78-4ad5-8b40-97d2e5c1a083}">
      <Declaration><![CDATA[// §6.11 forward
METHOD M_AskDecision
VAR_INPUT
    Req : ST_DecisionRequest;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _host <> 0 THEN
    _host.M_SequenceAskDecision(Req := Req);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Attach" Id="{83d17f5a-2b64-4c09-9ae8-01f6b2d47c35}">
      <Declaration><![CDATA[// bind the owner's host bridge; the derived Setup adds its typed child bindings.
METHOD M_Attach : BOOL
VAR_INPUT
    Host : I_SequenceHost;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_host := Host;
_attached := (Host <> 0);
IF _attached THEN
    // Announce this chain to its owner so the Unit base can run the
    // §6.10 per-scan result reset for it. The project writes nothing (O1).
    _host.M_SequenceRegister(Seq := THIS^);
END_IF
M_Attach := _attached;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Await" Id="{7d05e9c3-46a2-4f81-92b6-e3157cd80a49}">
      <Declaration><![CDATA[// §6.9(b) named plain-condition wait (forward to the host).
METHOD M_Await : BOOL
VAR_INPUT
    Idx : INT;
    Label : STRING(120);
    Ok : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_Await := FALSE;
IF _host <> 0 THEN
    M_Await := _host.M_SequenceAwait(Idx := Idx, Label := Label, Ok := Ok);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_BeginScan" Id="{4c0862c1-7015-4c44-8473-90c09e6eebff}">
      <Declaration><![CDATA[// Core §6.10 - scan-scoped reset of the shared transition result.
//
// `_retVal` is a ONE-SCAN signal: the active step's action writes it, the chart's
// transition reads it in the same scan, and it must not survive into the next.
// In an ST chart M_Advance is itself the transition, so it commits and clears in
// one call. In a chart language the RUNTIME evaluates transitions (SFC/LD/FBD),
// so nothing in the chart is positioned to clear afterwards - call this once per
// PLC cycle immediately BEFORE executing the chart. Clearing at the top of the
// scan is equivalent to clearing after the previous scan's transitions, and it
// forces every step action to re-assert its own result each scan, which is the
// property that makes a stale ADVANCE impossible.
//
// It deliberately clears ONLY the result. `_driveIssued` (M_MayIssue's one-shot)
// and `_delay` (M_Delay's timer) are STEP-scoped, not scan-scoped: resetting them
// every scan would re-issue a child command every cycle and stop any delay from
// ever elapsing. Those re-arm on step change, through M_ClearTransition.
METHOD M_BeginScan]]></Declaration>
      <Implementation>
        <ST><![CDATA[_retVal := E_StepResult.NONE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ClearDecision" Id="{4b06d8e1-72af-4c95-a3d8-e50c19b7f234}">
      <Declaration><![CDATA[METHOD M_ClearDecision]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _host <> 0 THEN
    _host.M_SequenceClearDecision();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ClearTransition" Id="{2e6b48d1-95cf-4a73-b30e-6f81da29c504}">
      <Declaration><![CDATA[// the ONE shared STEP-EXIT action: a completed step's result never leaks into
// the next step, and the step-scoped helpers (delay, drive latch) re-arm.
// ST charts reach this through M_Advance on commit. A chart language whose
// engine owns the transition (SFC/LD/FBD) wires this as the step exit action,
// which the runtime executes AFTER the transition condition was evaluated -
// so the transition still sees the result the step action produced.
METHOD M_ClearTransition]]></Declaration>
      <Implementation>
        <ST><![CDATA[_retVal := E_StepResult.NONE;
_driveIssued := FALSE;
_subRunning := FALSE;
_delay(IN := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Complete" Id="{68e5b09c-d3f1-4a27-85b6-04c7a2e91d58}">
      <Declaration><![CDATA[// §6.1 one-shot completion forward (finite chains)
METHOD M_Complete]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _host <> 0 THEN
    _host.M_SequenceComplete();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CountGood" Id="{31d84e0a-6cf2-49b7-90e5-2af7c81d53b6}">
      <Declaration><![CDATA[METHOD M_CountGood]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _host <> 0 THEN
    _host.M_SequenceCountGood();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Delay" Id="{e94b06d2-571c-4a88-9fe3-c07a35d21b60}">
      <Declaration><![CDATA[// a declared process wait in ONE step (settle/dwell). The timer runs while the
// step is active and re-arms through the shared exit action.
METHOD M_Delay : E_StepResult
VAR_INPUT
    PT : TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_Delay := E_StepResult.NONE;
_delay(IN := TRUE, PT := PT);
IF _delay.Q THEN
    _delay(IN := FALSE);
    M_Delay := E_StepResult.ADVANCE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_EndOfCycle" Id="{d95f31a8-40c6-4e7b-92d0-6b18e4c5f7a9}">
      <Declaration><![CDATA[// §8.11.1 cycle-complete marker forward; FALSE = stop granted (do not loop)
METHOD M_EndOfCycle : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_EndOfCycle := FALSE;
IF _host <> 0 THEN
    M_EndOfCycle := _host.M_SequenceEndOfCycle();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Fault" Id="{0b83f5e7-92c6-4d1a-8f40-56a91dce27b8}">
      <Declaration><![CDATA[// §6.9 first-out fault from a step (forward to the host).
METHOD M_Fault
VAR_INPUT
    Reason : E_Reason;
    DescriptionKey : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _host <> 0 THEN
    _host.M_SequenceFault(Reason := Reason, DescriptionKey := DescriptionKey);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Gate" Id="{49c8e2b7-1af3-4d50-a6e9-8b02f47c9d16}">
      <Declaration><![CDATA[// §3.4.2 run-style pacing gate (forward to the host).
METHOD M_Gate : BOOL
VAR_INPUT
    Steppable : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_Gate := FALSE;
IF _host <> 0 THEN
    M_Gate := _host.M_SequenceStepGate(Steppable := Steppable);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_MayIssue" Id="{d70a5c94-83e1-4f26-b5d8-42c69e01af37}">
      <Declaration><![CDATA[// §6.1 issue+await in ONE step: TRUE exactly once per step visit, when the
// run-style gate permits (§3.4.2). The action then sets the child's typed
// Command and raises Execute — visibly, in the step (§6.8). The child's Done
// releases the handshake and sets _retVal := ADVANCE; a child Error needs no
// step code — the owning Unit adopts it instantly via the §8.2 rollup.
// The latch re-arms through the shared exit action (M_ClearTransition).
METHOD M_MayIssue : BOOL
VAR_INPUT
    Steppable : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_MayIssue := FALSE;
IF _driveIssued THEN
    RETURN;
END_IF
IF M_Gate(Steppable := Steppable) THEN
    _driveIssued := TRUE;
    M_MayIssue := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PartProcessed" Id="{9f5a2c18-b7e4-4063-a58d-1e6c30d9f427}">
      <Declaration><![CDATA[METHOD M_PartProcessed : BOOL
VAR_INPUT
    Verdict : E_Verdict;
    Reason : E_Reason;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_PartProcessed := FALSE;
IF _host <> 0 THEN
    M_PartProcessed := _host.M_SequencePartProcessed(Verdict := Verdict, Reason := Reason);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PartReceived" Id="{7c3e0f91-2ab8-4d64-95c7-e8140b6a25d9}">
      <Declaration><![CDATA[// §3.16.3 forward (framework plumbing stays out of step actions).
METHOD M_PartReceived : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_PartReceived := FALSE;
IF _host <> 0 THEN
    M_PartReceived := _host.M_SequencePartReceived();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PartRecord" Id="{e21b7f60-93d5-4a8c-8f14-c5d09e3b7a42}">
      <Declaration><![CDATA[METHOD M_PartRecord : BOOL
VAR_INPUT
    RecordName : STRING(64);
    Value : LREAL;
    Minimum : LREAL;
    Maximum : LREAL;
    Target : LREAL;
    EngUnit : STRING(16);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_PartRecord := FALSE;
IF _host <> 0 THEN
    M_PartRecord := _host.M_SequencePartRecord(RecordName := RecordName,
        Value := Value, Minimum := Minimum, Maximum := Maximum, Target := Target,
        EngUnit := EngUnit);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PartStarted" Id="{5d19c4a7-8e02-4f5b-b6d3-70f28c1e94a6}">
      <Declaration><![CDATA[METHOD M_PartStarted]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _host <> 0 THEN
    _host.M_SequencePartStarted();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ResetBase" Id="{5a90c3e2-7f18-4d66-8b2a-9ce45d10f782}">
      <Declaration><![CDATA[// clear the base flow state to the first step. The derived M_Reset calls this.
METHOD M_ResetBase
VAR_INPUT
    // Defaults to 0 (N000), the conventional first step, so a derived M_Reset
    // reads `M_ResetBase();`. Legacy 4024 has no defaulted method inputs, so
    // there the argument is required — see Params/PL_FraktalCompat.TcGVL.
    {IF defined (FRAKTAL_TC3_4024)}
    FirstStep : INT;               // the chain's initial step number (N000 = 0)
    {ELSE}
    FirstStep : INT := 0;          // the chain's initial step number (N000 = 0)
    {END_IF}
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_step := FirstStep;
ActiveStep := FirstStep;
Done := FALSE;
_restart := FALSE;
M_ClearTransition();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ChainRun" Id="{b2dd28b6-7db9-48a6-8f4e-a437e83baa79}">
      <Declaration><![CDATA[// One scan of this chain. An ST chart overrides this with its
// `CASE _step OF` body; a chart-language POU leaves it alone because its own body
// IS the chart and the runtime executes it. Only a chain that is used as a
// composite step (M_RunSub) has to override it.
METHOD M_ChainRun]]></Declaration>
      <Implementation>
        <ST><![CDATA[;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ChainReset" Id="{a41025db-fb80-43ee-99ef-bace7f63f844}">
      <Declaration><![CDATA[// Restart this chain as a sub-chain of a composite step: its step records are
// offset by the owning step number (§6.5) so the stall walk still reports one
// continuous chain. OnChainReset carries any application state.
METHOD M_ChainReset
VAR_INPUT
    BaseStepNo : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_baseStepNo := BaseStepNo;
M_ResetBase(FirstStep := 0);
OnChainReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnChainReset" Id="{6e368c40-f3a8-46a7-866a-7e436102e0a9}">
      <Declaration><![CDATA[// §3.14 hook: clear application-owned chain state on restart. Empty by default
// so a chain that has none writes nothing.
METHOD PROTECTED OnChainReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RunSub" Id="{c441a4bf-6a3a-473d-aecf-8dcf381358dc}">
      <Declaration><![CDATA[// §6.8 run another chain as ONE composite step. Returns NONE while the
// sub-chain works and ADVANCE on the scan it finishes, so a step action reads:
//
//     _retVal := M_RunSub(Sub := _loadPosition, BaseStepNo := 240);
//
// The entry latch is step-scoped and re-arms through M_ClearTransition, so a
// chain re-entered later restarts correctly. Hand-written, this was eight lines
// per composite step and one forgotten latch reset left a chain that never ran
// again (§1.1 O1: the framework owns repeated flow control, not the project).
METHOD M_RunSub : E_StepResult
VAR_INPUT
    Sub : REFERENCE TO FB_SequenceBase;
    BaseStepNo : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_RunSub := E_StepResult.NONE;
IF NOT __ISVALIDREF(Sub) THEN
    RETURN;
END_IF
IF NOT _subRunning THEN
    Sub.M_ChainReset(BaseStepNo := BaseStepNo);
    _subRunning := TRUE;
END_IF
Sub.M_ChainRun();
IF Sub.Done THEN
    _subRunning := FALSE;
    M_RunSub := E_StepResult.ADVANCE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Step" Id="{b1f42a68-0d95-4e37-8cb1-27d3a9e60f14}">
      <Declaration><![CDATA[// §6.5 step record + the chart-local ActiveStep mirror, one call.
METHOD M_Step
VAR_INPUT
    StepNo : INT;
    StepName : STRING(120);
    Awaits : I_Module;
    AwaitingLabel : STRING(120);
    TimeClass : E_TimeClass;
    ExpectedTime : TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ActiveStep := StepNo;
IF _host <> 0 THEN
    _host.M_SequenceSetStep(StepNo := StepNo, StepName := StepName, Awaits := Awaits,
        AwaitingLabel := AwaitingLabel, TimeClass := TimeClass, ExpectedTime := ExpectedTime);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StopNow" Id="{1a97d3c8-45e2-4bf1-8d06-b52c8fe0a374}">
      <Declaration><![CDATA[// §3.4/§8.11 — accept the stop between cycles (forward to the host).
METHOD M_StopNow]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _host <> 0 THEN
    _host.M_SequenceStopNow();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StopPending" Id="{f6c14e29-8b70-4da3-95c2-30e8a1d7f465}">
      <Declaration><![CDATA[// §3.4 — poll at the between-cycles wait step (forward to the host).
METHOD M_StopPending : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_StopPending := FALSE;
IF _host <> 0 THEN
    M_StopPending := _host.M_SequenceStopPending();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_TakeDecision" Id="{a84c17f5-05d9-4e32-b6a1-38f0c92d67e4}">
      <Declaration><![CDATA[METHOD M_TakeDecision : INT]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_TakeDecision := 0;
IF _host <> 0 THEN
    M_TakeDecision := _host.M_SequenceTakeDecision();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>