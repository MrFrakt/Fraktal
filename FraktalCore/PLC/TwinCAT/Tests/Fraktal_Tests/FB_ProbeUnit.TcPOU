<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_ProbeUnit" Id="{a1676a86-f95f-460f-93ca-ed94ca5c7c5d}" SpecialFunc="None">
    <Declaration><![CDATA[// minimal Unit for the base suite: 2-step looping chain, one wait-classed step
FUNCTION_BLOCK FB_ProbeUnit EXTENDS FB_UnitBase
VAR_INPUT
    SimA, SimB : BOOL;
    SimFault : BOOL;                    // deterministic fault injection for base-path tests
END_VAR
VAR_OUTPUT
    ModeChangedCount : UDINT;
    ModeExitCount : UDINT;
    ModeExitFirstCount : UDINT;
    LastNewMode : E_Mode;
    LastOldMode : E_Mode;
    LastRequestedMode : E_Mode;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Cyclic();]]></ST>
    </Implementation>
    <Method Name="Setup" Id="{5b7a8b1b-03fd-4d4e-b0d2-5821d68d823c}">
      <Declaration><![CDATA[METHOD Setup : BOOL
VAR_INPUT
    Name : STRING(80);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_SetName(Name);
StallTime := T#0S;                       // test: stall pending fires immediately
Setup := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_Dispatch" Id="{2d5f574b-01d6-4291-a6ce-b24e805a7176}">
      <Declaration><![CDATA[METHOD PROTECTED _M_Dispatch]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE _step OF
    10:
        _M_SetStep(StepNo := 100, StepName := 'project.test.stepA', Awaits := 0,
            AwaitingLabel := '', TimeClass := E_TimeClass.WORK, ExpectedTime := T#0S);
        IF SimFault THEN
            _M_Fault(E_Reason.TEST_FAULT, 'forced Unit fault');
        ELSIF SimA THEN
            _step := 20;
        END_IF
    20:
        _M_SetStep(StepNo := 200, StepName := 'project.test.stepB', Awaits := 0,
            AwaitingLabel := '', TimeClass := E_TimeClass.WAIT_UPSTREAM, ExpectedTime := T#0S);
        IF SimB THEN
            _step := 30;
        END_IF
    30:
        IF _M_EndOfCycle() THEN
            _step := 10;
        END_IF
ELSE
    _M_Fault(E_Reason.STEP_STALLED, 'undefined step');
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_TestAskDecision" Id="{bd411061-9e75-4b2c-9300-92de13c0bb48}">
      <Declaration><![CDATA[// Test-probe seam for the protected §6.11 host service.
METHOD M_TestAskDecision : BOOL
VAR_INPUT
    Req : ST_DecisionRequest;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[_M_AskDecision(Req := Req);
M_TestAskDecision := Decision.Prompt = Req.Prompt;]]></ST></Implementation>
    </Method>
    <Method Name="M_TestClearDecision" Id="{c49007cc-d2ea-4b4a-9a11-48934620cc12}">
      <Declaration><![CDATA[METHOD M_TestClearDecision]]></Declaration>
      <Implementation><ST><![CDATA[M_SequenceClearDecision();]]></ST></Implementation>
    </Method>
    <Method Name="M_TestTakeDecision" Id="{1e5bd922-f4aa-41e6-b244-e37053253238}">
      <Declaration><![CDATA[METHOD M_TestTakeDecision : INT]]></Declaration>
      <Implementation><ST><![CDATA[M_TestTakeDecision := _M_TakeDecision();]]></ST></Implementation>
    </Method>
    <Method Name="OnModeChanged" Id="{c8d47169-ae9c-42b2-a7bc-8b4fbc0bab15}">
      <Declaration><![CDATA[METHOD PROTECTED OnModeChanged : DINT
VAR_INPUT
    NewMode : E_Mode;
    OldMode : E_Mode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[OnModeChanged := SUPER^.OnModeChanged(
    NewMode := NewMode, OldMode := OldMode);
ModeChangedCount := ModeChangedCount + 1;
LastNewMode := NewMode;
LastOldMode := OldMode;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnModeExit" Id="{1c73f57f-9a1f-43d6-a9a0-2fe455382bca}">
      <Declaration><![CDATA[METHOD PROTECTED OnModeExit : DINT
VAR_INPUT
    FirstCall : BOOL;
    RequestedMode : E_Mode;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// This probe wants the default immediate cancel, so the base call is intentional.
OnModeExit := SUPER^.OnModeExit(
    FirstCall := FirstCall, RequestedMode := RequestedMode);
ModeExitCount := ModeExitCount + 1;
IF FirstCall THEN
    ModeExitFirstCount := ModeExitFirstCount + 1;
END_IF
LastRequestedMode := RequestedMode;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
