<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_RobotCM_Tests" Id="{2c15ac6b-269e-479d-b99f-213276ccca4e}" SpecialFunc="None">
    <Declaration><![CDATA[// Annex I I.14 - the robot CM proven against the SIMULATED connector (I.5c).
// No arm, no emulator, no socket: FB_SimRobotConnector honours the handshake and
// injects the I.2 reasons on demand, which is the only way to prove refusals that
// would otherwise require deliberately breaking a cell.
//
// What is under test here is the CM's own contract - the S5.6 validation ladder,
// the S6.1 HELD translation, and the S8.2 rule that a connector's reason is
// ADOPTED rather than re-classified. The connector's wire behaviour is proven
// separately in FB_RobotConnector_Tests.
//
// Every test is a small scan-stepped sequencer: the sim's motion and the base's
// heartbeat are both TON-driven, so a loop of Cyclic() calls inside one scan
// advances no time at all. That mistake cost this suite two red tests once
// already; it is not repeated here.
FUNCTION_BLOCK FB_RobotCM_Tests EXTENDS TcUnit.FB_TestSuite
VAR
    _cmA : FB_RobotCM;  _rbA : FB_SimRobotConnector;  _sA : INT;  _nA : INT;
    _cmB : FB_RobotCM;  _rbB : FB_SimRobotConnector;  _sB : INT;  _nB : INT;
    _cmC : FB_RobotCM;  _rbC : FB_SimRobotConnector;  _sC : INT;  _nC : INT;
    _cmD : FB_RobotCM;  _rbD : FB_SimRobotConnector;  _sD : INT;  _nD : INT;
    _cmE : FB_RobotCM;  _rbE : FB_SimRobotConnector;  _sE : INT;  _nE : INT;
    _cmF : FB_RobotCM;  _rbF : FB_SimRobotConnector;  _sF : INT;  _nF : INT;
    _cmG : FB_RobotCM;  _rbG : FB_SimRobotConnector;  _sG : INT;  _nG : INT;
    _cmH : FB_RobotCM;  _rbH : FB_SimRobotConnector;  _sH : INT;  _nH : INT;
    _cmI : FB_RobotCM;  _rbI : FB_SimRobotConnector;  _sI : INT;  _nI : INT;
    _cmJ : FB_RobotCM;  _rbJ : FB_SimRobotConnector;  _sJ : INT;  _nJ : INT;
    _cmK : FB_RobotCM;  _rbK : FB_SimRobotConnector;  _sK : INT;  _nK : INT;
    _cmL : FB_RobotCM;  _rbL : FB_SimRobotConnector;  _sL : INT;  _nL : INT;
    _cmM : FB_RobotCM;  _rbM : FB_SimRobotConnector;  _sM : INT;  _nM : INT;
    _cmN : FB_RobotCM;  _rbN : FB_SimRobotConnector;  _sN : INT;  _nN : INT;
    _cmO : FB_RobotCM;  _rbO : FB_SimRobotConnector;  _sO : INT;  _nO : INT;
    _cmP : FB_RobotCM;  _rbP : FB_SimRobotConnector;  _sP : INT;  _nP : INT;
    _cmQ : FB_RobotCM;  _rbQ : FB_SimRobotConnector;  _sQ : INT;  _nQ : INT;
    _cmR : FB_RobotCM;  _rbR : FB_SimRobotConnector;  _sR : INT;  _nR : INT;
    _cmS : FB_RobotCM;  _rbS : FB_SimRobotConnector;  _sS : INT;  _nS : INT;
    _cmT : FB_RobotCM;  _rbT : FB_SimRobotConnector;  _sT : INT;  _nT : INT;
    _diag : ST_Diagnostic;   // C0185: cannot access .member on a property result
    _model : ST_ModelId;
    _enP : ST_ManualEnableStatus;
    _poseP0, _poseP : ST_RobotPose;
    _seenJ, _declR : BOOL;
    _kT : INT;
    _cmU : FB_RobotCM;  _rbU : FB_SimRobotConnector;  _sU : INT;  _nU : INT;  _idxU : DINT;
    _cmV : FB_RobotCM;  _rbV : FB_SimRobotConnector;  _sV : INT;  _nV : INT;  _enV : ST_ManualEnableStatus;
    _cmW : FB_RobotCM;  _rbW : FB_SimRobotConnector;  _sW : INT;  _nW : INT;
    _cmX : FB_RobotCM;  _rbX : FB_SimRobotConnector;  _sX : INT;  _nX : INT;
    _cmY : FB_RobotCM;  _rbY : FB_SimRobotConnector;  _sY : INT;  _nY : INT;
    _cmZ : FB_RobotCM;  _rbZ : FB_SimRobotConnector;  _sZ : INT;  _nZ : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Command_on_a_down_link_faults_with_the_link_reason();
Motion_before_homing_is_refused();
Home_is_exempt_from_the_reference_check();
Speed_scale_outside_its_band_is_refused_before_motion();
Mode_that_does_not_permit_motion_is_refused();
Lost_permissive_holds_on_path_rather_than_faulting();
Completion_publishes_the_reached_position();
Protective_stop_aborts_with_its_own_reason();
Default_mode_is_requested_at_link_up_and_published();
Request_mode_completes_only_when_the_controller_reports_it();
Configuration_the_type_cannot_honour_is_refused();
Set_payload_reaches_the_controller();
Safety_alias_lost_mid_move_stops_powers_off_and_stays_off();
Power_on_is_refused_without_the_safety_alias();
Aborting_a_command_stops_the_arm();
Jog_needs_a_manual_mode_the_enabling_device_and_a_fresh_request();
Jog_selection_is_validated_and_published();
User_signals_are_declared_published_and_written();
Arm_power_and_the_applied_speed_are_published();
A_repeated_refusal_keeps_its_own_reason_and_a_success_follows();
An_aborted_path_reports_its_progress_for_a_deliberate_continue();
Capabilities_are_published_and_a_command_not_offered_is_refused_before_issuing();
A_move_to_a_missing_or_untaught_point_is_refused_and_nothing_moves();
A_due_brake_test_is_published_and_withdrawn_by_running_it();
A_routine_that_leaves_its_demand_standing_faults();
A_declared_manual_move_runs_to_its_point_at_the_slowest_speed();]]></ST>
    </Implementation>
      <Method Name="Command_on_a_down_link_faults_with_the_link_reason" Id="{744a01e7-6ead-4f66-b518-a75649c37cc2}">
        <Declaration><![CDATA[METHOD PRIVATE Command_on_a_down_link_faults_with_the_link_reason]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Command_on_a_down_link_faults_with_the_link_reason');
// Deliberately never Connect()ed: the connector stays down. A command must FAULT
// with the link reason rather than wait - a sequence blocked on a robot that
// never heard the command is the failure this rule exists to prevent (Annex D).
CASE _sA OF
    0:
        _cmA.Setup(Name := 'Test.RobotA', Robot := _rbA);
        _cmA.ParCfg.SpeedScaleMin := 1.0;
        _cmA.ParCfg.SpeedScaleMax := 100.0;
        _cmA.ParCmd.SpeedScale    := 50.0;
        _cmA.ParCmd.TargetId      := 5;
        _cmA.Command              := E_RobotCommand.MOVE_TO;
        _sA := 1;
    1:
        _cmA.Execute := TRUE;
        _cmA();
        _sA := 2;
    2:
        _cmA();
        IF _cmA.Error THEN
            _diag := _cmA.Status.Diagnostic;
            AssertEquals_DINT(Expected := E_Reason.LINK_TIMEOUT, Actual := _diag.ReasonCode,
                Message := 'a command on a down link faults with the link reason');
            AssertFalse(Condition := _cmA.Busy,
                Message := 'and does not sit BUSY waiting for a robot that never heard it');
            TEST_FINISHED();
        ELSE
            _nA := _nA + 1;
IF _nA > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'a command on a down link never faulted');
    TEST_FINISHED();
END_IF
        END_IF
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Motion_before_homing_is_refused" Id="{88ad230c-71d9-4fc5-9a74-b5c0ebadd9ee}">
        <Declaration><![CDATA[METHOD PRIVATE Motion_before_homing_is_refused]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Motion_before_homing_is_refused');
// The heartbeat is TON-driven, so the link comes up over scans, not at once.
_rbB.Connect();
_rbB.Cyclic();

CASE _sB OF
    0:
        _cmB.Setup(Name := 'Test.RobotB', Robot := _rbB);
        _cmB.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmB.ParCfg.SpeedScaleMin := 1.0;
        _cmB.ParCfg.SpeedScaleMax := 100.0;
        _cmB.ParCfg.MoveTimeout   := T#2S;
        _cmB.ParCfg.HomeTimeout   := T#2S;
        _cmB.ParCfg.SpeedCeiling[E_RobotOpMode.AUTO_REMOTE] := 100.0;
        _cmB.ParCmd.SpeedScale    := 50.0;
        _cmB.ParCmd.TargetId      := 5;
        _cmB();
        IF _rbB.Linked THEN
            _rbB.PowerOn();          // powered but NEVER homed
            _sB := 1;
        END_IF
        _nB := _nB + 1;
IF _nB > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
    TEST_FINISHED();
END_IF
    1:
        _cmB.Command := E_RobotCommand.MOVE_TO;
        _cmB.Execute := TRUE;
        _cmB();
        _sB := 2;
    2:
        _cmB();
        IF _cmB.Error THEN
            // The specific cause, not the first check that happened to fail: an
            // unreferenced robot needs homing, and the operator is told exactly that.
            _diag := _cmB.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_NOT_REFERENCED,
                Actual := _diag.ReasonCode,
                Message := 'motion before homing is refused as unreferenced');
            AssertFalse(Condition := _rbB.MotionBusy,
                Message := 'and nothing was sent - the refusal is BEFORE motion (S5.6)');
            TEST_FINISHED();
        ELSE
            _nB := _nB + 1;
IF _nB > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'motion before homing was not refused');
    TEST_FINISHED();
END_IF
        END_IF
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Home_is_exempt_from_the_reference_check" Id="{098d521e-46f3-4d90-a565-cb421ba6ee0e}">
        <Declaration><![CDATA[METHOD PRIVATE Home_is_exempt_from_the_reference_check]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Home_is_exempt_from_the_reference_check');
// The heartbeat is TON-driven, so the link comes up over scans, not at once.
_rbC.Connect();
_rbC.Cyclic();

// The ladder that refuses motion before homing must NOT refuse homing itself:
// homing is what ESTABLISHES the reference, so gating it on one would leave the
// robot permanently unhomeable - a deadlock the validation exists to prevent,
// not to create. This is the test that would have caught it.
CASE _sC OF
    0:
        _cmC.Setup(Name := 'Test.RobotC', Robot := _rbC);
        _cmC.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmC.ParCfg.SpeedScaleMin := 1.0;
        _cmC.ParCfg.SpeedScaleMax := 100.0;
        _cmC.ParCfg.MoveTimeout   := T#2S;
        _cmC.ParCfg.HomeTimeout   := T#2S;
        _cmC.ParCfg.SpeedCeiling[E_RobotOpMode.AUTO_REMOTE] := 100.0;
        _cmC.ParCmd.SpeedScale    := 50.0;
        _cmC();
        IF _rbC.Linked THEN
            _rbC.PowerOn();
            AssertFalse(Condition := _rbC.Referenced,
                Message := 'precondition: the robot starts unreferenced');
            _sC := 1;
        END_IF
        _nC := _nC + 1;
IF _nC > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
    TEST_FINISHED();
END_IF
    1:
        _cmC.Command := E_RobotCommand.HOME;
        _cmC.Execute := TRUE;
        _cmC();
        _sC := 2;
    2:
        _cmC();
        IF _cmC.Done THEN
            AssertTrue(Condition := _rbC.Referenced,
                Message := 'homing completes and establishes the reference');
            TEST_FINISHED();
        ELSIF _cmC.Error THEN
            _diag := _cmC.Status.Diagnostic;
            AssertEquals_DINT(Expected := 0, Actual := _diag.ReasonCode,
                Message := 'HOME must not be refused for being unreferenced');
            TEST_FINISHED();
        ELSE
            _nC := _nC + 1;
IF _nC > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'HOME neither completed nor faulted');
    TEST_FINISHED();
END_IF
        END_IF
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Speed_scale_outside_its_band_is_refused_before_motion" Id="{392183a6-b629-4318-a324-fa96f5ce255f}">
        <Declaration><![CDATA[METHOD PRIVATE Speed_scale_outside_its_band_is_refused_before_motion]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Speed_scale_outside_its_band_is_refused_before_motion');
// The heartbeat is TON-driven, so the link comes up over scans, not at once.
_rbD.Connect();
_rbD.Cyclic();

CASE _sD OF
    0:
        _cmD.Setup(Name := 'Test.RobotD', Robot := _rbD);
        _cmD.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmD.ParCfg.SpeedScaleMin := 10.0;
        _cmD.ParCfg.SpeedScaleMax := 80.0;
        _cmD.ParCfg.MoveTimeout   := T#2S;
        _cmD.ParCfg.HomeTimeout   := T#2S;
        _cmD.ParCfg.SpeedCeiling[E_RobotOpMode.AUTO_REMOTE] := 100.0;
        _cmD.ParCmd.SpeedScale    := 95.0;    // outside the configured band
        _cmD.ParCmd.TargetId      := 3;
        _cmD();
        IF _rbD.Linked THEN
            _rbD.PowerOn();
            _rbD.Home();
            _sD := 1;
        END_IF
        _nD := _nD + 1;
IF _nD > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
    TEST_FINISHED();
END_IF
    1:
        _cmD();
        IF _rbD.Referenced THEN
            _sD := 2;
        END_IF
        _nD := _nD + 1;
IF _nD > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
    TEST_FINISHED();
END_IF
    2:
        _cmD.Command := E_RobotCommand.MOVE_TO;
        _cmD.Execute := TRUE;
        _cmD();
        _sD := 3;
    3:
        _cmD();
        IF _cmD.Error THEN
            // A malformed parameter is wrong regardless of mode or reference, so it
            // is checked FIRST and reported as itself.
            _diag := _cmD.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_PARAM_OOR,
                Actual := _diag.ReasonCode,
                Message := 'a speed scale outside the band is refused as out of range');
            AssertFalse(Condition := _rbD.MotionBusy,
                Message := 'and the robot never started moving');
            TEST_FINISHED();
        ELSE
            _nD := _nD + 1;
IF _nD > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'an out-of-band speed scale was not refused');
    TEST_FINISHED();
END_IF
        END_IF
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Mode_that_does_not_permit_motion_is_refused" Id="{fa30a01f-0310-4ce1-ab1f-bb709b4bc252}">
        <Declaration><![CDATA[METHOD PRIVATE Mode_that_does_not_permit_motion_is_refused]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Mode_that_does_not_permit_motion_is_refused');
// The heartbeat is TON-driven, so the link comes up over scans, not at once.
_rbE.Connect();
_rbE.Cyclic();

CASE _sE OF
    0:
        _cmE.Setup(Name := 'Test.RobotE', Robot := _rbE);
        _cmE.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmE.ParCfg.SpeedScaleMin := 1.0;
        _cmE.ParCfg.SpeedScaleMax := 100.0;
        _cmE.ParCfg.MoveTimeout   := T#2S;
        _cmE.ParCfg.HomeTimeout   := T#2S;
        _cmE.ParCfg.SpeedCeiling[E_RobotOpMode.AUTO_REMOTE]    := 100.0;
        _cmE.ParCfg.SpeedCeiling[E_RobotOpMode.MANUAL_REDUCED] := 25.0;
        _cmE.ParCmd.SpeedScale    := 50.0;
        _cmE.ParCmd.TargetId      := 3;
        _cmE();
        IF _rbE.Linked THEN
            _rbE.PowerOn();
            _rbE.Home();
            _sE := 1;
        END_IF
        _nE := _nE + 1;
IF _nE > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
    TEST_FINISHED();
END_IF
    1:
        _cmE();
        IF _rbE.Referenced THEN
            // The controller is put in a manual mode. Automatic motion commanded
            // from the PLC must not run in it, whatever the PLC would like.
            _rbE.RequestMode(Mode := E_RobotOpMode.MANUAL_REDUCED);
            _sE := 2;
        END_IF
        _nE := _nE + 1;
IF _nE > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
    TEST_FINISHED();
END_IF
    2:
        _cmE.Command := E_RobotCommand.MOVE_TO;
        _cmE.Execute := TRUE;
        _cmE();
        _sE := 3;
    3:
        _cmE();
        IF _cmE.Error THEN
            _diag := _cmE.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_MODE_NOT_PERMITTED,
                Actual := _diag.ReasonCode,
                Message := 'the controllers REPORTED mode bounds what may run');
            AssertFalse(Condition := _rbE.MotionBusy,
                Message := 'and nothing was sent to the robot');
            TEST_FINISHED();
        ELSE
            _nE := _nE + 1;
IF _nE > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'a non-permitting mode did not refuse the move');
    TEST_FINISHED();
END_IF
        END_IF
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Lost_permissive_holds_on_path_rather_than_faulting" Id="{c3955779-a1b8-49ef-8737-dd983ceedd17}">
        <Declaration><![CDATA[METHOD PRIVATE Lost_permissive_holds_on_path_rather_than_faulting]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Lost_permissive_holds_on_path_rather_than_faulting');
// The heartbeat is TON-driven, so the link comes up over scans, not at once.
_rbF.Connect();
_rbF.Cyclic();

// S6.1, I.4b: losing a declared condition mid-move is EXPECTED - an operator
// releasing an enable is the designed way to stop a robot. It must HOLD, not
// fault: a fault would demand an acknowledgement for a normal act, and the
// alarm record would fill with events that were never faults.
CASE _sF OF
    0:
        _cmF.Setup(Name := 'Test.RobotF', Robot := _rbF);
        _cmF.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmF.DeclareCondition(Index := 1, DescriptionKey := 'std.interlock.areaSafe',
            Reason := E_Reason.INTERLOCK_DROPPED, Bypassable := FALSE);
        _cmF.SetCondition(Index := 1, Ok := TRUE);
        _cmF.ParCfg.SpeedScaleMin := 1.0;
        _cmF.ParCfg.SpeedScaleMax := 100.0;
        _cmF.ParCfg.MoveTimeout   := T#5S;
        _cmF.ParCfg.HomeTimeout   := T#5S;
        _cmF.ParCfg.SpeedCeiling[E_RobotOpMode.AUTO_REMOTE] := 100.0;
        _cmF.ParCmd.SpeedScale    := 50.0;
        _cmF.ParCmd.TargetId      := 4;
        _rbF.MoveTime := T#2S;                // long enough to interrupt mid-move
        _cmF();
        IF _rbF.Linked THEN
            _rbF.PowerOn();
            _rbF.Home();
            _sF := 1;
        END_IF
        _nF := _nF + 1;
IF _nF > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
    TEST_FINISHED();
END_IF
    1:
        _cmF.SetCondition(Index := 1, Ok := TRUE);
        _cmF();
        IF _rbF.Referenced THEN
            _sF := 2;
        END_IF
        _nF := _nF + 1;
IF _nF > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
    TEST_FINISHED();
END_IF
    2:
        _cmF.SetCondition(Index := 1, Ok := TRUE);
        _cmF.Command := E_RobotCommand.MOVE_TO;
        _cmF.Execute := TRUE;
        _cmF();
        _sF := 3;
    3:
        _cmF.SetCondition(Index := 1, Ok := TRUE);
        _cmF();
        IF _rbF.MotionBusy THEN
            _sF := 4;                          // the arm is genuinely on its way
        END_IF
        _nF := _nF + 1;
IF _nF > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the move never started');
    TEST_FINISHED();
END_IF
    4:
        _cmF.SetCondition(Index := 1, Ok := FALSE);   // the permissive drops
        _cmF();
        IF _cmF.Held THEN
            AssertFalse(Condition := _cmF.Error,
                Message := 'a lost permissive HOLDS - it is not a fault (S6.1)');
            AssertTrue(Condition := _cmF.Busy,
                Message := 'and the command is still BUSY, not terminated');
            _sF := 5;
        ELSE
            _nF := _nF + 1;
IF _nF > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the lost permissive did not raise HELD');
    TEST_FINISHED();
END_IF
        END_IF
    5:
        // Level-based: the hold clears by itself the scan the condition returns,
        // with no per-type "clear the hold" code to forget.
        _cmF.SetCondition(Index := 1, Ok := TRUE);
        _cmF();
        IF NOT _cmF.Held THEN
            AssertFalse(Condition := _cmF.Error,
                Message := 'the restored permissive resumes rather than faulting');
            TEST_FINISHED();
        ELSE
            _nF := _nF + 1;
IF _nF > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the hold never cleared after the condition returned');
    TEST_FINISHED();
END_IF
        END_IF
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Completion_publishes_the_reached_position" Id="{cf5db934-0470-4196-b185-9c00f695e095}">
        <Declaration><![CDATA[METHOD PRIVATE Completion_publishes_the_reached_position]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Completion_publishes_the_reached_position');
// The heartbeat is TON-driven, so the link comes up over scans, not at once.
_rbG.Connect();
_rbG.Cyclic();

CASE _sG OF
    0:
        _cmG.Setup(Name := 'Test.RobotG', Robot := _rbG);
        _cmG.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmG.ParCfg.SpeedScaleMin := 1.0;
        _cmG.ParCfg.SpeedScaleMax := 100.0;
        _cmG.ParCfg.MoveTimeout   := T#5S;
        _cmG.ParCfg.HomeTimeout   := T#5S;
        _cmG.ParCfg.SpeedCeiling[E_RobotOpMode.AUTO_REMOTE] := 100.0;
        _cmG.ParCmd.SpeedScale    := 50.0;
        _cmG.ParCmd.TargetId      := 7;
        _cmG();
        IF _rbG.Linked THEN
            _rbG.PowerOn();
            _rbG.Home();
            _sG := 1;
        END_IF
        _nG := _nG + 1;
IF _nG > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
    TEST_FINISHED();
END_IF
    1:
        _cmG();
        IF _rbG.Referenced THEN
            _sG := 2;
        END_IF
        _nG := _nG + 1;
IF _nG > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
    TEST_FINISHED();
END_IF
    2:
        _cmG.Command := E_RobotCommand.MOVE_TO;
        _cmG.Execute := TRUE;
        _cmG();
        _sG := 3;
    3:
        _cmG();
        IF _cmG.Done THEN
            // OutCmd is what the COMMAND produced and stays latched until the next
            // one - distinct from OutImm, which is recomputed every scan (S3.12).
            AssertEquals_DWORD(Expected := 7, Actual := _cmG.OutCmd.ReachedId,
                Message := 'completion publishes the position actually reached');
            AssertTrue(Condition := _cmG.OutImm.Linked,
                Message := 'and the live facts mirror the connector');
            AssertFalse(Condition := _cmG.OutImm.MotionBusy,
                Message := 'with motion finished');
            TEST_FINISHED();
        ELSIF _cmG.Error THEN
            _diag := _cmG.Status.Diagnostic;
            AssertEquals_DINT(Expected := 0, Actual := _diag.ReasonCode,
                Message := 'the move should have completed, not faulted');
            TEST_FINISHED();
        ELSE
            _nG := _nG + 1;
IF _nG > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the move neither completed nor faulted');
    TEST_FINISHED();
END_IF
        END_IF
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Protective_stop_aborts_with_its_own_reason" Id="{384fd5d9-95a8-42df-8d0f-2f3295ffacd8}">
        <Declaration><![CDATA[METHOD PRIVATE Protective_stop_aborts_with_its_own_reason]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Protective_stop_aborts_with_its_own_reason');
// The heartbeat is TON-driven, so the link comes up over scans, not at once.
_rbH.Connect();
_rbH.Cyclic();

// I.4a(c): the robot's crash device is NOT a S9 safety function, and must never
// be recorded as one. A process event filed as a safety event corrupts exactly
// the record a safety review reads.
CASE _sH OF
    0:
        _cmH.Setup(Name := 'Test.RobotH', Robot := _rbH);
        _cmH.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmH.ParCfg.SpeedScaleMin := 1.0;
        _cmH.ParCfg.SpeedScaleMax := 100.0;
        _cmH.ParCfg.MoveTimeout   := T#5S;
        _cmH.ParCfg.HomeTimeout   := T#5S;
        _cmH.ParCfg.SpeedCeiling[E_RobotOpMode.AUTO_REMOTE] := 100.0;
        _cmH.ParCmd.SpeedScale    := 50.0;
        _cmH.ParCmd.TargetId      := 6;
        _rbH.MoveTime := T#2S;
        _cmH();
        IF _rbH.Linked THEN
            _rbH.PowerOn();
            _rbH.Home();
            _sH := 1;
        END_IF
        _nH := _nH + 1;
IF _nH > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
    TEST_FINISHED();
END_IF
    1:
        _cmH();
        IF _rbH.Referenced THEN
            _sH := 2;
        END_IF
        _nH := _nH + 1;
IF _nH > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
    TEST_FINISHED();
END_IF
    2:
        _cmH.Command := E_RobotCommand.MOVE_TO;
        _cmH.Execute := TRUE;
        _cmH();
        _sH := 3;
    3:
        _cmH();
        IF _rbH.MotionBusy THEN
            _rbH.Inject := E_RobotSimFault.PROTECTIVE_STOP;   // the crash device trips
            _sH := 4;
        END_IF
        _nH := _nH + 1;
IF _nH > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the move never started');
    TEST_FINISHED();
END_IF
    4:
        _cmH();
        IF _cmH.Error THEN
            _diag := _cmH.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_PROTECTIVE_STOP,
                Actual := _diag.ReasonCode,
                Message := 'a protective stop faults with its OWN reason, not a safety one');
            AssertTrue(Condition := _cmH.OutImm.ProtectiveStop,
                Message := 'and the condition is published while it stands');
            TEST_FINISHED();
        ELSE
            _nH := _nH + 1;
IF _nH > 2000 THEN
    AssertTrue(Condition := FALSE, Message := 'the protective stop did not fault the command');
    TEST_FINISHED();
END_IF
        END_IF
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Default_mode_is_requested_at_link_up_and_published" Id="{2dd4b74a-8089-46f9-bce8-498432c87d0d}">
        <Declaration><![CDATA[METHOD PRIVATE Default_mode_is_requested_at_link_up_and_published]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Default_mode_is_requested_at_link_up_and_published');
IF _sI = 99 THEN
    RETURN;
END_IF
_rbI.Connect();
_rbI.Cyclic();
CASE _sI OF
    0:
        _cmI.Setup(Name := 'Test.RobotI', Robot := _rbI);
        _cmI.ParCfg.MoveTimeout := T#3S;
        _cmI.ParCfg.HomeTimeout := T#3S;
        _cmI();
        IF _rbI.Linked THEN
            _sI := 1;
        END_IF
        _nI := _nI + 1;
        IF _nI > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sI := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmI();
        AssertTrue(Condition := _cmI.OutImm.RequestedMode = E_RobotOpMode.MANUAL_REDUCED,
            Message := 'the most restrictive mode is requested the moment the link is up');
        AssertTrue(Condition := _cmI.OutImm.ActualMode = E_RobotOpMode.MANUAL_REDUCED,
            Message := 'and the controller reports it granted');
        _sI := 99;
        TEST_FINISHED();
ELSE
    _sI := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Request_mode_completes_only_when_the_controller_reports_it" Id="{484620f6-c91d-408a-b557-2be6f2ed915f}">
        <Declaration><![CDATA[METHOD PRIVATE Request_mode_completes_only_when_the_controller_reports_it]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Request_mode_completes_only_when_the_controller_reports_it');
IF _sJ = 99 THEN
    RETURN;
END_IF
_rbJ.Connect();
_rbJ.Cyclic();
CASE _sJ OF
    0:
        _cmJ.Setup(Name := 'Test.RobotJ', Robot := _rbJ);
        _cmJ.ParCfg.MoveTimeout := T#3S;
        _cmJ.ParCfg.HomeTimeout := T#3S;
        _cmJ();
        IF _rbJ.Linked THEN
            _sJ := 1;
        END_IF
        _nJ := _nJ + 1;
        IF _nJ > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sJ := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmJ.Command := E_RobotCommand.REQUEST_MODE;
        _cmJ.ParCmd.Mode := E_RobotOpMode.AUTO_REMOTE;
        _cmJ.Execute := TRUE;
        _cmJ();
        _sJ := 2;
    2:
        _cmJ();
        IF _cmJ.Done THEN
            AssertTrue(Condition := _cmJ.OutImm.ActualMode = E_RobotOpMode.AUTO_REMOTE,
                Message := 'Done only once the controller reports the mode');
            AssertTrue(Condition := _cmJ.OutImm.RequestedMode = E_RobotOpMode.AUTO_REMOTE,
                Message := 'and the request is published beside the report');
            _cmJ.Execute := FALSE;
            _cmJ();
            _sJ := 3;
        ELSIF _cmJ.Error THEN
            AssertTrue(Condition := FALSE, Message := 'a granted request faulted');
            _sJ := 99;
            TEST_FINISHED();
        END_IF
    3:
        // A controller that accepts and stays put (a key switch, say).
        _rbJ.Inject := E_RobotSimFault.MODE_NOT_GRANTED;
        _cmJ.ParCfg.ModeTimeout := T#200MS;
        _cmJ.ParCmd.Mode := E_RobotOpMode.MANUAL_HIGH;
        _cmJ.Execute := TRUE;
        _cmJ();
        _sJ := 4;
    4:
        _cmJ();
        IF _cmJ.Busy AND NOT _seenJ THEN
            AssertTrue(Condition := (_cmJ.OutImm.RequestedMode = E_RobotOpMode.MANUAL_HIGH)
                AND (_cmJ.OutImm.ActualMode = E_RobotOpMode.AUTO_REMOTE),
                Message := 'an ungranted request stays visibly ungranted while it waits');
            _seenJ := TRUE;
        END_IF
        IF _cmJ.Error THEN
            _diag := _cmJ.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_MODE_NOT_PERMITTED, Actual := _diag.ReasonCode,
                Message := 'and faults when the controller never grants it');
            AssertTrue(Condition := _seenJ, Message := 'after waiting, not at once');
            _rbJ.Inject := E_RobotSimFault.NONE;
            _sJ := 99;
            TEST_FINISHED();
        END_IF
        _nJ := _nJ + 1;
        IF _nJ > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the mode request never resolved');
            _sJ := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sJ := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Configuration_the_type_cannot_honour_is_refused" Id="{35dad777-162a-4c36-bee5-9b4ec7e4e7eb}">
        <Declaration><![CDATA[METHOD PRIVATE Configuration_the_type_cannot_honour_is_refused]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Configuration_the_type_cannot_honour_is_refused');
IF _sK = 99 THEN
    RETURN;
END_IF
_cmK.ParCfg.SpeedScaleMin := 0.0;
AssertFalse(Condition := _cmK.Setup(Name := 'Test.RobotK', Robot := _rbK),
    Message := 'a non-positive speed band refuses Setup');
_cmK();
_diag := _cmK.Status.Diagnostic;
AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_CFG_INVALID, Actual := _diag.ReasonCode,
    Message := 'with the configuration reason');
_cmK.ParCfg.SpeedScaleMin := 1.0;
_cmK.ParCfg.DefaultMode := E_RobotOpMode.UNKNOWN;
AssertFalse(Condition := _cmK.PrepareRecipe(Model := _model), Message := 'UNKNOWN is not a default request');
_cmK.ParCfg.DefaultMode := E_RobotOpMode.MANUAL_REDUCED;
_cmK.ParCfg.SpeedCeiling[1] := 150.0;
AssertFalse(Condition := _cmK.PrepareRecipe(Model := _model), Message := 'a ceiling above 100 percent is refused');
_cmK.ParCfg.SpeedCeiling[1] := 100.0;
_cmK.ParCfg.ModeTimeout := T#0S;
AssertFalse(Condition := _cmK.PrepareRecipe(Model := _model), Message := 'a zero mode timeout is refused');
_cmK.ParCfg.ModeTimeout := T#10S;
AssertTrue(Condition := _cmK.PrepareRecipe(Model := _model), Message := 'and a sound configuration is accepted');
_sK := 99;
TEST_FINISHED();]]></ST>
        </Implementation>
      </Method>
      <Method Name="Set_payload_reaches_the_controller" Id="{57d94393-b02c-441b-9dcd-b68f1c2e8da7}">
        <Declaration><![CDATA[METHOD PRIVATE Set_payload_reaches_the_controller]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Set_payload_reaches_the_controller');
IF _sL = 99 THEN
    RETURN;
END_IF
_rbL.Connect();
_rbL.Cyclic();
CASE _sL OF
    0:
        _cmL.Setup(Name := 'Test.RobotL', Robot := _rbL);
        _cmL.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmL.ParCfg.MoveTimeout := T#3S;
        _cmL.ParCfg.HomeTimeout := T#3S;
        _cmL();
        IF _rbL.Linked THEN
            _sL := 1;
        END_IF
        _nL := _nL + 1;
        IF _nL > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sL := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmL.Command := E_RobotCommand.SET_PAYLOAD;
        _cmL.ParCmd.TargetId := 7;
        _cmL.Execute := TRUE;
        _cmL();
        _sL := 2;
    2:
        _cmL();
        IF _cmL.Done OR _cmL.Error THEN
            AssertTrue(Condition := _cmL.Done, Message := 'selecting a load case completes');
            AssertEquals_DWORD(Expected := 7, Actual := _rbL.ActivePayload,
                Message := 'and the controller holds that load case');
            _sL := 99;
            TEST_FINISHED();
        END_IF
        _nL := _nL + 1;
        IF _nL > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'SET_PAYLOAD never completed');
            _sL := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sL := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Safety_alias_lost_mid_move_stops_powers_off_and_stays_off" Id="{12956ac4-549c-42ad-aced-0d7eb6d68ba7}">
        <Declaration><![CDATA[METHOD PRIVATE Safety_alias_lost_mid_move_stops_powers_off_and_stays_off]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Safety_alias_lost_mid_move_stops_powers_off_and_stays_off');
IF _sM = 99 THEN
    RETURN;
END_IF
_rbM.Connect();
_rbM.Cyclic();
CASE _sM OF
    0:
        _cmM.Setup(Name := 'Test.RobotM', Robot := _rbM);
        _cmM.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmM.ParCfg.MoveTimeout := T#3S;
        _cmM.ParCfg.HomeTimeout := T#3S;
        _cmM();
        IF _rbM.Linked THEN
            _sM := 1;
        END_IF
        _nM := _nM + 1;
        IF _nM > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sM := 99;
            TEST_FINISHED();
        END_IF    1:
        _rbM.PowerOn();
        _rbM.Home();
        _sM := 2;
    2:
        _cmM();
        IF _rbM.Referenced AND NOT _rbM.MotionBusy THEN
            _rbM.MoveTime := T#2S;
            _cmM.Command := E_RobotCommand.MOVE_TO;
            _cmM.ParCmd.TargetId := 4;
            _cmM.ParCmd.SpeedScale := 50.0;
            _cmM.Execute := TRUE;
            _cmM();
            _sM := 3;
        END_IF
        _nM := _nM + 1;
        IF _nM > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
            _sM := 99;
            TEST_FINISHED();
        END_IF
    3:
        _cmM();
        IF _cmM.Busy AND _rbM.MotionBusy THEN
            _cmM.SetSafetyPermit(Permit := FALSE, DescriptionKey := '');
            _cmM();
            _sM := 4;
        END_IF
        _nM := _nM + 1;
        IF _nM > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the move never started');
            _sM := 99;
            TEST_FINISHED();
        END_IF
    4:
        _cmM();
        IF _cmM.Error THEN
            _diag := _cmM.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_SAFETY_DROPPED, Actual := _diag.ReasonCode,
                Message := 'a lost safety alias stops the command with the SAFETY reason');
            AssertFalse(Condition := _rbM.MotionBusy, Message := 'the arm was stopped');
            AssertFalse(Condition := _cmM.OutImm.ArmPowerOn, Message := 'and its power dropped');
            _cmM.Execute := FALSE;
            _cmM.SetSafetyPermit(Permit := TRUE, DescriptionKey := '');
            _cmM();
            _nM := 0;
            _sM := 5;
        END_IF
        _nM := _nM + 1;
        IF _nM > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the safety drop never faulted the command');
            _sM := 99;
            TEST_FINISHED();
        END_IF
    5:
        _cmM();
        _nM := _nM + 1;
        IF _nM > 50 THEN
            AssertFalse(Condition := _cmM.OutImm.ArmPowerOn,
                Message := 'regaining the alias powers nothing on: that is a deliberate POWER_ON');
            AssertTrue(Condition := _cmM.OutImm.SafetyPermit, Message := 'though the alias is published back');
            _sM := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sM := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Power_on_is_refused_without_the_safety_alias" Id="{911ae33b-8393-46af-8392-a993436121a9}">
        <Declaration><![CDATA[METHOD PRIVATE Power_on_is_refused_without_the_safety_alias
VAR
    cmReal   : FB_RobotCM;
    connReal : FB_StaubliVal3Connector;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Power_on_is_refused_without_the_safety_alias');
IF _sN = 99 THEN
    RETURN;
END_IF
_rbN.Connect();
_rbN.Cyclic();
CASE _sN OF
    0:
        cmReal.Setup(Name := 'Test.RobotReal', Robot := connReal);
        AssertFalse(Condition := cmReal.OutImm.SafetyPermit,
            Message := 'unconfigured real connector defaults to absent safety permit');
        cmReal.SetSimulationOverride(Enable := TRUE);
        AssertTrue(Condition := cmReal.OutImm.SafetyPermit,
            Message := 'SetSimulationOverride enables permit on un-aliased connector');
        _cmN.Setup(Name := 'Test.RobotN', Robot := _rbN);
        _cmN.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmN.ParCfg.MoveTimeout := T#3S;
        _cmN.ParCfg.HomeTimeout := T#3S;
        _cmN();
        IF _rbN.Linked THEN
            _cmN.SetSafetyPermit(Permit := FALSE, DescriptionKey := 'project.safety.cellGuard');
            _sN := 1;
        END_IF
        _nN := _nN + 1;
        IF _nN > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sN := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmN.Command := E_RobotCommand.POWER_ON;
        _cmN.Execute := TRUE;
        _cmN();
        _sN := 2;
    2:
        _cmN();
        IF _cmN.Error OR _cmN.Done THEN
            _diag := _cmN.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_SAFETY_DROPPED, Actual := _diag.ReasonCode,
                Message := 'no power is requested while the safety alias is absent');
            AssertFalse(Condition := _cmN.OutImm.ArmPowerOn, Message := 'and none arrives');
            AssertFalse(Condition := _cmN.OutImm.SafetyPermit, Message := 'the absent alias is published');
            _sN := 99;
            TEST_FINISHED();
        END_IF
        _nN := _nN + 1;
        IF _nN > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'POWER_ON neither refused nor completed');
            _sN := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sN := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Aborting_a_command_stops_the_arm" Id="{43e368fc-650b-4ea6-933b-c437f4050452}">
        <Declaration><![CDATA[METHOD PRIVATE Aborting_a_command_stops_the_arm]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Aborting_a_command_stops_the_arm');
IF _sO = 99 THEN
    RETURN;
END_IF
_rbO.Connect();
_rbO.Cyclic();
CASE _sO OF
    0:
        _cmO.Setup(Name := 'Test.RobotO', Robot := _rbO);
        _cmO.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmO.ParCfg.MoveTimeout := T#3S;
        _cmO.ParCfg.HomeTimeout := T#3S;
        _cmO();
        IF _rbO.Linked THEN
            _sO := 1;
        END_IF
        _nO := _nO + 1;
        IF _nO > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sO := 99;
            TEST_FINISHED();
        END_IF    1:
        _rbO.PowerOn();
        _rbO.Home();
        _sO := 2;
    2:
        _cmO();
        IF _rbO.Referenced AND NOT _rbO.MotionBusy THEN
            _rbO.MoveTime := T#2S;
            _cmO.Command := E_RobotCommand.MOVE_TO;
            _cmO.ParCmd.TargetId := 4;
            _cmO.ParCmd.SpeedScale := 50.0;
            _cmO.Execute := TRUE;
            _cmO();
            _sO := 3;
        END_IF
        _nO := _nO + 1;
        IF _nO > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
            _sO := 99;
            TEST_FINISHED();
        END_IF
    3:
        _cmO();
        IF _cmO.Busy AND _rbO.MotionBusy THEN
            _cmO.Abort := TRUE;
            _cmO();
            _sO := 4;
        END_IF
        _nO := _nO + 1;
        IF _nO > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the move never started');
            _sO := 99;
            TEST_FINISHED();
        END_IF
    4:
        _cmO();
        IF _cmO.Aborted OR _cmO.Error THEN
            AssertTrue(Condition := _cmO.Aborted, Message := 'the command is aborted');
            AssertFalse(Condition := _rbO.MotionBusy, Message := 'and so is the motion it commanded');
            _cmO.Abort := FALSE;
            _cmO.Execute := FALSE;
            _cmO();
            _sO := 99;
            TEST_FINISHED();
        END_IF
        _nO := _nO + 1;
        IF _nO > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the abort never completed');
            _sO := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sO := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Jog_needs_a_manual_mode_the_enabling_device_and_a_fresh_request" Id="{86ef6c95-9029-4d5b-b2c7-d06772b510fa}">
        <Declaration><![CDATA[METHOD PRIVATE Jog_needs_a_manual_mode_the_enabling_device_and_a_fresh_request]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Jog_needs_a_manual_mode_the_enabling_device_and_a_fresh_request');
IF _sP = 99 THEN
    RETURN;
END_IF
_rbP.Connect();
_rbP.Cyclic();
CASE _sP OF
    0:
        _cmP.Setup(Name := 'Test.RobotP', Robot := _rbP);
        _cmP.ParCfg.MoveTimeout := T#3S;
        _cmP.ParCfg.HomeTimeout := T#3S;
        _cmP();
        IF _rbP.Linked THEN
            _sP := 1;
        END_IF
        _nP := _nP + 1;
        IF _nP > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sP := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmP();
        _enP.Present := TRUE;
        _enP.Held := FALSE;
        AssertFalse(Condition := _cmP.RequestHeldCommand(Value := TO_DINT(E_RobotCommand.JOG_POS), Enable := _enP),
            Message := 'no jog without the enabling device held');
        AssertEquals_DINT(Expected := TO_DINT(E_Reason.PERMISSIVE_NOT_MET), Actual := _cmP.OutImm.JogStopReason,
            Message := 'and the reason is published');
        _enP.Held := TRUE;
        _poseP0 := _rbP.ActualPosition;
        _nP := 0;
        _sP := 2;
    2:
        AssertTrue(Condition := _cmP.RequestHeldCommand(Value := TO_DINT(E_RobotCommand.JOG_POS), Enable := _enP),
            Message := 'a held request in a manual mode is accepted');
        _cmP();
        _nP := _nP + 1;
        IF _nP > 10 THEN
            AssertTrue(Condition := _cmP.OutImm.Jogging, Message := 'and the arm jogs while it keeps arriving');
            _poseP := _rbP.ActualPosition;
            AssertTrue(Condition := _poseP.X > _poseP0.X, Message := 'in the asked direction');
            _nP := 0;
            _sP := 3;
        END_IF
    3:
        // Nobody asks any more: the jog must stop by itself.
        _cmP();
        IF NOT _cmP.OutImm.Jogging THEN
            AssertEquals_DINT(Expected := 0, Actual := _cmP.OutImm.JogStopReason,
                Message := 'a request that stops arriving stops the jog, as a release');
            _rbP.RequestMode(Mode := E_RobotOpMode.AUTO_REMOTE);
            _cmP();
            AssertFalse(Condition := _cmP.RequestHeldCommand(Value := TO_DINT(E_RobotCommand.JOG_NEG), Enable := _enP),
                Message := 'and no jog is accepted in automatic');
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_MODE_NOT_PERMITTED, Actual := _cmP.OutImm.JogStopReason,
                Message := 'with the mode as the reason');
            _sP := 99;
            TEST_FINISHED();
        END_IF
        _nP := _nP + 1;
        IF _nP > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the jog never stopped');
            _sP := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sP := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Jog_selection_is_validated_and_published" Id="{930c8112-598c-430b-9165-94f8a3319a8a}">
        <Declaration><![CDATA[METHOD PRIVATE Jog_selection_is_validated_and_published]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Jog_selection_is_validated_and_published');
IF _sQ = 99 THEN
    RETURN;
END_IF
AssertFalse(Condition := _cmQ.SetJogSelection(Mode := E_RobotJogMode.JOINT, Axis := 0),
    Message := 'axis 0 is refused');
AssertFalse(Condition := _cmQ.SetJogSelection(Mode := E_RobotJogMode.JOINT, Axis := PL_Robot.MAX_JOG_AXES + 1),
    Message := 'an axis beyond the type bound is refused');
AssertTrue(Condition := _cmQ.SetJogSelection(Mode := E_RobotJogMode.CARTESIAN, Axis := 3),
    Message := 'a real selection is accepted');
AssertEquals_INT(Expected := 3, Actual := _cmQ.OutImm.JogAxis, Message := 'and the axis is published');
AssertTrue(Condition := _cmQ.OutImm.JogMode = E_RobotJogMode.CARTESIAN, Message := 'with its frame');
_sQ := 99;
TEST_FINISHED();]]></ST>
        </Implementation>
      </Method>
      <Method Name="User_signals_are_declared_published_and_written" Id="{fc366431-237c-411d-a67f-f7968562cb8d}">
        <Declaration><![CDATA[METHOD PRIVATE User_signals_are_declared_published_and_written]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('User_signals_are_declared_published_and_written');
IF _sR = 99 THEN
    RETURN;
END_IF
_rbR.Connect();
_rbR.Cyclic();
CASE _sR OF
    0:
        IF NOT _declR THEN
            AssertTrue(Condition := _cmR.M_DeclareUserSignal(Index := 1, Key := 'project.robot.gripClosed',
                ToRobot := FALSE, Kind := E_RobotSignalKind.BOOL_SIGNAL), Message := 'a from-robot flag is declared');
            AssertTrue(Condition := _cmR.M_DeclareUserSignal(Index := 2, Key := 'project.robot.partCount',
                ToRobot := TRUE, Kind := E_RobotSignalKind.INT_SIGNAL), Message := 'a to-robot integer is declared');
            AssertFalse(Condition := _cmR.M_DeclareUserSignal(Index := 1, Key := 'project.robot.again',
                ToRobot := FALSE, Kind := E_RobotSignalKind.BOOL_SIGNAL), Message := 'a slot is declared once');
            AssertFalse(Condition := _cmR.M_DeclareUserSignal(Index := PL_Robot.MAX_USER_SIGNALS + 1,
                Key := 'project.robot.beyond', ToRobot := FALSE, Kind := E_RobotSignalKind.BOOL_SIGNAL),
                Message := 'a slot beyond the bound is refused');
            AssertFalse(Condition := _cmR.M_DeclareUserSignal(Index := 3, Key := '',
                ToRobot := FALSE, Kind := E_RobotSignalKind.BOOL_SIGNAL), Message := 'a nameless signal is refused');
            _declR := TRUE;
        END_IF
        _cmR.Setup(Name := 'Test.RobotR', Robot := _rbR);
        _cmR.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;
        _cmR();
        IF _rbR.Linked THEN
            _sR := 1;
        END_IF
        _nR := _nR + 1;
        IF _nR > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sR := 99;
            TEST_FINISHED();
        END_IF
    1:
        _rbR.UserIn[1] := 1.0;
        _cmR();
        AssertTrue(Condition := _cmR.OutImm.UserSignals[1].Valid, Message := 'a declared signal is valid while linked');
        AssertEquals_LREAL(Expected := 1.0, Actual := _cmR.OutImm.UserSignals[1].Value, Delta := 0.0001,
            Message := 'and publishes what the robot program reports');
        AssertTrue(Condition := _cmR.M_WriteUserSignal(Index := 2, Value := 42.0),
            Message := 'a to-robot integer is written');
        AssertEquals_LREAL(Expected := 42.0, Actual := _rbR.UserOut[2], Delta := 0.0001,
            Message := 'and reaches the robot program');
        AssertFalse(Condition := _cmR.M_WriteUserSignal(Index := 2, Value := 2.5),
            Message := 'an integer signal refuses a fraction rather than rounding it');
        AssertFalse(Condition := _cmR.M_WriteUserSignal(Index := 1, Value := 1.0),
            Message := 'a from-robot signal is never written');
        AssertFalse(Condition := _cmR.M_WriteUserSignal(Index := 3, Value := 1.0),
            Message := 'nor is an undeclared slot');
        AssertFalse(Condition := _cmR.OutImm.UserSignals[3].Valid, Message := 'which publishes nothing');
        _sR := 99;
        TEST_FINISHED();
ELSE
    _sR := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Arm_power_and_the_applied_speed_are_published" Id="{99bf9939-4020-4f47-b0e6-8a0b15ad28e2}">
        <Declaration><![CDATA[METHOD PRIVATE Arm_power_and_the_applied_speed_are_published]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Arm_power_and_the_applied_speed_are_published');
IF _sS = 99 THEN
    RETURN;
END_IF
_rbS.Connect();
_rbS.Cyclic();
CASE _sS OF
    0:
        _cmS.Setup(Name := 'Test.RobotS', Robot := _rbS);
        _cmS.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmS.ParCfg.MoveTimeout := T#3S;
        _cmS.ParCfg.HomeTimeout := T#3S;
        _cmS();
        IF _rbS.Linked THEN
            _cmS.ParCfg.SpeedCeiling[E_RobotOpMode.AUTO_REMOTE] := 40.0;
            _sS := 1;
        END_IF
        _nS := _nS + 1;
        IF _nS > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sS := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmS.Command := E_RobotCommand.POWER_ON;
        _cmS.Execute := TRUE;
        _cmS();
        _sS := 2;
    2:
        _cmS();
        IF _cmS.Done THEN
            AssertTrue(Condition := _cmS.OutImm.ArmPowerOn, Message := 'the reported arm power is published');
            _cmS.Execute := FALSE;
            _cmS();
            _rbS.Home();
            _sS := 3;
        END_IF
        _nS := _nS + 1;
        IF _nS > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'POWER_ON never completed');
            _sS := 99;
            TEST_FINISHED();
        END_IF
    3:
        _cmS();
        IF _rbS.Referenced AND NOT _rbS.MotionBusy THEN
            _cmS.Command := E_RobotCommand.MOVE_TO;
            _cmS.ParCmd.TargetId := 2;
            _cmS.ParCmd.SpeedScale := 50.0;
            _cmS.Execute := TRUE;
            _cmS();
            _sS := 4;
        END_IF
        _nS := _nS + 1;
        IF _nS > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
            _sS := 99;
            TEST_FINISHED();
        END_IF
    4:
        _cmS();
        IF _cmS.Done OR _cmS.Error THEN
            AssertTrue(Condition := _cmS.Done, Message := 'the move completes');
            AssertEquals_REAL(Expected := 40.0, Actual := _cmS.OutImm.SpeedScale, Delta := 0.001,
                Message := 'and the published scale is the one sent: MIN(ceiling, recipe)');
            _sS := 99;
            TEST_FINISHED();
        END_IF
        _nS := _nS + 1;
        IF _nS > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'MOVE_TO never completed');
            _sS := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sS := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="A_repeated_refusal_keeps_its_own_reason_and_a_success_follows" Id="{603b8186-959a-4df8-bccb-7440ef5faf48}">
        <Declaration><![CDATA[METHOD PRIVATE A_repeated_refusal_keeps_its_own_reason_and_a_success_follows]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('A_repeated_refusal_keeps_its_own_reason_and_a_success_follows');
IF _sT = 99 THEN
    RETURN;
END_IF
_rbT.Connect();
_rbT.Cyclic();
CASE _sT OF
    0:
        _cmT.Setup(Name := 'Test.RobotT', Robot := _rbT);
        _cmT.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmT.ParCfg.MoveTimeout := T#3S;
        _cmT.ParCfg.HomeTimeout := T#3S;
        _cmT();
        IF _rbT.Linked THEN
            _sT := 1;
        END_IF
        _nT := _nT + 1;
        IF _nT > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sT := 99;
            TEST_FINISHED();
        END_IF
    1:
        _rbT.PowerOn();
        _rbT.Home();
        _sT := 2;
    2:
        _cmT();
        IF _rbT.Referenced AND NOT _rbT.MotionBusy THEN
            _rbT.Inject := E_RobotSimFault.POINT_UNREACHABLE;
            _cmT.Command := E_RobotCommand.MOVE_TO;
            _cmT.ParCmd.TargetId := 3;
            _cmT.ParCmd.SpeedScale := 50.0;
            _cmT.Execute := TRUE;
            _cmT();
            _kT := 0;
            _sT := 3;
        END_IF
        _nT := _nT + 1;
        IF _nT > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
            _sT := 99;
            TEST_FINISHED();
        END_IF
    3:
        _cmT();
        IF _cmT.Error THEN
            _diag := _cmT.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_POINT_UNREACHABLE, Actual := _diag.ReasonCode,
                Message := 'every refusal carries the connector reason, the repeated one too');
            _cmT.Execute := FALSE;
            _cmT();
            _kT := _kT + 1;
            IF _kT >= 2 THEN
                _rbT.Inject := E_RobotSimFault.NONE;
                _sT := 5;
            ELSE
                _sT := 4;
            END_IF
        END_IF
        _nT := _nT + 1;
        IF _nT > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'a refused move never faulted');
            _sT := 99;
            TEST_FINISHED();
        END_IF
    4:
        _cmT.Execute := TRUE;
        _cmT();
        _sT := 3;
    5:
        _cmT.Execute := TRUE;
        _cmT();
        _sT := 6;
    6:
        _cmT();
        IF _cmT.Done OR _cmT.Error THEN
            AssertTrue(Condition := _cmT.Done,
                Message := 'and an accepted move after them completes - no stale reason adopted');
            _sT := 99;
            TEST_FINISHED();
        END_IF
        _nT := _nT + 1;
        IF _nT > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the accepted move never completed');
            _sT := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sT := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="An_aborted_path_reports_its_progress_for_a_deliberate_continue" Id="{88301521-0390-4599-ba39-1633855b05b2}">
        <Declaration><![CDATA[METHOD PRIVATE An_aborted_path_reports_its_progress_for_a_deliberate_continue]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('An_aborted_path_reports_its_progress_for_a_deliberate_continue');
IF _sU = 99 THEN
    RETURN;
END_IF
_rbU.Connect();
_rbU.Cyclic();
CASE _sU OF
    0:
        _cmU.Setup(Name := 'Test.RobotU', Robot := _rbU);
        _cmU.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmU.ParCfg.MoveTimeout := T#5S;
        _cmU.ParCfg.HomeTimeout := T#3S;
        _cmU();
        IF _rbU.Linked THEN
            _rbU.PowerOn();
            _rbU.Home();
            _sU := 1;
        END_IF
        _nU := _nU + 1;
        IF _nU > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sU := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmU();
        IF _rbU.Referenced AND NOT _rbU.MotionBusy THEN
            _rbU.MoveTime := T#2S;
            _cmU.Command := E_RobotCommand.RUN_PATH;
            _cmU.ParCmd.TargetId := 1;
            _cmU.ParCmd.StartIdx := 0;
            _cmU.ParCmd.EndIdx := 9;
            _cmU.ParCmd.SpeedScale := 50.0;
            _cmU.Execute := TRUE;
            _cmU();
            _sU := 2;
        END_IF
    2:
        _cmU();
        IF _rbU.PathIndex >= 2 THEN
            _cmU.Abort := TRUE;
            _cmU();
            _sU := 3;
        END_IF
    3:
        _cmU();
        IF _cmU.Aborted THEN
            _idxU := _cmU.OutImm.PathIndex;
            AssertTrue(Condition := (_idxU >= 0) AND (_idxU < 9),
                Message := 'the abort left the path part-way, and says how far it got');
            AssertFalse(Condition := _rbU.MotionBusy, Message := 'nothing continues by itself');
            _cmU.Abort := FALSE;
            _cmU.Execute := FALSE;
            _cmU();
            _sU := 4;
        END_IF
    4:
        // The deliberate continue: the remaining points, from where the path stopped.
        _rbU.MoveTime := T#200MS;
        _cmU.ParCmd.StartIdx := _idxU + 1;
        _cmU.Execute := TRUE;
        _cmU();
        _sU := 5;
    5:
        _cmU();
        IF _cmU.Done OR _cmU.Error THEN
            AssertTrue(Condition := _cmU.Done, Message := 'a RUN_PATH from the next point continues it');
            AssertEquals_DINT(Expected := 9, Actual := _cmU.OutImm.PathIndex, Message := 'to the end of the path');
            _sU := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sU := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="Capabilities_are_published_and_a_command_not_offered_is_refused_before_issuing" Id="{0e18ae14-aaf7-4dfd-9ee7-83745df12ffd}">
        <Declaration><![CDATA[METHOD PRIVATE Capabilities_are_published_and_a_command_not_offered_is_refused_before_issuing]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Capabilities_are_published_and_a_command_not_offered_is_refused_before_issuing');
IF _sV = 99 THEN
    RETURN;
END_IF
_rbV.Connect();
_rbV.Cyclic();
CASE _sV OF
    0:
        _cmV.Setup(Name := 'Test.RobotV', Robot := _rbV);
        _cmV.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmV.ParCfg.MoveTimeout := T#3S;
        _cmV.ParCfg.HomeTimeout := T#3S;
        _cmV();
        IF _rbV.Linked THEN
            // A controller without load cases and without a positive jog.
            _rbV.Offered := 16#0003FFFE AND NOT 16#00006000;
            _sV := 1;
        END_IF
        _nV := _nV + 1;
        IF _nV > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sV := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmV();
        AssertTrue(Condition := _cmV.OutImm.Capabilities.Reported, Message := 'the controller$'s offer is published');
        AssertEquals_DWORD(Expected := 16#00039FFE, Actual := TO_DWORD(_cmV.OutImm.Capabilities.Commands),
            Message := 'command by command');
        AssertEquals_INT(Expected := 7, Actual := _cmV.OutImm.Capabilities.JogAxes, Message := 'with its jog axes');
        _cmV.Command := E_RobotCommand.SET_PAYLOAD;
        _cmV.ParCmd.TargetId := 7;
        _cmV.Execute := TRUE;
        _cmV();
        _sV := 2;
    2:
        _cmV();
        IF _cmV.Error OR _cmV.Done THEN
            _diag := _cmV.Status.Diagnostic;
            AssertEquals_DINT(Expected := E_Reason.UNSUPPORTED_COMMAND, Actual := _diag.ReasonCode,
                Message := 'a command the controller does not offer is refused');
            AssertEquals_DWORD(Expected := 0, Actual := _rbV.ActivePayload,
                Message := 'before anything was sent');
            _enV.Held := TRUE;
            AssertFalse(Condition := _cmV.RequestHeldCommand(Value := TO_DINT(E_RobotCommand.JOG_POS), Enable := _enV),
                Message := 'a jog it does not offer is not started');
            AssertEquals_DINT(Expected := E_Reason.UNSUPPORTED_COMMAND, Actual := _cmV.OutImm.JogStopReason,
                Message := 'and says why');
            _sV := 99;
            TEST_FINISHED();
        END_IF
        _nV := _nV + 1;
        IF _nV > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'SET_PAYLOAD neither refused nor completed');
            _sV := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sV := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="A_move_to_a_missing_or_untaught_point_is_refused_and_nothing_moves" Id="{665ca5f0-bbe2-4fcb-9af2-c40aa9a739a3}">
        <Declaration><![CDATA[METHOD PRIVATE A_move_to_a_missing_or_untaught_point_is_refused_and_nothing_moves]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('A_move_to_a_missing_or_untaught_point_is_refused_and_nothing_moves');
IF _sW = 99 THEN
    RETURN;
END_IF
_rbW.Connect();
_rbW.Cyclic();
CASE _sW OF
    0:
        _cmW.Setup(Name := 'Test.RobotW', Robot := _rbW);
        _cmW.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmW.ParCfg.MoveTimeout := T#3S;
        _cmW.ParCfg.HomeTimeout := T#3S;
        _cmW();
        IF _rbW.Linked THEN
            _sW := 1;
        END_IF
        _nW := _nW + 1;
        IF _nW > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sW := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmW.Command := E_RobotCommand.MOVE_TO;
        _cmW.ParCmd.TargetId := 0;
        _cmW.ParCmd.SpeedScale := 50.0;
        _cmW.Execute := TRUE;
        _cmW();
        _sW := 2;
    2:
        _cmW();
        IF _cmW.Error OR _cmW.Done THEN
            _diag := _cmW.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_POINT_UNKNOWN, Actual := _diag.ReasonCode,
                Message := 'a move without a point is refused here, never sent as the zero pose');
            AssertFalse(Condition := _rbW.MotionBusy, Message := 'nothing moves');
            _cmW.Execute := FALSE;
            _cmW();
            _sW := 3;
        END_IF
        _nW := _nW + 1;
        IF _nW > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the pointless move neither refused nor completed');
            _sW := 99;
            TEST_FINISHED();
        END_IF
    3:
        _cmW();
        _rbW.PowerOn();
        _rbW.Home();
        _sW := 4;
    4:
        _cmW();
        IF _rbW.Referenced AND NOT _rbW.MotionBusy THEN
            // The controller holds points 1..10 only.
            _rbW.TaughtPoints := 10;
            _cmW.ParCmd.TargetId := 42;
            _cmW.Execute := TRUE;
            _cmW();
            _sW := 5;
        END_IF
        _nW := _nW + 1;
        IF _nW > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
            _sW := 99;
            TEST_FINISHED();
        END_IF
    5:
        _cmW();
        IF _cmW.Error OR _cmW.Done THEN
            _diag := _cmW.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_POINT_UNKNOWN, Actual := _diag.ReasonCode,
                Message := 'an untaught point is refused by the controller with its own reason');
            AssertFalse(Condition := _rbW.MotionBusy, Message := 'and nothing moves');
            _sW := 99;
            TEST_FINISHED();
        END_IF
        _nW := _nW + 1;
        IF _nW > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the untaught move neither refused nor completed');
            _sW := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sW := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="A_due_brake_test_is_published_and_withdrawn_by_running_it" Id="{a74c4fe0-b9e8-4629-ad26-4242243f495b}">
        <Declaration><![CDATA[METHOD PRIVATE A_due_brake_test_is_published_and_withdrawn_by_running_it]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('A_due_brake_test_is_published_and_withdrawn_by_running_it');
IF _sX = 99 THEN
    RETURN;
END_IF
_rbX.Connect();
_rbX.Cyclic();
CASE _sX OF
    0:
        _cmX.Setup(Name := 'Test.RobotX', Robot := _rbX);
        _cmX.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmX.ParCfg.MoveTimeout := T#3S;
        _cmX.ParCfg.HomeTimeout := T#3S;
        _cmX();
        IF _rbX.Linked THEN
            _sX := 1;
        END_IF
        _nX := _nX + 1;
        IF _nX > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sX := 99;
            TEST_FINISHED();
        END_IF    1:
        _cmX();
        _rbX.PowerOn();
        _rbX.Home();
        _sX := 2;
    2:
        _cmX();
        IF _rbX.Referenced AND NOT _rbX.MotionBusy THEN
            _rbX.M_DemandBrakeTest();
            _sX := 3;
        END_IF
        _nX := _nX + 1;
        IF _nX > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
            _sX := 99;
            TEST_FINISHED();
        END_IF
    3:
        _cmX();
        AssertTrue(Condition := _cmX.OutImm.BrakeTestDue, Message := 'the controller$'s demand is published');
        AssertTrue(Condition := _cmX.StateFlags[1].Value AND (_cmX.StateFlags[1].Key = 'std.state.robotBrakeTestDue'),
            Message := 'as a state flag the generic HMI shows');
        AssertFalse(Condition := _cmX.OutImm.SafeReferenceDue, Message := 'only the routine asked for');
        _cmX.Command := E_RobotCommand.BRAKE_TEST;
        _cmX.Execute := TRUE;
        _cmX();
        _sX := 4;
    4:
        _cmX();
        IF _cmX.Done OR _cmX.Error THEN
            AssertTrue(Condition := _cmX.Done, Message := 'the brake test runs to completion');
            AssertFalse(Condition := _cmX.OutImm.BrakeTestDue, Message := 'and the demand is withdrawn');
            _sX := 99;
            TEST_FINISHED();
        END_IF
        _nX := _nX + 1;
        IF _nX > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'BRAKE_TEST never finished');
            _sX := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sX := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="A_routine_that_leaves_its_demand_standing_faults" Id="{65727fb0-6344-4224-aa80-69622203c71f}">
        <Declaration><![CDATA[METHOD PRIVATE A_routine_that_leaves_its_demand_standing_faults]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('A_routine_that_leaves_its_demand_standing_faults');
IF _sY = 99 THEN
    RETURN;
END_IF
_rbY.Connect();
_rbY.Cyclic();
CASE _sY OF
    0:
        _cmY.Setup(Name := 'Test.RobotY', Robot := _rbY);
        _cmY.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmY.ParCfg.MoveTimeout := T#3S;
        _cmY.ParCfg.HomeTimeout := T#3S;
        _cmY();
        IF _rbY.Linked THEN
            _sY := 1;
        END_IF
        _nY := _nY + 1;
        IF _nY > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sY := 99;
            TEST_FINISHED();
        END_IF    1:
        _cmY();
        _rbY.PowerOn();
        _rbY.Home();
        _sY := 2;
    2:
        _cmY();
        IF _rbY.Referenced AND NOT _rbY.MotionBusy THEN
            _rbY.M_DemandSafeReference();
            _rbY.Inject := E_RobotSimFault.ROUTINE_FAILED;
            _cmY.Command := E_RobotCommand.SAFE_REFERENCE;
            _cmY.Execute := TRUE;
            _cmY();
            _sY := 3;
        END_IF
        _nY := _nY + 1;
        IF _nY > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
            _sY := 99;
            TEST_FINISHED();
        END_IF
    3:
        _cmY();
        IF _cmY.Done OR _cmY.Error THEN
            _diag := _cmY.Status.Diagnostic;
            AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_ROUTINE_FAILED, Actual := _diag.ReasonCode,
                Message := 'a safe reference run that ends with its demand standing is a finding, not a completion');
            AssertTrue(Condition := _cmY.OutImm.SafeReferenceDue, Message := 'and the demand stays published');
            _rbY.Inject := E_RobotSimFault.NONE;
            _sY := 99;
            TEST_FINISHED();
        END_IF
        _nY := _nY + 1;
        IF _nY > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'SAFE_REFERENCE never finished');
            _sY := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sY := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
      <Method Name="A_declared_manual_move_runs_to_its_point_at_the_slowest_speed" Id="{bdb8b44c-e06f-4135-8f73-6802263404ab}">
        <Declaration><![CDATA[METHOD PRIVATE A_declared_manual_move_runs_to_its_point_at_the_slowest_speed]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('A_declared_manual_move_runs_to_its_point_at_the_slowest_speed');
IF _sZ = 99 THEN
    RETURN;
END_IF
_rbZ.Connect();
_rbZ.Cyclic();
CASE _sZ OF
    0:
        _cmZ.Setup(Name := 'Test.RobotZ', Robot := _rbZ);
        _cmZ.ParCfg.DefaultMode := E_RobotOpMode.AUTO_REMOTE;   // an auto-only cell
        _cmZ.ParCfg.MoveTimeout := T#3S;
        _cmZ.ParCfg.HomeTimeout := T#3S;
        _cmZ();
        IF _rbZ.Linked THEN
            _sZ := 1;
        END_IF
        _nZ := _nZ + 1;
        IF _nZ > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated link never came up');
            _sZ := 99;
            TEST_FINISHED();
        END_IF
    1:
        _cmZ();
        AssertTrue(Condition := _cmZ.M_DeclareManualMove(Slot := 1, PointId := 7, LabelKey := 'project.robot.toPick'),
            Message := 'a move to a taught point is declared');
        AssertFalse(Condition := _cmZ.M_DeclareManualMove(Slot := 1, PointId := 8, LabelKey := 'project.robot.other'),
            Message := 'a slot is declared once');
        AssertFalse(Condition := _cmZ.M_DeclareManualMove(Slot := 0, PointId := 8, LabelKey := 'project.robot.other'),
            Message := 'slot 0 is refused');
        AssertFalse(Condition := _cmZ.M_DeclareManualMove(Slot := PL_Robot.MAX_MANUAL_MOVES + 1, PointId := 8,
            LabelKey := 'project.robot.other'), Message := 'a slot past the bound is refused');
        AssertFalse(Condition := _cmZ.M_DeclareManualMove(Slot := 2, PointId := 0, LabelKey := 'project.robot.other'),
            Message := 'point 0 names nothing');
        AssertFalse(Condition := _cmZ.M_DeclareManualMove(Slot := 2, PointId := 8, LabelKey := ''),
            Message := 'an unlabelled move is refused');
        AssertEquals_INT(Expected := 5, Actual := _cmZ.CatalogCount,
            Message := 'two jogs, two routines and the one declared move are offered');
        AssertEquals_DINT(Expected := PL_Robot.MANUAL_MOVE_BASE + 1, Actual := _cmZ.Catalog[5].Value,
            Message := 'under a value clear of every command');
        _cmZ.ParCmd.SpeedScale := 80.0;   // a program's speed, which a screen press must not inherit
        _sZ := 2;
    2:
        _cmZ();
        _rbZ.PowerOn();
        _rbZ.Home();
        _sZ := 3;
    3:
        _cmZ();
        IF _rbZ.Referenced AND NOT _rbZ.MotionBusy THEN
            AssertTrue(Condition := _cmZ.ManualCommand(Value := PL_Robot.MANUAL_MOVE_BASE + 1),
                Message := 'one press starts it');
            _sZ := 4;
        END_IF
        _nZ := _nZ + 1;
        IF _nZ > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the simulated robot never homed');
            _sZ := 99;
            TEST_FINISHED();
        END_IF
    4:
        _cmZ();
        IF _cmZ.Done OR _cmZ.Error THEN
            AssertTrue(Condition := _cmZ.Done, Message := 'the declared move completes');
            AssertEquals_DWORD(Expected := 7, Actual := _cmZ.OutCmd.ReachedId, Message := 'at its own point');
            AssertEquals_DWORD(Expected := 7, Actual := _rbZ.CurrentArea, Message := 'which the arm reached');
            AssertEquals_REAL(Expected := _cmZ.ParCfg.SpeedScaleMin, Actual := _cmZ.OutImm.SpeedScale, Delta := 0.001,
                Message := 'at the slowest speed the cell allows, not the program$'s');
            _sZ := 99;
            TEST_FINISHED();
        END_IF
        _nZ := _nZ + 1;
        IF _nZ > 3000 THEN
            AssertTrue(Condition := FALSE, Message := 'the declared move never finished');
            _sZ := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _sZ := 99;
    TEST_FINISHED();
END_CASE]]></ST>
        </Implementation>
      </Method>
  </POU>
</TcPlcObject>