<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_InputCM_Tests" Id="{5f23aa6a-e14f-460b-a881-7b5d5886f894}" SpecialFunc="None">
    <Declaration><![CDATA[// Basic passive input types used to keep hardware-bound signals out of Units.
FUNCTION_BLOCK FB_InputCM_Tests EXTENDS TcUnit.FB_TestSuite
VAR
    _input : FB_DigitalInputCM;
    _air : FB_AirPressureMonitorCM;
    _inputHal : ST_DigitalInputHal;
    _airHal : ST_AirPressureHal;
    _inputIdentity, _lowIdentity, _operatingIdentity : ST_IoPointIdentity;
    _d : ST_Diagnostic;
    _wired : BOOL;
    // Debounce rows (one instance each: TcUnit runs a suite's tests side by side).
    _pass, _slow, _bouncy, _lossy, _bad : FB_DigitalInputCM;
    _passHal, _slowHal, _bouncyHal, _lossyHal, _badHal : ST_DigitalInputHal;
    _passSetup, _badSetup, _badDone, _bounceStarted, _bounceSeen : BOOL;
    _slowStep, _lossStep : INT;
    _slowSince, _lossSince, _bounceSince : TIME;
    _tSlow, _tLoss : TON;
END_VAR
VAR CONSTANT
    TEST_TIMEOUT : TIME := T#5S;
END_VAR]]></Declaration>
    <Implementation><ST><![CDATA[IF NOT _wired THEN
    _input.Setup(Name := 'Test.PartPresent', HalRef := _inputHal,
        DisplayNameKey := 'project.module.partPresentSensor.name',
        DescriptionKey := 'project.module.partPresentSensor.description');
    _inputIdentity.Tag := '_101B601'; _inputIdentity.Address := 'EL1809 Ch12';
    _input.ConfigureIoIdentity(Identity := _inputIdentity);
    _air.Setup(Name := 'Test.Air', HalRef := _airHal);
    // Deterministic qualification in the test runtime, set through the registered
// §3.10.2 capability rather than by touching the module's retained data: that
// path is the only one a station has, so the test uses it too.
_air.M_ApplyConfigWrite(Scope := 'Test.Air', WriteKey := 'airPressure.conflictTime',
    Revision := 1, TextValue := '0', RootReady := TRUE);
    _lowIdentity.Tag := '_000MB085A_2'; _lowIdentity.Address := 'EL1809 Ch10';
    _operatingIdentity.Tag := '_000MB085A_4'; _operatingIdentity.Address := 'EL1809 Ch11';
    _air.ConfigureIoIdentity(LowSensor := _lowIdentity, OperatingSensor := _operatingIdentity);
    _inputHal.Quality := TRUE; _airHal.Quality := TRUE;
    _passSetup := _pass.Setup(Name := 'Test.Pass', HalRef := _passHal,
        DisplayNameKey := 'project.module.partPresentSensor.name',
        DescriptionKey := 'project.module.partPresentSensor.description');
    _slow.ParCfg.DebounceTime := T#50MS;
    _slow.Setup(Name := 'Test.Slow', HalRef := _slowHal,
        DisplayNameKey := 'project.module.partPresentSensor.name',
        DescriptionKey := 'project.module.partPresentSensor.description');
    _bouncy.ParCfg.DebounceTime := T#100MS;
    _bouncy.Setup(Name := 'Test.Bouncy', HalRef := _bouncyHal,
        DisplayNameKey := 'project.module.partPresentSensor.name',
        DescriptionKey := 'project.module.partPresentSensor.description');
    _lossy.ParCfg.DebounceTime := T#50MS;
    _lossy.Setup(Name := 'Test.Lossy', HalRef := _lossyHal,
        DisplayNameKey := 'project.module.partPresentSensor.name',
        DescriptionKey := 'project.module.partPresentSensor.description');
    _bad.ParCfg.DebounceTime := T#11S;
    _badSetup := _bad.Setup(Name := 'Test.Bad', HalRef := _badHal,
        DisplayNameKey := 'project.module.partPresentSensor.name',
        DescriptionKey := 'project.module.partPresentSensor.description');
    _wired := TRUE;
ELSE
    ;
END_IF
Digital_input_publishes_semantic_value_and_identity();
Air_monitor_derives_pressure_and_faults_on_conflict();
Zero_debounce_passes_through_in_the_same_scan();
Debounce_holds_until_stable_for_the_configured_time();
Bounce_shorter_than_debounce_never_reaches_Value();
Bad_quality_forces_false_and_restarts_the_timer();
Oversized_debounce_or_wrong_schema_publishes_invalid();]]></ST></Implementation>
    <Method Name="Digital_input_publishes_semantic_value_and_identity" Id="{3053e05f-ad4c-418d-91e7-9fb841ff223a}">
      <Declaration><![CDATA[METHOD Digital_input_publishes_semantic_value_and_identity]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Digital_input_publishes_semantic_value_and_identity');
_inputHal.Value := TRUE;
_input();
AssertTrue(Condition := _input.OutImm.Value, Message := 'HAL value published');
AssertEquals_STRING(Expected := '_101B601', Actual := _input.OutImm.IoTag,
    Message := 'physical identity is injected, not embedded in the type');
// §7.1: the display name is the instance's, the type key is the type's.
AssertEquals_STRING(Expected := 'project.module.partPresentSensor.name',
    Actual := _input.Status.DisplayNameKey, Message := 'display key is set per instance');
AssertEquals_STRING(Expected := 'std.moduleType.digitalInput', Actual := _input.Status.TypeKey,
    Message := 'type key is fixed by the type, whatever the instance is called');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="Air_monitor_derives_pressure_and_faults_on_conflict" Id="{5fec7a29-2d4a-4f52-a64a-c33c6eb3b945}">
      <Declaration><![CDATA[METHOD Air_monitor_derives_pressure_and_faults_on_conflict]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Air_monitor_derives_pressure_and_faults_on_conflict');
_airHal.LowPressure := FALSE; _airHal.OperatingPressure := TRUE;
_air();
AssertTrue(Condition := _air.OutImm.PressureOk,
    Message := 'operating threshold with low switch clear is ready');
_airHal.LowPressure := TRUE; _airHal.OperatingPressure := TRUE;
_air();
_d := _air.GetFaultSummary();
AssertEquals_DWORD(Expected := TO_DWORD(PL_ModuleReasons.AIR_SWITCH_CONFLICT),
    Actual := _air.ErrorID, Message := 'contradictory switches use registered type reason');
AssertEquals_STRING(Expected := '_000MB085A_2 / _000MB085A_4', Actual := _d.IoTag,
    Message := 'both implicated electrical tags are preserved');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="Zero_debounce_passes_through_in_the_same_scan" Id="{06143d71-cca4-43c2-b2e9-156186a6b3e3}">
      <Declaration><![CDATA[METHOD Zero_debounce_passes_through_in_the_same_scan]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Zero_debounce_passes_through_in_the_same_scan');
AssertTrue(Condition := _passSetup, Message := 'the v2 defaults are a valid configuration');
_passHal.Value := TRUE;
_pass();
AssertTrue(Condition := _pass.OutImm.Value, Message := 'T#0MS follows the HAL in the scan it changes');
_passHal.Value := FALSE;
_pass();
AssertFalse(Condition := _pass.OutImm.Value, Message := 'and back, in the same scan');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="Debounce_holds_until_stable_for_the_configured_time" Id="{d6f906e2-4dca-43de-b814-60678b2a0be1}">
      <Declaration><![CDATA[METHOD Debounce_holds_until_stable_for_the_configured_time]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Debounce_holds_until_stable_for_the_configured_time');
IF _slowStep = 99 THEN
    RETURN;
END_IF
_tSlow(IN := TRUE, PT := TEST_TIMEOUT);
CASE _slowStep OF
    0:
        _slowHal.Value := TRUE;
        _slowSince := TIME();
        _slow();
        AssertFalse(Condition := _slow.OutImm.Value,
            Message := 'a change is not published in the scan it appears');
        _slowStep := 1;
    1:
        _slow();
        IF _slow.OutImm.Value THEN
            AssertTrue(Condition := TIME() - _slowSince >= T#50MS,
                Message := 'Value followed only after DebounceTime of a continuous difference');
            _slowStep := 99;
            TEST_FINISHED();
        ELSIF _tSlow.Q THEN
            AssertTrue(Condition := FALSE, Message := 'a stable change never reached Value');
            _slowStep := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _slowStep := 99;
    TEST_FINISHED();
END_CASE]]></ST></Implementation>
    </Method>
    <Method Name="Bounce_shorter_than_debounce_never_reaches_Value" Id="{54e7defe-927f-4907-bb86-4965b8526578}">
      <Declaration><![CDATA[METHOD Bounce_shorter_than_debounce_never_reaches_Value]]></Declaration>
      <Implementation><ST><![CDATA[// A contact chattering every scan for several DebounceTimes: each return to the
// published value restarts the timer, so no single excursion is ever long enough.
TEST('Bounce_shorter_than_debounce_never_reaches_Value');
IF NOT _bounceStarted THEN
    _bounceSince := TIME();
    _bounceStarted := TRUE;
END_IF
IF TIME() - _bounceSince < T#500MS THEN
    _bouncyHal.Value := NOT _bouncyHal.Value;
    _bouncy();
    _bounceSeen := _bounceSeen OR _bouncy.OutImm.Value;
ELSE
    AssertFalse(Condition := _bounceSeen,
        Message := 'a chatter shorter than DebounceTime never reaches Value');
    AssertTrue(Condition := _bouncy.OutImm.Quality, Message := 'chatter is not a quality fault');
    TEST_FINISHED();
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="Bad_quality_forces_false_and_restarts_the_timer" Id="{e98e9cd3-d3cc-4a36-a017-14a8de431273}">
      <Declaration><![CDATA[METHOD Bad_quality_forces_false_and_restarts_the_timer]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Bad_quality_forces_false_and_restarts_the_timer');
IF _lossStep = 99 THEN
    RETURN;
END_IF
_tLoss(IN := TRUE, PT := TEST_TIMEOUT);
IF _tLoss.Q THEN
    AssertTrue(Condition := FALSE, Message := CONCAT('timed out in step ', INT_TO_STRING(_lossStep)));
    _lossStep := 99;
    TEST_FINISHED();
    RETURN;
END_IF
CASE _lossStep OF
    0:
        _lossyHal.Value := TRUE;
        _lossy();
        IF _lossy.OutImm.Value THEN
            _lossyHal.Quality := FALSE;
            _lossy();
            AssertFalse(Condition := _lossy.OutImm.Value,
                Message := 'bad quality forces Value FALSE in the same scan');
            AssertFalse(Condition := _lossy.OutImm.Quality, Message := 'and is published as bad');
            _lossyHal.Quality := TRUE;
            _lossSince := TIME();
            _lossy();
            AssertFalse(Condition := _lossy.OutImm.Value,
                Message := 'returning quality does not restore the old Value: it is timed afresh');
            _lossStep := 1;
        END_IF
    1:
        _lossy();
        IF _lossy.OutImm.Value THEN
            AssertTrue(Condition := TIME() - _lossSince >= T#50MS,
                Message := 'Value came back only after DebounceTime of good quality');
            _lossStep := 99;
            TEST_FINISHED();
        END_IF
ELSE
    _lossStep := 99;
    TEST_FINISHED();
END_CASE]]></ST></Implementation>
    </Method>
    <Method Name="Oversized_debounce_or_wrong_schema_publishes_invalid" Id="{4e3b1b22-3afd-476b-93f1-60256c9479d6}">
      <Declaration><![CDATA[METHOD Oversized_debounce_or_wrong_schema_publishes_invalid]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Oversized_debounce_or_wrong_schema_publishes_invalid');
IF _badDone THEN
    RETURN;
END_IF
AssertFalse(Condition := _badSetup, Message := 'Setup refuses a debounce above DI_DEBOUNCE_MAX');
_badHal.Value := TRUE;
_bad();
AssertFalse(Condition := _bad.OutImm.Quality, Message := 'an oversized debounce publishes an invalid input');
AssertFalse(Condition := _bad.OutImm.Value, Message := 'never a silently slow one');
_bad.ParCfg.DebounceTime := T#0MS;
_bad.ParCfg.SchemaVersion := 1;
_bad();
AssertFalse(Condition := _bad.OutImm.Quality, Message := 'a ParCfg of another layout is refused, not interpreted');
_bad.ParCfg.SchemaVersion := 2;
_bad();
AssertTrue(Condition := _bad.OutImm.Quality AND _bad.OutImm.Value,
    Message := 'a corrected ParCfg is honoured from the next scan');
_badDone := TRUE;
TEST_FINISHED();]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
