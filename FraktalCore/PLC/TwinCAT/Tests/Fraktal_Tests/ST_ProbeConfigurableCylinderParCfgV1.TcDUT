<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ProbeConfigurableCylinderParCfgV1" Id="{18f5d937-2a43-477f-b304-64b769f58fd7}">
    <Declaration><![CDATA[// ST_ConfigurableCylinderParCfg as Modules 0.14 and earlier stored it (v1): the
// record an upgraded station's recipe store still holds, which v2 must refuse (§3.8).
TYPE ST_ProbeConfigurableCylinderParCfgV1 :
STRUCT
    SchemaVersion     : UINT := 1;
    HomeSensorCount   : INT := 1;
    WorkSensorCount   : INT := 1;
    MoveTimeout       : TIME := T#5S;
    SettleTime        : TIME := T#30MS;
    TravelTime        : TIME := T#1S;
    DiscrepancyTime   : TIME := T#500MS;
    SingleActing      : BOOL := FALSE;
    SafePosOnAbort    : E_CylinderPosition := E_CylinderPosition.HOME;
    DeenergizeOnAbort : BOOL := TRUE;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
