<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_RobotConnector_Tests" Id="{dc5e0fca-eaee-44bb-a584-b0c619ee9c62}" SpecialFunc="None">
    <Declaration><![CDATA[// Annex I I.3/I.5 - the Staubli VAL3 connector over the SIM channel. No socket,
// no emulator, no arm: FB_SimByteChannel scripts request/reply pairs, so the wire
// protocol and every refusal path are provable in CI (S5.7, Annex H).
//
// This is the transport-layer half of the I.5c simulation requirement. The SRS
// Emulator remains the higher-fidelity layer for motion behaviour; what is proven
// here is the part that must hold before an emulator is worth starting: that the
// connector speaks the agreed frames, and that it REFUSES rather than pretends
// when the link is down, the mode is wrong, or the path was left.
//
// Linked means session up AND heartbeat healthy (Core §3.15.2), and the heartbeat
// is the TON-driven status poll, so every test that needs a live link runs ACROSS
// SCANS and scripts the STA reply the heartbeat asks for.
FUNCTION_BLOCK FB_RobotConnector_Tests EXTENDS TcUnit.FB_TestSuite
VAR
    _chan  : FB_SimByteChannel;
    _conn  : FB_StaubliVal3Connector;
    _chanB : FB_SimByteChannel;
    _connB : FB_StaubliVal3Connector;
    _chanC : FB_SimByteChannel;
    _connC : FB_StaubliVal3Connector;
    _chanD : FB_SimByteChannel;
    _connD : FB_StaubliVal3Connector;
    _ok    : BOOL;
    _i, _i2, _i4 : INT;
    _diag  : ST_Diagnostic;   // C0185: cannot access .member on a property result
    _pose  : ST_RobotPose;
    _w1, _w2, _w3, _w4, _w5, _w6 : BOOL;
    _sent2, _sent4 : BOOL;
    _chanE : FB_SimByteChannel;  _connE : FB_StaubliVal3Connector;  _iE : INT;  _wE : BOOL;
    _chanF : FB_SimByteChannel;  _connF : FB_StaubliVal3Connector;  _iF : INT;  _wF, _sentF : BOOL;
    _chanG : FB_SimByteChannel;  _connG : FB_StaubliVal3Connector;  _iG : INT;  _wG, _sentG : BOOL;
    _chanH : FB_SimByteChannel;  _connH : FB_StaubliVal3Connector;  _iH : INT;  _wH : BOOL;  _capsH : ST_RobotCapabilities;
    _chanI : FB_SimByteChannel;  _connI : FB_StaubliVal3Connector;  _iI : INT;  _wI, _sentI : BOOL;  _capsI : ST_RobotCapabilities;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Link_down_refuses_every_command_rather_than_dropping_it();
Id_addressed_commands_are_framed_on_the_wire();
Status_poll_publishes_the_controllers_reported_facts();
Controller_error_is_carried_verbatim_and_faults();
Resume_is_refused_when_the_arm_left_the_retained_path();
Unknown_mode_request_is_refused_outright();
Status_reply_reports_arm_power_and_user_inputs();
User_outputs_ride_the_status_poll();
Speed_then_move_in_one_scan_both_reach_the_wire();
The_controllers_offer_is_asked_once_and_its_demands_decoded();
An_untaught_point_is_refused_with_its_own_reason_and_an_unanswered_offer_filters_nothing();]]></ST>
    </Implementation>
      <Method Name="Link_down_refuses_every_command_rather_than_dropping_it" Id="{ce24fe50-b1bd-4599-ac24-7c1223c8a3f1}">
        <Declaration><![CDATA[METHOD PRIVATE Link_down_refuses_every_command_rather_than_dropping_it]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Link_down_refuses_every_command_rather_than_dropping_it');
IF NOT _w1 THEN
    // Deliberately never set up or connected: there is no session.
    // A command issued now must come back FALSE. Silently queueing it would let a
    // sequence wait on a robot that never heard the command (Annex D).
    AssertFalse(Condition := _connB.PowerOn(),
        Message := 'a command on a down link is refused, not queued');
    AssertFalse(Condition := _connB.MoveToPoint(PointId := 7),
        Message := 'and so is an ID-addressed move');
    AssertFalse(Condition := _connB.Linked,
        Message := 'Linked reports the link honestly');
    _diag := _connB.LastResult;
    AssertEquals_DINT(Expected := E_Reason.LINK_TIMEOUT, Actual := _diag.ReasonCode,
        Message := 'the refusal carries the link reason for the CM to adopt');
    _w1 := TRUE;
END_IF
TEST_FINISHED();]]></ST>
        </Implementation>
      </Method>
      <Method Name="Id_addressed_commands_are_framed_on_the_wire" Id="{7d6065f0-81a1-434b-a53e-2d75346f7635}">
        <Declaration><![CDATA[METHOD PRIVATE Id_addressed_commands_are_framed_on_the_wire]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Id_addressed_commands_are_framed_on_the_wire');
IF _w2 THEN
    TEST_FINISHED();
    RETURN;
END_IF
IF _i2 = 0 THEN
    // The channel only replies when the sent line matches EXACTLY, so a reply
    // proves the frame. Every argument is an identifier - never a coordinate (I.1).
    _chan.Script(Expect := 'STA$R', Reply := 'STA,OK,0,1,AUTO,4,0,1,0,0,0,0,0,0$R');
    _chan.Script(Expect := 'CAP$R', Reply := 'CAP,OK,262142,7,8$R');
    _chan.Script(Expect := 'TPL,11,22$R', Reply := 'TPL,OK$R');
    _conn.SetupLink(Name := 'Test.Robot', Chan := _chan, DevHost := '10.0.0.20', DevPort := 11000);
    _conn.Connect();
END_IF
_conn.Cyclic();
_i2 := _i2 + 1;
IF _conn.Linked AND NOT _sent2 THEN
    AssertTrue(Condition := _conn.MoveTemplate(FromPosId := 11, ToPosId := 22),
        Message := 'a routed move is accepted and framed as TPL,from,to');
    _sent2 := TRUE;
ELSIF _sent2 AND (_conn.LastResponse = 'TPL,OK') THEN
    AssertEquals_STRING(Expected := 'TPL,OK', Actual := _conn.LastResponse,
        Message := 'and the controller acknowledgement is published');
    _w2 := TRUE;
    TEST_FINISHED();
ELSIF _i2 > 1000 THEN
    AssertTrue(Condition := FALSE,
        Message := 'the link never came up, or the framed move was never acknowledged');
    _w2 := TRUE;
    TEST_FINISHED();
END_IF]]></ST>
        </Implementation>
      </Method>
      <Method Name="Status_poll_publishes_the_controllers_reported_facts" Id="{fa78ee37-e9e9-4f21-b601-5281d6c921be}">
        <Declaration><![CDATA[METHOD PRIVATE Status_poll_publishes_the_controllers_reported_facts]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Status_poll_publishes_the_controllers_reported_facts');
// The poll is the TON-driven heartbeat, so this test must run ACROSS SCANS - a loop
// of Cyclic() calls inside one scan advances no time and the timer never fires.
// Same shape as FB_TcpDev_Tests.Timeout_faults_10402, for the same reason.
IF _w3 THEN
    TEST_FINISHED();
    RETURN;
END_IF
IF _i = 0 THEN
    // STA,OK,busy,ref,mode,area,prot,resumable,x,y,z,rx,ry,rz
    _chanC.Script(Expect := 'CAP$R', Reply := 'CAP,OK,262142,7,8$R');
    _chanC.Script(Expect := 'STA$R',
        Reply := 'STA,OK,0,1,AUTO,4,0,1,100.5,200,300,0,0,90$R');
    _connC.SetupLink(Name := 'Test.RobotC', Chan := _chanC, DevHost := '10.0.0.21', DevPort := 11000);
    _connC.Connect();
END_IF
_connC.Cyclic();
_i := _i + 1;

IF _connC.Referenced THEN
    // Referenced only becomes TRUE once a status reply was parsed, so reaching
    // here proves the heartbeat fired, framed STA, and the reply was decoded.
    AssertTrue(Condition := _connC.Linked,
        Message := 'an answered status poll is a healthy heartbeat: the link is up');
    AssertTrue(Condition := _connC.ActualMode = E_RobotOpMode.AUTO_REMOTE,
        Message := 'ActualMode is what the controller REPORTS, not what we asked for');
    AssertEquals_DWORD(Expected := 4, Actual := _connC.CurrentArea,
        Message := 'the planning area is published for area-resolved motion');
    AssertFalse(Condition := _connC.ProtectiveStop,
        Message := 'the protective stop is published separately from S9 safety');
    _pose := _connC.ActualPosition;
    AssertEquals_LREAL(Expected := 100.5, Actual := _pose.X, Delta := 0.001,
        Message := 'the live pose is readable for display and diagnostics');
    AssertEquals_LREAL(Expected := 90, Actual := _pose.RZ, Delta := 0.001,
        Message := 'including orientation');
    // Jogging is bounded by the CONTROLLER's mode, not by a PLC release alone.
    // Asserted here because this is where a LINKED connector reporting AUTO
    // exists - proving the refusal comes from the mode gate and not the link.
    AssertFalse(Condition := _connC.Jog(Mode := E_RobotJogMode.JOINT, Axis := 1, Dir := 1),
        Message := 'jogging is refused while the controller reports auto');
    _w3 := TRUE;
    TEST_FINISHED();
ELSIF _i > 1000 THEN
    // Bounded so a regression fails loudly here instead of hanging the runner
    // with no message, which is the worse failure.
    AssertTrue(Condition := FALSE,
        Message := 'the status poll never delivered a reply');
    _w3 := TRUE;
    TEST_FINISHED();
END_IF]]></ST>
        </Implementation>
      </Method>
      <Method Name="Controller_error_is_carried_verbatim_and_faults" Id="{6b3683ef-43c0-4588-8bb8-8cc304187f2f}">
        <Declaration><![CDATA[METHOD PRIVATE Controller_error_is_carried_verbatim_and_faults]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Controller_error_is_carried_verbatim_and_faults');
IF _w4 THEN
    TEST_FINISHED();
    RETURN;
END_IF
IF _i4 = 0 THEN
    _chanD.Script(Expect := 'STA$R', Reply := 'STA,OK,0,0,AUTO,0,0,0,0,0,0,0,0,0$R');
    _chanD.Script(Expect := 'CAP$R', Reply := 'CAP,OK,262142,7,8$R');
    _chanD.Script(Expect := 'HOME$R', Reply := 'HOME,ERR,J12,joint 3 out of range$R');
    _connD.SetupLink(Name := 'Test.RobotD', Chan := _chanD, DevHost := '10.0.0.22', DevPort := 11000);
    _connD.Connect();
END_IF
_connD.Cyclic();
_i4 := _i4 + 1;
_diag := _connD.ControllerMessage;
IF _connD.Linked AND NOT _sent4 THEN
    AssertTrue(Condition := _connD.Home(), Message := 'the request is accepted by the transport');
    _sent4 := TRUE;
ELSIF _sent4 AND (_diag.ReasonCode = PL_ModuleReasons.ROBOT_CONTROLLER_FAULT) THEN
    // The robot's OWN text survives. Paraphrasing it would cost the technician the
    // one string that identifies the fault on the pendant (S8.2).
    AssertTrue(Condition := FIND(_diag.Description, 'joint 3 out of range') > 0,
        Message := 'the controller message is carried verbatim');
    _diag := _connD.LastResult;
    AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_CONTROLLER_FAULT,
        Actual := _diag.ReasonCode,
        Message := 'and it is the refusal the robot CM adopts as its first-out');
    AssertFalse(Condition := _connD.MotionBusy,
        Message := 'a refused command does not leave the connector claiming motion');
    _w4 := TRUE;
    TEST_FINISHED();
ELSIF _i4 > 1000 THEN
    AssertTrue(Condition := FALSE,
        Message := 'the controller error never arrived');
    _w4 := TRUE;
    TEST_FINISHED();
END_IF]]></ST>
        </Implementation>
      </Method>
      <Method Name="Resume_is_refused_when_the_arm_left_the_retained_path" Id="{b4d21257-73b9-41d0-b9fd-e98a9902a534}">
        <Declaration><![CDATA[METHOD PRIVATE Resume_is_refused_when_the_arm_left_the_retained_path]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Resume_is_refused_when_the_arm_left_the_retained_path');
IF NOT _w5 THEN
    // Resumable=0 in the status reply. A hold is exactly when an operator jogs the
    // arm, and resuming onto a path the tool has left is how a robot drives through
    // a fixture - so this must refuse rather than execute (I.4b).
    AssertFalse(Condition := _connD.Resumable,
        Message := 'the connector reports resumption invalid by default');
    AssertFalse(Condition := _connD.Resume(),
        Message := 'and Resume is refused rather than sent');
    _w5 := TRUE;
END_IF
TEST_FINISHED();]]></ST>
        </Implementation>
      </Method>
      <Method Name="Unknown_mode_request_is_refused_outright" Id="{1558bc16-a131-4003-9497-4383dd2e5e51}">
        <Declaration><![CDATA[METHOD PRIVATE Unknown_mode_request_is_refused_outright]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Unknown_mode_request_is_refused_outright');
IF NOT _w6 THEN
    // Requesting UNKNOWN is meaningless and must never reach the controller: an
    // uninitialised or unparsed mode must not travel as though it were a real
    // request. Self-contained on purpose - the previous version asserted a
    // precondition owned by another test, so one root cause failed two tests.
    AssertFalse(Condition := _connB.RequestMode(Mode := E_RobotOpMode.UNKNOWN),
        Message := 'an UNKNOWN mode request is refused before the transport');
    _w6 := TRUE;
END_IF
TEST_FINISHED();]]></ST>
        </Implementation>
      </Method>
      <Method Name="Status_reply_reports_arm_power_and_user_inputs" Id="{de7cf857-f37b-4dc1-b66a-d4a2a93fc47b}">
        <Declaration><![CDATA[METHOD PRIVATE Status_reply_reports_arm_power_and_user_inputs]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Status_reply_reports_arm_power_and_user_inputs');
IF _wE THEN
    RETURN;
END_IF
IF _iE = 0 THEN
    // ...,<rz>,<power>,<pathIdx>,<due>,<in1>,<in2>: the appended fields.
    _chanE.Script(Expect := 'STA$R', Reply := 'STA,OK,0,1,AUTO,4,0,1,0,0,0,0,0,0,1,3,0,7,42$R');
    _chanE.Script(Expect := 'CAP$R', Reply := 'CAP,OK,262142,7,8$R');
    _connE.SetupLink(Name := 'Test.RobotE', Chan := _chanE, DevHost := '10.0.0.23', DevPort := 11000);
    _connE.Connect();
END_IF
_connE.Cyclic();
_iE := _iE + 1;
IF _connE.Referenced THEN
    AssertTrue(Condition := _connE.ArmPowerOn, Message := 'the reported drive power is published');
    AssertEquals_DINT(Expected := 3, Actual := _connE.PathIndex, Message := 'and how far the path got');
    AssertEquals_LREAL(Expected := 7.0, Actual := _connE.UserSignal(Index := 1), Delta := 0.0001,
        Message := 'user input 1 is the first appended value');
    AssertEquals_LREAL(Expected := 42.0, Actual := _connE.UserSignal(Index := 2), Delta := 0.0001,
        Message := 'user input 2 the second');
    AssertEquals_LREAL(Expected := 0.0, Actual := _connE.UserSignal(Index := 3), Delta := 0.0001,
        Message := 'an absent field reads 0');
    _wE := TRUE;
    TEST_FINISHED();
ELSIF _iE > 3000 THEN
    AssertTrue(Condition := FALSE, Message := 'the status reply never arrived');
    _wE := TRUE;
    TEST_FINISHED();
END_IF]]></ST>
        </Implementation>
      </Method>
      <Method Name="User_outputs_ride_the_status_poll" Id="{c6065944-e1e4-4186-ba50-1a3cf898f9d6}">
        <Declaration><![CDATA[METHOD PRIVATE User_outputs_ride_the_status_poll]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('User_outputs_ride_the_status_poll');
IF _wF THEN
    RETURN;
END_IF
IF _iF = 0 THEN
    // Only the poll that carries the two outputs is answered with user input 9,
    // so seeing 9 proves the frame STA,1,42 went out.
    _chanF.Script(Expect := 'STA$R', Reply := 'STA,OK,0,1,AUTO,4,0,1,0,0,0,0,0,0,0$R');
    _chanF.Script(Expect := 'STA,1,42$R', Reply := 'STA,OK,0,1,AUTO,4,0,1,0,0,0,0,0,0,1,-1,0,9$R');
    _chanF.Script(Expect := 'CAP$R', Reply := 'CAP,OK,262142,7,8$R');
    _connF.SetupLink(Name := 'Test.RobotF', Chan := _chanF, DevHost := '10.0.0.24', DevPort := 11000);
    _connF.Connect();
END_IF
_connF.Cyclic();
_iF := _iF + 1;
IF _connF.Linked AND NOT _sentF THEN
    AssertTrue(Condition := _connF.WriteUserSignal(Index := 1, Value := 1.0), Message := 'output 1 is accepted');
    AssertTrue(Condition := _connF.WriteUserSignal(Index := 2, Value := 42.0), Message := 'output 2 is accepted');
    AssertFalse(Condition := _connF.WriteUserSignal(Index := 0, Value := 1.0), Message := 'index 0 is refused');
    _sentF := TRUE;
ELSIF _sentF AND (_connF.UserSignal(Index := 1) = 9.0) THEN
    AssertTrue(Condition := _connF.ArmPowerOn, Message := 'the poll carrying the outputs was answered');
    AssertEquals_DINT(Expected := -1, Actual := _connF.PathIndex, Message := 'no path progress reads -1');
    _wF := TRUE;
    TEST_FINISHED();
ELSIF _iF > 3000 THEN
    AssertTrue(Condition := FALSE, Message := 'the outputs never travelled with the status poll');
    _wF := TRUE;
    TEST_FINISHED();
END_IF]]></ST>
        </Implementation>
      </Method>
      <Method Name="Speed_then_move_in_one_scan_both_reach_the_wire" Id="{ce85a377-66d6-4446-8bf6-57caa0062906}">
        <Declaration><![CDATA[METHOD PRIVATE Speed_then_move_in_one_scan_both_reach_the_wire]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('Speed_then_move_in_one_scan_both_reach_the_wire');
IF _wG THEN
    RETURN;
END_IF
IF _iG = 0 THEN
    // The CM sends the speed and the move in the same scan, and the link-up CAP
    // question (or a status poll) may hold the slot at that very scan. Both must
    // WAIT, not be refused as a lost link.
    _chanG.Script(Expect := 'STA$R', Reply := 'STA,OK,0,1,AUTO,4,0,1,0,0,0,0,0,0,1$R');
    _chanG.Script(Expect := 'CAP$R', Reply := 'CAP,OK,262142,7,8$R');
    _chanG.Script(Expect := 'SPD,50$R', Reply := 'SPD,OK$R');
    _chanG.Script(Expect := 'MOV,5$R', Reply := 'MOV,OK$R');
    _connG.SetupLink(Name := 'Test.RobotG', Chan := _chanG, DevHost := '10.0.0.25', DevPort := 11000);
    _connG.Connect();
END_IF
_connG.Cyclic();
_iG := _iG + 1;
IF _connG.Linked AND NOT _sentG THEN
    AssertTrue(Condition := _connG.SetSpeedScale(Percent := 50.0), Message := 'the speed is accepted');
    AssertTrue(Condition := _connG.MoveToPoint(PointId := 5), Message := 'and the move behind it is accepted, not refused');
    _diag := _connG.LastResult;
    AssertEquals_DINT(Expected := E_Reason.NONE, Actual := _diag.ReasonCode,
        Message := 'with no reason against it');
    _sentG := TRUE;
ELSIF _sentG AND (_connG.LastResponse = 'MOV,OK') THEN
    _wG := TRUE;
    TEST_FINISHED();
ELSIF _iG > 3000 THEN
    AssertTrue(Condition := FALSE, Message := 'the queued move never reached the wire');
    _wG := TRUE;
    TEST_FINISHED();
END_IF]]></ST>
        </Implementation>
      </Method>
      <Method Name="The_controllers_offer_is_asked_once_and_its_demands_decoded" Id="{7007397d-e287-4fa9-8d47-06036e83040f}">
        <Declaration><![CDATA[METHOD PRIVATE The_controllers_offer_is_asked_once_and_its_demands_decoded]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('The_controllers_offer_is_asked_once_and_its_demands_decoded');
IF _wH THEN
    RETURN;
END_IF
IF _iH = 0 THEN
    // ...,<power>,<pathIdx>,<due>,<in1>: both routines asked for, input 1 = 5.
    _chanH.Script(Expect := 'STA$R', Reply := 'STA,OK,0,1,AUTO,4,0,1,0,0,0,0,0,0,1,-1,3,5$R');
    _chanH.Script(Expect := 'CAP$R', Reply := 'CAP,OK,40958,6,4$R');
    _connH.SetupLink(Name := 'Test.RobotH', Chan := _chanH, DevHost := '10.0.0.26', DevPort := 11000);
    _connH.Connect();
END_IF
_connH.Cyclic();
_iH := _iH + 1;
_capsH := _connH.Capabilities;
IF _capsH.Reported THEN
    AssertEquals_DWORD(Expected := 40958, Actual := TO_DWORD(_capsH.Commands), Message := 'the offered commands, as sent');
    AssertEquals_INT(Expected := 6, Actual := _capsH.JogAxes, Message := 'the jog axes');
    AssertEquals_INT(Expected := 4, Actual := _capsH.UserSignals, Message := 'the user-signal slots');
    AssertTrue(Condition := _connH.BrakeTestDue, Message := 'due bit 1 is the brake test');
    AssertTrue(Condition := _connH.SafeReferenceDue, Message := 'due bit 2 the safe reference run');
    AssertEquals_LREAL(Expected := 5.0, Actual := _connH.UserSignal(Index := 1), Delta := 0.0001,
        Message := 'and the user inputs follow the due field');
    _diag := _connH.LastResult;
    AssertEquals_DINT(Expected := E_Reason.NONE, Actual := _diag.ReasonCode,
        Message := 'asking is housekeeping: it leaves no reason behind');
    _wH := TRUE;
    TEST_FINISHED();
ELSIF _iH > 3000 THEN
    AssertTrue(Condition := FALSE, Message := 'the controller was never asked what it offers');
    _wH := TRUE;
    TEST_FINISHED();
END_IF]]></ST>
        </Implementation>
      </Method>
      <Method Name="An_untaught_point_is_refused_with_its_own_reason_and_an_unanswered_offer_filters_nothing" Id="{fd3d6da8-f2c2-4b22-9b07-218412b75d1f}">
        <Declaration><![CDATA[METHOD PRIVATE An_untaught_point_is_refused_with_its_own_reason_and_an_unanswered_offer_filters_nothing]]></Declaration>
        <Implementation>
          <ST><![CDATA[TEST('An_untaught_point_is_refused_with_its_own_reason_and_an_unanswered_offer_filters_nothing');
IF _wI THEN
    RETURN;
END_IF
IF _iI = 0 THEN
    // A server that predates CAP refuses it; the move is refused as untaught.
    _chanI.Script(Expect := 'STA$R', Reply := 'STA,OK,0,1,AUTO,4,0,1,0,0,0,0,0,0,1$R');
    _chanI.Script(Expect := 'CAP$R', Reply := 'CAP,ERR,E01,unknown request$R');
    _chanI.Script(Expect := 'MOV,42$R', Reply := 'MOV,ERR,UNKNOWN_ID,point 42 not taught$R');
    _connI.SetupLink(Name := 'Test.RobotI', Chan := _chanI, DevHost := '10.0.0.27', DevPort := 11000);
    _connI.Connect();
END_IF
_connI.Cyclic();
_iI := _iI + 1;
_diag := _connI.LastResult;
IF _connI.Linked AND NOT _sentI THEN
    AssertTrue(Condition := _connI.MoveToPoint(PointId := 42), Message := 'the move is sent');
    _sentI := TRUE;
ELSIF _sentI AND (_diag.ReasonCode <> E_Reason.NONE) THEN
    AssertEquals_DINT(Expected := PL_ModuleReasons.ROBOT_POINT_UNKNOWN, Actual := _diag.ReasonCode,
        Message := 'an untaught point carries its own reason, not a generic controller fault');
    AssertEquals_STRING(Expected := 'UNKNOWN_ID point 42 not taught', Actual := _diag.Description,
        Message := 'with the controller$'s own text');
    _capsI := _connI.Capabilities;
    AssertFalse(Condition := _capsI.Reported, Message := 'a refused CAP leaves the offer unreported');
    _wI := TRUE;
    TEST_FINISHED();
ELSIF _iI > 3000 THEN
    AssertTrue(Condition := FALSE, Message := 'the controller$'s refusal never arrived');
    _wI := TRUE;
    TEST_FINISHED();
END_IF]]></ST>
        </Implementation>
      </Method>
  </POU>
</TcPlcObject>
