<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Hmi_Tests" Id="{ddeeaa5c-8a07-48ff-a3b7-d25994435712}" SpecialFunc="None">
    <Declaration><![CDATA[// §3.10(a') under test: the data mirror IS the HMI contract — proven once.
FUNCTION_BLOCK FB_Hmi_Tests EXTENDS TcUnit.FB_TestSuite
VAR
    _p : FB_ProbeCM;
    _u : FB_ProbeUnit;
    _invalidNokUnit : FB_ProbeUnit;
    _mailboxUnit : FB_ProbeUnit;
    _mailboxInit : BOOL;
    _policyUnit : FB_ProbeUnit;
    _policyInit : BOOL;
    _policyProvider : FB_LocalAccessProvider;
    _w : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Status_mirror_carries_name_state_and_diag();
Unit_publishes_counters_and_history();
Nameplate_roundtrip();
Mailbox_commits_once_and_acknowledges();
Mailbox_policy_is_self_gated_and_power_ack_is_authoritative();]]></ST>
    </Implementation>
    <Method Name="Status_mirror_carries_name_state_and_diag" Id="{9f585fa2-c3b4-4a24-bbb7-c7f5aa8b5400}">
      <Declaration><![CDATA[METHOD Status_mirror_carries_name_state_and_diag]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Status_mirror_carries_name_state_and_diag');
IF NOT _w THEN
    _p.Setup('Test.Mirror');
    _u.Setup('Test.MirrorUnit');
    _invalidNokUnit.Setup('Test.InvalidNokUnit');
    _w := TRUE;
END_IF
AssertEquals_STRING(Expected := 'Test.Mirror', Actual := _p.Status.Name,
                    Message := 'mirror carries the browse name (3.10a$')');
_p.Execute := TRUE;
_p.SimFault := TRUE;
_p();
AssertEquals_DINT(Expected := TO_DINT(E_ExecState.ERROR),
                  Actual   := TO_DINT(_p.Status.State),
                  Message  := 'mirror state follows ExecState');
AssertEquals_DWORD(Expected := TO_DWORD(E_Reason.TEST_FAULT),
                   Actual   := TO_DWORD(_p.Status.Diagnostic.ReasonCode),
                   Message  := 'live diagnostic published as DATA (6.9a)');
AssertEquals_DINT(Expected := TO_DINT(E_Severity.LOW),
    Actual := TO_DINT(_p.Status.Diagnostic.Severity),
    Message := 'diagnostic uses the generated reason priority at its source');
AssertEquals_DINT(Expected := TO_DINT(E_Category.SYSTEM),
    Actual := TO_DINT(_p.Status.Diagnostic.Category),
    Message := 'diagnostic uses the generated reason category at its source');
AssertTrue(Condition := _p.Status.FaultActive, Message := 'mirror fault flag');
_p.Execute := FALSE;
_p.SimFault := FALSE;
_p();
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unit_publishes_counters_and_history" Id="{eed4b529-88a1-44ba-8b75-cb092ce86590}">
      <Declaration><![CDATA[METHOD Unit_publishes_counters_and_history]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Unit_publishes_counters_and_history');
AssertFalse(Condition := _invalidNokUnit.CountNok(Reason := E_Reason.NONE),
    Message := 'unattributed NOK rejected');
AssertEquals_UDINT(Expected := 0, Actual := _invalidNokUnit.NokCount,
    Message := 'rejected NOK does not alter KPI');
AssertEquals_INT(Expected := 0, Actual := _invalidNokUnit.HostEvents.Count,
    Message := 'rejected NOK does not publish a host event');
_u.CountGood();
_u.CountGood();
AssertTrue(Condition := _u.CountNok(Reason := E_Reason.RESULT_RECORD_REJECTED),
    Message := 'attributed NOK accepted without optional carrier');
AssertEquals_UDINT(Expected := 2, Actual := _u.GoodCount, Message := 'good counter (8.11)');
AssertEquals_UDINT(Expected := 1, Actual := _u.NokCount,  Message := 'nok counter (8.11)');
AssertEquals_DINT(Expected := TO_DINT(E_HostEventKind.NOK),
    Actual := TO_DINT(_u.HostEvents.Ring[_u.HostEvents.RingHead].Kind),
    Message := 'NOK host event emitted without optional carrier (11.6)');
AssertEquals_DWORD(Expected := TO_DWORD(E_Reason.RESULT_RECORD_REJECTED),
    Actual := TO_DWORD(_u.HostEvents.Ring[_u.HostEvents.RingHead].ReasonCode),
    Message := 'NOK host event preserves first-out reason');
// stall pending surfaces on the mirror while no fault is active (6.9/3.10a')
AssertTrue(Condition := _u.Start(), Message := 'start');
_u();
_u();                                        // StallTime T#0S -> pending
AssertEquals_DWORD(Expected := TO_DWORD(E_Reason.STEP_STALLED),
                   Actual   := TO_DWORD(_u.Status.Diagnostic.ReasonCode),
                   Message  := 'pending stall visible on the data mirror');
_u.Stop();
_u.SimA := TRUE;
_u.SimB := TRUE;
_u();
_u();
_u();
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Nameplate_roundtrip" Id="{6746f045-8a15-4c5b-a8c9-e189dbcd69a1}">
      <Declaration><![CDATA[// §3.10.1: SetNameplate persists identity; published for the HMI facet card
METHOD Nameplate_roundtrip
VAR
    plate : ST_Nameplate;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Nameplate_roundtrip');
plate.ManufacturerName := 'ACME';
plate.SerialNumber := 'SN-1';
_p.SetNameplate(Plate := plate);
AssertEquals_STRING(Expected := 'ACME', Actual := _p.Nameplate.ManufacturerName, Message := 'manufacturer persists');
AssertEquals_STRING(Expected := 'SN-1', Actual := _p.Nameplate.SerialNumber, Message := 'serial persists');
TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Mailbox_commits_once_and_acknowledges" Id="{cc495ad9-bbd4-4bba-a9a6-b1ca9fb06551}">
      <Declaration><![CDATA[// §3.10(a″): arguments are sampled only when Sequence changes; Ack is last.
METHOD Mailbox_commits_once_and_acknowledges]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Mailbox_commits_once_and_acknowledges');
IF NOT _mailboxInit THEN
    _mailboxUnit.Setup('Test.MailboxUnit');
    _mailboxInit := TRUE;
ELSE
    _mailboxInit := _mailboxInit;
END_IF
_mailboxUnit.HmiRequest.Kind := E_HmiRequestKind.SET_MODE;
_mailboxUnit.HmiRequest.IntValue := TO_DINT(E_Mode.MANUAL);
_mailboxUnit.HmiRequest.Sequence := 1;
_mailboxUnit();
AssertEquals_UDINT(Expected := 1, Actual := _mailboxUnit.HmiResponse.AckSequence,
    Message := 'committed sequence acknowledged');
AssertTrue(Condition := _mailboxUnit.HmiResponse.Accepted,
    Message := 'existing gated SetMode path accepted');
AssertEquals_DINT(Expected := TO_DINT(E_Mode.MANUAL),
    Actual := TO_DINT(_mailboxUnit.ModeActivePublished),
    Message := 'property-only mode is published as OPC UA data');

// Change arguments without changing Sequence: the transaction shall not replay.
_mailboxUnit.HmiRequest.IntValue := TO_DINT(E_Mode.AUTO);
_mailboxUnit();
AssertEquals_DINT(Expected := TO_DINT(E_Mode.MANUAL),
    Actual := TO_DINT(_mailboxUnit.ModeActivePublished),
    Message := 'unchanged sequence is ignored');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
    <Method Name="Mailbox_policy_is_self_gated_and_power_ack_is_authoritative" Id="{54b24bf9-e093-483c-a1d4-2942ee2f04b1}">
      <Declaration><![CDATA[METHOD Mailbox_policy_is_self_gated_and_power_ack_is_authoritative]]></Declaration>
      <Implementation><ST><![CDATA[TEST('Mailbox_policy_is_self_gated_and_power_ack_is_authoritative');
IF NOT _policyInit THEN
    _policyUnit.Setup('Test.PolicyMailboxUnit');
    _policyProvider.Register(User := 'admin1', Pin := '4711',
        Level := E_AccessLevel.ADMIN);
    _policyUnit();
    _policyUnit.Access.Setup(Provider := _policyProvider,
        pAlarmLog := ADR(_policyUnit.AlarmLog));
    // Policy is intentionally PERSISTENT. Commission every entry this repeatable
    // fixture observes so a previous successful run cannot become its precondition.
    _policyUnit.Access.ConfigureRequired(Gate := E_GatedAction.ACCESS_POLICY,
        Level := E_AccessLevel.NONE);
    _policyUnit.Access.ConfigureRequired(Gate := E_GatedAction.DATA_WRITE,
        Level := E_AccessLevel.NONE);
    _policyUnit.Access.ConfigureRequired(Gate := E_GatedAction.POWER_CONTROL,
        Level := E_AccessLevel.ADMIN);
    _policyInit := TRUE;
ELSE
    _policyInit := _policyInit;
END_IF

_policyUnit.HmiRequest.Kind := E_HmiRequestKind.CONTROL_ON;
_policyUnit.HmiRequest.Sequence := 1;
_policyUnit();
AssertFalse(Condition := _policyUnit.HmiResponse.Accepted,
    Message := 'control-power acknowledgement reflects PLC authorization');
AssertFalse(Condition := _policyUnit.ReqControlOn,
    Message := 'denied power request never latches');

_policyUnit.HmiRequest.Kind := E_HmiRequestKind.SET_ACCESS_LEVEL;
_policyUnit.HmiRequest.IntValue := TO_DINT(E_GatedAction.ACCESS_POLICY);
_policyUnit.HmiRequest.TextValue := '4';
_policyUnit.HmiRequest.Sequence := 2;
_policyUnit();
AssertFalse(Condition := _policyUnit.HmiResponse.Accepted,
    Message := 'anonymous session cannot raise ACCESS_POLICY above itself');
AssertEquals_DINT(Expected := TO_DINT(E_AccessLevel.NONE),
    Actual := TO_DINT(_policyUnit.Access.Policy.Required[TO_INT(E_GatedAction.ACCESS_POLICY)]),
    Message := 'self-lockout attempt leaves policy open');

_policyUnit.Access.RequestLogin(User := 'admin1', Secret := '4711');
_policyUnit();
_policyUnit.HmiRequest.Sequence := 3;
_policyUnit();
AssertTrue(Condition := _policyUnit.HmiResponse.Accepted,
    Message := 'authenticated admin may raise ACCESS_POLICY to ADMIN');
AssertEquals_DINT(Expected := TO_DINT(E_AccessLevel.ADMIN),
    Actual := TO_DINT(_policyUnit.Access.Policy.Required[TO_INT(E_GatedAction.ACCESS_POLICY)]),
    Message := 'ACCESS_POLICY threshold persisted');

_policyUnit.HmiRequest.IntValue := TO_DINT(E_GatedAction.DATA_WRITE);
_policyUnit.HmiRequest.TextValue := '2';
_policyUnit.Access.RequestLogout();
_policyUnit();
_policyUnit.HmiRequest.Sequence := 4;
_policyUnit();
AssertFalse(Condition := _policyUnit.HmiResponse.Accepted,
    Message := 'policy edits are self-gated after commissioning');
AssertEquals_DINT(Expected := TO_DINT(E_AccessLevel.NONE),
    Actual := TO_DINT(_policyUnit.Access.Policy.Required[TO_INT(E_GatedAction.DATA_WRITE)]),
    Message := 'denied edit leaves target threshold unchanged');
TEST_FINISHED();]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
