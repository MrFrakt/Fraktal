    <Description>Aggregate Fraktal Core + Modules + Press Demo TcUnit gate - excluded from deployed runtime (Core 5.7).</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- This manifest owns Fraktal_Tests\ and nothing else: every Compile path
         below is a plain downward path from Tests/.

         It deliberately does NOT link the press example. TwinCAT PLC Control
         rejects a raw Compile path containing '..' before it evaluates <Link>
         metadata ("'..' is not a valid folder name"), so a manifest sitting in
         Tests/ cannot reach Examples/. The two press-dependent suites
         (FB_PressDemoUnit_Tests, FB_FaultRecovery_Tests) therefore live in
         Examples/PressDemo/PressTests.plcproj, which reaches the press sources
         downward. Run both gates; neither is a subset of the other.

         The <Folder Include> list mirrors the Include directories, never any
         <Link> path: XAE materialises those entries as real directories on disk
         relative to this manifest, and a mismatch leaves phantom folders. -->
    <Compile Include="Fraktal_Tests\PlcTask.TcTTO">
      <Link>PlcTask.TcTTO</Link>
      <SubType>Code</SubType>
    </Compile>
    <!-- Project sources are linked, never copied: the aggregate gate tests the
         same application Unit, release logic, and native SFCs that are deployed. -->
    <Compile Include="Fraktal_Tests\FB_Access_Tests.TcPOU">
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="Fraktal_Tests\FB_AlarmLog_Tests.TcPOU">
      <SubType>Code</SubType>
    </Compile>
