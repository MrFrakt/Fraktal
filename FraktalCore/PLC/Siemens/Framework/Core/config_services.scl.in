// Keyed local-retain config. The typed owner validates before publishing a value.
FUNCTION "FRK_ConfigDataAllowed" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT Access : "FRK_Access"; ForWrite : Bool; Scope : String; END_VAR
VAR_TEMP Required : DInt; END_VAR
BEGIN
    #Required := "FRK_DataLevel"(Access := #Access, ClassId := "FRK_ConfigScratch".Entry.ClassId, Minimum := "FRK_ConfigScratch".MinRead, ForWrite := FALSE);
    IF #ForWrite THEN #Required := "FRK_DataLevel"(Access := #Access, ClassId := "FRK_ConfigScratch".Entry.ClassId, Minimum := "FRK_ConfigScratch".MinWrite, ForWrite := TRUE); END_IF;
    #FRK_ConfigDataAllowed := #Access.CurrentLevel >= #Required;
    IF #ForWrite AND NOT "FRK_DataPolicyReady"(Access := #Access) THEN #FRK_ConfigDataAllowed := FALSE; END_IF;
    IF NOT #FRK_ConfigDataAllowed THEN
        "FRK_ConfigScratch".AccessRejected := TRUE;
        "FRK_ConfigScratch".RequiredLevel := #Required;
        "FRK_ConfigScratch".RejectedScope := #Scope;
        "FRK_ConfigScratch".RejectedKey := "FRK_ConfigScratch".Entry.WriteKey;
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigAccessRefusal" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT Unit : "FRK_Unit"; Access : "FRK_Access"; END_VAR
VAR_IN_OUT Response : "ST_HmiResponse"; Persist : "ST_ConfigPersistStatus"; AlarmLog : "FRK_AlarmLog"; END_VAR
VAR_TEMP Text : WString[255]; END_VAR
BEGIN
    IF NOT #Unit.RequestPending OR #Response.Accepted OR NOT "FRK_ConfigScratch".AccessRejected THEN RETURN; END_IF;
    #Response.Diagnostic := WSTRING#'std.error.accessDenied';
    #Response.Report.Count := 0; #Response.Report.Released := TRUE;
    "FRK_ReleaseReason"(Report := #Response.Report, Description := #Response.Diagnostic, Reason := @E_Reason.PERMISSIVE_NOT_MET@, Path := STRING_TO_WSTRING("FRK_ConfigScratch".RejectedScope), Kind := @E_ReleaseKind.ACCESS@);
    #Persist.LastRejectScope := "FRK_ConfigScratch".RejectedScope;
    #Persist.LastRejectKey := "FRK_ConfigScratch".RejectedKey;
    #Text := CONCAT(IN1 := WSTRING#'std.audit.dataAccessDenied field=', IN2 := STRING_TO_WSTRING("FRK_ConfigScratch".RejectedKey));
    #Text := CONCAT(IN1 := #Text, IN2 := WSTRING#' required=');
    #Text := CONCAT(IN1 := #Text, IN2 := DINT_TO_WSTRING("FRK_ConfigScratch".RequiredLevel));
    "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #Access.CurrentUser, SourcePath := STRING_TO_WSTRING("FRK_ConfigScratch".RejectedScope));
END_FUNCTION

FUNCTION "FRK_ConfigWriteAudit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT Scope : String; Key : String; Value : WString; Captured : Bool; User : String; END_VAR
VAR_IN_OUT AlarmLog : "FRK_AlarmLog"; END_VAR
VAR_TEMP Prefix : WString[64]; Text : WString[255]; END_VAR
BEGIN
    IF #Captured THEN #Prefix := WSTRING#'std.audit.configCaptured field=';
    ELSE #Prefix := WSTRING#'std.audit.configWritten field='; END_IF;
    #Text := CONCAT(IN1 := #Prefix, IN2 := STRING_TO_WSTRING(#Key));
    // Preserve the full key/value/user: long entries use two adjacent audited
    // events from this same transaction instead of truncating accepted data.
    IF LEN(#Prefix) + LEN(#Key) + LEN(#Value) + LEN(#User) + 13 <= 255 THEN
        #Text := CONCAT(IN1 := #Text, IN2 := WSTRING#' value=');
        #Text := CONCAT(IN1 := #Text, IN2 := #Value);
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
    ELSE
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
        #Text := CONCAT(IN1 := WSTRING#'std.audit.configValue value=', IN2 := #Value);
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigDecode" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Text : WString;
    Storage : DInt;
    Minimum : LReal;
    Maximum : LReal;
    MaxLength : Int;
END_VAR
VAR_IN_OUT
    Value : "FRK_ConfigValue";
END_VAR
VAR_TEMP
    Index : Int;
    Width : Int;
    Negative : Bool;
    Magnitude : ULInt;
    Digit : ULInt;
    Decimal : LReal;
    Converted : Real;
    ConvertedOk : Bool;
END_VAR
BEGIN
    #FRK_ConfigDecode := FALSE;
    IF #Storage = @E_ConfigStorage.AS_STRING@ THEN
        IF LEN(#Text) > #MaxLength THEN RETURN; END_IF;
        #Value.Text := WSTRING_TO_STRING(#Text);
        IF STRING_TO_WSTRING(#Value.Text) <> #Text THEN RETURN; END_IF;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage = @E_ConfigStorage.AS_BOOL@ THEN
        IF #Text = WSTRING#'true' OR #Text = WSTRING#'TRUE' OR #Text = WSTRING#'1' THEN
            #Value.Flag := TRUE;
        ELSIF #Text = WSTRING#'false' OR #Text = WSTRING#'FALSE' OR #Text = WSTRING#'0' THEN
            #Value.Flag := FALSE;
        ELSE RETURN;
        END_IF;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage = @E_ConfigStorage.AS_REAL@ OR #Storage = @E_ConfigStorage.AS_LREAL@ THEN
        #ConvertedOk := "FRK_DecimalDecode"(Text := #Text,
            SinglePrecision := #Storage = @E_ConfigStorage.AS_REAL@, Value := #Decimal);
        IF NOT #ConvertedOk OR #Decimal < #Minimum OR #Decimal > #Maximum THEN RETURN; END_IF;
        IF #Storage = @E_ConfigStorage.AS_REAL@ THEN
            #Converted := LREAL_TO_REAL(#Decimal);
            IF #Converted = 0.0 AND #Decimal <> 0.0 THEN RETURN; END_IF;
            #Decimal := REAL_TO_LREAL(#Converted);
            IF #Decimal < #Minimum OR #Decimal > #Maximum THEN RETURN; END_IF;
        END_IF;
        #Value.Decimal := #Decimal;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage <> @E_ConfigStorage.AS_INT@ AND #Storage <> @E_ConfigStorage.AS_DINT@
        AND #Storage <> @E_ConfigStorage.AS_UDINT@ AND #Storage <> @E_ConfigStorage.AS_TIME@ THEN RETURN; END_IF;
    #Width := LEN(#Text);
    IF #Width = 0 THEN RETURN; END_IF;
    #Negative := FALSE;
    #Index := 1;
    IF #Text[1] = WCHAR#'-' THEN #Negative := TRUE; #Index := 2;
    ELSIF #Text[1] = WCHAR#'+' THEN #Index := 2;
    END_IF;
    IF #Index > #Width THEN RETURN; END_IF;
    #Magnitude := 0;
    WHILE #Index <= #Width DO
        IF #Text[#Index] < WCHAR#'0' OR #Text[#Index] > WCHAR#'9' THEN RETURN; END_IF;
        #Digit := UINT_TO_ULINT(WCHAR_TO_UINT(#Text[#Index]) - UINT#48);
        IF #Magnitude > (ULINT#4294967295 - #Digit) / ULINT#10 THEN RETURN; END_IF;
        #Magnitude := #Magnitude * ULINT#10 + #Digit;
        #Index := #Index + 1;
    END_WHILE;
    #Value.Number := ULINT_TO_LINT(#Magnitude);
    IF #Negative THEN #Value.Number := -#Value.Number; END_IF;
    IF LINT_TO_LREAL(#Value.Number) < #Minimum OR LINT_TO_LREAL(#Value.Number) > #Maximum THEN RETURN; END_IF;
    #FRK_ConfigDecode := TRUE;
END_FUNCTION

FUNCTION "FRK_ConfigEnumText" : WString
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Number : DInt;
END_VAR
BEGIN
    #FRK_ConfigEnumText := DINT_TO_WSTRING(#Number);
    IF #FRK_ConfigEnumText[1] = WCHAR#'+' THEN
        #FRK_ConfigEnumText := MID(IN := #FRK_ConfigEnumText, L := LEN(#FRK_ConfigEnumText) - 1, P := 2);
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigValidate" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Text : WString;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigValidate := "FRK_ConfigDecode"(Text := #Text,
        Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum,
        Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength,
        Value := "FRK_ConfigScratch".Value);
    IF NOT #FRK_ConfigValidate OR "FRK_ConfigScratch".EnumCount = 0 THEN RETURN; END_IF;
    #FRK_ConfigValidate := FALSE;
    FOR #Index := 1 TO "FRK_ConfigScratch".EnumCount DO
        IF "FRK_ConfigScratch".Value.Number = DINT_TO_LINT("FRK_ConfigScratch".EnumValues[#Index]) THEN
            #FRK_ConfigValidate := TRUE; RETURN;
        END_IF;
    END_FOR;
END_FUNCTION

FUNCTION "FRK_ConfigFind" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    Key : String;
    ModelCode : String;
END_VAR
VAR_TEMP
    Index : DInt;
END_VAR
BEGIN
    #FRK_ConfigFind := 0;
    FOR #Index := 1 TO @POOL_CAPACITY@ DO
        IF "FRK_ConfigStore".Rows[#Index].Used
            AND "FRK_ConfigStore".Rows[#Index].Record.Scope = #Scope
            AND "FRK_ConfigStore".Rows[#Index].Record.WriteKey = #Key
            AND "FRK_ConfigStore".Rows[#Index].ModelCode = #ModelCode THEN
            #FRK_ConfigFind := DINT_TO_INT(#Index);
            RETURN;
        END_IF;
    END_FOR;
END_FUNCTION

// Every accepted memory commit has one optional medium notification path.
FUNCTION "FRK_ConfigRecordValid" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT Scope : String; Record : "ST_ConfigRecord"; END_VAR
BEGIN
    #FRK_ConfigRecordValid := FALSE;
    IF #Record.Scope <> #Scope OR #Record.WriteKey <> "FRK_ConfigScratch".Entry.WriteKey
        OR #Record.Revision <> "FRK_ConfigScratch".Entry.WriteRevision
        OR #Record.Kind <> "FRK_ConfigScratch".Entry.ConfigKind
        OR #Record.ValueType <> "FRK_ConfigScratch".Entry.ValueType THEN RETURN; END_IF;
    #FRK_ConfigRecordValid := "FRK_ConfigValidate"(Text := STRING_TO_WSTRING(#Record.ValueText));
END_FUNCTION

FUNCTION "FRK_ConfigReserve" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT Scope : String; Key : String; ModelCode : String; END_VAR
VAR_IN_OUT Reserved : Array[1..@MAX_SET_RECORDS@] of Int; END_VAR
VAR_TEMP Found : Int; Candidate : DInt; Prior : Int; CandidateFree : Bool; END_VAR
BEGIN
    #FRK_ConfigReserve := 0;
    #Found := "FRK_ConfigFind"(Scope := #Scope, Key := #Key, ModelCode := #ModelCode);
    IF #Found > 0 THEN
        FOR #Prior := 1 TO @MAX_SET_RECORDS@ DO IF #Reserved[#Prior] = #Found THEN RETURN; END_IF; END_FOR;
        #FRK_ConfigReserve := #Found; RETURN;
    END_IF;
    FOR #Candidate := 1 TO @POOL_CAPACITY@ DO
        #CandidateFree := NOT "FRK_ConfigStore".Rows[#Candidate].Used;
        FOR #Prior := 1 TO @MAX_SET_RECORDS@ DO
            IF #Reserved[#Prior] = DINT_TO_INT(#Candidate) THEN #CandidateFree := FALSE; END_IF;
        END_FOR;
        IF #CandidateFree THEN #FRK_ConfigReserve := DINT_TO_INT(#Candidate); RETURN; END_IF;
    END_FOR;
END_FUNCTION

FUNCTION "FRK_ConfigChanged" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT Scope : String; ModelCode : String; Kind : DInt; END_VAR
BEGIN
    RETURN;
END_FUNCTION

FUNCTION "FRK_ConfigCommit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT SlotIndex : Int; ModelCode : String; Schema : UInt; Record : "ST_ConfigRecord"; END_VAR
VAR_TEMP Changed : Bool; END_VAR
BEGIN
    IF #SlotIndex < 1 OR #SlotIndex > @POOL_CAPACITY@ THEN RETURN; END_IF;
    #Changed := NOT "FRK_ConfigStore".Rows[#SlotIndex].Used
        OR "FRK_ConfigStore".Rows[#SlotIndex].SchemaVersion <> #Schema
        OR "FRK_ConfigStore".Rows[#SlotIndex].ModelCode <> #ModelCode
        OR "FRK_ConfigStore".Rows[#SlotIndex].Record.Scope <> #Record.Scope
        OR "FRK_ConfigStore".Rows[#SlotIndex].Record.WriteKey <> #Record.WriteKey
        OR "FRK_ConfigStore".Rows[#SlotIndex].Record.Revision <> #Record.Revision
        OR "FRK_ConfigStore".Rows[#SlotIndex].Record.Kind <> #Record.Kind
        OR "FRK_ConfigStore".Rows[#SlotIndex].Record.ValueType <> #Record.ValueType
        OR "FRK_ConfigStore".Rows[#SlotIndex].Record.ValueText <> #Record.ValueText;
    "FRK_ConfigStore".Rows[#SlotIndex].SchemaVersion := #Schema;
    "FRK_ConfigStore".Rows[#SlotIndex].ModelCode := #ModelCode;
    "FRK_ConfigStore".Rows[#SlotIndex].Record := #Record;
    "FRK_ConfigStore".Rows[#SlotIndex].Used := TRUE;
    IF #Changed THEN "FRK_ConfigChanged"(Scope := #Record.Scope, ModelCode := #ModelCode, Kind := #Record.Kind); END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigActiveChanged" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT RootIndex : Int; END_VAR
BEGIN
    RETURN;
END_FUNCTION

FUNCTION "FRK_ConfigSetActiveModel" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT RootIndex : Int; ModelCode : String; END_VAR
BEGIN
    IF #RootIndex < 1 OR #RootIndex > @ROOT_COUNT@ THEN RETURN; END_IF;
    IF "FRK_ConfigStore".ActiveModels[#RootIndex] = #ModelCode THEN RETURN; END_IF;
    "FRK_ConfigStore".ActiveModels[#RootIndex] := #ModelCode;
    "FRK_ConfigActiveChanged"(RootIndex := #RootIndex);
END_FUNCTION

FUNCTION "FRK_ConfigPut" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    ModelCode : String;
    Text : WString;
    RootIndex : Int;
END_VAR
VAR_TEMP
    Index : DInt;
    Candidate : DInt;
    Record : "ST_ConfigRecord";
END_VAR
BEGIN
    #FRK_ConfigPut := FALSE;
    IF #RootIndex < 1 OR #RootIndex > @ROOT_COUNT@ THEN RETURN; END_IF;
    IF "FRK_ConfigRuntime".Unavailable THEN "FRK_ConfigRuntime".Failed[#RootIndex] := TRUE; RETURN; END_IF;
    IF LEN(#Scope) > @SCOPE_WIDTH@ OR LEN(#Text) > @VALUE_WIDTH@ THEN RETURN; END_IF;
    IF NOT "FRK_ConfigValidate"(Text := #Text) THEN RETURN; END_IF;
    #Index := "FRK_ConfigFind"(Scope := #Scope, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := #ModelCode);
    IF #Index = 0 THEN
        FOR #Candidate := 1 TO @POOL_CAPACITY@ DO
            IF NOT "FRK_ConfigStore".Rows[#Candidate].Used THEN #Index := #Candidate; EXIT; END_IF;
        END_FOR;
    END_IF;
    IF #Index < 1 OR #Index > @POOL_CAPACITY@ THEN "FRK_ConfigRuntime".Failed[#RootIndex] := TRUE; RETURN; END_IF;
    #Record.Scope := #Scope;
    #Record.WriteKey := "FRK_ConfigScratch".Entry.WriteKey;
    #Record.Revision := "FRK_ConfigScratch".Entry.WriteRevision;
    #Record.Kind := "FRK_ConfigScratch".Entry.ConfigKind;
    #Record.ValueType := "FRK_ConfigScratch".Entry.ValueType;
    #Record.ValueText := WSTRING_TO_STRING(#Text);
    "FRK_ConfigCommit"(SlotIndex := DINT_TO_INT(#Index), ModelCode := #ModelCode, Schema := "FRK_ConfigScratch".Schema, Record := #Record);
    "FRK_ConfigRuntime".Failed[#RootIndex] := FALSE;
    #FRK_ConfigPut := TRUE;
END_FUNCTION

FUNCTION "FRK_ConfigGet" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    ModelCode : String;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigGet := FALSE;
    #Index := "FRK_ConfigFind"(Scope := #Scope, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := #ModelCode);
    IF #Index = 0 THEN RETURN; END_IF;
    IF "FRK_ConfigStore".Rows[#Index].SchemaVersion <> "FRK_ConfigScratch".Schema
        OR "FRK_ConfigStore".Rows[#Index].Record.Revision <> "FRK_ConfigScratch".Entry.WriteRevision
        OR "FRK_ConfigStore".Rows[#Index].Record.Kind <> "FRK_ConfigScratch".Entry.ConfigKind
        OR "FRK_ConfigStore".Rows[#Index].Record.ValueType <> "FRK_ConfigScratch".Entry.ValueType THEN RETURN; END_IF;
    #FRK_ConfigGet := "FRK_ConfigValidate"(Text := STRING_TO_WSTRING("FRK_ConfigStore".Rows[#Index].Record.ValueText));
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING("FRK_ConfigStore".Rows[#Index].Record.ValueText);
    IF #FRK_ConfigGet AND "FRK_ConfigScratch".EnumCount > 0 THEN
        "FRK_ConfigScratch".Entry.ValueText := "FRK_ConfigEnumText"(Number := LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigLoss" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    Scope : String;
END_VAR
BEGIN
    IF #RootIndex < 1 OR #RootIndex > @ROOT_COUNT@ THEN RETURN; END_IF;
    "FRK_ConfigStore".Lost[#RootIndex] := TRUE;
    "FRK_ConfigStore".Acknowledged[#RootIndex] := FALSE;
    "FRK_ConfigStore".LostPath[#RootIndex] := #Scope;
END_FUNCTION

FUNCTION "FRK_ConfigAppendEntry" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Cursor : "FRK_ConfigCursor";
    Page : "ST_ConfigPage";
END_VAR
VAR_TEMP
    Slot : DInt;
END_VAR
BEGIN
    #Slot := #Cursor.Position - #Cursor.First;
    #Cursor.Position := #Cursor.Position + 1;
    IF #Slot < 0 OR #Slot >= @MAX_CONFIG_PAGE@ THEN RETURN; END_IF;
    #Slot := #Slot + 1;
    #Page.Entries[#Slot] := "FRK_ConfigScratch".Entry;
    #Page.EntryCount := DINT_TO_INT(#Slot);
END_FUNCTION

FUNCTION "FRK_ConfigStatus" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    Scope : String;
    PolicyLost : Bool;
    UsersLost : Bool;
END_VAR
VAR_IN_OUT
    Persist : "ST_ConfigPersistStatus";
    AlarmLog : "FRK_AlarmLog";
END_VAR
VAR_TEMP
    Diag : "ST_Diagnostic";
    Accepted : Bool;
END_VAR
BEGIN
    IF #RootIndex < 1 OR #RootIndex > @ROOT_COUNT@ THEN RETURN; END_IF;
    #Persist.Pending := FALSE;
    #Persist.Failed := "FRK_ConfigRuntime".Failed[#RootIndex];
    #Persist.StoreKind := @E_ConfigStore.LOCAL_RETAIN@;
    // Named set operations are not wired by the live retained-value provider.
    #Persist.StorePresent := FALSE;
    #Persist.RestoreLost := "FRK_ConfigStore".Lost[#RootIndex] OR #PolicyLost OR #UsersLost;
    #Persist.RestoreAcknowledged := "FRK_ConfigStore".Acknowledged[#RootIndex] AND NOT #PolicyLost AND NOT #UsersLost;
    IF #PolicyLost THEN #Persist.LostPath := CONCAT(IN1 := #Scope, IN2 := '.AccessPolicy');
    ELSIF #UsersLost THEN #Persist.LostPath := CONCAT(IN1 := #Scope, IN2 := '.Access');
    ELSE #Persist.LostPath := "FRK_ConfigStore".LostPath[#RootIndex]; END_IF;
    // Access owns its precise loss events; announce only typed-config loss here.
    IF "FRK_ConfigStore".Lost[#RootIndex] AND NOT "FRK_ConfigStore".Acknowledged[#RootIndex] THEN
        IF "FRK_ConfigRuntime".LossSlot[#RootIndex] = 0 THEN
            #Diag := "FRK_UnitScratch".EmptyDiagnostic;
            #Diag.ReasonCode := @E_Reason.CONFIG_RESTORE_LOST@;
            #Diag.Description := WSTRING#'std.error.configRestoreLost';
            #Diag.SourcePath := STRING_TO_WSTRING("FRK_ConfigStore".LostPath[#RootIndex]);
            "FRK_ConfigRuntime".LossSlot[#RootIndex] := "FRK_AlarmRaise"(AlarmLog := #AlarmLog, Diag := #Diag, ResetClass := @E_ResetClass.AUTO_RESET@);
        END_IF;
    ELSIF "FRK_ConfigRuntime".LossSlot[#RootIndex] > 0 THEN
        #Accepted := "FRK_AlarmGone"(AlarmLog := #AlarmLog, Slot := "FRK_ConfigRuntime".LossSlot[#RootIndex]);
        "FRK_ConfigRuntime".LossSlot[#RootIndex] := 0;
    END_IF;
END_FUNCTION
