// Keyed local-retain config. The typed owner validates before publishing a value.
FUNCTION "FRK_ConfigWriteAudit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT Scope : String; Key : String; Value : WString; Captured : Bool; User : String; END_VAR
VAR_IN_OUT AlarmLog : "FRK_AlarmLog"; END_VAR
VAR_TEMP Prefix : WString[64]; Text : WString[255]; END_VAR
BEGIN
    IF #Captured THEN #Prefix := WSTRING#'std.audit.configCaptured field=';
    ELSE #Prefix := WSTRING#'std.audit.configWritten field='; END_IF;
    #Text := CONCAT(IN1 := #Prefix, IN2 := STRING_TO_WSTRING(#Key));
    // Preserve the full key/value/user: long entries use two adjacent audited
    // events from this same transaction instead of truncating accepted data.
    IF LEN(#Prefix) + LEN(#Key) + LEN(#Value) + LEN(#User) + 13 <= 255 THEN
        #Text := CONCAT(IN1 := #Text, IN2 := WSTRING#' value=');
        #Text := CONCAT(IN1 := #Text, IN2 := #Value);
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
    ELSE
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
        #Text := CONCAT(IN1 := WSTRING#'std.audit.configValue value=', IN2 := #Value);
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigDecode" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Text : WString;
    Storage : DInt;
    Minimum : LReal;
    Maximum : LReal;
    MaxLength : Int;
END_VAR
VAR_IN_OUT
    Value : "FRK_ConfigValue";
END_VAR
VAR_TEMP
    Index : Int;
    Width : Int;
    Negative : Bool;
    Magnitude : ULInt;
    Digit : ULInt;
    Decimal : LReal;
    Converted : Real;
    ConvertedOk : Bool;
END_VAR
BEGIN
    #FRK_ConfigDecode := FALSE;
    IF #Storage = @E_ConfigStorage.AS_STRING@ THEN
        IF LEN(#Text) > #MaxLength THEN RETURN; END_IF;
        #Value.Text := WSTRING_TO_STRING(#Text);
        IF STRING_TO_WSTRING(#Value.Text) <> #Text THEN RETURN; END_IF;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage = @E_ConfigStorage.AS_BOOL@ THEN
        IF #Text = WSTRING#'true' OR #Text = WSTRING#'TRUE' OR #Text = WSTRING#'1' THEN
            #Value.Flag := TRUE;
        ELSIF #Text = WSTRING#'false' OR #Text = WSTRING#'FALSE' OR #Text = WSTRING#'0' THEN
            #Value.Flag := FALSE;
        ELSE RETURN;
        END_IF;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage = @E_ConfigStorage.AS_REAL@ OR #Storage = @E_ConfigStorage.AS_LREAL@ THEN
        #ConvertedOk := "FRK_DecimalDecode"(Text := #Text,
            SinglePrecision := #Storage = @E_ConfigStorage.AS_REAL@, Value := #Decimal);
        IF NOT #ConvertedOk OR #Decimal < #Minimum OR #Decimal > #Maximum THEN RETURN; END_IF;
        IF #Storage = @E_ConfigStorage.AS_REAL@ THEN
            #Converted := LREAL_TO_REAL(#Decimal);
            IF #Converted = 0.0 AND #Decimal <> 0.0 THEN RETURN; END_IF;
            #Decimal := REAL_TO_LREAL(#Converted);
            IF #Decimal < #Minimum OR #Decimal > #Maximum THEN RETURN; END_IF;
        END_IF;
        #Value.Decimal := #Decimal;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage <> @E_ConfigStorage.AS_INT@ AND #Storage <> @E_ConfigStorage.AS_DINT@
        AND #Storage <> @E_ConfigStorage.AS_UDINT@ AND #Storage <> @E_ConfigStorage.AS_TIME@ THEN RETURN; END_IF;
    #Width := LEN(#Text);
    IF #Width = 0 THEN RETURN; END_IF;
    #Negative := FALSE;
    #Index := 1;
    IF #Text[1] = WCHAR#'-' THEN #Negative := TRUE; #Index := 2;
    ELSIF #Text[1] = WCHAR#'+' THEN #Index := 2;
    END_IF;
    IF #Index > #Width THEN RETURN; END_IF;
    #Magnitude := 0;
    WHILE #Index <= #Width DO
        IF #Text[#Index] < WCHAR#'0' OR #Text[#Index] > WCHAR#'9' THEN RETURN; END_IF;
        #Digit := UINT_TO_ULINT(WCHAR_TO_UINT(#Text[#Index]) - UINT#48);
        IF #Magnitude > (ULINT#4294967295 - #Digit) / ULINT#10 THEN RETURN; END_IF;
        #Magnitude := #Magnitude * ULINT#10 + #Digit;
        #Index := #Index + 1;
    END_WHILE;
    #Value.Number := ULINT_TO_LINT(#Magnitude);
    IF #Negative THEN #Value.Number := -#Value.Number; END_IF;
    IF LINT_TO_LREAL(#Value.Number) < #Minimum OR LINT_TO_LREAL(#Value.Number) > #Maximum THEN RETURN; END_IF;
    #FRK_ConfigDecode := TRUE;
END_FUNCTION

FUNCTION "FRK_ConfigEnumText" : WString
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Number : DInt;
END_VAR
BEGIN
    #FRK_ConfigEnumText := DINT_TO_WSTRING(#Number);
    IF #FRK_ConfigEnumText[1] = WCHAR#'+' THEN
        #FRK_ConfigEnumText := MID(IN := #FRK_ConfigEnumText, L := LEN(#FRK_ConfigEnumText) - 1, P := 2);
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigValidate" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Text : WString;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigValidate := "FRK_ConfigDecode"(Text := #Text,
        Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum,
        Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength,
        Value := "FRK_ConfigScratch".Value);
    IF NOT #FRK_ConfigValidate OR "FRK_ConfigScratch".EnumCount = 0 THEN RETURN; END_IF;
    #FRK_ConfigValidate := FALSE;
    FOR #Index := 1 TO "FRK_ConfigScratch".EnumCount DO
        IF "FRK_ConfigScratch".Value.Number = DINT_TO_LINT("FRK_ConfigScratch".EnumValues[#Index]) THEN
            #FRK_ConfigValidate := TRUE; RETURN;
        END_IF;
    END_FOR;
END_FUNCTION

FUNCTION "FRK_ConfigFind" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    Key : String;
    ModelCode : String;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigFind := 0;
    FOR #Index := 1 TO @POOL_CAPACITY@ DO
        IF "FRK_ConfigStore".Rows[#Index].Used
            AND "FRK_ConfigStore".Rows[#Index].Record.Scope = #Scope
            AND "FRK_ConfigStore".Rows[#Index].Record.WriteKey = #Key
            AND "FRK_ConfigStore".Rows[#Index].ModelCode = #ModelCode THEN
            #FRK_ConfigFind := #Index;
            RETURN;
        END_IF;
    END_FOR;
END_FUNCTION

FUNCTION "FRK_ConfigPut" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    ModelCode : String;
    Text : WString;
    RootIndex : Int;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigPut := FALSE;
    IF #RootIndex < 1 OR #RootIndex > @ROOT_COUNT@ THEN RETURN; END_IF;
    IF "FRK_ConfigRuntime".Unavailable THEN "FRK_ConfigRuntime".Failed[#RootIndex] := TRUE; RETURN; END_IF;
    IF LEN(#Scope) > @SCOPE_WIDTH@ OR LEN(#Text) > @VALUE_WIDTH@ THEN RETURN; END_IF;
    IF NOT "FRK_ConfigValidate"(Text := #Text) THEN RETURN; END_IF;
    #Index := "FRK_ConfigFind"(Scope := #Scope, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := #ModelCode);
    IF #Index = 0 THEN
        FOR #Index := 1 TO @POOL_CAPACITY@ DO
            IF NOT "FRK_ConfigStore".Rows[#Index].Used THEN EXIT; END_IF;
        END_FOR;
    END_IF;
    IF #Index < 1 OR #Index > @POOL_CAPACITY@ THEN "FRK_ConfigRuntime".Failed[#RootIndex] := TRUE; RETURN; END_IF;
    "FRK_ConfigStore".Rows[#Index].SchemaVersion := "FRK_ConfigScratch".Schema;
    "FRK_ConfigStore".Rows[#Index].ModelCode := #ModelCode;
    "FRK_ConfigStore".Rows[#Index].Record.Scope := #Scope;
    "FRK_ConfigStore".Rows[#Index].Record.WriteKey := "FRK_ConfigScratch".Entry.WriteKey;
    "FRK_ConfigStore".Rows[#Index].Record.Revision := "FRK_ConfigScratch".Entry.WriteRevision;
    "FRK_ConfigStore".Rows[#Index].Record.Kind := "FRK_ConfigScratch".Entry.ConfigKind;
    "FRK_ConfigStore".Rows[#Index].Record.ValueType := "FRK_ConfigScratch".Entry.ValueType;
    "FRK_ConfigStore".Rows[#Index].Record.ValueText := WSTRING_TO_STRING(#Text);
    "FRK_ConfigStore".Rows[#Index].Used := TRUE;
    "FRK_ConfigRuntime".Failed[#RootIndex] := FALSE;
    #FRK_ConfigPut := TRUE;
END_FUNCTION

FUNCTION "FRK_ConfigGet" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    ModelCode : String;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigGet := FALSE;
    #Index := "FRK_ConfigFind"(Scope := #Scope, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := #ModelCode);
    IF #Index = 0 THEN RETURN; END_IF;
    IF "FRK_ConfigStore".Rows[#Index].SchemaVersion <> "FRK_ConfigScratch".Schema
        OR "FRK_ConfigStore".Rows[#Index].Record.Revision <> "FRK_ConfigScratch".Entry.WriteRevision
        OR "FRK_ConfigStore".Rows[#Index].Record.Kind <> "FRK_ConfigScratch".Entry.ConfigKind
        OR "FRK_ConfigStore".Rows[#Index].Record.ValueType <> "FRK_ConfigScratch".Entry.ValueType THEN RETURN; END_IF;
    #FRK_ConfigGet := "FRK_ConfigValidate"(Text := STRING_TO_WSTRING("FRK_ConfigStore".Rows[#Index].Record.ValueText));
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING("FRK_ConfigStore".Rows[#Index].Record.ValueText);
    IF #FRK_ConfigGet AND "FRK_ConfigScratch".EnumCount > 0 THEN
        "FRK_ConfigScratch".Entry.ValueText := "FRK_ConfigEnumText"(Number := LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigLoss" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    Scope : String;
END_VAR
BEGIN
    IF #RootIndex < 1 OR #RootIndex > @ROOT_COUNT@ THEN RETURN; END_IF;
    "FRK_ConfigStore".Lost[#RootIndex] := TRUE;
    "FRK_ConfigStore".Acknowledged[#RootIndex] := FALSE;
    "FRK_ConfigStore".LostPath[#RootIndex] := #Scope;
END_FUNCTION

FUNCTION "FRK_ConfigAppendEntry" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Cursor : "FRK_ConfigCursor";
    Page : "ST_ConfigPage";
END_VAR
VAR_TEMP
    Slot : DInt;
END_VAR
BEGIN
    #Slot := #Cursor.Position - #Cursor.First;
    #Cursor.Position := #Cursor.Position + 1;
    IF #Slot < 0 OR #Slot >= @MAX_CONFIG_PAGE@ THEN RETURN; END_IF;
    #Slot := #Slot + 1;
    #Page.Entries[#Slot] := "FRK_ConfigScratch".Entry;
    #Page.EntryCount := DINT_TO_INT(#Slot);
END_FUNCTION

FUNCTION "FRK_ConfigStatus" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    Scope : String;
    PolicyLost : Bool;
    UsersLost : Bool;
END_VAR
VAR_IN_OUT
    Persist : "ST_ConfigPersistStatus";
    AlarmLog : "FRK_AlarmLog";
END_VAR
VAR_TEMP
    Diag : "ST_Diagnostic";
    Accepted : Bool;
END_VAR
BEGIN
    IF #RootIndex < 1 OR #RootIndex > @ROOT_COUNT@ THEN RETURN; END_IF;
    #Persist.Pending := FALSE;
    #Persist.Failed := "FRK_ConfigRuntime".Failed[#RootIndex];
    #Persist.StoreKind := @E_ConfigStore.LOCAL_RETAIN@;
    // Named set operations are not wired by the live retained-value provider.
    #Persist.StorePresent := FALSE;
    #Persist.RestoreLost := "FRK_ConfigStore".Lost[#RootIndex] OR #PolicyLost OR #UsersLost;
    #Persist.RestoreAcknowledged := "FRK_ConfigStore".Acknowledged[#RootIndex] AND NOT #PolicyLost AND NOT #UsersLost;
    IF #PolicyLost THEN #Persist.LostPath := CONCAT(IN1 := #Scope, IN2 := '.AccessPolicy');
    ELSIF #UsersLost THEN #Persist.LostPath := CONCAT(IN1 := #Scope, IN2 := '.Access');
    ELSE #Persist.LostPath := "FRK_ConfigStore".LostPath[#RootIndex]; END_IF;
    // Access owns its precise loss events; announce only typed-config loss here.
    IF "FRK_ConfigStore".Lost[#RootIndex] AND NOT "FRK_ConfigStore".Acknowledged[#RootIndex] THEN
        IF "FRK_ConfigRuntime".LossSlot[#RootIndex] = 0 THEN
            #Diag := "FRK_UnitScratch".EmptyDiagnostic;
            #Diag.ReasonCode := @E_Reason.CONFIG_RESTORE_LOST@;
            #Diag.Description := WSTRING#'std.error.configRestoreLost';
            #Diag.SourcePath := STRING_TO_WSTRING("FRK_ConfigStore".LostPath[#RootIndex]);
            "FRK_ConfigRuntime".LossSlot[#RootIndex] := "FRK_AlarmRaise"(AlarmLog := #AlarmLog, Diag := #Diag, ResetClass := @E_ResetClass.AUTO_RESET@);
        END_IF;
    ELSIF "FRK_ConfigRuntime".LossSlot[#RootIndex] > 0 THEN
        #Accepted := "FRK_AlarmGone"(AlarmLog := #AlarmLog, Slot := "FRK_ConfigRuntime".LossSlot[#RootIndex]);
        "FRK_ConfigRuntime".LossSlot[#RootIndex] := 0;
    END_IF;
END_FUNCTION
