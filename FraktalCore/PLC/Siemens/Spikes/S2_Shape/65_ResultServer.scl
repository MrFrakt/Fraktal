// Fraktal/TIA Phase 0 fixture S2 - test-result server (Part IV s.5.7 harvest,
// spike S13 byte transport). PUT/GET is not settable for S7-1200 through
// Openness and the OPC UA server needs a runtime licence, so the test image
// serves its own result table: a PASSIVE open-user-communication TCP connection
// on port 2000 that sends "SpkResults".T (396 bytes, standard layout) every
// 500 ms to whichever host connects. Read-only by construction: nothing the
// host sends is ever read. Test images only - never in a deployed program.

FUNCTION_BLOCK "FB_SpkResultServer"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Port : UInt := 2000;
   END_VAR

   VAR
      Send { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : TSEND_C;
      Conn { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : TCON_IP_v4;
      Configured : Bool;
      Req : Bool;
      LastMs : UDInt;
      SentCount : UDInt;
      ErrorCount : UDInt;
      LastStatus : Word;
      ComRst : Bool;               // COM_RST is InOut on TSEND_C: it needs a variable, not a literal
   END_VAR


BEGIN
	IF NOT #Configured THEN
	    #Conn.InterfaceId := "Local~PROFINET_interface_1";
	    #Conn.ID := 16#1;
	    #Conn.ConnectionType := 16#0B;          // TCP
	    #Conn.ActiveEstablished := FALSE;       // passive: the host connects to the CPU
	    #Conn.RemotePort := 0;
	    #Conn.LocalPort := #Port;
	    #Configured := TRUE;
	END_IF;

	// One send request every 500 ms while no job is in progress.
	#Req := FALSE;
	IF NOT #Send.BUSY AND "FRK_Clock".NowMs - #LastMs >= 500 THEN
	    #Req := TRUE;
	    #LastMs := "FRK_Clock".NowMs;
	END_IF;

	#Send(REQ := #Req,
	      CONT := TRUE,
	      LEN := 0,
	      CONNECT := #Conn,
	      DATA := "SpkResults".T,
	      COM_RST := #ComRst);

	IF #Send.DONE THEN
	    #SentCount := #SentCount + 1;
	END_IF;
	IF #Send.ERROR THEN
	    #ErrorCount := #ErrorCount + 1;
	    #LastStatus := #Send.STATUS;
	END_IF;
END_FUNCTION_BLOCK
