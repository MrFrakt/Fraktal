FUNCTION "FRK_ConfigBegin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      PageIndex : DInt;
      Revision : UDInt;
   END_VAR

   VAR_IN_OUT 
      Cursor : "FRK_ConfigCursor";
      Page : "ST_ConfigPage";
   END_VAR

   VAR_TEMP 
      Index : Int;
   END_VAR


BEGIN
	
	#Cursor.Position := 0;
	#Cursor.First := 0;
	#Page.Revision := #Revision;
	#Page.PageIndex := 0;
	IF #PageIndex >= 0 AND #PageIndex <= 32767 THEN
	    #Cursor.First := #PageIndex * 16;
	    #Page.PageIndex := DINT_TO_INT(#PageIndex);
	END_IF;
	#Page.PageCount := 1;
	#Page.EntryCount := 0;
	"FRK_UnitScratch".EmptyConfigEntry.ValueType := 1;
	"FRK_UnitScratch".EmptyConfigEntry.Readable := TRUE;
	FOR #Index := 1 TO 16 DO
	    #Page.Entries[#Index] := "FRK_UnitScratch".EmptyConfigEntry;
	END_FOR;
	
END_FUNCTION

