FUNCTION "FRK_AlarmRecoveryEventValid" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Ev : "ST_AlarmEvent";
   END_VAR


BEGIN
	
	#FRK_AlarmRecoveryEventValid := #Ev.ResetClass = 1
	AND #Ev.Severity >= 0 AND #Ev.Severity <= 2
	AND #Ev.Category >= 0 AND #Ev.Category <= 2
	AND #Ev.SourcePath <> WSTRING#'' AND #Ev.Description <> WSTRING#'' AND #Ev.ReasonCode > 0 AND #Ev.Duration >= T#0ms;
	
END_FUNCTION

