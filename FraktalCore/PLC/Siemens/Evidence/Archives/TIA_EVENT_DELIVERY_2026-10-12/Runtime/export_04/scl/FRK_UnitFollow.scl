FUNCTION "FRK_UnitFollow" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Supported : Array[0..6] of Bool;
   END_VAR

   VAR_IN_OUT 
      Core : "FRK_Core";
      Unit : "FRK_Unit";
      Status : "ST_ModuleStatus";
      Policy : Array[0..6] of "ST_ModePolicy";
      Access : "FRK_Access";
   END_VAR

   VAR_TEMP 
      Request : "ST_HmiRequest";
   END_VAR


BEGIN
	
	IF #Unit.FollowStart AND NOT #Unit.ModePending AND NOT #Unit.Clearing THEN
	    #Unit.FollowStart := FALSE;
	    #Request.Kind := 5;
	    "FRK_UnitOperation"(Core := #Core,
	                        Unit := #Unit,
	                        Status := #Status,
	                        Policy := #Policy,
	                        Access := #Access,
	                        Supported := #Supported,
	                        Request := #Request,
	                        Response := "FRK_UnitScratch".Response,
	                        Trusted := TRUE);
	END_IF;
	
END_FUNCTION

