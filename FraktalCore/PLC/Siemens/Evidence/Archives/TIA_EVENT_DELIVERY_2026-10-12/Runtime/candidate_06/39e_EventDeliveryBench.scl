// Test-only corruption before restore and real alarm callback stimulus after scan.
FUNCTION "F_RecoveryCheckpointInspect" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Startup : Bool;
END_VAR
VAR_TEMP
    Slot : Int;
    Index : Int;
END_VAR
BEGIN
    IF NOT #Startup THEN RETURN; END_IF;
    "GDB_DeliveryTest".RecoveryCheck := 0;
    #Slot := "FRK_AlarmRecoveryIndex"(Scope := 'StationA');
    IF #Slot < 1 OR #Slot > 2 THEN RETURN; END_IF;
    IF "FRK_AlarmRecovery".Rows[#Slot].SchemaVersion <> 1 THEN "GDB_DeliveryTest".RecoveryCheck := 1; RETURN; END_IF;
    IF "FRK_AlarmRecovery".Rows[#Slot].Scope <> 'StationA' THEN "GDB_DeliveryTest".RecoveryCheck := 2; RETURN; END_IF;
    IF "FRK_AlarmRecovery".Rows[#Slot].Checksum <> "FRK_AlarmRecoveryHeaderCrc"(Slot := #Slot) THEN "GDB_DeliveryTest".RecoveryCheck := 3; RETURN; END_IF;
    FOR #Index := 1 TO 16 DO
        IF "FRK_AlarmRecovery".Rows[#Slot].Active[#Index].State <> 0 THEN
            "GDB_DeliveryTest".RecoveryIndex := #Index;
            IF NOT "FRK_AlarmRecoveryEventValid"(Ev := "FRK_AlarmRecovery".Rows[#Slot].Active[#Index]) THEN "GDB_DeliveryTest".RecoveryCheck := 4; RETURN; END_IF;
            IF "FRK_AlarmRecovery".Rows[#Slot].EventCrc[#Index] <> "FRK_AlarmEventCrc"(Ev := "FRK_AlarmRecovery".Rows[#Slot].Active[#Index]) THEN "GDB_DeliveryTest".RecoveryCheck := 5; RETURN; END_IF;
            IF "FRK_AlarmRecovery".Rows[#Slot].Elapsed[#Index] > 2147483647 THEN "GDB_DeliveryTest".RecoveryCheck := 6; RETURN; END_IF;
            IF "FRK_AlarmRecovery".Rows[#Slot].TimeCrc[#Index] <> "FRK_AlarmRecoveryTimeCrc"(Slot := #Slot, EventSlot := #Index, Value := "FRK_AlarmRecovery".Rows[#Slot].Elapsed[#Index], EventCrc := "FRK_AlarmRecovery".Rows[#Slot].EventCrc[#Index]) THEN "GDB_DeliveryTest".RecoveryCheck := 7; RETURN; END_IF;
        END_IF;
    END_FOR;
END_FUNCTION

FUNCTION "F_DeliveryDamage" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Startup : Bool;
END_VAR
VAR_TEMP
    Slot : Int;
    Head : Int;
END_VAR
BEGIN
    IF NOT #Startup OR "GDB_DeliveryTest".Damage = 0 THEN RETURN; END_IF;
    #Slot := "FRK_DeliveryIndex"(Scope := "GDB_DeliveryTest".Scope);
    IF #Slot < 1 OR #Slot > 3 THEN RETURN; END_IF;
    #Head := "FRK_EventDeliveryStore".Images[#Slot].Head;
    CASE "GDB_DeliveryTest".Damage OF
        1: "FRK_EventDeliveryStore".Images[#Slot].SchemaVersion := 999;
        2: "FRK_EventDeliveryStore".Images[#Slot].Head := 0;
        3: "FRK_EventDeliveryStore".Images[#Slot].Count := 9;
        4: "FRK_EventDeliveryStore".Images[#Slot].Checksum := "FRK_EventDeliveryStore".Images[#Slot].Checksum XOR DWORD#1;
        5: IF #Head >= 1 AND #Head <= 8 THEN "FRK_EventDeliveryStore".Images[#Slot].Entries[#Head].Ev.Description := WSTRING#'test.tampered'; END_IF;
        6: IF #Head >= 1 AND #Head <= 8 THEN "FRK_EventDeliveryStore".Images[#Slot].Entries[#Head].Sequence := 0; END_IF;
        7: "FRK_EventDeliveryStore".Anchors[#Slot].Checksum := "FRK_EventDeliveryStore".Anchors[#Slot].Checksum XOR DWORD#1;
        8: "FRK_EventDeliveryStore".Images[#Slot].SchemaVersion := 0;
           "FRK_EventDeliveryStore".Images[#Slot].Revision := 0;
           "FRK_EventDeliveryStore".Images[#Slot].Checksum := DWORD#0;
        9: "FRK_EventDeliveryStore".Images[#Slot].NextSequence := UDINT#4294967295;
           "FRK_DeliverySave"(Slot := #Slot);
        10: "FRK_EventDeliveryStore".Anchors[#Slot].Checksum := "FRK_DeliveryAnchorCrc"(Slot := #Slot);
        ELSE RETURN;
    END_CASE;
    "GDB_DeliveryTest".Applied := TRUE;
    "GDB_DeliveryTest".Damage := 0;
END_FUNCTION

FUNCTION "F_DeliveryStimulus" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    AlarmLog : "FRK_AlarmLog";
END_VAR
VAR_TEMP
    Slot : Int;
    Gone : Bool;
END_VAR
BEGIN
    CASE "GDB_DeliveryTest".Operation OF
        1: "FRK_AlarmMessage"(AlarmLog := #AlarmLog, Reason := "GDB_DeliveryTest".Reason, Description := "GDB_DeliveryTest".Text, SourcePath := STRING_TO_WSTRING("GDB_DeliveryTest".Scope));
        2: #Slot := "FRK_AlarmRaise"(AlarmLog := #AlarmLog, Diag := "GDB_DeliveryTest".Diag, ResetClass := 1);
           "GDB_DeliveryTest".EventSlot := #Slot;
        3: #Gone := "FRK_AlarmGone"(AlarmLog := #AlarmLog, Slot := "GDB_DeliveryTest".EventSlot);
        ELSE RETURN;
    END_CASE;
END_FUNCTION

FUNCTION "F_DeliveryBench" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
    IF "GDB_DeliveryTest".Operation = 0 THEN RETURN; END_IF;
    IF "GDB_DeliveryTest".UnicodeMode THEN
        "GDB_DeliveryTest".Text := WSTRING#'test.--';
        "GDB_DeliveryTest".Text[6] := UINT_TO_WCHAR(20013);
        "GDB_DeliveryTest".Text[7] := UINT_TO_WCHAR(25991);
    END_IF;
    "GDB_DeliveryTest".Diag := "FRK_UnitScratch".EmptyDiagnostic;
    "GDB_DeliveryTest".Diag.ReasonCode := "GDB_DeliveryTest".Reason;
    "GDB_DeliveryTest".Diag.Description := "GDB_DeliveryTest".Text;
    "GDB_DeliveryTest".Diag.SourcePath := STRING_TO_WSTRING("GDB_DeliveryTest".Scope);
    "GDB_DeliveryTest".Diag.Severity := 2;
    "GDB_DeliveryTest".Diag.Category := 0;
    IF "GDB_DeliveryTest".Scope = 'StationA' THEN "F_DeliveryStimulus"(AlarmLog := "StationA".AlarmLog); END_IF;
    IF "GDB_DeliveryTest".Scope = 'StationA.Satellite' THEN "F_DeliveryStimulus"(AlarmLog := "StationA".Satellite.AlarmLog); END_IF;
    IF "GDB_DeliveryTest".Scope = 'StationB' THEN "F_DeliveryStimulus"(AlarmLog := "StationB".AlarmLog); END_IF;
    "GDB_DeliveryTest".Operation := 0;
END_FUNCTION
