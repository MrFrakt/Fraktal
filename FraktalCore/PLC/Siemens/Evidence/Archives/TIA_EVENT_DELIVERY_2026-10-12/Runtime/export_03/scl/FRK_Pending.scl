FUNCTION "FRK_Pending" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Diag : "ST_Diagnostic";
   END_VAR

   VAR_IN_OUT 
      Core : "FRK_Core";
      Status : "ST_ModuleStatus";
   END_VAR


BEGIN
	
	IF #Core.Exec = 1 AND NOT #Core.DiagTouched THEN
	    #Status.Diagnostic := #Diag;
	    #Status.Diagnostic.Severity := 0;
	    #Core.DiagTouched := TRUE;
	END_IF;
	
END_FUNCTION

