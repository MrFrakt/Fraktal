<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_ProbeClampRoot" Id="{5b1f7e2a-8c4d-4e61-9a3b-2f6d8c1e7a40}" SpecialFunc="None">
    <Declaration><![CDATA[// §5.7 Unit-tier probe: a root over the library's clamp EM, the shape a project
// Unit takes - wiring only, every step in its chain (§6.8). It replaces the
// library's former FB_ClampStationUnit, a concrete application Unit a reusable
// library must not ship (§6.7); the Unit-tier rows it carried are proven here.
FUNCTION_BLOCK FB_ProbeClampRoot EXTENDS FB_UnitBase
VAR_OUTPUT
    Clamp : FB_ClampEM;
END_VAR
VAR
    Chain : FB_ProbeClampCycle;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Cyclic();]]></ST>
    </Implementation>
    <Method Name="Setup" Id="{7c2e9a14-3b5f-4d80-b6e1-9f4a2c8d0e53}">
      <Declaration><![CDATA[METHOD Setup : BOOL
VAR_INPUT
    Name : STRING(80);
    HalA : REFERENCE TO ST_CylinderHal;
    HalB : REFERENCE TO ST_CylinderHal;
    Recipe : I_RecipeProvider;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_M_SetName(Name);
Setup := Clamp.Setup(Name := CONCAT(Name, '.Clamp'), HalA := HalA, HalB := HalB, Recipe := Recipe)
    AND _M_Register(Child := Clamp)
    AND Chain.Setup(Host := THIS^, Clamp := Clamp);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_Dispatch" Id="{e3a81c56-2d9f-4b07-8c4a-61f0b7d2e918}">
      <Declaration><![CDATA[METHOD PROTECTED _M_Dispatch]]></Declaration>
      <Implementation>
        <ST><![CDATA[Chain.M_Run();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
