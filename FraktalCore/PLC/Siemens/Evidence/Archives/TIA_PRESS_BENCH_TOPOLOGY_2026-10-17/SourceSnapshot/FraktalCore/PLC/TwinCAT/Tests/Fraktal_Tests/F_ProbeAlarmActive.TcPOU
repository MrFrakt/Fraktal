<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="F_ProbeAlarmActive" Id="{63f27f35-a87a-4770-ba4c-f9794ccf9398}" SpecialFunc="None">
    <Declaration><![CDATA[// Test helper: is an event with this reason and source currently active in Log?
FUNCTION F_ProbeAlarmActive : BOOL
VAR_INPUT
    pLog   : POINTER TO FB_AlarmLog;
    Reason : E_Reason;
    Source : STRING(255);
END_VAR
VAR
    i : INT;
END_VAR]]></Declaration>
    <Implementation><ST><![CDATA[F_ProbeAlarmActive := FALSE;
IF pLog = 0 THEN
    RETURN;
END_IF
FOR i := 1 TO MIN(pLog^.NActive, PL_Fraktal.MAX_ALARM_ACTIVE) DO
    IF (pLog^.Active[i].ReasonCode = Reason) AND (pLog^.Active[i].SourcePath = Source) THEN
        F_ProbeAlarmActive := TRUE;
    END_IF
END_FOR]]></ST></Implementation>
  </POU>
</TcPlcObject>