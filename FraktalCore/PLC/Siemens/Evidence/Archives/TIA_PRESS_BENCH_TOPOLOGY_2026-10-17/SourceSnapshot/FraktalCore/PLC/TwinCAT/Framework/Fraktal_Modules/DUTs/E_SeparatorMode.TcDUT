<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_SeparatorMode" Id="{feb37858-4307-4b1d-9640-021f88728754}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
// Separation behaviour variants (Annex A). SEPARATOR checks the carrier at AND
// after the device; STOPPER checks only at it.
TYPE E_SeparatorMode : (
    SEPARATOR  := 0,
    STOPPER    := 1,
    ASISTOPPER := 2,
    LEADFRAME  := 3
) DINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>