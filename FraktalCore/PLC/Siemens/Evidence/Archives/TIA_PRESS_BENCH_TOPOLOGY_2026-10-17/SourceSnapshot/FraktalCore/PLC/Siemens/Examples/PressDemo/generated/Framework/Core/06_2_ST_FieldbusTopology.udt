TYPE "ST_FieldbusTopology"
VERSION : 0.1
   STRUCT
      "NodeCount" : Int;
      "Nodes" : Array[1..3] of "ST_BusNode";
      "MappingValid" : Bool;
      "MappingDiagnostic" : WString[255];
      "ForcesEnabled" {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
   END_STRUCT;
END_TYPE
