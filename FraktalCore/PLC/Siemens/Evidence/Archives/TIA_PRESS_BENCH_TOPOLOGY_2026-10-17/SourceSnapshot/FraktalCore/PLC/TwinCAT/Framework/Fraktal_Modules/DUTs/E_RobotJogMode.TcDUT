<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_RobotJogMode" Id="{65611445-9828-453d-9b11-9f93a32b0988}">
    <Declaration><![CDATA[// Annex I I.3 - jog frame for manual motion. Named E_RobotJogMode, not
// E_JogMode: the short name collides with a Beckhoff motion-library type and the
// ambiguity surfaces only in a consumer that references both. Manual only, release-gated (S7.6).
{attribute 'qualified_only'}
TYPE E_RobotJogMode :
(
    JOINT     := 0,
    CARTESIAN := 1,
    TOOL      := 2
) DINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>