<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_AxisCommand" Id="{c83598c5-b828-48d8-bd13-212dcd2679eb}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
// Annex G motion CM. NONE is the unset value: dispatch rejects it (S5.6).
TYPE E_AxisCommand : (
    NONE    := 0,
    HOME    := 1,
    MOVE_TO := 2,
    // HELD commands (§7.6.1). Two entries rather than one plus a direction, so
    // the generic HMI renders two hold-buttons with no axis-specific code.
    // They never reach _M_Dispatch: a jog is not an Execute/Done command, and
    // PLCopen models it with level inputs for the same reason.
    JOG_POS := 3,
    JOG_NEG := 4
) DINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>