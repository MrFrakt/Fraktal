DATA_BLOCK "FRK_LineDefaults"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
VAR
    Values {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_PressDemoLineConfig";
    Image {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_LineImage";
    Status {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_LineStatus";
END_VAR
BEGIN
    Values.ShiftStartMin[1] := -1;
    Values.ShiftStartMin[2] := -1;
    Values.ShiftStartMin[3] := -1;
    Values.ShiftStartMin[4] := -1;
    Values.ShiftStartMin[5] := -1;
    Values.ShiftDurationMin[1] := 1440;
    Values.ShiftDurationMin[2] := 1440;
    Values.ShiftDurationMin[3] := 1440;
    Values.ShiftDurationMin[4] := 1440;
    Values.ShiftDurationMin[5] := 1440;
END_DATA_BLOCK
