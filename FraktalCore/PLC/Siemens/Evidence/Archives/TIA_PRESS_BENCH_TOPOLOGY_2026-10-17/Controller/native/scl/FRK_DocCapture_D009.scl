FUNCTION "FRK_DocCapture_D009" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D009 := FALSE;
	"FRK_PersistImages".D009.SchemaVersion := 1;
	"FRK_PersistImages".D009.Scope := 'PressDemo';
	"FRK_PersistImages".D009.Ordinal := 4;
	"FRK_PersistImages".D009.Payload := "FRK_SetStore".Sets[1, 4];
	FOR #Index := 0 TO 8249 DO
	    "FRK_PersistBuffers".D009Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D009, DEST_ARRAY => "FRK_PersistBuffers".D009Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 8250 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D009 := TRUE;
	
END_FUNCTION

