FUNCTION "FRK_Route_TwoHandStartCM" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Request : "ST_HmiRequest";
   END_VAR

   VAR_IN_OUT 
      Module : "FB_TwoHandStartCM";
      Hal : "ST_TwoHandHal";
      Report : "ST_ReleaseReport";
   END_VAR

   VAR_TEMP 
      RouteMatched : Bool;
      Index : Int;
   END_VAR


BEGIN
	
	#FRK_Route_TwoHandStartCM := FALSE;
	IF NOT "FRK_PathOwned"(OwnerPath := #Module.Status.Name, TargetPath := #Request.TargetPath) THEN
	    RETURN;
	END_IF;
	IF #Request.TargetPath = STRING_TO_WSTRING(#Module.Status.Name) THEN
	    FOR #Index := 1 TO 16 DO
	        #Module.ManConditions[#Index].Used := FALSE;
	    END_FOR;
	    "FRK_ManualApply"(Core := #Module.Core,
	                      Status := #Module.Status,
	                      Request := #Request,
	                      Commands := #Module.Catalog,
	                      Count := #Module.CatalogCount,
	                      Conditions := #Module.ManConditions,
	                      Report := #Report,
	                      Execute := #Module.Execute,
	                      Command := #Module.Command,
	                      ManualOwned := #Module.ManualOwned);
	    #FRK_Route_TwoHandStartCM := TRUE;
	    RETURN;
	END_IF;
	
END_FUNCTION

