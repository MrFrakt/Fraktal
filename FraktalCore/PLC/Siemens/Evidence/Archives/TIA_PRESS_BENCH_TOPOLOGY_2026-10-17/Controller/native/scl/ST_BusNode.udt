TYPE "ST_BusNode"
VERSION : 0.1
   STRUCT
      "Name" : String[80];
      DescriptionKey : String[160];
      TypeId : String[80];
      Address : String[40];
      State : DInt;
      LinkOk : Bool;
      ParentIdx : Int;
      ChannelCount : Int;
      Channels : Array[1..14] of "ST_IoChannel";
   END_STRUCT;

END_TYPE

