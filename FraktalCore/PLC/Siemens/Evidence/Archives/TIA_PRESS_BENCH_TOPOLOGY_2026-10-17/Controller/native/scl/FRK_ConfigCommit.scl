FUNCTION "FRK_ConfigCommit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      SlotIndex : Int;
      ModelCode : String;
      Schema : UInt;
      Record : "ST_ConfigRecord";
   END_VAR

   VAR_TEMP 
      Changed : Bool;
   END_VAR


BEGIN
	
	IF #SlotIndex < 1 OR #SlotIndex > 22 THEN
	    RETURN;
	END_IF;
	#Changed := NOT "FRK_ConfigStore".Rows[#SlotIndex].Used
	OR "FRK_ConfigStore".Rows[#SlotIndex].SchemaVersion <> #Schema
	OR "FRK_ConfigStore".Rows[#SlotIndex].ModelCode <> #ModelCode
	OR "FRK_ConfigStore".Rows[#SlotIndex].Record.Scope <> #Record.Scope
	OR "FRK_ConfigStore".Rows[#SlotIndex].Record.WriteKey <> #Record.WriteKey
	OR "FRK_ConfigStore".Rows[#SlotIndex].Record.Revision <> #Record.Revision
	OR "FRK_ConfigStore".Rows[#SlotIndex].Record.Kind <> #Record.Kind
	OR "FRK_ConfigStore".Rows[#SlotIndex].Record.ValueType <> #Record.ValueType
	OR "FRK_ConfigStore".Rows[#SlotIndex].Record.ValueText <> #Record.ValueText;
	"FRK_ConfigStore".Rows[#SlotIndex].SchemaVersion := #Schema;
	"FRK_ConfigStore".Rows[#SlotIndex].ModelCode := #ModelCode;
	"FRK_ConfigStore".Rows[#SlotIndex].Record := #Record;
	"FRK_ConfigStore".Rows[#SlotIndex].Used := TRUE;
	IF #Changed THEN
	    "FRK_ConfigChanged"(Scope := #Record.Scope,
	                        ModelCode := #ModelCode,
	                        Kind := #Record.Kind);
	END_IF;
	
END_FUNCTION

