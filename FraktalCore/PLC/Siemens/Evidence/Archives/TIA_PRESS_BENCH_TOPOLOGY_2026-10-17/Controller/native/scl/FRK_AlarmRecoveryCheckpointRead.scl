FUNCTION "FRK_AlarmRecoveryCheckpointRead" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Slot : Int;
      EventSlot : Int;
   END_VAR

   VAR_OUTPUT 
      Elapsed : UDInt;
      Checksum : DWord;
   END_VAR


BEGIN
	
	#Elapsed := 0;
	#Checksum := DWORD#0;
	IF #Slot < 1 OR #Slot > 1 OR #EventSlot < 1 OR #EventSlot > 16 THEN
	    RETURN;
	END_IF;
	IF "FRK_AlarmRecovery".Rows[#Slot].TimeBank[#EventSlot] THEN
	    #Elapsed := "FRK_AlarmRecovery".Rows[#Slot].ElapsedAlt[#EventSlot];
	    #Checksum := "FRK_AlarmRecovery".Rows[#Slot].TimeCrcAlt[#EventSlot];
	ELSE
	    #Elapsed := "FRK_AlarmRecovery".Rows[#Slot].Elapsed[#EventSlot];
	    #Checksum := "FRK_AlarmRecovery".Rows[#Slot].TimeCrc[#EventSlot];
	END_IF;
	
END_FUNCTION

