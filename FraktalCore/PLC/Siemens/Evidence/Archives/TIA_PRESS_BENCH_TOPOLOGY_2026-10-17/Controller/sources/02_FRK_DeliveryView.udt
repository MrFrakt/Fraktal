TYPE "FRK_DeliveryView"
VERSION : 0.1
   STRUCT
      "SchemaVersion" : UInt;
      "Scope" : String[80];
      "StreamId" : String[36];
      "Epoch" : UDInt;
      "Capacity" : Int;
      "Pending" : Int;
      "Overflow" : Bool;
      "Dropped" : UDInt;
      "RestoreLost" : Bool;
      "AnchorValid" : Bool;
      "Token" : String[160];
      "Checksum" : UDInt;
      "Ev" : "ST_AlarmEvent";
   END_STRUCT;
END_TYPE
