// Shared sequence services. The examples generator binds Core enum constants.
FUNCTION "FRK_SeqBegin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Run : Bool;
    Reset : Bool;
    OwnerIndex : DInt;
    ChainIndex : DInt;
    Delta : Time;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    #Seq.Scan := #Seq.Scan + 1;
    #Seq.Restart := #Reset OR (#Run AND NOT #Seq.RunPrevious);
    #Seq.RunPrevious := #Run;
    #Seq.OwnerIndex := #OwnerIndex;
    #Seq.ChainIndex := #ChainIndex;
    #Seq.RetVal := @E_StepResult.NONE@;
    #Seq.Pending := FALSE;
    #Seq.Awaiting := '';
    IF NOT #Run OR #Seq.Restart THEN
        #Seq.Step := 0;
        #Seq.RecordedStep := -1;
        #Seq.Visit := #Seq.Visit + 1;
        #Seq.Done := FALSE;
        #Seq.Error := FALSE;
        #Seq.StartLatched := FALSE;
        #Seq.Elapsed := T#0ms;
        #Seq.DelayElapsed := T#0ms;
        #Seq.ErrorDiagnostic.ReasonCode := @E_Reason.NONE@;
    END_IF;
    #Seq.Running := #Run AND NOT #Seq.Done AND NOT #Seq.Error
        AND #OwnerIndex > 0 AND #ChainIndex > 0;
    #Seq.ScanStep := #Seq.Step;
    IF #Seq.Running AND #Delta > T#0ms THEN #Seq.Elapsed := #Seq.Elapsed + #Delta; END_IF;
END_FUNCTION

FUNCTION "FRK_SeqStart" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    StartPulse : Bool;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    IF #Seq.Running THEN #Seq.StartLatched := #Seq.StartLatched OR #StartPulse; END_IF;
END_FUNCTION

FUNCTION "FRK_SeqCycleEnd" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    #Seq.StartLatched := FALSE;
END_FUNCTION

FUNCTION "FRK_SeqComplete" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    #Seq.Done := TRUE;
    #Seq.Running := FALSE;
END_FUNCTION

FUNCTION "FRK_SeqAt" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    StepNo : DInt;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    // Capture dispatch once: a forward LD transition cannot execute the next
    // state's rung in this scan or hide an Execute-low reset scan.
    #FRK_SeqAt := #Seq.Running AND NOT #Seq.Error AND #Seq.ScanStep = #StepNo;
END_FUNCTION

FUNCTION "FRK_SeqStep" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    StepNo : DInt;
    StepName : String;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
    Row : "FRK_SequenceRow";
END_VAR
BEGIN
    IF #Seq.RecordedStep <> #StepNo THEN
        #Seq.Visit := #Seq.Visit + 1;
        #Seq.Elapsed := T#0ms;
        #Seq.DelayElapsed := T#0ms;
        #Seq.RecordedStep := #StepNo;
    END_IF;
    #Seq.Step := #StepNo;
    #Seq.StepName := #StepName;
    #Row.StepNo := #StepNo;
    #Row.Visited := TRUE;
    #Row.LastDuration := #Seq.Elapsed;
END_FUNCTION

FUNCTION "FRK_SeqAwait" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Label : String;
    Ok : Bool;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    #FRK_SeqAwait := #Ok;
    IF NOT #Ok AND NOT #Seq.Pending THEN
        #Seq.Pending := TRUE;
        #Seq.Awaiting := #Label;
    END_IF;
END_FUNCTION

FUNCTION "FRK_SeqDelay" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Permit : Bool;
    PT : Time;
    Delta : Time;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    IF #Permit AND #Delta > T#0ms THEN #Seq.DelayElapsed := #Seq.DelayElapsed + #Delta; END_IF;
    #FRK_SeqDelay := #Permit AND #Seq.DelayElapsed >= #PT;
END_FUNCTION

FUNCTION "FRK_SeqAdvance" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Ok : Bool;
    OnAdvance : DInt;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    IF #Ok AND #Seq.Running AND NOT #Seq.Error THEN
        #Seq.RetVal := @E_StepResult.ADVANCE@;
        #Seq.Step := #OnAdvance;
    END_IF;
END_FUNCTION

FUNCTION "FRK_SeqLease" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
    Lease : "ST_SequenceCommandLease";
    Execute : Bool;
END_VAR
BEGIN
    IF #Lease.Raised AND #Lease.OwnerIndex > 0 AND #Lease.ChainIndex > 0
        AND #Lease.OwnerIndex = #Seq.OwnerIndex AND #Lease.ChainIndex = #Seq.ChainIndex THEN
        IF NOT #Seq.Running OR #Seq.Error OR #Seq.Restart OR #Lease.Step <> #Seq.Step THEN
            #Execute := FALSE;
            #Lease.Raised := FALSE;
            #Lease.ReleasedScan := #Seq.Scan;
        END_IF;
    END_IF;
END_FUNCTION

FUNCTION "FRK_SeqCommand" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Value : DInt;
    Label : String;
    Ready : Bool;
    Done : Bool;
    Error : Bool;
    Diagnostic : "ST_Diagnostic";
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
    Lease : "ST_SequenceCommandLease";
    Execute : Bool;
    Command : DInt;
END_VAR
VAR_TEMP
    WaitOk : Bool;
END_VAR
BEGIN
    #FRK_SeqCommand := FALSE;
    IF NOT #Seq.Running OR #Seq.Error OR #Seq.OwnerIndex <= 0 OR #Seq.ChainIndex <= 0 THEN RETURN; END_IF;
    IF #Lease.Raised THEN
        IF #Lease.OwnerIndex <> #Seq.OwnerIndex OR #Lease.ChainIndex <> #Seq.ChainIndex
            OR #Lease.Step <> #Seq.Step OR #Command <> #Value THEN
            // Another chain owns this command; never borrow its Done result.
            #WaitOk := "FRK_SeqAwait"(Seq := #Seq, Label := 'std.release.commandOwned', Ok := FALSE);
            RETURN;
        END_IF;
        IF #Error THEN
            #Seq.Error := TRUE;
            #Seq.ErrorDiagnostic := #Diagnostic;
            #Execute := FALSE;
        ELSIF #Done THEN
            #FRK_SeqCommand := TRUE;
        ELSE
            #WaitOk := "FRK_SeqAwait"(Seq := #Seq, Label := #Label, Ok := FALSE);
        END_IF;
    ELSIF #Ready AND #Lease.ReleasedScan <> #Seq.Scan THEN
        #Lease.OwnerIndex := #Seq.OwnerIndex;
        #Lease.ChainIndex := #Seq.ChainIndex;
        #Lease.Step := #Seq.Step;
        #Lease.Raised := TRUE;
        #Command := #Value;
        #Execute := TRUE;
        #WaitOk := "FRK_SeqAwait"(Seq := #Seq, Label := #Label, Ok := FALSE);
    ELSE
        #WaitOk := "FRK_SeqAwait"(Seq := #Seq, Label := #Label, Ok := FALSE);
    END_IF;
END_FUNCTION
