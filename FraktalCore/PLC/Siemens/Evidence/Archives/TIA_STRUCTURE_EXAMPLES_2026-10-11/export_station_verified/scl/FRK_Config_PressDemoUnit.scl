FUNCTION "FRK_Config_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      ReadLevel : DInt;
      Readable : Bool;
   END_VAR

   VAR_IN_OUT 
      Module : "FB_PressDemoUnit";
      Cursor : "FRK_ConfigCursor";
      Page : "ST_ConfigPage";
   END_VAR


BEGIN
	
	"FRK_ConfigUnit"(Scope := #Module.Status.Name,
	                 Policy := #Module.ModePolicy,
	                 ModelCount := 0,
	                 ReadLevel := #ReadLevel,
	                 Readable := #Readable,
	                 Cursor := #Cursor,
	                 Page := #Page);
	"FRK_Config_CylinderCM"(Module := #Module.PressRam,
	                        ReadLevel := #ReadLevel,
	                        Readable := #Readable,
	                        Cursor := #Cursor,
	                        Page := #Page);
	"FRK_Config_CylinderCM"(Module := #Module.Door,
	                        ReadLevel := #ReadLevel,
	                        Readable := #Readable,
	                        Cursor := #Cursor,
	                        Page := #Page);
	"FRK_Config_CylinderCM"(Module := #Module.PartSlide,
	                        ReadLevel := #ReadLevel,
	                        Readable := #Readable,
	                        Cursor := #Cursor,
	                        Page := #Page);
	
END_FUNCTION

