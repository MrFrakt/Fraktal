FUNCTION "F_CylinderRetract" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
      Target : "FB_CylinderCM";
   END_VAR


BEGIN
	
	#F_CylinderRetract := "FRK_SeqCommand"(Seq := #Seq, Lease := #Target.Device.Lease,
	                                       Execute := #Target.Execute, Command := #Target.Command,
	                                       Value := 2, Label := 'Cylinder.RETRACT', Ready := #Target.Status.State = 0,
	                                       Done := #Target.Done, Error := #Target.Error, Diagnostic := #Target.Status.Diagnostic);
	
END_FUNCTION

