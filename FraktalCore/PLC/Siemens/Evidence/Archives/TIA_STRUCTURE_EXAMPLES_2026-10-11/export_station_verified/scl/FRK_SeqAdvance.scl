FUNCTION "FRK_SeqAdvance" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Ok : Bool;
      OnAdvance : DInt;
   END_VAR

   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
   END_VAR


BEGIN
	
	IF #Ok AND #Seq.Running AND NOT #Seq.Error THEN
	    #Seq.RetVal := 1;
	    #Seq.Step := #OnAdvance;
	END_IF;
	
END_FUNCTION

