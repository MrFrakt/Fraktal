    "FRK_LineDef"(FieldIndex := 6);
    "FRK_SetRuntime".Work[#RootIndex].RejectScope := #Scope; "FRK_SetRuntime".Work[#RootIndex].RejectKey := "FRK_ConfigScratch".Entry.WriteKey;
