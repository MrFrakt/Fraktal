        "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].ValueText := WSTRING_TO_STRING("FRK_ConfigScratch".Entry.ValueText);
        "FRK_SetRuntime".Work[#RootIndex].Payload.Info.RecordCount := #Slot;
    ELSE
        #Slot := "FRK_SetCheck"(RootIndex := #RootIndex, Scope := #Scope, Access := #Access, Ready := #Ready AND (#Phase = 4 OR "FRK_Line".Ready), WriteAccess := #Phase <> 3);
        IF #Slot = 0 THEN RETURN; END_IF;
        IF #Phase = 1 THEN
    "FRK_LineSetStage".Values.TaktMs := LINT_TO_UDINT("FRK_ConfigScratch".Value.Number);
        END_IF;
