FUNCTION "FRK_LineSetWalk" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    Scope : String;
    Phase : Int;
    Access : "FRK_Access";
    Ready : Bool;
END_VAR
VAR_TEMP
    Slot : Int;
END_VAR
BEGIN
    #FRK_LineSetWalk := FALSE;
    "FRK_SetRuntime".Work[#RootIndex].RejectScope := 'BenchLineOwner';
    IF NOT "FRK_LineScope"(Scope := #Scope) OR NOT "FRK_Line".Data.Applied
        OR "FRK_Line".Data.Status.Role <> 1 THEN RETURN; END_IF;
    IF #Phase = 2 THEN
        "FRK_Line".Data.Values := "FRK_LineSetStage".Values;
        "FRK_LineCommit"(State := "FRK_Line".Data);
        #FRK_LineSetWalk := TRUE; RETURN;
    END_IF;
    IF #Phase = 1 THEN "FRK_LineSetStage".Values := "FRK_Line".Data.Values; END_IF;
    "FRK_LineDef"(FieldIndex := 1);
    "FRK_SetRuntime".Work[#RootIndex].RejectScope := #Scope; "FRK_SetRuntime".Work[#RootIndex].RejectKey := "FRK_ConfigScratch".Entry.WriteKey;
    IF #Phase = 0 OR #Phase = 5 THEN
        IF #Access.CurrentLevel < MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead) THEN RETURN; END_IF;
        "FRK_LineValue"(FieldIndex := 1, Values := "FRK_Line".Data.Values);
        IF NOT "FRK_ConfigValidate"(Text := "FRK_ConfigScratch".Entry.ValueText)
            OR "FRK_SetRuntime".Work[#RootIndex].Payload.Info.RecordCount >= 30 THEN RETURN; END_IF;
        #Slot := "FRK_SetRuntime".Work[#RootIndex].Payload.Info.RecordCount + 1;
        "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].Scope := #Scope;
