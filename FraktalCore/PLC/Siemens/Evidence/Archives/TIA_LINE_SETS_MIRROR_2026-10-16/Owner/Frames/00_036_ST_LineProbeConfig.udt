TYPE "ST_LineProbeConfig"
VERSION : 0.1
   STRUCT
      "SchemaVersion" : UInt := 1;
      "TaktMs" : UDInt := 1000;
      "Gain" : LReal := 1.25;
      "Grade" : DInt := 1;
      "Enabled" : Bool := TRUE;
      "HostName" : String[40] := 'press-line';
      "Offsets" : Array[0..1] of Int;
      "Small" : USInt := 7;
   END_STRUCT;
END_TYPE
