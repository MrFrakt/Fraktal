// Shared sequence services. The examples generator binds Core enum constants.
FUNCTION "FRK_SeqBegin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Run : Bool;
    Reset : Bool;
    OwnerIndex : DInt;
    ChainIndex : DInt;
    BranchIndex : DInt;
    ViewOffset : DInt;
    ViewDepth : Int;
    Delta : Time;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
VAR_TEMP Life : "FRK_SequenceLifecycle"; Boundary : Bool; END_VAR
BEGIN
    #Seq.Scan := #Seq.Scan + 1;
    "FRK_SeqLifecycleRead"(Owner := #OwnerIndex, Life := #Life);
    #Boundary := NOT #Seq.Initialized OR #Seq.RestartEpoch <> #Life.RestartEpoch;
    #Seq.RestartPending := #Seq.RestartPending OR #Boundary;
    #Seq.Rearm := FALSE;
    IF NOT #Boundary AND #Seq.ResumeEpoch <> #Life.ResumeEpoch AND #Seq.Frozen THEN
        // Leaving ERROR only re-arms. A new accepted Unit Start is still needed.
        #Seq.ResumePending := NOT #Seq.RestartPending;
        #Seq.Error := FALSE;
        #Seq.Rearm := TRUE;
        #Seq.Visit := #Seq.Visit + 1;
        #Seq.EventVisit := #Seq.Visit - 1;
        #Seq.Warned := FALSE;
        #Seq.StartLatched := FALSE;
        #Seq.Elapsed := T#0ms; #Seq.DelayElapsed := T#0ms;
        #Seq.ErrorDiagnostic.ReasonCode := @E_Reason.NONE@;
    END_IF;
    IF #Life.Faulted AND (#Seq.RunPrevious OR #Seq.Error OR #Seq.Frozen) THEN #Seq.Frozen := TRUE; END_IF;
    #Seq.Restart := #Boundary OR (#Run AND #Seq.RestartPending) OR (#Reset AND NOT #Life.Faulted)
        OR (#Run AND NOT #Seq.RunPrevious AND NOT #Seq.Frozen AND NOT #Seq.ResumePending);
    #Seq.Initialized := TRUE;
    #Seq.RestartEpoch := #Life.RestartEpoch; #Seq.ResumeEpoch := #Life.ResumeEpoch;
    #Seq.OwnerIndex := #OwnerIndex;
    #Seq.ChainIndex := #ChainIndex;
    #Seq.BranchIndex := #BranchIndex;
    #Seq.ViewOffset := #ViewOffset;
    #Seq.ViewDepth := #ViewDepth;
    #Seq.RetVal := @E_StepResult.NONE@;
    #Seq.Pending := FALSE;
    #Seq.CommandFailed := FALSE;
    #Seq.CommandIssued := FALSE;
    #Seq.Awaiting := '';
    IF #Seq.Restart OR (NOT #Run AND NOT #Seq.Frozen AND NOT #Seq.ResumePending) THEN
        #Seq.Step := 0;
        #Seq.RecordedStep := -1;
        #Seq.Visit := #Seq.Visit + 1;
        #Seq.Done := FALSE;
        #Seq.Error := FALSE;
        #Seq.StartLatched := FALSE;
        #Seq.Frozen := FALSE; #Seq.ResumePending := FALSE;
        #Seq.Elapsed := T#0ms;
        #Seq.DelayElapsed := T#0ms;
        #Seq.ErrorDiagnostic.ReasonCode := @E_Reason.NONE@;
    END_IF;
    #Seq.Running := #Run AND NOT #Seq.Done AND NOT #Seq.Error AND NOT #Life.Faulted
        AND #Life.Valid AND #OwnerIndex > 0 AND #ChainIndex > 0;
    IF #Seq.Running AND #Seq.ResumePending THEN #Seq.Frozen := FALSE; #Seq.ResumePending := FALSE; END_IF;
    IF #Seq.Running THEN #Seq.RestartPending := FALSE; END_IF;
    #Seq.SubReset := #Seq.Restart OR #Seq.Rearm;
    #Seq.RunPrevious := #Run;
    #Seq.ScanStep := #Seq.Step;
    IF #Seq.Running AND #Delta > T#0ms THEN #Seq.Elapsed := #Seq.Elapsed + #Delta; END_IF;
END_FUNCTION

FUNCTION "FRK_SeqGraphBegin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Run : Bool; Reset : Bool; OwnerIndex : DInt; ChainIndex : DInt;
    BranchIndex : DInt; ViewOffset : DInt; ViewDepth : Int; Delta : Time;
END_VAR
VAR_IN_OUT Seq : "FRK_SequenceCtx"; END_VAR
VAR_TEMP PreviousResult : DInt; END_VAR
BEGIN
    // Native GRAPH evaluates transitions before the new step's actions.
    // Preserve exactly the preceding active scan's result for that evaluation;
    // the mandatory step record clears it before the current action decides.
    #PreviousResult := #Seq.RetVal;
    "FRK_SeqBegin"(Run := #Run, Reset := #Reset, OwnerIndex := #OwnerIndex,
        ChainIndex := #ChainIndex, BranchIndex := #BranchIndex, ViewOffset := #ViewOffset,
        ViewDepth := #ViewDepth, Delta := #Delta, Seq := #Seq);
    IF #Seq.Running AND NOT #Seq.Restart AND NOT #Seq.Rearm THEN #Seq.RetVal := #PreviousResult; END_IF;
END_FUNCTION

FUNCTION "FRK_SeqStart" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    StartPulse : Bool;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    IF #Seq.Running THEN #Seq.StartLatched := #Seq.StartLatched OR #StartPulse; END_IF;
END_FUNCTION

FUNCTION "FRK_SeqCycleEnd" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    #Seq.StartLatched := FALSE;
    IF #Seq.BranchIndex = 0 THEN "FRK_SeqProfileComplete"(Owner := #Seq.OwnerIndex); END_IF;
END_FUNCTION

FUNCTION "FRK_SeqComplete" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    #Seq.Done := TRUE;
    #Seq.Running := FALSE;
END_FUNCTION

FUNCTION "FRK_SeqAt" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    StepNo : DInt;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    // Capture dispatch once: a forward LD transition cannot execute the next
    // state's rung in this scan or hide an Execute-low reset scan.
    #FRK_SeqAt := #Seq.Running AND NOT #Seq.Error AND #Seq.ScanStep = #StepNo;
END_FUNCTION

FUNCTION "FRK_SeqStep" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    StepNo : DInt;
    StepName : String;
    AwaitingLabel : String;
    AwaitsPath : String;
    TimeClass : DInt;
    ExpectedTime : Time;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
    Row : "FRK_SequenceRow";
END_VAR
BEGIN
    #Seq.RetVal := @E_StepResult.NONE@;
    IF NOT #Seq.Running OR #Seq.Error THEN RETURN; END_IF;
    IF #Seq.RecordedStep <> #StepNo THEN
        #Seq.Visit := #Seq.Visit + 1;
        #Seq.Elapsed := T#0ms;
        #Seq.DelayElapsed := T#0ms;
        #Seq.RecordedStep := #StepNo;
        #Seq.Warned := FALSE;
    END_IF;
    #Seq.Step := #StepNo;
    #Seq.StepName := #StepName;
    #Row.StepNo := #StepNo;
    #Row.Visited := TRUE;
    #Row.LastDuration := #Seq.Elapsed;
    "FRK_SeqViewStep"(Owner := #Seq.OwnerIndex, StepNo := #StepNo + #Seq.ViewOffset,
        Branch := #Seq.BranchIndex, Depth := #Seq.ViewDepth, Visit := #Seq.Visit, StepName := #StepName,
        AwaitingLabel := #AwaitingLabel, AwaitsPath := #AwaitsPath, TimeClass := #TimeClass,
        ExpectedTime := #ExpectedTime, Elapsed := #Seq.Elapsed);
END_FUNCTION

FUNCTION "FRK_SeqAwait" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Label : String;
    Ok : Bool;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    #FRK_SeqAwait := #Ok;
    "FRK_SeqViewAwait"(Owner := #Seq.OwnerIndex, StepNo := #Seq.RecordedStep + #Seq.ViewOffset,
        Branch := #Seq.BranchIndex, Label := #Label, Ok := #Ok);
    IF NOT #Ok AND NOT #Seq.Pending THEN
        #Seq.Pending := TRUE;
        #Seq.Awaiting := #Label;
    END_IF;
END_FUNCTION

FUNCTION "FRK_SeqDelay" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Permit : Bool;
    PT : Time;
    Delta : Time;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    #FRK_SeqDelay := FALSE;
    IF NOT #Seq.Running OR #Seq.Error THEN RETURN; END_IF;
    IF #Permit AND #Delta > T#0ms THEN #Seq.DelayElapsed := #Seq.DelayElapsed + #Delta; END_IF;
    #FRK_SeqDelay := #Permit AND #Seq.DelayElapsed >= #PT;
END_FUNCTION

FUNCTION "FRK_SeqAdvance" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Ok : Bool;
    OnAdvance : DInt;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
END_VAR
BEGIN
    "FRK_SeqSelect"(Seq := #Seq, AdvanceOk := #Ok, Jump1Ok := FALSE);
    "FRK_SeqRoute"(Seq := #Seq, OnAdvance := #OnAdvance, OnJump1 := -1);
END_FUNCTION

FUNCTION "FRK_SeqLease" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT TargetIndex : DInt; END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
    Lease : "ST_SequenceCommandLease";
    Execute : Bool;
    Abort : Bool;
END_VAR
VAR_TEMP Slot : Int; END_VAR
BEGIN
    IF #Lease.OwnerIndex = #Seq.OwnerIndex AND #Lease.ChainIndex = #Seq.ChainIndex AND #Lease.BranchIndex = #Seq.BranchIndex
        AND #Lease.AbortIssued AND #Lease.ReleasedScan <> #Seq.Scan THEN
        #Abort := FALSE; #Lease.AbortIssued := FALSE;
    END_IF;
    IF #Lease.Raised AND #Lease.OwnerIndex > 0 AND #Lease.ChainIndex > 0
        AND #Lease.OwnerIndex = #Seq.OwnerIndex AND #Lease.ChainIndex = #Seq.ChainIndex
        AND #Lease.BranchIndex = #Seq.BranchIndex THEN
        IF NOT #Seq.Running OR #Seq.Error OR #Seq.Restart OR #Seq.Rearm OR #Lease.Step <> #Seq.Step THEN
            #Slot := "FRK_DiagSlot"(Index := #TargetIndex);
            IF #Slot > 0 THEN
                #Abort := "FRK_Diagnostics".Samples[#Slot].Valid AND "FRK_Diagnostics".Samples[#Slot].State = @E_ExecState.BUSY@;
                #Lease.AbortIssued := #Abort;
            END_IF;
            #Execute := FALSE;
            #Lease.Raised := FALSE;
            #Lease.ReleasedScan := #Seq.Scan;
        END_IF;
    END_IF;
END_FUNCTION

FUNCTION "FRK_SeqCommand" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Value : DInt;
    Label : String;
    TargetIndex : DInt;
    OwnFailure : Bool;
END_VAR
VAR_IN_OUT
    Seq : "FRK_SequenceCtx";
    Lease : "ST_SequenceCommandLease";
    Execute : Bool;
    Command : DInt;
END_VAR
VAR_TEMP
    WaitOk : Bool;
    Summary : "FRK_DiagSummary";
    WaitLabel : String[120];
END_VAR
BEGIN
    #FRK_SeqCommand := FALSE;
    IF NOT #Seq.Running OR #Seq.Error OR #Seq.OwnerIndex <= 0 OR #Seq.ChainIndex <= 0 THEN RETURN; END_IF;
    "FRK_DiagRead"(Owner := #Seq.OwnerIndex, Target := #TargetIndex, Faults := TRUE, DescendantsOnly := FALSE, Summary := #Summary);
    IF NOT #Summary.Valid THEN
        #Seq.Error := TRUE;
        #Seq.ErrorDiagnostic := "FRK_Diagnostics".Empty.Diagnostic;
        #Seq.ErrorDiagnostic.ReasonCode := @E_Reason.DEVICE_NOT_READY@;
        #Seq.ErrorDiagnostic.Description := WSTRING#'std.error.hmiRequestRejected';
        #Seq.ErrorDiagnostic.SourcePath := STRING_TO_WSTRING("FRK_DiagName"(Index := #Seq.OwnerIndex));
        #Seq.ErrorDiagnostic.Severity := @E_Severity.MED@;
        #Seq.ErrorDiagnostic.Since := "FRK_Now"();
        "FRK_Rationalize"(Diag := #Seq.ErrorDiagnostic);
        "FRK_SeqViewFail"(Owner := #Seq.OwnerIndex, StepNo := #Seq.RecordedStep + #Seq.ViewOffset,
            Branch := #Seq.BranchIndex, Diag := #Seq.ErrorDiagnostic);
        #Execute := FALSE;
        RETURN;
    END_IF;
    #WaitLabel := "FRK_DiagName"(Index := #TargetIndex);
    #WaitLabel := CONCAT(IN1 := #WaitLabel, IN2 := '.');
    #WaitLabel := CONCAT(IN1 := #WaitLabel, IN2 := #Label);
    IF #Lease.Raised THEN
        IF #Lease.OwnerIndex <> #Seq.OwnerIndex OR #Lease.ChainIndex <> #Seq.ChainIndex OR #Lease.BranchIndex <> #Seq.BranchIndex
            OR #Lease.Step <> #Seq.Step OR #Command <> #Value THEN
            // Another chain owns this command; never borrow its Done result.
            #WaitOk := "FRK_SeqAwait"(Seq := #Seq, Label := 'std.release.commandOwned', Ok := FALSE);
            RETURN;
        END_IF;
        "FRK_SeqViewWatch"(Owner := #Seq.OwnerIndex, StepNo := #Seq.RecordedStep + #Seq.ViewOffset,
            Branch := #Seq.BranchIndex, Target := #TargetIndex, Waiting := #Summary.State <> @E_ExecState.DONE@, OwnFailure := #OwnFailure);
        IF #Summary.Fault THEN
            IF #OwnFailure THEN
                #Seq.CommandFailed := TRUE;
                #Seq.HandledDiagnostic := #Summary.Diagnostic;
            ELSE
                #Seq.Error := TRUE;
                #Seq.ErrorDiagnostic := #Summary.Diagnostic;
                "FRK_SeqViewNote"(Owner := #Seq.OwnerIndex, StepNo := #Seq.RecordedStep + #Seq.ViewOffset,
                    Branch := #Seq.BranchIndex, IsError := TRUE, Key := WSTRING_TO_STRING(#Summary.Diagnostic.Description), SourcePath := WSTRING_TO_STRING(#Summary.Diagnostic.SourcePath));
            END_IF;
            #Execute := FALSE;
        ELSIF #Summary.State = @E_ExecState.DONE@ THEN
            #FRK_SeqCommand := TRUE;
        ELSE
            #WaitOk := "FRK_SeqAwait"(Seq := #Seq, Label := #WaitLabel, Ok := FALSE);
        END_IF;
    ELSIF #Summary.State = @E_ExecState.READY@ AND NOT #Summary.Fault AND #Lease.ReleasedScan <> #Seq.Scan THEN
        #Lease.OwnerIndex := #Seq.OwnerIndex;
        #Lease.ChainIndex := #Seq.ChainIndex;
        #Lease.BranchIndex := #Seq.BranchIndex;
        #Lease.Step := #Seq.Step;
        #Lease.Raised := TRUE;
        #Seq.CommandIssued := TRUE;
        #Command := #Value;
        #Execute := TRUE;
        "FRK_SeqViewWatch"(Owner := #Seq.OwnerIndex, StepNo := #Seq.RecordedStep + #Seq.ViewOffset,
            Branch := #Seq.BranchIndex, Target := #TargetIndex, Waiting := TRUE, OwnFailure := TRUE);
        #WaitOk := "FRK_SeqAwait"(Seq := #Seq, Label := #WaitLabel, Ok := FALSE);
    ELSE
        "FRK_SeqViewWatch"(Owner := #Seq.OwnerIndex, StepNo := #Seq.RecordedStep + #Seq.ViewOffset,
            Branch := #Seq.BranchIndex, Target := #TargetIndex, Waiting := TRUE, OwnFailure := TRUE);
        #WaitOk := "FRK_SeqAwait"(Seq := #Seq, Label := #WaitLabel, Ok := FALSE);
    END_IF;
END_FUNCTION
