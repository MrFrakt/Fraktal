    Hal : "ST_CylinderHal";
    Report : "ST_ReleaseReport";
END_VAR
VAR_TEMP
    RouteMatched : Bool;
    Index : Int;
END_VAR
BEGIN
    #FRK_Route_CylinderCM := FALSE;
    IF NOT "FRK_PathOwned"(OwnerPath := #Module.Status.Name, TargetPath := #Request.TargetPath) THEN RETURN; END_IF;
    IF #Request.TargetPath = STRING_TO_WSTRING(#Module.Status.Name) THEN
        FOR #Index := 1 TO 16 DO #Module.ManConditions[#Index].Used := FALSE; END_FOR;
        // ---- AUTHORED: OnManRelease
    "FRK_ManualCondition"(Conditions := #Module.ManConditions, Slot := 1, Value := 1, Ok := #Hal.ExtendPermit, Diag := #Hal.PermitDiagnostic, Bypassable := FALSE);
    "FRK_ManualCondition"(Conditions := #Module.ManConditions, Slot := 2, Value := 2, Ok := #Hal.RetractPermit, Diag := #Hal.RetractDiagnostic, Bypassable := FALSE);

        // ---- GENERATED: manual release end
        "FRK_ManualApply"(Core := #Module.Core, Status := #Module.Status, Request := #Request, Commands := #Module.Catalog, Count := #Module.CatalogCount, Conditions := #Module.ManConditions, Report := #Report, Execute := #Module.Execute, Command := #Module.Command, ManualOwned := #Module.ManualOwned);
        #FRK_Route_CylinderCM := TRUE;
        RETURN;
    END_IF;
END_FUNCTION
