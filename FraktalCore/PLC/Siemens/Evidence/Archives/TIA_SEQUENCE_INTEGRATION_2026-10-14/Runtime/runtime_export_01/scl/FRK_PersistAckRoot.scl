	    "FRK_PersistConsumers".Rows[5].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 5);
	    "FRK_PersistDirty"(Slot := 5);
	END_IF;
	IF #RootIndex = 1 AND "FRK_PersistConsumers".Rows[6].Rejected THEN
	    "FRK_PersistConsumers".Rows[6].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 6);
	    "FRK_PersistDirty"(Slot := 6);
	END_IF;
	IF #RootIndex = 1 AND "FRK_PersistConsumers".Rows[7].Rejected THEN
	    "FRK_PersistConsumers".Rows[7].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 7);
	    "FRK_PersistDirty"(Slot := 7);
	END_IF;
	IF #RootIndex = 1 AND "FRK_PersistConsumers".Rows[8].Rejected THEN
	    "FRK_PersistConsumers".Rows[8].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 8);
	    "FRK_PersistDirty"(Slot := 8);
	END_IF;
	IF #RootIndex = 2 AND "FRK_PersistConsumers".Rows[9].Rejected THEN
	    "FRK_PersistConsumers".Rows[9].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 9);
	    "FRK_PersistDirty"(Slot := 9);
	END_IF;
	IF #RootIndex = 2 AND "FRK_PersistConsumers".Rows[10].Rejected THEN
	    "FRK_PersistConsumers".Rows[10].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 10);
	    "FRK_PersistDirty"(Slot := 10);
	END_IF;
	IF #RootIndex = 2 AND "FRK_PersistConsumers".Rows[11].Rejected THEN
	    "FRK_PersistConsumers".Rows[11].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 11);
	    "FRK_PersistDirty"(Slot := 11);
	END_IF;
	IF #RootIndex = 2 AND "FRK_PersistConsumers".Rows[12].Rejected THEN
	    "FRK_PersistConsumers".Rows[12].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 12);
	    "FRK_PersistDirty"(Slot := 12);
	END_IF;
	IF #RootIndex = 2 AND "FRK_PersistConsumers".Rows[13].Rejected THEN
	    "FRK_PersistConsumers".Rows[13].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 13);
	    "FRK_PersistDirty"(Slot := 13);
	END_IF;
	IF #RootIndex = 2 AND "FRK_PersistConsumers".Rows[14].Rejected THEN
