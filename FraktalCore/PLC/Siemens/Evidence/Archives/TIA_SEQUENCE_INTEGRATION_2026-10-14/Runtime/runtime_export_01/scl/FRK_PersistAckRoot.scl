FUNCTION "FRK_PersistAckRoot" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      RootIndex : Int;
   END_VAR


BEGIN
	
	IF #RootIndex = 1 AND "FRK_PersistConsumers".Rows[1].Rejected THEN
	    "FRK_PersistConsumers".Rows[1].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 1);
	    "FRK_PersistDirty"(Slot := 1);
	END_IF;
	IF #RootIndex = 1 AND "FRK_PersistConsumers".Rows[2].Rejected THEN
	    "FRK_PersistConsumers".Rows[2].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 2);
	    "FRK_PersistDirty"(Slot := 2);
	END_IF;
