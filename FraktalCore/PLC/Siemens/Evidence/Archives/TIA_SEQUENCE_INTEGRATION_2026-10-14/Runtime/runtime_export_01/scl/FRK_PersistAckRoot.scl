	    "FRK_PersistDirty"(Slot := 14);
	END_IF;
	IF #RootIndex = 2 AND "FRK_PersistConsumers".Rows[15].Rejected THEN
	    "FRK_PersistConsumers".Rows[15].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 15);
	    "FRK_PersistDirty"(Slot := 15);
	END_IF;
	IF #RootIndex = 2 AND "FRK_PersistConsumers".Rows[16].Rejected THEN
	    "FRK_PersistConsumers".Rows[16].Acknowledged := TRUE;
	    "FRK_PersistRepair"(Slot := 16);
	    "FRK_PersistDirty"(Slot := 16);
	END_IF;
	
END_FUNCTION

