FUNCTION "FRK_DocCapture_D002" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D002 := FALSE;
	"FRK_PersistImages".D002.SchemaVersion := 1;
	"FRK_PersistImages".D002.Scope := 'PressDemo';
	#Stored := 0;
	FOR #Index := 1 TO 1 DO
	    IF "FRK_AccessPolicies".Rows[#Index].Scope = 'PressDemo' THEN
	        #Stored := #Index;
	    END_IF;
	END_FOR;
	IF #Stored = 0 THEN
	    RETURN;
	END_IF;
	"FRK_PersistImages".D002.Image := "FRK_AccessPolicies".Rows[#Stored];
	IF NOT "FRK_AccessPolicyValid"(Image := "FRK_PersistImages".D002.Image) THEN
	    RETURN;
	END_IF;
	FOR #Index := 0 TO 413 DO
	    "FRK_PersistBuffers".D002Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D002, DEST_ARRAY => "FRK_PersistBuffers".D002Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 414 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D002 := TRUE;
	
END_FUNCTION

