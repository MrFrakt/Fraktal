FUNCTION "FRK_SeqViewBegin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Owner : DInt;
    Clear : Bool;
    ResetErrors : Bool;
END_VAR
VAR_IN_OUT
    Enabled : Bool;
END_VAR
BEGIN
