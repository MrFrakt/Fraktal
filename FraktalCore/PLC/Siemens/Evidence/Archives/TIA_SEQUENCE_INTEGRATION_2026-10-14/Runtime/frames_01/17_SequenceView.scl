    CASE #Owner OF
        1: "FRK_ViewAwait"(StepNo := #StepNo, Branch := #Branch, Label := #Label, Ok := #Ok, Defs := "FRK_Views".V001.Defs, Cursors := "FRK_Views".V001.Cursors, Count := "FRK_Views".V001.Count, Current := "FRK_Views".V001.Current, Book := "FRK_Views".V001.Book);
        5: "FRK_ViewAwait"(StepNo := #StepNo, Branch := #Branch, Label := #Label, Ok := #Ok, Defs := "FRK_Views".V005.Defs, Cursors := "FRK_Views".V005.Cursors, Count := "FRK_Views".V005.Count, Current := "FRK_Views".V005.Current, Book := "FRK_Views".V005.Book);
        9: "FRK_ViewAwait"(StepNo := #StepNo, Branch := #Branch, Label := #Label, Ok := #Ok, Defs := "FRK_Views".V009.Defs, Cursors := "FRK_Views".V009.Cursors, Count := "FRK_Views".V009.Count, Current := "FRK_Views".V009.Current, Book := "FRK_Views".V009.Book);
