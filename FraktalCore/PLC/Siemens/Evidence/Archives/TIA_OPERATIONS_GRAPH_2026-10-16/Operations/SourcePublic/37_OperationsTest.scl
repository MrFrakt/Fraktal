FUNCTION_BLOCK "FB_OperationsTest"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_OUTPUT
    Done {ExternalWritable := 'False'} : Bool;
    Checks {ExternalWritable := 'False'} : Int;
    Failures {ExternalWritable := 'False'} : Int;
    FirstFailure {ExternalWritable := 'False'} : Int;
END_VAR
VAR
    Result {ExternalWritable := 'False'} : "FRK_TestResult";
    Ran {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
    Book {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_Production";
    Oee {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_Oee";
    Trend {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[1..60] of "ST_OeeSample";
    Unit {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_Unit";
    Calendar {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_ShiftCalendarV3";
    AlarmLog {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_AlarmLog";
    Access {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_Access";
    Response {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_HmiResponse";
    Ok {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
    Index {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
    Machine {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DInt;
    Selected {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
    StartAt {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : LDT;
    EndAt {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : LDT;
    Target {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : UDInt;
    CurrentShift {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
    StartedAt {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : LDT;
    ProductionTarget {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : UDInt;
    History {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[1..8] of "ST_ShiftRecordV3";
    HistoryCount {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
    Truncated {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
    HealthInput {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_SystemHealthInput";
    HealthConfig {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_SystemHealthParCfg";
    HealthStatus {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_SystemHealthStatus";
    HealthBook {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_HealthBook";
    EngineeringSlots {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[1..1] of Int;
    ShelfSlot {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
    TestDiag {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_Diagnostic";
    TowerConfig {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_SignalTowerParCfg";
    TowerBook {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_TowerBook";
    TowerStatus {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_SignalTowerOut";
    TestCore {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_Core";
    Support {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0..2] of Bool;
    HostView {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_HostEvents";
    HostSeen {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : UDInt;
END_VAR
BEGIN
    IF NOT #Ran THEN
        #Book := "FRK_ProductionDefaults".Book;
        #Oee := "FRK_ProductionDefaults".Oee;
        #Unit.Good := 0; #Unit.Nok := 0; #Unit.Rework := 0;
        "FRK_OeeTick"(NowMs := 0, Exec := 1, Blocking := FALSE, Good := 0, Nok := 0, IdealCycleMs := 0, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_TestAssert"(Condition := NOT #Oee.OeeValid AND NOT #Oee.AvailValid AND NOT #Oee.PerfValid AND NOT #Oee.QualValid, Code := 1, Result := #Result);
        "FRK_OeeTick"(NowMs := 1000, Exec := 1, Blocking := FALSE, Good := 3, Nok := 1, IdealCycleMs := 100, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_TestAssert"(Condition := #Oee.RunMs = 1000 AND #Oee.DownMs = 0 AND #Oee.IdleMs = 0, Code := 2, Result := #Result);
        "FRK_TestAssert"(Condition := ABS(#Oee.Quality - 0.75) < 0.00001 AND ABS(#Oee.Performance - 0.4) < 0.00001 AND ABS(#Oee.Oee - 0.3) < 0.00001, Code := 3, Result := #Result);
        "FRK_OeeTick"(NowMs := 2000, Exec := 1, Blocking := TRUE, Good := 3, Nok := 1, IdealCycleMs := 100, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_TestAssert"(Condition := #Oee.RunMs = 1000 AND #Oee.DownMs = 1000, Code := 4, Result := #Result);
        "FRK_OeeTick"(NowMs := 2500, Exec := 0, Blocking := FALSE, Good := 3, Nok := 1, IdealCycleMs := 0, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_TestAssert"(Condition := #Oee.IdleMs = 500 AND NOT #Oee.PerfValid AND ABS(#Oee.Oee - 0.375) < 0.00001, Code := 5, Result := #Result);
        #Book := "FRK_ProductionDefaults".Book;
        #Oee := "FRK_ProductionDefaults".Oee;
        #Unit.Good := 0; #Unit.Nok := 0; #Unit.Rework := 0;
        "FRK_OeeTick"(NowMs := 4294967290, Exec := 1, Blocking := FALSE, Good := 0, Nok := 0, IdealCycleMs := 100, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_OeeTick"(NowMs := 4, Exec := 1, Blocking := FALSE, Good := 0, Nok := 0, IdealCycleMs := 100, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_TestAssert"(Condition := #Oee.RunMs = 10, Code := 6, Result := #Result);
        #Oee.RunMs := UDINT#4294967290;
        "FRK_OeeTick"(NowMs := 14, Exec := 1, Blocking := FALSE, Good := 0, Nok := 0, IdealCycleMs := 100, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_TestAssert"(Condition := #Oee.RunMs = UDINT#4294967295, Code := 7, Result := #Result);
        #Book := "FRK_ProductionDefaults".Book;
        #Oee := "FRK_ProductionDefaults".Oee;
        #Unit.Good := 0; #Unit.Nok := 0; #Unit.Rework := 0;
        "FRK_OeeTick"(NowMs := 0, Exec := 1, Blocking := FALSE, Good := 0, Nok := 0, IdealCycleMs := 100, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_OeeTick"(NowMs := 60000, Exec := 1, Blocking := FALSE, Good := 1000, Nok := 0, IdealCycleMs := 1000, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_TestAssert"(Condition := #Book.TrendHead = 1 AND #Trend[1].OeeValid AND #Oee.Performance = 1.0, Code := 8, Result := #Result);
        "FRK_OeeReset"(Good := 1000, Nok := 0, Book := #Book, Oee := #Oee, Trend := #Trend);
        "FRK_TestAssert"(Condition := #Book.TrendHead = 0 AND #Book.ManualReset AND #Book.GoodBase = 1000 AND NOT #Oee.OeeValid, Code := 9, Result := #Result);
        #Machine := "FRK_MachineState"(Exec := 3, Mode := 0, Blocking := FALSE, Starved := FALSE, Blocked := FALSE, StopRequested := FALSE);
        "FRK_TestAssert"(Condition := #Machine = 4, Code := 10, Result := #Result);
        #Machine := "FRK_MachineState"(Exec := 1, Mode := 0, Blocking := TRUE, Starved := TRUE, Blocked := TRUE, StopRequested := FALSE);
        "FRK_TestAssert"(Condition := #Machine = 4, Code := 11, Result := #Result);
        #Machine := "FRK_MachineState"(Exec := 1, Mode := 3, Blocking := FALSE, Starved := TRUE, Blocked := TRUE, StopRequested := FALSE);
        "FRK_TestAssert"(Condition := #Machine = 5, Code := 12, Result := #Result);
        #Machine := "FRK_MachineState"(Exec := 1, Mode := 0, Blocking := FALSE, Starved := TRUE, Blocked := TRUE, StopRequested := FALSE);
        "FRK_TestAssert"(Condition := #Machine = 2, Code := 13, Result := #Result);
        #Machine := "FRK_MachineState"(Exec := 1, Mode := 0, Blocking := FALSE, Starved := TRUE, Blocked := FALSE, StopRequested := FALSE);
        "FRK_TestAssert"(Condition := #Machine = 3, Code := 14, Result := #Result);
        #Machine := "FRK_MachineState"(Exec := 1, Mode := 0, Blocking := FALSE, Starved := FALSE, Blocked := FALSE, StopRequested := FALSE);
        "FRK_TestAssert"(Condition := #Machine = 0, Code := 15, Result := #Result);
        #Machine := "FRK_MachineState"(Exec := 0, Mode := 1, Blocking := FALSE, Starved := FALSE, Blocked := FALSE, StopRequested := TRUE);
        "FRK_TestAssert"(Condition := #Machine = 6, Code := 16, Result := #Result);
        #Machine := "FRK_MachineState"(Exec := 0, Mode := 1, Blocking := FALSE, Starved := FALSE, Blocked := FALSE, StopRequested := FALSE);
        "FRK_TestAssert"(Condition := #Machine = 1, Code := 17, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := #Ok, Code := 18, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Calendar.SchemaVersion := 2;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := NOT #Ok, Code := 19, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Calendar.UtcOffsetMin := 841;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := NOT #Ok, Code := 20, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Calendar.Rows[1].StartMin := 1440;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := NOT #Ok, Code := 21, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Calendar.Rows[1].DurationMin := 0;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := NOT #Ok, Code := 22, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Calendar.Rows[1].ActiveDays := 128;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := NOT #Ok, Code := 23, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Calendar.Rows[1].ProductionTarget := -1;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := NOT #Ok, Code := 24, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Calendar.Rows[1].StartMin := 480; #Calendar.Rows[1].DurationMin := 720; #Calendar.Rows[1].ActiveDays := 96; #Calendar.Rows[1].ProductionTarget := 500;
        #Ok := "FRK_ShiftInterval"(Now := LDT#2026-10-17-08:00:00, Calendar := #Calendar, ShiftIndex => #Selected, StartAt => #StartAt, EndAt => #EndAt, Target => #Target);
        "FRK_TestAssert"(Condition := #Ok AND #Selected = 1 AND #Target = 500 AND #EndAt = LDT#2026-10-17-20:00:00, Code := 25, Result := #Result);
        #Ok := "FRK_ShiftInterval"(Now := LDT#2026-10-17-20:00:00, Calendar := #Calendar, ShiftIndex => #Selected, StartAt => #StartAt, EndAt => #EndAt, Target => #Target);
        "FRK_TestAssert"(Condition := #Ok AND #Selected = 0 AND #Target = 0 AND #EndAt = LDT#2026-10-18-08:00:00, Code := 26, Result := #Result);
        #Calendar.UtcOffsetMin := 60;
        #Ok := "FRK_ShiftInterval"(Now := LDT#2026-10-17-07:00:00, Calendar := #Calendar, ShiftIndex => #Selected, StartAt => #StartAt, EndAt => #EndAt, Target => #Target);
        "FRK_TestAssert"(Condition := #Ok AND #Selected = 1 AND #StartAt = LDT#2026-10-17-07:00:00, Code := 27, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Calendar.Rows[1].StartMin := 1380; #Calendar.Rows[1].DurationMin := 120; #Calendar.Rows[1].ActiveDays := 64;
        #Ok := "FRK_ShiftInterval"(Now := LDT#2026-10-19-00:30:00, Calendar := #Calendar, ShiftIndex => #Selected, StartAt => #StartAt, EndAt => #EndAt, Target => #Target);
        "FRK_TestAssert"(Condition := #Ok AND #Selected = 1 AND #StartAt = LDT#2026-10-18-23:00:00, Code := 28, Result := #Result);
        #Calendar.Rows[2].StartMin := 0; #Calendar.Rows[2].DurationMin := 60; #Calendar.Rows[2].ActiveDays := 1;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := NOT #Ok, Code := 29, Result := #Result);
        #Calendar.Rows[2].StartMin := 60;
        #Ok := "FRK_ShiftValidate"(Calendar := #Calendar);
        "FRK_TestAssert"(Condition := #Ok, Code := 30, Result := #Result);
        #Calendar.SchemaVersion := 3; #Calendar.UtcOffsetMin := 0;
        FOR #Index := 1 TO 5 DO
            #Calendar.Rows[#Index].StartMin := -1; #Calendar.Rows[#Index].DurationMin := 1440;
            #Calendar.Rows[#Index].ActiveDays := 0; #Calendar.Rows[#Index].ProductionTarget := 0;
        END_FOR;
        #Book := "FRK_ProductionDefaults".Book;
        #Oee := "FRK_ProductionDefaults".Oee;
        #Unit.Good := 0; #Unit.Nok := 0; #Unit.Rework := 0;
        #HistoryCount := 0; #Truncated := FALSE;
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-17-06:00:00, Synchronized := TRUE, Revision := 1, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := NOT #Ok AND #CurrentShift = 0, Code := 31, Result := #Result);
        #Unit.Good := 7; #Oee.RunMs := 1000;
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-17-07:00:00, Synchronized := TRUE, Revision := 1, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := NOT #Ok AND #Unit.Good = 7 AND #StartedAt = LDT#2026-10-17-06:00:00, Code := 32, Result := #Result);
        #Calendar.Rows[1].StartMin := 480; #Calendar.Rows[1].DurationMin := 720; #Calendar.Rows[1].ActiveDays := 96; #Calendar.Rows[1].ProductionTarget := 500;
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-17-07:00:00, Synchronized := TRUE, Revision := 2, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := NOT #Ok AND #Unit.Good = 7 AND #Book.ShiftEnd = LDT#2026-10-17-08:00:00, Code := 33, Result := #Result);
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-17-08:00:00, Synchronized := TRUE, Revision := 2, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := #Ok AND #HistoryCount = 1 AND #History[1].GoodCount = 7 AND #History[1].ShiftIndex = 0 AND #Unit.Good = 0, Code := 34, Result := #Result);
        "FRK_TestAssert"(Condition := #CurrentShift = 1 AND #ProductionTarget = 500 AND #History[1].ProductionTarget = 0, Code := 35, Result := #Result);
        #Unit.Good := 9; #Unit.Nok := 1; #Unit.Rework := 2; #Oee.RunMs := 1000;
        #Calendar.Rows[1].ProductionTarget := 900;
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-17-09:00:00, Synchronized := TRUE, Revision := 3, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := NOT #Ok AND #ProductionTarget = 500 AND #Unit.Good = 9, Code := 36, Result := #Result);
        #Book.ManualReset := TRUE;
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-17-20:00:00, Synchronized := TRUE, Revision := 3, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := #Ok AND #History[1].ProductionTarget = 500 AND #History[1].GoodCount = 9 AND #History[1].NokCount = 1 AND #History[1].ReworkCount = 2 AND #History[1].ManualReset, Code := 37, Result := #Result);
        "FRK_TestAssert"(Condition := #History[1].TimeSynchronized AND #CurrentShift = 0 AND #ProductionTarget = 0 AND #Oee.RunMs = 0, Code := 38, Result := #Result);
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-18-08:00:00, Synchronized := TRUE, Revision := 3, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := #Ok AND #CurrentShift = 1 AND #ProductionTarget = 900, Code := 39, Result := #Result);
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-18-07:00:00, Synchronized := TRUE, Revision := 3, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := NOT #Ok AND NOT #Book.ShiftSynchronized AND #History[1].EndAt >= #History[1].StartAt, Code := 40, Result := #Result);
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-20-12:00:00, Synchronized := TRUE, Revision := 3, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        "FRK_TestAssert"(Condition := #Ok AND #HistoryCount = 4 AND NOT #History[1].TimeSynchronized, Code := 41, Result := #Result);
