        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-01-00:00:00, Synchronized := TRUE, Revision := 1, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-02-00:00:00, Synchronized := TRUE, Revision := 1, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
        #Ok := "FRK_ShiftTick"(Now := LDT#2026-10-03-00:00:00, Synchronized := TRUE, Revision := 1, Scope := 'Operations', Calendar := #Calendar, Book := #Book, Unit := #Unit, Oee := #Oee, CurrentShift := #CurrentShift, StartedAt := #StartedAt, ProductionTarget := #ProductionTarget, History := #History, Count := #HistoryCount, Truncated := #Truncated, AlarmLog := #AlarmLog);
