FUNCTION "FRK_LineBoot" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      OwnerRole : Bool;
      NowMs : UDInt;
   END_VAR

   VAR_IN_OUT 
      State : "FRK_LineState";
   END_VAR


BEGIN
	
	#State.Values := "FRK_LineDefaults".Values;
	#State.Image := "FRK_LineDefaults".Image;
	#State.Status := "FRK_LineDefaults".Status;
	#State.Status.LineId := 'PRESS-LINE-1';
	#State.Status.Owner := 'BenchLineOwner';
	#State.Status.Role := 2;
	#State.Applied := FALSE;
	#State.HaveSuccess := FALSE;
	#State.LastSuccessMs := #NowMs;
	#State.StartedMs := #NowMs;
	#State.BuiltRevision := 0;
	#State.Dirty := FALSE;
	#State.StaleSlot := 0;
	IF #OwnerRole THEN
	    #State.Status.Role := 1;
	    #State.Status.Revision := 1;
	    #State.Dirty := TRUE;
	    "FRK_LineBuild"(State := #State);
	    #State.Applied := #State.Image.Revision <> 0;
	END_IF;
	
END_FUNCTION

