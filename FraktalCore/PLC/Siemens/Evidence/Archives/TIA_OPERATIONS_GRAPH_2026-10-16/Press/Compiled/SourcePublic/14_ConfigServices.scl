// Bounded exact decimal/binary conversion. Integer limbs are base 65536.
// No native decimal conversion: measured VAL_STRG/STRG_VAL lose IEEE values.
FUNCTION "FRK_IntegerSet" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Value : ULInt;
END_VAR
VAR_IN_OUT
    Number : "FRK_ConfigInteger";
END_VAR
VAR_TEMP
    Remaining : ULInt;
END_VAR
BEGIN
    #Number.Used := 0; #Remaining := #Value;
    WHILE #Remaining > ULINT#0 DO
        #Number.Limbs[#Number.Used] := ULINT_TO_UDINT(#Remaining MOD ULINT#65536);
        #Number.Used := #Number.Used + 1; #Remaining := #Remaining / ULINT#65536;
    END_WHILE;
END_FUNCTION

FUNCTION "FRK_IntegerMul" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Factor : UDInt;
    Addend : UDInt;
END_VAR
VAR_IN_OUT
    Number : "FRK_ConfigInteger";
END_VAR
VAR_TEMP
    Index : Int;
    Carry : ULInt;
    Product : ULInt;
END_VAR
BEGIN
    #FRK_IntegerMul := FALSE; #Carry := UDINT_TO_ULINT(#Addend);
    FOR #Index := 0 TO #Number.Used - 1 DO
        #Product := UDINT_TO_ULINT(#Number.Limbs[#Index]) * UDINT_TO_ULINT(#Factor) + #Carry;
        #Number.Limbs[#Index] := ULINT_TO_UDINT(#Product MOD ULINT#65536);
        #Carry := #Product / ULINT#65536;
    END_FOR;
    WHILE #Carry > ULINT#0 DO
        IF #Number.Used >= 102 THEN RETURN; END_IF;
        #Number.Limbs[#Number.Used] := ULINT_TO_UDINT(#Carry MOD ULINT#65536);
        #Number.Used := #Number.Used + 1; #Carry := #Carry / ULINT#65536;
    END_WHILE;
    #FRK_IntegerMul := TRUE;
END_FUNCTION

FUNCTION "FRK_IntegerShift" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Bits : Int;
END_VAR
VAR_IN_OUT
    Number : "FRK_ConfigInteger";
END_VAR
VAR_TEMP
    Index : Int;
    Words : Int;
    Remainder : Int;
END_VAR
BEGIN
    #FRK_IntegerShift := FALSE;
    IF #Bits < 0 THEN RETURN; END_IF;
    IF #Number.Used = 0 THEN #FRK_IntegerShift := TRUE; RETURN; END_IF;
    #Words := #Bits / 16; #Remainder := #Bits MOD 16;
    IF #Number.Used + #Words > 102 THEN RETURN; END_IF;
    FOR #Index := #Number.Used - 1 TO 0 BY -1 DO
        #Number.Limbs[#Index + #Words] := #Number.Limbs[#Index];
    END_FOR;
    FOR #Index := 0 TO #Words - 1 DO #Number.Limbs[#Index] := 0; END_FOR;
    #Number.Used := #Number.Used + #Words;
    #FRK_IntegerShift := "FRK_IntegerMul"(Number := #Number,
        Factor := SHL(IN := UDINT#1, N := INT_TO_USINT(#Remainder)), Addend := 0);
END_FUNCTION

FUNCTION "FRK_IntegerCompare" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    LeftValue : "FRK_ConfigInteger";
    RightValue : "FRK_ConfigInteger";
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_IntegerCompare := 0;
    IF #LeftValue.Used > #RightValue.Used THEN #FRK_IntegerCompare := 1; RETURN; END_IF;
    IF #LeftValue.Used < #RightValue.Used THEN #FRK_IntegerCompare := -1; RETURN; END_IF;
    FOR #Index := #LeftValue.Used - 1 TO 0 BY -1 DO
        IF #LeftValue.Limbs[#Index] > #RightValue.Limbs[#Index] THEN #FRK_IntegerCompare := 1; RETURN; END_IF;
        IF #LeftValue.Limbs[#Index] < #RightValue.Limbs[#Index] THEN #FRK_IntegerCompare := -1; RETURN; END_IF;
    END_FOR;
END_FUNCTION

FUNCTION "FRK_IntegerSubtract" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    LeftValue : "FRK_ConfigInteger";
    RightValue : "FRK_ConfigInteger";
END_VAR
VAR_TEMP
    Index : Int;
    Borrow : DInt;
    Difference : DInt;
END_VAR
BEGIN
    // Caller establishes LeftValue >= RightValue.
    #Borrow := 0;
    FOR #Index := 0 TO #LeftValue.Used - 1 DO
        #Difference := UDINT_TO_DINT(#LeftValue.Limbs[#Index]) - #Borrow;
        IF #Index < #RightValue.Used THEN #Difference := #Difference - UDINT_TO_DINT(#RightValue.Limbs[#Index]); END_IF;
        #Borrow := 0;
        IF #Difference < 0 THEN #Difference := #Difference + 65536; #Borrow := 1; END_IF;
        #LeftValue.Limbs[#Index] := DINT_TO_UDINT(#Difference);
    END_FOR;
    WHILE #LeftValue.Used > 0 DO
        IF #LeftValue.Limbs[#LeftValue.Used - 1] <> 0 THEN EXIT; END_IF;
        #LeftValue.Used := #LeftValue.Used - 1;
    END_WHILE;
END_FUNCTION

FUNCTION "FRK_IntegerBits" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Number : "FRK_ConfigInteger";
END_VAR
VAR_TEMP
    TopWord : UDInt;
END_VAR
BEGIN
    #FRK_IntegerBits := 0;
    IF #Number.Used = 0 THEN RETURN; END_IF;
    #FRK_IntegerBits := (#Number.Used - 1) * 16;
    #TopWord := #Number.Limbs[#Number.Used - 1];
    WHILE #TopWord > 0 DO
        #FRK_IntegerBits := #FRK_IntegerBits + 1; #TopWord := #TopWord / UDINT#2;
    END_WHILE;
END_FUNCTION

FUNCTION "FRK_DecimalDecode" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Text : WString;
    SinglePrecision : Bool;
END_VAR
VAR_IN_OUT
    Value : LReal;
END_VAR
VAR_TEMP
    Numerator : "FRK_ConfigInteger";
    Denominator : "FRK_ConfigInteger";
    Index : Int;
    Width : Int;
    Digits : Int;
    Fraction : Int;
    Exponent : Int;
    Scale : Int;
    BinaryExponent : Int;
    MinimumExponent : Int;
    MaximumExponent : Int;
    Precision : Int;
    SignificantBits : Int;
    Comparison : Int;
    Significand : ULInt;
    Negative : Bool;
    ExponentNegative : Bool;
    PointSeen : Bool;
    Ok : Bool;
END_VAR
BEGIN
    #FRK_DecimalDecode := FALSE;
    #Width := LEN(#Text);
    IF #Width = 0 OR #Width > 80 THEN RETURN; END_IF;
    #Index := 1; #Negative := FALSE;
    IF #Text[#Index] = WCHAR#'-' THEN #Negative := TRUE; #Index := 2;
    ELSIF #Text[#Index] = WCHAR#'+' THEN #Index := 2; END_IF;
    "FRK_IntegerSet"(Number := #Numerator, Value := ULINT#0);
    "FRK_IntegerSet"(Number := #Denominator, Value := ULINT#1);
    #Digits := 0; #Fraction := 0; #PointSeen := FALSE;
    WHILE #Index <= #Width DO
        IF #Text[#Index] = WCHAR#'e' OR #Text[#Index] = WCHAR#'E' THEN EXIT; END_IF;
        IF #Text[#Index] = WCHAR#'.' THEN
            IF #PointSeen THEN RETURN; END_IF;
            #PointSeen := TRUE;
        ELSE
            IF #Text[#Index] < WCHAR#'0' OR #Text[#Index] > WCHAR#'9' THEN RETURN; END_IF;
            #Ok := "FRK_IntegerMul"(Number := #Numerator, Factor := 10,
                Addend := UINT_TO_UDINT(WCHAR_TO_UINT(#Text[#Index]) - UINT#48));
            IF NOT #Ok THEN RETURN; END_IF;
            #Digits := #Digits + 1;
            IF #PointSeen THEN #Fraction := #Fraction + 1; END_IF;
        END_IF;
        #Index := #Index + 1;
    END_WHILE;
    IF #Digits = 0 THEN RETURN; END_IF;
    #Exponent := 0; #ExponentNegative := FALSE;
    IF #Index <= #Width THEN
        #Index := #Index + 1;
        IF #Index > #Width THEN RETURN; END_IF;
        IF #Text[#Index] = WCHAR#'-' THEN #ExponentNegative := TRUE; #Index := #Index + 1;
        ELSIF #Text[#Index] = WCHAR#'+' THEN #Index := #Index + 1; END_IF;
        IF #Index > #Width THEN RETURN; END_IF;
        WHILE #Index <= #Width DO
            IF #Text[#Index] < WCHAR#'0' OR #Text[#Index] > WCHAR#'9' THEN RETURN; END_IF;
            #Exponent := #Exponent * 10 + UINT_TO_INT(WCHAR_TO_UINT(#Text[#Index]) - UINT#48);
            IF #Exponent > 400 THEN RETURN; END_IF;
            #Index := #Index + 1;
        END_WHILE;
    END_IF;
    IF #Numerator.Used = 0 THEN #Value := 0.0; #FRK_DecimalDecode := TRUE; RETURN; END_IF;
    IF #ExponentNegative THEN #Exponent := -#Exponent; END_IF;
    #Scale := #Exponent - #Fraction;
    WHILE #Scale > 0 DO
        #Ok := "FRK_IntegerMul"(Number := #Numerator, Factor := 10, Addend := 0);
        IF NOT #Ok THEN RETURN; END_IF;
        #Scale := #Scale - 1;
    END_WHILE;
    WHILE #Scale < 0 DO
        #Ok := "FRK_IntegerMul"(Number := #Denominator, Factor := 10, Addend := 0);
        IF NOT #Ok THEN RETURN; END_IF;
        #Scale := #Scale + 1;
    END_WHILE;
    #Precision := 53; #MinimumExponent := -1022; #MaximumExponent := 1023;
    IF #SinglePrecision THEN #Precision := 24; #MinimumExponent := -126; #MaximumExponent := 127; END_IF;
    #BinaryExponent := "FRK_IntegerBits"(Number := #Numerator) - "FRK_IntegerBits"(Number := #Denominator);
    IF #BinaryExponent > #MaximumExponent + 1 OR #BinaryExponent < #MinimumExponent - #Precision THEN RETURN; END_IF;
    IF #BinaryExponent >= 0 THEN #Ok := "FRK_IntegerShift"(Number := #Denominator, Bits := #BinaryExponent);
    ELSE #Ok := "FRK_IntegerShift"(Number := #Numerator, Bits := -#BinaryExponent); END_IF;
    IF NOT #Ok THEN RETURN; END_IF;
    IF "FRK_IntegerCompare"(LeftValue := #Numerator, RightValue := #Denominator) < 0 THEN
        #Ok := "FRK_IntegerMul"(Number := #Numerator, Factor := 2, Addend := 0);
        #BinaryExponent := #BinaryExponent - 1;
    END_IF;
    IF #BinaryExponent > #MaximumExponent THEN RETURN; END_IF;
    #SignificantBits := #Precision + MIN(IN1 := 0, IN2 := #BinaryExponent - #MinimumExponent);
    IF #SignificantBits < 0 THEN RETURN; END_IF;
    IF #SignificantBits = 0 THEN
        // Strictly above half the smallest subnormal rounds to that value.
        IF "FRK_IntegerCompare"(LeftValue := #Numerator, RightValue := #Denominator) = 0 THEN RETURN; END_IF;
        #Significand := ULINT#1; #Scale := #MinimumExponent - #Precision + 1;
    ELSE
        #Significand := ULINT#1;
        "FRK_IntegerSubtract"(LeftValue := #Numerator, RightValue := #Denominator);
        FOR #Index := 1 TO #SignificantBits - 1 DO
            #Ok := "FRK_IntegerMul"(Number := #Numerator, Factor := 2, Addend := 0);
            IF NOT #Ok THEN RETURN; END_IF;
            #Significand := #Significand * ULINT#2;
            IF "FRK_IntegerCompare"(LeftValue := #Numerator, RightValue := #Denominator) >= 0 THEN
                "FRK_IntegerSubtract"(LeftValue := #Numerator, RightValue := #Denominator);
                #Significand := #Significand + ULINT#1;
            END_IF;
        END_FOR;
        #Ok := "FRK_IntegerMul"(Number := #Numerator, Factor := 2, Addend := 0);
        IF NOT #Ok THEN RETURN; END_IF;
        #Comparison := "FRK_IntegerCompare"(LeftValue := #Numerator, RightValue := #Denominator);
        IF #Comparison > 0 OR (#Comparison = 0 AND #Significand MOD ULINT#2 = ULINT#1) THEN #Significand := #Significand + ULINT#1; END_IF;
        IF #BinaryExponent = #MaximumExponent AND #Significand = SHL(IN := ULINT#1, N := INT_TO_USINT(#Precision)) THEN RETURN; END_IF;
        #Scale := #BinaryExponent - #SignificantBits + 1;
    END_IF;
    #Value := ULINT_TO_LREAL(#Significand);
    WHILE #Scale > 0 DO #Value := #Value * 2.0; #Scale := #Scale - 1; END_WHILE;
    WHILE #Scale < 0 DO #Value := #Value / 2.0; #Scale := #Scale + 1; END_WHILE;
    IF #Value = 0.0 THEN RETURN; END_IF;
    IF #Negative THEN #Value := -#Value; END_IF;
    #FRK_DecimalDecode := TRUE;
END_FUNCTION

FUNCTION "FRK_DecimalFormat" : WString
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Number : LReal;
END_VAR
VAR_TEMP
    Numerator : "FRK_ConfigInteger";
    Denominator : "FRK_ConfigInteger";
    TwiceRemainder : "FRK_ConfigInteger";
    Normalized : LReal;
    Significand : ULInt;
    BinaryExponent : Int;
    DecimalExponent : Int;
    Index : Int;
    Comparison : Int;
    Ok : Bool;
    Digits : Array[1..17] of Int;
    Text : WString[80];
    ExponentText : WString[8];
END_VAR
BEGIN
    #FRK_DecimalFormat := WSTRING#'';
    IF #Number <> #Number OR (#Number <> 0.0 AND #Number / 2.0 = #Number) THEN RETURN; END_IF;
    IF #Number = 0.0 THEN #FRK_DecimalFormat := WSTRING#'0'; RETURN; END_IF;
    #Normalized := ABS(#Number); #BinaryExponent := 0;
    WHILE #Normalized >= 2.0 DO #Normalized := #Normalized / 2.0; #BinaryExponent := #BinaryExponent + 1; END_WHILE;
    WHILE #Normalized < 1.0 DO #Normalized := #Normalized * 2.0; #BinaryExponent := #BinaryExponent - 1; END_WHILE;
    // Extract binary digits with exact powers of two. Avoid a large decimal
    // floating literal or a floating-to-integer conversion of the significand.
    #Significand := ULINT#1; #Normalized := #Normalized - 1.0;
    FOR #Index := 1 TO 52 DO
        #Normalized := #Normalized * 2.0; #Significand := #Significand * ULINT#2;
        IF #Normalized >= 1.0 THEN
            #Normalized := #Normalized - 1.0; #Significand := #Significand + ULINT#1;
        END_IF;
    END_FOR;
    "FRK_IntegerSet"(Number := #Numerator, Value := #Significand);
    "FRK_IntegerSet"(Number := #Denominator, Value := ULINT#1);
    #BinaryExponent := #BinaryExponent - 52;
    IF #BinaryExponent >= 0 THEN #Ok := "FRK_IntegerShift"(Number := #Numerator, Bits := #BinaryExponent);
    ELSE #Ok := "FRK_IntegerShift"(Number := #Denominator, Bits := -#BinaryExponent); END_IF;
    IF NOT #Ok THEN RETURN; END_IF;
    #DecimalExponent := 0;
    WHILE "FRK_IntegerCompare"(LeftValue := #Numerator, RightValue := #Denominator) < 0 DO
        #Ok := "FRK_IntegerMul"(Number := #Numerator, Factor := 10, Addend := 0);
        IF NOT #Ok THEN RETURN; END_IF;
        #DecimalExponent := #DecimalExponent - 1;
    END_WHILE;
    #TwiceRemainder := #Denominator;
    #Ok := "FRK_IntegerMul"(Number := #TwiceRemainder, Factor := 10, Addend := 0);
    WHILE "FRK_IntegerCompare"(LeftValue := #Numerator, RightValue := #TwiceRemainder) >= 0 DO
        #Denominator := #TwiceRemainder; #DecimalExponent := #DecimalExponent + 1;
        #Ok := "FRK_IntegerMul"(Number := #TwiceRemainder, Factor := 10, Addend := 0);
        IF NOT #Ok THEN RETURN; END_IF;
    END_WHILE;
    FOR #Index := 1 TO 17 DO
        #Digits[#Index] := 0;
        WHILE "FRK_IntegerCompare"(LeftValue := #Numerator, RightValue := #Denominator) >= 0 DO
            "FRK_IntegerSubtract"(LeftValue := #Numerator, RightValue := #Denominator);
            #Digits[#Index] := #Digits[#Index] + 1;
        END_WHILE;
        IF #Index < 17 THEN
            #Ok := "FRK_IntegerMul"(Number := #Numerator, Factor := 10, Addend := 0);
            IF NOT #Ok THEN RETURN; END_IF;
        END_IF;
    END_FOR;
    #Ok := "FRK_IntegerMul"(Number := #Numerator, Factor := 2, Addend := 0);
    IF NOT #Ok THEN RETURN; END_IF;
    #Comparison := "FRK_IntegerCompare"(LeftValue := #Numerator, RightValue := #Denominator);
    IF #Comparison > 0 OR (#Comparison = 0 AND #Digits[17] MOD 2 = 1) THEN
        #Index := 17;
        WHILE #Index > 0 DO
            #Digits[#Index] := #Digits[#Index] + 1;
            IF #Digits[#Index] < 10 THEN EXIT; END_IF;
            #Digits[#Index] := 0; #Index := #Index - 1;
        END_WHILE;
        IF #Index = 0 THEN #Digits[1] := 1; #DecimalExponent := #DecimalExponent + 1; END_IF;
    END_IF;
    #Text := WSTRING#'';
    FOR #Index := 1 TO 17 DO
        #Text := CONCAT(IN1 := #Text, IN2 := WCHAR_TO_WSTRING(UINT_TO_WCHAR(INT_TO_UINT(#Digits[#Index]) + UINT#48)));
        IF #Index = 1 THEN #Text := CONCAT(IN1 := #Text, IN2 := WSTRING#'.'); END_IF;
    END_FOR;
    #ExponentText := DINT_TO_WSTRING(INT_TO_DINT(#DecimalExponent));
    #Text := CONCAT(IN1 := #Text, IN2 := WSTRING#'E');
    #Text := CONCAT(IN1 := #Text, IN2 := #ExponentText);
    IF #Number < 0.0 THEN #Text := CONCAT(IN1 := WSTRING#'-', IN2 := #Text); END_IF;
    #FRK_DecimalFormat := #Text;
END_FUNCTION

FUNCTION "FRK_ConfigDecimalText" : WString
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Number : LReal;
END_VAR
VAR_TEMP
    Text : WString[80];
    RoundTrip : LReal;
    Ok : Bool;
END_VAR
BEGIN
    #FRK_ConfigDecimalText := WSTRING#'';
    #Text := "FRK_DecimalFormat"(Number := #Number);
    #Ok := "FRK_DecimalDecode"(Text := #Text, SinglePrecision := FALSE, Value := #RoundTrip);
    IF #Ok AND #RoundTrip = #Number THEN #FRK_ConfigDecimalText := #Text; END_IF;
END_FUNCTION

// Keyed local-retain config. The typed owner validates before publishing a value.
FUNCTION "FRK_ConfigWriteAudit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT Scope : String; Key : String; Value : WString; Captured : Bool; User : String; END_VAR
VAR_IN_OUT AlarmLog : "FRK_AlarmLog"; END_VAR
VAR_TEMP Prefix : WString[64]; Text : WString[255]; END_VAR
BEGIN
    IF #Captured THEN #Prefix := WSTRING#'std.audit.configCaptured field=';
    ELSE #Prefix := WSTRING#'std.audit.configWritten field='; END_IF;
    #Text := CONCAT(IN1 := #Prefix, IN2 := STRING_TO_WSTRING(#Key));
    // Preserve the full key/value/user: long entries use two adjacent audited
    // events from this same transaction instead of truncating accepted data.
    IF LEN(#Prefix) + LEN(#Key) + LEN(#Value) + LEN(#User) + 13 <= 255 THEN
        #Text := CONCAT(IN1 := #Text, IN2 := WSTRING#' value=');
        #Text := CONCAT(IN1 := #Text, IN2 := #Value);
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
    ELSE
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
        #Text := CONCAT(IN1 := WSTRING#'std.audit.configValue value=', IN2 := #Value);
        "FRK_AccessAudit"(AlarmLog := #AlarmLog, What := #Text, Who := #User, SourcePath := STRING_TO_WSTRING(#Scope));
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigDecode" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Text : WString;
    Storage : DInt;
    Minimum : LReal;
    Maximum : LReal;
    MaxLength : Int;
END_VAR
VAR_IN_OUT
    Value : "FRK_ConfigValue";
END_VAR
VAR_TEMP
    Index : Int;
    Width : Int;
    Negative : Bool;
    Magnitude : ULInt;
    Digit : ULInt;
    Decimal : LReal;
    Converted : Real;
    ConvertedOk : Bool;
END_VAR
BEGIN
    #FRK_ConfigDecode := FALSE;
    IF #Storage = 8 THEN
        IF LEN(#Text) > #MaxLength THEN RETURN; END_IF;
        #Value.Text := WSTRING_TO_STRING(#Text);
        IF STRING_TO_WSTRING(#Value.Text) <> #Text THEN RETURN; END_IF;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage = 1 THEN
        IF #Text = WSTRING#'true' OR #Text = WSTRING#'TRUE' OR #Text = WSTRING#'1' THEN
            #Value.Flag := TRUE;
        ELSIF #Text = WSTRING#'false' OR #Text = WSTRING#'FALSE' OR #Text = WSTRING#'0' THEN
            #Value.Flag := FALSE;
        ELSE RETURN;
        END_IF;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage = 5 OR #Storage = 6 THEN
        #ConvertedOk := "FRK_DecimalDecode"(Text := #Text,
            SinglePrecision := #Storage = 5, Value := #Decimal);
        IF NOT #ConvertedOk OR #Decimal < #Minimum OR #Decimal > #Maximum THEN RETURN; END_IF;
        IF #Storage = 5 THEN
            #Converted := LREAL_TO_REAL(#Decimal);
            IF #Converted = 0.0 AND #Decimal <> 0.0 THEN RETURN; END_IF;
            #Decimal := REAL_TO_LREAL(#Converted);
            IF #Decimal < #Minimum OR #Decimal > #Maximum THEN RETURN; END_IF;
        END_IF;
        #Value.Decimal := #Decimal;
        #FRK_ConfigDecode := TRUE;
        RETURN;
    END_IF;
    IF #Storage <> 2 AND #Storage <> 3
        AND #Storage <> 4 AND #Storage <> 7 THEN RETURN; END_IF;
    #Width := LEN(#Text);
    IF #Width = 0 THEN RETURN; END_IF;
    #Negative := FALSE;
    #Index := 1;
    IF #Text[1] = WCHAR#'-' THEN #Negative := TRUE; #Index := 2;
    ELSIF #Text[1] = WCHAR#'+' THEN #Index := 2;
    END_IF;
    IF #Index > #Width THEN RETURN; END_IF;
    #Magnitude := 0;
    WHILE #Index <= #Width DO
        IF #Text[#Index] < WCHAR#'0' OR #Text[#Index] > WCHAR#'9' THEN RETURN; END_IF;
        #Digit := UINT_TO_ULINT(WCHAR_TO_UINT(#Text[#Index]) - UINT#48);
        IF #Magnitude > (ULINT#4294967295 - #Digit) / ULINT#10 THEN RETURN; END_IF;
        #Magnitude := #Magnitude * ULINT#10 + #Digit;
        #Index := #Index + 1;
    END_WHILE;
    #Value.Number := ULINT_TO_LINT(#Magnitude);
    IF #Negative THEN #Value.Number := -#Value.Number; END_IF;
    IF LINT_TO_LREAL(#Value.Number) < #Minimum OR LINT_TO_LREAL(#Value.Number) > #Maximum THEN RETURN; END_IF;
    #FRK_ConfigDecode := TRUE;
END_FUNCTION

FUNCTION "FRK_ConfigEnumText" : WString
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Number : DInt;
END_VAR
BEGIN
    #FRK_ConfigEnumText := DINT_TO_WSTRING(#Number);
    IF #FRK_ConfigEnumText[1] = WCHAR#'+' THEN
        #FRK_ConfigEnumText := MID(IN := #FRK_ConfigEnumText, L := LEN(#FRK_ConfigEnumText) - 1, P := 2);
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigValidate" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Text : WString;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigValidate := "FRK_ConfigDecode"(Text := #Text,
        Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum,
        Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength,
        Value := "FRK_ConfigScratch".Value);
    IF NOT #FRK_ConfigValidate OR "FRK_ConfigScratch".EnumCount = 0 THEN RETURN; END_IF;
    #FRK_ConfigValidate := FALSE;
    FOR #Index := 1 TO "FRK_ConfigScratch".EnumCount DO
        IF "FRK_ConfigScratch".Value.Number = DINT_TO_LINT("FRK_ConfigScratch".EnumValues[#Index]) THEN
            #FRK_ConfigValidate := TRUE; RETURN;
        END_IF;
    END_FOR;
END_FUNCTION

FUNCTION "FRK_ConfigFind" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    Key : String;
    ModelCode : String;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigFind := 0;
    FOR #Index := 1 TO 17 DO
        IF "FRK_ConfigStore".Rows[#Index].Used
            AND "FRK_ConfigStore".Rows[#Index].Record.Scope = #Scope
            AND "FRK_ConfigStore".Rows[#Index].Record.WriteKey = #Key
            AND "FRK_ConfigStore".Rows[#Index].ModelCode = #ModelCode THEN
            #FRK_ConfigFind := #Index;
            RETURN;
        END_IF;
    END_FOR;
END_FUNCTION

FUNCTION "FRK_ConfigPutRaw" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    ModelCode : String;
    Text : WString;
    RootIndex : Int;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigPutRaw := FALSE;
    IF #RootIndex < 1 OR #RootIndex > 1 THEN RETURN; END_IF;
    IF "FRK_ConfigRuntime".Unavailable THEN "FRK_ConfigRuntime".Failed[#RootIndex] := TRUE; RETURN; END_IF;
    IF LEN(#Scope) > 80 OR LEN(#Text) > 80 THEN RETURN; END_IF;
    IF NOT "FRK_ConfigValidate"(Text := #Text) THEN RETURN; END_IF;
    #Index := "FRK_ConfigFind"(Scope := #Scope, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := #ModelCode);
    IF #Index = 0 THEN
        FOR #Index := 1 TO 17 DO
            IF NOT "FRK_ConfigStore".Rows[#Index].Used THEN EXIT; END_IF;
        END_FOR;
    END_IF;
    IF #Index < 1 OR #Index > 17 THEN "FRK_ConfigRuntime".Failed[#RootIndex] := TRUE; RETURN; END_IF;
    "FRK_ConfigStore".Rows[#Index].SchemaVersion := "FRK_ConfigScratch".Schema;
    "FRK_ConfigStore".Rows[#Index].ModelCode := #ModelCode;
    "FRK_ConfigStore".Rows[#Index].Record.Scope := #Scope;
    "FRK_ConfigStore".Rows[#Index].Record.WriteKey := "FRK_ConfigScratch".Entry.WriteKey;
    "FRK_ConfigStore".Rows[#Index].Record.Revision := "FRK_ConfigScratch".Entry.WriteRevision;
    "FRK_ConfigStore".Rows[#Index].Record.Kind := "FRK_ConfigScratch".Entry.ConfigKind;
    "FRK_ConfigStore".Rows[#Index].Record.ValueType := "FRK_ConfigScratch".Entry.ValueType;
    "FRK_ConfigStore".Rows[#Index].Record.ValueText := WSTRING_TO_STRING(#Text);
    "FRK_ConfigStore".Rows[#Index].Used := TRUE;
    "FRK_ConfigRuntime".Failed[#RootIndex] := FALSE;
    #FRK_ConfigPutRaw := TRUE;
END_FUNCTION

FUNCTION "FRK_ConfigPut" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    ModelCode : String;
    Text : WString;
    RootIndex : Int;
END_VAR
VAR_TEMP
    Stored : Int;
    Changed : Bool;
    Slot : Int;
END_VAR
BEGIN
    #Stored := "FRK_ConfigFind"(Scope := #Scope, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := #ModelCode);
    #Changed := #Stored = 0;
    IF #Stored > 0 THEN #Changed := "FRK_ConfigStore".Rows[#Stored].SchemaVersion <> "FRK_ConfigScratch".Schema OR "FRK_ConfigStore".Rows[#Stored].Record.Revision <> "FRK_ConfigScratch".Entry.WriteRevision OR "FRK_ConfigStore".Rows[#Stored].Record.ValueText <> WSTRING_TO_STRING(#Text); END_IF;
    #FRK_ConfigPut := "FRK_ConfigPutRaw"(Scope := #Scope, ModelCode := #ModelCode, Text := #Text, RootIndex := #RootIndex);
    IF #FRK_ConfigPut AND #Changed THEN
        #Slot := "FRK_PersistConfigSlot"(Scope := #Scope, ModelCode := #ModelCode, Kind := "FRK_ConfigScratch".Entry.ConfigKind);
        IF #Slot > 0 THEN "FRK_PersistDirty"(Slot := #Slot); END_IF;
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigGet" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    ModelCode : String;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    #FRK_ConfigGet := FALSE;
    #Index := "FRK_ConfigFind"(Scope := #Scope, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := #ModelCode);
    IF #Index = 0 THEN RETURN; END_IF;
    IF "FRK_ConfigStore".Rows[#Index].SchemaVersion <> "FRK_ConfigScratch".Schema
        OR "FRK_ConfigStore".Rows[#Index].Record.Revision <> "FRK_ConfigScratch".Entry.WriteRevision
        OR "FRK_ConfigStore".Rows[#Index].Record.Kind <> "FRK_ConfigScratch".Entry.ConfigKind
        OR "FRK_ConfigStore".Rows[#Index].Record.ValueType <> "FRK_ConfigScratch".Entry.ValueType THEN RETURN; END_IF;
    #FRK_ConfigGet := "FRK_ConfigValidate"(Text := STRING_TO_WSTRING("FRK_ConfigStore".Rows[#Index].Record.ValueText));
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING("FRK_ConfigStore".Rows[#Index].Record.ValueText);
    IF #FRK_ConfigGet AND "FRK_ConfigScratch".EnumCount > 0 THEN
        "FRK_ConfigScratch".Entry.ValueText := "FRK_ConfigEnumText"(Number := LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
    END_IF;
END_FUNCTION

FUNCTION "FRK_ConfigLoss" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    Scope : String;
END_VAR
BEGIN
    IF #RootIndex < 1 OR #RootIndex > 1 THEN RETURN; END_IF;
    "FRK_ConfigStore".Lost[#RootIndex] := TRUE;
    "FRK_ConfigStore".Acknowledged[#RootIndex] := FALSE;
    "FRK_ConfigStore".LostPath[#RootIndex] := #Scope;
END_FUNCTION

FUNCTION "FRK_ConfigAppendEntry" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Cursor : "FRK_ConfigCursor";
    Page : "ST_ConfigPage";
END_VAR
VAR_TEMP
    Slot : DInt;
END_VAR
BEGIN
    #Slot := #Cursor.Position - #Cursor.First;
    #Cursor.Position := #Cursor.Position + 1;
    IF #Slot < 0 OR #Slot >= 16 THEN RETURN; END_IF;
    #Slot := #Slot + 1;
    #Page.Entries[#Slot] := "FRK_ConfigScratch".Entry;
    #Page.EntryCount := DINT_TO_INT(#Slot);
END_FUNCTION

FUNCTION "FRK_ConfigStatus" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    Scope : String;
    PolicyLost : Bool;
    UsersLost : Bool;
END_VAR
VAR_IN_OUT
    Persist : "ST_ConfigPersistStatus";
    AlarmLog : "FRK_AlarmLog";
END_VAR
VAR_TEMP
    Diag : "ST_Diagnostic";
    Accepted : Bool;
END_VAR
BEGIN
    IF #RootIndex < 1 OR #RootIndex > 1 THEN RETURN; END_IF;
    #Persist.Pending := FALSE;
    #Persist.Failed := "FRK_ConfigRuntime".Failed[#RootIndex];
    #Persist.StoreKind := 0;
    // Named set operations are not wired by the live retained-value provider.
    #Persist.StorePresent := TRUE;
    #Persist.RestoreLost := "FRK_ConfigStore".Lost[#RootIndex] OR #PolicyLost OR #UsersLost;
    #Persist.RestoreAcknowledged := "FRK_ConfigStore".Acknowledged[#RootIndex] AND NOT #PolicyLost AND NOT #UsersLost;
    IF #PolicyLost THEN #Persist.LostPath := CONCAT(IN1 := #Scope, IN2 := '.AccessPolicy');
    ELSIF #UsersLost THEN #Persist.LostPath := CONCAT(IN1 := #Scope, IN2 := '.Access');
    ELSE #Persist.LostPath := "FRK_ConfigStore".LostPath[#RootIndex]; END_IF;
    // Access owns its precise loss events; announce only typed-config loss here.
    IF "FRK_ConfigStore".Lost[#RootIndex] AND NOT "FRK_ConfigStore".Acknowledged[#RootIndex] THEN
        IF "FRK_ConfigRuntime".LossSlot[#RootIndex] = 0 THEN
            #Diag := "FRK_UnitScratch".EmptyDiagnostic;
            #Diag.ReasonCode := 2040;
            #Diag.Description := WSTRING#'std.error.configRestoreLost';
            #Diag.SourcePath := STRING_TO_WSTRING("FRK_ConfigStore".LostPath[#RootIndex]);
            "FRK_ConfigRuntime".LossSlot[#RootIndex] := "FRK_AlarmRaise"(AlarmLog := #AlarmLog, Diag := #Diag, ResetClass := 0);
        END_IF;
    ELSIF "FRK_ConfigRuntime".LossSlot[#RootIndex] > 0 THEN
        #Accepted := "FRK_AlarmGone"(AlarmLog := #AlarmLog, Slot := "FRK_ConfigRuntime".LossSlot[#RootIndex]);
        "FRK_ConfigRuntime".LossSlot[#RootIndex] := 0;
    END_IF;
    "FRK_PersistRootStatus"(RootIndex := #RootIndex, Persist := #Persist);
END_FUNCTION
FUNCTION "FRK_ConfigRoot" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RegIndex : DInt;
END_VAR
BEGIN
    #FRK_ConfigRoot := 0;
    CASE #RegIndex OF
        1: #FRK_ConfigRoot := 1;
        2: #FRK_ConfigRoot := 1;
        3: #FRK_ConfigRoot := 1;
        4: #FRK_ConfigRoot := 1;
        5: #FRK_ConfigRoot := 1;
        6: #FRK_ConfigRoot := 1;
        7: #FRK_ConfigRoot := 1;
        ELSE RETURN;
    END_CASE;
END_FUNCTION
FUNCTION "FRK_ConfigModelCode" : String
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    ModelIndex : UDInt;
END_VAR
BEGIN
    #FRK_ConfigModelCode := '';
    IF #RootIndex < 1 OR #RootIndex > 1 THEN RETURN; END_IF;
    IF #ModelIndex = 0 THEN #FRK_ConfigModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex]; RETURN; END_IF;
    CASE #ModelIndex OF
        1: #FRK_ConfigModelCode := 'ALUMINUM';
        2: #FRK_ConfigModelCode := 'PLASTIC';
        3: #FRK_ConfigModelCode := 'STEEL';
        ELSE RETURN;
    END_CASE;
END_FUNCTION
FUNCTION "FRK_ConfigBoot" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Startup : Bool;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    IF NOT #Startup THEN RETURN; END_IF;
    "FRK_ConfigRuntime".Fresh := "FRK_ConfigStore".SchemaVersion = 0;
    IF "FRK_ConfigStore".SchemaVersion <> 1 THEN
        FOR #Index := 1 TO 17 DO "FRK_ConfigStore".Rows[#Index].Used := FALSE; END_FOR;
        IF NOT "FRK_ConfigRuntime".Fresh THEN "FRK_ConfigLoss"(RootIndex := 1, Scope := 'PressDemo'); END_IF;
        "FRK_ConfigStore".ActiveModels[1] := 'ALUMINUM';
        "FRK_ConfigStore".SchemaVersion := 1;
    END_IF;
    IF "FRK_ConfigStore".ActiveModels[1] <> 'ALUMINUM' AND "FRK_ConfigStore".ActiveModels[1] <> 'PLASTIC' AND "FRK_ConfigStore".ActiveModels[1] <> 'STEEL' THEN
        "FRK_ConfigStore".ActiveModels[1] := 'ALUMINUM';
        "FRK_ConfigLoss"(RootIndex := 1, Scope := 'PressDemo');
    END_IF;
END_FUNCTION
