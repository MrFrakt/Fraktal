FUNCTION "FRK_AlarmUnshelve" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// Shelving changes annunciation only. Blocking and interlock scans ignore it.
   VAR_INPUT 
      Slot : Int;
   END_VAR

   VAR_IN_OUT 
      AlarmLog : "FRK_AlarmLog";
   END_VAR


BEGIN
	
	#FRK_AlarmUnshelve := FALSE;
	IF #Slot < 1 OR #Slot > 16 THEN
	    RETURN;
	END_IF;
	IF NOT #AlarmLog.Active[#Slot].Shelved THEN
	    RETURN;
	END_IF;
	#AlarmLog.Active[#Slot].Shelved := FALSE;
	#AlarmLog.ShelfDuration[#Slot] := 0;
	"FRK_AlarmMessage"(AlarmLog := #AlarmLog,
	                   Reason := 0,
	                   Description := WSTRING#'std.audit.alarmUnshelved',
	                   SourcePath := #AlarmLog.Active[#Slot].SourcePath);
	#FRK_AlarmUnshelve := TRUE;
	
END_FUNCTION

