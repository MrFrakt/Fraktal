TYPE "ST_ShiftRecordV3"
VERSION : 0.1
   STRUCT
      "SchemaVersion" : UInt := 3;
      "ProductionTarget" : UDInt;
      "ShiftIndex" : Int;
      "StartAt" : LDT;
      "EndAt" : LDT;
      "TimeSynchronized" : Bool;
      "ManualReset" : Bool;
      "GoodCount" : UDInt;
      "NokCount" : UDInt;
      "ReworkCount" : UDInt;
      "RunMs" : UDInt;
      "DownMs" : UDInt;
      "IdleMs" : UDInt;
      "Availability" : Real;
      "AvailValid" : Bool;
      "Performance" : Real;
      "PerfValid" : Bool;
      "Quality" : Real;
      "QualValid" : Bool;
      "Oee" : Real;
      "OeeValid" : Bool;
   END_STRUCT;
END_TYPE
