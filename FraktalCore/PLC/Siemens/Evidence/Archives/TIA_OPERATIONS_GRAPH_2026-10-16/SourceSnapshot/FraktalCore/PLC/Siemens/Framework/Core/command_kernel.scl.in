// Shared command kernel v0.1. Core 2.2 / 6.1 / 3.14 / 8.11.
// Generated enum/rationalization values come from Core authorities.
FUNCTION "FRK_ClockTick" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_TEMP
    DeltaS : LReal;
END_VAR
BEGIN
    #DeltaS := RUNTIME("FRK_Clock".Mem);
    IF #DeltaS < 0.0 OR #DeltaS > 60.0 THEN
        #DeltaS := 0.0;
    END_IF;
    "FRK_Clock".AccMs := "FRK_Clock".AccMs + #DeltaS * 1000.0;
    IF "FRK_Clock".AccMs >= 4294967296.0 THEN
        "FRK_Clock".AccMs := "FRK_Clock".AccMs - 4294967296.0;
    END_IF;
    "FRK_Clock".NowMs := TRUNC_UDINT("FRK_Clock".AccMs);
END_FUNCTION

FUNCTION "FRK_Elapsed" : UDInt
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    NewMs : UDInt;
    OldMs : UDInt;
END_VAR
VAR_TEMP
    Wide : ULInt;
END_VAR
BEGIN
    IF #NewMs >= #OldMs THEN
        #Wide := UDINT_TO_ULINT(#NewMs) - UDINT_TO_ULINT(#OldMs);
    ELSE
        #Wide := ULINT#4294967296 + UDINT_TO_ULINT(#NewMs) - UDINT_TO_ULINT(#OldMs);
    END_IF;
    #FRK_Elapsed := ULINT_TO_UDINT(#Wide);
END_FUNCTION

FUNCTION "FRK_Now" : LDT
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_TEMP Stamp : DTL; ResultCode : Int; END_VAR
BEGIN
    #ResultCode := RD_SYS_T(OUT => #Stamp);
    IF #ResultCode = 0 THEN #FRK_Now := DTL_TO_LDT(#Stamp);
    ELSE #FRK_Now := LDT#1970-01-01-00:00:00.000000000; END_IF;
END_FUNCTION

FUNCTION "FRK_ClearDiag" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    #Status.Diagnostic.ReasonCode := 0;
    #Status.Diagnostic.SourcePath := WSTRING#'';
    #Status.Diagnostic.Description := WSTRING#'';
    #Status.Diagnostic.IoTag := '';
    #Status.Diagnostic.IoAddress := '';
    #Status.Diagnostic.Severity := @E_Severity.LOW@;
    #Status.Diagnostic.Category := @E_Category.PROCESS@;
    #Status.Diagnostic.Since := LDT#1970-01-01-00:00:00.000000000;
    #Status.Diagnostic.TimeSynchronized := FALSE;
END_FUNCTION

FUNCTION "FRK_Rationalize" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Diag : "ST_Diagnostic";
END_VAR
BEGIN
    CASE #Diag.ReasonCode OF
@RATIONALIZATION@
        ELSE RETURN;
    END_CASE;
END_FUNCTION

FUNCTION "FRK_Diagnostic" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    ReasonCode : DInt;
    Description : WString;
    Severity : DInt;
END_VAR
VAR_IN_OUT
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    #Status.Diagnostic.ReasonCode := #ReasonCode;
    #Status.Diagnostic.SourcePath := STRING_TO_WSTRING(#Status.Name);
    #Status.Diagnostic.Description := #Description;
    #Status.Diagnostic.IoTag := '';
    #Status.Diagnostic.IoAddress := '';
    #Status.Diagnostic.Severity := #Severity;
    #Status.Diagnostic.Category := @E_Category.PROCESS@;
    #Status.Diagnostic.Since := "FRK_Now"();
    // UTC source alone is not proof of synchronization; quality stays false.
    #Status.Diagnostic.TimeSynchronized := FALSE;
END_FUNCTION

FUNCTION "FRK_Fault" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    ReasonCode : DInt;
    Description : WString;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    IF #Core.Exec = @E_ExecState.ERROR@ THEN
        RETURN;
    END_IF;
    "FRK_Diagnostic"(Status := #Status, ReasonCode := #ReasonCode, Description := #Description, Severity := @E_Severity.MED@);
    "FRK_Rationalize"(Diag := #Status.Diagnostic);
    #Core.Exec := @E_ExecState.ERROR@;
    #Core.Step := 0;
    #Core.Dispatch := FALSE;
    #Core.DiagTouched := TRUE;
END_FUNCTION

FUNCTION "FRK_AdoptFault" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Diag : "ST_Diagnostic";
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    IF #Core.Exec = @E_ExecState.ERROR@ THEN
        RETURN;
    END_IF;
    #Status.Diagnostic := #Diag;
    #Core.Exec := @E_ExecState.ERROR@;
    #Core.Step := 0;
    #Core.Dispatch := FALSE;
    #Core.DiagTouched := TRUE;
END_FUNCTION

FUNCTION "FRK_HoldDiag" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Diag : "ST_Diagnostic";
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    IF #Core.Exec <> @E_ExecState.BUSY@ THEN
        RETURN;
    END_IF;
    #Status.Diagnostic := #Diag;
    #Status.Diagnostic.Severity := @E_Severity.LOW@;
    #Core.HoldReq := TRUE;
    #Core.HoldReason := #Diag.ReasonCode;
    #Core.DiagTouched := TRUE;
END_FUNCTION

FUNCTION "FRK_Hold" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    ReasonCode : DInt;
    Description : WString;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    IF #Core.Exec <> @E_ExecState.BUSY@ THEN
        RETURN;
    END_IF;
    IF NOT #Core.Held OR #Core.HoldReason <> #ReasonCode THEN
        "FRK_Diagnostic"(Status := #Status, ReasonCode := #ReasonCode, Description := #Description, Severity := @E_Severity.LOW@);
    END_IF;
    #Core.HoldReq := TRUE;
    #Core.HoldReason := #ReasonCode;
    #Core.DiagTouched := TRUE;
END_FUNCTION

FUNCTION "FRK_Pending" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Diag : "ST_Diagnostic";
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    IF #Core.Exec = @E_ExecState.BUSY@ AND NOT #Core.DiagTouched THEN
        #Status.Diagnostic := #Diag;
        #Status.Diagnostic.Severity := @E_Severity.LOW@;
        #Core.DiagTouched := TRUE;
    END_IF;
END_FUNCTION

FUNCTION "FRK_Complete" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    IF #Core.Exec = @E_ExecState.BUSY@ THEN
        #Core.Exec := @E_ExecState.DONE@;
        #Core.Step := 0;
        #Core.Dispatch := FALSE;
        "FRK_ClearDiag"(Status := #Status);
    END_IF;
END_FUNCTION

FUNCTION "FRK_Start" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Supported : Bool;
    Timeout : Time;
    Label : String;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    #Core.CommandLabel := #Label;
    IF NOT #Supported THEN
        "FRK_Fault"(Core := #Core, Status := #Status, ReasonCode := @E_Reason.UNSUPPORTED_COMMAND@, Description := WSTRING#'fraktal.command.unsupported');
    ELSIF #Timeout <= T#0ms THEN
        "FRK_Fault"(Core := #Core, Status := #Status, ReasonCode := @E_Reason.RECIPE_INVALID@, Description := WSTRING#'fraktal.command.timeout.invalid');
    ELSE
        #Core.TimeoutMs := DINT_TO_UDINT(TIME_TO_DINT(#Timeout));
    END_IF;
END_FUNCTION

FUNCTION "FRK_Begin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Execute : Bool;
    Abort : Bool;
    Command : DInt;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    #Core.EvInit := NOT #Core.Initialized;
    #Core.Initialized := TRUE;
    #Core.EvCommandStart := FALSE;
    #Core.EvAbort := FALSE;
    #Core.EvAbortInError := FALSE;
    #Core.HoldReq := FALSE;
    #Core.DiagTouched := FALSE;
@FAULT_HANDLED_RESET@
    #Core.HookResult := 0;
    IF NOT #Execute AND (#Core.Armed OR #Core.ReleasePending) AND (#Core.Exec = @E_ExecState.DONE@ OR #Core.Exec = @E_ExecState.ERROR@ OR #Core.Exec = @E_ExecState.ABORTED@) THEN
        #Core.Exec := @E_ExecState.READY@;
        #Core.Armed := FALSE;
        #Core.HoldReason := 0;
        "FRK_ClearDiag"(Status := #Status);
    END_IF;
    IF #Execute AND NOT #Core.ExecPrev AND (#Core.Exec = @E_ExecState.READY@ OR (#Core.Exec = @E_ExecState.ERROR@ AND NOT #Core.Armed)) THEN
        #Core.Exec := @E_ExecState.BUSY@;
        #Core.Armed := TRUE;
        #Core.Command := #Command;
        #Core.Step := 10;
        #Core.StartMs := "FRK_Clock".NowMs;
        #Core.LastNowMs := "FRK_Clock".NowMs;
        #Core.ActiveMs := 0;
        #Core.TimeoutMs := 0;
        #Core.CommandLabel := '';
        #Core.TimingOpen := TRUE;
        #Core.Held := FALSE;
        #Core.HoldReason := 0;
        "FRK_ClearDiag"(Status := #Status);
        #Core.EvCommandStart := TRUE;
    END_IF;
    #Core.DeltaMs := "FRK_Elapsed"(NewMs := "FRK_Clock".NowMs, OldMs := #Core.LastNowMs);
    #Core.LastNowMs := "FRK_Clock".NowMs;
    #Core.ExecPrev := #Execute;
    #Core.Dispatch := #Core.Exec = @E_ExecState.BUSY@;
END_FUNCTION

FUNCTION "FRK_RouteAbort" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Abort : Bool;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
END_VAR
VAR_TEMP
    ErrorAbort : Bool;
END_VAR
BEGIN
    IF (#Abort OR #Core.ReleasePending) AND #Core.Exec = @E_ExecState.BUSY@ THEN
        #Core.Exec := @E_ExecState.ABORTED@;
        #Core.Step := 0;
        #Core.Dispatch := FALSE;
        #Core.EvAbort := TRUE;
    END_IF;
    #ErrorAbort := (#Abort OR #Core.ReleasePending) AND #Core.Exec = @E_ExecState.ERROR@;
    #Core.EvAbortInError := #ErrorAbort AND NOT #Core.AbortPrev;
    #Core.AbortPrev := #ErrorAbort;
END_FUNCTION

FUNCTION "FRK_TimingUpdate" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT DurationMs : UDInt; END_VAR
VAR_IN_OUT Row : "ST_TimingRow"; END_VAR
VAR_TEMP BoundedMs : UDInt; Duration : Time; AverageMs : LInt; END_VAR
BEGIN
    #BoundedMs := #DurationMs;
    IF #BoundedMs > UDINT#2147483647 THEN #BoundedMs := UDINT#2147483647; END_IF;
    #Duration := DINT_TO_TIME(UDINT_TO_DINT(#BoundedMs));
    IF #Row.Count < UDINT#4294967295 THEN #Row.Count := #Row.Count + 1; END_IF;
    #Row.Last := #Duration;
    IF #Row.Count = 1 OR #Duration < #Row.Minimum THEN #Row.Minimum := #Duration; END_IF;
    IF #Duration > #Row.Maximum THEN #Row.Maximum := #Duration; END_IF;
    #AverageMs := DINT_TO_LINT(TIME_TO_DINT(#Row.Avg));
    #AverageMs := #AverageMs + (UDINT_TO_LINT(#BoundedMs) - #AverageMs) / UDINT_TO_LINT(#Row.Count);
    #Row.Avg := DINT_TO_TIME(LINT_TO_DINT(#AverageMs));
END_FUNCTION

FUNCTION "FRK_RecordTiming" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Core : "FRK_Core";
END_VAR
VAR_TEMP
    Index : DInt;
    Slot : DInt;
    DurationMs : UDInt;
END_VAR
BEGIN
    #DurationMs := "FRK_Elapsed"(NewMs := "FRK_Clock".NowMs, OldMs := #Core.StartMs);
    // TIME's positive domain is bounded; clamp instead of publishing negatives.
    IF #DurationMs > UDINT#2147483647 THEN
        #DurationMs := UDINT#2147483647;
    END_IF;
    #Core.Timing.LastCmdTime := DINT_TO_TIME(UDINT_TO_DINT(#DurationMs));
    #Slot := 0;
    FOR #Index := 1 TO @MAX_CMD_STATS@ DO
        IF #Core.Timing.Rows[#Index].Count > 0 AND #Core.Timing.Rows[#Index].Id = #Core.Command THEN
            #Slot := #Index;
            EXIT;
        ELSIF #Slot = 0 AND #Core.Timing.Rows[#Index].Count = 0 THEN
            #Slot := #Index;
        END_IF;
    END_FOR;
    IF #Slot = 0 THEN
        #Core.Timing.Truncated := TRUE;
    ELSE
        #Core.Timing.Rows[#Slot].Id := #Core.Command;
        #Core.Timing.Rows[#Slot].Label := #Core.CommandLabel;
        "FRK_TimingUpdate"(DurationMs := #DurationMs, Row := #Core.Timing.Rows[#Slot]);
    END_IF;
    #Core.TimingOpen := FALSE;
END_FUNCTION

FUNCTION "FRK_End" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_OUTPUT
    Busy : Bool;
    Done : Bool;
    Error : Bool;
    Aborted : Bool;
    Held : Bool;
    ErrorID : DWord;
    Timing : "ST_ModuleTiming";
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
VAR_TEMP
    ActiveWide : ULInt;
END_VAR
BEGIN
    IF #Core.Exec = @E_ExecState.BUSY@ THEN
        IF #Core.Held AND NOT #Core.HoldReq AND NOT #Core.DiagTouched THEN
            "FRK_ClearDiag"(Status := #Status);
        END_IF;
        // HELD suspends progress timeout. Wall-clock command duration includes it.
        IF NOT #Core.Held AND NOT #Core.HoldReq THEN
            #ActiveWide := UDINT_TO_ULINT(#Core.ActiveMs) + UDINT_TO_ULINT(#Core.DeltaMs);
            IF #ActiveWide > ULINT#2147483647 THEN
                #ActiveWide := ULINT#2147483647;
            END_IF;
            #Core.ActiveMs := ULINT_TO_UDINT(#ActiveWide);
            IF #Core.TimeoutMs > 0 AND #Core.ActiveMs >= #Core.TimeoutMs THEN
                IF #Status.Diagnostic.ReasonCode = 0 THEN
                    "FRK_Fault"(Core := #Core, Status := #Status, ReasonCode := @E_Reason.TIMEOUT@, Description := WSTRING#'fraktal.command.timeout');
                ELSE
                    #Status.Diagnostic.Severity := @E_Severity.MED@;
                    "FRK_Rationalize"(Diag := #Status.Diagnostic);
                    #Core.Exec := @E_ExecState.ERROR@;
                    #Core.Step := 0;
                    #Core.Dispatch := FALSE;
                END_IF;
            END_IF;
        END_IF;
    END_IF;
    #Core.Held := #Core.HoldReq AND #Core.Exec = @E_ExecState.BUSY@;
    IF NOT #Core.Held THEN
        #Core.HoldReason := 0;
    END_IF;
    IF #Core.TimingOpen AND #Core.Exec <> @E_ExecState.BUSY@ THEN
        "FRK_RecordTiming"(Core := #Core);
    END_IF;
    #Busy := #Core.Exec = @E_ExecState.BUSY@;
    #Done := #Core.Exec = @E_ExecState.DONE@;
    #Error := #Core.Exec = @E_ExecState.ERROR@;
    #Aborted := #Core.Exec = @E_ExecState.ABORTED@;
    #Held := #Core.Held;
    #ErrorID := DINT_TO_DWORD(#Status.Diagnostic.ReasonCode);
    #Timing := #Core.Timing;
    #Status.State := #Core.Exec;
    #Status.FaultActive := #Core.Exec = @E_ExecState.ERROR@;
    #Core.HoldReq := FALSE;
    #Core.EvInit := FALSE;
    #Core.EvCommandStart := FALSE;
    #Core.EvAbort := FALSE;
    #Core.EvAbortInError := FALSE;
    #Core.ReleasePending := FALSE;
    "FRK_SyncRegistry"(Index := #Core.RegIndex, Status := #Status);
END_FUNCTION

FUNCTION "FRK_ReleaseCommand" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Core : "FRK_Core";
    Execute : Bool;
END_VAR
BEGIN
    #Execute := FALSE;
    #Core.ReleasePending := TRUE;
END_FUNCTION
