FUNCTION "FRK_Quiesce_SatelliteUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Module : "FB_SatelliteUnit";
      Hal : "ST_SatelliteUnitHal";
   END_VAR

   VAR_TEMP 
      WasBusy : Bool;
   END_VAR


BEGIN
	
	#Module.Execute := FALSE;
	#Module.Abort := FALSE;
	#WasBusy := #Module.Core.Exec = 1;
	"FRK_RouteAbort"(Abort := TRUE,
	                 Core := #Module.Core);
	IF #Module.Core.RegIndex > 0 THEN
	    "FRK_End"(Core := #Module.Core,
	              Status := #Module.Status,
	              Busy => #Module.Busy,
	              Done => #Module.Done,
	              Error => #Module.Error,
	              Aborted => #Module.Aborted,
	              Held => #Module.Held,
	              ErrorID => #Module.ErrorID,
	              Timing => #Module.Timing);
	END_IF;
	"FRK_AccessDropSession"(Access := #Module.Access);
	"FRK_AccessCancel"(Access := #Module.Access);
	#Module.RunningPublished := FALSE;
	"FRK_CyclicHook_SatelliteUnit"(Device := #Module.Device,
	                               Hal := #Hal,
	                               OutImm := #Module.OutImm,
	                               StateFlagCount := #Module.StateFlagCount,
	                               StateFlags := #Module.StateFlags,
	                               StateTouched := #Module.StateTouched);
	"FRK_Quiesce_DeclarationCell"(Module := #Module.Cell,
	                              Hal := #Hal.Cell);
	"FRK_Quiesce_InnerUnit"(Module := #Module.Inner,
	                        Hal := #Hal.Inner);
	"FRK_DiagSync"(Index := #Module.Core.RegIndex,
	               Withdraw := TRUE,
	               Status := #Module.Status,
	               Held := #Module.Core.Held,
	               Timeout := T#0ms,
	               ActiveTimeoutMs := #Module.Core.TimeoutMs);
	
END_FUNCTION

