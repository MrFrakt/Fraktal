FUNCTION "FRK_DecisionAudit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Key : WString;
      SourcePath : WString;
      Option : Int;
   END_VAR

   VAR_IN_OUT 
      AlarmLog : "FRK_AlarmLog";
   END_VAR

   VAR_TEMP 
      Diag : "ST_Diagnostic";
      Slot : Int;
      Gone : Bool;
      Choice : String[6];
   END_VAR


BEGIN
	
	#Diag := "FRK_UnitScratch".EmptyDiagnostic;
	#Diag.Description := #Key;
	IF #Option <> 0 THEN
	    #Diag.Description := CONCAT(IN1 := #Diag.Description, IN2 := WSTRING#' option=');
	    #Choice := INT_TO_STRING(#Option);
	    IF LEFT(IN := #Choice, L := 1) = '+' THEN
	        #Choice := DELETE(IN := #Choice, L := 1, P := 1);
	    END_IF;
	    #Diag.Description := CONCAT(IN1 := #Diag.Description, IN2 := STRING_TO_WSTRING(#Choice));
	END_IF;
	#Diag.SourcePath := #SourcePath;
	#Diag.Severity := 0;
	#Diag.Category := 0;
	#Slot := "FRK_AlarmRaise"(AlarmLog := #AlarmLog, Diag := #Diag, ResetClass := 0);
	IF #Slot > 0 THEN
	    #Gone := "FRK_AlarmGone"(AlarmLog := #AlarmLog, Slot := #Slot);
	END_IF;
	
END_FUNCTION

