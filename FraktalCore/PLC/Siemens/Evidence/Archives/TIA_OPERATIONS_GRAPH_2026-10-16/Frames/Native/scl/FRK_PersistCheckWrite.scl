FUNCTION "FRK_PersistCheckWrite" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      Done : Bool;
   END_VAR


BEGIN
	
	#Done := FALSE;
	#FRK_PersistCheckWrite := FALSE;
	CASE "FRK_PersistRuntime".Slot OF
	    1:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[1], Bytes := "FRK_PersistBuffers".D001Data, Check := "FRK_PersistRuntime".CheckWrite);
	    2:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[2], Bytes := "FRK_PersistBuffers".D002Data, Check := "FRK_PersistRuntime".CheckWrite);
	    3:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[3], Bytes := "FRK_PersistBuffers".D003Data, Check := "FRK_PersistRuntime".CheckWrite);
	    4:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[4], Bytes := "FRK_PersistBuffers".D004Data, Check := "FRK_PersistRuntime".CheckWrite);
	    5:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[5], Bytes := "FRK_PersistBuffers".D005Data, Check := "FRK_PersistRuntime".CheckWrite);
	    6:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[6], Bytes := "FRK_PersistBuffers".D006Data, Check := "FRK_PersistRuntime".CheckWrite);
	    7:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[7], Bytes := "FRK_PersistBuffers".D007Data, Check := "FRK_PersistRuntime".CheckWrite);
	    8:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[8], Bytes := "FRK_PersistBuffers".D008Data, Check := "FRK_PersistRuntime".CheckWrite);
	    9:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[9], Bytes := "FRK_PersistBuffers".D009Data, Check := "FRK_PersistRuntime".CheckWrite);
	    10:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[10], Bytes := "FRK_PersistBuffers".D010Data, Check := "FRK_PersistRuntime".CheckWrite);
	    11:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[11], Bytes := "FRK_PersistBuffers".D011Data, Check := "FRK_PersistRuntime".CheckWrite);
	    12:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[12], Bytes := "FRK_PersistBuffers".D012Data, Check := "FRK_PersistRuntime".CheckWrite);
	    13:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[13], Bytes := "FRK_PersistBuffers".D013Data, Check := "FRK_PersistRuntime".CheckWrite);
	    14:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[14], Bytes := "FRK_PersistBuffers".D014Data, Check := "FRK_PersistRuntime".CheckWrite);
	    15:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[15], Bytes := "FRK_PersistBuffers".D015Data, Check := "FRK_PersistRuntime".CheckWrite);
	    16:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[16], Bytes := "FRK_PersistBuffers".D016Data, Check := "FRK_PersistRuntime".CheckWrite);
	    17:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[17], Bytes := "FRK_PersistBuffers".D017Data, Check := "FRK_PersistRuntime".CheckWrite);
	    18:
