FUNCTION "FRK_TowerTick" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      MachineState : DInt;
      AlarmActive : Bool;
      HighestSeverity : DInt;
      OperatorActionRequired : Bool;
      ParCfg : "ST_SignalTowerParCfg";
   END_VAR

   VAR_IN_OUT 
      Book : "FRK_TowerBook";
      Status : "ST_SignalTowerOut";
   END_VAR

   VAR_TEMP 
      TestActive : Bool;
   END_VAR


BEGIN
	
	IF #Book.TestActive AND "FRK_Elapsed"(NewMs := "FRK_Clock".NowMs, OldMs := #Book.StartedMs) >= #Book.DurationMs THEN
	    #Book.TestActive := FALSE;
	END_IF;
	#TestActive := #Book.TestActive;
	#Status.Red := FALSE;
	#Status.Amber := FALSE;
	#Status.Green := FALSE;
	#Status.Blue := FALSE;
	#Status.White := FALSE;
	#Status.Horn := FALSE;
	#Status.TestActive := #TestActive;
	IF #TestActive THEN
	    #Status.Red := TRUE;
	    #Status.Amber := TRUE;
	    #Status.Green := TRUE;
	    #Status.Blue := TRUE;
	    #Status.White := TRUE;
	    #Status.Horn := TRUE;
	ELSE
	    CASE #MachineState OF
	        4:
	            #Status.Red := TRUE;
	        2, 3, 5:
	            #Status.Amber := TRUE;
	        0:
	            #Status.Green := TRUE;
	        1, 6:
	            #Status.TestActive := #TestActive;
	        ELSE
	            #Status.Red := TRUE; // unknown state fails conspicuously
	    END_CASE;
	    IF #AlarmActive THEN
	        CASE #HighestSeverity OF
	            2:
	                #Status.Red := TRUE;
	                #Status.Green := FALSE;
	                IF #ParCfg.HornOnHigh THEN
	                    #Status.Horn := TRUE;
	                ELSE
	                    #Status.TestActive := #TestActive;
	                END_IF;
	            1, 0:
	                IF NOT #Status.Red THEN
	                    #Status.Amber := TRUE;
	                ELSE
	                    #Status.TestActive := #TestActive;
	                END_IF;
	            ELSE
	                #Status.Red := TRUE;
	                #Status.Green := FALSE;
	        END_CASE;
	    ELSE
	        #Status.TestActive := #TestActive;
	    END_IF;
	    IF #OperatorActionRequired THEN
	        IF #ParCfg.OperatorUsesWhite THEN
	            #Status.White := TRUE;
	        ELSE
	            #Status.Blue := TRUE;
	        END_IF;
	    ELSE
	        #Status.TestActive := #TestActive;
	    END_IF;
	END_IF;
	
	
END_FUNCTION

