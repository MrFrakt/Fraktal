FUNCTION "FRK_Complete" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Core : "FRK_Core";
      Status : "ST_ModuleStatus";
   END_VAR


BEGIN
	
	IF #Core.Exec = 1 THEN
	    #Core.Exec := 2;
	    #Core.Step := 0;
	    #Core.Dispatch := FALSE;
	    "FRK_ClearDiag"(Status := #Status);
	END_IF;
	
END_FUNCTION

