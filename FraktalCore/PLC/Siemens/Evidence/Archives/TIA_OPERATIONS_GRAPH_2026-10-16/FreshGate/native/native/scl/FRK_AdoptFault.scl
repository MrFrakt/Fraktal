FUNCTION "FRK_AdoptFault" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Diag : "ST_Diagnostic";
   END_VAR

   VAR_IN_OUT 
      Core : "FRK_Core";
      Status : "ST_ModuleStatus";
   END_VAR


BEGIN
	
	IF #Core.Exec = 3 THEN
	    RETURN;
	END_IF;
	#Status.Diagnostic := #Diag;
	#Core.Exec := 3;
	#Core.Step := 0;
	#Core.Dispatch := FALSE;
	#Core.DiagTouched := TRUE;
	
END_FUNCTION

