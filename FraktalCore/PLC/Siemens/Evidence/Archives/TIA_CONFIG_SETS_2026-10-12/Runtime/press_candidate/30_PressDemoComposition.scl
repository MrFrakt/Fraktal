FUNCTION_BLOCK "FB_FraktalMain"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Startup {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
END_VAR
BEGIN
    IF #Startup THEN
        "FRK_Registry".Count := 0;
        "FRK_Registry".Fault := FALSE;
    END_IF;
    "FRK_ClockTick"();
    "FRK_ConfigBoot"(Startup := #Startup);
    "FRK_SetBoot"(Startup := #Startup);
    "PressDemo"(ParentIndex := 0, Startup := #Startup, Hal := "GDB_FraktalHal".Data.PressDemo);
END_FUNCTION_BLOCK
