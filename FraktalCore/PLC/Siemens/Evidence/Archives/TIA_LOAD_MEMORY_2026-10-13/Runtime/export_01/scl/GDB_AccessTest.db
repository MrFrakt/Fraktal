      HashData { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0..47] of Byte;
      Hash0 { ExternalWritable := 'False'} : Array[0..31] of Byte;
      Hash1 { ExternalWritable := 'False'} : Array[0..31] of Byte;
      Hash2 { ExternalWritable := 'False'} : Array[0..31] of Byte;
      Hash3 { ExternalWritable := 'False'} : Array[0..31] of Byte;
      HashOk { ExternalWritable := 'False'} : Bool;
   END_VAR


