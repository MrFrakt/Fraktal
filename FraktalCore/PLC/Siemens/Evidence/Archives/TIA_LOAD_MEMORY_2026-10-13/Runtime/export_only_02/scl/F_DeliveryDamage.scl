FUNCTION "F_DeliveryDamage" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Startup : Bool;
   END_VAR

   VAR_TEMP 
      Slot : Int;
      Head : Int;
   END_VAR


BEGIN
	
	IF NOT #Startup OR "GDB_DeliveryTest".Damage = 0 THEN
	    RETURN;
	END_IF;
	#Slot := "FRK_DeliveryIndex"(Scope := "GDB_DeliveryTest".Scope);
	IF #Slot < 1 OR #Slot > 3 THEN
	    RETURN;
	END_IF;
	#Head := "FRK_EventDeliveryStore".Images[#Slot].Head;
	CASE "GDB_DeliveryTest".Damage OF
	    1:
	        "FRK_EventDeliveryStore".Images[#Slot].SchemaVersion := 999;
	    2:
	        "FRK_EventDeliveryStore".Images[#Slot].Head := 0;
	    3:
	        "FRK_EventDeliveryStore".Images[#Slot].Count := 9;
	    4:
	        "FRK_EventDeliveryStore".Images[#Slot].Checksum := "FRK_EventDeliveryStore".Images[#Slot].Checksum XOR DWORD#1;
	    5:
	        IF #Head >= 1 AND #Head <= 8 THEN
	            "FRK_EventDeliveryStore".Images[#Slot].Entries[#Head].Ev.Description := WSTRING#'test.tampered';
	        END_IF;
	    6:
	        IF #Head >= 1 AND #Head <= 8 THEN
	            "FRK_EventDeliveryStore".Images[#Slot].Entries[#Head].Sequence := 0;
	        END_IF;
	    7:
	        "FRK_EventDeliveryStore".Anchors[#Slot].Checksum := "FRK_EventDeliveryStore".Anchors[#Slot].Checksum XOR DWORD#1;
	    8:
	        "FRK_EventDeliveryStore".Images[#Slot].SchemaVersion := 0;
	        "FRK_EventDeliveryStore".Images[#Slot].Revision := 0;
	        "FRK_EventDeliveryStore".Images[#Slot].Checksum := DWORD#0;
	    9:
	        "FRK_EventDeliveryStore".Images[#Slot].NextSequence := UDINT#4294967295;
	        "FRK_DeliverySave"(Slot := #Slot);
	    10:
	        "FRK_EventDeliveryStore".Anchors[#Slot].Checksum := "FRK_DeliveryAnchorCrc"(Slot := #Slot);
	    ELSE
	        RETURN;
	END_CASE;
	"GDB_DeliveryTest".Applied := TRUE;
	"GDB_DeliveryTest".Damage := 0;
	
END_FUNCTION

