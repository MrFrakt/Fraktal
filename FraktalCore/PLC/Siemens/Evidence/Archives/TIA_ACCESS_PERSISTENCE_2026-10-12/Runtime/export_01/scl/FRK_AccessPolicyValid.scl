FUNCTION "FRK_AccessPolicyValid" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Image : "FRK_AccessPolicyImage";
   END_VAR

   VAR_TEMP 
      Index : Int;
   END_VAR


BEGIN
	
	#FRK_AccessPolicyValid := FALSE;
	IF #Image.SchemaVersion <> 1 OR #Image.Scope = '' OR #Image.Generation = 0 OR #Image.Policy.SessionTimeout < T#0ms OR #Image.Policy.SessionTimeout > T#604800000ms THEN
	    RETURN;
	END_IF;
	FOR #Index := 0 TO 11 DO
	    IF #Image.Policy.Required[#Index] < 0 OR #Image.Policy.Required[#Index] > 4 THEN
	        RETURN;
	    END_IF;
	END_FOR;
	#FRK_AccessPolicyValid := #Image.Checksum = "FRK_AccessPolicyCrc"(Image := #Image);
	
END_FUNCTION

