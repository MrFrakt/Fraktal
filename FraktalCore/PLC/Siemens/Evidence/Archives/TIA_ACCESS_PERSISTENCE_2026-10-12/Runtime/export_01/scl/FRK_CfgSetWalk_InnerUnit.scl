	END_IF;
	IF #Phase = 2 AND "FRK_SetRuntime".Work[#RootIndex].Payload.Info.Kind = 1 THEN
	    #Module.StationCfg := #Module.ConfigStageStationCfg;
	END_IF;
	#Ok := "FRK_CfgSetWalk_DeclarationCell"(Module := #Module.Cell, RootIndex := #RootIndex, Phase := #Phase, Access := #Access, Ready := #Ready);
	IF NOT #Ok THEN
	    RETURN;
	END_IF;
	#FRK_CfgSetWalk_InnerUnit := TRUE;
	
END_FUNCTION

