TYPE "ST_ConfigSetInfo"
VERSION : 0.1
   STRUCT
      Used : Bool;
      SetName : String[80];
      RootIdentity : String[80];
      SetSchema : UInt;
      ConfigRev : UDInt;
      Kind : DInt;
      ModelCode : String[64];
      RecordCount : Int;
      CreatedAt : LDT;
      TimeSynchronized : Bool;
   END_STRUCT;

END_TYPE

