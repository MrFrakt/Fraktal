BEGIN
    IF #RootIndex = 1 AND #Ordinal = 1 THEN "FRK_PersistDirty"(Slot := 5); END_IF;
    IF #RootIndex = 1 AND #Ordinal = 2 THEN "FRK_PersistDirty"(Slot := 6); END_IF;
    IF #RootIndex = 1 AND #Ordinal = 3 THEN "FRK_PersistDirty"(Slot := 7); END_IF;
    IF #RootIndex = 1 AND #Ordinal = 4 THEN "FRK_PersistDirty"(Slot := 8); END_IF;
    IF #RootIndex = 2 AND #Ordinal = 1 THEN "FRK_PersistDirty"(Slot := 13); END_IF;
    IF #RootIndex = 2 AND #Ordinal = 2 THEN "FRK_PersistDirty"(Slot := 14); END_IF;
    IF #RootIndex = 2 AND #Ordinal = 3 THEN "FRK_PersistDirty"(Slot := 15); END_IF;
    IF #RootIndex = 2 AND #Ordinal = 4 THEN "FRK_PersistDirty"(Slot := 16); END_IF;
END_FUNCTION
FUNCTION "FRK_PersistModelDirty" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
END_VAR
BEGIN
    IF #RootIndex = 1 THEN "FRK_PersistDirty"(Slot := 1); END_IF;
    IF #RootIndex = 2 THEN "FRK_PersistDirty"(Slot := 9); END_IF;
END_FUNCTION
FUNCTION "FRK_PersistVirginConfig" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Scope : String;
    ModelCode : String;
    Kind : DInt;
END_VAR
VAR_TEMP
    Slot : Int;
END_VAR
BEGIN
    #FRK_PersistVirginConfig := FALSE;
    #Slot := "FRK_PersistConfigSlot"(Scope := #Scope, ModelCode := #ModelCode, Kind := #Kind);
    IF #Slot > 0 THEN #FRK_PersistVirginConfig := "FRK_PersistConsumers".Rows[#Slot].Virgin; END_IF;
END_FUNCTION
FUNCTION "FRK_PersistLineTick" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
    IF "FRK_PersistConsumers".Ready AND "FRK_Line".Data.Dirty THEN
        "FRK_PersistDirty"(Slot := 18);
        "FRK_Line".Data.Dirty := FALSE;
    END_IF;
END_FUNCTION
