// Core 3.12: derived facts; owning frame resolves freshness every scan.
FUNCTION "FRK_StateSweep" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Startup : Bool;
END_VAR
VAR_IN_OUT
    Flags : Array[1..@MAX_STATE_FLAGS@] of "ST_StateFlag";
    Count : Int;
    Touched : Array[1..@MAX_STATE_FLAGS@] of Bool;
END_VAR
VAR_TEMP
    Index : Int;
END_VAR
BEGIN
    IF #Count < 0 OR #Count > @MAX_STATE_FLAGS@ THEN #Count := 0; END_IF;
    FOR #Index := 1 TO #Count DO
        IF #Startup OR NOT #Touched[#Index] THEN
            #Flags[#Index].Value := FALSE;
            #Flags[#Index].Stale := TRUE;
        END_IF;
        #Touched[#Index] := FALSE;
    END_FOR;
END_FUNCTION

FUNCTION "FRK_State" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Idx : Int;
    Key : String;
    Ok : Bool;
END_VAR
VAR_IN_OUT
    Flags : Array[1..@MAX_STATE_FLAGS@] of "ST_StateFlag";
    Count : Int;
    Touched : Array[1..@MAX_STATE_FLAGS@] of Bool;
END_VAR
VAR_TEMP
    Stamp : DTL;
    ResultCode : Int;
END_VAR
BEGIN
    #FRK_State := #Ok;
    IF #Idx < 1 OR #Idx > @MAX_STATE_FLAGS@ OR LEN(#Key) = 0 OR LEN(#Key) > @STATE_KEY_WIDTH@ THEN RETURN; END_IF;
    IF #Idx > #Count THEN #Count := #Idx; END_IF;
    IF #Flags[#Idx].Value <> #Ok OR #Flags[#Idx].Key <> #Key OR #Flags[#Idx].Stale THEN
        #Flags[#Idx].Since := LDT#1970-01-01-00:00:00.000000000;
        #ResultCode := RD_SYS_T(OUT => #Stamp);
        IF #ResultCode = 0 THEN #Flags[#Idx].Since := DTL_TO_LDT(#Stamp); END_IF;
    END_IF;
    #Flags[#Idx].Key := #Key;
    #Flags[#Idx].Value := #Ok;
    #Flags[#Idx].Stale := FALSE;
    #Touched[#Idx] := TRUE;
END_FUNCTION
