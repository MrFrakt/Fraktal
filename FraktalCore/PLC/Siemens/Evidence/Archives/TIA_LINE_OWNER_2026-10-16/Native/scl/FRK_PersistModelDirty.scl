FUNCTION "FRK_PersistModelDirty" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      RootIndex : Int;
   END_VAR


BEGIN
	
	IF #RootIndex = 1 THEN
	    "FRK_PersistDirty"(Slot := 1);
	END_IF;
	IF #RootIndex = 2 THEN
	    "FRK_PersistDirty"(Slot := 9);
	END_IF;
	
END_FUNCTION

