FUNCTION "FRK_ViewWatch" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Owner : DInt;
      StepNo : DInt;
      Branch : DInt;
      Target : DInt;
      Waiting : Bool;
      OwnFailure : Bool;
   END_VAR

   VAR_IN_OUT 
      Defs : Array[*] of "ST_SequenceStepDef";
      Rows : Array[*] of "ST_SequenceStep";
      Notes : Array[*] of "ST_SequenceAnnotation";
      Count : Int;
      NoteCount : Int;
      Current : "ST_StepRecord";
      Book : "FRK_ViewBook";
      GuardDefaults : Array[*] of Time;
   END_VAR

   VAR_TEMP 
      Index : Int;
      RowIdx : Int;
      Summary : "FRK_DiagSummary";
   END_VAR


BEGIN
	
	#RowIdx := 0;
	FOR #Index := 1 TO #Count DO
	    IF #Defs[#Index].StepNo = #StepNo AND #Defs[#Index].Branch = #Branch THEN
	        #RowIdx := #Index;
	        EXIT;
	    END_IF;
	END_FOR;
	IF #RowIdx = 0 THEN
	    RETURN;
	END_IF;
	"FRK_DiagRead"(Owner := #Owner, Target := #Target, Faults := TRUE, DescendantsOnly := FALSE, Summary := #Summary);
	IF #Summary.Timeout > #GuardDefaults[#RowIdx] THEN
	    #GuardDefaults[#RowIdx] := #Summary.Timeout;
	END_IF;
	IF #Summary.Fault AND NOT #OwnFailure THEN
	    IF NOT #Book.FaultFound THEN
	        #Book.FaultFound := TRUE;
	        #Book.FaultDiagnostic := #Summary.Diagnostic;
	    END_IF;
	    "FRK_ViewNote"(StepNo := #StepNo,
	                   Branch := #Branch,
	                   IsError := TRUE,
	                   Key := WSTRING_TO_STRING(#Summary.Diagnostic.Description),
	                   SourcePath := WSTRING_TO_STRING(#Summary.Diagnostic.SourcePath),
	                   Defs := #Defs,
	                   Rows := #Rows,
	                   Notes := #Notes,
	                   Count := #Count,
	                   NoteCount := #NoteCount);
	END_IF;
	IF #Branch = 0 AND #Current.StepNo = #StepNo AND #Waiting AND NOT #Book.PendingFound THEN
	    #Book.AwaitIndex := #Target;
	END_IF;
	
END_FUNCTION

