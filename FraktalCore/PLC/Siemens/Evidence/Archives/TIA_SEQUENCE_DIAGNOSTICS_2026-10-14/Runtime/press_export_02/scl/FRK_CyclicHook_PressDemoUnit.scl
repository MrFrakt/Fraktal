FUNCTION "FRK_CyclicHook_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Core : "FRK_Core";
      Door : "FB_CylinderCM";
      Held : Bool;
      OutImm : "ST_PressDemoOutImm";
      ParCfg : "ST_PressDemoParCfg";
      PartSlide : "FB_CylinderCM";
      PressRam : "FB_CylinderCM";
      StateFlagCount : Int;
      StateFlags : Array[1..12] of "ST_StateFlag";
      StateTouched : Array[1..12] of Bool;
      Status : "ST_ModuleStatus";
   END_VAR


BEGIN
	
	#OutImm.Homed := "FRK_State"(Idx := 1, Key := 'project.state.pressAtLoadPosition',
	                             Ok := #PressRam.OutImm.Retracted AND #Door.OutImm.Retracted AND #PartSlide.OutImm.Retracted, Flags := #StateFlags, Count := #StateFlagCount, Touched := #StateTouched);
	"FRK_DiagSync"(Index := #Core.RegIndex,
	               Withdraw := FALSE,
	               Status := #Status,
	               Held := #Held,
	               Timeout := #ParCfg.Timeout,
	               ActiveTimeoutMs := #Core.TimeoutMs);
	
END_FUNCTION

