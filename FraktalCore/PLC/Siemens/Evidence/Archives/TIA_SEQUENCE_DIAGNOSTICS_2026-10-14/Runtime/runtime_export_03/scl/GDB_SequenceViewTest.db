DATA_BLOCK "GDB_SequenceViewTest"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      Owner : DInt;
      Enabled : Bool;
      Annotate : Bool;
      IsError : Bool;
      StepNo : DInt;
      Branch : DInt;
      Depth : Int;
      Visit : UDInt;
      StepName : String[120];
      ExpectedTime : Time;
      Elapsed : Time;
      Key : String[120];
      SourcePath : String[80];
      FastPulse : Bool;
      Parent : Bool;
      AwaitEnabled : Bool;
      AwaitOk : Bool;
      AwaitLabel : String[120];
      UseHelper : Bool;
      HelperReset : Bool;
      HelperOffset : DInt;
      Overflow { ExternalWritable := 'False'} : Bool;
   END_VAR


BEGIN

END_DATA_BLOCK

