FUNCTION "FRK_ClearDiag" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Status : "ST_ModuleStatus";
   END_VAR


BEGIN
	
	#Status.Diagnostic.ReasonCode := 0;
	#Status.Diagnostic.SourcePath := WSTRING#'';
	#Status.Diagnostic.Description := WSTRING#'';
	#Status.Diagnostic.IoTag := '';
	#Status.Diagnostic.IoAddress := '';
	#Status.Diagnostic.Severity := 0;
	#Status.Diagnostic.Category := 0;
	#Status.Diagnostic.Since := LDT#1970-01-01-00:00:00.000000000;
	#Status.Diagnostic.TimeSynchronized := FALSE;
	
END_FUNCTION

