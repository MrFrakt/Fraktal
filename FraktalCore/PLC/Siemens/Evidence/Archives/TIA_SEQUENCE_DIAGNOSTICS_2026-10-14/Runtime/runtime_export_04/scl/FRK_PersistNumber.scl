FUNCTION "FRK_PersistNumber" : DWord
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// Binding-owned byte medium. Consumers own content validation and authority.
   VAR_INPUT 
      Offset : Int;
   END_VAR

   VAR_IN_OUT 
      Bytes : Array[*] of Byte;
   END_VAR

   VAR_TEMP 
      Index : Int;
   END_VAR


BEGIN
	
	#FRK_PersistNumber := DWORD#0;
	IF #Offset < 0 OR #Offset > UPPER_BOUND(ARR := #Bytes, DIM := 1) - 3 THEN
	    RETURN;
	END_IF;
	FOR #Index := 0 TO 3 DO
	    #FRK_PersistNumber := #FRK_PersistNumber OR SHL(IN := BYTE_TO_DWORD(#Bytes[#Offset + #Index]), N := INT_TO_UINT(#Index * 8));
	END_FOR;
	
END_FUNCTION

