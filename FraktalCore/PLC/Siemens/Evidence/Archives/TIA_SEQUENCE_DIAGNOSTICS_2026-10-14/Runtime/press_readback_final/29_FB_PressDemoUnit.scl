    #FRK_Route_PressDemoUnit := #FRK_Route_PressDemoUnit OR #RouteMatched;
END_FUNCTION
FUNCTION "FRK_CfgDef_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    FieldIndex : Int;
END_VAR
BEGIN
    "FRK_ConfigScratch".Entry := "FRK_ConfigScratch".Blank;
    CASE #FieldIndex OF
        1:
            "FRK_ConfigScratch".Entry.WriteKey := 'requireTwoHandStart';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.Item := WSTRING#'StationCfg/RequireTwoHandStart';
            "FRK_ConfigScratch".Entry.ConfigKind := 1;
            "FRK_ConfigScratch".Entry.ValueType := 2;
            "FRK_ConfigScratch".Entry.Writable := TRUE;
            "FRK_ConfigScratch".Entry.RequiresReady := TRUE;
            "FRK_ConfigScratch".Entry.HasMinimum := FALSE;
            "FRK_ConfigScratch".Entry.HasMaximum := FALSE;
            "FRK_ConfigScratch".Entry.Minimum := 0.0;
            "FRK_ConfigScratch".Entry.Maximum := 1.0;
            "FRK_ConfigScratch".Entry.LabelKey := 'project.config.requireTwoHandStart';
            "FRK_ConfigScratch".Storage := 1;
            "FRK_ConfigScratch".Schema := 1;
            "FRK_ConfigScratch".Minimum := 0.0;
            "FRK_ConfigScratch".Maximum := 1.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 0;
            "FRK_ConfigScratch".MinWrite := 0;
        2:
            "FRK_ConfigScratch".Entry.WriteKey := 'transferSettleTime';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.Item := WSTRING#'StationCfg/TransferSettleTime';
            "FRK_ConfigScratch".Entry.ConfigKind := 1;
            "FRK_ConfigScratch".Entry.ValueType := 3;
            "FRK_ConfigScratch".Entry.Writable := TRUE;
            "FRK_ConfigScratch".Entry.RequiresReady := TRUE;
            "FRK_ConfigScratch".Entry.HasMinimum := TRUE;
            "FRK_ConfigScratch".Entry.HasMaximum := TRUE;
            "FRK_ConfigScratch".Entry.Minimum := 0.0;
            "FRK_ConfigScratch".Entry.Maximum := 30000.0;
            "FRK_ConfigScratch".Entry.LabelKey := 'project.config.transferSettleTime';
            "FRK_ConfigScratch".Storage := 7;
            "FRK_ConfigScratch".Schema := 1;
            "FRK_ConfigScratch".Minimum := 0.0;
            "FRK_ConfigScratch".Maximum := 30000.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 0;
            "FRK_ConfigScratch".MinWrite := 0;
        3:
            "FRK_ConfigScratch".Entry.WriteKey := 'pressSettleTime';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.Item := WSTRING#'StationCfg/PressSettleTime';
            "FRK_ConfigScratch".Entry.ConfigKind := 1;
            "FRK_ConfigScratch".Entry.ValueType := 3;
            "FRK_ConfigScratch".Entry.Writable := TRUE;
            "FRK_ConfigScratch".Entry.RequiresReady := TRUE;
            "FRK_ConfigScratch".Entry.HasMinimum := TRUE;
            "FRK_ConfigScratch".Entry.HasMaximum := TRUE;
            "FRK_ConfigScratch".Entry.Minimum := 0.0;
            "FRK_ConfigScratch".Entry.Maximum := 30000.0;
            "FRK_ConfigScratch".Entry.LabelKey := 'project.config.pressSettleTime';
            "FRK_ConfigScratch".Storage := 7;
            "FRK_ConfigScratch".Schema := 1;
            "FRK_ConfigScratch".Minimum := 0.0;
            "FRK_ConfigScratch".Maximum := 30000.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 0;
            "FRK_ConfigScratch".MinWrite := 0;
        ELSE RETURN;
    END_CASE;
END_FUNCTION
FUNCTION "FRK_CfgRestore_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
    StationCfg : "ST_PressDemoStationCfg";
    ConfigStageStationCfg : "ST_PressDemoStationCfg";
    ConfigDefaultStationCfg : "ST_PressDemoStationCfg";
END_VAR
VAR_TEMP
    RootIndex : Int;
    Ok : Bool;
    Stored : Bool;
END_VAR
BEGIN
    #RootIndex := "FRK_ConfigRoot"(RegIndex := #Core.RegIndex);
    IF #RootIndex = 0 THEN RETURN; END_IF;
    #Ok := TRUE;
    #ConfigStageStationCfg := #ConfigDefaultStationCfg;
    "FRK_CfgDef_PressDemoUnit"(FieldIndex := 1);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := '') = 0 THEN
    IF #ConfigDefaultStationCfg.RequireTwoHandStart THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true'; ELSE "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false'; END_IF;
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := '', Kind := 1) THEN
            #Ok := FALSE;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := '');
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageStationCfg.RequireTwoHandStart := "FRK_ConfigScratch".Value.Flag;
    END_IF;
    "FRK_CfgDef_PressDemoUnit"(FieldIndex := 2);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := '') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultStationCfg.TransferSettleTime));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := '', Kind := 1) THEN
            #Ok := FALSE;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := '');
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageStationCfg.TransferSettleTime := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
    END_IF;
    "FRK_CfgDef_PressDemoUnit"(FieldIndex := 3);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := '') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultStationCfg.PressSettleTime));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := '', Kind := 1) THEN
            #Ok := FALSE;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := '');
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageStationCfg.PressSettleTime := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
    END_IF;
    IF #Ok THEN
        #StationCfg := #ConfigStageStationCfg;
    ELSE
        #StationCfg := #ConfigDefaultStationCfg;
        "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 1);
    IF #ConfigDefaultStationCfg.RequireTwoHandStart THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true'; ELSE "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false'; END_IF;
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 2);
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultStationCfg.TransferSettleTime));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 3);
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultStationCfg.PressSettleTime));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
    END_IF;
END_FUNCTION
FUNCTION "FRK_Config_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Access : "FRK_Access";
    RootIndex : Int;
    ModelIndex : UDInt;
END_VAR
VAR_IN_OUT
    Status : "ST_ModuleStatus";
    ModePolicy : Array[0..6] of "ST_ModePolicy";
    AvailableModelCount : Int;
    SequenceStepDef : Array[1..23] of "ST_SequenceStepDef";
    SequenceStepCount : Int;
    StationCfg : "ST_PressDemoStationCfg";
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
    Cursor : "FRK_ConfigCursor";
    Page : "ST_ConfigPage";
END_VAR
VAR_TEMP
    Ok : Bool;
END_VAR
BEGIN
    IF #ModelIndex = 0 THEN
        "FRK_ConfigUnit"(Scope := #Status.Name, Policy := #ModePolicy, ModelCount := #AvailableModelCount, ReadLevel := #Access.Policy.Required[0], Readable := #Access.CurrentLevel >= #Access.Policy.Required[0], Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN "FRK_ViewManifest"(Scope := #Status.Name, Defs := #SequenceStepDef, Count := #SequenceStepCount, ReadLevel := #Access.Policy.Required[0], Readable := #Access.CurrentLevel >= #Access.Policy.Required[0], Cursor := #Cursor, Page := #Page); END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 1);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    IF #StationCfg.RequireTwoHandStart THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true'; ELSE "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false'; END_IF;
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 2);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#StationCfg.TransferSettleTime));
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 3);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#StationCfg.PressSettleTime));
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN "FRK_Config_CylinderCM"(Module := #PressRam, Access := #Access, RootIndex := #RootIndex, ModelIndex := #ModelIndex, Cursor := #Cursor, Page := #Page); END_IF;
    IF #ModelIndex = 0 THEN "FRK_Config_CylinderCM"(Module := #Door, Access := #Access, RootIndex := #RootIndex, ModelIndex := #ModelIndex, Cursor := #Cursor, Page := #Page); END_IF;
    IF #ModelIndex = 0 THEN "FRK_Config_CylinderCM"(Module := #PartSlide, Access := #Access, RootIndex := #RootIndex, ModelIndex := #ModelIndex, Cursor := #Cursor, Page := #Page); END_IF;
END_FUNCTION
FUNCTION "FRK_CfgWrite_PressDemoUnit" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Request : "ST_HmiRequest";
    Access : "FRK_Access";
    RootIndex : Int;
    RootReady : Bool;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
    StationCfg : "ST_PressDemoStationCfg";
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
    Matched : Bool;
END_VAR
VAR_TEMP
    Ok : Bool;
    Level : DInt;
    Code : String[64];
    Inactive : Bool;
END_VAR
BEGIN
    #FRK_CfgWrite_PressDemoUnit := FALSE;
    IF #Request.TargetPath = STRING_TO_WSTRING(#Status.Name) OR (#Request.TargetPath = WSTRING#'' AND #Core.ParentIndex = 0) THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 1);
        IF #Request.NameValue = "FRK_ConfigScratch".Entry.WriteKey THEN
            #Matched := TRUE;
            IF DINT_TO_UDINT(#Request.IntValue) <> "FRK_ConfigScratch".Entry.WriteRevision THEN RETURN; END_IF;
            #Level := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
            IF #Access.CurrentLevel < #Level THEN RETURN; END_IF;
            IF #Request.DurationMs <> 0 THEN RETURN; END_IF;
            #Code := '';
            #Inactive := FALSE;
            IF "FRK_ConfigScratch".Entry.RequiresReady AND NOT #Inactive AND NOT #RootReady THEN RETURN; END_IF;
            #Ok := "FRK_ConfigDecode"(Text := #Request.TextValue, Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum, Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength, Value := "FRK_ConfigScratch".Value);
            IF NOT #Ok THEN RETURN; END_IF;
            #Ok := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := #Code, Text := #Request.TextValue, RootIndex := #RootIndex);
            IF NOT #Ok THEN RETURN; END_IF;
            IF NOT #Inactive THEN
    #StationCfg.RequireTwoHandStart := "FRK_ConfigScratch".Value.Flag;
            END_IF;
            #FRK_CfgWrite_PressDemoUnit := TRUE;
            RETURN;
        END_IF;
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 2);
        IF #Request.NameValue = "FRK_ConfigScratch".Entry.WriteKey THEN
            #Matched := TRUE;
            IF DINT_TO_UDINT(#Request.IntValue) <> "FRK_ConfigScratch".Entry.WriteRevision THEN RETURN; END_IF;
            #Level := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
            IF #Access.CurrentLevel < #Level THEN RETURN; END_IF;
            IF #Request.DurationMs <> 0 THEN RETURN; END_IF;
            #Code := '';
            #Inactive := FALSE;
            IF "FRK_ConfigScratch".Entry.RequiresReady AND NOT #Inactive AND NOT #RootReady THEN RETURN; END_IF;
            #Ok := "FRK_ConfigDecode"(Text := #Request.TextValue, Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum, Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength, Value := "FRK_ConfigScratch".Value);
            IF NOT #Ok THEN RETURN; END_IF;
            #Ok := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := #Code, Text := #Request.TextValue, RootIndex := #RootIndex);
            IF NOT #Ok THEN RETURN; END_IF;
            IF NOT #Inactive THEN
    #StationCfg.TransferSettleTime := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
            END_IF;
            #FRK_CfgWrite_PressDemoUnit := TRUE;
            RETURN;
        END_IF;
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 3);
        IF #Request.NameValue = "FRK_ConfigScratch".Entry.WriteKey THEN
            #Matched := TRUE;
            IF DINT_TO_UDINT(#Request.IntValue) <> "FRK_ConfigScratch".Entry.WriteRevision THEN RETURN; END_IF;
            #Level := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
            IF #Access.CurrentLevel < #Level THEN RETURN; END_IF;
            IF #Request.DurationMs <> 0 THEN RETURN; END_IF;
            #Code := '';
            #Inactive := FALSE;
            IF "FRK_ConfigScratch".Entry.RequiresReady AND NOT #Inactive AND NOT #RootReady THEN RETURN; END_IF;
            #Ok := "FRK_ConfigDecode"(Text := #Request.TextValue, Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum, Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength, Value := "FRK_ConfigScratch".Value);
            IF NOT #Ok THEN RETURN; END_IF;
            #Ok := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := #Code, Text := #Request.TextValue, RootIndex := #RootIndex);
            IF NOT #Ok THEN RETURN; END_IF;
            IF NOT #Inactive THEN
    #StationCfg.PressSettleTime := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
            END_IF;
            #FRK_CfgWrite_PressDemoUnit := TRUE;
            RETURN;
        END_IF;
    END_IF;
    #Ok := "FRK_CfgWrite_CylinderCM"(Module := #PressRam, Access := #Access, Request := #Request, RootIndex := #RootIndex, RootReady := #RootReady, Matched := #Matched);
    IF #Matched THEN #FRK_CfgWrite_PressDemoUnit := #Ok; RETURN; END_IF;
    #Ok := "FRK_CfgWrite_CylinderCM"(Module := #Door, Access := #Access, Request := #Request, RootIndex := #RootIndex, RootReady := #RootReady, Matched := #Matched);
    IF #Matched THEN #FRK_CfgWrite_PressDemoUnit := #Ok; RETURN; END_IF;
    #Ok := "FRK_CfgWrite_CylinderCM"(Module := #PartSlide, Access := #Access, Request := #Request, RootIndex := #RootIndex, RootReady := #RootReady, Matched := #Matched);
    IF #Matched THEN #FRK_CfgWrite_PressDemoUnit := #Ok; RETURN; END_IF;
END_FUNCTION
FUNCTION "FRK_CfgRecipe_PressDemoUnit" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    ModelCode : String;
    Phase : Int;
END_VAR
VAR_IN_OUT
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
    RejectScope : String;
    RejectKey : String;
END_VAR
VAR_TEMP
    Ok : Bool;
END_VAR
BEGIN
    #FRK_CfgRecipe_PressDemoUnit := TRUE;
    #Ok := "FRK_CfgRecipe_CylinderCM"(Module := #PressRam, ModelCode := #ModelCode, Phase := #Phase, RejectScope := #RejectScope, RejectKey := #RejectKey);
    IF NOT #Ok THEN #FRK_CfgRecipe_PressDemoUnit := FALSE; RETURN; END_IF;
    #Ok := "FRK_CfgRecipe_CylinderCM"(Module := #Door, ModelCode := #ModelCode, Phase := #Phase, RejectScope := #RejectScope, RejectKey := #RejectKey);
    IF NOT #Ok THEN #FRK_CfgRecipe_PressDemoUnit := FALSE; RETURN; END_IF;
    #Ok := "FRK_CfgRecipe_CylinderCM"(Module := #PartSlide, ModelCode := #ModelCode, Phase := #Phase, RejectScope := #RejectScope, RejectKey := #RejectKey);
    IF NOT #Ok THEN #FRK_CfgRecipe_PressDemoUnit := FALSE; RETURN; END_IF;
END_FUNCTION
FUNCTION "FRK_CfgSetWalk_PressDemoUnit" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
    Phase : Int;
    Access : "FRK_Access";
    Ready : Bool;
END_VAR
VAR_IN_OUT
    Status : "ST_ModuleStatus";
    StationCfg : "ST_PressDemoStationCfg";
    ConfigStageStationCfg : "ST_PressDemoStationCfg";
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
END_VAR
VAR_TEMP
    Slot : Int;
    Stored : Int;
    Ok : Bool;
END_VAR
BEGIN
    #FRK_CfgSetWalk_PressDemoUnit := FALSE;
    IF #Phase = 1 THEN #ConfigStageStationCfg := #StationCfg; END_IF;
    IF "FRK_SetRuntime".Work[#RootIndex].Payload.Info.Kind = 1 THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 1);
        "FRK_SetRuntime".Work[#RootIndex].RejectScope := #Status.Name;
        "FRK_SetRuntime".Work[#RootIndex].RejectKey := "FRK_ConfigScratch".Entry.WriteKey;
        IF #Phase = 0 THEN
            IF #Access.CurrentLevel < MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead) THEN RETURN; END_IF;
            #Ok := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := "FRK_SetRuntime".Work[#RootIndex].Payload.Info.ModelCode);
            IF NOT #Ok OR "FRK_SetRuntime".Work[#RootIndex].Payload.Info.RecordCount >= 3 THEN RETURN; END_IF;
            #Slot := "FRK_SetRuntime".Work[#RootIndex].Payload.Info.RecordCount + 1;
            "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].Scope := #Status.Name;
            "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].WriteKey := "FRK_ConfigScratch".Entry.WriteKey;
            "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].Revision := "FRK_ConfigScratch".Entry.WriteRevision;
            "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].Kind := "FRK_ConfigScratch".Entry.ConfigKind;
            "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].ValueType := "FRK_ConfigScratch".Entry.ValueType;
            "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].ValueText := WSTRING_TO_STRING("FRK_ConfigScratch".Entry.ValueText);
            "FRK_SetRuntime".Work[#RootIndex].Payload.Info.RecordCount := #Slot;
        ELSIF #Phase = 2 THEN
            #Slot := "FRK_SetRecord"(RootIndex := #RootIndex, Scope := #Status.Name, WriteKey := "FRK_ConfigScratch".Entry.WriteKey);
            #Stored := "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := "FRK_SetRuntime".Work[#RootIndex].Payload.Info.ModelCode);
            IF "FRK_ConfigStore".Rows[#Stored].Record.ValueText <> "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].ValueText THEN
                "FRK_PersistDirty"(Slot := "FRK_PersistConfigSlot"(Scope := "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].Scope, ModelCode := "FRK_SetRuntime".Work[#RootIndex].Payload.Info.ModelCode, Kind := "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot].Kind));
            END_IF;
            "FRK_ConfigStore".Rows[#Stored].Record := "FRK_SetRuntime".Work[#RootIndex].Payload.Records[#Slot];
            "FRK_ConfigStore".Rows[#Stored].SchemaVersion := "FRK_ConfigScratch".Schema;
        ELSE
            #Slot := "FRK_SetCheck"(RootIndex := #RootIndex, Scope := #Status.Name, Access := #Access, Ready := #Ready, WriteAccess := #Phase <> 3);
            IF #Slot = 0 THEN RETURN; END_IF;
            IF #Phase = 1 THEN
    #ConfigStageStationCfg.RequireTwoHandStart := "FRK_ConfigScratch".Value.Flag;
            END_IF;
        END_IF;
    END_IF;
