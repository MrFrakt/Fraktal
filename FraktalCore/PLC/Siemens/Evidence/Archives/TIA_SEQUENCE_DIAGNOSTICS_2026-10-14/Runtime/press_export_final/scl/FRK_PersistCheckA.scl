FUNCTION "FRK_PersistCheckA" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      Done : Bool;
   END_VAR


BEGIN
	
	#Done := FALSE;
	#FRK_PersistCheckA := FALSE;
	CASE "FRK_PersistRuntime".Slot OF
	    1:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[1], Bytes := "FRK_PersistBuffers".D001A, Check := "FRK_PersistRuntime".CheckA);
	    2:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[2], Bytes := "FRK_PersistBuffers".D002A, Check := "FRK_PersistRuntime".CheckA);
	    3:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[3], Bytes := "FRK_PersistBuffers".D003A, Check := "FRK_PersistRuntime".CheckA);
	    4:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[4], Bytes := "FRK_PersistBuffers".D004A, Check := "FRK_PersistRuntime".CheckA);
	    5:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[5], Bytes := "FRK_PersistBuffers".D005A, Check := "FRK_PersistRuntime".CheckA);
	    6:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[6], Bytes := "FRK_PersistBuffers".D006A, Check := "FRK_PersistRuntime".CheckA);
	    7:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[7], Bytes := "FRK_PersistBuffers".D007A, Check := "FRK_PersistRuntime".CheckA);
	    ELSE
	        RETURN;
	END_CASE;
	#FRK_PersistCheckA := #Done;
	
END_FUNCTION

