FUNCTION "FRK_ViewManifest" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Scope : String;
      Count : Int;
      ReadLevel : DInt;
      Readable : Bool;
   END_VAR

   VAR_IN_OUT 
      Defs : Array[*] of "ST_SequenceStepDef";
      Cursor : "FRK_ConfigCursor";
      Page : "ST_ConfigPage";
   END_VAR

   VAR_TEMP 
      Index : Int;
      IndexText : String[8];
      Prefix : String[254];
      Item : String[254];
   END_VAR


BEGIN
	
	FOR #Index := 1 TO #Count DO
	    #IndexText := INT_TO_STRING(#Index);
	    IF #IndexText[1] = '+' THEN
	        #IndexText := DELETE(IN := #IndexText, L := 1, P := 1);
	    END_IF;
	    #Prefix := CONCAT(IN1 := 'SequenceSteps/SequenceSteps[', IN2 := #IndexText);
	    #Prefix := CONCAT(IN1 := #Prefix, IN2 := ']/');
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'StepNo');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := INT_TO_WSTRING(#Defs[#Index].StepNo),
	                       ValueType := 0,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'Branch');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := INT_TO_WSTRING(#Defs[#Index].Branch),
	                       ValueType := 0,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'TimeClass');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := DINT_TO_WSTRING(#Defs[#Index].TimeClass),
	                       ValueType := 0,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'ExpectedTime');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#Defs[#Index].ExpectedTime)),
	                       ValueType := 0,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'StepName');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := STRING_TO_WSTRING(#Defs[#Index].StepName),
	                       ValueType := 1,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'AwaitingLabel');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := STRING_TO_WSTRING(#Defs[#Index].AwaitingLabel),
	                       ValueType := 1,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'AwaitsPath');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := STRING_TO_WSTRING(#Defs[#Index].AwaitsPath),
	                       ValueType := 1,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	END_FOR;
	
END_FUNCTION

