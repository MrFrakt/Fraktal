FUNCTION "FRK_DiagName" : String
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Index : DInt;
   END_VAR


BEGIN
	
	#FRK_DiagName := '';
	CASE #Index OF
	    1:
	        #FRK_DiagName := 'PressDemo';
	    2:
	        #FRK_DiagName := 'PressDemo.PressRam';
	    3:
	        #FRK_DiagName := 'PressDemo.Door';
	    4:
	        #FRK_DiagName := 'PressDemo.PartSlide';
	    5:
	        #FRK_DiagName := 'PressDemo.TwoHand';
	    6:
	        #FRK_DiagName := 'PressDemo.PartPresentSensor';
	    7:
	        #FRK_DiagName := 'PressDemo.AirPressureMonitor';
	    ELSE
	        RETURN;
	END_CASE;
	
END_FUNCTION

