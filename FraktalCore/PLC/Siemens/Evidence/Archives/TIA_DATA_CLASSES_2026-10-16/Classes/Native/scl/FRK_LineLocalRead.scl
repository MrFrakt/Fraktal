FUNCTION "FRK_LineLocalRead" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      OwnerState : "FRK_LineState";
      Image : "ST_LineImage";
   END_VAR


BEGIN
	
	#FRK_LineLocalRead := #OwnerState.Status.Role = 1
	AND #OwnerState.Status.Revision <> 0
	AND #OwnerState.Image.Revision = #OwnerState.Status.Revision;
	IF #FRK_LineLocalRead THEN
	    #Image := #OwnerState.Image;
	END_IF;
	
END_FUNCTION

