TYPE "ST_HostEvent"
VERSION : 0.1
   STRUCT
      Sequence : UDInt;
      Kind : DInt;
      StationPath : WString[255];
      PartUid : String[64];
      Subject : String[80];
      Value : String[80];
      Stamp : LDT;
      TimeSynchronized : Bool;
      Verdict : DInt;
      ReasonCode : DInt;
   END_STRUCT;

END_TYPE

