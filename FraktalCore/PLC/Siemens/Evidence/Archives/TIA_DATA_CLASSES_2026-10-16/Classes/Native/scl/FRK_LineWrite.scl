FUNCTION "FRK_LineWrite" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Request : "ST_HmiRequest";
      Access : "FRK_Access";
      Ready : Bool;
   END_VAR

   VAR_IN_OUT 
      State : "FRK_LineState";
      Matched : Bool;
   END_VAR

   VAR_TEMP 
      FieldIndex : Int;
      Stage : "ST_LineProductionConfig";
   END_VAR


BEGIN
	
	#FRK_LineWrite := FALSE;
	FOR #FieldIndex := 1 TO 29 DO
	    "FRK_LineDef"(FieldIndex := #FieldIndex);
	    IF #Request.NameValue = "FRK_ConfigScratch".Entry.WriteKey THEN
	        #Matched := TRUE;
	        "FRK_ConfigScratch".CommittedScope := 'BenchLineOwner';
	        IF NOT "FRK_ConfigDataAllowed"(Access := #Access, ForWrite := TRUE, Scope := 'BenchLineOwner') THEN
	            "FRK_ConfigScratch".RejectDescription := WSTRING#'std.error.accessDenied';
	            "FRK_ConfigScratch".RejectReason := 2002;
	            RETURN;
	        END_IF;
	        IF "FRK_ConfigScratch".Entry.RequiresReady AND NOT #Ready THEN
	            "FRK_ConfigScratch".RejectDescription := WSTRING#'std.release.unitNotReady';
	            "FRK_ConfigScratch".RejectReason := 2002;
	            RETURN;
	        END_IF;
	        IF #State.Status.LineId <> 'PRESS-LINE-1' OR #State.Status.Owner <> 'BenchLineOwner'
	            OR #State.Status.Role <> 1 OR #Request.Kind <> 19
	            OR #Request.DurationMs <> 0
	            OR DINT_TO_UDINT(#Request.IntValue) <> "FRK_ConfigScratch".Entry.WriteRevision
	        THEN
	            RETURN;
	        END_IF;
	        IF NOT "FRK_ConfigValidate"(Text := #Request.TextValue) THEN
	            RETURN;
	        END_IF;
	        #Stage := #State.Values;
	        "FRK_LineAssign"(FieldIndex := #FieldIndex,
	                         Values := #Stage);
	        IF NOT "FRK_LineValid"(Values := #Stage) THEN
	            RETURN;
	        END_IF;
	        #State.Values := #Stage;
	        "FRK_LineCommit"(State := #State);
	        #FRK_LineWrite := TRUE;
	        RETURN;
	    END_IF;
	END_FOR;
	
END_FUNCTION

