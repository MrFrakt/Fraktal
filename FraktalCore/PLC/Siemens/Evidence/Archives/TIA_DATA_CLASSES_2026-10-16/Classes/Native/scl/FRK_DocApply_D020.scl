FUNCTION "FRK_DocApply_D020" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocApply_D020 := FALSE;
	#Position := 24;
	#NativeResult := Deserialize(SRC_ARRAY := "FRK_PersistBuffers".D020Data, DEST_VARIABLE => "FRK_PersistImages".D020, POS := #Position);
	IF #NativeResult <> 0 OR #Position <> 24 + UDINT_TO_DINT("FRK_PersistConsumers".Rows[20].Result.Length) THEN
	    RETURN;
	END_IF;
	IF "FRK_PersistImages".D020.SchemaVersion <> 1 OR "FRK_PersistImages".D020.Scope <> 'StationB' THEN
	    RETURN;
	END_IF;
	IF "FRK_PersistImages".D020.Image.Scope <> 'StationB' OR NOT "FRK_ClassValid"(Image := "FRK_PersistImages".D020.Image) THEN
	    RETURN;
	END_IF;
	"FRK_ClassPolicies".Rows[2] := "FRK_PersistImages".D020.Image;
	#FRK_DocApply_D020 := TRUE;
	
END_FUNCTION

