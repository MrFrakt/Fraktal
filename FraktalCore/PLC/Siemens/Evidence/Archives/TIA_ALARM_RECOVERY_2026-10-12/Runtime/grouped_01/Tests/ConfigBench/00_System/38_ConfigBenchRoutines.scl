        "GDB_UnitTest".ChildCommand := 2;
        "GDB_UnitTest".Verdict := 1;
        "GDB_UnitTest".Reason := 2003;
        "GDB_UnitTest".CarrierControl := 0;
        "FRK_UnitSetLocalCarrier"(Unit := "StationA".Unit, Index := 1);
    END_IF;
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.Finish := "GDB_UnitTest".FinishCycle;
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.Permit := "GDB_UnitTest".Permit;
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.ExitHold := "GDB_UnitTest".ExitHold;
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.BackgroundFault := "GDB_UnitTest".FaultRoot;
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.Verdict := "GDB_UnitTest".Verdict;
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.Diag.ReasonCode := "GDB_UnitTest".Reason;
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.Diag.Description := WSTRING#'test.start.permit';
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.Diag.SourcePath := WSTRING#'StationA.Cell.Clamp';
    IF "GDB_UnitTest".IssueChild THEN
        "StationA".Cell.Clamp.Command := "GDB_UnitTest".ChildCommand;
        "StationA".Cell.Clamp.Execute := TRUE;
        "GDB_UnitTest".IssueChild := FALSE;
    END_IF;
    CASE "GDB_UnitTest".CarrierControl OF
        1: "FRK_UnitSetLocalCarrier"(Unit := "StationA".Unit, Index := 1);
        2: "FRK_Carriers".Slots[1].Enabled := FALSE;
        3: "FRK_Carriers".Slots[1].Context.Uid := 'other';
        ELSE "GDB_UnitTest".CarrierControl := 0;
    END_CASE;
    "GDB_UnitTest".CarrierControl := 0;
    "GDB_FraktalHal".Data.StationA.Cell.Gate.Permit := "GDB_RoutingTest".PermitOne;
    IF "GDB_RoutingTest".PermitTwo THEN "GDB_FraktalHal".Data.StationA.Cell.Gate.Sample := 0; ELSE "GDB_FraktalHal".Data.StationA.Cell.Gate.Sample := 1; END_IF;
    "GDB_FraktalHal".Data.StationA.Cell.Gate.Diag.ReasonCode := 2002;
    "GDB_FraktalHal".Data.StationA.Cell.Gate.Diag.Description := WSTRING#'test.manual.first';
    "GDB_FraktalHal".Data.StationA.Cell.Gate.LaterDiag.ReasonCode := 2003;
    "GDB_FraktalHal".Data.StationA.Cell.Gate.LaterDiag.Description := WSTRING#'test.manual.second';
    "GDB_FraktalHal".Data.StationA.Satellite.Cell.Clamp.Permit := "GDB_RoutingTest".RootManualPermit;
    "GDB_FraktalHal".Data.StationA.Satellite.Cell.Clamp.Diag.SourcePath := WSTRING#'StationA.Satellite.Cell.Clamp';
    "GDB_FraktalHal".Data.StationA.Satellite.Cell.Clamp.Diag.Description := WSTRING#'test.nested.permit';
    "GDB_FraktalHal".Data.StationA.Satellite.Cell.Clamp.Diag.ReasonCode := 2002;
    "GDB_FraktalHal".Data.StationA.Satellite.Inner.Cell.Clamp.Permit := TRUE;
    "GDB_FraktalHal".Data.StationA.Satellite.Cell.Clamp.Finish := "GDB_RoutingTest".NestedFinish;
    "GDB_FraktalHal".Data.StationA.Satellite.Inner.Cell.Clamp.Finish := "GDB_RoutingTest".InnerFinish;
    IF "GDB_RoutingTest".NestedAccessLock THEN
        "StationA".Satellite.Access.Policy.Required[5] := 4;
    ELSE
        "StationA".Satellite.Access.Policy.Required[5] := 0;
    END_IF;
    IF "GDB_RoutingTest".LocalPulse THEN
        "GDB_RoutingTest".LocalRequest.Kind := "GDB_RoutingTest".LocalKind;
        "GDB_RoutingTest".LocalRequest.IntValue := "GDB_RoutingTest".LocalValue;
        "FRK_UnitOperation"(Core := "StationA".Satellite.Core, Unit := "StationA".Satellite.Unit, Status := "StationA".Satellite.Status, Policy := "StationA".Satellite.ModePolicy, Access := "StationA".Satellite.Access, Supported := "StationA".Satellite.SupportedModesPublished, Request := "GDB_RoutingTest".LocalRequest, Response := "FRK_UnitScratch".Response, Trusted := FALSE);
        "GDB_RoutingTest".LocalAccepted := "FRK_UnitScratch".Response.Accepted;
        "GDB_RoutingTest".LocalFirstKind := -1;
        IF "FRK_UnitScratch".Response.Report.Count > 0 THEN "GDB_RoutingTest".LocalFirstKind := "FRK_UnitScratch".Response.Report.Reasons[1].Kind; END_IF;
        "GDB_RoutingTest".LocalPulse := FALSE;
    END_IF;
    "StationA".Access.ProviderEnabled := NOT "GDB_AccessTest".ProviderOff;
    "StationB".Access.ProviderEnabled := NOT "GDB_AccessTest".ProviderOff;
    "StationA".AlarmLog.SinkEnabled := TRUE;
    "StationB".AlarmLog.SinkEnabled := TRUE;
    "GDB_FraktalHal".Data.StationA.Cell.Clamp.Sample := "GDB_StateAlarmTest".Position;
    IF "GDB_StateAlarmTest".ClearLog THEN
        "FRK_AlarmBegin"(AlarmLog := "StationA".AlarmLog, Startup := TRUE);
        "GDB_StateAlarmTest".SinkCome := 0;
        "GDB_StateAlarmTest".SinkClose := 0;
        "GDB_StateAlarmTest".ClearLog := FALSE;
    END_IF;
    IF "GDB_StateAlarmTest".RaisePulse THEN
        "GDB_StateAlarmTest".Slot := "FRK_AlarmRaise"(AlarmLog := "StationA".AlarmLog, Diag := "GDB_StateAlarmTest".Diag, ResetClass := "GDB_StateAlarmTest".ResetClass);
        "GDB_StateAlarmTest".RaisePulse := FALSE;
    END_IF;
    IF "GDB_StateAlarmTest".GonePulse THEN
        "GDB_StateAlarmTest".GoneAccepted := "FRK_AlarmGone"(AlarmLog := "StationA".AlarmLog, Slot := "GDB_StateAlarmTest".Slot);
        "GDB_StateAlarmTest".GonePulse := FALSE;
    END_IF;
    IF "GDB_StateAlarmTest".FillPulse THEN
        FOR #SlotIndex := 1 TO "GDB_StateAlarmTest".FillCount DO
            #Taken := "FRK_AlarmRaise"(AlarmLog := "StationA".AlarmLog, Diag := "GDB_StateAlarmTest".Diag, ResetClass := "GDB_StateAlarmTest".ResetClass);
            IF "GDB_StateAlarmTest".ResetClass = 0 THEN #Accepted := "FRK_AlarmGone"(AlarmLog := "StationA".AlarmLog, Slot := #Taken); END_IF;
        END_FOR;
        "GDB_StateAlarmTest".FillPulse := FALSE;
    END_IF;
    IF "GDB_StateAlarmTest".CauseLive THEN
        IF "GDB_StateAlarmTest".CauseSlot = 0 THEN
            "GDB_StateAlarmTest".CauseSlot := "FRK_AlarmRaise"(AlarmLog := "StationA".AlarmLog, Diag := "GDB_StateAlarmTest".Diag, ResetClass := 1);
        ELSIF "StationA".AlarmLog.Active["GDB_StateAlarmTest".CauseSlot].State = 0 THEN
            "GDB_StateAlarmTest".CauseSlot := "FRK_AlarmRaise"(AlarmLog := "StationA".AlarmLog, Diag := "GDB_StateAlarmTest".Diag, ResetClass := 1);
        END_IF;
    ELSIF "GDB_StateAlarmTest".CauseSlot > 0 THEN
        #Accepted := "FRK_AlarmGone"(AlarmLog := "StationA".AlarmLog, Slot := "GDB_StateAlarmTest".CauseSlot);
        "GDB_StateAlarmTest".CauseSlot := 0;
    END_IF;
    "FRK_StateSweep"(Flags := "GDB_StateAlarmTest".StandaloneFlags, Count := "GDB_StateAlarmTest".StandaloneCount, Touched := "GDB_StateAlarmTest".Touched, Startup := #Startup);
    IF "GDB_StateAlarmTest".PublishState THEN
        "GDB_StateAlarmTest".StandaloneReturn := "FRK_State"(Idx := "GDB_StateAlarmTest".StateIndex, Key := 'project.state.atHome', Ok := "GDB_StateAlarmTest".StateValue, Flags := "GDB_StateAlarmTest".StandaloneFlags, Count := "GDB_StateAlarmTest".StandaloneCount, Touched := "GDB_StateAlarmTest".Touched);
    END_IF;
    "FRK_ConfigRuntime".Unavailable := "GDB_ConfigTest".Unavailable;
    IF "GDB_ConfigTest".BlockRestore THEN "StationA".ConfigPersist.RestorePolicy := 1;
    ELSE "StationA".ConfigPersist.RestorePolicy := 0; END_IF;
    IF "GDB_ConfigTest".CorruptPulse THEN
        "GDB_ConfigTest".CorruptSlot := "FRK_ConfigFind"(Scope := "GDB_ConfigTest".CorruptScope, Key := "GDB_ConfigTest".CorruptKey, ModelCode := "GDB_ConfigTest".CorruptModel);
        IF "GDB_ConfigTest".CorruptSlot > 0 THEN
            "FRK_ConfigStore".Rows["GDB_ConfigTest".CorruptSlot].SchemaVersion := "GDB_ConfigTest".CorruptSchema;
            "FRK_ConfigStore".Rows["GDB_ConfigTest".CorruptSlot].Record.ValueText := "GDB_ConfigTest".CorruptText;
        END_IF;
        "GDB_ConfigTest".CorruptPulse := FALSE;
    END_IF;
END_FUNCTION

FUNCTION "F_ConfigBenchObserve" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Startup : Bool;
END_VAR
BEGIN
    "GDB_StateAlarmTest".NativeFaultSlot := "StationA".Cell.Gate.Core.FaultSlot;
    "GDB_RoutingTest".ManExecute := "StationA".Cell.Gate.Execute;
    "GDB_RoutingTest".ManStarts := "StationA".Cell.Gate.Device.StartCount;
    "GDB_UnitTest".Scans := "GDB_UnitTest".Scans + 1;
    "GDB_UnitTest".ChildExecute := "StationA".Cell.Clamp.Execute;
    "GDB_UnitTest".ChildState := "StationA".Cell.Clamp.Core.Exec;
    "GDB_UnitTest".CarrierWrites := "FRK_Carriers".Slots[1].Writes;
    "GDB_UnitTest".CarrierSerial := "FRK_Carriers".Slots[1].Serial;
    "GDB_UnitTest".WrittenUid := "FRK_Carriers".Slots[1].Written.Uid;
    "GDB_UnitTest".WrittenVerdict := "FRK_Carriers".Slots[1].Written.Result.Verdict;
    IF "StationA".AlarmLog.RingHead > 0 AND "StationA".AlarmLog.RingHead <= 64 THEN
        "GDB_UnitTest".LastEvent := "StationA".AlarmLog.Ring["StationA".AlarmLog.RingHead].ReasonCode;
    END_IF;
    "GDB_UnitTest".SecretCleared := "StationA".HmiRequest.Secret = '';
    "GDB_UnitTest".SnapshotSecretCleared := "StationA".Unit.Request.Secret = '';
    IF "StationA".Access.LoginBusy AND ("GDB_AccessTest".CancelOnLogin OR "GDB_AccessTest".SupersedeOnLogin) THEN
        "GDB_AccessTest".InterruptedBusy := TRUE;
        IF "GDB_AccessTest".CancelOnLogin THEN
            "GDB_AccessTest".InterruptRequest.Kind := 2;
            "FRK_UnitOperation"(Core := "StationA".Core, Unit := "StationA".Unit, Status := "StationA".Status, Policy := "StationA".ModePolicy, Access := "StationA".Access, Supported := "StationA".SupportedModesPublished, Request := "GDB_AccessTest".InterruptRequest, Response := "FRK_UnitScratch".Response, Trusted := FALSE);
        ELSE
            "GDB_AccessTest".SupersededSequence := "FRK_AccessNext"(Previous := "StationA".Access.LoginSequence);
            "FRK_AccessLogin"(Access := "StationA".Access, User := 'unknown', Secret := 'wrong', Sequence := "GDB_AccessTest".SupersededSequence);
        END_IF;
        "GDB_AccessTest".CancelOnLogin := FALSE;
        "GDB_AccessTest".SupersedeOnLogin := FALSE;
    END_IF;
    "F_ConfigSetBench"();
    "F_AccessPersistenceBench"(Startup := #Startup);
    "F_AlarmPersistenceBench"();
    "F_AlarmRecoveryBench"();
END_FUNCTION
