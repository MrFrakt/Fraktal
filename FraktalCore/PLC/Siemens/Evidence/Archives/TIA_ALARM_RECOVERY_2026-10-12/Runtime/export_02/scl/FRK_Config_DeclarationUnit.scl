FUNCTION "FRK_Config_DeclarationUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Access : "FRK_Access";
      RootIndex : Int;
      ModelIndex : UDInt;
   END_VAR

   VAR_IN_OUT 
      Core : "FRK_Core";
      Status : "ST_ModuleStatus";
      ParCfg : "ST_DeclarationParCfg";
      ModePolicy : Array[0..6] of "ST_ModePolicy";
      AvailableModelCount : Int;
      StationCfg : "ST_UnitProbeStationCfg";
      Cell : "FB_DeclarationCell";
      Satellite : "FB_SatelliteUnit";
      Cursor : "FRK_ConfigCursor";
      Page : "ST_ConfigPage";
   END_VAR

   VAR_TEMP 
      Ok : Bool;
   END_VAR


BEGIN
	
	IF #ModelIndex = 0 THEN
	    "FRK_ConfigUnit"(Scope := #Status.Name,
	                     Policy := #ModePolicy,
	                     ModelCount := #AvailableModelCount,
	                     ReadLevel := #Access.Policy.Required[0],
	                     Readable := #Access.CurrentLevel >= #Access.Policy.Required[0],
	                     Cursor := #Cursor,
	                     Page := #Page);
	END_IF;
	IF #ModelIndex = 0 THEN
	    "FRK_ConfigAppend"(Scope := #Status.Name,
	                       Item := 'AvailableModels/AvailableModels[1]/ModelCode',
	                       ValueText := WSTRING#'MODEL_A',
	                       ValueType := 1,
	                       ReadLevel := #Access.Policy.Required[0],
	                       Readable := #Access.CurrentLevel >= #Access.Policy.Required[0],
	                       Cursor := #Cursor,
	                       Page := #Page);
	    "FRK_ConfigAppend"(Scope := #Status.Name,
	                       Item := 'AvailableModels/AvailableModels[2]/ModelCode',
	                       ValueText := WSTRING#'MODEL_B',
	                       ValueType := 1,
	                       ReadLevel := #Access.Policy.Required[0],
	                       Readable := #Access.CurrentLevel >= #Access.Policy.Required[0],
	                       Cursor := #Cursor,
	                       Page := #Page);
	END_IF;
	IF (#ModelIndex = 0 OR #Core.ParentIndex = 0) THEN
	    "FRK_CfgDef_DeclarationUnit"(FieldIndex := 1);
	    "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
	    "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
	    "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
	    "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
	    "FRK_ConfigScratch".Entry.ModelScoped := #Core.ParentIndex = 0;
	    IF #ModelIndex <> 0 THEN
	        "FRK_ConfigScratch".Entry.RequiresReady := "FRK_ConfigScratch".Entry.RequiresReady AND "FRK_ConfigModelCode"(RootIndex := #RootIndex, ModelIndex := #ModelIndex) = "FRK_ConfigStore".ActiveModels[#RootIndex];
	        #Ok := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := "FRK_ConfigModelCode"(RootIndex := #RootIndex, ModelIndex := #ModelIndex));
	        IF NOT #Ok THEN
	            "FRK_ConfigScratch".Entry.Readable := FALSE;
	        END_IF;
	    ELSE
	        "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ParCfg.Timeout));
	    END_IF;
	    IF NOT "FRK_ConfigScratch".Entry.Readable THEN
	        "FRK_ConfigScratch".Entry.ValueText := WSTRING#'';
	    END_IF;
	    "FRK_ConfigAppendEntry"(Cursor := #Cursor,
	                            Page := #Page);
	END_IF;
	IF (#ModelIndex = 0 OR #Core.ParentIndex = 0) THEN
	    "FRK_CfgDef_DeclarationUnit"(FieldIndex := 2);
	    "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
	    "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
	    "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
	    "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
	    "FRK_ConfigScratch".Entry.ModelScoped := #Core.ParentIndex = 0;
	    IF #ModelIndex <> 0 THEN
	        "FRK_ConfigScratch".Entry.RequiresReady := "FRK_ConfigScratch".Entry.RequiresReady AND "FRK_ConfigModelCode"(RootIndex := #RootIndex, ModelIndex := #ModelIndex) = "FRK_ConfigStore".ActiveModels[#RootIndex];
	        #Ok := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := "FRK_ConfigModelCode"(RootIndex := #RootIndex, ModelIndex := #ModelIndex));
	        IF NOT #Ok THEN
	            "FRK_ConfigScratch".Entry.Readable := FALSE;
	        END_IF;
	    ELSE
	        "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(#ParCfg.Preset);
	    END_IF;
	    IF NOT "FRK_ConfigScratch".Entry.Readable THEN
	        "FRK_ConfigScratch".Entry.ValueText := WSTRING#'';
	    END_IF;
	    "FRK_ConfigAppendEntry"(Cursor := #Cursor,
	                            Page := #Page);
	END_IF;
	IF #ModelIndex = 0 THEN
	    "FRK_CfgDef_DeclarationUnit"(FieldIndex := 3);
	    "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
	    "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
	    "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
	    "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
	    "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
	    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING(#StationCfg.SiteLabel);
	    IF NOT "FRK_ConfigScratch".Entry.Readable THEN
	        "FRK_ConfigScratch".Entry.ValueText := WSTRING#'';
	    END_IF;
	    "FRK_ConfigAppendEntry"(Cursor := #Cursor,
	                            Page := #Page);
	END_IF;
	IF #ModelIndex = 0 THEN
	    "FRK_CfgDef_DeclarationUnit"(FieldIndex := 4);
	    "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
	    "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
	    "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
	    "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
	    "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
	    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING(#StationCfg.LongText);
	    IF NOT "FRK_ConfigScratch".Entry.Readable THEN
	        "FRK_ConfigScratch".Entry.ValueText := WSTRING#'';
	    END_IF;
	    "FRK_ConfigAppendEntry"(Cursor := #Cursor,
	                            Page := #Page);
	END_IF;
	IF #ModelIndex = 0 THEN
	    "FRK_CfgDef_DeclarationUnit"(FieldIndex := 5);
	    "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
	    "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
	    "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
	    "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
	    "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
	    IF #StationCfg.Enabled THEN
	        "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true';
	    ELSE
	        "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false';
	    END_IF;
	    IF NOT "FRK_ConfigScratch".Entry.Readable THEN
	        "FRK_ConfigScratch".Entry.ValueText := WSTRING#'';
	    END_IF;
	    "FRK_ConfigAppendEntry"(Cursor := #Cursor,
	                            Page := #Page);
	END_IF;
	IF #ModelIndex = 0 THEN
	    "FRK_Config_DeclarationCell"(Module := #Cell,
	                                 Access := #Access,
	                                 RootIndex := #RootIndex,
	                                 ModelIndex := #ModelIndex,
	                                 Cursor := #Cursor,
	                                 Page := #Page);
	END_IF;
	IF #ModelIndex = 0 THEN
	    "FRK_Config_SatelliteUnit"(Module := #Satellite,
	                               Access := #Access,
	                               RootIndex := #RootIndex,
	                               ModelIndex := #ModelIndex,
	                               Cursor := #Cursor,
	                               Page := #Page);
	END_IF;
	
END_FUNCTION

