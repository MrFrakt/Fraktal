FUNCTION "FRK_AlarmHistoryIndex" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// Reference-1500 LOCAL_RETAIN: closed history only, keyed by actual Unit scope.
// No active alarms, commands, sessions or monotonic clocks are restored.
   VAR_INPUT 
      Scope : String;
   END_VAR


BEGIN
	
	#FRK_AlarmHistoryIndex := 0;
	IF #Scope = 'StationA' THEN
	    #FRK_AlarmHistoryIndex := 1;
	    RETURN;
	END_IF;
	IF #Scope = 'StationA.Satellite' THEN
	    #FRK_AlarmHistoryIndex := 2;
	    RETURN;
	END_IF;
	IF #Scope = 'StationB' THEN
	    #FRK_AlarmHistoryIndex := 3;
	    RETURN;
	END_IF;
	
END_FUNCTION

