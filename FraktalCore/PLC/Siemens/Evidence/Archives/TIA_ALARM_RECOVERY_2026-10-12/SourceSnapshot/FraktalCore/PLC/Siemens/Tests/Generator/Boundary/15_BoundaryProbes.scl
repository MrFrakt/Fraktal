// TEST ONLY. Frame ABI/order probes, not the Core lifecycle implementation.
FUNCTION "FRK_ReleaseCommand" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Core : "FRK_Core";
    Execute : Bool;
END_VAR
BEGIN
    #Execute := FALSE;
    #Core.ReleasePending := TRUE;
END_FUNCTION

FUNCTION "FRK_ClockTick" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
    // Boundary fixture deliberately supplies no clock.
    RETURN;
END_FUNCTION

FUNCTION "FRK_RouteAbort" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Abort : Bool;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
END_VAR
BEGIN
    #Core.EvAbort := FALSE;
    #Core.EvAbortInError := FALSE;
END_FUNCTION

FUNCTION "FRK_Begin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Execute : Bool;
    Abort : Bool;
    Command : DInt;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    #Core.EvInit := NOT #Core.Initialized;
    #Core.Initialized := TRUE;
    #Core.Dispatch := FALSE;
    IF #Core.RegIndex < 1 OR #Core.RegIndex > 16 THEN
        RETURN;
    END_IF;
    "GDB_FrameProbe".Order := "GDB_FrameProbe".Order + 1;
    "GDB_FrameProbe".Rows[#Core.RegIndex].BeginCalls := "GDB_FrameProbe".Rows[#Core.RegIndex].BeginCalls + 1;
    IF "GDB_FrameProbe".Rows[#Core.RegIndex].BeginOrder = 0 THEN
        "GDB_FrameProbe".Rows[#Core.RegIndex].BeginOrder := "GDB_FrameProbe".Order;
    END_IF;
END_FUNCTION

FUNCTION "FRK_FrameProbeAssert" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Passed : Bool;
END_VAR
BEGIN
    "GDB_FrameProbe".Checks := "GDB_FrameProbe".Checks + 1;
    IF NOT #Passed THEN
        "GDB_FrameProbe".FailedChecks := "GDB_FrameProbe".FailedChecks + 1;
    END_IF;
END_FUNCTION

FUNCTION "FRK_End" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_OUTPUT
    Busy : Bool;
    Done : Bool;
    Error : Bool;
    Aborted : Bool;
    Held : Bool;
    ErrorID : DWord;
    Timing : "ST_ModuleTiming";
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
END_VAR
BEGIN
    #Busy := FALSE;
    #Done := FALSE;
    #Aborted := FALSE;
    #Held := FALSE;
    #ErrorID := DWORD#0;
    #Error := "FRK_Registry".Fault;
    #Timing := #Core.Timing;
    #Status.State := #Core.Exec;
    #Status.FaultActive := "FRK_Registry".Fault;
    #Core.EvInit := FALSE;
    #Core.ReleasePending := FALSE;
    IF #Core.RegIndex < 1 OR #Core.RegIndex > 16 THEN
        RETURN;
    END_IF;
    "GDB_FrameProbe".Rows[#Core.RegIndex].EndCalls := "GDB_FrameProbe".Rows[#Core.RegIndex].EndCalls + 1;
    "FRK_SyncRegistry"(Index := #Core.RegIndex, Status := #Status);
END_FUNCTION

FUNCTION "FRK_FrameProbeInit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Index : DInt;
END_VAR
BEGIN
    IF #Index < 1 OR #Index > 16 THEN
        RETURN;
    END_IF;
    "GDB_FrameProbe".Order := "GDB_FrameProbe".Order + 1;
    "GDB_FrameProbe".Rows[#Index].InitCalls := "GDB_FrameProbe".Rows[#Index].InitCalls + 1;
    "GDB_FrameProbe".Rows[#Index].InitOrder := "GDB_FrameProbe".Order;
END_FUNCTION

FUNCTION "FRK_FrameProbeCyclic" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Index : DInt;
END_VAR
BEGIN
    IF #Index < 1 OR #Index > 16 THEN
        RETURN;
    END_IF;
    "GDB_FrameProbe".Rows[#Index].CyclicCalls := "GDB_FrameProbe".Rows[#Index].CyclicCalls + 1;
END_FUNCTION
