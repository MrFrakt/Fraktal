FUNCTION "FRK_SeqViewBegin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Owner : DInt;
      Clear : Bool;
      ResetErrors : Bool;
   END_VAR

   VAR_IN_OUT 
      Enabled : Bool;
   END_VAR


BEGIN
	
	CASE #Owner OF
	    1:
	        "FRK_ViewBegin"(Clear := #Clear,
	                        ResetErrors := #ResetErrors,
	                        Defs := "FRK_Views".V001.Defs,
	                        Rows := "FRK_Views".V001.Rows,
	                        Cursors := "FRK_Views".V001.Cursors,
	                        Notes := "FRK_Views".V001.Notes,
	                        Count := "FRK_Views".V001.Count,
	                        NoteCount := "FRK_Views".V001.NoteCount,
	                        Current := "FRK_Views".V001.Current,
	                        Book := "FRK_Views".V001.Book,
	                        Touched := "FRK_Views".V001.Touched,
	                        Depths := "FRK_Views".V001.Depths,
	                        Visits := "FRK_Views".V001.Visits,
	                        Enabled := #Enabled);
	    5:
	        "FRK_ViewBegin"(Clear := #Clear,
	                        ResetErrors := #ResetErrors,
	                        Defs := "FRK_Views".V005.Defs,
	                        Rows := "FRK_Views".V005.Rows,
	                        Cursors := "FRK_Views".V005.Cursors,
	                        Notes := "FRK_Views".V005.Notes,
	                        Count := "FRK_Views".V005.Count,
	                        NoteCount := "FRK_Views".V005.NoteCount,
	                        Current := "FRK_Views".V005.Current,
	                        Book := "FRK_Views".V005.Book,
	                        Touched := "FRK_Views".V005.Touched,
	                        Depths := "FRK_Views".V005.Depths,
	                        Visits := "FRK_Views".V005.Visits,
	                        Enabled := #Enabled);
	    9:
	        "FRK_ViewBegin"(Clear := #Clear,
	                        ResetErrors := #ResetErrors,
	                        Defs := "FRK_Views".V009.Defs,
	                        Rows := "FRK_Views".V009.Rows,
	                        Cursors := "FRK_Views".V009.Cursors,
	                        Notes := "FRK_Views".V009.Notes,
	                        Count := "FRK_Views".V009.Count,
	                        NoteCount := "FRK_Views".V009.NoteCount,
	                        Current := "FRK_Views".V009.Current,
	                        Book := "FRK_Views".V009.Book,
	                        Touched := "FRK_Views".V009.Touched,
	                        Depths := "FRK_Views".V009.Depths,
	                        Visits := "FRK_Views".V009.Visits,
	                        Enabled := #Enabled);
	    13:
	        "FRK_ViewBegin"(Clear := #Clear,
	                        ResetErrors := #ResetErrors,
	                        Defs := "FRK_Views".V013.Defs,
	                        Rows := "FRK_Views".V013.Rows,
	                        Cursors := "FRK_Views".V013.Cursors,
	                        Notes := "FRK_Views".V013.Notes,
	                        Count := "FRK_Views".V013.Count,
	                        NoteCount := "FRK_Views".V013.NoteCount,
	                        Current := "FRK_Views".V013.Current,
	                        Book := "FRK_Views".V013.Book,
	                        Touched := "FRK_Views".V013.Touched,
	                        Depths := "FRK_Views".V013.Depths,
	                        Visits := "FRK_Views".V013.Visits,
	                        Enabled := #Enabled);
	    17:
	        "FRK_ViewBegin"(Clear := #Clear,
	                        ResetErrors := #ResetErrors,
	                        Defs := "FRK_Views".V017.Defs,
	                        Rows := "FRK_Views".V017.Rows,
	                        Cursors := "FRK_Views".V017.Cursors,
	                        Notes := "FRK_Views".V017.Notes,
	                        Count := "FRK_Views".V017.Count,
	                        NoteCount := "FRK_Views".V017.NoteCount,
	                        Current := "FRK_Views".V017.Current,
	                        Book := "FRK_Views".V017.Book,
	                        Touched := "FRK_Views".V017.Touched,
	                        Depths := "FRK_Views".V017.Depths,
	                        Visits := "FRK_Views".V017.Visits,
	                        Enabled := #Enabled);
	    21:
	        "FRK_ViewBegin"(Clear := #Clear,
	                        ResetErrors := #ResetErrors,
	                        Defs := "FRK_Views".V021.Defs,
	                        Rows := "FRK_Views".V021.Rows,
	                        Cursors := "FRK_Views".V021.Cursors,
	                        Notes := "FRK_Views".V021.Notes,
	                        Count := "FRK_Views".V021.Count,
	                        NoteCount := "FRK_Views".V021.NoteCount,
	                        Current := "FRK_Views".V021.Current,
	                        Book := "FRK_Views".V021.Book,
	                        Touched := "FRK_Views".V021.Touched,
	                        Depths := "FRK_Views".V021.Depths,
	                        Visits := "FRK_Views".V021.Visits,
	                        Enabled := #Enabled);
	    ELSE
	        RETURN;
	END_CASE;
	
END_FUNCTION

