<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_LineRecord" Id="{68945882-8ae4-41ee-bece-0948c3c9cb4a}">
    <Declaration><![CDATA[// Core §3.8e - one line value as it travels from owner to mirror: the same
// (WriteKey, Revision, value text) a WRITE_CONFIG carries, so a mirror applies it
// through the ordinary typed handler and a revision mismatch refuses it.
TYPE ST_LineRecord :
STRUCT
    WriteKey  : STRING(160);
    Revision  : UDINT;
    ValueText : STRING(80);
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>