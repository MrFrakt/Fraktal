FUNCTION "FRK_AlarmRecoveryScope" : String
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Slot : Int;
   END_VAR


BEGIN
	
	CASE #Slot OF
	    1:
	        #FRK_AlarmRecoveryScope := 'PressDemo';
	    ELSE
	        #FRK_AlarmRecoveryScope := '';
	END_CASE;
	
END_FUNCTION

