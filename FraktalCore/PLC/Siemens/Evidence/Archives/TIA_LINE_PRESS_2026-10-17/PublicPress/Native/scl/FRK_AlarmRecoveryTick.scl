FUNCTION "FRK_AlarmRecoveryTick" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      AlarmLog : "FRK_AlarmLog";
   END_VAR

   VAR_TEMP 
      Slot : Int;
      Index : Int;
      Span : UDInt;
      Saved : UDInt;
      SavedCrc : DWord;
      Work : DWord;
   END_VAR


BEGIN
	
	#Slot := #AlarmLog.RecoverySlot;
	IF #Slot < 1 OR #Slot > 1 THEN
	    RETURN;
	END_IF;
	FOR #Index := 1 TO 16 DO
	    IF #AlarmLog.Active[#Index].State = 1 AND #AlarmLog.Active[#Index].ResetClass = 1 THEN
	        #Span := "FRK_AlarmRecoveryElapsed"(AlarmLog := #AlarmLog, EventSlot := #Index);
	        "FRK_AlarmRecoveryCheckpointRead"(Slot := #Slot,
	                                          EventSlot := #Index,
	                                          Elapsed => #Saved,
	                                          Checksum => #SavedCrc);
	        IF #Saved <> #Span THEN
	            #Work := "FRK_AlarmRecoveryTimeCrc"(Slot := #Slot, EventSlot := #Index, Value := #Span, EventCrc := "FRK_AlarmRecovery".Rows[#Slot].EventCrc[#Index]);
	            IF "FRK_AlarmRecovery".Rows[#Slot].TimeBank[#Index] THEN
	                "FRK_AlarmRecovery".Rows[#Slot].Elapsed[#Index] := #Span;
	                "FRK_AlarmRecovery".Rows[#Slot].TimeCrc[#Index] := #Work;
	            ELSE
	                "FRK_AlarmRecovery".Rows[#Slot].ElapsedAlt[#Index] := #Span;
	                "FRK_AlarmRecovery".Rows[#Slot].TimeCrcAlt[#Index] := #Work;
	            END_IF;
	            "FRK_AlarmRecovery".Rows[#Slot].TimeBank[#Index] := NOT "FRK_AlarmRecovery".Rows[#Slot].TimeBank[#Index];
	        END_IF;
	    END_IF;
	END_FOR;
	
END_FUNCTION

