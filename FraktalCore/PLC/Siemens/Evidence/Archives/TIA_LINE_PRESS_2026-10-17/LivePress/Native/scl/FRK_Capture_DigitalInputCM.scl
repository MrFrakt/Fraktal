FUNCTION "FRK_Capture_DigitalInputCM" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Module : "FB_DigitalInputCM";
      AlarmLog : "FRK_AlarmLog";
   END_VAR


BEGIN
	
	"FRK_AlarmCapture"(AlarmLog := #AlarmLog,
	                   Core := #Module.Core,
	                   Status := #Module.Status);
	
END_FUNCTION

