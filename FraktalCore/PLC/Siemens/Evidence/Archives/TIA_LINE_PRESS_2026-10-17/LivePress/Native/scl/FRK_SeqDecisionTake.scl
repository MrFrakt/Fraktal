FUNCTION "FRK_SeqDecisionTake" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
      AlarmLog : "FRK_AlarmLog";
   END_VAR


BEGIN
	
	// A decision is consumed once by its step, independently of pacing. Keep
	// the answer until the mandatory step record or lifecycle re-arms it.
	IF NOT #Seq.Running OR #Seq.Error THEN
	    #FRK_SeqDecisionTake := 0;
	    RETURN;
	END_IF;
	IF #Seq.DecisionAnswer = 0 THEN
	    #Seq.DecisionAnswer := "FRK_DecisionTake"(Owner := #Seq.OwnerIndex, AlarmLog := #AlarmLog);
	END_IF;
	#FRK_SeqDecisionTake := #Seq.DecisionAnswer;
	
END_FUNCTION

