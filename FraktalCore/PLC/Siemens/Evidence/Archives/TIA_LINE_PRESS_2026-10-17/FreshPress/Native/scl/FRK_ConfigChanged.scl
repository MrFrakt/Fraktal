FUNCTION "FRK_ConfigChanged" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Scope : String;
      ModelCode : String;
      Kind : DInt;
   END_VAR

   VAR_TEMP 
      Slot : Int;
   END_VAR


BEGIN
	
	#Slot := "FRK_PersistConfigSlot"(Scope := #Scope, ModelCode := #ModelCode, Kind := #Kind);
	IF #Slot > 0 THEN
	    "FRK_PersistDirty"(Slot := #Slot);
	END_IF;
	
END_FUNCTION

