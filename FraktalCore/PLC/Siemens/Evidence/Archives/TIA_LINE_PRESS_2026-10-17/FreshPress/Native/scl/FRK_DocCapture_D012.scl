FUNCTION "FRK_DocCapture_D012" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D012 := FALSE;
	"FRK_PersistImages".D012.SchemaVersion := 1;
	"FRK_PersistImages".D012.Scope := 'PressDemo';
	IF "FRK_ModelRuntime".Rows[1].State = 1 THEN
	    #Ok := "FRK_ModelCapture"(RootIndex := 1,
	                              Catalog := "FRK_ModelRuntime".Rows[1].Stage,
	                              Image := "FRK_PersistImages".D012.Image);
	ELSE
	    #Ok := "FRK_ModelCapture"(RootIndex := 1,
	                              Catalog := "FRK_ModelStore".Rows[1],
	                              Image := "FRK_PersistImages".D012.Image);
	END_IF;
	IF NOT #Ok THEN
	    RETURN;
	END_IF;
	FOR #Index := 0 TO 2895 DO
	    "FRK_PersistBuffers".D012Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D012, DEST_ARRAY => "FRK_PersistBuffers".D012Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 2896 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D012 := TRUE;
	
END_FUNCTION

