  <DUT Name="E_HostEventKind" Id="{c276beac-cb84-429d-bc63-7778cc0327ea}">
    <Declaration><![CDATA[// Core §11.6.1 — fixed, append-only L3/MES event vocabulary.
{attribute 'qualified_only'}
TYPE E_HostEventKind :
(
    NONE := 0,
    PART_RECEIVED := 1,
    PROCESSING_STARTED := 2,
    PROCESSED := 3,
    PROCESSING_ABORTED := 4,
    CHANGEOVER_STARTED := 5,
    CHANGEOVER_DONE := 6,
    TOOL_CHANGED := 7,
    MATERIAL_CHANGED := 8,
    MODE_CHANGED := 9,
    NOK := 10
) DINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
