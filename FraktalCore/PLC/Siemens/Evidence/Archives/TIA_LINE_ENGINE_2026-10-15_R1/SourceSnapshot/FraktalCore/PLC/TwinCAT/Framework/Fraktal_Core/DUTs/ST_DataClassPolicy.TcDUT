<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_DataClassPolicy" Id="{fa54f136-f748-4de7-bab8-23b2f87e980a}">
    <Declaration><![CDATA[// Core §3.8d - one project-declared data class: the ACCESS axis of
// editable data, orthogonal to its ConfigKind. The levels are policy (§7.7(b)):
// declared as defaults, persisted, and editable through ACCESS_POLICY.
TYPE ST_DataClassPolicy :
STRUCT
    ClassId    : STRING(40);    // stable identity a value is registered into
    LabelKey   : STRING(160);   // localization key for the class's name
    ReadLevel  : E_AccessLevel; // to see the class's values
    WriteLevel : E_AccessLevel; // to change them
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>