            "FRK_ConfigScratch".Entry.ConfigKind := 2;
            "FRK_ConfigScratch".Entry.ValueType := 0;
            "FRK_ConfigScratch".Entry.Writable := TRUE;
            "FRK_ConfigScratch".Entry.RequiresReady := FALSE;
            "FRK_ConfigScratch".Entry.HasMinimum := FALSE;
            "FRK_ConfigScratch".Entry.HasMaximum := FALSE;
            "FRK_ConfigScratch".Entry.Minimum := -32768.0;
            "FRK_ConfigScratch".Entry.Maximum := 32767.0;
            "FRK_ConfigScratch".Entry.LabelKey := 'test.config.preset';
            "FRK_ConfigScratch".Storage := 2;
            "FRK_ConfigScratch".Schema := 1;
            "FRK_ConfigScratch".Minimum := -32768.0;
            "FRK_ConfigScratch".Maximum := 32767.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 1;
            "FRK_ConfigScratch".MinWrite := 2;
            "FRK_ConfigScratch".EnumCount := 0;
        7:
            "FRK_ConfigScratch".Entry.WriteKey := 'line.offset.1';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.EnumDomain := WSTRING#'';
            "FRK_ConfigScratch".Entry.Item := WSTRING#'Line/Offsets[1]';
            "FRK_ConfigScratch".Entry.ConfigKind := 2;
            "FRK_ConfigScratch".Entry.ValueType := 0;
            "FRK_ConfigScratch".Entry.Writable := TRUE;
            "FRK_ConfigScratch".Entry.RequiresReady := FALSE;
            "FRK_ConfigScratch".Entry.HasMinimum := FALSE;
            "FRK_ConfigScratch".Entry.HasMaximum := FALSE;
            "FRK_ConfigScratch".Entry.Minimum := -32768.0;
            "FRK_ConfigScratch".Entry.Maximum := 32767.0;
            "FRK_ConfigScratch".Entry.LabelKey := 'test.config.preset';
            "FRK_ConfigScratch".Storage := 2;
            "FRK_ConfigScratch".Schema := 1;
            "FRK_ConfigScratch".Minimum := -32768.0;
            "FRK_ConfigScratch".Maximum := 32767.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 1;
            "FRK_ConfigScratch".MinWrite := 2;
            "FRK_ConfigScratch".EnumCount := 0;
        8:
            "FRK_ConfigScratch".Entry.WriteKey := 'line.small';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.EnumDomain := WSTRING#'';
            "FRK_ConfigScratch".Entry.Item := WSTRING#'Line/Small';
            "FRK_ConfigScratch".Entry.ConfigKind := 2;
            "FRK_ConfigScratch".Entry.ValueType := 0;
