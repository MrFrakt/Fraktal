FUNCTION "FRK_LineDef" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    FieldIndex : Int;
END_VAR
BEGIN
    "FRK_ConfigScratch".Entry := "FRK_ConfigScratch".Blank;
    "FRK_ConfigScratch".EnumCount := 0;
    CASE #FieldIndex OF
        1:
            "FRK_ConfigScratch".Entry.WriteKey := 'line.taktMs';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.EnumDomain := WSTRING#'';
            "FRK_ConfigScratch".Entry.Item := WSTRING#'Line/TaktMs';
            "FRK_ConfigScratch".Entry.ConfigKind := 2;
            "FRK_ConfigScratch".Entry.ValueType := 0;
            "FRK_ConfigScratch".Entry.Writable := TRUE;
            "FRK_ConfigScratch".Entry.RequiresReady := TRUE;
            "FRK_ConfigScratch".Entry.HasMinimum := TRUE;
            "FRK_ConfigScratch".Entry.HasMaximum := TRUE;
            "FRK_ConfigScratch".Entry.Minimum := 1.0;
            "FRK_ConfigScratch".Entry.Maximum := 100000.0;
            "FRK_ConfigScratch".Entry.LabelKey := 'test.config.preset';
            "FRK_ConfigScratch".Storage := 4;
            "FRK_ConfigScratch".Schema := 1;
            "FRK_ConfigScratch".Minimum := 1.0;
            "FRK_ConfigScratch".Maximum := 100000.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 1;
            "FRK_ConfigScratch".MinWrite := 2;
            "FRK_ConfigScratch".EnumCount := 0;
        2:
            "FRK_ConfigScratch".Entry.WriteKey := 'line.gain';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.EnumDomain := WSTRING#'';
            "FRK_ConfigScratch".Entry.Item := WSTRING#'Line/Gain';
            "FRK_ConfigScratch".Entry.ConfigKind := 2;
            "FRK_ConfigScratch".Entry.ValueType := 0;
            "FRK_ConfigScratch".Entry.Writable := TRUE;
            "FRK_ConfigScratch".Entry.RequiresReady := FALSE;
            "FRK_ConfigScratch".Entry.HasMinimum := TRUE;
            "FRK_ConfigScratch".Entry.HasMaximum := TRUE;
            "FRK_ConfigScratch".Entry.Minimum := -100.0;
            "FRK_ConfigScratch".Entry.Maximum := 100.0;
            "FRK_ConfigScratch".Entry.LabelKey := 'test.config.preset';
            "FRK_ConfigScratch".Storage := 6;
            "FRK_ConfigScratch".Schema := 1;
            "FRK_ConfigScratch".Minimum := -100.0;
            "FRK_ConfigScratch".Maximum := 100.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 1;
            "FRK_ConfigScratch".MinWrite := 2;
