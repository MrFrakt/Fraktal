            "FRK_ConfigScratch".Maximum := 6.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 1;
            "FRK_ConfigScratch".MinWrite := 2;
            "FRK_ConfigScratch".EnumCount := 7;
            "FRK_ConfigScratch".EnumValues[1] := 0;
            "FRK_ConfigScratch".EnumValues[2] := 1;
            "FRK_ConfigScratch".EnumValues[3] := 2;
            "FRK_ConfigScratch".EnumValues[4] := 3;
            "FRK_ConfigScratch".EnumValues[5] := 4;
            "FRK_ConfigScratch".EnumValues[6] := 5;
            "FRK_ConfigScratch".EnumValues[7] := 6;
        4:
            "FRK_ConfigScratch".Entry.WriteKey := 'line.enabled';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.EnumDomain := WSTRING#'';
            "FRK_ConfigScratch".Entry.Item := WSTRING#'Line/Enabled';
            "FRK_ConfigScratch".Entry.ConfigKind := 2;
            "FRK_ConfigScratch".Entry.ValueType := 2;
            "FRK_ConfigScratch".Entry.Writable := TRUE;
            "FRK_ConfigScratch".Entry.RequiresReady := FALSE;
            "FRK_ConfigScratch".Entry.HasMinimum := FALSE;
            "FRK_ConfigScratch".Entry.HasMaximum := FALSE;
            "FRK_ConfigScratch".Entry.Minimum := 0.0;
            "FRK_ConfigScratch".Entry.Maximum := 1.0;
            "FRK_ConfigScratch".Entry.LabelKey := 'test.config.preset';
            "FRK_ConfigScratch".Storage := 1;
            "FRK_ConfigScratch".Schema := 1;
            "FRK_ConfigScratch".Minimum := 0.0;
            "FRK_ConfigScratch".Maximum := 1.0;
            "FRK_ConfigScratch".MaxLength := 0;
            "FRK_ConfigScratch".MinRead := 1;
            "FRK_ConfigScratch".MinWrite := 2;
            "FRK_ConfigScratch".EnumCount := 0;
        5:
            "FRK_ConfigScratch".Entry.WriteKey := 'line.hostName';
            "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
            "FRK_ConfigScratch".Entry.EnumDomain := WSTRING#'';
