FUNCTION "F_LineAssert" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Condition : Bool;
      Code : DInt;
   END_VAR

   VAR_IN_OUT 
      Checks : UDInt;
      Failures : UDInt;
      FirstFailure : DInt;
   END_VAR


BEGIN
	
	#Checks := #Checks + 1;
	IF NOT #Condition THEN
	    #Failures := #Failures + 1;
	    IF #FirstFailure = 0 THEN
	        #FirstFailure := #Code;
	    END_IF;
	END_IF;
	
END_FUNCTION

