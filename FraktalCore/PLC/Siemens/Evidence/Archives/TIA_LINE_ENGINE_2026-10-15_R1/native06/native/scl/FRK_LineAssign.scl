FUNCTION "FRK_LineAssign" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      FieldIndex : Int;
   END_VAR

   VAR_IN_OUT 
      Values : "ST_LineProbeConfig";
   END_VAR


BEGIN
	
	CASE #FieldIndex OF
	    1:
	        #Values.TaktMs := LINT_TO_UDINT("FRK_ConfigScratch".Value.Number);
	    2:
	        #Values.Gain := "FRK_ConfigScratch".Value.Decimal;
	    3:
	        #Values.Grade := LINT_TO_DINT("FRK_ConfigScratch".Value.Number);
	    4:
	        #Values.Enabled := "FRK_ConfigScratch".Value.Flag;
	    5:
	        #Values.HostName := "FRK_ConfigScratch".Value.Text;
	    6:
	        #Values.Offsets[0] := LINT_TO_INT("FRK_ConfigScratch".Value.Number);
	    7:
	        #Values.Offsets[1] := LINT_TO_INT("FRK_ConfigScratch".Value.Number);
	    8:
	        #Values.Small := LINT_TO_USINT("FRK_ConfigScratch".Value.Number);
	    ELSE
	        RETURN;
	END_CASE;
	
END_FUNCTION

