	        "FRK_ConfigScratch".MinRead := 0;
	        "FRK_ConfigScratch".MinWrite := 1;
	        "FRK_ConfigScratch".EnumCount := 0;
	    3:
	        "FRK_ConfigScratch".Entry.WriteKey := 'siteLabel';
	        "FRK_ConfigScratch".Entry.WriteRevision := UDINT#1;
	        "FRK_ConfigScratch".Entry.EnumDomain := WSTRING#'';
	        "FRK_ConfigScratch".Entry.Item := WSTRING#'StationCfg/SiteLabel';
	        "FRK_ConfigScratch".Entry.ConfigKind := 1;
	        "FRK_ConfigScratch".Entry.ValueType := 1;
	        "FRK_ConfigScratch".Entry.Writable := TRUE;
	        "FRK_ConfigScratch".Entry.RequiresReady := FALSE;
	        "FRK_ConfigScratch".Entry.HasMinimum := FALSE;
	        "FRK_ConfigScratch".Entry.HasMaximum := FALSE;
	        "FRK_ConfigScratch".Entry.Minimum := 0.0;
	        "FRK_ConfigScratch".Entry.Maximum := 1.0;
	        "FRK_ConfigScratch".Entry.LabelKey := 'test.config.siteLabel';
