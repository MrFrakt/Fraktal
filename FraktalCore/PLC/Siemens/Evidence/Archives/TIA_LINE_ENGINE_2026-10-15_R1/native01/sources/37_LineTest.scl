FUNCTION "F_LineAssert" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Condition : Bool;
    Code : DInt;
END_VAR
VAR_IN_OUT
    Checks : UDInt;
    Failures : UDInt;
    FirstFailure : DInt;
END_VAR
BEGIN
    #Checks := #Checks + 1;
    IF NOT #Condition THEN
        #Failures := #Failures + 1;
        IF #FirstFailure = 0 THEN #FirstFailure := #Code; END_IF;
    END_IF;
END_FUNCTION

FUNCTION_BLOCK "FB_LineTest"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_OUTPUT
    Done {ExternalWritable := 'False'} : Bool;
    Checks {ExternalWritable := 'False'} : UDInt;
    Failures {ExternalWritable := 'False'} : UDInt;
    FirstFailure {ExternalWritable := 'False'} : DInt;
END_VAR
VAR
    Ran {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
    OwnerState {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_LineState";
    MirrorState {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_LineState";
    Incoming {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_LineImage";
    Request {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_HmiRequest";
    Access {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_Access";
    Cursor {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "FRK_ConfigCursor";
    Page {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : "ST_ConfigPage";
    SavedBytes {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0..20000] of Byte;
    CheckCount {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : UDInt;
    FailureCount {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : UDInt;
    FailedCode {ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : DInt;
END_VAR
VAR_TEMP
    NowMs : UDInt;
    PreviousRevision : UDInt;
    Synchronized : Bool;
    Matched : Bool;
    Ok : Bool;
    Position : DInt;
    SavedLength : DInt;
    NativeResult : Int;
END_VAR
BEGIN
    IF NOT #Ran THEN
        #NowMs := 0;
        #Synchronized := FALSE;
    "FRK_LineBoot"(OwnerRole := TRUE, NowMs := 0, State := #OwnerState);
    "FRK_LineBoot"(OwnerRole := FALSE, NowMs := 0, State := #MirrorState);
    #Access.CurrentLevel := 2;
    #Request.Kind := 19;
    #Request.IntValue := 1;
    "F_LineAssert"(Condition := #OwnerState.Status.Revision = 1 AND #OwnerState.Image.Count = 8 AND #OwnerState.Image.Revision = 1, Code := 1, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "F_LineAssert"(Condition := #OwnerState.Values.TaktMs = 1000 AND #OwnerState.Values.Gain = 1.25 AND #OwnerState.Values.Small = 7, Code := 2, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.NameValue := 'line.taktMs';
    #Request.TextValue := WSTRING#'2500';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := #Ok AND #Matched AND #OwnerState.Values.TaktMs = 2500 AND #OwnerState.Status.Revision = 2, Code := 3, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.NameValue := 'line.gain';
    #Request.TextValue := WSTRING#'2.5';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := FALSE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := #Ok AND #OwnerState.Values.Gain = 2.5 AND #OwnerState.Status.Revision = 3, Code := 4, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #PreviousRevision := #OwnerState.Status.Revision;
    #Request.NameValue := 'line.taktMs';
    #Request.TextValue := WSTRING#'3000';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := FALSE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND #OwnerState.Status.Revision = #PreviousRevision, Code := 5, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.NameValue := 'line.taktMs';
    #Request.TextValue := WSTRING#'0';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND #OwnerState.Status.Revision = #PreviousRevision, Code := 6, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.NameValue := 'line.small';
    #Request.TextValue := WSTRING#'256';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND #OwnerState.Status.Revision = #PreviousRevision, Code := 7, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.NameValue := 'line.grade';
    #Request.TextValue := WSTRING#'99';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND #OwnerState.Status.Revision = #PreviousRevision, Code := 8, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.NameValue := 'line.gain';
    #Request.TextValue := WSTRING#'garbage';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND #OwnerState.Status.Revision = #PreviousRevision, Code := 9, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.NameValue := 'line.hostName';
    #Request.TextValue := WSTRING#'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND #OwnerState.Status.Revision = #PreviousRevision, Code := 10, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Access.CurrentLevel := 1;
    #Request.NameValue := 'line.taktMs';
    #Request.TextValue := WSTRING#'3000';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND #OwnerState.Status.Revision = #PreviousRevision, Code := 11, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Access.CurrentLevel := 2;
    #Request.IntValue := 2;
    #Request.NameValue := 'line.taktMs';
    #Request.TextValue := WSTRING#'3000';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok, Code := 12, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.IntValue := 1;
    #Request.DurationMs := 1;
    #Request.NameValue := 'line.taktMs';
    #Request.TextValue := WSTRING#'3000';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok, Code := 13, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Request.DurationMs := 0;
    #Request.NameValue := 'line.missing';
    #Request.TextValue := WSTRING#'3000';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND NOT #Matched, Code := 14, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #NowMs := 100;
    #Ok := "FRK_LineLocalRead"(OwnerState := #OwnerState, Image := #Incoming);
    "F_LineAssert"(Condition := #Ok AND #Incoming.Revision = 3, Code := 15, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := #Ok AND #MirrorState.Status.Revision = 3 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5, Code := 16, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "F_LineAssert"(Condition := #MirrorState.Status.Owner = 'BenchLineOwner' AND NOT #MirrorState.Status.TimeSynchronized AND NOT #MirrorState.Status.Stale, Code := 17, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #PreviousRevision := #MirrorState.Status.Revision;
    #Matched := FALSE;
    #Request.NameValue := 'line.taktMs';
    #Request.TextValue := WSTRING#'999';
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #MirrorState, Matched := #Matched);
    "F_LineAssert"(Condition := NOT #Ok AND #Matched AND #MirrorState.Values.TaktMs = 2500, Code := 18, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.LineId := 'wrong';
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 1 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 19, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Owner := 'wrong';
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 20, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Count := 7;
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 21, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Count := 33;
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 22, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Revision := 0;
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 23, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Revision := 2;
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 24, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Records[8].WriteKey := 'unknown';
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 25, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Records[8].WriteKey := #Incoming.Records[1].WriteKey;
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 26, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Records[8].Revision := 2;
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 27, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Records[8].ValueText := '256';
    #Incoming.Revision := 4;
    #Incoming.Records[1].ValueText := '3000';
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 28, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Records[3].ValueText := '99';
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 29, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Incoming.Records[1].ValueText := '3000';
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #Ok AND #MirrorState.Status.SourceError = 2 AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Values.Gain = 2.5 AND #MirrorState.Status.Revision = #PreviousRevision, Code := 30, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #NowMs := 599;
    "FRK_LineTick"(NowMs := #NowMs, SourceError := 17, State := #MirrorState);
    "F_LineAssert"(Condition := NOT #MirrorState.Status.Stale AND #MirrorState.Status.SourceError = 17, Code := 31, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #NowMs := 600;
    "FRK_LineTick"(NowMs := #NowMs, SourceError := 17, State := #MirrorState);
    "F_LineAssert"(Condition := #MirrorState.Status.Stale AND #MirrorState.Values.TaktMs = 2500, Code := 32, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Incoming := #OwnerState.Image;
    #Synchronized := TRUE;
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := #Ok AND NOT #MirrorState.Status.Stale AND #MirrorState.Status.SourceError = 0 AND #MirrorState.Status.TimeSynchronized, Code := 33, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Position := 0;
    #NativeResult := Serialize(SRC_VARIABLE := #MirrorState.Image, DEST_ARRAY => #SavedBytes, POS := #Position);
    #SavedLength := #Position;
    "F_LineAssert"(Condition := #NativeResult = 0 AND #SavedLength > 0, Code := 34, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "FRK_LineBoot"(OwnerRole := FALSE, NowMs := 700, State := #MirrorState);
    #Position := 0;
    #NativeResult := Deserialize(SRC_ARRAY := #SavedBytes, DEST_VARIABLE => #Incoming, POS := #Position);
    "F_LineAssert"(Condition := #NativeResult = 0 AND #Position = #SavedLength AND #MirrorState.Values.TaktMs = 1000, Code := 35, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := TRUE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := #Ok AND #MirrorState.Values.TaktMs = 2500 AND #MirrorState.Status.Revision = 3 AND NOT #MirrorState.HaveSuccess, Code := 36, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "F_LineAssert"(Condition := NOT #MirrorState.Status.TimeSynchronized AND #MirrorState.Status.LastUpdate = LDT#1970-01-01-00:00:00, Code := 37, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "FRK_LineTick"(NowMs := 1200, SourceError := 17, State := #MirrorState);
    "F_LineAssert"(Condition := #MirrorState.Status.Stale AND #MirrorState.Values.Gain = 2.5, Code := 38, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "FRK_LineBoot"(OwnerRole := FALSE, NowMs := 0, State := #MirrorState);
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := #Ok AND #MirrorState.Values.TaktMs = 2500, Code := 39, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #OwnerState.Status.Revision := UDINT#4294967295;
    #Request.NameValue := 'line.taktMs';
    #Request.TextValue := WSTRING#'2600';
    #Matched := FALSE;
    #Ok := "FRK_LineWrite"(Request := #Request, Access := #Access, Ready := TRUE, State := #OwnerState, Matched := #Matched);
    "F_LineAssert"(Condition := #Ok AND #OwnerState.Status.Revision = 1, Code := 40, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #MirrorState.Status.Revision := UDINT#4294967295;
    #Incoming := #OwnerState.Image;
    #Ok := "FRK_LineApply"(Image := #Incoming, Restore := FALSE, NowMs := #NowMs, Stamp := LDT#2026-10-15-12:00:00, TimeSynchronized := #Synchronized, State := #MirrorState);
    "F_LineAssert"(Condition := #Ok AND #MirrorState.Status.Revision = 1 AND #MirrorState.Values.TaktMs = 2600, Code := 41, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "FRK_ConfigBegin"(Cursor := #Cursor, Page := #Page, PageIndex := 0, Revision := 1);
    "FRK_LineManifest"(Scope := 'StationB', Access := #Access, State := #MirrorState, Cursor := #Cursor, Page := #Page);
    "FRK_ConfigFinish"(Cursor := #Cursor, Page := #Page);
    "F_LineAssert"(Condition := #Page.EntryCount = 8 AND #Page.Entries[1].Scope = WSTRING#'StationB' AND #Page.Entries[1].Item = WSTRING#'Line/TaktMs', Code := 42, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "F_LineAssert"(Condition := NOT #Page.Entries[1].Writable AND #Page.Entries[1].Readable AND #Page.Entries[1].ConfigKind = 2, Code := 43, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    #Access.CurrentLevel := 0;
    "FRK_ConfigBegin"(Cursor := #Cursor, Page := #Page, PageIndex := 0, Revision := 1);
    "FRK_LineManifest"(Scope := 'StationA', Access := #Access, State := #OwnerState, Cursor := #Cursor, Page := #Page);
    "FRK_ConfigFinish"(Cursor := #Cursor, Page := #Page);
    "F_LineAssert"(Condition := NOT #Page.Entries[1].Readable AND #Page.Entries[1].ValueText = WSTRING#'' AND #Page.Entries[1].Writable, Code := 44, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
    "FRK_LineBoot"(OwnerRole := FALSE, NowMs := UDINT#4294967200, State := #MirrorState);
    "FRK_LineTick"(NowMs := 404, SourceError := 0, State := #MirrorState);
    "F_LineAssert"(Condition := #MirrorState.Status.Stale, Code := 45, Checks := #CheckCount, Failures := #FailureCount, FirstFailure := #FailedCode);
        #Ran := TRUE;
    END_IF;
    #Done := #Ran;
    #Checks := #CheckCount;
    #Failures := #FailureCount;
    #FirstFailure := #FailedCode;
END_FUNCTION_BLOCK
