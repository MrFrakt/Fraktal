FUNCTION "FRK_DocCapture_D018" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D018 := FALSE;
	"FRK_PersistImages".D018.SchemaVersion := 1;
	"FRK_PersistImages".D018.Scope := 'BenchLineOwner';
	IF NOT "FRK_Line".Data.Applied OR "FRK_Line".Data.Image.Revision <> "FRK_Line".Data.Status.Revision THEN
	    RETURN;
	END_IF;
	"FRK_PersistImages".D018.Image := "FRK_Line".Data.Image;
	FOR #Index := 0 TO 8755 DO
	    "FRK_PersistBuffers".D018Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D018, DEST_ARRAY => "FRK_PersistBuffers".D018Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 8756 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D018 := TRUE;
	
END_FUNCTION

