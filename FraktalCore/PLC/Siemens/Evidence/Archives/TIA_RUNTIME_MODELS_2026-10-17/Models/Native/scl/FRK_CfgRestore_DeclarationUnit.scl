	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
	    "FRK_CfgDef_DeclarationUnit"(FieldIndex := 5);
	    "FRK_ConfigScratch".Entry.ValueText := "FRK_ConfigDecimalText"(Number := #ConfigDefaultStationCfg.Ratio);
	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
	    "FRK_CfgDef_DeclarationUnit"(FieldIndex := 6);
	    "FRK_ConfigScratch".Entry.ValueText := "FRK_ConfigDecimalText"(Number := REAL_TO_LREAL(#ConfigDefaultStationCfg.Gain));
	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
