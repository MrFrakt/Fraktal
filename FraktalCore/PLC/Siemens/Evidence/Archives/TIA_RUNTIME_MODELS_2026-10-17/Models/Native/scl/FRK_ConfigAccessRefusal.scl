FUNCTION "FRK_ConfigAccessRefusal" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Unit : "FRK_Unit";
      Access : "FRK_Access";
   END_VAR

   VAR_IN_OUT 
      Response : "ST_HmiResponse";
      Persist : "ST_ConfigPersistStatus";
      AlarmLog : "FRK_AlarmLog";
   END_VAR

   VAR_TEMP 
      Text : WString[255];
   END_VAR


BEGIN
	
	IF NOT #Unit.RequestPending OR #Response.Accepted OR NOT "FRK_ConfigScratch".AccessRejected THEN
	    RETURN;
	END_IF;
	#Response.Diagnostic := WSTRING#'std.error.accessDenied';
	#Response.Report.Count := 0;
	#Response.Report.Released := TRUE;
	"FRK_ReleaseReason"(Report := #Response.Report,
	                    Description := #Response.Diagnostic,
	                    Reason := 2002,
	                    Path := STRING_TO_WSTRING("FRK_ConfigScratch".RejectedScope),
	                    Kind := 1);
	#Persist.LastRejectScope := "FRK_ConfigScratch".RejectedScope;
	#Persist.LastRejectKey := "FRK_ConfigScratch".RejectedKey;
	#Text := CONCAT(IN1 := WSTRING#'std.audit.dataAccessDenied field=', IN2 := STRING_TO_WSTRING("FRK_ConfigScratch".RejectedKey));
	#Text := CONCAT(IN1 := #Text, IN2 := WSTRING#' required=');
	#Text := CONCAT(IN1 := #Text, IN2 := DINT_TO_WSTRING("FRK_ConfigScratch".RequiredLevel));
	"FRK_AccessAudit"(AlarmLog := #AlarmLog,
	                  What := #Text,
	                  Who := #Access.CurrentUser,
	                  SourcePath := STRING_TO_WSTRING("FRK_ConfigScratch".RejectedScope));
	
END_FUNCTION

