FUNCTION "FRK_DiagSlot" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// One private sample per deployed module consumed by a selected sequence Unit.
// Typed owning frames derive these from the authoritative module contract.
   VAR_INPUT 
      Index : DInt;
   END_VAR


BEGIN
	
	#FRK_DiagSlot := 0;
	CASE #Index OF
	    1:
	        #FRK_DiagSlot := 1;
	    2:
	        #FRK_DiagSlot := 2;
	    3:
	        #FRK_DiagSlot := 3;
	    4:
	        #FRK_DiagSlot := 4;
	    5:
	        #FRK_DiagSlot := 5;
	    6:
	        #FRK_DiagSlot := 6;
	    7:
	        #FRK_DiagSlot := 7;
	    8:
	        #FRK_DiagSlot := 8;
	    9:
	        #FRK_DiagSlot := 9;
	    10:
	        #FRK_DiagSlot := 10;
	    11:
	        #FRK_DiagSlot := 11;
	    12:
	        #FRK_DiagSlot := 12;
	    13:
	        #FRK_DiagSlot := 13;
	    14:
	        #FRK_DiagSlot := 14;
	    15:
	        #FRK_DiagSlot := 15;
	    16:
	        #FRK_DiagSlot := 16;
	    17:
	        #FRK_DiagSlot := 17;
	    18:
	        #FRK_DiagSlot := 18;
	    19:
	        #FRK_DiagSlot := 19;
	    20:
	        #FRK_DiagSlot := 20;
	    21:
	        #FRK_DiagSlot := 21;
	    22:
	        #FRK_DiagSlot := 22;
	    23:
	        #FRK_DiagSlot := 23;
	    24:
	        #FRK_DiagSlot := 24;
	    ELSE
	        RETURN;
	END_CASE;
	
END_FUNCTION

