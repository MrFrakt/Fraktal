FUNCTION "FRK_HostSlot" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// Core 11.6 fixed vocabulary and shape; stores exist only for deployed Units.
   VAR_INPUT 
      Scope : String;
   END_VAR


BEGIN
	
	#FRK_HostSlot := 0;
	IF #Scope = 'StationA' THEN
	    #FRK_HostSlot := 1;
	    RETURN;
	END_IF;
	IF #Scope = 'StationA.Satellite' THEN
	    #FRK_HostSlot := 2;
	    RETURN;
	END_IF;
	IF #Scope = 'StationA.Satellite.Inner' THEN
	    #FRK_HostSlot := 3;
	    RETURN;
	END_IF;
	IF #Scope = 'StationB' THEN
	    #FRK_HostSlot := 4;
	    RETURN;
	END_IF;
	IF #Scope = 'StationB.Satellite' THEN
	    #FRK_HostSlot := 5;
	    RETURN;
	END_IF;
	IF #Scope = 'StationB.Satellite.Inner' THEN
	    #FRK_HostSlot := 6;
	    RETURN;
	END_IF;
	
END_FUNCTION

