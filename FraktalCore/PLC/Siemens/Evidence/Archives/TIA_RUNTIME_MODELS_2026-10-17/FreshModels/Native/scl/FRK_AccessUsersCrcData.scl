FUNCTION "FRK_AccessUsersCrcData" : DWord
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// Reference-1500 LOCAL_RETAIN adapter. No sessions or plaintext credentials.
// CRC-32 arithmetic comes from Core F_Crc32; encoding is binding-local, versioned.
   VAR_INPUT 
      Count : DInt;
      SchemaVersion : UInt;
      Generation : UDInt;
   END_VAR

   VAR_IN_OUT 
      Rows : Array[1..16] of "ST_UserRecord";
   END_VAR

   VAR_TEMP 
      Work : DWord;
      Slot : Int;
      Index : Int;
      Size : Int;
   END_VAR


BEGIN
	
	#Work := "FRK_CrcNumber"(Previous := DWORD#16#FFFFFFFF, Value := UINT_TO_UDINT(#SchemaVersion));
	#Work := "FRK_CrcNumber"(Previous := #Work, Value := #Generation);
	#Work := "FRK_CrcNumber"(Previous := #Work, Value := DINT_TO_UDINT(#Count));
	// Unused rows are included: an altered dormant credential is not ignored.
	FOR #Slot := 1 TO 16 DO
	    #Size := LEN(#Rows[#Slot].User);
	    #Work := "FRK_CrcNumber"(Previous := #Work, Value := INT_TO_UDINT(#Size));
	    FOR #Index := 1 TO #Size DO
	        #Work := "FRK_CrcByte"(Previous := #Work, Value := CHAR_TO_BYTE(#Rows[#Slot].User[#Index]));
	    END_FOR;
	    #Work := "FRK_CrcNumber"(Previous := #Work, Value := DINT_TO_UDINT(#Rows[#Slot].Level));
	    FOR #Index := 0 TO 15 DO
	        #Work := "FRK_CrcByte"(Previous := #Work, Value := #Rows[#Slot].Salt[#Index]);
	    END_FOR;
	    FOR #Index := 0 TO 31 DO
	        #Work := "FRK_CrcByte"(Previous := #Work, Value := #Rows[#Slot].PinHash[#Index]);
	    END_FOR;
	END_FOR;
	#FRK_AccessUsersCrcData := NOT #Work;
	
END_FUNCTION

