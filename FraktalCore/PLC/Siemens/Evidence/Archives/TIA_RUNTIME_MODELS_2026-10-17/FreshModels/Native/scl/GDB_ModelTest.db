      Poisoned { ExternalWritable := 'False'} : Bool;
      Damaged { ExternalWritable := 'False'} : Bool;
      Done { ExternalWritable := 'False'} : Bool;
      Checks { ExternalWritable := 'False'} : Int;
      Failures { ExternalWritable := 'False'} : Int;
      FirstFailure { ExternalWritable := 'False'} : Int;
      PendingSeen { ExternalWritable := 'False'} : Bool;
      PrematurePublication { ExternalWritable := 'False'} : Bool;
      StagedPreset { ExternalWritable := 'False'} : DInt;
      ModelDocument { ExternalWritable := 'False'} : Int;
