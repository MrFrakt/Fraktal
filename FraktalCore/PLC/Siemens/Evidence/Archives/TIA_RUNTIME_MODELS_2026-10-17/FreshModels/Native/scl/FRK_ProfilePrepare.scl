FUNCTION "FRK_ProfilePrepare" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// Core 8.11.4: bounded main-line timing, fed from existing step records.
   VAR_INPUT 
      Run : Bool;
      Withdraw : Bool;
   END_VAR

   VAR_IN_OUT 
      Book : "FRK_ProfileBook";
   END_VAR


BEGIN
	
	#Book.Collecting := #Run AND NOT #Withdraw;
	IF NOT #Book.Collecting THEN
	    #Book.Running := FALSE;
	    #Book.HasOpen := FALSE;
	    #Book.CompletedVisit := 0;
	    #Book.NSteps := 0;
	    #Book.CompleteRequested := FALSE;
	END_IF;
	
END_FUNCTION

