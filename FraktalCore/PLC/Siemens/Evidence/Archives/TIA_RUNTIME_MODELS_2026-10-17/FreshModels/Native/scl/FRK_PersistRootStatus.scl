	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[11].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[11].PendingSince < #Persist.PendingSince) THEN
	            #Persist.PendingSince := "FRK_PersistConsumers".Rows[11].PendingSince;
	        END_IF;
	    END_IF;
	END_IF;
	IF #RootIndex = 2 THEN
	    #Persist.Failed := #Persist.Failed OR "FRK_PersistConsumers".Rows[12].Failed;
	    IF "FRK_PersistConsumers".Rows[12].Dirty OR "FRK_PersistConsumers".Rows[12].Ticket <> 0 THEN
	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[12].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[12].PendingSince < #Persist.PendingSince) THEN
	            #Persist.PendingSince := "FRK_PersistConsumers".Rows[12].PendingSince;
	        END_IF;
	    END_IF;
	END_IF;
	IF #RootIndex = 2 THEN
	    #Persist.Failed := #Persist.Failed OR "FRK_PersistConsumers".Rows[13].Failed;
	    IF "FRK_PersistConsumers".Rows[13].Dirty OR "FRK_PersistConsumers".Rows[13].Ticket <> 0 THEN
	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[13].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[13].PendingSince < #Persist.PendingSince) THEN
	            #Persist.PendingSince := "FRK_PersistConsumers".Rows[13].PendingSince;
	        END_IF;
	    END_IF;
	END_IF;
	IF #RootIndex = 2 THEN
	    #Persist.Failed := #Persist.Failed OR "FRK_PersistConsumers".Rows[14].Failed;
	    IF "FRK_PersistConsumers".Rows[14].Dirty OR "FRK_PersistConsumers".Rows[14].Ticket <> 0 THEN
	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[14].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[14].PendingSince < #Persist.PendingSince) THEN
	            #Persist.PendingSince := "FRK_PersistConsumers".Rows[14].PendingSince;
	        END_IF;
	    END_IF;
	END_IF;
	IF #RootIndex = 2 THEN
	    #Persist.Failed := #Persist.Failed OR "FRK_PersistConsumers".Rows[15].Failed;
	    IF "FRK_PersistConsumers".Rows[15].Dirty OR "FRK_PersistConsumers".Rows[15].Ticket <> 0 THEN
	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[15].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[15].PendingSince < #Persist.PendingSince) THEN
	            #Persist.PendingSince := "FRK_PersistConsumers".Rows[15].PendingSince;
	        END_IF;
	    END_IF;
	END_IF;
	IF #RootIndex = 2 THEN
	    #Persist.Failed := #Persist.Failed OR "FRK_PersistConsumers".Rows[16].Failed;
	    IF "FRK_PersistConsumers".Rows[16].Dirty OR "FRK_PersistConsumers".Rows[16].Ticket <> 0 THEN
	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[16].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[16].PendingSince < #Persist.PendingSince) THEN
	            #Persist.PendingSince := "FRK_PersistConsumers".Rows[16].PendingSince;
	        END_IF;
