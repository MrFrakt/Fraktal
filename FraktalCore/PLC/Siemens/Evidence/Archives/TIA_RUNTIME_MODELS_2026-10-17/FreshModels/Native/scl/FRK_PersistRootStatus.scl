	IF #RootIndex = 1 OR #RootIndex = 2 THEN
	    #Persist.Failed := #Persist.Failed OR "FRK_PersistConsumers".Rows[18].Failed;
	    IF "FRK_PersistConsumers".Rows[18].Dirty OR "FRK_PersistConsumers".Rows[18].Ticket <> 0 THEN
	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[18].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[18].PendingSince < #Persist.PendingSince) THEN
	            #Persist.PendingSince := "FRK_PersistConsumers".Rows[18].PendingSince;
	        END_IF;
	    END_IF;
	END_IF;
	IF (#RootIndex = 1 OR #RootIndex = 2) AND "FRK_PersistConsumers".Rows[18].Rejected AND NOT "FRK_PersistConsumers".Rows[18].Acknowledged THEN
	    #Persist.RestoreLost := TRUE;
	    #Persist.RestoreAcknowledged := FALSE;
	    #Persist.LostPath := 'BenchLineOwner';
	END_IF;
	IF #RootIndex = 1 THEN
	    #Persist.Failed := #Persist.Failed OR "FRK_PersistConsumers".Rows[19].Failed;
	    IF "FRK_PersistConsumers".Rows[19].Dirty OR "FRK_PersistConsumers".Rows[19].Ticket <> 0 THEN
	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[19].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[19].PendingSince < #Persist.PendingSince) THEN
	            #Persist.PendingSince := "FRK_PersistConsumers".Rows[19].PendingSince;
	        END_IF;
	    END_IF;
	END_IF;
	IF #RootIndex = 2 THEN
	    #Persist.Failed := #Persist.Failed OR "FRK_PersistConsumers".Rows[20].Failed;
	    IF "FRK_PersistConsumers".Rows[20].Dirty OR "FRK_PersistConsumers".Rows[20].Ticket <> 0 THEN
	        #Persist.Pending := TRUE;
	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[20].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[20].PendingSince < #Persist.PendingSince) THEN
