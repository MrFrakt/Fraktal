	        IF #Persist.PendingSince = LDT#1970-01-01-00:00:00 OR ("FRK_PersistConsumers".Rows[21].PendingSince <> LDT#1970-01-01-00:00:00 AND "FRK_PersistConsumers".Rows[21].PendingSince < #Persist.PendingSince) THEN
