FUNCTION "FRK_LineSetWalk" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      RootIndex : Int;
      Scope : String;
      Phase : Int;
      Access : "FRK_Access";
      Ready : Bool;
   END_VAR

