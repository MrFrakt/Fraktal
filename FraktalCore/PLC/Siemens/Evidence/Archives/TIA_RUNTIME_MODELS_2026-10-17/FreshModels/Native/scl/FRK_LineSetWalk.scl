BEGIN
	
	#FRK_LineSetWalk := FALSE;
	"FRK_SetRuntime".Work[#RootIndex].RejectScope := 'BenchLineOwner';
	IF NOT "FRK_LineScope"(Scope := #Scope) OR NOT "FRK_Line".Data.Applied
	    OR "FRK_Line".Data.Status.Role <> 1 THEN
	    RETURN;
	END_IF;
	IF #Phase = 2 THEN
	    "FRK_Line".Data.Values := "FRK_LineSetStage".Values;
