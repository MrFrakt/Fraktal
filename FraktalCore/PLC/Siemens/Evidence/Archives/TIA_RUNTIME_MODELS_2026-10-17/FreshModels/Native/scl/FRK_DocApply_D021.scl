FUNCTION "FRK_DocApply_D021" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocApply_D021 := FALSE;
	#Position := 24;
	#NativeResult := Deserialize(SRC_ARRAY := "FRK_PersistBuffers".D021Data, DEST_VARIABLE => "FRK_PersistImages".D021, POS := #Position);
	IF #NativeResult <> 0 OR #Position <> 24 + UDINT_TO_DINT("FRK_PersistConsumers".Rows[21].Result.Length) THEN
	    RETURN;
	END_IF;
	IF "FRK_PersistImages".D021.SchemaVersion <> 1 OR "FRK_PersistImages".D021.Scope <> 'StationA' THEN
	    RETURN;
	END_IF;
	IF NOT "FRK_ModelApply"(RootIndex := 1,
	                            Image := "FRK_PersistImages".D021.Image) THEN
	    RETURN;
	END_IF;
	#FRK_DocApply_D021 := TRUE;
	
END_FUNCTION

