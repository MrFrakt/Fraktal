FUNCTION "FRK_DocCapture_D014" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D014 := FALSE;
	"FRK_PersistImages".D014.SchemaVersion := 1;
	"FRK_PersistImages".D014.Scope := 'StationB';
	"FRK_PersistImages".D014.Ordinal := 2;
	"FRK_PersistImages".D014.Payload := "FRK_SetStore".Sets[2, 2];
	FOR #Index := 0 TO 11209 DO
	    "FRK_PersistBuffers".D014Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D014, DEST_ARRAY => "FRK_PersistBuffers".D014Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 11210 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D014 := TRUE;
	
END_FUNCTION

