FUNCTION "FRK_AlarmShelve" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Slot : Int;
      DurationMs : UDInt;
   END_VAR

   VAR_IN_OUT 
      AlarmLog : "FRK_AlarmLog";
   END_VAR

   VAR_TEMP 
      Duration : UDInt;
      Stamp : LDT;
   END_VAR


BEGIN
	
	#FRK_AlarmShelve := FALSE;
	IF #Slot < 1 OR #Slot > 16 OR #DurationMs = 0 THEN
	    RETURN;
	END_IF;
	IF #AlarmLog.Active[#Slot].State = 0 OR #AlarmLog.Active[#Slot].Category = 1
	    OR NOT "FRK_ReasonShelvable"(Reason := #AlarmLog.Active[#Slot].ReasonCode) THEN
	    RETURN;
	END_IF;
	#Duration := #DurationMs;
	IF #Duration > UDINT#28800000 THEN
	    #Duration := UDINT#28800000;
	END_IF;
	#AlarmLog.ShelfSince[#Slot] := "FRK_Clock".NowMs;
	#AlarmLog.ShelfDuration[#Slot] := #Duration;
	#AlarmLog.Active[#Slot].Shelved := TRUE;
	#Stamp := "FRK_Now"() + LT#1ms * UDINT_TO_LINT(#Duration);
	#AlarmLog.Active[#Slot].ShelvedUntil := LDT_TO_DT(#Stamp);
	#AlarmLog.Active[#Slot].ShelfTimeSynchronized := FALSE;
	"FRK_AlarmMessage"(AlarmLog := #AlarmLog,
	                   Reason := 0,
	                   Description := WSTRING#'std.audit.alarmShelved',
	                   SourcePath := #AlarmLog.Active[#Slot].SourcePath);
	#FRK_AlarmShelve := TRUE;
	
END_FUNCTION

