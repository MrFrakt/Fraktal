FUNCTION "FRK_Now" : LDT
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      Stamp {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      ResultCode : Int;
   END_VAR


BEGIN
	
	#ResultCode := RD_SYS_T(OUT => #Stamp);
	IF #ResultCode = 0 THEN
	    #FRK_Now := DTL_TO_LDT(#Stamp);
	ELSE
	    #FRK_Now := LDT#1970-01-01-00:00:00.000000000;
	END_IF;
	
END_FUNCTION

