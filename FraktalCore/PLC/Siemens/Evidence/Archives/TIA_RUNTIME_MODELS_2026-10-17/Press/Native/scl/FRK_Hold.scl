FUNCTION "FRK_Hold" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      ReasonCode : DInt;
      Description : WString;
   END_VAR

   VAR_IN_OUT 
      Core : "FRK_Core";
      Status : "ST_ModuleStatus";
   END_VAR


BEGIN
	
	IF #Core.Exec <> 1 THEN
	    RETURN;
	END_IF;
	IF NOT #Core.Held OR #Core.HoldReason <> #ReasonCode THEN
	    "FRK_Diagnostic"(Status := #Status,
	                     ReasonCode := #ReasonCode,
	                     Description := #Description,
	                     Severity := 0);
	END_IF;
	#Core.HoldReq := TRUE;
	#Core.HoldReason := #ReasonCode;
	#Core.DiagTouched := TRUE;
	
END_FUNCTION

