FUNCTION "FRK_EngineeringManifest" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Scope : String;
      Access : "FRK_Access";
   END_VAR

   VAR_IN_OUT 
      Cursor : "FRK_ConfigCursor";
      Page : "ST_ConfigPage";
   END_VAR


BEGIN
	
	"FRK_ConfigAppend"(Scope := #Scope,
	                   Item := 'Engineering/Count',
	                   ValueText := WSTRING#'1',
	                   ValueType := 1,
	                   ReadLevel := #Access.Policy.Required[0],
	                   Readable := #Access.CurrentLevel >= #Access.Policy.Required[0],
	                   Cursor := #Cursor,
	                   Page := #Page);
	"FRK_ConfigAppend"(Scope := #Scope,
	                   Item := 'Engineering/Gates/1/Name',
	                   ValueText := WSTRING#'USE_SIMULATION',
	                   ValueType := 1,
	                   ReadLevel := #Access.Policy.Required[0],
	                   Readable := #Access.CurrentLevel >= #Access.Policy.Required[0],
	                   Cursor := #Cursor,
	                   Page := #Page);
	"FRK_ConfigAppend"(Scope := #Scope,
	                   Item := 'Engineering/Gates/1/DescriptionKey',
	                   ValueText := WSTRING#'std.engineering.simulation',
	                   ValueType := 1,
	                   ReadLevel := #Access.Policy.Required[0],
	                   Readable := #Access.CurrentLevel >= #Access.Policy.Required[0],
	                   Cursor := #Cursor,
	                   Page := #Page);
	
END_FUNCTION

