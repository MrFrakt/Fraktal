FUNCTION "FRK_PersistTick" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_TEMP
    Pick : Int;
    Index : Int;
    Slot : Int;
    Operation : Int;
    Done : Bool;
    Check : "FRK_PersistCheck";
END_VAR
BEGIN
    IF "FRK_PersistRuntime".LastScan = "FRK_PersistRuntime".Scan THEN RETURN; END_IF;
    "FRK_PersistRuntime".LastScan := "FRK_PersistRuntime".Scan;
    IF "FRK_PersistRuntime".Active = 0 THEN
        #Pick := 0;
        FOR #Index := 1 TO 4 DO
            IF "FRK_PersistRuntime".Queue[#Index].State = 1 THEN
                IF #Pick = 0 THEN #Pick := #Index; ELSIF "FRK_PersistRuntime".Queue[#Index].Ticket < "FRK_PersistRuntime".Queue[#Pick].Ticket THEN #Pick := #Index; END_IF;
            END_IF;
        END_FOR;
        IF #Pick = 0 THEN RETURN; END_IF;
        "FRK_PersistRuntime".Active := #Pick;
        "FRK_PersistRuntime".Slot := "FRK_PersistRuntime".Queue[#Pick].Slot;
        "FRK_PersistRuntime".Queue[#Pick].State := 2;
        "FRK_PersistRuntime".Result := "FRK_PersistRuntime".EmptyResult;
        "FRK_PersistRuntime".Stage := 1; "FRK_PersistRuntime".NativeReq := TRUE;
        "FRK_PersistRuntime".CheckA.Cursor := -1; "FRK_PersistRuntime".CheckB.Cursor := -1;
    END_IF;
    IF "FRK_PersistRuntime".Unavailable THEN
        "FRK_PersistRuntime".Result.ErrorId := UDINT#32963;
        "FRK_PersistFinish"(); RETURN;
    END_IF;
    CASE "FRK_PersistRuntime".Stage OF
        1, 2, 8, 9:
            #Operation := "FRK_PersistRuntime".Stage;
