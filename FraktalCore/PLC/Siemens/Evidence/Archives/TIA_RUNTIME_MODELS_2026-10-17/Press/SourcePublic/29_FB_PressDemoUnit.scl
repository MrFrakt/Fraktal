FUNCTION "FRK_CfgOperation_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
    ParCfg : "ST_PressDemoParCfg";
    ModePolicy : Array[0..6] of "ST_ModePolicy";
    Access : "FRK_Access";
    Unit : "FRK_Unit";
    HmiResponse : "ST_HmiResponse";
    AlarmLog : "FRK_AlarmLog";
    ConfigPersist : "ST_ConfigPersistStatus";
    ConfigCursor : "FRK_ConfigCursor";
    ConfigRev : UDInt;
    Model : "ST_ModelId";
    AvailableModelCount : Int;
    ConfigStaged : Bool;
    ModelCapacity : Int;
    SequenceStepDef : Array[1..23] of "ST_SequenceStepDef";
    SequenceStepCount : Int;
    SupportedModesPublished : Array[0..6] of Bool;
    StationCfg : "ST_PressDemoStationCfg";
    ConfigStageParCfg : "ST_PressDemoParCfg";
    ConfigDefaultParCfg : "ST_PressDemoParCfg";
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
    TwoHand : "FB_TwoHandStartCM";
    PartPresentSensor : "FB_DigitalInputCM";
    AirPressureMonitor : "FB_AirPressureMonitorCM";
END_VAR
VAR_TEMP
    RootIndex : Int;
    Request : "ST_HmiRequest";
    Ready : Bool;
    Matched : Bool;
    Ok : Bool;
    Desired : String[64];
    Scope : String[80];
    Key : String[160];
END_VAR
BEGIN
    #RootIndex := "FRK_ConfigRoot"(RegIndex := #Core.RegIndex);
    IF #Core.ParentIndex <> 0 OR #RootIndex = 0 THEN RETURN; END_IF;
    #Model.ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex];
    IF NOT #Unit.RequestPending THEN RETURN; END_IF;
    #Request := #Unit.Request;
    #Ready := #Core.Exec = 0 AND NOT #Unit.ModePending AND NOT #Unit.Clearing AND "FRK_DescendantsReady"(OwnerIndex := #Core.RegIndex);
    CASE #Request.Kind OF
        23:
            "FRK_ConfigBegin"(Cursor := #ConfigCursor, Page := #HmiResponse.ConfigPage, PageIndex := #Request.IntValue, Revision := #ConfigRev);
            #HmiResponse.Accepted := FALSE;
            #HmiResponse.Diagnostic := WSTRING#'std.error.modelNotAvailable';
            IF #Request.DurationMs <= INT_TO_UDINT(#AvailableModelCount) AND #Request.IntValue >= 0 AND #Request.IntValue <= 32767 THEN
                "FRK_Config_PressDemoUnit"(Core := #Core, Status := #Status, ParCfg := #ParCfg, ModePolicy := #ModePolicy, AvailableModelCount := #AvailableModelCount, ModelCapacity := #ModelCapacity, SequenceStepDef := #SequenceStepDef, SequenceStepCount := #SequenceStepCount, StationCfg := #StationCfg, PressRam := #PressRam, Door := #Door, PartSlide := #PartSlide, TwoHand := #TwoHand, PartPresentSensor := #PartPresentSensor, AirPressureMonitor := #AirPressureMonitor, Access := #Access, RootIndex := #RootIndex, ModelIndex := #Request.DurationMs, Cursor := #ConfigCursor, Page := #HmiResponse.ConfigPage);
                "FRK_ConfigFinish"(Cursor := #ConfigCursor, Page := #HmiResponse.ConfigPage);
                #HmiResponse.Accepted := TRUE; #HmiResponse.Diagnostic := WSTRING#'';
            END_IF;
        19, 27:
            #HmiResponse.Accepted := FALSE;
            "FRK_ConfigScratch".RejectDescription := WSTRING#'std.error.recipeSchemaInvalid';
            "FRK_ConfigScratch".RejectReason := 2004;
            "FRK_ConfigScratch".CommittedScope := #Status.Name;
            #HmiResponse.Diagnostic := "FRK_ConfigScratch".RejectDescription;
            #ConfigPersist.LastRejectScope := #Status.Name;
            #ConfigPersist.LastRejectKey := #Request.NameValue;
            #HmiResponse.Report.Count := 0; #HmiResponse.Report.Released := TRUE;
            IF #Request.Kind = 27 THEN
                "FRK_ManualCommon"(Core := #Core, Unit := #Unit, Status := #Status, Report := #HmiResponse.Report);
                #Ready := #Ready AND #HmiResponse.Report.Released AND #Request.DurationMs = 0;
                IF NOT #Ready THEN
                    #HmiResponse.Diagnostic := WSTRING#'std.release.unitNotReady';
                    IF #HmiResponse.Report.Count = 0 THEN "FRK_ReleaseReason"(Report := #HmiResponse.Report, Description := #HmiResponse.Diagnostic, Reason := 2002, Path := STRING_TO_WSTRING(#Status.Name), Kind := 4); END_IF;
                    RETURN; END_IF;
            END_IF;
            IF #Request.DurationMs <= INT_TO_UDINT(#AvailableModelCount) THEN
                #Matched := FALSE;
                #HmiResponse.Accepted := "FRK_CfgWrite_PressDemoUnit"(Core := #Core, Status := #Status, ParCfg := #ParCfg, StationCfg := #StationCfg, PressRam := #PressRam, Door := #Door, PartSlide := #PartSlide, TwoHand := #TwoHand, PartPresentSensor := #PartPresentSensor, AirPressureMonitor := #AirPressureMonitor, Access := #Access, Request := #Request, RootIndex := #RootIndex, RootReady := #Ready, Matched := #Matched);
            END_IF;
            IF #HmiResponse.Accepted THEN
                "FRK_ConfigWriteAudit"(Scope := "FRK_ConfigScratch".CommittedScope, Key := #Request.NameValue, Value := "FRK_ConfigScratch".CommittedText, Captured := #Request.Kind = 27, User := #Unit.RequestUser, AlarmLog := #AlarmLog);
                #ConfigRev := "FRK_ConfigRevision"(Previous := #ConfigRev);
                #HmiResponse.Diagnostic := WSTRING#'';
                #ConfigPersist.LastRejectScope := ''; #ConfigPersist.LastRejectKey := '';
            ELSE
                #ConfigPersist.LastRejectScope := "FRK_ConfigScratch".CommittedScope;
                #HmiResponse.Diagnostic := "FRK_ConfigScratch".RejectDescription;
                "FRK_ReleaseReason"(Report := #HmiResponse.Report, Description := #HmiResponse.Diagnostic, Reason := "FRK_ConfigScratch".RejectReason, Path := STRING_TO_WSTRING("FRK_ConfigScratch".CommittedScope), Kind := 4);
            END_IF;
