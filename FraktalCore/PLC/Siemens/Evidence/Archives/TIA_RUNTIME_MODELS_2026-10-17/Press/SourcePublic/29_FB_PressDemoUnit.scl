END_VAR
VAR_IN_OUT
    Module : "FB_PressDemoUnit";
    Hal : "ST_PressDemoUnitHal";
    Report : "ST_ReleaseReport";
END_VAR
VAR_TEMP
    RouteMatched : Bool;
    Index : Int;
END_VAR
BEGIN
    #FRK_Route_PressDemoUnit := FALSE;
    IF NOT "FRK_PathOwned"(OwnerPath := #Module.Status.Name, TargetPath := #Request.TargetPath) THEN RETURN; END_IF;
    "FRK_Release_PressDemoUnit"(Unit := #Module.Unit, Hal := #Hal);
    "FRK_ManualCommon"(Core := #Module.Core, Unit := #Module.Unit, Status := #Module.Status, Report := #Report);
    IF #Request.TargetPath = STRING_TO_WSTRING(#Module.Status.Name) THEN
        "FRK_ReleaseReason"(Report := #Report, Description := WSTRING#'std.error.unsupportedHmiRequest', Reason := 2008, Path := STRING_TO_WSTRING(#Module.Status.Name), Kind := 4);
        #FRK_Route_PressDemoUnit := TRUE;
        RETURN;
    END_IF;
    #RouteMatched := "FRK_Route_CylinderCM"(Module := #Module.PressRam, Hal := #Hal.PressRam, Request := #Request, Report := #Report);
    #FRK_Route_PressDemoUnit := #FRK_Route_PressDemoUnit OR #RouteMatched;
    #RouteMatched := "FRK_Route_CylinderCM"(Module := #Module.Door, Hal := #Hal.Door, Request := #Request, Report := #Report);
    #FRK_Route_PressDemoUnit := #FRK_Route_PressDemoUnit OR #RouteMatched;
    #RouteMatched := "FRK_Route_CylinderCM"(Module := #Module.PartSlide, Hal := #Hal.PartSlide, Request := #Request, Report := #Report);
    #FRK_Route_PressDemoUnit := #FRK_Route_PressDemoUnit OR #RouteMatched;
    #RouteMatched := "FRK_Route_TwoHandStartCM"(Module := #Module.TwoHand, Hal := #Hal.TwoHand, Request := #Request, Report := #Report);
    #FRK_Route_PressDemoUnit := #FRK_Route_PressDemoUnit OR #RouteMatched;
    #RouteMatched := "FRK_Route_DigitalInputCM"(Module := #Module.PartPresentSensor, Hal := #Hal.PartPresentSensor, Request := #Request, Report := #Report);
    #FRK_Route_PressDemoUnit := #FRK_Route_PressDemoUnit OR #RouteMatched;
    #RouteMatched := "FRK_Route_AirPressureMonitorCM"(Module := #Module.AirPressureMonitor, Hal := #Hal.AirPressureMonitor, Request := #Request, Report := #Report);
    #FRK_Route_PressDemoUnit := #FRK_Route_PressDemoUnit OR #RouteMatched;
END_FUNCTION
