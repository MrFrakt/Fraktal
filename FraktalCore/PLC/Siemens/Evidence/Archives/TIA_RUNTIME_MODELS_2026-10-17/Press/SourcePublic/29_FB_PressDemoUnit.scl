    IF NOT #Ok THEN #FRK_CfgRecipe_PressDemoUnit := FALSE; RETURN; END_IF;
    #Ok := "FRK_CfgRecipe_TwoHandStartCM"(Module := #TwoHand, ModelCode := #ModelCode, Phase := #Phase, RejectScope := #RejectScope, RejectKey := #RejectKey);
    IF NOT #Ok THEN #FRK_CfgRecipe_PressDemoUnit := FALSE; RETURN; END_IF;
