FUNCTION "FRK_ModelPrepare" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Startup : Bool;
   END_VAR

   VAR_TEMP 
      RootIndex : Int;
      Index : DInt;
   END_VAR


BEGIN
	
	IF NOT #Startup THEN
	    RETURN;
	END_IF;
	FOR #RootIndex := 1 TO 2 DO
	    "FRK_ModelRuntime".Rows[#RootIndex] := "FRK_ModelRuntime".BlankWork;
	END_FOR;
	
END_FUNCTION

