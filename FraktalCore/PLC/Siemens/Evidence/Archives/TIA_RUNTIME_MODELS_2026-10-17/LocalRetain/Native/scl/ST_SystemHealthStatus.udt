TYPE "ST_SystemHealthStatus"
VERSION : 0.1
   STRUCT
      Present : Bool;
      Healthy : Bool;
      SourcePath : WString[255];
      TaskAvailable : Bool;
      TaskCycleUs : UDInt;
      TaskJitterUs : UDInt;
      TaskOverrun : Bool;
      ControllerAvailable : Bool;
      CpuLoadPct : LReal;
      MemoryAvailableMb : UDInt;
      IpcAvailable : Bool;
      IpcTemperatureC : LReal;
      FanHealthy : Bool;
      StorageHealthPct : LReal;
      FieldbusAvailable : Bool;
      FieldbusMasterHealthy : Bool;
      LostFrameCount : UDInt;
      SlaveErrorCount : UDInt;
      DcAvailable : Bool;
      DcSynchronized : Bool;
      TimeQuality : "ST_TimeQuality";
      FanAvailable : Bool;
      StorageAvailable : Bool;
   END_STRUCT;

END_TYPE

