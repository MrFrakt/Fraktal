            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
        IF NOT "FRK_ConfigRecordValid"(Scope := 'StationB.Satellite.Inner.Cell.Clamp', Record := #Image.Rows[#RowIndex].Record) THEN RETURN; END_IF;
        #Stored := "FRK_ConfigReserve"(Scope := 'StationB.Satellite.Inner.Cell.Clamp', Key := 'preset', ModelCode := #Image.Catalog.Codes[#ModelSlot], Reserved := #Targets);
        IF #Stored < 1 OR #Stored > 212 THEN RETURN; END_IF;
        #Targets[#RowIndex] := #Stored;
        #RowIndex := (#ModelSlot - 3) * 26 + 25;
        "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 1);
        IF NOT #Image.Rows[#RowIndex].Used OR #Image.Rows[#RowIndex].SchemaVersion <> "FRK_ConfigScratch".Schema
            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
        IF NOT "FRK_ConfigRecordValid"(Scope := 'StationB.Satellite.Inner.Cell.Gate', Record := #Image.Rows[#RowIndex].Record) THEN RETURN; END_IF;
        #Stored := "FRK_ConfigReserve"(Scope := 'StationB.Satellite.Inner.Cell.Gate', Key := 'timeout', ModelCode := #Image.Catalog.Codes[#ModelSlot], Reserved := #Targets);
        IF #Stored < 1 OR #Stored > 212 THEN RETURN; END_IF;
        #Targets[#RowIndex] := #Stored;
        #RowIndex := (#ModelSlot - 3) * 26 + 26;
        "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 2);
        IF NOT #Image.Rows[#RowIndex].Used OR #Image.Rows[#RowIndex].SchemaVersion <> "FRK_ConfigScratch".Schema
            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
        IF NOT "FRK_ConfigRecordValid"(Scope := 'StationB.Satellite.Inner.Cell.Gate', Record := #Image.Rows[#RowIndex].Record) THEN RETURN; END_IF;
        #Stored := "FRK_ConfigReserve"(Scope := 'StationB.Satellite.Inner.Cell.Gate', Key := 'preset', ModelCode := #Image.Catalog.Codes[#ModelSlot], Reserved := #Targets);
        IF #Stored < 1 OR #Stored > 212 THEN RETURN; END_IF;
        #Targets[#RowIndex] := #Stored;
    END_FOR;
    FOR #Index := 1 TO #Image.RecordCount DO
        "FRK_ConfigStore".Rows[#Targets[#Index]] := #Image.Rows[#Index];
    END_FOR;
    "FRK_ModelStore".Rows[2] := #Image.Catalog;
    "FRK_ConfigStore".SchemaVersion := 1;
    #FRK_ModelApply_R2 := TRUE;
END_FUNCTION
FUNCTION "FRK_ModelCapture" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
END_VAR
VAR_IN_OUT
    Image : "FRK_ModelImage";
    Catalog : "FRK_ModelCatalog";
END_VAR
BEGIN
    #FRK_ModelCapture := FALSE;
    CASE #RootIndex OF
        1: #FRK_ModelCapture := "FRK_ModelCapture_R1"(Image := #Image, Catalog := #Catalog);
        2: #FRK_ModelCapture := "FRK_ModelCapture_R2"(Image := #Image, Catalog := #Catalog);
        ELSE RETURN;
    END_CASE;
END_FUNCTION
FUNCTION "FRK_ModelApply" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
END_VAR
VAR_IN_OUT
    Image : "FRK_ModelImage";
END_VAR
BEGIN
    #FRK_ModelApply := FALSE;
    CASE #RootIndex OF
        1: #FRK_ModelApply := "FRK_ModelApply_R1"(Image := #Image);
        2: #FRK_ModelApply := "FRK_ModelApply_R2"(Image := #Image);
        ELSE RETURN;
    END_CASE;
END_FUNCTION
FUNCTION "FRK_ModelDefaults" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    RootIndex : Int;
END_VAR
BEGIN
    IF #RootIndex < 1 OR #RootIndex > 2 THEN RETURN; END_IF;
    "FRK_ModelStore".Rows[#RootIndex] := "FRK_ModelRuntime".BlankCatalog;
    "FRK_ModelStore".Rows[#RootIndex].SchemaVersion := 1;
    "FRK_ModelStore".Rows[#RootIndex].Capacity := 3;
    "FRK_ModelStore".Rows[#RootIndex].Count := 2;
    "FRK_ModelStore".Rows[#RootIndex].Generation := 1;
    IF #RootIndex = 1 THEN "FRK_ModelStore".Rows[#RootIndex].Scope := 'StationA'; END_IF;
    IF #RootIndex = 2 THEN "FRK_ModelStore".Rows[#RootIndex].Scope := 'StationB'; END_IF;
    "FRK_ModelStore".Rows[#RootIndex].Codes[1] := 'MODEL_A';
    "FRK_ModelStore".Rows[#RootIndex].Codes[2] := 'MODEL_B';
    "FRK_ModelStore".Rows[#RootIndex].Checksum := "FRK_ModelCrc"(Catalog := "FRK_ModelStore".Rows[#RootIndex]);
END_FUNCTION
FUNCTION "FRK_ModelPrepare" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Startup : Bool;
END_VAR
VAR_TEMP
    RootIndex : Int;
    Index : DInt;
END_VAR
BEGIN
    IF NOT #Startup THEN RETURN; END_IF;
    FOR #RootIndex := 1 TO 2 DO
        "FRK_ModelRuntime".Rows[#RootIndex] := "FRK_ModelRuntime".BlankWork;
    END_FOR;
END_FUNCTION
FUNCTION "FRK_ModelBoot" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Startup : Bool;
END_VAR
VAR_TEMP
    Virgin : Bool;
    Ok : Bool;
END_VAR
BEGIN
    IF NOT #Startup THEN RETURN; END_IF;
    #Virgin := "FRK_ModelVirgin"(Catalog := "FRK_ModelStore".Rows[1]);
    #Ok := "FRK_ModelValid"(RootIndex := 1, Catalog := "FRK_ModelStore".Rows[1]);
    IF #Ok THEN #Ok := "FRK_ModelCapture"(RootIndex := 1, Catalog := "FRK_ModelStore".Rows[1], Image := "FRK_ModelRuntime".ScratchImage); END_IF;
    IF NOT #Ok THEN
        "FRK_ModelDefaults"(RootIndex := 1);
        IF NOT #Virgin THEN "FRK_ConfigLoss"(RootIndex := 1, Scope := 'StationA'); END_IF;
    END_IF;
    IF NOT "FRK_ModelKnown"(RootIndex := 1, Code := "FRK_ConfigStore".ActiveModels[1]) THEN
        "FRK_ConfigSetActiveModel"(RootIndex := 1, ModelCode := 'MODEL_A');
        IF NOT #Virgin OR "FRK_ConfigStore".SchemaVersion <> 0 THEN "FRK_ConfigLoss"(RootIndex := 1, Scope := 'StationA'); END_IF;
    END_IF;
    "FRK_ModelRuntime".Rows[1].Ready := TRUE;
    #Virgin := "FRK_ModelVirgin"(Catalog := "FRK_ModelStore".Rows[2]);
    #Ok := "FRK_ModelValid"(RootIndex := 2, Catalog := "FRK_ModelStore".Rows[2]);
    IF #Ok THEN #Ok := "FRK_ModelCapture"(RootIndex := 2, Catalog := "FRK_ModelStore".Rows[2], Image := "FRK_ModelRuntime".ScratchImage); END_IF;
    IF NOT #Ok THEN
        "FRK_ModelDefaults"(RootIndex := 2);
        IF NOT #Virgin THEN "FRK_ConfigLoss"(RootIndex := 2, Scope := 'StationB'); END_IF;
    END_IF;
    IF NOT "FRK_ModelKnown"(RootIndex := 2, Code := "FRK_ConfigStore".ActiveModels[2]) THEN
        "FRK_ConfigSetActiveModel"(RootIndex := 2, ModelCode := 'MODEL_A');
        IF NOT #Virgin OR "FRK_ConfigStore".SchemaVersion <> 0 THEN "FRK_ConfigLoss"(RootIndex := 2, Scope := 'StationB'); END_IF;
    END_IF;
    "FRK_ModelRuntime".Rows[2].Ready := TRUE;
END_FUNCTION
