        "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 2);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Cell.Gate', Key := 'preset', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Cell.Gate', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 11;
        "FRK_CfgDef_SatelliteUnit"(FieldIndex := 1);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite', Key := 'timeout', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 12;
        "FRK_CfgDef_SatelliteUnit"(FieldIndex := 2);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite', Key := 'preset', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 13;
        "FRK_CfgDef_DeclarationCell"(FieldIndex := 1);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite.Cell', Key := 'timeout', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite.Cell', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 14;
        "FRK_CfgDef_DeclarationCell"(FieldIndex := 2);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite.Cell', Key := 'preset', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite.Cell', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 15;
        "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 1);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite.Cell.Clamp', Key := 'timeout', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite.Cell.Clamp', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 16;
        "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 2);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite.Cell.Clamp', Key := 'preset', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite.Cell.Clamp', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 17;
        "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 1);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite.Cell.Gate', Key := 'timeout', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite.Cell.Gate', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 18;
        "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 2);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite.Cell.Gate', Key := 'preset', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite.Cell.Gate', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
        #Image.Rows[#RowIndex] := "FRK_ConfigStore".Rows[#Stored];
        #Image.RecordCount := #Image.RecordCount + 1;
        #RowIndex := (#ModelSlot - 3) * 26 + 19;
        "FRK_CfgDef_InnerUnit"(FieldIndex := 1);
        #Stored := "FRK_ConfigFind"(Scope := 'StationA.Satellite.Inner', Key := 'timeout', ModelCode := #Catalog.Codes[#ModelSlot]);
        IF #Stored = 0 OR NOT "FRK_ConfigGet"(Scope := 'StationA.Satellite.Inner', ModelCode := #Catalog.Codes[#ModelSlot]) THEN RETURN; END_IF;
