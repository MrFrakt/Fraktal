FUNCTION "FRK_ModelApply_R1" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Image : "FRK_ModelImage";
END_VAR
VAR_TEMP
    Index : Int;
    ModelSlot : Int;
    RowIndex : Int;
    Stored : Int;
    Targets : Array[1..32] of Int;
END_VAR
BEGIN
    #FRK_ModelApply_R1 := FALSE;
    IF NOT "FRK_ModelValid"(RootIndex := 1, Catalog := #Image.Catalog) THEN RETURN; END_IF;
    IF #Image.RecordCount <> (#Image.Catalog.Count - 2) * 26 THEN RETURN; END_IF;
    FOR #Index := 1 TO 32 DO #Targets[#Index] := 0; END_FOR;
    FOR #ModelSlot := 3 TO #Image.Catalog.Count DO
        #RowIndex := (#ModelSlot - 3) * 26 + 1;
        "FRK_CfgDef_DeclarationUnit"(FieldIndex := 1);
        IF NOT #Image.Rows[#RowIndex].Used OR #Image.Rows[#RowIndex].SchemaVersion <> "FRK_ConfigScratch".Schema
            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
        IF NOT "FRK_ConfigRecordValid"(Scope := 'StationA', Record := #Image.Rows[#RowIndex].Record) THEN RETURN; END_IF;
        #Stored := "FRK_ConfigReserve"(Scope := 'StationA', Key := 'timeout', ModelCode := #Image.Catalog.Codes[#ModelSlot], Reserved := #Targets);
        IF #Stored < 1 OR #Stored > 212 THEN RETURN; END_IF;
        #Targets[#RowIndex] := #Stored;
        #RowIndex := (#ModelSlot - 3) * 26 + 2;
        "FRK_CfgDef_DeclarationUnit"(FieldIndex := 2);
        IF NOT #Image.Rows[#RowIndex].Used OR #Image.Rows[#RowIndex].SchemaVersion <> "FRK_ConfigScratch".Schema
            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
        IF NOT "FRK_ConfigRecordValid"(Scope := 'StationA', Record := #Image.Rows[#RowIndex].Record) THEN RETURN; END_IF;
        #Stored := "FRK_ConfigReserve"(Scope := 'StationA', Key := 'preset', ModelCode := #Image.Catalog.Codes[#ModelSlot], Reserved := #Targets);
        IF #Stored < 1 OR #Stored > 212 THEN RETURN; END_IF;
        #Targets[#RowIndex] := #Stored;
        #RowIndex := (#ModelSlot - 3) * 26 + 3;
        "FRK_CfgDef_DeclarationUnit"(FieldIndex := 8);
        IF NOT #Image.Rows[#RowIndex].Used OR #Image.Rows[#RowIndex].SchemaVersion <> "FRK_ConfigScratch".Schema
            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
        IF NOT "FRK_ConfigRecordValid"(Scope := 'StationA', Record := #Image.Rows[#RowIndex].Record) THEN RETURN; END_IF;
        #Stored := "FRK_ConfigReserve"(Scope := 'StationA', Key := 'idealCycleMs', ModelCode := #Image.Catalog.Codes[#ModelSlot], Reserved := #Targets);
        IF #Stored < 1 OR #Stored > 212 THEN RETURN; END_IF;
        #Targets[#RowIndex] := #Stored;
        #RowIndex := (#ModelSlot - 3) * 26 + 4;
        "FRK_CfgDef_DeclarationUnit"(FieldIndex := 9);
        IF NOT #Image.Rows[#RowIndex].Used OR #Image.Rows[#RowIndex].SchemaVersion <> "FRK_ConfigScratch".Schema
            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
        IF NOT "FRK_ConfigRecordValid"(Scope := 'StationA', Record := #Image.Rows[#RowIndex].Record) THEN RETURN; END_IF;
        #Stored := "FRK_ConfigReserve"(Scope := 'StationA', Key := 'baselineMs', ModelCode := #Image.Catalog.Codes[#ModelSlot], Reserved := #Targets);
        IF #Stored < 1 OR #Stored > 212 THEN RETURN; END_IF;
        #Targets[#RowIndex] := #Stored;
        #RowIndex := (#ModelSlot - 3) * 26 + 5;
        "FRK_CfgDef_DeclarationCell"(FieldIndex := 1);
        IF NOT #Image.Rows[#RowIndex].Used OR #Image.Rows[#RowIndex].SchemaVersion <> "FRK_ConfigScratch".Schema
            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
        IF NOT "FRK_ConfigRecordValid"(Scope := 'StationA.Cell', Record := #Image.Rows[#RowIndex].Record) THEN RETURN; END_IF;
        #Stored := "FRK_ConfigReserve"(Scope := 'StationA.Cell', Key := 'timeout', ModelCode := #Image.Catalog.Codes[#ModelSlot], Reserved := #Targets);
        IF #Stored < 1 OR #Stored > 212 THEN RETURN; END_IF;
        #Targets[#RowIndex] := #Stored;
        #RowIndex := (#ModelSlot - 3) * 26 + 6;
        "FRK_CfgDef_DeclarationCell"(FieldIndex := 2);
        IF NOT #Image.Rows[#RowIndex].Used OR #Image.Rows[#RowIndex].SchemaVersion <> "FRK_ConfigScratch".Schema
            OR #Image.Rows[#RowIndex].ModelCode <> #Image.Catalog.Codes[#ModelSlot]
            THEN RETURN; END_IF;
