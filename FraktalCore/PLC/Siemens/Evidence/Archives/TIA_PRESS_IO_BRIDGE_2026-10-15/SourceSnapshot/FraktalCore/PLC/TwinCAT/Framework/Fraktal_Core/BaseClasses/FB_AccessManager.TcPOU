<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_AccessManager" Id="{a5754c56-27d7-4f58-93a7-2bc76040ee69}" SpecialFunc="None">
    <Declaration><![CDATA[// Core §7.7(c) — per-root session + enforcement. Login/logout is DATA-DRIVEN
// (§3.10(a')): the HMI writes ReqUser/ReqSecret and pulses ReqLogin/ReqLogout;
// the secret is cleared after every attempt. Policy default: fully open (§7.7(b)).
FUNCTION_BLOCK FB_AccessManager
VAR_INPUT
    ReqUser   : STRING(32);          // HMI-writable login request
    ReqSecret : STRING(32);          // cleared after each attempt (§7.7(c))
    ReqLogin  : BOOL;
    ReqLogout : BOOL;
END_VAR
VAR_OUTPUT
    SessionGeneration : UDINT; // changes on every successful login/session termination
    CurrentUser  : STRING(32);
    CurrentLevel : E_AccessLevel;    // HMI greys controls from this; PLC re-checks
    LoginFailed  : BOOL;             // last attempt outcome (HMI feedback)
END_VAR
VAR PERSISTENT
    Policy : ST_AccessPolicy;
    // §3.8d - data-class levels. A SEPARATE persistent table on purpose: adding
    // members to Policy would change its layout, TwinCAT would reinitialize it on
    // the next download, and a locked-down station would silently come back
    // fully open. A new variable starts empty and touches nothing that exists.
    ClassCount : INT;
    Classes    : ARRAY[1..PL_Fraktal.MAX_DATA_CLASSES] OF ST_DataClassPolicy;        // §3.8a station config; edit gated by ACCESS_POLICY
END_VAR
VAR
    {attribute 'OPC.UA.DA' := '0'}
    _provider : I_AccessProvider;
    {attribute 'OPC.UA.DA' := '0'}
    _log      : POINTER TO FB_AlarmLog;
    _tIdle    : TON;
    _activityPending : BOOL;          // accepted operator action rearms the idle timer
    // §7.7(c) - the provider's durable-table service, when it offers one.
    {attribute 'OPC.UA.DA' := '0'}
    _store : I_AccessStore;
    _storeRestored : BOOL;              // the store's table has been read
    _restoreLossSeen : BOOL;          // this root has taken the provider's loss
    _restoreLossTake : BOOL;          // pending for the root's §3.8b annunciation
    _saveFailedSlot : INT;            // open CONFIG_PERSIST_FAILED event (0 = none)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// event/session handling is in Cyclic (called by the owning Unit each scan)]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{f524a87a-e061-4ff8-b535-53d9cf845caa}">
      <Declaration><![CDATA[METHOD Cyclic : BOOL
VAR
    lvl : E_AccessLevel;
    loginHandled : BOOL;
    logoutHandled : BOOL;
    sessionRearm : BOOL;
    activityHandled : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// §7.7(c) - restore/save the provider's table before this scan's login, so a
// restored user can log in on the scan the table arrives.
IF _store <> 0 THEN
    _storeRestored := _store.M_Service();
    _M_StoreCyclic();
END_IF
sessionRearm := FALSE;
loginHandled := ReqLogin;
IF loginHandled THEN
    ReqLogin := FALSE;
    lvl := E_AccessLevel.NONE;
    IF _provider <> 0 THEN
        lvl := _provider.Authenticate(User := ReqUser, Secret := ReqSecret);
    END_IF
    ReqSecret := '';                                   // never retain the secret
    IF lvl > E_AccessLevel.NONE THEN
        SessionGeneration := SessionGeneration + 1;
        CurrentUser := ReqUser;
        CurrentLevel := lvl;
        LoginFailed := FALSE;
        sessionRearm := TRUE;
        _M_Audit('std.audit.login', CurrentUser);
    ELSE
        LoginFailed := TRUE;
        _M_Audit('std.audit.loginFailed', ReqUser);
    END_IF
END_IF
logoutHandled := ReqLogout;
IF logoutHandled THEN
    ReqLogout := FALSE;
    SessionGeneration := SessionGeneration + 1;
    IF CurrentLevel > E_AccessLevel.NONE THEN
        _M_Audit('std.audit.logout', CurrentUser);
        CurrentUser := '';
        CurrentLevel := E_AccessLevel.NONE;
    END_IF
END_IF
// Idle means time since the last accepted authenticated operator action, not
// absolute session age. Background reads/release queries never call RecordActivity.
activityHandled := _activityPending;
_activityPending := FALSE;
_tIdle(IN := (Policy.SessionTimeout > T#0S)
       AND (CurrentLevel > E_AccessLevel.NONE)
       AND NOT sessionRearm AND NOT activityHandled,
       PT := Policy.SessionTimeout);
IF _tIdle.Q THEN
    _M_Audit('std.audit.autoLogout', CurrentUser);
    SessionGeneration := SessionGeneration + 1;
        CurrentUser := '';
    CurrentLevel := E_AccessLevel.NONE;
END_IF
Cyclic := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConfigureRequired" Id="{ca211e14-0c26-4d31-aaf3-bf00dccfed16}">
      <Declaration><![CDATA[// Startup/station-configuration seam; runtime HMI writes remain Unit-gated.
METHOD ConfigureRequired : BOOL
VAR_INPUT
    Gate : E_GatedAction;
    Level : E_AccessLevel;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[// Upper bound = the LAST E_GatedAction member; it moves with every appended gate.
IF (TO_INT(Gate) < 0) OR (TO_INT(Gate) > TO_INT(E_GatedAction.CONFIG_SET))
OR (TO_INT(Level) < TO_INT(E_AccessLevel.NONE)) OR (TO_INT(Level) > TO_INT(E_AccessLevel.ADMIN)) THEN
    ConfigureRequired := FALSE;
ELSE
    Policy.Required[TO_INT(Gate)] := Level;
    ConfigureRequired := TRUE;
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="ConfigureSessionTimeout" Id="{599da87d-384b-4292-9157-c068d222ef29}">
      <Declaration><![CDATA[// Persistent station-policy edit. Seven days is a defensive upper bound that
// stays within the signed millisecond TIME conversion used by the TC3 binding.
METHOD ConfigureSessionTimeout : BOOL
VAR_INPUT
    TimeoutMs : UDINT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[IF TimeoutMs > 604800000 THEN
    ConfigureSessionTimeout := FALSE;
    RETURN;
END_IF
Policy.SessionTimeout := DINT_TO_TIME(TO_DINT(TimeoutMs));
ConfigureSessionTimeout := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="RequestLogin" Id="{126d9072-7c2d-4ed5-978f-501975d1299e}">
      <Declaration><![CDATA[// ST-facing request seam. OPC UA clients continue to write the published request data.
METHOD RequestLogin : BOOL
VAR_INPUT
    User : STRING(32);
    Secret : STRING(32);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[ReqUser := User;
ReqSecret := Secret;
ReqLogin := TRUE;
RequestLogin := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="RequestLogout" Id="{2c9e0da4-edd0-461d-a5ce-adcdc0497718}">
      <Declaration><![CDATA[// ST-facing request seam; the cyclic edge handler performs the state change and audit.
METHOD RequestLogout : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[ReqLogout := TRUE;
RequestLogout := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="RecordActivity" Id="{02034063-e7c6-46e2-b512-f7b902713d40}">
      <Declaration><![CDATA[// Called only by accepted gated operator actions. Keeping this explicit prevents
// periodic reads and release-panel polling from keeping an abandoned session alive.
METHOD RecordActivity : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[RecordActivity := CurrentLevel > E_AccessLevel.NONE;
IF RecordActivity THEN
    _activityPending := TRUE;
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="Permits" Id="{0a2e27c0-07c7-4a25-aa9d-77c75345beec}">
      <Declaration><![CDATA[// pure check for UI/logic — no logging
METHOD Permits : BOOL
VAR_INPUT
    Gate : E_GatedAction;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Permits := FALSE;
// Upper bound = the LAST E_GatedAction member. It said POWER_CONTROL after
// CONFIG_SET was appended, so every parameter-set operation was refused.
IF (TO_INT(Gate) < 0) OR (TO_INT(Gate) > TO_INT(E_GatedAction.CONFIG_SET)) THEN
    RETURN;
END_IF
IF (TO_INT(CurrentLevel) < TO_INT(E_AccessLevel.NONE)) OR (TO_INT(CurrentLevel) > TO_INT(E_AccessLevel.ADMIN)) THEN
    RETURN;
END_IF
IF (TO_INT(Policy.Required[TO_INT(Gate)]) < TO_INT(E_AccessLevel.NONE))
OR (TO_INT(Policy.Required[TO_INT(Gate)]) > TO_INT(E_AccessLevel.ADMIN)) THEN
    RETURN;                                      // corrupt policy fails closed
END_IF
Permits := TO_DINT(CurrentLevel) >= TO_DINT(Policy.Required[TO_INT(Gate)]);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_DataLevel" Id="{1f3c50fd-8132-405e-ba9f-0f47a19196a5}">
      <Declaration><![CDATA[// §3.8d - the EFFECTIVE level to read or write a value: its class's level,
// raised (never lowered) by the value's own minimum. '' is the built-in class,
// whose levels are the DATA_READ/DATA_WRITE thresholds. An undeclared class or
// a corrupt level fails closed at ADMIN.
METHOD M_DataLevel : E_AccessLevel
VAR_INPUT
    ClassId  : STRING(40);
    MinLevel : E_AccessLevel;
    ForWrite : BOOL;
END_VAR
VAR
    i     : INT;
    n     : INT;
    level : E_AccessLevel;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[level := E_AccessLevel.ADMIN;
IF ClassId = '' THEN
    IF ForWrite THEN
        level := Policy.Required[TO_INT(E_GatedAction.DATA_WRITE)];
    ELSE
        level := Policy.Required[TO_INT(E_GatedAction.DATA_READ)];
    END_IF
ELSE
    n := LIMIT(0, ClassCount, PL_Fraktal.MAX_DATA_CLASSES);
    FOR i := 1 TO n DO
        IF Classes[i].ClassId = ClassId THEN
            IF ForWrite THEN
                level := Classes[i].WriteLevel;
            ELSE
                level := Classes[i].ReadLevel;
            END_IF
            EXIT;
        END_IF
    END_FOR
END_IF
IF (TO_DINT(level) < TO_DINT(E_AccessLevel.NONE))
OR (TO_DINT(level) > TO_DINT(E_AccessLevel.ADMIN)) THEN
    level := E_AccessLevel.ADMIN;                // corrupt policy fails closed
END_IF
IF (TO_DINT(MinLevel) < TO_DINT(E_AccessLevel.NONE))
OR (TO_DINT(MinLevel) > TO_DINT(E_AccessLevel.ADMIN)) THEN
    level := E_AccessLevel.ADMIN;
ELSIF TO_DINT(MinLevel) > TO_DINT(level) THEN
    level := MinLevel;                           // raise-only
END_IF
M_DataLevel := level;]]></ST></Implementation>
    </Method>
    <Method Name="M_PermitsLevel" Id="{1f043cf1-ea7f-4595-ade3-27391af3f670}">
      <Declaration><![CDATA[// Pure check of the session against an already-resolved level.
METHOD M_PermitsLevel : BOOL
VAR_INPUT
    Required : E_AccessLevel;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_PermitsLevel := (TO_DINT(Required) >= TO_DINT(E_AccessLevel.NONE))
    AND (TO_DINT(Required) <= TO_DINT(E_AccessLevel.ADMIN))
    AND (TO_DINT(CurrentLevel) >= TO_DINT(Required));]]></ST></Implementation>
    </Method>
    <Method Name="M_PermitsLevelLogged" Id="{980eb7c1-7ab7-4576-aa28-ff94186436ba}">
      <Declaration><![CDATA[// Gated-entry form of M_PermitsLevel: a refusal is audited like a refused
// gated action (§7.7(c)), so a value refused by its class leaves the same trace.
METHOD M_PermitsLevelLogged : BOOL
VAR_INPUT
    Required : E_AccessLevel;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_PermitsLevelLogged := M_PermitsLevel(Required := Required);
IF NOT M_PermitsLevelLogged THEN
    _M_Audit(What := 'std.audit.dataAccessDenied', Who := CurrentUser);
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="M_DeclareClass" Id="{9376ef6b-894a-4400-82d0-3fdf01771da9}">
      <Declaration><![CDATA[// §3.8d - declare a data class, normally at Setup on every boot. The levels
// are DEFAULTS: a class already in the persistent table keeps the levels a
// deployment edited, and only its label follows the code. Refused when the
// table is full, the id is empty, or a level is out of range.
METHOD M_DeclareClass : BOOL
VAR_INPUT
    ClassId    : STRING(80);
    LabelKey   : STRING(160);
    ReadLevel  : E_AccessLevel;
    WriteLevel : E_AccessLevel;
END_VAR
VAR
    i : INT;
    n : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_DeclareClass := FALSE;
IF (ClassId = '') OR (LEN(ClassId) > 40)
OR (TO_DINT(ReadLevel) < TO_DINT(E_AccessLevel.NONE))
OR (TO_DINT(ReadLevel) > TO_DINT(E_AccessLevel.ADMIN))
OR (TO_DINT(WriteLevel) < TO_DINT(E_AccessLevel.NONE))
OR (TO_DINT(WriteLevel) > TO_DINT(E_AccessLevel.ADMIN)) THEN
    RETURN;
END_IF
n := LIMIT(0, ClassCount, PL_Fraktal.MAX_DATA_CLASSES);
ClassCount := n;
FOR i := 1 TO n DO
    IF Classes[i].ClassId = ClassId THEN
        Classes[i].LabelKey := LabelKey;          // the persisted levels stand
        M_DeclareClass := TRUE;
        RETURN;
    END_IF
END_FOR
IF n >= PL_Fraktal.MAX_DATA_CLASSES THEN
    RETURN;
END_IF
n := n + 1;
Classes[n].ClassId := ClassId;
Classes[n].LabelKey := LabelKey;
Classes[n].ReadLevel := ReadLevel;
Classes[n].WriteLevel := WriteLevel;
ClassCount := n;
M_DeclareClass := TRUE;]]></ST></Implementation>
    </Method>
    <Method Name="M_SetClassLevel" Id="{d7f445d3-01dd-4c41-9d06-c5bbdd88886b}">
      <Declaration><![CDATA[// §3.8d/§7.7(b) - change a declared class's read or write level. The caller
// (the root) owns the ACCESS_POLICY gate; this validates and stores only.
METHOD M_SetClassLevel : BOOL
VAR_INPUT
    ClassId  : STRING(80);
    Level    : E_AccessLevel;
    ForWrite : BOOL;
END_VAR
VAR
    i : INT;
    n : INT;
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[M_SetClassLevel := FALSE;
IF (TO_DINT(Level) < TO_DINT(E_AccessLevel.NONE))
OR (TO_DINT(Level) > TO_DINT(E_AccessLevel.ADMIN)) THEN
    RETURN;
END_IF
n := LIMIT(0, ClassCount, PL_Fraktal.MAX_DATA_CLASSES);
FOR i := 1 TO n DO
    IF Classes[i].ClassId = ClassId THEN
        IF ForWrite THEN
            Classes[i].WriteLevel := Level;
        ELSE
            Classes[i].ReadLevel := Level;
        END_IF
        M_SetClassLevel := TRUE;
        RETURN;
    END_IF
END_FOR]]></ST></Implementation>
    </Method>
    <Method Name="PermitsLogged" Id="{95aa1389-db64-4f1a-8591-0c8cfda5199a}">
      <Declaration><![CDATA[// gated-entry check: a DENIED attempt is audited as a MESSAGE event (§8.3/§7.7(c))
METHOD PermitsLogged : BOOL
VAR_INPUT
    Gate : E_GatedAction;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[PermitsLogged := Permits(Gate := Gate);
IF NOT PermitsLogged THEN
    _M_AuditDenied(Gate := Gate);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Setup" Id="{380f7b09-d7bf-4407-aa62-ac88c12cd7da}">
      <Declaration><![CDATA[METHOD Setup : BOOL
VAR_INPUT
    Provider : I_AccessProvider;
    pAlarmLog : POINTER TO FB_AlarmLog;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Provider <> 0 THEN
    _provider := Provider;                  // Unit OnInit may attach only the audit log
    _store := 0;
    __QUERYINTERFACE(Provider, _store);     // optional: a provider that retains its table
END_IF
_log := pAlarmLog;
Setup := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_TakeRestoreLoss" Id="{0bfca304-195b-4616-8112-6b3c451a1dba}">
      <Declaration><![CDATA[// §3.8b/§7.7(c) - TRUE exactly once per loss: the provider's retained user table
// was rejected or missing at restore. The owning root announces it like any
// other lost configuration image; taking it here never clears the provider.
METHOD M_TakeRestoreLoss : BOOL]]></Declaration>
      <Implementation><ST><![CDATA[M_TakeRestoreLoss := _restoreLossTake;
_restoreLossTake := FALSE;]]></ST></Implementation>
    </Method>
    <Method Name="_M_StoreCyclic" Id="{68bd7de3-3fc6-42ad-a9a1-3ee99b0c65e1}">
      <Declaration><![CDATA[// A registration that cannot be written is live now and lost at the next
// restart, so it stands as CONFIG_PERSIST_FAILED until a later write succeeds; a
// retained table that cannot be read stands the same way until it can.
METHOD PRIVATE _M_StoreCyclic
VAR
    text : STRING(80);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[IF _store.M_RestoreLost() THEN
    IF NOT _restoreLossSeen THEN
        _restoreLossSeen := TRUE;
        _restoreLossTake := TRUE;
    END_IF
END_IF
IF _store.M_SaveFailed() THEN
    IF (_saveFailedSlot = 0) AND (_log <> 0) THEN
        text := 'std.error.accessPersistFailed';
        IF NOT _storeRestored THEN
            text := 'std.error.storageUnreadable';
        END_IF
        _saveFailedSlot := _log^.Raise(Reason := E_Reason.CONFIG_PERSIST_FAILED,
            Text := text, Source := 'Access',
            Severity := E_Severity.MED, Category := E_Category.SYSTEM,
            ResetClass := E_ResetClass.AUTO_RESET);
    END_IF
ELSIF _saveFailedSlot > 0 THEN
    IF _log <> 0 THEN
        _log^.Gone(Slot := _saveFailedSlot);
    END_IF
    _saveFailedSlot := 0;
END_IF]]></ST></Implementation>
    </Method>
    <Method Name="_M_Audit" Id="{4a43a0c7-56fe-4d93-9850-5fda5b3cfdb6}">
      <Declaration><![CDATA[// audit trail for free: come+gone MESSAGE lands in the §8.3 ring
METHOD PRIVATE _M_Audit
VAR_INPUT
    What : STRING(64);
    Who : STRING(32);
END_VAR
VAR
    auditSlot : INT;
    txt : STRING(255);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _log = 0 THEN
    RETURN;
END_IF
txt := CONCAT(What, ': ');
txt := CONCAT(txt, Who);
auditSlot := _log^.Raise(Reason := E_Reason.NONE, Text := txt,
                 Source := 'Access', Severity := E_Severity.LOW,
                 Category := E_Category.SYSTEM, ResetClass := E_ResetClass.AUTO_RESET);
IF auditSlot > 0 THEN
    _log^.Gone(Slot := auditSlot);                     // instant come+gone -> ring entry
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_AuditDenied" Id="{27bed78f-4c82-494f-971f-602072298ccf}">
      <Declaration><![CDATA[// Include the action ordinal: a generic "denied" record is not actionable audit.
METHOD PRIVATE _M_AuditDenied
VAR_INPUT
    Gate : E_GatedAction;
END_VAR
VAR
    detail : STRING(32);
END_VAR]]></Declaration>
      <Implementation><ST><![CDATA[detail := CONCAT(CurrentUser, ' gate=');
detail := CONCAT(detail, TO_STRING(TO_DINT(Gate)));
_M_Audit(What := 'std.audit.accessDenied', Who := detail);]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
