TYPE "FRK_DeliveryReceipt"
VERSION : 0.1
   STRUCT
      "SchemaVersion" : UInt;
      "TargetPath" : String[80];
      "Token" : String[160];
      "Checksum" : UDInt;
      "DiscardLost" : Bool;
      "Epoch" : UDInt;
      "StreamId" : String[36];
      "Sequence" : UDInt;
   END_STRUCT;
END_TYPE
