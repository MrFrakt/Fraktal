// Demo logical I/O boundary. Bind these symbols to the commissioned hardware
// when a bench is available; feedback is never synthesized on that path.
DATA_BLOCK "GDB_PressDemoIO"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
VAR
    PartPresent : Bool;
    PartQuality : Bool;
    AirLowPressure : Bool;
    AirOperatingPressure : Bool;
    TwoHandLeft : Bool;
    TwoHandRight : Bool;
    TwoHandSafeActive : Bool;
    StandardIoHealthy : Bool;
    RamExtended : Bool;
    RamRetracted : Bool;
    DoorClosed : Bool;
    DoorOpen : Bool;
    SlideInside : Bool;
    SlideOutside : Bool;
    RamExtend : Bool;
    RamRetract : Bool;
    DoorClose : Bool;
    DoorRelease : Bool;
    SlideExtend : Bool;
    SlideRetract : Bool;
    StartLamp : Bool;
END_VAR
BEGIN
END_DATA_BLOCK

// SIMULATION ONLY - a plant model for virtual commissioning, never a safety
// calculation. The defaults run the press autonomously: air present, good
// parts swapped at the load position. The stimuli are readable but never
// writable over the Web API (its write surface stays the HmiRequest mailbox);
// change one through the engineering/simulation tools, not the HMI.
DATA_BLOCK "GDB_PressDemoSim"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
VAR
    LeftButton { ExternalWritable := 'False'} : Bool;
    RightButton { ExternalWritable := 'False'} : Bool;
    AirPressureOk { ExternalWritable := 'False'} : Bool := TRUE;
    PartQuality { ExternalWritable := 'False'} : Bool := TRUE;
    FieldbusHealthy { ExternalWritable := 'False'} : Bool := TRUE;
    // AutoLoad swaps the part whenever the slide returns to the load position;
    // without it PartPresent is the operator's manual stimulus.
    AutoLoad { ExternalWritable := 'False'} : Bool := TRUE;
    PartPresent { ExternalWritable := 'False'} : Bool := TRUE;
    RamPositionMs { ExternalWritable := 'False'} : DInt;
    DoorPositionMs { ExternalWritable := 'False'} : DInt;
    SlidePositionMs { ExternalWritable := 'False'} : DInt;
    PartLoaded { ExternalWritable := 'False'} : Bool := TRUE;
    SwapSinceMs { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : UDInt;
    Swapping { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
    SlideWasInside { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
    LastMs { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : UDInt;
    Started { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
END_VAR
BEGIN
END_DATA_BLOCK

// One double-acting cylinder: position in milliseconds of travel.
FUNCTION "F_PressDemoSimCylinder" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    TravelMs : DInt;
    DeltaMs : DInt;
END_VAR
VAR_IN_OUT
    PositionMs : DInt;
    Hal : "ST_CylinderHal";
END_VAR
BEGIN
    IF #Hal.CoilExtend AND NOT #Hal.CoilRetract THEN
        #PositionMs := MIN(IN1 := #PositionMs + #DeltaMs, IN2 := #TravelMs);
    ELSIF #Hal.CoilRetract AND NOT #Hal.CoilExtend THEN
        #PositionMs := MAX(IN1 := #PositionMs - #DeltaMs, IN2 := 0);
    END_IF;
    #Hal.FeedbackExtended := #PositionMs >= #TravelMs;
    #Hal.FeedbackRetracted := #PositionMs <= 0;
END_FUNCTION

FUNCTION_BLOCK "FB_PressDemoHardwareDriver"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    ReadInputs { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False' } : Bool;
END_VAR
VAR_TEMP
    DeltaMs : DInt;
END_VAR
VAR CONSTANT
    // Build gate (Core 7.5): TRUE animates the plant model and holds every
    // physical output FALSE. Changing it is a regeneration plus a download.
    USE_SIMULATION : Bool := FALSE;
    RAM_TRAVEL_MS : DInt := 250;
    DOOR_TRAVEL_MS : DInt := 200;
    SLIDE_TRAVEL_MS : DInt := 300;
    PART_SWAP_MS : UDInt := 1000;
END_VAR
BEGIN
    IF #ReadInputs AND #USE_SIMULATION THEN
        IF NOT "GDB_PressDemoSim".Started THEN
            "GDB_PressDemoSim".Started := TRUE;
            "GDB_PressDemoSim".LastMs := "FRK_Clock".NowMs;
        END_IF;
        #DeltaMs := UDINT_TO_DINT("FRK_Elapsed"(NewMs := "FRK_Clock".NowMs, OldMs := "GDB_PressDemoSim".LastMs));
        "GDB_PressDemoSim".LastMs := "FRK_Clock".NowMs;
        "F_PressDemoSimCylinder"(TravelMs := #RAM_TRAVEL_MS, DeltaMs := #DeltaMs,
            PositionMs := "GDB_PressDemoSim".RamPositionMs, Hal := "GDB_FraktalHal".Data.PressDemo.PressRam);
        "F_PressDemoSimCylinder"(TravelMs := #DOOR_TRAVEL_MS, DeltaMs := #DeltaMs,
            PositionMs := "GDB_PressDemoSim".DoorPositionMs, Hal := "GDB_FraktalHal".Data.PressDemo.Door);
        "F_PressDemoSimCylinder"(TravelMs := #SLIDE_TRAVEL_MS, DeltaMs := #DeltaMs,
            PositionMs := "GDB_PressDemoSim".SlidePositionMs, Hal := "GDB_FraktalHal".Data.PressDemo.PartSlide);
        // Operator part swap: the pressed part is removed and a new one placed
        // once the slide is back at the load position.
        IF "GDB_PressDemoSim".AutoLoad THEN
            IF "GDB_FraktalHal".Data.PressDemo.PartSlide.FeedbackExtended THEN
                "GDB_PressDemoSim".SlideWasInside := TRUE;
            ELSIF "GDB_PressDemoSim".SlideWasInside AND "GDB_FraktalHal".Data.PressDemo.PartSlide.FeedbackRetracted THEN
                "GDB_PressDemoSim".SlideWasInside := FALSE;
                "GDB_PressDemoSim".Swapping := TRUE;
                "GDB_PressDemoSim".SwapSinceMs := "FRK_Clock".NowMs;
            END_IF;
            IF "GDB_PressDemoSim".Swapping AND "FRK_Elapsed"(NewMs := "FRK_Clock".NowMs,
                OldMs := "GDB_PressDemoSim".SwapSinceMs) >= #PART_SWAP_MS THEN
                "GDB_PressDemoSim".Swapping := FALSE;
            END_IF;
            "GDB_PressDemoSim".PartLoaded := NOT "GDB_PressDemoSim".Swapping;
        ELSE
            "GDB_PressDemoSim".Swapping := FALSE;
            "GDB_PressDemoSim".SlideWasInside := FALSE;
            "GDB_PressDemoSim".PartLoaded := "GDB_PressDemoSim".PartPresent;
        END_IF;
        "GDB_FraktalHal".Data.PressDemo.PartPresentSensor.Value := "GDB_PressDemoSim".PartLoaded;
        "GDB_FraktalHal".Data.PressDemo.PartPresentSensor.Quality := "GDB_PressDemoSim".FieldbusHealthy;
        "GDB_FraktalHal".Data.PressDemo.Process.PartQuality := "GDB_PressDemoSim".PartQuality;
        "GDB_FraktalHal".Data.PressDemo.AirPressureMonitor.LowPressure := NOT "GDB_PressDemoSim".AirPressureOk;
        "GDB_FraktalHal".Data.PressDemo.AirPressureMonitor.OperatingPressure := "GDB_PressDemoSim".AirPressureOk;
        "GDB_FraktalHal".Data.PressDemo.AirPressureMonitor.Quality := "GDB_PressDemoSim".FieldbusHealthy;
        "GDB_FraktalHal".Data.PressDemo.TwoHand.LeftPressed := "GDB_PressDemoSim".LeftButton;
        "GDB_FraktalHal".Data.PressDemo.TwoHand.RightPressed := "GDB_PressDemoSim".RightButton;
        "GDB_FraktalHal".Data.PressDemo.TwoHand.SafeActive := "GDB_PressDemoSim".LeftButton
            AND "GDB_PressDemoSim".RightButton AND "GDB_PressDemoSim".FieldbusHealthy;
        "GDB_FraktalHal".Data.PressDemo.TwoHand.FieldbusHealthy := "GDB_PressDemoSim".FieldbusHealthy;
    ELSIF #ReadInputs THEN
        "GDB_FraktalHal".Data.PressDemo.PartPresentSensor.Value := "GDB_PressDemoIO".PartPresent;
        "GDB_FraktalHal".Data.PressDemo.PartPresentSensor.Quality := "GDB_PressDemoIO".StandardIoHealthy;
        "GDB_FraktalHal".Data.PressDemo.Process.PartQuality := "GDB_PressDemoIO".PartQuality;
        "GDB_FraktalHal".Data.PressDemo.AirPressureMonitor.LowPressure := "GDB_PressDemoIO".AirLowPressure;
        "GDB_FraktalHal".Data.PressDemo.AirPressureMonitor.OperatingPressure := "GDB_PressDemoIO".AirOperatingPressure;
        "GDB_FraktalHal".Data.PressDemo.AirPressureMonitor.Quality := "GDB_PressDemoIO".StandardIoHealthy;
        "GDB_FraktalHal".Data.PressDemo.TwoHand.LeftPressed := "GDB_PressDemoIO".TwoHandLeft;
        "GDB_FraktalHal".Data.PressDemo.TwoHand.RightPressed := "GDB_PressDemoIO".TwoHandRight;
        "GDB_FraktalHal".Data.PressDemo.TwoHand.SafeActive := "GDB_PressDemoIO".TwoHandSafeActive;
        "GDB_FraktalHal".Data.PressDemo.TwoHand.FieldbusHealthy := "GDB_PressDemoIO".StandardIoHealthy;
        "GDB_FraktalHal".Data.PressDemo.PressRam.FeedbackExtended := "GDB_PressDemoIO".RamExtended;
        "GDB_FraktalHal".Data.PressDemo.PressRam.FeedbackRetracted := "GDB_PressDemoIO".RamRetracted;
        "GDB_FraktalHal".Data.PressDemo.Door.FeedbackExtended := "GDB_PressDemoIO".DoorClosed;
        "GDB_FraktalHal".Data.PressDemo.Door.FeedbackRetracted := "GDB_PressDemoIO".DoorOpen;
        "GDB_FraktalHal".Data.PressDemo.PartSlide.FeedbackExtended := "GDB_PressDemoIO".SlideInside;
        "GDB_FraktalHal".Data.PressDemo.PartSlide.FeedbackRetracted := "GDB_PressDemoIO".SlideOutside;
    ELSIF #USE_SIMULATION THEN
        // Never energize a physical output during virtual commissioning; the
        // plant model reads the coils from the HAL on the next input read.
        "GDB_PressDemoIO".RamExtend := FALSE;
        "GDB_PressDemoIO".RamRetract := FALSE;
        "GDB_PressDemoIO".DoorClose := FALSE;
        "GDB_PressDemoIO".DoorRelease := FALSE;
        "GDB_PressDemoIO".SlideExtend := FALSE;
        "GDB_PressDemoIO".SlideRetract := FALSE;
        "GDB_PressDemoIO".StartLamp := FALSE;
    ELSE
        "GDB_PressDemoIO".RamExtend := "GDB_FraktalHal".Data.PressDemo.PressRam.CoilExtend;
        "GDB_PressDemoIO".RamRetract := "GDB_FraktalHal".Data.PressDemo.PressRam.CoilRetract;
        "GDB_PressDemoIO".DoorClose := "GDB_FraktalHal".Data.PressDemo.Door.CoilExtend;
        "GDB_PressDemoIO".DoorRelease := "GDB_FraktalHal".Data.PressDemo.Door.CoilRetract;
        "GDB_PressDemoIO".SlideExtend := "GDB_FraktalHal".Data.PressDemo.PartSlide.CoilExtend;
        "GDB_PressDemoIO".SlideRetract := "GDB_FraktalHal".Data.PressDemo.PartSlide.CoilRetract;
        "GDB_PressDemoIO".StartLamp := "PressDemo".OutImm.TwoHandStartReady;
    END_IF;
END_FUNCTION_BLOCK

DATA_BLOCK "GDB_PressDemoHardwareDriver"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_PressDemoHardwareDriver"
BEGIN
END_DATA_BLOCK

FUNCTION "F_PressDemoReadInputs" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
    "GDB_PressIoBridgeClient"();
    "GDB_PressDemoHardwareDriver"(ReadInputs := TRUE);
END_FUNCTION

FUNCTION "F_PressDemoWriteOutputs" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
BEGIN
    "GDB_PressDemoHardwareDriver"(ReadInputs := FALSE);
END_FUNCTION
