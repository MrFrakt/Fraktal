DATA_BLOCK "GDB_PressDemoIO"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// Demo logical I/O boundary. Bind these symbols to the commissioned hardware
// when a bench is available; feedback is never synthesized on that path.
   VAR 
      PartPresent : Bool;
      PartQuality : Bool;
      AirLowPressure : Bool;
      AirOperatingPressure : Bool;
      TwoHandLeft : Bool;
      TwoHandRight : Bool;
      TwoHandSafeActive : Bool;
      StandardIoHealthy : Bool;
      RamExtended : Bool;
      RamRetracted : Bool;
      DoorClosed : Bool;
      DoorOpen : Bool;
      SlideInside : Bool;
      SlideOutside : Bool;
      RamExtend : Bool;
      RamRetract : Bool;
      DoorClose : Bool;
      DoorRelease : Bool;
      SlideExtend : Bool;
      SlideRetract : Bool;
      StartLamp : Bool;
   END_VAR


BEGIN

END_DATA_BLOCK

