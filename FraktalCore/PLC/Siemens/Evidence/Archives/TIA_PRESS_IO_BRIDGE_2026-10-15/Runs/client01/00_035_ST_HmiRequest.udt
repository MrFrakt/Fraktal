TYPE "ST_HmiRequest"
VERSION : 0.1
   STRUCT
      "Kind" : DInt;
      "TargetPath" : WString[255];
      "NameValue" : String[160];
      "TextValue" : WString[255];
      "User" : String[32];
      "Secret" : String[32];
      "IntValue" : DInt;
      "BoolValue" : Bool;
      "DurationMs" : UDInt;
      "Sequence" : UDInt;
   END_STRUCT;
END_TYPE
