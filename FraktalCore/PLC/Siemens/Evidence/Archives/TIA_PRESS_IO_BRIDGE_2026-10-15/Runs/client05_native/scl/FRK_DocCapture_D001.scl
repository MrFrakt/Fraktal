FUNCTION "FRK_DocCapture_D001" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
      Targets : Array[1..1] of Int;
      Prior : Int;
      Reserved : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D001 := FALSE;
	"FRK_PersistImages".D001.SchemaVersion := 1;
	"FRK_PersistImages".D001.Scope := 'PressDemo';
	"FRK_PersistImages".D001.Kind := 1;
	"FRK_PersistImages".D001.ModelCode := '';
	"FRK_PersistImages".D001.ActiveModel := "FRK_ConfigStore".ActiveModels[1];
	"FRK_PersistImages".D001.Count := 1;
	#Stored := "FRK_ConfigFind"(Scope := 'PressDemo', Key := 'requireTwoHandStart', ModelCode := '');
	IF #Stored = 0 THEN
	    RETURN;
	END_IF;
	"FRK_PersistImages".D001.Rows[1] := "FRK_ConfigStore".Rows[#Stored];
	FOR #Index := 0 TO 775 DO
	    "FRK_PersistBuffers".D001Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D001, DEST_ARRAY => "FRK_PersistBuffers".D001Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 776 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D001 := TRUE;
	
END_FUNCTION

