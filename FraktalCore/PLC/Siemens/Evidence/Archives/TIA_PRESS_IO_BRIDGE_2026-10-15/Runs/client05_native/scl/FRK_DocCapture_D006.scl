FUNCTION "FRK_DocCapture_D006" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D006 := FALSE;
	"FRK_PersistImages".D006.SchemaVersion := 1;
	"FRK_PersistImages".D006.Scope := 'PressDemo';
	"FRK_PersistImages".D006.Ordinal := 1;
	"FRK_PersistImages".D006.Payload := "FRK_SetStore".Sets[1, 1];
	FOR #Index := 0 TO 1589 DO
	    "FRK_PersistBuffers".D006Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D006, DEST_ARRAY => "FRK_PersistBuffers".D006Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 1590 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D006 := TRUE;
	
END_FUNCTION

