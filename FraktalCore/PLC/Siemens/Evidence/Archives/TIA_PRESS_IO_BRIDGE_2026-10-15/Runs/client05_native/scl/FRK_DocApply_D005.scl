FUNCTION "FRK_DocApply_D005" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocApply_D005 := FALSE;
	#Position := 24;
	#NativeResult := Deserialize(SRC_ARRAY := "FRK_PersistBuffers".D005Data, DEST_VARIABLE => "FRK_PersistImages".D005, POS := #Position);
	IF #NativeResult <> 0 OR #Position <> 24 + UDINT_TO_DINT("FRK_PersistConsumers".Rows[5].Result.Length) THEN
	    RETURN;
	END_IF;
	IF "FRK_PersistImages".D005.SchemaVersion <> 1 OR "FRK_PersistImages".D005.Scope <> 'PressDemo' THEN
	    RETURN;
	END_IF;
	IF "FRK_PersistImages".D005.Image.Scope <> 'PressDemo' OR NOT "FRK_AccessPolicyValid"(Image := "FRK_PersistImages".D005.Image) THEN
	    RETURN;
	END_IF;
	"FRK_AccessPolicies".Rows[1] := "FRK_PersistImages".D005.Image;
	#FRK_DocApply_D005 := TRUE;
	
END_FUNCTION

