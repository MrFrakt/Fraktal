TYPE "ST_ModuleStatus"
VERSION : 0.1
   STRUCT
      "Name" : String[80];
      DisplayNameKey : String[160];
      DescriptionKey : String[160];
      TypeKey : String[160];
      ModuleType : DInt;
      State : DInt;
      FaultActive : Bool;
      Diagnostic : "ST_Diagnostic";
      TileEnable : Bool := TRUE;
      ControlDomainId : String[80];
   END_STRUCT;

END_TYPE

