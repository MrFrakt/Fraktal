	        #Profiler.StatsTruncated := "FRK_Profiles".P013.Book.StatsTruncated;
	        #Profiler.LastCycleTime := "FRK_Profiles".P013.Book.LastCycleTime;
	        #Profiler.MinCycleTime := "FRK_Profiles".P013.Book.MinCycleTime;
	        #Profiler.History := "FRK_Profiles".P013.History;
	        #Profiler.HistoryHead := "FRK_Profiles".P013.Book.Head;
	    ELSE
	        RETURN;
	END_CASE;
	#Starved := #Core.Exec = 1 AND #Unit.Mode = 0 AND #CurrentStep.TimeClass = 1;
	#Blocked := #Core.Exec = 1 AND #Unit.Mode = 0 AND #CurrentStep.TimeClass = 2;
	"FRK_DecisionCyclic"(Owner := #Core.RegIndex,
	                     Busy := #Core.Exec = 1,
	                     Reset := #Startup OR #Unit.EvReset OR #Core.EvModeChanged,
	                     AlarmLog := #AlarmLog);
	"FRK_DecisionPublish"(Owner := #Core.RegIndex,
	                      Decision := #Decision,
	                      DecisionAnswer := #DecisionAnswer);
	IF NOT #Unit.EvReset THEN
	    "FRK_AlarmCapture"(AlarmLog := #AlarmLog,
	                       Core := #Core,
	                       Status := #Status);
	    "FRK_Capture_DeclarationCell"(Module := #Cell,
	                                  AlarmLog := #AlarmLog);
	    "FRK_AlarmEnd"(AlarmLog := #AlarmLog);
	END_IF;
	IF #Core.RegIndex > 0 THEN
	    "FRK_Registry".Rows[#Core.RegIndex].AlarmBlocking := #AlarmLog.Blocking;
	END_IF;
	#Unit.AlarmBlocking := "FRK_AlarmTreeBlocking"(Owner := #Core.RegIndex) OR "FRK_AlarmRecoveryTreeBlocking"(Scope := #Status.Name);
	"FRK_AccessPersist"(Access := #Access,
	                    Unit := #Unit,
	                    Response := #HmiResponse,
	                    SourcePath := STRING_TO_WSTRING(#Status.Name),
	                    AlarmLog := #AlarmLog);
	"FRK_AccessFinish"(Access := #Access,
	                   Unit := #Unit,
	                   Response := #HmiResponse,
	                   SourcePath := STRING_TO_WSTRING(#Status.Name),
	                   AlarmLog := #AlarmLog,
	                   Revision := #ConfigRev);
	"FRK_UnitFinish"(Core := #Core,
	                 Unit := #Unit,
	                 Response := #HmiResponse,
	                 Status := #Status,
	                 Part := #Part,
	                 AlarmLog := #AlarmLog,
	                 History := #History,
	                 Head := #HistoryHead);
	#ModeActivePublished := #Unit.Mode;
	#RunningPublished := #Core.Exec = 1;
	#StopPendingPublished := #Unit.StopReq AND #Core.Exec = 1;
	#GoodCount := #Unit.Good;
	#NokCount := #Unit.Nok;
	#ReworkCount := #Unit.Rework;
	#NokReason := #Unit.NokReason;
	// ---- AUTHORED: unconditional cyclic/derived data
	"FRK_CyclicHook_DeclarationUnit"(Device := #Device,
	                                 Hal := #Hal,
	                                 OutImm := #OutImm,
	                                 StateFlagCount := #StateFlagCount,
	                                 StateFlags := #StateFlags,
	                                 StateTouched := #StateTouched);
	// ---- GENERATED: diagnostic snapshot
	"FRK_DiagSync"(Index := #Core.RegIndex,
	               Withdraw := FALSE,
	               Status := #Status,
	               Held := #Core.Held,
	               Timeout := #ParCfg.Timeout,
	               ActiveTimeoutMs := #Core.TimeoutMs);
	// ---- GENERATED: frame end
	
END_FUNCTION_BLOCK

