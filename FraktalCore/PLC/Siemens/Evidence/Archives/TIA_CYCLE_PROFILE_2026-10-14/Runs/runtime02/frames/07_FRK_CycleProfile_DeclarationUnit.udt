TYPE "FRK_CycleProfile_DeclarationUnit"
VERSION : 0.1
   STRUCT
      "CycleNo" : UDInt;
      "Started" : LDT;
      "StartedTimeSynchronized" : Bool;
      "Total" : Time;
      "WorkTime" : Time;
      "WaitTime" : Time;
      "ByClass" : Array[0..4] of Time;
      "NSteps" : Int;
      "Truncated" : Bool;
      "Steps" : Array[1..4] of "ST_StepTiming";
   END_STRUCT;
END_TYPE
