FUNCTION_BLOCK "FB_PressDemoHardwareDriver"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      ReadInputs { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
   END_VAR


BEGIN
	
	IF #ReadInputs THEN
	    "GDB_FraktalHal".Data.PressDemo.Process.PartPresent := "GDB_PressDemoIO".PartPresent;
	    "GDB_FraktalHal".Data.PressDemo.Process.PartQuality := "GDB_PressDemoIO".PartQuality;
	    "GDB_FraktalHal".Data.PressDemo.Process.AirPressureOk := "GDB_PressDemoIO".AirPressureOk;
	    "GDB_FraktalHal".Data.PressDemo.Process.TwoHandHeld := "GDB_PressDemoIO".TwoHandHeld;
	    "GDB_FraktalHal".Data.PressDemo.Process.StartPulse := "GDB_PressDemoIO".StartPulse;
	    "GDB_FraktalHal".Data.PressDemo.PressRam.FeedbackExtended := "GDB_PressDemoIO".RamExtended;
	    "GDB_FraktalHal".Data.PressDemo.PressRam.FeedbackRetracted := "GDB_PressDemoIO".RamRetracted;
	    "GDB_FraktalHal".Data.PressDemo.Door.FeedbackExtended := "GDB_PressDemoIO".DoorClosed;
	    "GDB_FraktalHal".Data.PressDemo.Door.FeedbackRetracted := "GDB_PressDemoIO".DoorOpen;
	    "GDB_FraktalHal".Data.PressDemo.PartSlide.FeedbackExtended := "GDB_PressDemoIO".SlideInside;
	    "GDB_FraktalHal".Data.PressDemo.PartSlide.FeedbackRetracted := "GDB_PressDemoIO".SlideOutside;
	ELSE
	    "GDB_PressDemoIO".RamExtend := "GDB_FraktalHal".Data.PressDemo.PressRam.CoilExtend;
	    "GDB_PressDemoIO".RamRetract := "GDB_FraktalHal".Data.PressDemo.PressRam.CoilRetract;
	    "GDB_PressDemoIO".DoorClose := "GDB_FraktalHal".Data.PressDemo.Door.CoilExtend;
	    "GDB_PressDemoIO".DoorRelease := "GDB_FraktalHal".Data.PressDemo.Door.CoilRetract;
	    "GDB_PressDemoIO".SlideExtend := "GDB_FraktalHal".Data.PressDemo.PartSlide.CoilExtend;
	    "GDB_PressDemoIO".SlideRetract := "GDB_FraktalHal".Data.PressDemo.PartSlide.CoilRetract;
	END_IF;
	
END_FUNCTION_BLOCK

