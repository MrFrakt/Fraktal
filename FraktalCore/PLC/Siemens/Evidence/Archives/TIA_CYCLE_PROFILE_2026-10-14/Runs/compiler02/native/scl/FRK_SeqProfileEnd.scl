FUNCTION "FRK_SeqProfileEnd" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Owner : DInt;
      StepNo : DInt;
      Expected : Time;
      NowMs : UDInt;
   END_VAR


BEGIN
	
	CASE #Owner OF
	    1:
	        "FRK_ProfileEnd"(StepNo := #StepNo,
	                         Expected := #Expected,
	                         NowMs := #NowMs,
	                         Book := "FRK_Profiles".P001.Book,
	                         Steps := "FRK_Profiles".P001.Steps,
	                         LastSteps := "FRK_Profiles".P001.LastSteps,
	                         Stats := "FRK_Profiles".P001.Stats,
	                         History := "FRK_Profiles".P001.History);
	    5:
	        "FRK_ProfileEnd"(StepNo := #StepNo,
	                         Expected := #Expected,
	                         NowMs := #NowMs,
	                         Book := "FRK_Profiles".P005.Book,
	                         Steps := "FRK_Profiles".P005.Steps,
	                         LastSteps := "FRK_Profiles".P005.LastSteps,
	                         Stats := "FRK_Profiles".P005.Stats,
	                         History := "FRK_Profiles".P005.History);
	    9:
	        "FRK_ProfileEnd"(StepNo := #StepNo,
	                         Expected := #Expected,
	                         NowMs := #NowMs,
	                         Book := "FRK_Profiles".P009.Book,
	                         Steps := "FRK_Profiles".P009.Steps,
	                         LastSteps := "FRK_Profiles".P009.LastSteps,
	                         Stats := "FRK_Profiles".P009.Stats,
	                         History := "FRK_Profiles".P009.History);
	    13:
	        "FRK_ProfileEnd"(StepNo := #StepNo,
	                         Expected := #Expected,
	                         NowMs := #NowMs,
	                         Book := "FRK_Profiles".P013.Book,
	                         Steps := "FRK_Profiles".P013.Steps,
	                         LastSteps := "FRK_Profiles".P013.LastSteps,
	                         Stats := "FRK_Profiles".P013.Stats,
	                         History := "FRK_Profiles".P013.History);
	    17:
	        "FRK_ProfileEnd"(StepNo := #StepNo,
	                         Expected := #Expected,
	                         NowMs := #NowMs,
	                         Book := "FRK_Profiles".P017.Book,
	                         Steps := "FRK_Profiles".P017.Steps,
	                         LastSteps := "FRK_Profiles".P017.LastSteps,
	                         Stats := "FRK_Profiles".P017.Stats,
	                         History := "FRK_Profiles".P017.History);
	    21:
	        "FRK_ProfileEnd"(StepNo := #StepNo,
	                         Expected := #Expected,
	                         NowMs := #NowMs,
	                         Book := "FRK_Profiles".P021.Book,
	                         Steps := "FRK_Profiles".P021.Steps,
	                         LastSteps := "FRK_Profiles".P021.LastSteps,
	                         Stats := "FRK_Profiles".P021.Stats,
	                         History := "FRK_Profiles".P021.History);
	    ELSE
	        RETURN;
	END_CASE;
	
END_FUNCTION

