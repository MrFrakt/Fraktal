TYPE "ST_UnitProbeStationCfg"
VERSION : 0.1
   STRUCT
      SchemaVersion : UInt := 3;
      SiteLabel : String[80] := 'bench';
      Enabled : Bool := TRUE;
      Ratio : LReal := 1.25;
      Gain : Real := 2.5;
      Grade : DInt := 1;
      Offsets : Array[-1..1] of Int;
      Small : USInt := 7;
      LongText : String[80] := 'long default';
   END_STRUCT;

END_TYPE

