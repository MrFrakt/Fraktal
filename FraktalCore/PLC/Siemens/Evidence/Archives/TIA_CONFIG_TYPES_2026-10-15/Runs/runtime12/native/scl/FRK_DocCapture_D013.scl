FUNCTION "FRK_DocCapture_D013" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D013 := FALSE;
	"FRK_PersistImages".D013.SchemaVersion := 1;
	"FRK_PersistImages".D013.Scope := 'StationB';
	"FRK_PersistImages".D013.Ordinal := 1;
	"FRK_PersistImages".D013.Payload := "FRK_SetStore".Sets[2, 1];
	FOR #Index := 0 TO 11579 DO
	    "FRK_PersistBuffers".D013Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D013, DEST_ARRAY => "FRK_PersistBuffers".D013Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 11580 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D013 := TRUE;
	
END_FUNCTION

