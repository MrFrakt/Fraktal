FUNCTION "FRK_DocCapture_D007" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D007 := FALSE;
	"FRK_PersistImages".D007.SchemaVersion := 1;
	"FRK_PersistImages".D007.Scope := 'StationA';
	"FRK_PersistImages".D007.Ordinal := 3;
	"FRK_PersistImages".D007.Payload := "FRK_SetStore".Sets[1, 3];
	FOR #Index := 0 TO 11579 DO
	    "FRK_PersistBuffers".D007Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D007, DEST_ARRAY => "FRK_PersistBuffers".D007Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 11580 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D007 := TRUE;
	
END_FUNCTION

