FUNCTION "F_PressDemoClearStart" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Complete : Bool;
   END_VAR

   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
   END_VAR


BEGIN
	
	IF #Complete THEN
	    "FRK_SeqCycleEnd"(Seq := #Seq);
	END_IF;
	
END_FUNCTION

