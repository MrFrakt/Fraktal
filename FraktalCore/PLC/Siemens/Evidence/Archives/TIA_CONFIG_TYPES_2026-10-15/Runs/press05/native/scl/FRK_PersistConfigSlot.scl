FUNCTION "FRK_PersistConfigSlot" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Scope : String;
      ModelCode : String;
      Kind : DInt;
   END_VAR


BEGIN
	
	#FRK_PersistConfigSlot := 0;
	IF #Scope = 'PressDemo' AND #ModelCode = '' AND #Kind = 1 THEN
	    #FRK_PersistConfigSlot := 1;
	    RETURN;
	END_IF;
	IF #Scope = 'PressDemo' AND #ModelCode = '' AND #Kind = 1 THEN
	    #FRK_PersistConfigSlot := 1;
	    RETURN;
	END_IF;
	IF #Scope = 'PressDemo' AND #ModelCode = '' AND #Kind = 1 THEN
	    #FRK_PersistConfigSlot := 1;
	    RETURN;
	END_IF;
	
END_FUNCTION

