FUNCTION "FRK_ManualFinish" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Core : "FRK_Core";
   END_VAR

   VAR_IN_OUT 
      Execute : Bool;
      ManualOwned : Bool;
   END_VAR


BEGIN
	
	IF #ManualOwned AND #Core.Exec <> 1 THEN
	    #Execute := FALSE;
	    #ManualOwned := FALSE;
	END_IF;
	
END_FUNCTION

