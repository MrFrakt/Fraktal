    END_IF;
    "FRK_CyclicHook_DeclarationCell"(Device := #Module.Device, OutImm := #Module.OutImm);
    "FRK_Quiesce_DeclarationCylinder"(Module := #Module.Clamp, Hal := #Hal.Clamp);
    "FRK_Quiesce_DeclarationCylinder"(Module := #Module.Gate, Hal := #Hal.Gate);
END_FUNCTION
