FUNCTION "FRK_Elapsed" : UDInt
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      NewMs : UDInt;
      OldMs : UDInt;
   END_VAR

   VAR_TEMP 
      Wide : ULInt;
   END_VAR


BEGIN
	
	IF #NewMs >= #OldMs THEN
	    #Wide := UDINT_TO_ULINT(#NewMs) - UDINT_TO_ULINT(#OldMs);
	ELSE
	    #Wide := ULINT#4294967296 + UDINT_TO_ULINT(#NewMs) - UDINT_TO_ULINT(#OldMs);
	END_IF;
	#FRK_Elapsed := ULINT_TO_UDINT(#Wide);
	
END_FUNCTION

