FUNCTION "FRK_ConfigDecimalText" : WString
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Number : LReal;
   END_VAR

   VAR_TEMP 
      Position : UInt;
      Converted : WString[80];
      Valid : Bool;
      Decoded : "FRK_ConfigValue";
   END_VAR


BEGIN
	
	#FRK_ConfigDecimalText := WSTRING#'';
	#Converted := WSTRING#'';
	#Position := 1;
	// Scientific notation with seventeen significant digits. Refuse a value
	// if the platform cannot represent it as an exactly reversible document.
	VAL_STRG(IN := #Number,
	         SIZE := USINT#0,
	         PREC := USINT#16,
	         FORMAT := WORD#16#0002,
	         P := #Position,
	         OUT => #Converted,
	         ENO => #Valid);
	IF NOT #Valid THEN
	    RETURN;
	END_IF;
	#Valid := "FRK_ConfigDecode"(Text := #Converted, Storage := 6,
	                             Minimum := LREAL#-1.7976931348623157E+308, Maximum := LREAL#1.7976931348623157E+308,
	                             MaxLength := 0, Value := #Decoded);
	IF #Valid AND #Decoded.Decimal = #Number THEN
	    #FRK_ConfigDecimalText := #Converted;
	END_IF;
	
END_FUNCTION

