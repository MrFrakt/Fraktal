FUNCTION "FRK_SetResult" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Request : "ST_HmiRequest";
      Response : "ST_HmiResponse";
      Scope : String;
      RootIndex : Int;
   END_VAR

   VAR_IN_OUT 
      Persist : "ST_ConfigPersistStatus";
      AlarmLog : "FRK_AlarmLog";
   END_VAR

   VAR_TEMP 
      Diag : "ST_Diagnostic";
      Slot : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	IF #Request.Kind <> 29 THEN
	    RETURN;
	END_IF;
	IF NOT #Response.Accepted THEN
	    #Persist.LastRejectScope := "FRK_SetRuntime".Work[#RootIndex].RejectScope;
	    #Persist.LastRejectKey := "FRK_SetRuntime".Work[#RootIndex].RejectKey;
	END_IF;
	#Diag := "FRK_UnitScratch".EmptyDiagnostic;
	#Diag.SourcePath := STRING_TO_WSTRING(#Scope);
	IF #Response.Accepted THEN
	    #Diag.ReasonCode := 2043;
	    #Diag.Description := WSTRING#'std.event.configSetApplied';
	ELSE
	    #Diag.ReasonCode := 2042;
	    #Diag.Description := WSTRING#'std.error.configSetRejected';
	    #Diag.SourcePath := STRING_TO_WSTRING(#Persist.LastRejectScope);
	END_IF;
	#Slot := "FRK_AlarmRaise"(AlarmLog := #AlarmLog, Diag := #Diag, ResetClass := 0);
	IF #Slot > 0 THEN
	    #Ok := "FRK_AlarmGone"(AlarmLog := #AlarmLog, Slot := #Slot);
	END_IF;
	
END_FUNCTION

