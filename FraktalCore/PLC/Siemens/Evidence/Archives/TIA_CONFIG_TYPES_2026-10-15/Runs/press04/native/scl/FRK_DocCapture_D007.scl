FUNCTION "FRK_DocCapture_D007" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Length : DInt;
   END_VAR

   VAR_TEMP 
      Index : Int;
      Stored : Int;
      Position : DInt;
      NativeResult : Int;
      Ok : Bool;
   END_VAR


BEGIN
	
	#FRK_DocCapture_D007 := FALSE;
	"FRK_PersistImages".D007.SchemaVersion := 1;
	"FRK_PersistImages".D007.Scope := 'users';
	IF NOT "FRK_AccessStorage".UsersReady THEN
	    RETURN;
	END_IF;
	"FRK_PersistImages".D007.Generation := "FRK_LocalUsers".Generation;
	"FRK_PersistImages".D007.Count := "FRK_LocalUsers".Count;
	"FRK_PersistImages".D007.Rows := "FRK_LocalUsers".Rows;
	"FRK_PersistImages".D007.Checksum := "FRK_LocalUsers".Checksum;
	FOR #Index := 0 TO 8727 DO
	    "FRK_PersistBuffers".D007Data[#Index] := BYTE#0;
	END_FOR;
	#Position := 24;
	#NativeResult := Serialize(SRC_VARIABLE := "FRK_PersistImages".D007, DEST_ARRAY => "FRK_PersistBuffers".D007Data, POS := #Position);
	IF #NativeResult <> 0 OR #Position < 24 OR #Position > 8728 THEN
	    RETURN;
	END_IF;
	#Length := #Position - 24;
	#FRK_DocCapture_D007 := TRUE;
	
END_FUNCTION

