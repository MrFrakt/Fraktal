    IF "FRK_ConfigRuntime".Unavailable THEN "FRK_ConfigRuntime".Failed[#RootIndex] := TRUE; "FRK_SetRuntime".Work[#RootIndex].Importing := FALSE; "FRK_SetRuntime".Work[#RootIndex].Exporting := FALSE; "FRK_SetRuntime".Work[#RootIndex].Piece := WSTRING#''; RETURN; END_IF;
    #Ready := #Core.Exec = 0 AND NOT #Unit.ModePending AND NOT #Unit.Clearing AND "FRK_DescendantsReady"(OwnerIndex := #Core.RegIndex);
    #SetName := WSTRING_TO_STRING(#Request.TextValue);
