    IF #Request.Kind <> 32 THEN "FRK_SetRuntime".Work[#RootIndex].Exporting := FALSE; END_IF;
    IF #Request.Kind <> 28 AND #Request.Kind <> 29 AND #Request.Kind <> 30 AND #Request.Kind <> 32 AND #Request.Kind <> 33 AND #Request.Kind <> 35 THEN RETURN; END_IF;
