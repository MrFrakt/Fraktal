                "FRK_SetRuntime".Work[#RootIndex].NextLine := 0; "FRK_SetRuntime".Work[#RootIndex].Exporting := TRUE;
            END_IF;
            IF NOT "FRK_SetRuntime".Work[#RootIndex].Exporting OR #SetName <> "FRK_SetRuntime".Work[#RootIndex].Payload.Info.SetName OR #Request.IntValue <> "FRK_SetRuntime".Work[#RootIndex].NextLine OR #Request.IntValue > "FRK_SetRuntime".Work[#RootIndex].Payload.Info.RecordCount THEN "FRK_SetRuntime".Work[#RootIndex].Exporting := FALSE; RETURN; END_IF;
            #Ok := "FRK_SetShape"(RootIndex := #RootIndex, RootIdentity := #Status.Name);
