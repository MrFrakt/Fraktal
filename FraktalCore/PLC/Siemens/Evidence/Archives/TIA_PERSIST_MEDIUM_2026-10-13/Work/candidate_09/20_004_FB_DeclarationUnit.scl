            IF #Request.NameValue <> '' OR #Request.IntValue < 0 THEN RETURN; END_IF;
            IF #Request.IntValue = 0 THEN
                #Slot := "FRK_SetFind"(RootIndex := #RootIndex, SetName := #SetName); IF #Slot = 0 THEN RETURN; END_IF;
