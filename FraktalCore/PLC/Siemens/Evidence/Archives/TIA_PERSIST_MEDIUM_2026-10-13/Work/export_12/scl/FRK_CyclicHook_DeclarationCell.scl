FUNCTION "FRK_CyclicHook_DeclarationCell" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Device : "ST_DeclarationOutImm";
      OutImm : "ST_DeclarationOutImm";
   END_VAR


BEGIN
	
	#Device.Sample := #Device.Sample + 1;
	#OutImm := #Device;
	
END_FUNCTION

