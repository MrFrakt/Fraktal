                    #Result := READ_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_Load_D017B".Bytes, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_PersistBuffers".D017A);
                END_IF;
            ELSE
                IF "GDB_PersistenceTest".Bank = 1 THEN
                    #Result := WRIT_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_PersistBuffers".D017A, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_Load_D017A".Bytes);
                ELSE
                    #Result := WRIT_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_PersistBuffers".D017A, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_Load_D017B".Bytes);
                END_IF;
            END_IF;
            IF "GDB_PersistenceTest".Step = 1 AND NOT "GDB_PersistenceTest".Busy AND #Result = 0 THEN "FRK_PersistBuffers".D017A["GDB_PersistenceTest".Offset] := "GDB_PersistenceTest".ByteValue; END_IF;
        ELSE "GDB_PersistenceTest".Step := 0; RETURN;
    END_CASE;
    "GDB_PersistenceTest".Pulse := FALSE;
    "GDB_PersistenceTest".NativeStatus := INT_TO_WORD(#Result);
    IF "GDB_PersistenceTest".Busy THEN RETURN; END_IF;
    IF #Result <> 0 THEN "GDB_PersistenceTest".Step := 0; "GDB_PersistenceTest".Done := TRUE; "GDB_PersistenceTest".Operation := 0; RETURN; END_IF;
    IF "GDB_PersistenceTest".Step = 1 THEN "GDB_PersistenceTest".Step := 2; "GDB_PersistenceTest".Pulse := TRUE;
    ELSE "GDB_PersistenceTest".Step := 0; "GDB_PersistenceTest".Applied := TRUE; "GDB_PersistenceTest".Done := TRUE; "GDB_PersistenceTest".Operation := 0; END_IF;
END_FUNCTION
