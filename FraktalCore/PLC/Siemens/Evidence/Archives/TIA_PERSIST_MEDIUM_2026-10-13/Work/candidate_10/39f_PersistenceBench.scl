FUNCTION "F_PersistenceBench" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_TEMP
    Slot : Int;
    Index : Int;
    Result : Int;
END_VAR
BEGIN
    "FRK_PersistRuntime".Unavailable := "GDB_PersistenceTest".Unavailable;
    IF "GDB_PersistenceTest".Operation <> 0 AND "GDB_PersistenceTest".Step = 0 THEN
        "GDB_PersistenceTest".Applied := FALSE; "GDB_PersistenceTest".Done := FALSE;
        #Slot := "GDB_PersistenceTest".Slot;
        IF #Slot < 1 OR #Slot > 17 THEN "GDB_PersistenceTest".Operation := 0; RETURN; END_IF;
        IF "FRK_PersistRuntime".Leased[#Slot] THEN RETURN; END_IF;
        CASE "GDB_PersistenceTest".Operation OF
            1:
                IF "GDB_PersistenceTest".Offset < 0 OR "GDB_PersistenceTest".Offset >= "FRK_PersistRuntime".Capacity[#Slot] + 24 THEN "GDB_PersistenceTest".Operation := 0; RETURN; END_IF;
                IF "GDB_PersistenceTest".Bank <> 1 AND "GDB_PersistenceTest".Bank <> 2 THEN "GDB_PersistenceTest".Operation := 0; RETURN; END_IF;
                "GDB_PersistenceTest".Step := 1; "GDB_PersistenceTest".Pulse := TRUE;
            2:
                IF "FRK_PersistAnchors".SelectedB[#Slot] THEN "FRK_PersistAnchors".RowsB[#Slot].Checksum := "FRK_PersistAnchors".RowsB[#Slot].Checksum XOR DWORD#1;
                ELSE "FRK_PersistAnchors".RowsA[#Slot].Checksum := "FRK_PersistAnchors".RowsA[#Slot].Checksum XOR DWORD#1; END_IF;
                "GDB_PersistenceTest".Applied := TRUE; "GDB_PersistenceTest".Done := TRUE; "GDB_PersistenceTest".Operation := 0;
            3:
                // Deliberately poison retained caches: subsequent boot must read the selected medium.
                FOR #Index := 1 TO 114 DO "FRK_ConfigStore".Rows[#Index].Record.ValueText := 'poison-cache'; END_FOR;
                "FRK_LocalUsers".Checksum := DWORD#0;
                "GDB_PersistenceTest".Applied := TRUE; "GDB_PersistenceTest".Done := TRUE; "GDB_PersistenceTest".Operation := 0;
            ELSE "GDB_PersistenceTest".Operation := 0;
        END_CASE;
    END_IF;
    IF "GDB_PersistenceTest".Step = 0 THEN RETURN; END_IF;
    #Slot := "GDB_PersistenceTest".Slot;
    CASE #Slot OF
        1:
            IF "GDB_PersistenceTest".Step = 1 THEN
                IF "GDB_PersistenceTest".Bank = 1 THEN
                    #Result := READ_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_Load_D001A".Bytes, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_PersistBuffers".D001A);
                ELSE
                    #Result := READ_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_Load_D001B".Bytes, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_PersistBuffers".D001A);
                END_IF;
            ELSE
                IF "GDB_PersistenceTest".Bank = 1 THEN
                    #Result := WRIT_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_PersistBuffers".D001A, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_Load_D001A".Bytes);
                ELSE
                    #Result := WRIT_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_PersistBuffers".D001A, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_Load_D001B".Bytes);
                END_IF;
            END_IF;
            IF "GDB_PersistenceTest".Step = 1 AND NOT "GDB_PersistenceTest".Busy AND #Result = 0 THEN "FRK_PersistBuffers".D001A["GDB_PersistenceTest".Offset] := "GDB_PersistenceTest".ByteValue; END_IF;
        2:
            IF "GDB_PersistenceTest".Step = 1 THEN
                IF "GDB_PersistenceTest".Bank = 1 THEN
                    #Result := READ_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_Load_D002A".Bytes, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_PersistBuffers".D002A);
