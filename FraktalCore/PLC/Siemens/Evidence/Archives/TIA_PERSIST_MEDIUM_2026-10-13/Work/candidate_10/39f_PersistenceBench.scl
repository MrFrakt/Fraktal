                    #Result := WRIT_DBL(REQ := "GDB_PersistenceTest".Pulse, SRCBLK := "FRK_PersistBuffers".D002A, BUSY => "GDB_PersistenceTest".Busy, DSTBLK => "FRK_Load_D002A".Bytes);
