FUNCTION "FRK_PersistVirginConfig" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Scope : String;
      ModelCode : String;
      Kind : DInt;
   END_VAR

   VAR_TEMP 
      Slot : Int;
   END_VAR


BEGIN
	
	#FRK_PersistVirginConfig := FALSE;
	#Slot := "FRK_PersistConfigSlot"(Scope := #Scope, ModelCode := #ModelCode, Kind := #Kind);
	IF #Slot > 0 THEN
	    #FRK_PersistVirginConfig := "FRK_PersistConsumers".Rows[#Slot].Virgin;
	END_IF;
	
END_FUNCTION

