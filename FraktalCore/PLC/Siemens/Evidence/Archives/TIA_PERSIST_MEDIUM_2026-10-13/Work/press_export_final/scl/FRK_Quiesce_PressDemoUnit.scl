FUNCTION "FRK_Quiesce_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Module : "FB_PressDemoUnit";
      Hal : "ST_PressDemoUnitHal";
   END_VAR

   VAR_TEMP 
      WasBusy : Bool;
   END_VAR


BEGIN
	
	#Module.Execute := FALSE;
	#Module.Abort := FALSE;
	#WasBusy := #Module.Core.Exec = 1;
	"FRK_RouteAbort"(Abort := TRUE,
	                 Core := #Module.Core);
	IF #Module.Core.RegIndex > 0 THEN
	    "FRK_End"(Core := #Module.Core,
	              Status := #Module.Status,
	              Busy => #Module.Busy,
	              Done => #Module.Done,
	              Error => #Module.Error,
	              Aborted => #Module.Aborted,
	              Held => #Module.Held,
	              ErrorID => #Module.ErrorID,
	              Timing => #Module.Timing);
	END_IF;
	"FRK_AccessDropSession"(Access := #Module.Access);
	"FRK_AccessCancel"(Access := #Module.Access);
	#Module.RunningPublished := FALSE;
	"FRK_CyclicHook_PressDemoUnit"(Door := #Module.Door,
	                               OutImm := #Module.OutImm,
	                               PartSlide := #Module.PartSlide,
	                               PressRam := #Module.PressRam,
	                               StateFlagCount := #Module.StateFlagCount,
	                               StateFlags := #Module.StateFlags,
	                               StateTouched := #Module.StateTouched);
	"FRK_Quiesce_CylinderCM"(Module := #Module.PressRam,
	                         Hal := #Hal.PressRam);
	"FRK_Quiesce_CylinderCM"(Module := #Module.Door,
	                         Hal := #Hal.Door);
	"FRK_Quiesce_CylinderCM"(Module := #Module.PartSlide,
	                         Hal := #Hal.PartSlide);
	
END_FUNCTION

