FUNCTION "FRK_CyclicHook_SatelliteUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Device : "ST_UnitProbeDevice";
      Hal : "ST_SatelliteUnitHal";
      OutImm : "ST_UnitProbeImm";
      StateFlagCount : Int;
      StateFlags : Array[1..12] of "ST_StateFlag";
      StateTouched : Array[1..12] of Bool;
   END_VAR


BEGIN
	
	#OutImm.Cycles := #Device.Cycles;
	#OutImm.ExitCalls := #Device.ExitCalls;
	#OutImm.Changes := #Device.Changes;
	#OutImm.Resets := #Device.Resets;
	#OutImm.AtHome := "FRK_State"(Idx := 1, Key := 'project.state.atHome', Ok := #Hal.Cell.Clamp.Sample = 0, Flags := #StateFlags, Count := #StateFlagCount, Touched := #StateTouched);
	
END_FUNCTION

