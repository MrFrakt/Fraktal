	            #HmiResponse.Diagnostic := WSTRING#'std.audit.manualCommandAccepted';
	        ELSE
	            #HmiResponse.Diagnostic := WSTRING#'std.audit.manualCommandRejected';
	        END_IF;
	    END_IF;
