	                  Status := #Status,
	                  Policy := #ModePolicy,
	                  Access := #Access,
	                  Request := #HmiRequest,
	                  Response := #HmiResponse,
	                  Supported := #SupportedModesPublished);
	#Unit.ConfigBlocked := #Access.PolicyLost;
	// ---- GENERATED: begin
	"FRK_Begin"(Core := #Core,
	            Status := #Status,
	            Execute := #Unit.RunReq,
	            Abort := (#Abort OR #Unit.AbortReq),
	            Command := 1);
	IF #Core.EvCommandStart THEN
	    #LatchedParCmd := #ParCmd;
	    CASE #Core.Command OF
	        1:
	            "FRK_UnitRunStart"(Core := #Core,
	                               Status := #Status,
	                               Timeout := #ParCfg.Timeout,
	                               Label := 'Run');
	        ELSE
	            "FRK_Start"(Core := #Core,
	                        Status := #Status,
	                        Supported := FALSE,
	                        Timeout := T#0ms,
	                        Label := '');
	    END_CASE;
	END_IF;
	IF #Core.EvCommandStart THEN
	    // ---- AUTHORED: CommandStart
	    #Device.Received := "FRK_PartReceived"(Core := #Core, Unit := #Unit, Status := #Status, Part := #Part, AlarmLog := #AlarmLog);
	    IF #Device.Received THEN
	        "FRK_PartStarted"(Unit := #Unit,
	                          Status := #Status,
	                          Part := #Part,
	                          AlarmLog := #AlarmLog);
	    END_IF;
	    // ---- GENERATED: reaction end
	END_IF;
	// ---- AUTHORED: cyclic management
	IF #Hal.Cell.Clamp.BackgroundFault THEN
	    "FRK_Fault"(Core := #Core,
	                Status := #Status,
	                ReasonCode := 2901,
	                Description := WSTRING#'test.unit.condition');
	END_IF;
	// ---- GENERATED: end management
	"FRK_Release_SatelliteUnit"(Unit := #Unit,
	                            Hal := #Hal);
	IF #Core.RegIndex > 0 THEN
	    "FRK_Registry".Rows[#Core.RegIndex].AlarmBlocking := #AlarmLog.Blocking;
	END_IF;
	#Unit.AlarmBlocking := "FRK_AlarmTreeBlocking"(Owner := #Core.RegIndex) OR "FRK_AlarmRecoveryTreeBlocking"(Scope := #Status.Name);
	"FRK_UnitConsume"(Core := #Core,
