	"FRK_AlarmHistoryBoot"(AlarmLog := #AlarmLog,
	                       Startup := #Startup,
	                       Scope := #Status.Name);
	"FRK_AlarmRecoveryBoot"(AlarmLog := #AlarmLog,
	                        Startup := #Startup,
	                        Scope := #Status.Name);
	"FRK_AlarmRecoveryTick"(AlarmLog := #AlarmLog);
	"FRK_AccessPolicyBoot"(Access := #Access,
	                       Startup := #Startup,
	                       Root := #Core.ParentIndex = 0,
