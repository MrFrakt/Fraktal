// Canonical retained-image CRC primitives, shared by typed consumers.
FUNCTION "FRK_CrcByte" : DWord
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Previous : DWord;
    Value : Byte;
END_VAR
VAR_TEMP
    BitIndex : Int;
    Work : DWord;
END_VAR
BEGIN
    #Work := #Previous XOR BYTE_TO_DWORD(#Value);
    FOR #BitIndex := 0 TO 7 DO
        IF (#Work AND DWORD#1) <> 0 THEN #Work := SHR(IN := #Work, N := 1) XOR DWORD#16#@CRC_POLYNOMIAL@;
        ELSE #Work := SHR(IN := #Work, N := 1); END_IF;
    END_FOR;
    #FRK_CrcByte := #Work;
END_FUNCTION

FUNCTION "FRK_CrcNumber" : DWord
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Previous : DWord;
    Value : UDInt;
END_VAR
VAR_TEMP
    Index : Int;
    Work : DWord;
END_VAR
BEGIN
    #Work := #Previous;
    FOR #Index := 0 TO 3 DO
        #Work := "FRK_CrcByte"(Previous := #Work, Value := DWORD_TO_BYTE(SHR(IN := UDINT_TO_DWORD(#Value), N := INT_TO_UINT(#Index * 8))));
    END_FOR;
    #FRK_CrcNumber := #Work;
END_FUNCTION

