FUNCTION "F_CylinderExtendHandled" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// The step deliberately owns a failure branch. The shared command service
// still verifies ownership; the original child first-out is retained verbatim.
   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
      Target : "FB_CylinderCM";
   END_VAR


BEGIN
	
	#F_CylinderExtendHandled := "FRK_SeqCommand"(Seq := #Seq, Lease := #Target.Device.Lease,
	                                             Execute := #Target.Execute, Command := #Target.Command, Value := 1,
	                                             Label := 'Cylinder.EXTEND', Ready := #Target.Status.State = 0,
	                                             Done := #Target.Done, Error := #Target.Error, OwnFailure := TRUE, Diagnostic := #Target.Status.Diagnostic);
	
END_FUNCTION

