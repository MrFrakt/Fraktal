    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := '') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultStationCfg.TransferSettleTime));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh THEN
            #Ok := FALSE;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := '');
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageStationCfg.TransferSettleTime := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
    END_IF;
    "FRK_CfgDef_PressDemoUnit"(FieldIndex := 3);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := '') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultStationCfg.PressSettleTime));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh THEN
            #Ok := FALSE;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := '');
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageStationCfg.PressSettleTime := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
    END_IF;
    IF #Ok THEN
        #StationCfg := #ConfigStageStationCfg;
    ELSE
        #StationCfg := #ConfigDefaultStationCfg;
        "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 1);
    IF #ConfigDefaultStationCfg.RequireTwoHandStart THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true'; ELSE "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false'; END_IF;
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 2);
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultStationCfg.TransferSettleTime));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 3);
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultStationCfg.PressSettleTime));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
    END_IF;
END_FUNCTION
FUNCTION "FRK_Config_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Access : "FRK_Access";
    RootIndex : Int;
    ModelIndex : UDInt;
END_VAR
VAR_IN_OUT
    Status : "ST_ModuleStatus";
    ModePolicy : Array[0..6] of "ST_ModePolicy";
    AvailableModelCount : Int;
    StationCfg : "ST_PressDemoStationCfg";
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
    Cursor : "FRK_ConfigCursor";
    Page : "ST_ConfigPage";
END_VAR
VAR_TEMP
    Ok : Bool;
END_VAR
BEGIN
    IF #ModelIndex = 0 THEN
        "FRK_ConfigUnit"(Scope := #Status.Name, Policy := #ModePolicy, ModelCount := #AvailableModelCount, ReadLevel := #Access.Policy.Required[0], Readable := #Access.CurrentLevel >= #Access.Policy.Required[0], Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 1);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    IF #StationCfg.RequireTwoHandStart THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true'; ELSE "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false'; END_IF;
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 2);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#StationCfg.TransferSettleTime));
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 3);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#StationCfg.PressSettleTime));
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN "FRK_Config_CylinderCM"(Module := #PressRam, Access := #Access, RootIndex := #RootIndex, ModelIndex := #ModelIndex, Cursor := #Cursor, Page := #Page); END_IF;
    IF #ModelIndex = 0 THEN "FRK_Config_CylinderCM"(Module := #Door, Access := #Access, RootIndex := #RootIndex, ModelIndex := #ModelIndex, Cursor := #Cursor, Page := #Page); END_IF;
    IF #ModelIndex = 0 THEN "FRK_Config_CylinderCM"(Module := #PartSlide, Access := #Access, RootIndex := #RootIndex, ModelIndex := #ModelIndex, Cursor := #Cursor, Page := #Page); END_IF;
END_FUNCTION
FUNCTION "FRK_CfgWrite_PressDemoUnit" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Request : "ST_HmiRequest";
    Access : "FRK_Access";
    RootIndex : Int;
    RootReady : Bool;
END_VAR
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
    StationCfg : "ST_PressDemoStationCfg";
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
    Matched : Bool;
END_VAR
VAR_TEMP
    Ok : Bool;
    Level : DInt;
    Code : String[64];
    Inactive : Bool;
END_VAR
BEGIN
    #FRK_CfgWrite_PressDemoUnit := FALSE;
    IF #Request.TargetPath = STRING_TO_WSTRING(#Status.Name) OR (#Request.TargetPath = WSTRING#'' AND #Core.ParentIndex = 0) THEN
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 1);
        IF #Request.NameValue = "FRK_ConfigScratch".Entry.WriteKey THEN
            #Matched := TRUE;
            IF DINT_TO_UDINT(#Request.IntValue) <> "FRK_ConfigScratch".Entry.WriteRevision THEN RETURN; END_IF;
            #Level := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
            IF #Access.CurrentLevel < #Level THEN RETURN; END_IF;
            IF #Request.DurationMs <> 0 THEN RETURN; END_IF;
            #Code := '';
            #Inactive := FALSE;
            IF "FRK_ConfigScratch".Entry.RequiresReady AND NOT #Inactive AND NOT #RootReady THEN RETURN; END_IF;
            #Ok := "FRK_ConfigDecode"(Text := #Request.TextValue, Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum, Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength, Value := "FRK_ConfigScratch".Value);
            IF NOT #Ok THEN RETURN; END_IF;
            #Ok := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := #Code, Text := #Request.TextValue, RootIndex := #RootIndex);
            IF NOT #Ok THEN RETURN; END_IF;
            IF NOT #Inactive THEN
    #StationCfg.RequireTwoHandStart := "FRK_ConfigScratch".Value.Flag;
            END_IF;
            #FRK_CfgWrite_PressDemoUnit := TRUE;
            RETURN;
        END_IF;
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 2);
        IF #Request.NameValue = "FRK_ConfigScratch".Entry.WriteKey THEN
            #Matched := TRUE;
            IF DINT_TO_UDINT(#Request.IntValue) <> "FRK_ConfigScratch".Entry.WriteRevision THEN RETURN; END_IF;
            #Level := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
            IF #Access.CurrentLevel < #Level THEN RETURN; END_IF;
            IF #Request.DurationMs <> 0 THEN RETURN; END_IF;
            #Code := '';
            #Inactive := FALSE;
            IF "FRK_ConfigScratch".Entry.RequiresReady AND NOT #Inactive AND NOT #RootReady THEN RETURN; END_IF;
            #Ok := "FRK_ConfigDecode"(Text := #Request.TextValue, Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum, Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength, Value := "FRK_ConfigScratch".Value);
            IF NOT #Ok THEN RETURN; END_IF;
            #Ok := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := #Code, Text := #Request.TextValue, RootIndex := #RootIndex);
            IF NOT #Ok THEN RETURN; END_IF;
            IF NOT #Inactive THEN
    #StationCfg.TransferSettleTime := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
            END_IF;
            #FRK_CfgWrite_PressDemoUnit := TRUE;
            RETURN;
        END_IF;
        "FRK_CfgDef_PressDemoUnit"(FieldIndex := 3);
        IF #Request.NameValue = "FRK_ConfigScratch".Entry.WriteKey THEN
            #Matched := TRUE;
            IF DINT_TO_UDINT(#Request.IntValue) <> "FRK_ConfigScratch".Entry.WriteRevision THEN RETURN; END_IF;
            #Level := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
            IF #Access.CurrentLevel < #Level THEN RETURN; END_IF;
            IF #Request.DurationMs <> 0 THEN RETURN; END_IF;
            #Code := '';
            #Inactive := FALSE;
            IF "FRK_ConfigScratch".Entry.RequiresReady AND NOT #Inactive AND NOT #RootReady THEN RETURN; END_IF;
            #Ok := "FRK_ConfigDecode"(Text := #Request.TextValue, Storage := "FRK_ConfigScratch".Storage, Minimum := "FRK_ConfigScratch".Minimum, Maximum := "FRK_ConfigScratch".Maximum, MaxLength := "FRK_ConfigScratch".MaxLength, Value := "FRK_ConfigScratch".Value);
            IF NOT #Ok THEN RETURN; END_IF;
            #Ok := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := #Code, Text := #Request.TextValue, RootIndex := #RootIndex);
            IF NOT #Ok THEN RETURN; END_IF;
            IF NOT #Inactive THEN
    #StationCfg.PressSettleTime := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
            END_IF;
            #FRK_CfgWrite_PressDemoUnit := TRUE;
            RETURN;
        END_IF;
    END_IF;
    #Ok := "FRK_CfgWrite_CylinderCM"(Module := #PressRam, Access := #Access, Request := #Request, RootIndex := #RootIndex, RootReady := #RootReady, Matched := #Matched);
    IF #Matched THEN #FRK_CfgWrite_PressDemoUnit := #Ok; RETURN; END_IF;
    #Ok := "FRK_CfgWrite_CylinderCM"(Module := #Door, Access := #Access, Request := #Request, RootIndex := #RootIndex, RootReady := #RootReady, Matched := #Matched);
    IF #Matched THEN #FRK_CfgWrite_PressDemoUnit := #Ok; RETURN; END_IF;
    #Ok := "FRK_CfgWrite_CylinderCM"(Module := #PartSlide, Access := #Access, Request := #Request, RootIndex := #RootIndex, RootReady := #RootReady, Matched := #Matched);
    IF #Matched THEN #FRK_CfgWrite_PressDemoUnit := #Ok; RETURN; END_IF;
END_FUNCTION
FUNCTION "FRK_CfgRecipe_PressDemoUnit" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    ModelCode : String;
    Phase : Int;
END_VAR
VAR_IN_OUT
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
    RejectScope : String;
    RejectKey : String;
END_VAR
VAR_TEMP
    Ok : Bool;
END_VAR
BEGIN
    #FRK_CfgRecipe_PressDemoUnit := TRUE;
    #Ok := "FRK_CfgRecipe_CylinderCM"(Module := #PressRam, ModelCode := #ModelCode, Phase := #Phase, RejectScope := #RejectScope, RejectKey := #RejectKey);
    IF NOT #Ok THEN #FRK_CfgRecipe_PressDemoUnit := FALSE; RETURN; END_IF;
    #Ok := "FRK_CfgRecipe_CylinderCM"(Module := #Door, ModelCode := #ModelCode, Phase := #Phase, RejectScope := #RejectScope, RejectKey := #RejectKey);
    IF NOT #Ok THEN #FRK_CfgRecipe_PressDemoUnit := FALSE; RETURN; END_IF;
    #Ok := "FRK_CfgRecipe_CylinderCM"(Module := #PartSlide, ModelCode := #ModelCode, Phase := #Phase, RejectScope := #RejectScope, RejectKey := #RejectKey);
    IF NOT #Ok THEN #FRK_CfgRecipe_PressDemoUnit := FALSE; RETURN; END_IF;
END_FUNCTION
FUNCTION "FRK_CfgOperation_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
    ModePolicy : Array[0..6] of "ST_ModePolicy";
    Access : "FRK_Access";
    Unit : "FRK_Unit";
    HmiResponse : "ST_HmiResponse";
    ConfigPersist : "ST_ConfigPersistStatus";
    ConfigCursor : "FRK_ConfigCursor";
    ConfigRev : UDInt;
    ModelId : "ST_ModelId";
    AvailableModelCount : Int;
    StationCfg : "ST_PressDemoStationCfg";
    PressRam : "FB_CylinderCM";
    Door : "FB_CylinderCM";
    PartSlide : "FB_CylinderCM";
END_VAR
VAR_TEMP
    RootIndex : Int;
    Request : "ST_HmiRequest";
    Ready : Bool;
    Matched : Bool;
    Ok : Bool;
    Desired : String[64];
    Scope : String[80];
    Key : String[160];
END_VAR
BEGIN
    #RootIndex := "FRK_ConfigRoot"(RegIndex := #Core.RegIndex);
    IF #Core.ParentIndex <> 0 OR #RootIndex = 0 THEN RETURN; END_IF;
    #ModelId.ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex];
    IF NOT #Unit.RequestPending THEN RETURN; END_IF;
    #Request := #Unit.Request;
    #Ready := #Core.Exec = 0 AND NOT #Unit.ModePending AND NOT #Unit.Clearing AND "FRK_DescendantsReady"(OwnerIndex := #Core.RegIndex);
    CASE #Request.Kind OF
        23:
            "FRK_ConfigBegin"(Cursor := #ConfigCursor, Page := #HmiResponse.ConfigPage, PageIndex := #Request.IntValue, Revision := #ConfigRev);
            #HmiResponse.Accepted := FALSE;
            #HmiResponse.Diagnostic := WSTRING#'std.error.modelNotAvailable';
            IF #Request.DurationMs <= 0 AND #Request.IntValue >= 0 AND #Request.IntValue <= 32767 THEN
                "FRK_Config_PressDemoUnit"(Status := #Status, ModePolicy := #ModePolicy, AvailableModelCount := #AvailableModelCount, StationCfg := #StationCfg, PressRam := #PressRam, Door := #Door, PartSlide := #PartSlide, Access := #Access, RootIndex := #RootIndex, ModelIndex := #Request.DurationMs, Cursor := #ConfigCursor, Page := #HmiResponse.ConfigPage);
                "FRK_ConfigFinish"(Cursor := #ConfigCursor, Page := #HmiResponse.ConfigPage);
                #HmiResponse.Accepted := TRUE; #HmiResponse.Diagnostic := WSTRING#'';
            END_IF;
        19:
            #HmiResponse.Accepted := FALSE;
            #HmiResponse.Diagnostic := WSTRING#'std.error.hmiRequestRejected';
            #ConfigPersist.LastRejectScope := #Status.Name;
            #ConfigPersist.LastRejectKey := #Request.NameValue;
            IF #Request.DurationMs <= 0 THEN
                #Matched := FALSE;
                #HmiResponse.Accepted := "FRK_CfgWrite_PressDemoUnit"(Core := #Core, Status := #Status, StationCfg := #StationCfg, PressRam := #PressRam, Door := #Door, PartSlide := #PartSlide, Access := #Access, Request := #Request, RootIndex := #RootIndex, RootReady := #Ready, Matched := #Matched);
            END_IF;
            IF #HmiResponse.Accepted THEN
                #ConfigRev := "FRK_ConfigRevision"(Previous := #ConfigRev);
                #HmiResponse.Diagnostic := WSTRING#'';
                #ConfigPersist.LastRejectScope := ''; #ConfigPersist.LastRejectKey := '';
            END_IF;
        31:
            #HmiResponse.Accepted := #Access.CurrentLevel >= 3;
            IF #HmiResponse.Accepted THEN "FRK_ConfigStore".Acknowledged[#RootIndex] := TRUE;
            ELSE #HmiResponse.Diagnostic := WSTRING#'std.error.configRestoreAckRefused'; END_IF;
        ELSE RETURN;
    END_CASE;
END_FUNCTION
