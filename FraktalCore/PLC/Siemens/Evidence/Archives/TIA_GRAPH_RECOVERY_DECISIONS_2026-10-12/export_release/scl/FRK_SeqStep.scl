FUNCTION "FRK_SeqStep" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      StepNo : DInt;
      StepName : String;
   END_VAR

   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
      Row : "FRK_SequenceRow";
   END_VAR


BEGIN
	
	IF #Seq.RecordedStep <> #StepNo THEN
	    #Seq.Visit := #Seq.Visit + 1;
	    #Seq.Elapsed := T#0ms;
	    #Seq.DelayElapsed := T#0ms;
	    #Seq.RecordedStep := #StepNo;
	    #Seq.Warned := FALSE;
	END_IF;
	#Seq.Step := #StepNo;
	#Seq.StepName := #StepName;
	#Row.StepNo := #StepNo;
	#Row.Visited := TRUE;
	#Row.LastDuration := #Seq.Elapsed;
	
END_FUNCTION

