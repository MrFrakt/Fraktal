	#Hal.PressRam.RetractPermit := #Hal.Process.AirPressureOk;
	#Hal.PressRam.PermitDiagnostic := "FRK_UnitScratch".EmptyDiagnostic;
	#Hal.PressRam.PermitDiagnostic.Description := STRING_TO_WSTRING(#Release.RamExtend.Blocker);
