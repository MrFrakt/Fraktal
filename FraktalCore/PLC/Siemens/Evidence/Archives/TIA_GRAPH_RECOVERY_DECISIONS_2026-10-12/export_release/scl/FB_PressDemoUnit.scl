	         RamHealthy := NOT #PressRam.Error AND NOT #PressRam.Aborted,
	         DoorHealthy := NOT #Door.Error AND NOT #Door.Aborted,
	         SlideHealthy := NOT #PartSlide.Error AND NOT #PartSlide.Aborted,
	         TwoHandHeld := #Hal.Process.TwoHandHeld OR NOT #StationCfg.RequireTwoHandStart);
