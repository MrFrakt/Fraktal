	                 Policy := #ModePolicy,
	                 Access := #Access,
	                 Supported := #SupportedModesPublished);
	IF #Unit.RequestPending AND (#Unit.Request.Kind = 11 OR #Unit.Request.Kind = 16) THEN
	    #ManualMatched := FALSE;
	    #RouteMatched := "FRK_Route_CylinderCM"(Module := #PressRam, Hal := #Hal.PressRam, Request := #Unit.Request, Report := #HmiResponse.Report);
	    #ManualMatched := #ManualMatched OR #RouteMatched;
	    #RouteMatched := "FRK_Route_CylinderCM"(Module := #Door, Hal := #Hal.Door, Request := #Unit.Request, Report := #HmiResponse.Report);
