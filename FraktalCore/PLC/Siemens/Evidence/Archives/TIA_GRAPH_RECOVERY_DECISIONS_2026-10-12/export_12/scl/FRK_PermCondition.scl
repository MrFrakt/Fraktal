FUNCTION "FRK_PermCondition" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Label : String;
      Ok : Bool;
   END_VAR

   VAR_IN_OUT 
      Perm : "FRK_PermCtx";
   END_VAR


BEGIN
	
	#Perm.Count := #Perm.Count + 1;
	IF NOT #Ok THEN
	    IF #Perm.Permit THEN
	        #Perm.Blocker := #Label;
	    END_IF;
	    #Perm.Permit := FALSE;
	END_IF;
	
END_FUNCTION

