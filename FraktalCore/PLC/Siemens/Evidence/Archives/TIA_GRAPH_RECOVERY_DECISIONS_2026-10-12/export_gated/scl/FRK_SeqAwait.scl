FUNCTION "FRK_SeqAwait" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Label : String;
      Ok : Bool;
   END_VAR

   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
   END_VAR


BEGIN
	
	#FRK_SeqAwait := #Ok;
	IF NOT #Ok AND NOT #Seq.Pending THEN
	    #Seq.Pending := TRUE;
	    #Seq.Awaiting := #Label;
	END_IF;
	
END_FUNCTION

