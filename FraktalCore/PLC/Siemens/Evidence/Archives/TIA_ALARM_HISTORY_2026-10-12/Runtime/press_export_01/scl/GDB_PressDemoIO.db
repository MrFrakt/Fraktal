DATA_BLOCK "GDB_PressDemoIO"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
// Demo logical I/O boundary. Bind these symbols to the commissioned hardware
// driver when a bench is available; feedback is never synthesized here.
   VAR 
      PartPresent : Bool;
      PartQuality : Bool;
      AirPressureOk : Bool;
      TwoHandHeld : Bool;
      StartPulse : Bool;
      RamExtended : Bool;
      RamRetracted : Bool;
      DoorClosed : Bool;
      DoorOpen : Bool;
      SlideInside : Bool;
      SlideOutside : Bool;
      RamExtend : Bool;
      RamRetract : Bool;
      DoorClose : Bool;
      DoorRelease : Bool;
      SlideExtend : Bool;
      SlideRetract : Bool;
   END_VAR


BEGIN

END_DATA_BLOCK

