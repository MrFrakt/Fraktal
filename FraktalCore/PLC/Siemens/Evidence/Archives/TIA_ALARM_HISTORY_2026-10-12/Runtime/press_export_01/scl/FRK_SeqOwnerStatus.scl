FUNCTION "FRK_SeqOwnerStatus" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
      Core : "FRK_Core";
      Status : "ST_ModuleStatus";
   END_VAR


BEGIN
	
	IF #Core.Exec = 3 THEN
	    #Seq.Error := TRUE;
	    #Seq.ErrorDiagnostic := #Status.Diagnostic;
	ELSIF #Seq.Error THEN
	    "FRK_AdoptFault"(Core := #Core,
	                     Status := #Status,
	                     Diag := #Seq.ErrorDiagnostic);
	END_IF;
	
END_FUNCTION

