TYPE "ST_ConfigEntry"
VERSION : 0.1
   STRUCT
      "Scope" : WString[255];
      "Item" : WString[255];
      "ValueText" : WString[255];
      "WriteKey" : String[160];
      "WriteRevision" : UDInt;
      "ConfigKind" : DInt;
      "ValueType" : DInt;
      "Writable" : Bool;
      "RequiresReady" : Bool;
      "HasMinimum" : Bool;
      "HasMaximum" : Bool;
      "Minimum" : LReal;
      "Maximum" : LReal;
      "Unit" : String[16];
      "LabelKey" : String[160];
      "EnumDomain" : WString[255];
      "ClassId" : String[40];
      "ReadLevel" : DInt;
      "WriteLevel" : DInt;
      "Readable" : Bool;
      "UnitCode" : DInt;
      "EnumLabelKey" : String[80];
      "ModelScoped" : Bool;
   END_STRUCT;
END_TYPE
