FUNCTION "FRK_CfgRestore_DeclarationCylinder" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Core : "FRK_Core";
      Status : "ST_ModuleStatus";
      ParCfg : "ST_DeclarationParCfg";
      ConfigStageParCfg : "ST_DeclarationParCfg";
      ConfigDefaultParCfg : "ST_DeclarationParCfg";
   END_VAR

   VAR_TEMP 
      RootIndex : Int;
      Ok : Bool;
      Stored : Bool;
   END_VAR


BEGIN
	
	#RootIndex := "FRK_ConfigRoot"(RegIndex := #Core.RegIndex);
	IF #RootIndex = 0 THEN
	    RETURN;
	END_IF;
	#Ok := TRUE;
	#ConfigStageParCfg := #ConfigDefaultParCfg;
	"FRK_CfgDef_DeclarationCylinder"(FieldIndex := 1);
	IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := 'MODEL_A') = 0 THEN
	    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultParCfg.Timeout));
	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := 'MODEL_A', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
	    IF NOT "FRK_ConfigRuntime".Fresh THEN
	        IF "FRK_ConfigStore".ActiveModels[#RootIndex] = 'MODEL_A' THEN
	            #Ok := FALSE;
	        END_IF;
	        "FRK_ConfigLoss"(RootIndex := #RootIndex,
	                         Scope := #Status.Name);
	    END_IF;
	END_IF;
	IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := 'MODEL_B') = 0 THEN
	    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultParCfg.Timeout));
	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := 'MODEL_B', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
	    IF NOT "FRK_ConfigRuntime".Fresh THEN
	        IF "FRK_ConfigStore".ActiveModels[#RootIndex] = 'MODEL_B' THEN
	            #Ok := FALSE;
	        END_IF;
	        "FRK_ConfigLoss"(RootIndex := #RootIndex,
	                         Scope := #Status.Name);
	    END_IF;
	END_IF;
	#Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex]);
	#Ok := #Ok AND #Stored;
	IF #Stored THEN
	    #ConfigStageParCfg.Timeout := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
	END_IF;
	"FRK_CfgDef_DeclarationCylinder"(FieldIndex := 2);
	IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := 'MODEL_A') = 0 THEN
	    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(#ConfigDefaultParCfg.Preset);
	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := 'MODEL_A', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
	    IF NOT "FRK_ConfigRuntime".Fresh THEN
	        IF "FRK_ConfigStore".ActiveModels[#RootIndex] = 'MODEL_A' THEN
	            #Ok := FALSE;
	        END_IF;
	        "FRK_ConfigLoss"(RootIndex := #RootIndex,
	                         Scope := #Status.Name);
	    END_IF;
	END_IF;
	IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := 'MODEL_B') = 0 THEN
	    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(#ConfigDefaultParCfg.Preset);
	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := 'MODEL_B', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
	    IF NOT "FRK_ConfigRuntime".Fresh THEN
	        IF "FRK_ConfigStore".ActiveModels[#RootIndex] = 'MODEL_B' THEN
	            #Ok := FALSE;
	        END_IF;
	        "FRK_ConfigLoss"(RootIndex := #RootIndex,
	                         Scope := #Status.Name);
	    END_IF;
	END_IF;
	#Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex]);
	#Ok := #Ok AND #Stored;
	IF #Stored THEN
	    #ConfigStageParCfg.Preset := LINT_TO_DINT("FRK_ConfigScratch".Value.Number);
	END_IF;
	IF #Ok THEN
	    #ParCfg := #ConfigStageParCfg;
	ELSE
	    #ParCfg := #ConfigDefaultParCfg;
	    "FRK_ConfigLoss"(RootIndex := #RootIndex,
	                     Scope := #Status.Name);
	    "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 1);
	    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultParCfg.Timeout));
	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex], Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
	    "FRK_CfgDef_DeclarationCylinder"(FieldIndex := 2);
	    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(#ConfigDefaultParCfg.Preset);
	    #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex], Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
	END_IF;
	
END_FUNCTION

