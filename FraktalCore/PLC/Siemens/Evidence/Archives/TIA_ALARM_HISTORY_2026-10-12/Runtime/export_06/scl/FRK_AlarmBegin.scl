FUNCTION "FRK_AlarmBegin" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Startup : Bool;
   END_VAR

   VAR_IN_OUT 
      AlarmLog : "FRK_AlarmLog";
   END_VAR

   VAR_TEMP 
      Index : Int;
   END_VAR


BEGIN
	
	FOR #Index := 1 TO 16 DO
	    #AlarmLog.Touched[#Index] := FALSE;
	    IF #Startup THEN
	        #AlarmLog.Active[#Index] := "FRK_UnitScratch".EmptyEvent;
	        #AlarmLog.Automatic[#Index] := FALSE;
	        #AlarmLog.ComeMs[#Index] := 0;
	    END_IF;
	END_FOR;
	IF #Startup THEN
	    FOR #Index := 1 TO 64 DO
	        #AlarmLog.Ring[#Index] := "FRK_UnitScratch".EmptyEvent;
	    END_FOR;
	    #AlarmLog.RingHead := 0;
	    #AlarmLog.RingUsed := 0;
	    #AlarmLog.Truncated := FALSE;
	END_IF;
	IF #Startup AND #AlarmLog.HistorySlot > 0 THEN "FRK_AlarmHistoryClear"(AlarmLog := #AlarmLog);
	END_IF;
	"FRK_AlarmRefresh"(AlarmLog := #AlarmLog);
	
END_FUNCTION

