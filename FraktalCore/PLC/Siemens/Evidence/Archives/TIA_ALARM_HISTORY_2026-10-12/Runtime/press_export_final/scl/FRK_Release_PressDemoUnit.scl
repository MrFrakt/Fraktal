FUNCTION "FRK_Release_PressDemoUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Unit : "FRK_Unit";
      Hal : "ST_PressDemoUnitHal";
   END_VAR


BEGIN
	
	"FRK_UnitSetPermit"(Unit := #Unit,
	                    Ok := #Hal.Process.AirPressureOk,
	                    Diag := #Hal.Process.PermitDiagnostic);
	
END_FUNCTION

