FUNCTION "FRK_SeqMessage" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Diag : "ST_Diagnostic";
   END_VAR

   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
      AlarmLog : "FRK_AlarmLog";
   END_VAR

   VAR_TEMP 
      Slot : Int;
      Gone : Bool;
   END_VAR


BEGIN
	
	IF #Seq.Warned THEN
	    RETURN;
	END_IF;
	#Slot := "FRK_AlarmRaise"(AlarmLog := #AlarmLog, Diag := #Diag, ResetClass := 0);
	IF #Slot > 0 THEN
	    #Gone := "FRK_AlarmGone"(AlarmLog := #AlarmLog, Slot := #Slot);
	    #Seq.Warned := TRUE;
	END_IF;
	
END_FUNCTION

