TYPE "ST_Diagnostic"
VERSION : 0.1
   STRUCT
      "ReasonCode" : DInt;
      "SourcePath" : WString[255];
      "Description" : WString[255];
      "IoTag" : String[80];
      "IoAddress" : String[80];
      "Severity" : DInt;
      "Category" : DInt;
      "Since" : LDT;
      "TimeSynchronized" : Bool;
   END_STRUCT;
END_TYPE
