DATA_BLOCK "GDB_ConfigTest"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      Unavailable : Bool;
      CorruptPulse : Bool;
      CorruptScope : String[80];
      CorruptKey : String[160];
      CorruptModel : String[64];
      CorruptText : String[80];
      CorruptSchema : UInt;
      CorruptSlot { ExternalWritable := 'False'} : Int;
      ConfiguredPulse : Bool;
   END_VAR
   VAR RETAIN
      BlockRestore : Bool;
   END_VAR


BEGIN

END_DATA_BLOCK

