FUNCTION "F_CylinderRelease" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
      Target : "FB_CylinderCM";
   END_VAR


BEGIN
	
	IF #Target.Device.Lease.Raised AND #Target.Device.Lease.OwnerIndex = #Seq.OwnerIndex
	    AND #Target.Device.Lease.ChainIndex = #Seq.ChainIndex AND #Target.Device.Lease.BranchIndex = #Seq.BranchIndex THEN
	    #Target.Abort := #Target.Busy;
	    #Target.Device.Lease.AbortIssued := #Target.Busy;
	    #Target.Execute := FALSE;
	    #Target.Device.Lease.Raised := FALSE;
	    #Target.Device.Lease.ReleasedScan := #Seq.Scan;
	END_IF;
	
END_FUNCTION

