FUNCTION "F_PressDemoConfirmScrap" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      SourcePath : String;
   END_VAR

   VAR_IN_OUT 
      Seq : "FRK_SequenceCtx";
      AlarmLog : "FRK_AlarmLog";
   END_VAR

   VAR_TEMP 
      Request : "ST_DecisionRequest";
      Asked : Bool;
      Answer : Int;
      Ready : Bool;
   END_VAR


BEGIN
	
	#Request := "FRK_Decisions".EmptyRequest;
	#Request.Prompt := WSTRING#'project.decision.pressNotReached';
	#Request.Options[1] := 'project.decision.confirmScrapAndReturn';
	// Scrap is deliberate: no timeout and no default answer.
	#Asked := "FRK_DecisionAsk"(Owner := #Seq.OwnerIndex, OwnerPath := STRING_TO_WSTRING(#SourcePath), Request := #Request, AlarmLog := #AlarmLog);
	#Answer := 0;
	IF #Asked THEN
	    #Answer := "FRK_DecisionTake"(Owner := #Seq.OwnerIndex, AlarmLog := #AlarmLog);
	END_IF;
	#Ready := "FRK_SeqAwait"(Seq := #Seq, Label := 'project.condition.pressFailureConfirmation', Ok := #Asked AND #Answer = 1);
	#F_PressDemoConfirmScrap := #Ready;
	
END_FUNCTION

