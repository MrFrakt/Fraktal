FUNCTION "FRK_ProfileEnd" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      StepNo : DInt;
      Expected : Time;
      NowMs : UDInt;
   END_VAR

   VAR_IN_OUT 
      Book : "FRK_ProfileBook";
      Steps : Array[*] of "ST_StepTiming";
      LastSteps : Array[*] of "ST_StepTiming";
      Stats : Array[*] of "ST_TimingRow";
      History : Array[*] of "ST_CycleSummary";
   END_VAR


BEGIN
	
	IF #Book.HasOpen AND #Book.OpenNo = #StepNo THEN
	    #Book.OpenExpected := #Expected;
	END_IF;
	IF #Book.CompleteRequested THEN
	    #Book.CompleteRequested := FALSE;
	    "FRK_ProfileComplete"(NowMs := #NowMs,
	                          Book := #Book,
	                          Steps := #Steps,
	                          LastSteps := #LastSteps,
	                          Stats := #Stats,
	                          History := #History);
	END_IF;
	
END_FUNCTION

