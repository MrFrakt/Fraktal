FUNCTION "FRK_SeqProfileComplete" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Owner : DInt;
   END_VAR


BEGIN
	
	CASE #Owner OF
	    1:
	        "FRK_ProfileRequest"(Book := "FRK_Profiles".P001.Book);
	    ELSE
	        RETURN;
	END_CASE;
	
END_FUNCTION

