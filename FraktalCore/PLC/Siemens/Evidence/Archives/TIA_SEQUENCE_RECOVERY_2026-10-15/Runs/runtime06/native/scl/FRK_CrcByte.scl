FUNCTION "FRK_CrcByte" : DWord
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
// Canonical retained-image CRC primitives, shared by typed consumers.
   VAR_INPUT 
      Previous : DWord;
      Value : Byte;
   END_VAR

   VAR_TEMP 
      BitIndex : Int;
      Work : DWord;
   END_VAR


BEGIN
	
	#Work := #Previous XOR BYTE_TO_DWORD(#Value);
	FOR #BitIndex := 0 TO 7 DO
	    IF (#Work AND DWORD#1) <> 0 THEN
	        #Work := SHR(IN := #Work, N := 1) XOR DWORD#16#EDB88320;
	    ELSE
	        #Work := SHR(IN := #Work, N := 1);
	    END_IF;
	END_FOR;
	#FRK_CrcByte := #Work;
	
END_FUNCTION

