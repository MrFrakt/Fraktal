FUNCTION "FRK_DocApply" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Slot : Int;
   END_VAR


BEGIN
	
	#FRK_DocApply := FALSE;
	CASE #Slot OF
	    1:
	        #FRK_DocApply := "FRK_DocApply_D001"();
	    2:
	        #FRK_DocApply := "FRK_DocApply_D002"();
	    3:
	        #FRK_DocApply := "FRK_DocApply_D003"();
	    4:
	        #FRK_DocApply := "FRK_DocApply_D004"();
	    5:
	        #FRK_DocApply := "FRK_DocApply_D005"();
	    6:
	        #FRK_DocApply := "FRK_DocApply_D006"();
	    7:
	        #FRK_DocApply := "FRK_DocApply_D007"();
	    ELSE
	        RETURN;
	END_CASE;
	
END_FUNCTION

