FUNCTION "FRK_SeqLifecycleRead" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Owner : DInt;
   END_VAR

   VAR_IN_OUT 
      Life : "FRK_SequenceLifecycle";
   END_VAR


BEGIN
	
	#Life := "FRK_SequenceOwners".Empty;
	CASE #Owner OF
	    1:
	        #Life := "FRK_SequenceOwners".O001;
	    5:
	        #Life := "FRK_SequenceOwners".O005;
	    9:
	        #Life := "FRK_SequenceOwners".O009;
	    13:
	        #Life := "FRK_SequenceOwners".O013;
	    17:
	        #Life := "FRK_SequenceOwners".O017;
	    21:
	        #Life := "FRK_SequenceOwners".O021;
	    ELSE
	        RETURN;
	END_CASE;
	
END_FUNCTION

