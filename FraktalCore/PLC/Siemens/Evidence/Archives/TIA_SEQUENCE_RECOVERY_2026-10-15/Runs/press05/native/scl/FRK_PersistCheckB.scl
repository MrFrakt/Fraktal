FUNCTION "FRK_PersistCheckB" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      Done : Bool;
   END_VAR


BEGIN
	
	#Done := FALSE;
	#FRK_PersistCheckB := FALSE;
	CASE "FRK_PersistRuntime".Slot OF
	    1:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[1], Bytes := "FRK_PersistBuffers".D001B, Check := "FRK_PersistRuntime".CheckB);
	    2:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[2], Bytes := "FRK_PersistBuffers".D002B, Check := "FRK_PersistRuntime".CheckB);
	    3:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[3], Bytes := "FRK_PersistBuffers".D003B, Check := "FRK_PersistRuntime".CheckB);
	    4:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[4], Bytes := "FRK_PersistBuffers".D004B, Check := "FRK_PersistRuntime".CheckB);
	    5:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[5], Bytes := "FRK_PersistBuffers".D005B, Check := "FRK_PersistRuntime".CheckB);
	    6:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[6], Bytes := "FRK_PersistBuffers".D006B, Check := "FRK_PersistRuntime".CheckB);
	    7:
	        #Done := "FRK_PersistValidate"(ExpectedKey := "FRK_PersistRuntime".KeyCrc[7], Bytes := "FRK_PersistBuffers".D007B, Check := "FRK_PersistRuntime".CheckB);
	    ELSE
	        RETURN;
	END_CASE;
	#FRK_PersistCheckB := #Done;
	
END_FUNCTION

