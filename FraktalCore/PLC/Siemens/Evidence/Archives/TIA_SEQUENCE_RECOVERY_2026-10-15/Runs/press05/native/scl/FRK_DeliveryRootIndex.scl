FUNCTION "FRK_DeliveryRootIndex" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      RootScope : String;
   END_VAR


BEGIN
	
	#FRK_DeliveryRootIndex := 0;
	IF #RootScope = 'PressDemo' THEN
	    #FRK_DeliveryRootIndex := 1;
	    RETURN;
	END_IF;
	
END_FUNCTION

