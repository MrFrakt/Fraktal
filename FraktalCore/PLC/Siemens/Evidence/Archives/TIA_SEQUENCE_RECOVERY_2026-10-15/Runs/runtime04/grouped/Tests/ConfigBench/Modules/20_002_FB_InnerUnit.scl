FUNCTION "FRK_CfgRestore_InnerUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_IN_OUT
    Core : "FRK_Core";
    Status : "ST_ModuleStatus";
    ParCfg : "ST_DeclarationParCfg";
    StationCfg : "ST_UnitProbeStationCfg";
    ConfigStageParCfg : "ST_DeclarationParCfg";
    ConfigDefaultParCfg : "ST_DeclarationParCfg";
    ConfigStageStationCfg : "ST_UnitProbeStationCfg";
    ConfigDefaultStationCfg : "ST_UnitProbeStationCfg";
END_VAR
VAR_TEMP
    RootIndex : Int;
    Ok : Bool;
    Stored : Bool;
END_VAR
BEGIN
    #RootIndex := "FRK_ConfigRoot"(RegIndex := #Core.RegIndex);
    IF #RootIndex = 0 THEN RETURN; END_IF;
    #Ok := TRUE;
    #ConfigStageParCfg := #ConfigDefaultParCfg;
    "FRK_CfgDef_InnerUnit"(FieldIndex := 1);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := 'MODEL_A') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultParCfg.Timeout));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := 'MODEL_A', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := 'MODEL_A', Kind := 0) THEN
            IF "FRK_ConfigStore".ActiveModels[#RootIndex] = 'MODEL_A' THEN #Ok := FALSE; END_IF;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := 'MODEL_B') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultParCfg.Timeout));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := 'MODEL_B', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := 'MODEL_B', Kind := 0) THEN
            IF "FRK_ConfigStore".ActiveModels[#RootIndex] = 'MODEL_B' THEN #Ok := FALSE; END_IF;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex]);
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageParCfg.Timeout := DINT_TO_TIME(LINT_TO_DINT("FRK_ConfigScratch".Value.Number));
    END_IF;
    "FRK_CfgDef_InnerUnit"(FieldIndex := 2);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := 'MODEL_A') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(#ConfigDefaultParCfg.Preset);
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := 'MODEL_A', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := 'MODEL_A', Kind := 0) THEN
            IF "FRK_ConfigStore".ActiveModels[#RootIndex] = 'MODEL_A' THEN #Ok := FALSE; END_IF;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := 'MODEL_B') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(#ConfigDefaultParCfg.Preset);
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := 'MODEL_B', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := 'MODEL_B', Kind := 0) THEN
            IF "FRK_ConfigStore".ActiveModels[#RootIndex] = 'MODEL_B' THEN #Ok := FALSE; END_IF;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex]);
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageParCfg.Preset := LINT_TO_DINT("FRK_ConfigScratch".Value.Number);
    END_IF;
    IF #Ok THEN
        #ParCfg := #ConfigStageParCfg;
    ELSE
        #ParCfg := #ConfigDefaultParCfg;
        "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        "FRK_CfgDef_InnerUnit"(FieldIndex := 1);
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#ConfigDefaultParCfg.Timeout));
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex], Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        "FRK_CfgDef_InnerUnit"(FieldIndex := 2);
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(#ConfigDefaultParCfg.Preset);
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := "FRK_ConfigStore".ActiveModels[#RootIndex], Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
    END_IF;
    #Ok := TRUE;
    #ConfigStageStationCfg := #ConfigDefaultStationCfg;
    "FRK_CfgDef_InnerUnit"(FieldIndex := 3);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := '') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING(#ConfigDefaultStationCfg.SiteLabel);
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := '', Kind := 1) THEN
            #Ok := FALSE;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := '');
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageStationCfg.SiteLabel := "FRK_ConfigScratch".Value.Text;
    END_IF;
    "FRK_CfgDef_InnerUnit"(FieldIndex := 4);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := '') = 0 THEN
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING(#ConfigDefaultStationCfg.LongText);
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := '', Kind := 1) THEN
            #Ok := FALSE;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := '');
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageStationCfg.LongText := "FRK_ConfigScratch".Value.Text;
    END_IF;
    "FRK_CfgDef_InnerUnit"(FieldIndex := 5);
    IF "FRK_ConfigFind"(Scope := #Status.Name, Key := "FRK_ConfigScratch".Entry.WriteKey, ModelCode := '') = 0 THEN
    IF #ConfigDefaultStationCfg.Enabled THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true'; ELSE "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false'; END_IF;
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        IF NOT "FRK_ConfigRuntime".Fresh AND NOT "FRK_PersistVirginConfig"(Scope := #Status.Name, ModelCode := '', Kind := 1) THEN
            #Ok := FALSE;
            "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        END_IF;
    END_IF;
    #Stored := "FRK_ConfigGet"(Scope := #Status.Name, ModelCode := '');
    #Ok := #Ok AND #Stored;
    IF #Stored THEN
    #ConfigStageStationCfg.Enabled := "FRK_ConfigScratch".Value.Flag;
    END_IF;
    IF #Ok THEN
        #StationCfg := #ConfigStageStationCfg;
    ELSE
        #StationCfg := #ConfigDefaultStationCfg;
        "FRK_ConfigLoss"(RootIndex := #RootIndex, Scope := #Status.Name);
        "FRK_CfgDef_InnerUnit"(FieldIndex := 3);
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING(#ConfigDefaultStationCfg.SiteLabel);
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        "FRK_CfgDef_InnerUnit"(FieldIndex := 4);
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING(#ConfigDefaultStationCfg.LongText);
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
        "FRK_CfgDef_InnerUnit"(FieldIndex := 5);
    IF #ConfigDefaultStationCfg.Enabled THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true'; ELSE "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false'; END_IF;
        #Stored := "FRK_ConfigPut"(Scope := #Status.Name, ModelCode := '', Text := "FRK_ConfigScratch".Entry.ValueText, RootIndex := #RootIndex);
    END_IF;
END_FUNCTION
FUNCTION "FRK_Config_InnerUnit" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
