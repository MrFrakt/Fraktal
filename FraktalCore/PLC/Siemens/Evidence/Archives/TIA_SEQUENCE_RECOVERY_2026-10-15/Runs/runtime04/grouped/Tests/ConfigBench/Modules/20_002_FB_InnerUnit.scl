END_VAR
BEGIN
    IF #ModelIndex = 0 THEN
        "FRK_ConfigUnit"(Scope := #Module.Status.Name, Policy := #Module.ModePolicy, ModelCount := 0, ReadLevel := #Access.Policy.Required[0], Readable := #Access.CurrentLevel >= #Access.Policy.Required[0], Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN "FRK_ViewManifest"(Scope := #Module.Status.Name, Defs := #Module.SequenceStepDef, Count := #Module.SequenceStepCount, ReadLevel := #Access.Policy.Required[0], Readable := #Access.CurrentLevel >= #Access.Policy.Required[0], Cursor := #Cursor, Page := #Page); END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_InnerUnit"(FieldIndex := 1);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Module.Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(TIME_TO_DINT(#Module.ParCfg.Timeout));
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_InnerUnit"(FieldIndex := 2);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Module.Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    "FRK_ConfigScratch".Entry.ValueText := DINT_TO_WSTRING(#Module.ParCfg.Preset);
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_InnerUnit"(FieldIndex := 3);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Module.Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING(#Module.StationCfg.SiteLabel);
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_InnerUnit"(FieldIndex := 4);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Module.Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
        "FRK_ConfigScratch".Entry.WriteLevel := MAX(IN1 := #Access.Policy.Required[1], IN2 := "FRK_ConfigScratch".MinWrite);
        "FRK_ConfigScratch".Entry.Readable := #Access.CurrentLevel >= "FRK_ConfigScratch".Entry.ReadLevel;
        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    "FRK_ConfigScratch".Entry.ValueText := STRING_TO_WSTRING(#Module.StationCfg.LongText);
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN
        "FRK_CfgDef_InnerUnit"(FieldIndex := 5);
        "FRK_ConfigScratch".Entry.Scope := STRING_TO_WSTRING(#Module.Status.Name);
        "FRK_ConfigScratch".Entry.ReadLevel := MAX(IN1 := #Access.Policy.Required[0], IN2 := "FRK_ConfigScratch".MinRead);
