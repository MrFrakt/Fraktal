        "FRK_ConfigScratch".Entry.ModelScoped := FALSE;
    IF #Module.StationCfg.Enabled THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#'true'; ELSE "FRK_ConfigScratch".Entry.ValueText := WSTRING#'false'; END_IF;
        IF NOT "FRK_ConfigScratch".Entry.Readable THEN "FRK_ConfigScratch".Entry.ValueText := WSTRING#''; END_IF;
        "FRK_ConfigAppendEntry"(Cursor := #Cursor, Page := #Page);
    END_IF;
    IF #ModelIndex = 0 THEN "FRK_Config_DeclarationCell"(Module := #Module.Cell, Access := #Access, RootIndex := #RootIndex, ModelIndex := #ModelIndex, Cursor := #Cursor, Page := #Page); END_IF;
