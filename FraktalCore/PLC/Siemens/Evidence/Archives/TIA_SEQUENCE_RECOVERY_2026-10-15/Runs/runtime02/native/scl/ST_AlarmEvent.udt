TYPE "ST_AlarmEvent"
VERSION : 0.1
   STRUCT
      ReasonCode : DInt;
      Description : WString[255];
      SourcePath : WString[255];
      IoTag : String[80];
      IoAddress : String[80];
      Severity : DInt;
      Category : DInt;
      ResetClass : DInt;
      State : DInt;
      ComeAt : LDT;
      GoneAt : LDT;
      ResetAt : LDT;
      Duration : Time;
      Shelved : Bool;
      ShelvedUntil : LDT;
      ComeTimeSynchronized : Bool;
      GoneTimeSynchronized : Bool;
      ResetTimeSynchronized : Bool;
      ShelfTimeSynchronized : Bool;
   END_STRUCT;

END_TYPE

