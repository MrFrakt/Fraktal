TYPE "FRK_Core"
VERSION : 0.1
STRUCT
    Named : Bool;
    Initialized : Bool;
    RegIndex : DInt;
    ParentIndex : DInt;
    ModuleType : DInt;
    Exec : DInt;
    Command : DInt;
    ExecPrev : Bool;
    AbortPrev : Bool;
    HoldReason : DInt;
    Dispatch : Bool;
    ReleasePending : Bool;
    EvInit : Bool;
    EvCommandStart : Bool;
    EvAbort : Bool;
    EvAbortInError : Bool;
    EvModeExit : Bool;
    EvModeChanged : Bool;
    Step : DInt;
    HookResult : DInt;
    Timing : "ST_ModuleTiming";
END_STRUCT;
END_TYPE
