FUNCTION "FRK_PartAborted" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Core : "FRK_Core";
      Unit : "FRK_Unit";
      Status : "ST_ModuleStatus";
      Part : "ST_PartContext";
      History : Array[1..16] of "ST_Diagnostic";
      Head : Int;
   END_VAR


BEGIN
	
	IF #Unit.CarrierIndex = 0 OR NOT #Part.Present THEN
	    RETURN;
	END_IF;
	#Part.Result.Verdict := 0;
	IF #Core.Exec = 3 AND #Part.Result.ReasonCode = 0 THEN
	    #Part.Result.ReasonCode := #Status.Diagnostic.ReasonCode;
	END_IF;
	"FRK_PartEvent"(History := #History,
	                Head := #Head,
	                Reason := 2027,
	                Uid := #Part.Uid,
	                SourcePath := #Status.Name);
	#Part.Present := FALSE;
	
END_FUNCTION

