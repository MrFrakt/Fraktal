FUNCTION "FRK_Route_InnerUnit" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
VAR_INPUT
    Request : "ST_HmiRequest";
END_VAR
VAR_IN_OUT
    Module : "FB_InnerUnit";
    Hal : "ST_InnerUnitHal";
    Report : "ST_ReleaseReport";
END_VAR
VAR_TEMP
    RouteMatched : Bool;
    Index : Int;
END_VAR
BEGIN
    #FRK_Route_InnerUnit := FALSE;
    IF NOT "FRK_PathOwned"(OwnerPath := #Module.Status.Name, TargetPath := #Request.TargetPath) THEN RETURN; END_IF;
    "FRK_Release_InnerUnit"(Unit := #Module.Unit, Hal := #Hal);
    "FRK_ManualCommon"(Core := #Module.Core, Unit := #Module.Unit, Status := #Module.Status, Report := #Report);
    IF #Request.TargetPath = STRING_TO_WSTRING(#Module.Status.Name) THEN
        "FRK_ReleaseReason"(Report := #Report, Description := WSTRING#'std.error.unsupportedHmiRequest', Reason := 2008, Path := STRING_TO_WSTRING(#Module.Status.Name), Kind := 4);
        #FRK_Route_InnerUnit := TRUE;
        RETURN;
    END_IF;
    #RouteMatched := "FRK_Route_DeclarationCell"(Module := #Module.Cell, Hal := #Hal.Cell, Request := #Request, Report := #Report);
    #FRK_Route_InnerUnit := #FRK_Route_InnerUnit OR #RouteMatched;
END_FUNCTION
