FUNCTION "FRK_PartEvent" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Reason : DInt;
      Uid : String;
      SourcePath : String;
   END_VAR

   VAR_IN_OUT 
      History : Array[1..16] of "ST_Diagnostic";
      Head : Int;
   END_VAR

   VAR_TEMP 
      Stamp {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      ResultCode : Int;
   END_VAR


BEGIN
	
	IF #Head < 0 OR #Head >= 16 THEN
	    #Head := 0;
	END_IF;
	#Head := #Head + 1;
	#History[#Head].ReasonCode := #Reason;
	#History[#Head].SourcePath := STRING_TO_WSTRING(#SourcePath);
	CASE #Reason OF
	    2024:
	        #History[#Head].Description := WSTRING#'std.event.partReceived: ';
	    2025:
	        #History[#Head].Description := WSTRING#'std.event.partProcessingStarted: ';
	    2026:
	        #History[#Head].Description := WSTRING#'std.event.partProcessed: ';
	    2027:
	        #History[#Head].Description := WSTRING#'std.event.partAborted: ';
	    ELSE
	        #History[#Head].Description := WSTRING#'';
	END_CASE;
	#History[#Head].Description := CONCAT(IN1 := #History[#Head].Description, IN2 := STRING_TO_WSTRING(#Uid));
	#History[#Head].IoTag := '';
	#History[#Head].IoAddress := '';
	#History[#Head].Severity := 0;
	#History[#Head].Category := 0;
	#History[#Head].TimeSynchronized := FALSE;
	#History[#Head].Since := LDT#1970-01-01-00:00:00.000000000;
	#ResultCode := RD_SYS_T(OUT => #Stamp);
	IF #ResultCode = 0 THEN
	    #History[#Head].Since := DTL_TO_LDT(#Stamp);
	END_IF;
	
END_FUNCTION

