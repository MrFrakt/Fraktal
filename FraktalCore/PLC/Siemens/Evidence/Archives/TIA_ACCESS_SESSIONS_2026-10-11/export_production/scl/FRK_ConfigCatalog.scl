FUNCTION "FRK_ConfigCatalog" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Scope : String;
      Count : Int;
      Catalog : Array[1..12] of "ST_CommandInfo";
      ReadLevel : DInt;
      Readable : Bool;
   END_VAR

   VAR_IN_OUT 
      Cursor : "FRK_ConfigCursor";
      Page : "ST_ConfigPage";
   END_VAR

   VAR_TEMP 
      Index : Int;
      IndexText : String[8];
      Prefix : String[254];
      Item : String[254];
   END_VAR


BEGIN
	
	"FRK_ConfigAppend"(Scope := #Scope,
	                   Item := 'CatalogCount',
	                   ValueText := STRING_TO_WSTRING(INT_TO_STRING(#Count)),
	                   ValueType := 0,
	                   ReadLevel := #ReadLevel,
	                   Readable := #Readable,
	                   Cursor := #Cursor,
	                   Page := #Page);
	FOR #Index := 1 TO #Count DO
	    IF #Index > 12 THEN
	        EXIT;
	    END_IF;
	    #IndexText := INT_TO_STRING(#Index);
	    IF #IndexText[1] = '+' THEN
	        #IndexText := DELETE(IN := #IndexText, L := 1, P := 1);
	    END_IF;
	    #Prefix := CONCAT(IN1 := 'Catalog/Catalog[', IN2 := #IndexText);
	    #Prefix := CONCAT(IN1 := #Prefix, IN2 := ']/');
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'Value');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := STRING_TO_WSTRING(DINT_TO_STRING(#Catalog[#Index].Value)),
	                       ValueType := 0,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'Label');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := STRING_TO_WSTRING(#Catalog[#Index].Label),
	                       ValueType := 1,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	    #Item := CONCAT(IN1 := #Prefix, IN2 := 'Style');
	    "FRK_ConfigAppend"(Scope := #Scope,
	                       Item := #Item,
	                       ValueText := STRING_TO_WSTRING(DINT_TO_STRING(#Catalog[#Index].Style)),
	                       ValueType := 0,
	                       ReadLevel := #ReadLevel,
	                       Readable := #Readable,
	                       Cursor := #Cursor,
	                       Page := #Page);
	END_FOR;
	
END_FUNCTION

