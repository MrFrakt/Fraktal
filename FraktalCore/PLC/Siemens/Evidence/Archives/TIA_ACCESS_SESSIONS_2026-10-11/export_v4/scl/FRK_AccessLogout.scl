FUNCTION "FRK_AccessLogout" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_IN_OUT 
      Access : "FRK_Access";
   END_VAR


BEGIN
	
	"FRK_AccessCancel"(Access := #Access);
	#Access.CurrentLevel := 0;
	#Access.CurrentUser := '';
	#Access.LoginFailed := FALSE;
	#Access.SessionGeneration := "FRK_AccessNext"(Previous := #Access.SessionGeneration);
	
END_FUNCTION

