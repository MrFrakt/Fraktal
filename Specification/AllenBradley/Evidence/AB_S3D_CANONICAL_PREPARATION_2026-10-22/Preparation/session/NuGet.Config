<?xml version="1.0" encoding="utf-8"?>
<!--
  The Rockwell C# client is not on nuget.org; it ships inside the Logix
  Designer SDK installation. Its directory contains spaces, which dotnet's
  source flag mangles into a relative path, so the source belongs here in
  configuration rather than on every command line. nuget.org is still needed
  for the client's own transitive dependencies (Grpc, Protobuf, and friends).
-->
<configuration>
  <packageSources>
    <add key="rockwell-logix-designer-sdk" value="C:\Users\Public\Documents\Studio 5000\Logix Designer SDK\dotnet" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
