# HMI ignores are centralized in the repo-root .gitignore (O9: single source).
# This file is intentionally minimal. Do NOT ignore pubspec.lock — the HMI is a
# deployable app and pins its versions there.
#
# Flutter's generated per-platform folders keep their own template .gitignore
# (e.g. windows/.gitignore); those stay local because Flutter regenerates them.
