<Line Number="198"><![CDATA[        FRK_Press_AlarmActive.ActGoneDate[FRK_Press_AlmSlot] := FRK_Press_NowDate;]]></Line>
<Line Number="199"><![CDATA[        FRK_Press_AlarmActive.ActGoneTime[FRK_Press_AlmSlot] := FRK_Press_NowTime;]]></Line>
<Line Number="200"><![CDATA[        FRK_Press_AlarmActive.ActDurationMs[FRK_Press_AlmSlot] := (FRK_Press_ScanCount - FRK_Press_AlarmActive.ActComeScan[FRK_Press_AlmSlot]) * FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="201"><![CDATA[        FRK_Press_AlarmActive.ActState[FRK_Press_AlmSlot] := 2;]]></Line>
