<Line Number="1198"><![CDATA[                FRK_Press_AccessWork.AuditLength := FRK_Press_AccessState.UserLength;]]></Line>
<Line Number="1199"><![CDATA[                FRK_Press_AccessWork.AuditSource := 1;]]></Line>
<Line Number="1200"><![CDATA[                FRK_Press_AccessWork.AuditEventSource := 1;]]></Line>
<Line Number="1201"><![CDATA[                FRK_Press_AccessWork.AuditGate := FRK_Press_AccessWork.Gate;]]></Line>
<Line Number="1202"><![CDATA[                JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="1203"><![CDATA[            END_IF;]]></Line>
<Line Number="1204"><![CDATA[        ELSIF (FRK_Press_HmiRequest.Kind <> 1) AND (FRK_Press_HmiRequest.Kind <> 2) THEN]]></Line>
<Line Number="1205"><![CDATA[            CASE FRK_Press_HmiRequest.Kind OF]]></Line>
<Line Number="1206"><![CDATA[                15, 16, 17, 23, 30, 32, 38:]]></Line>
<Line Number="1207"><![CDATA[                    (* Pure queries do not record operator activity. *)]]></Line>
<Line Number="1208"><![CDATA[                ELSE]]></Line>
<Line Number="1209"><![CDATA[                    IF (FRK_Press_HmiResponse.Accepted <> 0) AND (FRK_Press_AccessState.CurrentLevel > 0) THEN]]></Line>
<Line Number="1210"><![CDATA[                        FRK_Press_AccessWork.IdleMs := 0;]]></Line>
<Line Number="1211"><![CDATA[                        FRK_Press_AccessWork.AuditKey := 661;]]></Line>
<Line Number="1212"><![CDATA[                        FRK_Press_AccessWork.AuditKind := FRK_Press_HmiRequest.Kind;]]></Line>
<Line Number="1213"><![CDATA[                        FRK_Press_AccessWork.AuditSequence := FRK_Press_HmiLastSequence;]]></Line>
<Line Number="1214"><![CDATA[                        FRK_Press_AccessWork.AuditAccepted := 1;]]></Line>
<Line Number="1215"><![CDATA[                        FRK_Press_AccessWork.AuditLength := FRK_Press_AccessState.UserLength;]]></Line>
<Line Number="1216"><![CDATA[                        FRK_Press_AccessWork.AuditSource := 1;]]></Line>
<Line Number="1217"><![CDATA[                        FRK_Press_AccessWork.AuditEventSource := 1;]]></Line>
<Line Number="1218"><![CDATA[                        FRK_Press_AccessWork.AuditGate := FRK_Press_AccessWork.Gate;]]></Line>
<Line Number="1219"><![CDATA[                        JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="1220"><![CDATA[                    END_IF;]]></Line>
<Line Number="1221"><![CDATA[            END_CASE;]]></Line>
<Line Number="1222"><![CDATA[        END_IF;]]></Line>
<Line Number="1223"><![CDATA[    END_IF;]]></Line>
<Line Number="1224"><![CDATA[    JSR(FRK_Press_DataRefreshLevels, 0);]]></Line>
<Line Number="1225"><![CDATA[    (* A refusal that named no reason would be indistinguishable from a]]></Line>
<Line Number="1226"><![CDATA[       command that silently did nothing. *)]]></Line>
<Line Number="1227"><![CDATA[    IF (FRK_Press_HmiResponse.Accepted = 0) AND (FRK_Press_HmiResponse.DiagnosticKey = 0) THEN]]></Line>
<Line Number="1228"><![CDATA[        FRK_Press_HmiResponse.DiagnosticKey := 634;]]></Line>
<Line Number="1229"><![CDATA[    END_IF;]]></Line>
<Line Number="1230"><![CDATA[    (* Wipe the secret, as the oracle does. Clearing LEN alone would leave]]></Line>
<Line Number="1231"><![CDATA[       the characters in DATA for anyone reading the member directly, so]]></Line>
<Line Number="1232"><![CDATA[       the bytes go too. *)]]></Line>
<Line Number="1233"><![CDATA[    FRK_Press_HmiRequest.Secret.LEN := 0;]]></Line>
<Line Number="1234"><![CDATA[    FOR FRK_Press_HmiWipe := 0 TO 31 DO]]></Line>
<Line Number="1235"><![CDATA[        FRK_Press_HmiRequest.Secret.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="1236"><![CDATA[    END_FOR;]]></Line>
<Line Number="1237"><![CDATA[    FRK_Press_HmiResponse.AckSequence := FRK_Press_HmiLastSequence;]]></Line>
<Line Number="1238"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ReleaseStart" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* Core 7.8: why START would be refused right now (TC3's *)]]></Line>
<Line Number="1"><![CDATA[(* ReleaseReportStart), the one rule a START and a physical start read *)]]></Line>
<Line Number="2"><![CDATA[FRK_Press_StartRelease.Count := 0;]]></Line>
<Line Number="3"><![CDATA[FRK_Press_StartRelease.Released := 0;]]></Line>
<Line Number="4"><![CDATA[FRK_Press_AccessWork.Permitted := 0;]]></Line>
<Line Number="5"><![CDATA[IF (5 >= 0) AND (5 < 12) THEN]]></Line>
<Line Number="6"><![CDATA[    IF (FRK_Press_AccessState.CurrentLevel >= 0) AND (FRK_Press_AccessState.CurrentLevel <= 4)]]></Line>
<Line Number="7"><![CDATA[        AND (FRK_Press_AccessState.Required[5] >= 0) AND (FRK_Press_AccessState.Required[5] <= 4)]]></Line>
<Line Number="8"><![CDATA[        AND (FRK_Press_AccessState.CurrentLevel >= FRK_Press_AccessState.Required[5]) THEN]]></Line>
<Line Number="9"><![CDATA[        FRK_Press_AccessWork.Permitted := 1;]]></Line>
<Line Number="10"><![CDATA[    END_IF;]]></Line>
<Line Number="11"><![CDATA[END_IF;]]></Line>
<Line Number="12"><![CDATA[IF FRK_Press_AccessWork.Permitted = 0 THEN]]></Line>
<Line Number="13"><![CDATA[    IF FRK_Press_StartRelease.Count < 8 THEN]]></Line>
<Line Number="14"><![CDATA[        FRK_Press_StartRelease.Key[FRK_Press_StartRelease.Count] := 653;]]></Line>
<Line Number="15"><![CDATA[        (* std.error.accessDenied *)]]></Line>
<Line Number="16"><![CDATA[        FRK_Press_StartRelease.Reason[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="17"><![CDATA[        FRK_Press_StartRelease.Source[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="18"><![CDATA[        FRK_Press_StartRelease.Kind[FRK_Press_StartRelease.Count] := 1;]]></Line>
<Line Number="19"><![CDATA[        FRK_Press_StartRelease.Count := FRK_Press_StartRelease.Count + 1;]]></Line>
<Line Number="20"><![CDATA[    END_IF;]]></Line>
<Line Number="21"><![CDATA[END_IF;]]></Line>
<Line Number="22"><![CDATA[IF FRK_Press_Unit.Mode = 1 THEN]]></Line>
<Line Number="23"><![CDATA[    IF FRK_Press_StartRelease.Count < 8 THEN]]></Line>
<Line Number="24"><![CDATA[        FRK_Press_StartRelease.Key[FRK_Press_StartRelease.Count] := 646;]]></Line>
<Line Number="25"><![CDATA[        (* std.release.manualHasNoAutoSequence *)]]></Line>
<Line Number="26"><![CDATA[        FRK_Press_StartRelease.Reason[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="27"><![CDATA[        FRK_Press_StartRelease.Source[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="28"><![CDATA[        FRK_Press_StartRelease.Kind[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="29"><![CDATA[        FRK_Press_StartRelease.Count := FRK_Press_StartRelease.Count + 1;]]></Line>
<Line Number="30"><![CDATA[    END_IF;]]></Line>
<Line Number="31"><![CDATA[END_IF;]]></Line>
<Line Number="32"><![CDATA[IF (FRK_Press_Unit.Running <> 0) OR (FRK_Press_Unit.Error <> 0) OR (FRK_Press_Unit.Complete <> 0)]]></Line>
<Line Number="33"><![CDATA[    OR (FRK_Press_Unit.Aborted <> 0) THEN]]></Line>
<Line Number="34"><![CDATA[    IF FRK_Press_StartRelease.Count < 8 THEN]]></Line>
<Line Number="35"><![CDATA[        FRK_Press_StartRelease.Key[FRK_Press_StartRelease.Count] := 667;]]></Line>
<Line Number="36"><![CDATA[        (* std.release.unitNotReady *)]]></Line>
<Line Number="37"><![CDATA[        FRK_Press_StartRelease.Reason[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="38"><![CDATA[        FRK_Press_StartRelease.Source[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="39"><![CDATA[        FRK_Press_StartRelease.Kind[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="40"><![CDATA[        FRK_Press_StartRelease.Count := FRK_Press_StartRelease.Count + 1;]]></Line>
<Line Number="41"><![CDATA[    END_IF;]]></Line>
<Line Number="42"><![CDATA[END_IF;]]></Line>
<Line Number="43"><![CDATA[IF FRK_Press_AlarmActive.Blocking <> 0 THEN]]></Line>
<Line Number="44"><![CDATA[    IF FRK_Press_StartRelease.Count < 8 THEN]]></Line>
<Line Number="45"><![CDATA[        FRK_Press_StartRelease.Key[FRK_Press_StartRelease.Count] := 668;]]></Line>
<Line Number="46"><![CDATA[        (* std.release.manualReset *)]]></Line>
<Line Number="47"><![CDATA[        FRK_Press_StartRelease.Reason[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="48"><![CDATA[        FRK_Press_StartRelease.Source[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="49"><![CDATA[        FRK_Press_StartRelease.Kind[FRK_Press_StartRelease.Count] := 2;]]></Line>
<Line Number="50"><![CDATA[        FRK_Press_StartRelease.Count := FRK_Press_StartRelease.Count + 1;]]></Line>
<Line Number="51"><![CDATA[    END_IF;]]></Line>
<Line Number="52"><![CDATA[END_IF;]]></Line>
<Line Number="53"><![CDATA[IF (FRK_T_PressStationCfgTag.SchemaVersion = 0) THEN]]></Line>
<Line Number="54"><![CDATA[    IF FRK_Press_StartRelease.Count < 8 THEN]]></Line>
<Line Number="55"><![CDATA[        FRK_Press_StartRelease.Key[FRK_Press_StartRelease.Count] := 670;]]></Line>
<Line Number="56"><![CDATA[        (* std.release.configRestoring *)]]></Line>
<Line Number="57"><![CDATA[        FRK_Press_StartRelease.Reason[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="58"><![CDATA[        FRK_Press_StartRelease.Source[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="59"><![CDATA[        FRK_Press_StartRelease.Kind[FRK_Press_StartRelease.Count] := 4;]]></Line>
<Line Number="60"><![CDATA[        FRK_Press_StartRelease.Count := FRK_Press_StartRelease.Count + 1;]]></Line>
<Line Number="61"><![CDATA[    END_IF;]]></Line>
<Line Number="62"><![CDATA[END_IF;]]></Line>
<Line Number="63"><![CDATA[IF ((FRK_Press_Unit.Mode = 0) OR (FRK_Press_Unit.Mode = 2))]]></Line>
<Line Number="64"><![CDATA[    AND NOT ((FRK_Press_CtxAirPressureMonitor.OutImm_PressureOk <> 0)) THEN]]></Line>
<Line Number="65"><![CDATA[    IF FRK_Press_StartRelease.Count < 8 THEN]]></Line>
<Line Number="66"><![CDATA[        FRK_Press_StartRelease.Key[FRK_Press_StartRelease.Count] := 671;]]></Line>
<Line Number="67"><![CDATA[        (* project.condition.airPressureOk *)]]></Line>
<Line Number="68"><![CDATA[        FRK_Press_StartRelease.Reason[FRK_Press_StartRelease.Count] := 2002;]]></Line>
<Line Number="69"><![CDATA[        FRK_Press_StartRelease.Source[FRK_Press_StartRelease.Count] := 0;]]></Line>
<Line Number="70"><![CDATA[        FRK_Press_StartRelease.Kind[FRK_Press_StartRelease.Count] := 3;]]></Line>
<Line Number="71"><![CDATA[        FRK_Press_StartRelease.Count := FRK_Press_StartRelease.Count + 1;]]></Line>
<Line Number="72"><![CDATA[    END_IF;]]></Line>
<Line Number="73"><![CDATA[END_IF;]]></Line>
<Line Number="74"><![CDATA[IF FRK_Press_StartRelease.Count = 0 THEN]]></Line>
<Line Number="75"><![CDATA[    FRK_Press_StartRelease.Released := 1;]]></Line>
<Line Number="76"><![CDATA[ELSE]]></Line>
<Line Number="77"><![CDATA[    FRK_Press_StartRelease.Released := 0;]]></Line>
<Line Number="78"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ScanAccessStartup" Type="ST">
<STContent>
<Line Number="0"><![CDATA[IF S:FS THEN]]></Line>
<Line Number="1"><![CDATA[    FRK_Press_AccessState.LoginBusy := 0;]]></Line>
<Line Number="2"><![CDATA[    FRK_Press_AccessWork.Remaining := 0;]]></Line>
<Line Number="3"><![CDATA[    FRK_Press_AccessWork.LoginValid := 0;]]></Line>
<Line Number="4"><![CDATA[    FRK_Press_AccessWork.HashPhase := 0;]]></Line>
<Line Number="5"><![CDATA[    FRK_Press_AccessWork.HashDone := 0;]]></Line>
<Line Number="6"><![CDATA[    FRK_Press_AccessWork.HashCursor := 0;]]></Line>
<Line Number="7"><![CDATA[    FOR FRK_Press_AccessWork.Index := 0 TO 63 DO]]></Line>
<Line Number="8"><![CDATA[        FRK_Press_AccessWork.Buffer[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="9"><![CDATA[        FRK_Press_AccessWork.Words[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="10"><![CDATA[    END_FOR;]]></Line>
<Line Number="11"><![CDATA[    FOR FRK_Press_AccessWork.Index := 0 TO 31 DO]]></Line>
<Line Number="12"><![CDATA[        FRK_Press_AccessWork.Digest[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="13"><![CDATA[        FRK_Press_AccessWork.User[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="14"><![CDATA[    END_FOR;]]></Line>
<Line Number="15"><![CDATA[    FOR FRK_Press_AccessWork.Index := 0 TO 15 DO]]></Line>
<Line Number="16"><![CDATA[        FRK_Press_AccessWork.Salt[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="17"><![CDATA[    END_FOR;]]></Line>
<Line Number="18"><![CDATA[    FOR FRK_Press_AccessWork.Index := 0 TO 7 DO]]></Line>
<Line Number="19"><![CDATA[        FRK_Press_AccessWork.H[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="20"><![CDATA[        FRK_Press_AccessWork.V[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="21"><![CDATA[    END_FOR;]]></Line>
<Line Number="22"><![CDATA[    FOR FRK_Press_AccessWork.Index := 0 TO 4 DO]]></Line>
<Line Number="23"><![CDATA[        FRK_Press_AccessWork.Temp[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="24"><![CDATA[    END_FOR;]]></Line>
<Line Number="25"><![CDATA[    FRK_Press_AccessLoginRequest.Secret.LEN := 0;]]></Line>
<Line Number="26"><![CDATA[    FOR FRK_Press_HmiWipe := 0 TO 31 DO]]></Line>
<Line Number="27"><![CDATA[        FRK_Press_AccessLoginRequest.Secret.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="28"><![CDATA[    END_FOR;]]></Line>
<Line Number="29"><![CDATA[    FRK_Press_AccessLoginRequest.TextValue.LEN := 0;]]></Line>
<Line Number="30"><![CDATA[    FOR FRK_Press_HmiWipe := 0 TO 254 DO]]></Line>
<Line Number="31"><![CDATA[        FRK_Press_AccessLoginRequest.TextValue.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="32"><![CDATA[    END_FOR;]]></Line>
<Line Number="33"><![CDATA[    FRK_Press_AccessState.CurrentLevel := 0;]]></Line>
<Line Number="34"><![CDATA[    FRK_Press_AccessState.UserLength := 0;]]></Line>
<Line Number="35"><![CDATA[    FRK_Press_AccessWork.IdleMs := 0;]]></Line>
<Line Number="36"><![CDATA[    FOR FRK_Press_AccessWork.Index := 0 TO 31 DO]]></Line>
<Line Number="37"><![CDATA[        FRK_Press_AccessState.UserBytes[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="38"><![CDATA[    END_FOR;]]></Line>
<Line Number="39"><![CDATA[    FRK_Press_AccessState.LoginFailed := 0;]]></Line>
<Line Number="40"><![CDATA[    FRK_Press_AccessState.LoginResultSequence := 0;]]></Line>
<Line Number="41"><![CDATA[    FRK_Press_HmiRequest.Secret.LEN := 0;]]></Line>
<Line Number="42"><![CDATA[    FOR FRK_Press_HmiWipe := 0 TO 31 DO]]></Line>
<Line Number="43"><![CDATA[        FRK_Press_HmiRequest.Secret.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="44"><![CDATA[    END_FOR;]]></Line>
<Line Number="45"><![CDATA[    FRK_Press_HmiRequest.TextValue.LEN := 0;]]></Line>
<Line Number="46"><![CDATA[    FOR FRK_Press_HmiWipe := 0 TO 254 DO]]></Line>
<Line Number="47"><![CDATA[        FRK_Press_HmiRequest.TextValue.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="48"><![CDATA[    END_FOR;]]></Line>
<Line Number="49"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ScanConfigRestore" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* Core §3.8a restore - first scan, fail-closed, never silent *)]]></Line>
<Line Number="1"><![CDATA[FRK_Press_ConfigPersist.SchemaVersion := 1;]]></Line>
<Line Number="2"><![CDATA[FRK_Press_ConfigPersist.RestorePolicy := 0;]]></Line>
<Line Number="3"><![CDATA[IF S:FS THEN]]></Line>
<Line Number="4"><![CDATA[    FRK_Press_ConfigPersist.RestoreLost := 0;]]></Line>
<Line Number="5"><![CDATA[    FRK_Press_ConfigPersist.RestoreAcknowledged := 0;]]></Line>
<Line Number="6"><![CDATA[    FRK_Press_ConfigPersist.LostModuleId := 0;]]></Line>
<Line Number="7"><![CDATA[    (* StationCfg *)]]></Line>
<Line Number="8"><![CDATA[    IF FRK_T_PressStationCfgTag.SchemaVersion <> 3 THEN]]></Line>
<Line Number="9"><![CDATA[        IF FRK_T_PressStationCfgTag.SchemaVersion <> 0 THEN]]></Line>
<Line Number="10"><![CDATA[            FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="11"><![CDATA[            FRK_Press_ConfigPersist.LostModuleId := 1;]]></Line>
<Line Number="12"><![CDATA[        END_IF;]]></Line>
<Line Number="13"><![CDATA[        FRK_T_PressStationCfgTag.StationNumber := 1;]]></Line>
<Line Number="14"><![CDATA[        FRK_T_PressStationCfgTag.RamExtendLimitMs := 2000;]]></Line>
<Line Number="15"><![CDATA[        FRK_T_PressStationCfgTag.AirPressureMinKpa := 450;]]></Line>
<Line Number="16"><![CDATA[        FRK_T_PressStationCfgTag.AirConflictTimeMs := 500;]]></Line>
<Line Number="17"><![CDATA[        FRK_T_PressStationCfgTag.RequireTwoHandStart := 1;]]></Line>
<Line Number="18"><![CDATA[        FRK_T_PressStationCfgTag.SchemaVersion := 0;]]></Line>
<Line Number="19"><![CDATA[    END_IF;]]></Line>
<Line Number="20"><![CDATA[    (* model M-100 *)]]></Line>
<Line Number="21"><![CDATA[    IF FRK_Press_ModelCfg[0].SchemaVersion <> 4 THEN]]></Line>
<Line Number="22"><![CDATA[        IF FRK_Press_ModelCfg[0].SchemaVersion <> 0 THEN]]></Line>
<Line Number="23"><![CDATA[            FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="24"><![CDATA[            FRK_Press_ConfigPersist.LostModuleId := 1;]]></Line>
<Line Number="25"><![CDATA[        END_IF;]]></Line>
<Line Number="26"><![CDATA[        FRK_Press_ModelCfg[0].TransferSettleMs := 200;]]></Line>
<Line Number="27"><![CDATA[        FRK_Press_ModelCfg[0].PressDwellMs := 300;]]></Line>
<Line Number="28"><![CDATA[        FRK_Press_ModelCfg[0].IdealCycleMs := 950;]]></Line>
<Line Number="29"><![CDATA[        FRK_Press_ModelCfg[0].BaselineWorkMs := 950;]]></Line>
<Line Number="30"><![CDATA[        FRK_Press_ModelCfg[0].SchemaVersion := 4;]]></Line>
<Line Number="31"><![CDATA[    END_IF;]]></Line>
<Line Number="32"><![CDATA[    (* model M-200 *)]]></Line>
<Line Number="33"><![CDATA[    IF FRK_Press_ModelCfg[1].SchemaVersion <> 4 THEN]]></Line>
<Line Number="34"><![CDATA[        IF FRK_Press_ModelCfg[1].SchemaVersion <> 0 THEN]]></Line>
<Line Number="35"><![CDATA[            FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="36"><![CDATA[            FRK_Press_ConfigPersist.LostModuleId := 1;]]></Line>
<Line Number="37"><![CDATA[        END_IF;]]></Line>
<Line Number="38"><![CDATA[        FRK_Press_ModelCfg[1].TransferSettleMs := 300;]]></Line>
<Line Number="39"><![CDATA[        FRK_Press_ModelCfg[1].PressDwellMs := 600;]]></Line>
<Line Number="40"><![CDATA[        FRK_Press_ModelCfg[1].IdealCycleMs := 1350;]]></Line>
<Line Number="41"><![CDATA[        FRK_Press_ModelCfg[1].BaselineWorkMs := 1350;]]></Line>
<Line Number="42"><![CDATA[        FRK_Press_ModelCfg[1].SchemaVersion := 4;]]></Line>
<Line Number="43"><![CDATA[    END_IF;]]></Line>
<Line Number="44"><![CDATA[    (* model M-050 *)]]></Line>
<Line Number="45"><![CDATA[    IF FRK_Press_ModelCfg[2].SchemaVersion <> 4 THEN]]></Line>
<Line Number="46"><![CDATA[        IF FRK_Press_ModelCfg[2].SchemaVersion <> 0 THEN]]></Line>
<Line Number="47"><![CDATA[            FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="48"><![CDATA[            FRK_Press_ConfigPersist.LostModuleId := 1;]]></Line>
<Line Number="49"><![CDATA[        END_IF;]]></Line>
<Line Number="50"><![CDATA[        FRK_Press_ModelCfg[2].TransferSettleMs := 150;]]></Line>
<Line Number="51"><![CDATA[        FRK_Press_ModelCfg[2].PressDwellMs := 150;]]></Line>
<Line Number="52"><![CDATA[        FRK_Press_ModelCfg[2].IdealCycleMs := 750;]]></Line>
<Line Number="53"><![CDATA[        FRK_Press_ModelCfg[2].BaselineWorkMs := 750;]]></Line>
<Line Number="54"><![CDATA[        FRK_Press_ModelCfg[2].SchemaVersion := 4;]]></Line>
<Line Number="55"><![CDATA[    END_IF;]]></Line>
<Line Number="56"><![CDATA[    IF FRK_Press_ModelCatalog.SchemaVersion = 0 THEN]]></Line>
<Line Number="57"><![CDATA[        FRK_Press_ModelCatalog.CodeLength[0] := 5;]]></Line>
<Line Number="58"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[0] := 77;]]></Line>
<Line Number="59"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[1] := 45;]]></Line>
<Line Number="60"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[2] := 49;]]></Line>
<Line Number="61"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[3] := 48;]]></Line>
<Line Number="62"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[4] := 48;]]></Line>
<Line Number="63"><![CDATA[        FRK_Press_ModelCatalog.CodeLength[1] := 5;]]></Line>
<Line Number="64"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[80] := 77;]]></Line>
<Line Number="65"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[81] := 45;]]></Line>
<Line Number="66"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[82] := 50;]]></Line>
<Line Number="67"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[83] := 48;]]></Line>
<Line Number="68"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[84] := 48;]]></Line>
<Line Number="69"><![CDATA[        FRK_Press_ModelCatalog.CodeLength[2] := 5;]]></Line>
<Line Number="70"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[160] := 77;]]></Line>
<Line Number="71"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[161] := 45;]]></Line>
<Line Number="72"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[162] := 48;]]></Line>
<Line Number="73"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[163] := 53;]]></Line>
<Line Number="74"><![CDATA[        FRK_Press_ModelCatalog.CodeBytes[164] := 48;]]></Line>
<Line Number="75"><![CDATA[        FRK_Press_ModelCatalog.Count := 3;]]></Line>
<Line Number="76"><![CDATA[        FRK_Press_ModelCatalog.SchemaVersion := 1;]]></Line>
<Line Number="77"><![CDATA[    ELSIF (FRK_Press_ModelCatalog.SchemaVersion <> 1) OR (FRK_Press_ModelCatalog.Count < 3)]]></Line>
<Line Number="78"><![CDATA[        OR (FRK_Press_ModelCatalog.Count > 8) THEN]]></Line>
<Line Number="79"><![CDATA[        FRK_Press_ModelCatalog.Count := 0;]]></Line>
<Line Number="80"><![CDATA[        FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="81"><![CDATA[        FRK_Press_ConfigPersist.LostModuleId := 1;]]></Line>
<Line Number="82"><![CDATA[    END_IF;]]></Line>
<Line Number="83"><![CDATA[    FOR FRK_Press_SetIndex := 0 TO FRK_Press_ModelCatalog.Count - 1 DO]]></Line>
<Line Number="84"><![CDATA[        IF (FRK_Press_ModelCatalog.CodeLength[FRK_Press_SetIndex] < 1)]]></Line>
<Line Number="85"><![CDATA[            OR (FRK_Press_ModelCatalog.CodeLength[FRK_Press_SetIndex] > 80)]]></Line>
<Line Number="86"><![CDATA[            OR (FRK_Press_ModelCfg[FRK_Press_SetIndex].SchemaVersion <> 4) THEN]]></Line>
<Line Number="87"><![CDATA[            FRK_Press_ModelCatalog.Count := 0;]]></Line>
<Line Number="88"><![CDATA[            FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="89"><![CDATA[        END_IF;]]></Line>
<Line Number="90"><![CDATA[        FOR FRK_Press_SetCopy := 0 TO 79 DO]]></Line>
<Line Number="91"><![CDATA[            IF FRK_Press_SetCopy < FRK_Press_ModelCatalog.CodeLength[FRK_Press_SetIndex] THEN]]></Line>
<Line Number="92"><![CDATA[                IF (FRK_Press_ModelCatalog.CodeBytes[FRK_Press_SetIndex * 80 + FRK_Press_SetCopy] < 33)]]></Line>
<Line Number="93"><![CDATA[                    OR (FRK_Press_ModelCatalog.CodeBytes[FRK_Press_SetIndex * 80 + FRK_Press_SetCopy] > 126) THEN]]></Line>
<Line Number="94"><![CDATA[                    FRK_Press_ModelCatalog.Count := 0;]]></Line>
<Line Number="95"><![CDATA[                    FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="96"><![CDATA[                END_IF;]]></Line>
<Line Number="97"><![CDATA[            END_IF;]]></Line>
<Line Number="98"><![CDATA[        END_FOR;]]></Line>
<Line Number="99"><![CDATA[        FOR FRK_Press_SetPrior := 0 TO FRK_Press_SetIndex - 1 DO]]></Line>
<Line Number="100"><![CDATA[            IF FRK_Press_ModelCatalog.CodeLength[FRK_Press_SetIndex] = FRK_Press_ModelCatalog.CodeLength[FRK_Press_SetPrior] THEN]]></Line>
<Line Number="101"><![CDATA[                FRK_Press_ConfigCandidate := 1;]]></Line>
<Line Number="102"><![CDATA[                FOR FRK_Press_SetCopy := 0 TO 79 DO]]></Line>
<Line Number="103"><![CDATA[                    IF FRK_Press_SetCopy < FRK_Press_ModelCatalog.CodeLength[FRK_Press_SetIndex] THEN]]></Line>
<Line Number="104"><![CDATA[                        IF FRK_Press_ModelCatalog.CodeBytes[FRK_Press_SetIndex * 80 + FRK_Press_SetCopy] <> FRK_Press_ModelCatalog.CodeBytes[FRK_Press_SetPrior * 80 + FRK_Press_SetCopy] THEN]]></Line>
<Line Number="105"><![CDATA[                            FRK_Press_ConfigCandidate := 0;]]></Line>
<Line Number="106"><![CDATA[                        END_IF;]]></Line>
<Line Number="107"><![CDATA[                    END_IF;]]></Line>
<Line Number="108"><![CDATA[                END_FOR;]]></Line>
<Line Number="109"><![CDATA[                IF FRK_Press_ConfigCandidate <> 0 THEN]]></Line>
<Line Number="110"><![CDATA[                    FRK_Press_ModelCatalog.Count := 0;]]></Line>
<Line Number="111"><![CDATA[                    FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="112"><![CDATA[                END_IF;]]></Line>
<Line Number="113"><![CDATA[            END_IF;]]></Line>
<Line Number="114"><![CDATA[        END_FOR;]]></Line>
<Line Number="115"><![CDATA[    END_FOR;]]></Line>
<Line Number="116"><![CDATA[END_IF;]]></Line>
<Line Number="117"><![CDATA[(* Line calendar *)]]></Line>
<Line Number="118"><![CDATA[IF FRK_T_LineCfgV3Tag.SchemaVersion <> 3 THEN]]></Line>
<Line Number="119"><![CDATA[    IF FRK_T_LineCfgV3Tag.SchemaVersion <> 0 THEN]]></Line>
<Line Number="120"><![CDATA[        FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="121"><![CDATA[        FRK_Press_ConfigPersist.LostModuleId := 1;]]></Line>
<Line Number="122"><![CDATA[    END_IF;]]></Line>
<Line Number="123"><![CDATA[    FRK_T_LineCfgV3Tag.UtcOffsetMin := 0;]]></Line>
<Line Number="124"><![CDATA[    FRK_T_LineCfgV3Tag.StartMin1 := -1;]]></Line>
<Line Number="125"><![CDATA[    FRK_T_LineCfgV3Tag.DurationMin1 := 480;]]></Line>
<Line Number="126"><![CDATA[    FRK_T_LineCfgV3Tag.ActiveDays1 := 0;]]></Line>
<Line Number="127"><![CDATA[    FRK_T_LineCfgV3Tag.StartMin2 := -1;]]></Line>
<Line Number="128"><![CDATA[    FRK_T_LineCfgV3Tag.DurationMin2 := 480;]]></Line>
<Line Number="129"><![CDATA[    FRK_T_LineCfgV3Tag.ActiveDays2 := 0;]]></Line>
<Line Number="130"><![CDATA[    FRK_T_LineCfgV3Tag.StartMin3 := -1;]]></Line>
<Line Number="131"><![CDATA[    FRK_T_LineCfgV3Tag.DurationMin3 := 480;]]></Line>
<Line Number="132"><![CDATA[    FRK_T_LineCfgV3Tag.ActiveDays3 := 0;]]></Line>
<Line Number="133"><![CDATA[    FRK_T_LineCfgV3Tag.StartMin4 := -1;]]></Line>
<Line Number="134"><![CDATA[    FRK_T_LineCfgV3Tag.DurationMin4 := 480;]]></Line>
<Line Number="135"><![CDATA[    FRK_T_LineCfgV3Tag.ActiveDays4 := 0;]]></Line>
<Line Number="136"><![CDATA[    FRK_T_LineCfgV3Tag.StartMin5 := -1;]]></Line>
<Line Number="137"><![CDATA[    FRK_T_LineCfgV3Tag.DurationMin5 := 480;]]></Line>
<Line Number="138"><![CDATA[    FRK_T_LineCfgV3Tag.ActiveDays5 := 0;]]></Line>
<Line Number="139"><![CDATA[    FRK_T_LineCfgV3Tag.ProductionTarget1 := 0;]]></Line>
<Line Number="140"><![CDATA[    FRK_T_LineCfgV3Tag.ProductionTarget2 := 0;]]></Line>
<Line Number="141"><![CDATA[    FRK_T_LineCfgV3Tag.ProductionTarget3 := 0;]]></Line>
<Line Number="142"><![CDATA[    FRK_T_LineCfgV3Tag.ProductionTarget4 := 0;]]></Line>
<Line Number="143"><![CDATA[    FRK_T_LineCfgV3Tag.ProductionTarget5 := 0;]]></Line>
<Line Number="144"><![CDATA[    FRK_T_LineCfgV3Tag.SchemaVersion := 3;]]></Line>
<Line Number="145"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ScanModules" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* Every module runs unconditionally, before any sequence intent *)]]></Line>
<Line Number="1"><![CDATA[FRK_Press_CtxPartPresentSensor.RawValue := FRK_Press_PartPresent;]]></Line>
<Line Number="2"><![CDATA[FRK_Press_CtxPartPresentSensor.RawQuality := 1;]]></Line>
<Line Number="3"><![CDATA[FRK_M_DigitalInput(FRK_Press_InstPartPresentSensor, FRK_Press_CtxPartPresentSensor, FRK_Press_ScanCount);]]></Line>
<Line Number="4"><![CDATA[FRK_Press_CtxTwoHand.RawLeft := FRK_Press_TwoHand;]]></Line>
<Line Number="5"><![CDATA[FRK_Press_CtxTwoHand.RawRight := FRK_Press_TwoHand;]]></Line>
<Line Number="6"><![CDATA[FRK_Press_CtxTwoHand.RawSafe := FRK_Press_TwoHand;]]></Line>
<Line Number="7"><![CDATA[FRK_Press_CtxTwoHand.RawHealthy := 1;]]></Line>
<Line Number="8"><![CDATA[FRK_M_TwoHand(FRK_Press_InstTwoHand, FRK_Press_CtxTwoHand, FRK_Press_ScanCount);]]></Line>
<Line Number="9"><![CDATA[FRK_Press_CtxAirPressureMonitor.RawOperating := FRK_Press_AirOk;]]></Line>
<Line Number="10"><![CDATA[IF FRK_Press_AirOk <> 0 THEN]]></Line>
<Line Number="11"><![CDATA[    FRK_Press_CtxAirPressureMonitor.RawLow := 0;]]></Line>
<Line Number="12"><![CDATA[ELSE]]></Line>
<Line Number="13"><![CDATA[    FRK_Press_CtxAirPressureMonitor.RawLow := 1;]]></Line>
<Line Number="14"><![CDATA[END_IF;]]></Line>
<Line Number="15"><![CDATA[FRK_Press_CtxAirPressureMonitor.RawQuality := 1;]]></Line>
<Line Number="16"><![CDATA[FRK_Press_CtxAirPressureMonitor.ResetRequest := FRK_Press_ResetRequest;]]></Line>
<Line Number="17"><![CDATA[FRK_Press_CtxAirPressureMonitor.Par_ConflictTimeMs := FRK_T_PressStationCfgTag.AirConflictTimeMs;]]></Line>
<Line Number="18"><![CDATA[FRK_M_AirPressure(FRK_Press_InstAirPressureMonitor, FRK_Press_CtxAirPressureMonitor, FRK_Press_ScanCount);]]></Line>
<Line Number="19"><![CDATA[FRK_Press_CtxPressRam.FaultRequest := FRK_Press_FaultPressRam;]]></Line>
<Line Number="20"><![CDATA[FRK_Press_CtxPressRam.HoldRequest := FRK_Press_HoldPressRam;]]></Line>
<Line Number="21"><![CDATA[IF (FRK_Press_CtxAirPressureMonitor.OutImm_PressureOk <> 0) THEN]]></Line>
<Line Number="22"><![CDATA[    FRK_Press_CtxPressRam.AreaSafe := 1;]]></Line>
<Line Number="23"><![CDATA[ELSE]]></Line>
<Line Number="24"><![CDATA[    FRK_Press_CtxPressRam.AreaSafe := 0;]]></Line>
<Line Number="25"><![CDATA[END_IF;]]></Line>
<Line Number="26"><![CDATA[IF FRK_Press_CtxPressRam.ParCmd_Command = 1 THEN]]></Line>
<Line Number="27"><![CDATA[    IF NOT ((FRK_Press_CtxAirPressureMonitor.OutImm_PressureOk <> 0)) THEN]]></Line>
<Line Number="28"><![CDATA[        FRK_Press_CtxPressRam.Permit := 0;]]></Line>
<Line Number="29"><![CDATA[        FRK_Press_CtxPressRam.PermitKey := 672;]]></Line>
<Line Number="30"><![CDATA[        (* project.interlock.pressRequiresAirPressure *)]]></Line>
<Line Number="31"><![CDATA[    ELSIF NOT ((FRK_Press_CtxDoor.OutImm_Extended <> 0) AND (FRK_Press_CtxDoor.OutImm_Retracted = 0)) THEN]]></Line>
<Line Number="32"><![CDATA[        FRK_Press_CtxPressRam.Permit := 0;]]></Line>
<Line Number="33"><![CDATA[        FRK_Press_CtxPressRam.PermitKey := 673;]]></Line>
<Line Number="34"><![CDATA[        (* project.interlock.pressRequiresGuardClosed *)]]></Line>
<Line Number="35"><![CDATA[    ELSIF NOT ((FRK_Press_CtxPartSlide.OutImm_Extended <> 0) AND (FRK_Press_CtxPartSlide.OutImm_Retracted = 0)) THEN]]></Line>
<Line Number="36"><![CDATA[        FRK_Press_CtxPressRam.Permit := 0;]]></Line>
<Line Number="37"><![CDATA[        FRK_Press_CtxPressRam.PermitKey := 674;]]></Line>
<Line Number="38"><![CDATA[        (* project.interlock.pressRequiresSlideInside *)]]></Line>
<Line Number="39"><![CDATA[    ELSIF NOT ((FRK_Press_CtxDoor.Error = 0) AND (FRK_Press_CtxPartSlide.Error = 0)) THEN]]></Line>
<Line Number="40"><![CDATA[        FRK_Press_CtxPressRam.Permit := 0;]]></Line>
<Line Number="41"><![CDATA[        FRK_Press_CtxPressRam.PermitKey := 675;]]></Line>
<Line Number="42"><![CDATA[        (* project.interlock.pressRequiresHealthyGuardSlide *)]]></Line>
<Line Number="43"><![CDATA[    ELSIF NOT ((FRK_Press_CtxTwoHand.OutImm_SafeActive <> 0)) THEN]]></Line>
<Line Number="44"><![CDATA[        FRK_Press_CtxPressRam.Permit := 0;]]></Line>
<Line Number="45"><![CDATA[        FRK_Press_CtxPressRam.PermitKey := 676;]]></Line>
<Line Number="46"><![CDATA[        (* project.interlock.pressRequiresTwoHandHeld *)]]></Line>
<Line Number="47"><![CDATA[    ELSE]]></Line>
<Line Number="48"><![CDATA[        FRK_Press_CtxPressRam.Permit := 1;]]></Line>
<Line Number="49"><![CDATA[        FRK_Press_CtxPressRam.PermitKey := 0;]]></Line>
<Line Number="50"><![CDATA[    END_IF;]]></Line>
<Line Number="51"><![CDATA[ELSE]]></Line>
<Line Number="52"><![CDATA[    FRK_Press_CtxPressRam.Permit := 1;]]></Line>
<Line Number="53"><![CDATA[    FRK_Press_CtxPressRam.PermitKey := 0;]]></Line>
<Line Number="54"><![CDATA[END_IF;]]></Line>
<Line Number="55"><![CDATA[FRK_M_Cylinder(FRK_Press_InstPressRam, FRK_Press_CtxPressRam, FRK_Press_ScanCount);]]></Line>
<Line Number="56"><![CDATA[FRK_Press_CtxDoor.FaultRequest := FRK_Press_FaultDoor;]]></Line>
<Line Number="57"><![CDATA[FRK_Press_CtxDoor.HoldRequest := FRK_Press_HoldDoor;]]></Line>
<Line Number="58"><![CDATA[IF (FRK_Press_CtxAirPressureMonitor.OutImm_PressureOk <> 0) THEN]]></Line>
<Line Number="59"><![CDATA[    FRK_Press_CtxDoor.AreaSafe := 1;]]></Line>
<Line Number="60"><![CDATA[ELSE]]></Line>
<Line Number="61"><![CDATA[    FRK_Press_CtxDoor.AreaSafe := 0;]]></Line>
<Line Number="62"><![CDATA[END_IF;]]></Line>
<Line Number="63"><![CDATA[IF FRK_Press_CtxDoor.ParCmd_Command = 1 THEN]]></Line>
<Line Number="64"><![CDATA[    IF NOT ((FRK_Press_CtxPartSlide.OutImm_Extended <> 0) AND (FRK_Press_CtxPartSlide.OutImm_Retracted = 0)]]></Line>
<Line Number="65"><![CDATA[        AND (FRK_Press_CtxPartSlide.Busy = 0) AND (FRK_Press_CtxPartSlide.Error = 0)) THEN]]></Line>
<Line Number="66"><![CDATA[        FRK_Press_CtxDoor.Permit := 0;]]></Line>
<Line Number="67"><![CDATA[        FRK_Press_CtxDoor.PermitKey := 677;]]></Line>
<Line Number="68"><![CDATA[        (* project.interlock.doorCloseRequiresSlideInside *)]]></Line>
<Line Number="69"><![CDATA[    ELSE]]></Line>
<Line Number="70"><![CDATA[        FRK_Press_CtxDoor.Permit := 1;]]></Line>
<Line Number="71"><![CDATA[        FRK_Press_CtxDoor.PermitKey := 0;]]></Line>
<Line Number="72"><![CDATA[    END_IF;]]></Line>
<Line Number="73"><![CDATA[ELSE]]></Line>
<Line Number="74"><![CDATA[    FRK_Press_CtxDoor.Permit := 1;]]></Line>
<Line Number="75"><![CDATA[    FRK_Press_CtxDoor.PermitKey := 0;]]></Line>
<Line Number="76"><![CDATA[END_IF;]]></Line>
<Line Number="77"><![CDATA[FRK_M_Cylinder(FRK_Press_InstDoor, FRK_Press_CtxDoor, FRK_Press_ScanCount);]]></Line>
<Line Number="78"><![CDATA[FRK_Press_CtxPartSlide.FaultRequest := FRK_Press_FaultPartSlide;]]></Line>
<Line Number="79"><![CDATA[FRK_Press_CtxPartSlide.HoldRequest := FRK_Press_HoldPartSlide;]]></Line>
<Line Number="80"><![CDATA[IF (FRK_Press_CtxAirPressureMonitor.OutImm_PressureOk <> 0) THEN]]></Line>
<Line Number="81"><![CDATA[    FRK_Press_CtxPartSlide.AreaSafe := 1;]]></Line>
<Line Number="82"><![CDATA[ELSE]]></Line>
<Line Number="83"><![CDATA[    FRK_Press_CtxPartSlide.AreaSafe := 0;]]></Line>
<Line Number="84"><![CDATA[END_IF;]]></Line>
<Line Number="85"><![CDATA[IF FRK_Press_CtxPartSlide.ParCmd_Command = 1 THEN]]></Line>
<Line Number="86"><![CDATA[    IF NOT ((FRK_Press_CtxDoor.OutImm_Retracted <> 0) AND (FRK_Press_CtxDoor.OutImm_Extended = 0)]]></Line>
<Line Number="87"><![CDATA[        AND (FRK_Press_CtxDoor.Busy = 0) AND (FRK_Press_CtxDoor.Error = 0)) THEN]]></Line>
<Line Number="88"><![CDATA[        FRK_Press_CtxPartSlide.Permit := 0;]]></Line>
<Line Number="89"><![CDATA[        FRK_Press_CtxPartSlide.PermitKey := 678;]]></Line>
<Line Number="90"><![CDATA[        (* project.interlock.slideMoveRequiresDoorOpen *)]]></Line>
<Line Number="91"><![CDATA[    ELSE]]></Line>
<Line Number="92"><![CDATA[        FRK_Press_CtxPartSlide.Permit := 1;]]></Line>
<Line Number="93"><![CDATA[        FRK_Press_CtxPartSlide.PermitKey := 0;]]></Line>
<Line Number="94"><![CDATA[    END_IF;]]></Line>
<Line Number="95"><![CDATA[ELSIF FRK_Press_CtxPartSlide.ParCmd_Command = 2 THEN]]></Line>
<Line Number="96"><![CDATA[    IF NOT ((FRK_Press_CtxDoor.OutImm_Retracted <> 0) AND (FRK_Press_CtxDoor.OutImm_Extended = 0)]]></Line>
<Line Number="97"><![CDATA[        AND (FRK_Press_CtxDoor.Busy = 0) AND (FRK_Press_CtxDoor.Error = 0)) THEN]]></Line>
<Line Number="98"><![CDATA[        FRK_Press_CtxPartSlide.Permit := 0;]]></Line>
<Line Number="99"><![CDATA[        FRK_Press_CtxPartSlide.PermitKey := 679;]]></Line>
<Line Number="100"><![CDATA[        (* project.interlock.slideOutsideRequiresDoorOpen *)]]></Line>
<Line Number="101"><![CDATA[    ELSE]]></Line>
<Line Number="102"><![CDATA[        FRK_Press_CtxPartSlide.Permit := 1;]]></Line>
<Line Number="103"><![CDATA[        FRK_Press_CtxPartSlide.PermitKey := 0;]]></Line>
<Line Number="104"><![CDATA[    END_IF;]]></Line>
<Line Number="105"><![CDATA[ELSE]]></Line>
<Line Number="106"><![CDATA[    FRK_Press_CtxPartSlide.Permit := 1;]]></Line>
<Line Number="107"><![CDATA[    FRK_Press_CtxPartSlide.PermitKey := 0;]]></Line>
<Line Number="108"><![CDATA[END_IF;]]></Line>
<Line Number="109"><![CDATA[FRK_M_Cylinder(FRK_Press_InstPartSlide, FRK_Press_CtxPartSlide, FRK_Press_ScanCount);]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ScanStart" Type="ST">
<STContent>
<Line Number="0"><![CDATA[JSR(FRK_Press_ReleaseStart, 0);]]></Line>
<Line Number="1"><![CDATA[(* A physical start starts the chain from ready, by START's own rule *)]]></Line>
<Line Number="2"><![CDATA[IF (FRK_Press_CtxTwoHand.OutImm_StartPulse <> 0) AND (FRK_Press_Unit.Mode = 0) AND (FRK_Press_Unit.Running = 0)]]></Line>
<Line Number="3"><![CDATA[    AND (FRK_Press_StartRelease.Released <> 0) THEN]]></Line>
<Line Number="4"><![CDATA[    FRK_Press_RunRequest := 1;]]></Line>
<Line Number="5"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ScanUnit" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* Sequence intent second, and it checks the ordering itself *)]]></Line>
<Line Number="1"><![CDATA[FRK_Press_Unit.RunRequest := FRK_Press_RunRequest;]]></Line>
<Line Number="2"><![CDATA[FRK_Press_Unit.AbortRequest := FRK_Press_AbortRequest;]]></Line>
<Line Number="3"><![CDATA[FRK_Press_Unit.ResetRequest := FRK_Press_ResetRequest;]]></Line>
<Line Number="4"><![CDATA[FRK_Press_Unit.ModeRequest := FRK_Press_ModeRequest;]]></Line>
<Line Number="5"><![CDATA[FRK_Press_Unit.DecisionAnswer := FRK_Press_DecisionAnswer;]]></Line>
<Line Number="6"><![CDATA[FRK_Press_Unit.ModelRequest := FRK_Press_ModelRequest;]]></Line>
<Line Number="7"><![CDATA[FRK_U_Press(FRK_Press_InstUnit, FRK_Press_Unit, FRK_Press_Chart, FRK_T_PressParCfgTag, FRK_Press_CtxPressRam,]]></Line>
<Line Number="8"><![CDATA[    FRK_Press_CtxDoor, FRK_Press_CtxPartSlide, FRK_Press_CtxPartPresentSensor, FRK_Press_CtxTwoHand,]]></Line>
<Line Number="9"><![CDATA[    FRK_Press_CtxAirPressureMonitor, FRK_Press_ScanCount, FRK_Press_TwoHand, FRK_Press_PartPresent, FRK_Press_AirOk,]]></Line>
<Line Number="10"><![CDATA[    FRK_Press_ModelRequest);]]></Line>
<Line Number="11"><![CDATA[(* Core 3.8 changeover: the bounded commit the chain asked for *)]]></Line>
<Line Number="12"><![CDATA[IF (FRK_Press_Unit.CommitModel >= 1) AND (FRK_Press_Unit.CommitModel <= FRK_Press_ModelCatalog.Count)]]></Line>
<Line Number="13"><![CDATA[    AND (FRK_Press_Unit.CommitModel <= 8) THEN]]></Line>
<Line Number="14"><![CDATA[    FRK_T_PressParCfgTag.TransferSettleMs := FRK_Press_ModelCfg[FRK_Press_Unit.CommitModel - 1].TransferSettleMs;]]></Line>
<Line Number="15"><![CDATA[    FRK_T_PressParCfgTag.PressDwellMs := FRK_Press_ModelCfg[FRK_Press_Unit.CommitModel - 1].PressDwellMs;]]></Line>
<Line Number="16"><![CDATA[    FRK_T_PressParCfgTag.IdealCycleMs := FRK_Press_ModelCfg[FRK_Press_Unit.CommitModel - 1].IdealCycleMs;]]></Line>
<Line Number="17"><![CDATA[    FRK_T_PressParCfgTag.BaselineWorkMs := FRK_Press_ModelCfg[FRK_Press_Unit.CommitModel - 1].BaselineWorkMs;]]></Line>
<Line Number="18"><![CDATA[    FRK_Press_Unit.CommitModel := 0;]]></Line>
<Line Number="19"><![CDATA[END_IF;]]></Line>
<Line Number="20"><![CDATA[FRK_Press_OrderFail := FRK_Press_Unit.OrderFail;]]></Line>
<Line Number="21"><![CDATA[(* AUTO: rendered in LD *)]]></Line>
<Line Number="22"><![CDATA[IF (FRK_Press_Unit.Mode = 0) AND (FRK_Press_Unit.Running <> 0) THEN]]></Line>
<Line Number="23"><![CDATA[    JSR(FRK_PressAutoLd, 0);]]></Line>
<Line Number="24"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ScanHealth" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* The controller clock, once per scan, for every stamp below *)]]></Line>
<Line Number="1"><![CDATA[GSV(WallClockTime,, DateTime, FRK_Press_Clock[0]);]]></Line>
<Line Number="2"><![CDATA[FRK_Press_NowDate := FRK_Press_Clock[0] * 10000 + FRK_Press_Clock[1] * 100 + FRK_Press_Clock[2];]]></Line>
<Line Number="3"><![CDATA[FRK_Press_NowTime := FRK_Press_Clock[3] * 10000000 + FRK_Press_Clock[4] * 100000 + FRK_Press_Clock[5] * 1000 + (FRK_Press_Clock[6] - (FRK_Press_Clock[6] MOD 1000)) / 1000;]]></Line>
<Line Number="4"><![CDATA[(* Core 8.12 controller health probe (TC3 FB_TcSystemHealthProbe); AB S3 *)]]></Line>
<Line Number="5"><![CDATA[GSV(TASK, FRK_PressTask, LastScanTime, FRK_Press_HealthProbe.TaskLastScanUs);]]></Line>
<Line Number="6"><![CDATA[GSV(TASK, FRK_PressTask, MaxScanTime, FRK_Press_HealthProbe.TaskMaxScanUs);]]></Line>
<Line Number="7"><![CDATA[GSV(TASK, FRK_PressTask, OverlapCount, FRK_Press_HealthProbe.TaskOverlapCount);]]></Line>
<Line Number="8"><![CDATA[GSV(TimeSynchronize,, IsSynchronized, FRK_Press_HealthProbe.TimeIsSynchronized);]]></Line>
<Line Number="9"><![CDATA[GSV(TimeSynchronize,, PTPEnable, FRK_Press_HealthProbe.TimePtpEnable);]]></Line>
<Line Number="10"><![CDATA[GSV(FaultLog,, MinorFaultBits, FRK_Press_HealthProbe.MinorFaultBits);]]></Line>
<Line Number="11"><![CDATA[GSV(FaultLog,, MajorFaultBits, FRK_Press_HealthProbe.MajorFaultBits);]]></Line>
<Line Number="12"><![CDATA[FRK_Press_HealthProbe.NowMinuteUs := (FRK_Press_Clock[5] * 1000000) + FRK_Press_Clock[6];]]></Line>
<Line Number="13"><![CDATA[IF FRK_Press_HealthProbe.Samples > 0 THEN]]></Line>
<Line Number="14"><![CDATA[    FRK_Press_HealthProbe.IntervalUs := FRK_Press_HealthProbe.NowMinuteUs - FRK_Press_HealthProbe.PrevMinuteUs;]]></Line>
<Line Number="15"><![CDATA[    IF FRK_Press_HealthProbe.IntervalUs < 0 THEN]]></Line>
<Line Number="16"><![CDATA[        FRK_Press_HealthProbe.IntervalUs := FRK_Press_HealthProbe.IntervalUs + 60000000;]]></Line>
<Line Number="17"><![CDATA[    END_IF;]]></Line>
<Line Number="18"><![CDATA[    IF FRK_Press_HealthProbe.IntervalUs >= 10000 THEN]]></Line>
<Line Number="19"><![CDATA[        FRK_Press_HealthProbe.JitterUs := FRK_Press_HealthProbe.IntervalUs - 10000;]]></Line>
<Line Number="20"><![CDATA[    ELSE]]></Line>
<Line Number="21"><![CDATA[        FRK_Press_HealthProbe.JitterUs := 10000 - FRK_Press_HealthProbe.IntervalUs;]]></Line>
<Line Number="22"><![CDATA[    END_IF;]]></Line>
<Line Number="23"><![CDATA[    IF FRK_Press_HealthProbe.WinScans = 0 THEN]]></Line>
<Line Number="24"><![CDATA[        FRK_Press_HealthProbe.WinMaxIntervalUs := FRK_Press_HealthProbe.IntervalUs;]]></Line>
<Line Number="25"><![CDATA[        FRK_Press_HealthProbe.WinMinIntervalUs := FRK_Press_HealthProbe.IntervalUs;]]></Line>
<Line Number="26"><![CDATA[        FRK_Press_HealthProbe.WinMaxJitterUs := FRK_Press_HealthProbe.JitterUs;]]></Line>
<Line Number="27"><![CDATA[    ELSE]]></Line>
<Line Number="28"><![CDATA[        IF FRK_Press_HealthProbe.IntervalUs > FRK_Press_HealthProbe.WinMaxIntervalUs THEN]]></Line>
<Line Number="29"><![CDATA[            FRK_Press_HealthProbe.WinMaxIntervalUs := FRK_Press_HealthProbe.IntervalUs;]]></Line>
<Line Number="30"><![CDATA[        END_IF;]]></Line>
<Line Number="31"><![CDATA[        IF FRK_Press_HealthProbe.IntervalUs < FRK_Press_HealthProbe.WinMinIntervalUs THEN]]></Line>
<Line Number="32"><![CDATA[            FRK_Press_HealthProbe.WinMinIntervalUs := FRK_Press_HealthProbe.IntervalUs;]]></Line>
<Line Number="33"><![CDATA[        END_IF;]]></Line>
<Line Number="34"><![CDATA[        IF FRK_Press_HealthProbe.JitterUs > FRK_Press_HealthProbe.WinMaxJitterUs THEN]]></Line>
<Line Number="35"><![CDATA[            FRK_Press_HealthProbe.WinMaxJitterUs := FRK_Press_HealthProbe.JitterUs;]]></Line>
<Line Number="36"><![CDATA[        END_IF;]]></Line>
<Line Number="37"><![CDATA[    END_IF;]]></Line>
<Line Number="38"><![CDATA[    FRK_Press_HealthProbe.WinScans := FRK_Press_HealthProbe.WinScans + 1;]]></Line>
<Line Number="39"><![CDATA[    IF FRK_Press_HealthProbe.WinScans >= 100 THEN]]></Line>
<Line Number="40"><![CDATA[        FRK_Press_HealthProbe.MaxIntervalUs := FRK_Press_HealthProbe.WinMaxIntervalUs;]]></Line>
<Line Number="41"><![CDATA[        FRK_Press_HealthProbe.MinIntervalUs := FRK_Press_HealthProbe.WinMinIntervalUs;]]></Line>
<Line Number="42"><![CDATA[        FRK_Press_HealthProbe.MaxJitterUs := FRK_Press_HealthProbe.WinMaxJitterUs;]]></Line>
<Line Number="43"><![CDATA[        FRK_Press_HealthProbe.WinScans := 0;]]></Line>
<Line Number="44"><![CDATA[    END_IF;]]></Line>
<Line Number="45"><![CDATA[END_IF;]]></Line>
<Line Number="46"><![CDATA[FRK_Press_HealthProbe.PrevMinuteUs := FRK_Press_HealthProbe.NowMinuteUs;]]></Line>
<Line Number="47"><![CDATA[IF FRK_Press_HealthProbe.Samples < 2000000000 THEN]]></Line>
<Line Number="48"><![CDATA[    FRK_Press_HealthProbe.Samples := FRK_Press_HealthProbe.Samples + 1;]]></Line>
<Line Number="49"><![CDATA[END_IF;]]></Line>
<Line Number="50"><![CDATA[(* Core 8.12 system health (TC3 FB_SystemHealthPublisher), S3's subset *)]]></Line>
<Line Number="51"><![CDATA[FRK_Press_SystemHealth.Present := 0;]]></Line>
<Line Number="52"><![CDATA[IF (FRK_Press_HealthCfg.SchemaVersion = 1) AND (FRK_Press_HealthCfg.MaxTaskCycleUs > 0)]]></Line>
<Line Number="53"><![CDATA[    AND (FRK_Press_HealthCfg.MaxTaskJitterUs > 0) THEN]]></Line>
<Line Number="54"><![CDATA[    FRK_Press_SystemHealth.Present := 1;]]></Line>
<Line Number="55"><![CDATA[END_IF;]]></Line>
<Line Number="56"><![CDATA[FRK_Press_SystemHealth.TaskAvailable := 0;]]></Line>
<Line Number="57"><![CDATA[IF FRK_Press_HealthProbe.Samples > 1 THEN]]></Line>
<Line Number="58"><![CDATA[    FRK_Press_SystemHealth.TaskAvailable := 1;]]></Line>
<Line Number="59"><![CDATA[END_IF;]]></Line>
<Line Number="60"><![CDATA[IF FRK_Press_HealthProbe.Samples <= 1 THEN]]></Line>
<Line Number="61"><![CDATA[    FRK_Press_SystemHealth.SeenOverlap := FRK_Press_HealthProbe.TaskOverlapCount;]]></Line>
<Line Number="62"><![CDATA[END_IF;]]></Line>
<Line Number="63"><![CDATA[FRK_Press_SystemHealth.TaskOverrun := 0;]]></Line>
<Line Number="64"><![CDATA[IF FRK_Press_HealthProbe.TaskOverlapCount <> FRK_Press_SystemHealth.SeenOverlap THEN]]></Line>
<Line Number="65"><![CDATA[    FRK_Press_SystemHealth.TaskOverrun := 1;]]></Line>
<Line Number="66"><![CDATA[    FRK_Press_SystemHealth.SeenOverlap := FRK_Press_HealthProbe.TaskOverlapCount;]]></Line>
<Line Number="67"><![CDATA[END_IF;]]></Line>
<Line Number="68"><![CDATA[FRK_Press_SystemHealth.Bad[0] := 0;]]></Line>
<Line Number="69"><![CDATA[FRK_Press_SystemHealth.Bad[1] := 0;]]></Line>
<Line Number="70"><![CDATA[FRK_Press_SystemHealth.Bad[2] := 0;]]></Line>
<Line Number="71"><![CDATA[FRK_Press_SystemHealth.Bad[3] := 0;]]></Line>
<Line Number="72"><![CDATA[FRK_Press_SystemHealth.Bad[4] := 0;]]></Line>
<Line Number="73"><![CDATA[FRK_Press_SystemHealth.Bad[5] := 0;]]></Line>
<Line Number="74"><![CDATA[IF (FRK_Press_SystemHealth.Present <> 0) AND (FRK_Press_SystemHealth.TaskAvailable <> 0) THEN]]></Line>
<Line Number="75"><![CDATA[    IF (FRK_Press_SystemHealth.TaskOverrun <> 0)]]></Line>
<Line Number="76"><![CDATA[        OR (FRK_Press_HealthProbe.IntervalUs > FRK_Press_HealthCfg.MaxTaskCycleUs) THEN]]></Line>
<Line Number="77"><![CDATA[        FRK_Press_SystemHealth.Bad[0] := 1;]]></Line>
<Line Number="78"><![CDATA[    END_IF;]]></Line>
<Line Number="79"><![CDATA[    IF FRK_Press_HealthProbe.JitterUs > FRK_Press_HealthCfg.MaxTaskJitterUs THEN]]></Line>
<Line Number="80"><![CDATA[        FRK_Press_SystemHealth.Bad[1] := 1;]]></Line>
<Line Number="81"><![CDATA[    END_IF;]]></Line>
<Line Number="82"><![CDATA[    (* local I/O, no fieldbus or distributed clock here: bad only if required *)]]></Line>
<Line Number="83"><![CDATA[    IF FRK_Press_HealthCfg.RequireFieldbus <> 0 THEN]]></Line>
<Line Number="84"><![CDATA[        FRK_Press_SystemHealth.Bad[3] := 1;]]></Line>
<Line Number="85"><![CDATA[    END_IF;]]></Line>
<Line Number="86"><![CDATA[    IF FRK_Press_HealthCfg.RequireDcSync <> 0 THEN]]></Line>
<Line Number="87"><![CDATA[        FRK_Press_SystemHealth.Bad[4] := 1;]]></Line>
<Line Number="88"><![CDATA[    END_IF;]]></Line>
<Line Number="89"><![CDATA[    IF (FRK_Press_HealthCfg.RequireTimeSync <> 0) AND (FRK_Press_HealthProbe.TimeIsSynchronized = 0) THEN]]></Line>
<Line Number="90"><![CDATA[        FRK_Press_SystemHealth.Bad[5] := 1;]]></Line>
<Line Number="91"><![CDATA[    END_IF;]]></Line>
<Line Number="92"><![CDATA[END_IF;]]></Line>
<Line Number="93"><![CDATA[(* healthy only once evaluated: never on a sample nothing was judged on *)]]></Line>
<Line Number="94"><![CDATA[FRK_Press_SystemHealth.Healthy := 0;]]></Line>
<Line Number="95"><![CDATA[IF (FRK_Press_SystemHealth.Present <> 0) AND (FRK_Press_SystemHealth.TaskAvailable <> 0) THEN]]></Line>
<Line Number="96"><![CDATA[    FRK_Press_SystemHealth.Healthy := 1;]]></Line>
<Line Number="97"><![CDATA[END_IF;]]></Line>
<Line Number="98"><![CDATA[IF FRK_Press_SystemHealth.Bad[0] <> 0 THEN]]></Line>
<Line Number="99"><![CDATA[    FRK_Press_SystemHealth.Healthy := 0;]]></Line>
<Line Number="100"><![CDATA[END_IF;]]></Line>
<Line Number="101"><![CDATA[IF FRK_Press_SystemHealth.Bad[1] <> 0 THEN]]></Line>
<Line Number="102"><![CDATA[    FRK_Press_SystemHealth.Healthy := 0;]]></Line>
<Line Number="103"><![CDATA[END_IF;]]></Line>
<Line Number="104"><![CDATA[IF FRK_Press_SystemHealth.Bad[2] <> 0 THEN]]></Line>
<Line Number="105"><![CDATA[    FRK_Press_SystemHealth.Healthy := 0;]]></Line>
<Line Number="106"><![CDATA[END_IF;]]></Line>
<Line Number="107"><![CDATA[IF FRK_Press_SystemHealth.Bad[3] <> 0 THEN]]></Line>
<Line Number="108"><![CDATA[    FRK_Press_SystemHealth.Healthy := 0;]]></Line>
<Line Number="109"><![CDATA[END_IF;]]></Line>
<Line Number="110"><![CDATA[IF FRK_Press_SystemHealth.Bad[4] <> 0 THEN]]></Line>
<Line Number="111"><![CDATA[    FRK_Press_SystemHealth.Healthy := 0;]]></Line>
<Line Number="112"><![CDATA[END_IF;]]></Line>
<Line Number="113"><![CDATA[IF FRK_Press_SystemHealth.Bad[5] <> 0 THEN]]></Line>
<Line Number="114"><![CDATA[    FRK_Press_SystemHealth.Healthy := 0;]]></Line>
<Line Number="115"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ScanDiagnostics" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* Core 6.9: the stall watchdog, TC3's _tStall. A hold is a declared *)]]></Line>
<Line Number="1"><![CDATA[(* wait, not a stall, so any hold disarms it; a step change restarts it. *)]]></Line>
<Line Number="2"><![CDATA[FRK_Press_AnyHeld := 0;]]></Line>
<Line Number="3"><![CDATA[IF FRK_Press_CtxPressRam.OutImm_Held <> 0 THEN]]></Line>
<Line Number="4"><![CDATA[    FRK_Press_AnyHeld := 1;]]></Line>
<Line Number="5"><![CDATA[END_IF;]]></Line>
<Line Number="6"><![CDATA[IF FRK_Press_CtxDoor.OutImm_Held <> 0 THEN]]></Line>
<Line Number="7"><![CDATA[    FRK_Press_AnyHeld := 1;]]></Line>
<Line Number="8"><![CDATA[END_IF;]]></Line>
<Line Number="9"><![CDATA[IF FRK_Press_CtxPartSlide.OutImm_Held <> 0 THEN]]></Line>
<Line Number="10"><![CDATA[    FRK_Press_AnyHeld := 1;]]></Line>
<Line Number="11"><![CDATA[END_IF;]]></Line>
<Line Number="12"><![CDATA[IF FRK_Press_CtxPartPresentSensor.OutImm_Held <> 0 THEN]]></Line>
<Line Number="13"><![CDATA[    FRK_Press_AnyHeld := 1;]]></Line>
<Line Number="14"><![CDATA[END_IF;]]></Line>
<Line Number="15"><![CDATA[IF FRK_Press_CtxTwoHand.OutImm_Held <> 0 THEN]]></Line>
<Line Number="16"><![CDATA[    FRK_Press_AnyHeld := 1;]]></Line>
<Line Number="17"><![CDATA[END_IF;]]></Line>
<Line Number="18"><![CDATA[IF FRK_Press_CtxAirPressureMonitor.OutImm_Held <> 0 THEN]]></Line>
<Line Number="19"><![CDATA[    FRK_Press_AnyHeld := 1;]]></Line>
<Line Number="20"><![CDATA[END_IF;]]></Line>
<Line Number="21"><![CDATA[IF (FRK_Press_Unit.Running <> 0) AND (FRK_Press_Unit.Error = 0) AND (FRK_Press_AnyHeld = 0)]]></Line>
<Line Number="22"><![CDATA[    AND (FRK_Press_Unit.Step = FRK_Press_Unit.StallStep) THEN]]></Line>
<Line Number="23"><![CDATA[    FRK_Press_Unit.StallMs := FRK_Press_Unit.StallMs + FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="24"><![CDATA[ELSE]]></Line>
<Line Number="25"><![CDATA[    FRK_Press_Unit.StallMs := 0;]]></Line>
<Line Number="26"><![CDATA[END_IF;]]></Line>
<Line Number="27"><![CDATA[FRK_Press_Unit.StallStep := FRK_Press_Unit.Step;]]></Line>
<Line Number="28"><![CDATA[(* TC3 times a step against its ExpectedTime when it states one, else *)]]></Line>
<Line Number="29"><![CDATA[(* StallTime. A step that takes exactly its expected time is seen to *)]]></Line>
<Line Number="30"><![CDATA[(* finish one scan later, so it has that scan before it is stalled. *)]]></Line>
<Line Number="31"><![CDATA[FRK_Press_Unit.StepExpectedMs := 0;]]></Line>
<Line Number="32"><![CDATA[IF (FRK_Press_Unit.Mode = 0) AND (FRK_Press_Unit.Step = 170) THEN]]></Line>
<Line Number="33"><![CDATA[    FRK_Press_Unit.StepExpectedMs := FRK_T_PressParCfgTag.TransferSettleMs;]]></Line>
<Line Number="34"><![CDATA[END_IF;]]></Line>
<Line Number="35"><![CDATA[IF (FRK_Press_Unit.Mode = 0) AND (FRK_Press_Unit.Step = 220) THEN]]></Line>
<Line Number="36"><![CDATA[    FRK_Press_Unit.StepExpectedMs := FRK_T_PressParCfgTag.PressDwellMs;]]></Line>
<Line Number="37"><![CDATA[END_IF;]]></Line>
<Line Number="38"><![CDATA[IF FRK_Press_Unit.StepExpectedMs > 0 THEN]]></Line>
<Line Number="39"><![CDATA[    FRK_Press_StallLimitMs := FRK_Press_Unit.StepExpectedMs + FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="40"><![CDATA[ELSE]]></Line>
<Line Number="41"><![CDATA[    FRK_Press_StallLimitMs := FRK_Press_Unit.StallTimeMs;]]></Line>
<Line Number="42"><![CDATA[END_IF;]]></Line>
<Line Number="43"><![CDATA[IF (FRK_Press_StallLimitMs > 0) AND (FRK_Press_Unit.StallMs >= FRK_Press_StallLimitMs) THEN]]></Line>
<Line Number="44"><![CDATA[    FRK_Press_Unit.StepTimedOut := 1;]]></Line>
<Line Number="45"><![CDATA[ELSE]]></Line>
<Line Number="46"><![CDATA[    FRK_Press_Unit.StepTimedOut := 0;]]></Line>
<Line Number="47"><![CDATA[END_IF;]]></Line>
<Line Number="48"><![CDATA[(* Core 6.9(a): the Unit's one diagnostic, in TC3's order - an adopted *)]]></Line>
<Line Number="49"><![CDATA[(* fault, the first held child (_M_RollupHold), a stall. *)]]></Line>
<Line Number="50"><![CDATA[IF FRK_Press_Unit.Error <> 0 THEN]]></Line>
<Line Number="51"><![CDATA[    FRK_Press_Unit.DiagReason := FRK_Press_Unit.ErrorID;]]></Line>
<Line Number="52"><![CDATA[ELSIF (FRK_Press_Unit.Running <> 0) AND (FRK_Press_CtxPressRam.OutImm_Held <> 0) THEN]]></Line>
<Line Number="53"><![CDATA[    FRK_Press_Unit.DiagReason := FRK_Press_CtxPressRam.OutImm_Reason;]]></Line>
<Line Number="54"><![CDATA[ELSIF (FRK_Press_Unit.Running <> 0) AND (FRK_Press_CtxDoor.OutImm_Held <> 0) THEN]]></Line>
<Line Number="55"><![CDATA[    FRK_Press_Unit.DiagReason := FRK_Press_CtxDoor.OutImm_Reason;]]></Line>
<Line Number="56"><![CDATA[ELSIF (FRK_Press_Unit.Running <> 0) AND (FRK_Press_CtxPartSlide.OutImm_Held <> 0) THEN]]></Line>
<Line Number="57"><![CDATA[    FRK_Press_Unit.DiagReason := FRK_Press_CtxPartSlide.OutImm_Reason;]]></Line>
<Line Number="58"><![CDATA[ELSIF (FRK_Press_Unit.Running <> 0) AND (FRK_Press_CtxPartPresentSensor.OutImm_Held <> 0) THEN]]></Line>
<Line Number="59"><![CDATA[    FRK_Press_Unit.DiagReason := FRK_Press_CtxPartPresentSensor.OutImm_Reason;]]></Line>
<Line Number="60"><![CDATA[ELSIF (FRK_Press_Unit.Running <> 0) AND (FRK_Press_CtxTwoHand.OutImm_Held <> 0) THEN]]></Line>
<Line Number="61"><![CDATA[    FRK_Press_Unit.DiagReason := FRK_Press_CtxTwoHand.OutImm_Reason;]]></Line>
<Line Number="62"><![CDATA[ELSIF (FRK_Press_Unit.Running <> 0) AND (FRK_Press_CtxAirPressureMonitor.OutImm_Held <> 0) THEN]]></Line>
<Line Number="63"><![CDATA[    FRK_Press_Unit.DiagReason := FRK_Press_CtxAirPressureMonitor.OutImm_Reason;]]></Line>
<Line Number="64"><![CDATA[ELSIF FRK_Press_Unit.StepTimedOut <> 0 THEN]]></Line>
<Line Number="65"><![CDATA[    FRK_Press_Unit.DiagReason := 2005;]]></Line>
<Line Number="66"><![CDATA[ELSE]]></Line>
<Line Number="67"><![CDATA[    FRK_Press_Unit.DiagReason := 0;]]></Line>
<Line Number="68"><![CDATA[END_IF;]]></Line>
<Line Number="69"><![CDATA[IF FRK_Press_Unit.DiagReason <> FRK_Press_Unit.DiagStamped THEN]]></Line>
<Line Number="70"><![CDATA[    FRK_Press_Unit.DiagStamped := FRK_Press_Unit.DiagReason;]]></Line>
<Line Number="71"><![CDATA[    FRK_Press_Unit.DiagSinceDate := FRK_Press_NowDate;]]></Line>
<Line Number="72"><![CDATA[    FRK_Press_Unit.DiagSinceTime := FRK_Press_NowTime;]]></Line>
<Line Number="73"><![CDATA[    IF FRK_Press_Unit.Error <> 0 THEN]]></Line>
<Line Number="74"><![CDATA[        CASE FRK_Press_Unit.ErrorSource OF]]></Line>
<Line Number="75"><![CDATA[            1:]]></Line>
<Line Number="76"><![CDATA[                FRK_Press_Unit.DiagIoRoles := FRK_Press_CtxPressRam.OutImm_IoRoles;]]></Line>
<Line Number="77"><![CDATA[]]></Line>
<Line Number="78"><![CDATA[            2:]]></Line>
<Line Number="79"><![CDATA[                FRK_Press_Unit.DiagIoRoles := FRK_Press_CtxDoor.OutImm_IoRoles;]]></Line>
<Line Number="80"><![CDATA[]]></Line>
<Line Number="81"><![CDATA[            3:]]></Line>
<Line Number="82"><![CDATA[                FRK_Press_Unit.DiagIoRoles := FRK_Press_CtxPartSlide.OutImm_IoRoles;]]></Line>
<Line Number="83"><![CDATA[]]></Line>
<Line Number="84"><![CDATA[            4:]]></Line>
<Line Number="85"><![CDATA[                FRK_Press_Unit.DiagIoRoles := FRK_Press_CtxPartPresentSensor.OutImm_IoRoles;]]></Line>
<Line Number="86"><![CDATA[]]></Line>
<Line Number="87"><![CDATA[            5:]]></Line>
<Line Number="88"><![CDATA[                FRK_Press_Unit.DiagIoRoles := FRK_Press_CtxTwoHand.OutImm_IoRoles;]]></Line>
<Line Number="89"><![CDATA[]]></Line>
<Line Number="90"><![CDATA[            6:]]></Line>
<Line Number="91"><![CDATA[                FRK_Press_Unit.DiagIoRoles := FRK_Press_CtxAirPressureMonitor.OutImm_IoRoles;]]></Line>
<Line Number="92"><![CDATA[            ELSE]]></Line>
<Line Number="93"><![CDATA[                FRK_Press_Unit.DiagIoRoles := 0;]]></Line>
<Line Number="94"><![CDATA[        END_CASE;]]></Line>
<Line Number="95"><![CDATA[    ELSE]]></Line>
<Line Number="96"><![CDATA[        FRK_Press_Unit.DiagIoRoles := 0;]]></Line>
<Line Number="97"><![CDATA[    END_IF;]]></Line>
<Line Number="98"><![CDATA[END_IF;]]></Line>
<Line Number="99"><![CDATA[IF FRK_Press_CtxPressRam.OutImm_Reason <> FRK_Press_CtxPressRam.DiagStamped THEN]]></Line>
<Line Number="100"><![CDATA[    FRK_Press_CtxPressRam.DiagStamped := FRK_Press_CtxPressRam.OutImm_Reason;]]></Line>
<Line Number="101"><![CDATA[    FRK_Press_CtxPressRam.DiagSinceDate := FRK_Press_NowDate;]]></Line>
<Line Number="102"><![CDATA[    FRK_Press_CtxPressRam.DiagSinceTime := FRK_Press_NowTime;]]></Line>
<Line Number="103"><![CDATA[END_IF;]]></Line>
<Line Number="104"><![CDATA[IF FRK_Press_CtxDoor.OutImm_Reason <> FRK_Press_CtxDoor.DiagStamped THEN]]></Line>
<Line Number="105"><![CDATA[    FRK_Press_CtxDoor.DiagStamped := FRK_Press_CtxDoor.OutImm_Reason;]]></Line>
<Line Number="106"><![CDATA[    FRK_Press_CtxDoor.DiagSinceDate := FRK_Press_NowDate;]]></Line>
<Line Number="107"><![CDATA[    FRK_Press_CtxDoor.DiagSinceTime := FRK_Press_NowTime;]]></Line>
<Line Number="108"><![CDATA[END_IF;]]></Line>
<Line Number="109"><![CDATA[IF FRK_Press_CtxPartSlide.OutImm_Reason <> FRK_Press_CtxPartSlide.DiagStamped THEN]]></Line>
<Line Number="110"><![CDATA[    FRK_Press_CtxPartSlide.DiagStamped := FRK_Press_CtxPartSlide.OutImm_Reason;]]></Line>
<Line Number="111"><![CDATA[    FRK_Press_CtxPartSlide.DiagSinceDate := FRK_Press_NowDate;]]></Line>
<Line Number="112"><![CDATA[    FRK_Press_CtxPartSlide.DiagSinceTime := FRK_Press_NowTime;]]></Line>
<Line Number="113"><![CDATA[END_IF;]]></Line>
<Line Number="114"><![CDATA[IF FRK_Press_CtxPartPresentSensor.OutImm_Reason <> FRK_Press_CtxPartPresentSensor.DiagStamped THEN]]></Line>
<Line Number="115"><![CDATA[    FRK_Press_CtxPartPresentSensor.DiagStamped := FRK_Press_CtxPartPresentSensor.OutImm_Reason;]]></Line>
<Line Number="116"><![CDATA[    FRK_Press_CtxPartPresentSensor.DiagSinceDate := FRK_Press_NowDate;]]></Line>
<Line Number="117"><![CDATA[    FRK_Press_CtxPartPresentSensor.DiagSinceTime := FRK_Press_NowTime;]]></Line>
<Line Number="118"><![CDATA[END_IF;]]></Line>
<Line Number="119"><![CDATA[IF FRK_Press_CtxTwoHand.OutImm_Reason <> FRK_Press_CtxTwoHand.DiagStamped THEN]]></Line>
<Line Number="120"><![CDATA[    FRK_Press_CtxTwoHand.DiagStamped := FRK_Press_CtxTwoHand.OutImm_Reason;]]></Line>
<Line Number="121"><![CDATA[    FRK_Press_CtxTwoHand.DiagSinceDate := FRK_Press_NowDate;]]></Line>
<Line Number="122"><![CDATA[    FRK_Press_CtxTwoHand.DiagSinceTime := FRK_Press_NowTime;]]></Line>
<Line Number="123"><![CDATA[END_IF;]]></Line>
<Line Number="124"><![CDATA[IF FRK_Press_CtxAirPressureMonitor.OutImm_Reason <> FRK_Press_CtxAirPressureMonitor.DiagStamped THEN]]></Line>
<Line Number="125"><![CDATA[    FRK_Press_CtxAirPressureMonitor.DiagStamped := FRK_Press_CtxAirPressureMonitor.OutImm_Reason;]]></Line>
<Line Number="126"><![CDATA[    FRK_Press_CtxAirPressureMonitor.DiagSinceDate := FRK_Press_NowDate;]]></Line>
<Line Number="127"><![CDATA[    FRK_Press_CtxAirPressureMonitor.DiagSinceTime := FRK_Press_NowTime;]]></Line>
<Line Number="128"><![CDATA[END_IF;]]></Line>
<Line Number="129"><![CDATA[(* Core 8.3 alarm log: fault capture, as TC3's FB_UnitBase *)]]></Line>
<Line Number="130"><![CDATA[FRK_Press_AlarmActive.SchemaVersion := 2;]]></Line>
<Line Number="131"><![CDATA[FRK_Press_AlarmRing.SchemaVersion := 2;]]></Line>
<Line Number="132"><![CDATA[(* Core 8.10: bounded task-duration countdown; no wall-clock dependency *)]]></Line>
<Line Number="133"><![CDATA[FOR FRK_Press_AlarmShelfWork.Index := 0 TO 15 DO]]></Line>
<Line Number="134"><![CDATA[    IF FRK_Press_AlarmActive.ActShelved[FRK_Press_AlarmShelfWork.Index] <> 0 THEN]]></Line>
<Line Number="135"><![CDATA[        IF FRK_Press_AlarmShelfWork.RemainingMs[FRK_Press_AlarmShelfWork.Index] > FRK_Press_Unit.Par_TaskPeriodMs THEN]]></Line>
<Line Number="136"><![CDATA[            FRK_Press_AlarmShelfWork.RemainingMs[FRK_Press_AlarmShelfWork.Index] := FRK_Press_AlarmShelfWork.RemainingMs[FRK_Press_AlarmShelfWork.Index] - FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="137"><![CDATA[        ELSE]]></Line>
<Line Number="138"><![CDATA[            FRK_Press_AlarmActive.ActShelved[FRK_Press_AlarmShelfWork.Index] := 0;]]></Line>
<Line Number="139"><![CDATA[            FRK_Press_AlarmShelfWork.RemainingMs[FRK_Press_AlarmShelfWork.Index] := 0;]]></Line>
<Line Number="140"><![CDATA[            FRK_Press_AccessWork.AuditKey := 639;]]></Line>
<Line Number="141"><![CDATA[            FRK_Press_AccessWork.AuditKind := 21;]]></Line>
<Line Number="142"><![CDATA[            FRK_Press_AccessWork.AuditSequence := 0;]]></Line>
<Line Number="143"><![CDATA[            FRK_Press_AccessWork.AuditAccepted := 1;]]></Line>
<Line Number="144"><![CDATA[            FRK_Press_AccessWork.AuditLength := 0;]]></Line>
<Line Number="145"><![CDATA[            FRK_Press_AccessWork.AuditSource := 1;]]></Line>
<Line Number="146"><![CDATA[            FRK_Press_AccessWork.AuditEventSource := FRK_Press_AlarmActive.ActSourceModuleId[FRK_Press_AlarmShelfWork.Index];]]></Line>
<Line Number="147"><![CDATA[            FRK_Press_AccessWork.AuditGate := 9;]]></Line>
<Line Number="148"><![CDATA[            JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="149"><![CDATA[        END_IF;]]></Line>
<Line Number="150"><![CDATA[    END_IF;]]></Line>
<Line Number="151"><![CDATA[END_FOR;]]></Line>
<Line Number="152"><![CDATA[(* 8.3(c): ERROR entry raises *)]]></Line>
<Line Number="153"><![CDATA[IF (FRK_Press_Unit.Error <> 0) AND (FRK_Press_AlarmActive.FaultEvt = 0) THEN]]></Line>
<Line Number="154"><![CDATA[    JSR(FRK_Press_AlarmOpen, 0);]]></Line>
<Line Number="155"><![CDATA[    IF FRK_Press_AlmSlot >= 0 THEN]]></Line>
<Line Number="156"><![CDATA[        FRK_Press_AlarmActive.ActReasonCode[FRK_Press_AlmSlot] := FRK_Press_Unit.ErrorID;]]></Line>
<Line Number="157"><![CDATA[        CASE FRK_Press_Unit.ErrorID OF]]></Line>
<Line Number="158"><![CDATA[            10, 2003, 2041, 10101, 10102, 10115, 10601:]]></Line>
<Line Number="159"><![CDATA[                FRK_Press_AlarmActive.ActSeverity[FRK_Press_AlmSlot] := 1;]]></Line>
<Line Number="160"><![CDATA[]]></Line>
<Line Number="161"><![CDATA[            11, 16, 17, 21, 2002, 2005, 2007, 2008, 2042, 2043, 12001, 12010, 12011, 12012, 12020:]]></Line>
<Line Number="162"><![CDATA[                FRK_Press_AlarmActive.ActSeverity[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="163"><![CDATA[]]></Line>
<Line Number="164"><![CDATA[            15:]]></Line>
<Line Number="165"><![CDATA[                FRK_Press_AlarmActive.ActSeverity[FRK_Press_AlmSlot] := 2;]]></Line>
<Line Number="166"><![CDATA[            ELSE]]></Line>
