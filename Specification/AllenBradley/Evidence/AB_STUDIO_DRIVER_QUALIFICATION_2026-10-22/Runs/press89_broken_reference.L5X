<Line Number="395"><![CDATA[                    IF (FRK_Press_AccessLoginRequest.User.LEN < 1) OR (FRK_Press_AccessLoginRequest.User.LEN > 32) THEN]]></Line>
<Line Number="396"><![CDATA[                        FRK_Press_AccessWork.LoginValid := 0;]]></Line>
<Line Number="397"><![CDATA[                        FRK_Press_AccessWork.ActorLength := 0;]]></Line>
<Line Number="398"><![CDATA[                    END_IF;]]></Line>
<Line Number="399"><![CDATA[                    CASE FRK_Press_AccessWork.Profile OF]]></Line>
<Line Number="400"><![CDATA[                        0:]]></Line>
<Line Number="401"><![CDATA[                            IF (FRK_Press_AccessLoginRequest.Secret.LEN < 1)]]></Line>
<Line Number="402"><![CDATA[                                OR (FRK_Press_AccessLoginRequest.Secret.LEN > 32) THEN]]></Line>
<Line Number="403"><![CDATA[                                FRK_Press_AccessWork.LoginValid := 0;]]></Line>
<Line Number="404"><![CDATA[                            END_IF;]]></Line>
<Line Number="405"><![CDATA[]]></Line>
<Line Number="406"><![CDATA[                        1:]]></Line>
<Line Number="407"><![CDATA[                            IF (FRK_Press_AccessLoginRequest.TextValue.LEN <> 64)]]></Line>
<Line Number="408"><![CDATA[                                OR (FRK_Press_AccessLoginRequest.Secret.LEN <> 0) THEN]]></Line>
<Line Number="409"><![CDATA[                                FRK_Press_AccessWork.LoginValid := 0;]]></Line>
<Line Number="410"><![CDATA[                            END_IF;]]></Line>
