</Routine>
<Routine Name="FRK_Press_AlarmShelfRequest" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_AlarmShelfWork.ModuleId := 0;]]></Line>
<Line Number="1"><![CDATA[FRK_Press_AlarmShelfWork.Reason := 0;]]></Line>
<Line Number="2"><![CDATA[FRK_Press_AlarmShelfWork.Allowed := 0;]]></Line>
<Line Number="3"><![CDATA[IF (FRK_Press_MfHeader.Valid = 1) AND (FRK_Press_MfHeader.Truncated = 0) THEN]]></Line>
<Line Number="4"><![CDATA[    IF (FRK_Press_MfHeader.ModulesCount = 7) AND (FRK_Press_MfHeader.RationalizationCount = 23)]]></Line>
<Line Number="5"><![CDATA[        AND (FRK_Press_MfHeader.LocalizationCount = 679) THEN]]></Line>
<Line Number="6"><![CDATA[        FOR FRK_Press_AlarmShelfWork.Index := 0 TO 6 DO]]></Line>
<Line Number="7"><![CDATA[            FRK_Press_AlarmShelfWork.Slot := FRK_Press_MfModules[FRK_Press_AlarmShelfWork.Index].CanonicalPathKey - 1;]]></Line>
<Line Number="8"><![CDATA[            IF (FRK_Press_AlarmShelfWork.Slot >= 0) AND (FRK_Press_AlarmShelfWork.Slot < 679) THEN]]></Line>
<Line Number="9"><![CDATA[                FRK_Press_AlarmShelfWork.Seconds := FRK_Press_MfLocalization[FRK_Press_AlarmShelfWork.Slot].PortableKey.LEN;]]></Line>
<Line Number="10"><![CDATA[                IF (FRK_Press_AlarmShelfWork.Seconds > 0) AND (FRK_Press_AlarmShelfWork.Seconds <= 56)]]></Line>
<Line Number="11"><![CDATA[                    AND (FRK_Press_HmiRequest.TargetPath.LEN = FRK_Press_AlarmShelfWork.Seconds) THEN]]></Line>
<Line Number="12"><![CDATA[                    FRK_Press_AlarmShelfWork.Matches := 1;]]></Line>
<Line Number="13"><![CDATA[                    FOR FRK_Press_AlarmShelfWork.Byte := 0 TO FRK_Press_AlarmShelfWork.Seconds - 1 DO]]></Line>
<Line Number="14"><![CDATA[                        IF FRK_Press_HmiRequest.TargetPath.DATA[FRK_Press_AlarmShelfWork.Byte] <> FRK_Press_MfLocalization[FRK_Press_AlarmShelfWork.Slot].PortableKey.DATA[FRK_Press_AlarmShelfWork.Byte] THEN]]></Line>
<Line Number="15"><![CDATA[                            FRK_Press_AlarmShelfWork.Matches := 0;]]></Line>
<Line Number="16"><![CDATA[                        END_IF;]]></Line>
<Line Number="17"><![CDATA[                    END_FOR;]]></Line>
<Line Number="18"><![CDATA[                    IF FRK_Press_AlarmShelfWork.Matches = 1 THEN]]></Line>
<Line Number="19"><![CDATA[                        FRK_Press_AlarmShelfWork.ModuleId := FRK_Press_MfModules[FRK_Press_AlarmShelfWork.Index].ModuleId;]]></Line>
<Line Number="20"><![CDATA[                    END_IF;]]></Line>
<Line Number="21"><![CDATA[                END_IF;]]></Line>
<Line Number="22"><![CDATA[            END_IF;]]></Line>
<Line Number="23"><![CDATA[        END_FOR;]]></Line>
<Line Number="24"><![CDATA[        FOR FRK_Press_AlarmShelfWork.Index := 0 TO 22 DO]]></Line>
<Line Number="25"><![CDATA[            FRK_Press_AlarmShelfWork.Slot := FRK_Press_MfRationalization[FRK_Press_AlarmShelfWork.Index].ActionKey - 1;]]></Line>
<Line Number="26"><![CDATA[            IF (FRK_Press_AlarmShelfWork.Slot >= 0) AND (FRK_Press_AlarmShelfWork.Slot < 679) THEN]]></Line>
<Line Number="27"><![CDATA[                FRK_Press_AlarmShelfWork.Seconds := FRK_Press_MfLocalization[FRK_Press_AlarmShelfWork.Slot].PortableKey.LEN - 7;]]></Line>
<Line Number="28"><![CDATA[                IF (FRK_Press_AlarmShelfWork.Seconds > 0) AND (FRK_Press_AlarmShelfWork.Seconds <= 49)]]></Line>
<Line Number="29"><![CDATA[                    AND (FRK_Press_HmiRequest.TextValue.LEN = FRK_Press_AlarmShelfWork.Seconds) THEN]]></Line>
<Line Number="30"><![CDATA[                    FRK_Press_AlarmShelfWork.Matches := 1;]]></Line>
<Line Number="31"><![CDATA[                    FOR FRK_Press_AlarmShelfWork.Byte := 0 TO FRK_Press_AlarmShelfWork.Seconds - 1 DO]]></Line>
<Line Number="32"><![CDATA[                        IF FRK_Press_HmiRequest.TextValue.DATA[FRK_Press_AlarmShelfWork.Byte] <> FRK_Press_MfLocalization[FRK_Press_AlarmShelfWork.Slot].PortableKey.DATA[FRK_Press_AlarmShelfWork.Byte] THEN]]></Line>
<Line Number="33"><![CDATA[                            FRK_Press_AlarmShelfWork.Matches := 0;]]></Line>
<Line Number="34"><![CDATA[                        END_IF;]]></Line>
<Line Number="35"><![CDATA[                    END_FOR;]]></Line>
<Line Number="36"><![CDATA[                    IF FRK_Press_AlarmShelfWork.Matches = 1 THEN]]></Line>
<Line Number="37"><![CDATA[                        FRK_Press_AlarmShelfWork.Reason := FRK_Press_MfRationalization[FRK_Press_AlarmShelfWork.Index].ReasonCode;]]></Line>
<Line Number="38"><![CDATA[                        IF (FRK_Press_MfRationalization[FRK_Press_AlarmShelfWork.Index].Shelvable = 1)]]></Line>
<Line Number="39"><![CDATA[                            AND ((FRK_Press_MfRationalization[FRK_Press_AlarmShelfWork.Index].Category = 0)]]></Line>
<Line Number="40"><![CDATA[                            OR (FRK_Press_MfRationalization[FRK_Press_AlarmShelfWork.Index].Category = 2)) THEN]]></Line>
<Line Number="41"><![CDATA[                            FRK_Press_AlarmShelfWork.Allowed := 1;]]></Line>
<Line Number="42"><![CDATA[                        ELSE]]></Line>
<Line Number="43"><![CDATA[                            FRK_Press_AlarmShelfWork.Allowed := 0;]]></Line>
<Line Number="44"><![CDATA[                        END_IF;]]></Line>
<Line Number="45"><![CDATA[                    END_IF;]]></Line>
<Line Number="46"><![CDATA[                END_IF;]]></Line>
<Line Number="47"><![CDATA[            END_IF;]]></Line>
<Line Number="48"><![CDATA[        END_FOR;]]></Line>
<Line Number="49"><![CDATA[    END_IF;]]></Line>
<Line Number="50"><![CDATA[END_IF;]]></Line>
<Line Number="51"><![CDATA[FRK_Press_AlarmShelfWork.Matches := 0;]]></Line>
<Line Number="52"><![CDATA[FRK_Press_AlarmShelfWork.Slot := -1;]]></Line>
<Line Number="53"><![CDATA[IF (FRK_Press_AlarmShelfWork.ModuleId > 0) AND (FRK_Press_AlarmShelfWork.Reason <> 0) THEN]]></Line>
<Line Number="54"><![CDATA[    FOR FRK_Press_AlarmShelfWork.Index := 0 TO 15 DO]]></Line>
<Line Number="55"><![CDATA[        IF (FRK_Press_AlarmActive.ActState[FRK_Press_AlarmShelfWork.Index] <> 0)]]></Line>
<Line Number="56"><![CDATA[            AND (FRK_Press_AlarmActive.ActSourceModuleId[FRK_Press_AlarmShelfWork.Index] = FRK_Press_AlarmShelfWork.ModuleId)]]></Line>
<Line Number="57"><![CDATA[            AND (FRK_Press_AlarmActive.ActReasonCode[FRK_Press_AlarmShelfWork.Index] = FRK_Press_AlarmShelfWork.Reason) THEN]]></Line>
<Line Number="58"><![CDATA[            FRK_Press_AlarmShelfWork.Slot := FRK_Press_AlarmShelfWork.Index;]]></Line>
<Line Number="59"><![CDATA[            FRK_Press_AlarmShelfWork.Matches := FRK_Press_AlarmShelfWork.Matches + 1;]]></Line>
<Line Number="60"><![CDATA[        END_IF;]]></Line>
<Line Number="61"><![CDATA[    END_FOR;]]></Line>
<Line Number="62"><![CDATA[END_IF;]]></Line>
<Line Number="63"><![CDATA[IF FRK_Press_AlarmShelfWork.Matches <> 1 THEN]]></Line>
<Line Number="64"><![CDATA[    FRK_Press_HmiResponse.DiagnosticKey := 641;]]></Line>
<Line Number="65"><![CDATA[    (* std.error.alarmIdentityNotUnique *)]]></Line>
<Line Number="66"><![CDATA[ELSE]]></Line>
<Line Number="67"><![CDATA[    IF FRK_Press_HmiRequest.Kind = 20 THEN]]></Line>
<Line Number="68"><![CDATA[        IF (FRK_Press_AlarmShelfWork.Allowed = 0) OR (FRK_Press_HmiRequest.DurationMs < 1000) THEN]]></Line>
<Line Number="69"><![CDATA[            FRK_Press_HmiResponse.DiagnosticKey := 634;]]></Line>
<Line Number="70"><![CDATA[            (* project.mailbox.refused.rejected *)]]></Line>
<Line Number="71"><![CDATA[        ELSE]]></Line>
<Line Number="72"><![CDATA[            FRK_Press_AlarmShelfWork.Seconds := (FRK_Press_HmiRequest.DurationMs - (FRK_Press_HmiRequest.DurationMs MOD 1000)) / 1000;]]></Line>
<Line Number="73"><![CDATA[            IF FRK_Press_AlarmShelfWork.Seconds > 28800 THEN]]></Line>
<Line Number="74"><![CDATA[                FRK_Press_AlarmShelfWork.Seconds := 28800;]]></Line>
<Line Number="75"><![CDATA[            END_IF;]]></Line>
<Line Number="76"><![CDATA[            FRK_Press_AlarmActive.ActShelved[FRK_Press_AlarmShelfWork.Slot] := 1;]]></Line>
<Line Number="77"><![CDATA[            FRK_Press_AlarmShelfWork.RemainingMs[FRK_Press_AlarmShelfWork.Slot] := FRK_Press_AlarmShelfWork.Seconds * 1000;]]></Line>
<Line Number="78"><![CDATA[            FRK_Press_AccessWork.AuditKey := 638;]]></Line>
<Line Number="79"><![CDATA[            FRK_Press_AccessWork.AuditKind := 20;]]></Line>
<Line Number="80"><![CDATA[            FRK_Press_AccessWork.AuditSequence := FRK_Press_HmiLastSequence;]]></Line>
<Line Number="81"><![CDATA[            FRK_Press_AccessWork.AuditAccepted := 1;]]></Line>
<Line Number="82"><![CDATA[            FRK_Press_AccessWork.AuditLength := FRK_Press_AccessState.UserLength;]]></Line>
<Line Number="83"><![CDATA[            FRK_Press_AccessWork.AuditSource := 1;]]></Line>
<Line Number="84"><![CDATA[            FRK_Press_AccessWork.AuditEventSource := FRK_Press_AlarmActive.ActSourceModuleId[FRK_Press_AlarmShelfWork.Slot];]]></Line>
<Line Number="85"><![CDATA[            FRK_Press_AccessWork.AuditGate := 9;]]></Line>
<Line Number="86"><![CDATA[            JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="87"><![CDATA[            FRK_Press_HmiResponse.Accepted := 1;]]></Line>
<Line Number="88"><![CDATA[        END_IF;]]></Line>
<Line Number="89"><![CDATA[    ELSE]]></Line>
<Line Number="90"><![CDATA[        IF FRK_Press_AlarmActive.ActShelved[FRK_Press_AlarmShelfWork.Slot] = 0 THEN]]></Line>
<Line Number="91"><![CDATA[            FRK_Press_HmiResponse.DiagnosticKey := 634;]]></Line>
<Line Number="92"><![CDATA[            (* project.mailbox.refused.rejected *)]]></Line>
<Line Number="93"><![CDATA[        ELSE]]></Line>
<Line Number="94"><![CDATA[            FRK_Press_AlarmActive.ActShelved[FRK_Press_AlarmShelfWork.Slot] := 0;]]></Line>
<Line Number="95"><![CDATA[            FRK_Press_AlarmShelfWork.RemainingMs[FRK_Press_AlarmShelfWork.Slot] := 0;]]></Line>
<Line Number="96"><![CDATA[            FRK_Press_AccessWork.AuditKey := 639;]]></Line>
<Line Number="97"><![CDATA[            FRK_Press_AccessWork.AuditKind := 21;]]></Line>
<Line Number="98"><![CDATA[            FRK_Press_AccessWork.AuditSequence := FRK_Press_HmiLastSequence;]]></Line>
<Line Number="99"><![CDATA[            FRK_Press_AccessWork.AuditAccepted := 1;]]></Line>
<Line Number="100"><![CDATA[            FRK_Press_AccessWork.AuditLength := FRK_Press_AccessState.UserLength;]]></Line>
<Line Number="101"><![CDATA[            FRK_Press_AccessWork.AuditSource := 1;]]></Line>
<Line Number="102"><![CDATA[            FRK_Press_AccessWork.AuditEventSource := FRK_Press_AlarmActive.ActSourceModuleId[FRK_Press_AlarmShelfWork.Slot];]]></Line>
<Line Number="103"><![CDATA[            FRK_Press_AccessWork.AuditGate := 9;]]></Line>
<Line Number="104"><![CDATA[            JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="105"><![CDATA[            FRK_Press_HmiResponse.Accepted := 1;]]></Line>
<Line Number="106"><![CDATA[        END_IF;]]></Line>
<Line Number="107"><![CDATA[    END_IF;]]></Line>
<Line Number="108"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
</Routines>
</Program>
