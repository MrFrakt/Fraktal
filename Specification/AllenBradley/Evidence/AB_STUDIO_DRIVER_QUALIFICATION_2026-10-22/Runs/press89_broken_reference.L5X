<Routine Name="FRK_Press_DataResolveLevel" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_DataWork.Level := 4;]]></Line>
<Line Number="1"><![CDATA[FRK_Press_DataWork.Valid := 0;]]></Line>
<Line Number="2"><![CDATA[IF FRK_Press_DataWork.ClassKey = 0 THEN]]></Line>
<Line Number="3"><![CDATA[    IF FRK_Press_DataWork.ForWrite <> 0 THEN]]></Line>
<Line Number="4"><![CDATA[        FRK_Press_DataWork.Level := FRK_Press_AccessState.Required[1];]]></Line>
<Line Number="5"><![CDATA[    ELSE]]></Line>
<Line Number="6"><![CDATA[        FRK_Press_DataWork.Level := FRK_Press_AccessState.Required[0];]]></Line>
<Line Number="7"><![CDATA[    END_IF;]]></Line>
<Line Number="8"><![CDATA[ELSE]]></Line>
<Line Number="9"><![CDATA[    IF (FRK_Press_DataPolicy.Count >= 0) AND (FRK_Press_DataPolicy.Count <= 2) THEN]]></Line>
<Line Number="10"><![CDATA[        FOR FRK_Press_DataWork.Index := 0 TO FRK_Press_DataPolicy.Count - 1 DO]]></Line>
<Line Number="11"><![CDATA[            IF (FRK_Press_DataWork.Valid = 0)]]></Line>
<Line Number="12"><![CDATA[                AND (FRK_Press_DataPolicy.ClassKey[FRK_Press_DataWork.Index] = FRK_Press_DataWork.ClassKey) THEN]]></Line>
<Line Number="13"><![CDATA[                IF FRK_Press_DataWork.ForWrite <> 0 THEN]]></Line>
<Line Number="14"><![CDATA[                    FRK_Press_DataWork.Level := FRK_Press_DataPolicy.WriteLevel[FRK_Press_DataWork.Index];]]></Line>
<Line Number="15"><![CDATA[                ELSE]]></Line>
<Line Number="16"><![CDATA[                    FRK_Press_DataWork.Level := FRK_Press_DataPolicy.ReadLevel[FRK_Press_DataWork.Index];]]></Line>
<Line Number="17"><![CDATA[                END_IF;]]></Line>
<Line Number="18"><![CDATA[                FRK_Press_DataWork.Valid := 1;]]></Line>
<Line Number="19"><![CDATA[            END_IF;]]></Line>
<Line Number="20"><![CDATA[        END_FOR;]]></Line>
<Line Number="21"><![CDATA[    END_IF;]]></Line>
<Line Number="22"><![CDATA[END_IF;]]></Line>
<Line Number="23"><![CDATA[IF (FRK_Press_DataWork.Level < 0) OR (FRK_Press_DataWork.Level > 4) THEN]]></Line>
<Line Number="24"><![CDATA[    FRK_Press_DataWork.Level := 4;]]></Line>
<Line Number="25"><![CDATA[END_IF;]]></Line>
<Line Number="26"><![CDATA[IF (FRK_Press_DataWork.Minimum < 0) OR (FRK_Press_DataWork.Minimum > 4) THEN]]></Line>
<Line Number="27"><![CDATA[    FRK_Press_DataWork.Level := 4;]]></Line>
<Line Number="28"><![CDATA[ELSIF FRK_Press_DataWork.Minimum > FRK_Press_DataWork.Level THEN]]></Line>
<Line Number="29"><![CDATA[    FRK_Press_DataWork.Level := FRK_Press_DataWork.Minimum;]]></Line>
<Line Number="30"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_DataRefreshLevels" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_DataLevels.Count := 30;]]></Line>
