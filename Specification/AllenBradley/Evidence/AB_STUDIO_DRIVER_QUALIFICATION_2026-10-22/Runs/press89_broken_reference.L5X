<Line Number="359"><![CDATA[                    FOR FRK_Press_HmiWipe := 0 TO 254 DO]]></Line>
<Line Number="360"><![CDATA[                        FRK_Press_HmiRequest.TextValue.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="361"><![CDATA[                    END_FOR;]]></Line>
