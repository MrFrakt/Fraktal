<Member Name="CurTrunc" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[it had more steps than it holds]]></Description></Member>
<Member Name="CurByClass" DataType="DINT" Dimension="5" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[its time by E_TimeClass]]></Description></Member>
<Member Name="LastCycleNo" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[completed cycles; 0 = none yet]]></Description></Member>
<Member Name="LastN" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[steps in the last cycle]]></Description></Member>
<Member Name="LastTrunc" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[the last cycle had more steps than it holds]]></Description></Member>
