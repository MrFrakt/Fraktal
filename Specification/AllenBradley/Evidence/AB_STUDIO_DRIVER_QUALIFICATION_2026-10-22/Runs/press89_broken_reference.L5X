<Line Number="236"><![CDATA[            FRK_Press_AccessWork.High := ((FRK_Press_AccessWork.H[FRK_Press_AccessWork.WordIndex]]]></Line>
<Line Number="237"><![CDATA[                AND -65536) / 65536) + ((FRK_Press_AccessWork.V[FRK_Press_AccessWork.WordIndex] AND -65536) / 65536);]]></Line>
<Line Number="238"><![CDATA[            FRK_Press_AccessWork.High := (FRK_Press_AccessWork.High + ((FRK_Press_AccessWork.Low AND -65536) / 65536))]]></Line>
<Line Number="239"><![CDATA[                AND 65535;]]></Line>
<Line Number="240"><![CDATA[            FRK_Press_AccessWork.H[FRK_Press_AccessWork.WordIndex] := ((FRK_Press_AccessWork.High AND 32767) * 65536)]]></Line>
<Line Number="241"><![CDATA[                OR (FRK_Press_AccessWork.Low AND 65535);]]></Line>
<Line Number="242"><![CDATA[            IF FRK_Press_AccessWork.High >= 32768 THEN]]></Line>
