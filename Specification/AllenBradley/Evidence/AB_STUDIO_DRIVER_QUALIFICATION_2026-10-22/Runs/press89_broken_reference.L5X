<Member Name="StatLast" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[last duration, by chart row]]></Description></Member>
<Member Name="StatMin" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[shortest, by chart row]]></Description></Member>
<Member Name="StatMax" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[longest, by chart row]]></Description></Member>
<Member Name="StatAvg" DataType="DINT" Dimension="32" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[running mean, by chart row]]></Description></Member>
<Member Name="HistoryHead" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[1-based slot of the newest cycle; 0 = none]]></Description></Member>
<Member Name="HisCycleNo" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[trend: cycle]]></Description></Member>
<Member Name="HisTotal" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[trend: its time]]></Description></Member>
<Member Name="HisWork" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[trend: its WORK time]]></Description></Member>
<Member Name="HisByClass" DataType="DINT" Dimension="300" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[trend: its time by class, 5 per cycle]]></Description></Member>
