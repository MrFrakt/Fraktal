<DataValueMember Name="UnitCode" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="CaptureSourceKey" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ClassKey" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="MinReadLevel" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="MinWriteLevel" DataType="DINT" Radix="Decimal" Value="0"/>
</Structure>
</Element>
<Element Index="[31]">
<Structure DataType="FRK_T_PressMfWriteCapV4">
<DataValueMember Name="CapabilityIndex" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="PathKey" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="WriteKeyKey" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="LabelKey" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ConfigKind" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ValueType" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Minimum" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Maximum" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="RequiresReady" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="UnitCode" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="CaptureSourceKey" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ClassKey" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="MinReadLevel" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="MinWriteLevel" DataType="DINT" Radix="Decimal" Value="0"/>
</Structure>
</Element>
</Array>
</Data>
</Tag>
</Tags>
<Programs>
<Program Name="FRK_PressProgram" TestEdits="false" MainRoutineName="FRK_PressMain" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="FRK_PressMain" Type="ST">
<STContent>
<Line Number="0"><![CDATA[JSR(FRK_Press_ScanAccessStartup, 0);]]></Line>
<Line Number="1"><![CDATA[JSR(FRK_PressHmiFrame, 0);]]></Line>
<Line Number="2"><![CDATA[JSR(FRK_PressHmiMailbox, 0);]]></Line>
<Line Number="3"><![CDATA[JSR(FRK_Press_ScanConfigRestore, 0);]]></Line>
<Line Number="4"><![CDATA[FRK_Press_ScanCount := FRK_Press_ScanCount + 1;]]></Line>
<Line Number="5"><![CDATA[FRK_Press_TaskPeriodMs := 10;]]></Line>
<Line Number="6"><![CDATA[JSR(FRK_Press_ScanModules, 0);]]></Line>
<Line Number="7"><![CDATA[JSR(FRK_Press_ScanStart, 0);]]></Line>
<Line Number="8"><![CDATA[JSR(FRK_Press_ScanUnit, 0);]]></Line>
<Line Number="9"><![CDATA[JSR(FRK_Press_ScanHealth, 0);]]></Line>
<Line Number="10"><![CDATA[JSR(FRK_Press_ScanDiagnostics, 0);]]></Line>
<Line Number="11"><![CDATA[JSR(FRK_Press_ScanStatistics, 0);]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_PressHmiFrame" Type="ST">
<STContent>
<Line Number="0"><![CDATA[IF FRK_Press_HmiRequest.Sequence <> FRK_Press_HmiLastSequence THEN]]></Line>
<Line Number="1"><![CDATA[    CPS(FRK_Press_HmiRequest.Frame, FRK_Press_HmiFrameSample, 1);]]></Line>
<Line Number="2"><![CDATA[    FRK_Press_HmiFrameValid := 1;]]></Line>
<Line Number="3"><![CDATA[    IF (FRK_Press_HmiFrameSample.Words[0] <> 1)]]></Line>
<Line Number="4"><![CDATA[        OR (FRK_Press_HmiFrameSample.Words[88] <> FRK_Press_HmiRequest.Sequence) THEN]]></Line>
<Line Number="5"><![CDATA[        FRK_Press_HmiFrameValid := 0;]]></Line>
<Line Number="6"><![CDATA[    END_IF;]]></Line>
<Line Number="7"><![CDATA[    IF (FRK_Press_HmiFrameSample.Words[5] < 0) OR (FRK_Press_HmiFrameSample.Words[5] > 255) THEN]]></Line>
<Line Number="8"><![CDATA[        FRK_Press_HmiFrameValid := 0;]]></Line>
<Line Number="9"><![CDATA[    END_IF;]]></Line>
<Line Number="10"><![CDATA[    FRK_Press_HmiRequest.TargetPath.LEN := 0;]]></Line>
<Line Number="11"><![CDATA[    IF (FRK_Press_HmiFrameSample.Words[6] < 0) OR (FRK_Press_HmiFrameSample.Words[6] > 160) THEN]]></Line>
<Line Number="12"><![CDATA[        FRK_Press_HmiFrameValid := 0;]]></Line>
<Line Number="13"><![CDATA[    END_IF;]]></Line>
<Line Number="14"><![CDATA[    FRK_Press_HmiRequest.NameValue.LEN := 0;]]></Line>
<Line Number="15"><![CDATA[    IF (FRK_Press_HmiFrameSample.Words[7] < 0) OR (FRK_Press_HmiFrameSample.Words[7] > 255) THEN]]></Line>
<Line Number="16"><![CDATA[        FRK_Press_HmiFrameValid := 0;]]></Line>
<Line Number="17"><![CDATA[    END_IF;]]></Line>
<Line Number="18"><![CDATA[    FRK_Press_HmiRequest.TextValue.LEN := 0;]]></Line>
<Line Number="19"><![CDATA[    IF (FRK_Press_HmiFrameSample.Words[8] < 0) OR (FRK_Press_HmiFrameSample.Words[8] > 32) THEN]]></Line>
<Line Number="20"><![CDATA[        FRK_Press_HmiFrameValid := 0;]]></Line>
<Line Number="21"><![CDATA[    END_IF;]]></Line>
<Line Number="22"><![CDATA[    FRK_Press_HmiRequest.User.LEN := 0;]]></Line>
<Line Number="23"><![CDATA[    IF (FRK_Press_HmiFrameSample.Words[9] < 0) OR (FRK_Press_HmiFrameSample.Words[9] > 32) THEN]]></Line>
<Line Number="24"><![CDATA[        FRK_Press_HmiFrameValid := 0;]]></Line>
<Line Number="25"><![CDATA[    END_IF;]]></Line>
<Line Number="26"><![CDATA[    FRK_Press_HmiRequest.Secret.LEN := 0;]]></Line>
<Line Number="27"><![CDATA[    IF FRK_Press_HmiFrameValid <> 0 THEN]]></Line>
<Line Number="28"><![CDATA[        IF (FRK_Press_HmiFrameSample.Words[5] + FRK_Press_HmiFrameSample.Words[6] + FRK_Press_HmiFrameSample.Words[7] + FRK_Press_HmiFrameSample.Words[8] + FRK_Press_HmiFrameSample.Words[9]) > 312 THEN]]></Line>
<Line Number="29"><![CDATA[            FRK_Press_HmiFrameValid := 0;]]></Line>
<Line Number="30"><![CDATA[        END_IF;]]></Line>
<Line Number="31"><![CDATA[    END_IF;]]></Line>
<Line Number="32"><![CDATA[    FRK_Press_HmiRequest.Kind := -1;]]></Line>
<Line Number="33"><![CDATA[    IF FRK_Press_HmiFrameValid <> 0 THEN]]></Line>
<Line Number="34"><![CDATA[        FRK_Press_HmiFrameCursor := 0;]]></Line>
<Line Number="35"><![CDATA[        FOR FRK_Press_HmiFrameField := 5 TO 9 DO]]></Line>
<Line Number="36"><![CDATA[            CASE FRK_Press_HmiFrameField OF]]></Line>
<Line Number="37"><![CDATA[                5:]]></Line>
<Line Number="38"><![CDATA[                    FRK_Press_HmiRequest.TargetPath.LEN := FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameField];]]></Line>
<Line Number="39"><![CDATA[]]></Line>
<Line Number="40"><![CDATA[                6:]]></Line>
<Line Number="41"><![CDATA[                    FRK_Press_HmiRequest.NameValue.LEN := FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameField];]]></Line>
<Line Number="42"><![CDATA[]]></Line>
<Line Number="43"><![CDATA[                7:]]></Line>
<Line Number="44"><![CDATA[                    FRK_Press_HmiRequest.TextValue.LEN := FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameField];]]></Line>
<Line Number="45"><![CDATA[]]></Line>
<Line Number="46"><![CDATA[                8:]]></Line>
<Line Number="47"><![CDATA[                    FRK_Press_HmiRequest.User.LEN := FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameField];]]></Line>
<Line Number="48"><![CDATA[]]></Line>
<Line Number="49"><![CDATA[                9:]]></Line>
<Line Number="50"><![CDATA[                    FRK_Press_HmiRequest.Secret.LEN := FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameField];]]></Line>
<Line Number="51"><![CDATA[            END_CASE;]]></Line>
<Line Number="52"><![CDATA[            FOR FRK_Press_HmiWipe := 0 TO FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameField] - 1 DO]]></Line>
<Line Number="53"><![CDATA[                FRK_Press_HmiFrameWord := 10 + (FRK_Press_HmiFrameCursor - (FRK_Press_HmiFrameCursor MOD 4)) / 4;]]></Line>
<Line Number="54"><![CDATA[                CASE (FRK_Press_HmiFrameCursor MOD 4) OF]]></Line>
<Line Number="55"><![CDATA[                    0:]]></Line>
<Line Number="56"><![CDATA[                        FRK_Press_HmiFrameByte := FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameWord] AND 255;]]></Line>
<Line Number="57"><![CDATA[]]></Line>
<Line Number="58"><![CDATA[                    1:]]></Line>
<Line Number="59"><![CDATA[                        FRK_Press_HmiFrameByte := (FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameWord]]]></Line>
<Line Number="60"><![CDATA[                            AND 65280) / 256;]]></Line>
<Line Number="61"><![CDATA[]]></Line>
<Line Number="62"><![CDATA[                    2:]]></Line>
<Line Number="63"><![CDATA[                        FRK_Press_HmiFrameByte := (FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameWord]]]></Line>
<Line Number="64"><![CDATA[                            AND 16711680) / 65536;]]></Line>
<Line Number="65"><![CDATA[]]></Line>
<Line Number="66"><![CDATA[                    3:]]></Line>
<Line Number="67"><![CDATA[                        FRK_Press_HmiFrameByte := (FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameWord]]]></Line>
<Line Number="68"><![CDATA[                            AND 2130706432) / 16777216;]]></Line>
<Line Number="69"><![CDATA[                        IF FRK_Press_HmiFrameSample.Words[FRK_Press_HmiFrameWord] < 0 THEN]]></Line>
<Line Number="70"><![CDATA[                            FRK_Press_HmiFrameByte := FRK_Press_HmiFrameByte OR 128;]]></Line>
<Line Number="71"><![CDATA[                        END_IF;]]></Line>
<Line Number="72"><![CDATA[                END_CASE;]]></Line>
<Line Number="73"><![CDATA[                IF FRK_Press_HmiFrameByte > 127 THEN]]></Line>
<Line Number="74"><![CDATA[                    FRK_Press_HmiFrameValid := 0;]]></Line>
<Line Number="75"><![CDATA[                END_IF;]]></Line>
<Line Number="76"><![CDATA[                CASE FRK_Press_HmiFrameField OF]]></Line>
<Line Number="77"><![CDATA[                    5:]]></Line>
<Line Number="78"><![CDATA[                        FRK_Press_HmiRequest.TargetPath.DATA[FRK_Press_HmiWipe] := FRK_Press_HmiFrameByte;]]></Line>
<Line Number="79"><![CDATA[]]></Line>
<Line Number="80"><![CDATA[                    6:]]></Line>
<Line Number="81"><![CDATA[                        FRK_Press_HmiRequest.NameValue.DATA[FRK_Press_HmiWipe] := FRK_Press_HmiFrameByte;]]></Line>
<Line Number="82"><![CDATA[]]></Line>
<Line Number="83"><![CDATA[                    7:]]></Line>
<Line Number="84"><![CDATA[                        FRK_Press_HmiRequest.TextValue.DATA[FRK_Press_HmiWipe] := FRK_Press_HmiFrameByte;]]></Line>
<Line Number="85"><![CDATA[]]></Line>
<Line Number="86"><![CDATA[                    8:]]></Line>
<Line Number="87"><![CDATA[                        FRK_Press_HmiRequest.User.DATA[FRK_Press_HmiWipe] := FRK_Press_HmiFrameByte;]]></Line>
<Line Number="88"><![CDATA[]]></Line>
<Line Number="89"><![CDATA[                    9:]]></Line>
<Line Number="90"><![CDATA[                        FRK_Press_HmiRequest.Secret.DATA[FRK_Press_HmiWipe] := FRK_Press_HmiFrameByte;]]></Line>
<Line Number="91"><![CDATA[                END_CASE;]]></Line>
<Line Number="92"><![CDATA[                FRK_Press_HmiFrameCursor := FRK_Press_HmiFrameCursor + 1;]]></Line>
<Line Number="93"><![CDATA[            END_FOR;]]></Line>
<Line Number="94"><![CDATA[        END_FOR;]]></Line>
<Line Number="95"><![CDATA[        IF FRK_Press_HmiFrameValid <> 0 THEN]]></Line>
<Line Number="96"><![CDATA[            FRK_Press_HmiRequest.Kind := FRK_Press_HmiFrameSample.Words[1];]]></Line>
<Line Number="97"><![CDATA[            FRK_Press_HmiRequest.IntValue := FRK_Press_HmiFrameSample.Words[2];]]></Line>
<Line Number="98"><![CDATA[            FRK_Press_HmiRequest.BoolValue := FRK_Press_HmiFrameSample.Words[3];]]></Line>
<Line Number="99"><![CDATA[            FRK_Press_HmiRequest.DurationMs := FRK_Press_HmiFrameSample.Words[4];]]></Line>
<Line Number="100"><![CDATA[        END_IF;]]></Line>
<Line Number="101"><![CDATA[    END_IF;]]></Line>
<Line Number="102"><![CDATA[    FOR FRK_Press_HmiWipe := 0 TO 88 DO]]></Line>
<Line Number="103"><![CDATA[        FRK_Press_HmiRequest.Frame.Words[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="104"><![CDATA[        FRK_Press_HmiFrameSample.Words[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="105"><![CDATA[    END_FOR;]]></Line>
<Line Number="106"><![CDATA[    FRK_Press_HmiFrameCursor := 0;]]></Line>
<Line Number="107"><![CDATA[    FRK_Press_HmiFrameWord := 0;]]></Line>
<Line Number="108"><![CDATA[    FRK_Press_HmiFrameByte := 0;]]></Line>
<Line Number="109"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_PressHmiMailbox" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_AccessWork.HashRan := 0;]]></Line>
<Line Number="1"><![CDATA[FRK_Press_AccessWork.Rearmed := 0;]]></Line>
<Line Number="2"><![CDATA[FRK_Press_AccessWork.Gate := -1;]]></Line>
<Line Number="3"><![CDATA[IF FRK_Press_AccessState.LoginBusy <> 0 THEN]]></Line>
<Line Number="4"><![CDATA[    IF (FRK_Press_AccessWork.Remaining > 0) AND (FRK_Press_AccessWork.Remaining <= 17) THEN]]></Line>
<Line Number="5"><![CDATA[        FRK_Press_AccessWork.HashRan := 1;]]></Line>
<Line Number="6"><![CDATA[        JSR(FRK_Press_AccessSha256, 0);]]></Line>
<Line Number="7"><![CDATA[        IF FRK_Press_AccessWork.HashDone <> 0 THEN]]></Line>
<Line Number="8"><![CDATA[            IF FRK_Press_AccessWork.Remaining > 0 THEN]]></Line>
<Line Number="9"><![CDATA[                FRK_Press_AccessWork.Remaining := FRK_Press_AccessWork.Remaining - 1;]]></Line>
<Line Number="10"><![CDATA[            END_IF;]]></Line>
<Line Number="11"><![CDATA[            IF FRK_Press_AccessWork.Remaining > 0 THEN]]></Line>
<Line Number="12"><![CDATA[                FOR FRK_Press_AccessWork.Index := 0 TO 31 DO]]></Line>
<Line Number="13"><![CDATA[                    FRK_Press_AccessWork.Buffer[FRK_Press_AccessWork.Index] := FRK_Press_AccessWork.Digest[FRK_Press_AccessWork.Index];]]></Line>
<Line Number="14"><![CDATA[                END_FOR;]]></Line>
<Line Number="15"><![CDATA[                FOR FRK_Press_AccessWork.Index := 0 TO 15 DO]]></Line>
<Line Number="16"><![CDATA[                    FRK_Press_AccessWork.Buffer[FRK_Press_AccessWork.Index + 32] := FRK_Press_AccessWork.Salt[FRK_Press_AccessWork.Index];]]></Line>
<Line Number="17"><![CDATA[                END_FOR;]]></Line>
<Line Number="18"><![CDATA[                FRK_Press_AccessWork.Buffer[48] := 128;]]></Line>
<Line Number="19"><![CDATA[                FRK_Press_AccessWork.Buffer[62] := ((48 * 8) AND -256) / 256;]]></Line>
<Line Number="20"><![CDATA[                FRK_Press_AccessWork.Buffer[63] := (48 * 8) AND 255;]]></Line>
<Line Number="21"><![CDATA[                FRK_Press_AccessWork.HashDone := FRK_Broken_Reference_Tag;]]></Line>
<Line Number="22"><![CDATA[            END_IF;]]></Line>
<Line Number="23"><![CDATA[        END_IF;]]></Line>
<Line Number="24"><![CDATA[    ELSE]]></Line>
<Line Number="25"><![CDATA[        FRK_Press_AccessWork.LoginValid := 0;]]></Line>
<Line Number="26"><![CDATA[        FRK_Press_AccessWork.Remaining := 0;]]></Line>
<Line Number="27"><![CDATA[    END_IF;]]></Line>
<Line Number="28"><![CDATA[    IF FRK_Press_AccessWork.Remaining = 0 THEN]]></Line>
<Line Number="29"><![CDATA[        FRK_Press_AccessWork.Difference := 1;]]></Line>
<Line Number="30"><![CDATA[        IF (FRK_Press_AccessWork.Hit >= 0) AND (FRK_Press_AccessWork.LoginValid <> 0) THEN]]></Line>
<Line Number="31"><![CDATA[            FRK_Press_AccessWork.Difference := 0;]]></Line>
<Line Number="32"><![CDATA[            FOR FRK_Press_AccessWork.Index := 0 TO 31 DO]]></Line>
<Line Number="33"><![CDATA[                FRK_Press_AccessWork.Difference := FRK_Press_AccessWork.Difference]]></Line>
<Line Number="34"><![CDATA[                    OR (FRK_Press_AccessWork.Digest[FRK_Press_AccessWork.Index]]]></Line>
<Line Number="35"><![CDATA[                    XOR FRK_Press_AccessUsers.Hash[FRK_Press_AccessWork.Hit * 32 + FRK_Press_AccessWork.Index]);]]></Line>
<Line Number="36"><![CDATA[            END_FOR;]]></Line>
<Line Number="37"><![CDATA[            IF (FRK_Press_AccessUsers.Level[FRK_Press_AccessWork.Hit] < 1)]]></Line>
<Line Number="38"><![CDATA[                OR (FRK_Press_AccessUsers.Level[FRK_Press_AccessWork.Hit] > 4) THEN]]></Line>
<Line Number="39"><![CDATA[                FRK_Press_AccessWork.Difference := 1;]]></Line>
<Line Number="40"><![CDATA[            END_IF;]]></Line>
<Line Number="41"><![CDATA[        END_IF;]]></Line>
<Line Number="42"><![CDATA[        FRK_Press_AccessWork.Gate := -1;]]></Line>
<Line Number="43"><![CDATA[        IF FRK_Press_AccessWork.Difference = 0 THEN]]></Line>
<Line Number="44"><![CDATA[            FRK_Press_AccessState.CurrentLevel := FRK_Press_AccessUsers.Level[FRK_Press_AccessWork.Hit];]]></Line>
<Line Number="45"><![CDATA[            FRK_Press_AccessState.UserLength := FRK_Press_AccessWork.ActorLength;]]></Line>
<Line Number="46"><![CDATA[            FOR FRK_Press_AccessWork.Index := 0 TO 31 DO]]></Line>
<Line Number="47"><![CDATA[                FRK_Press_AccessState.UserBytes[FRK_Press_AccessWork.Index] := FRK_Press_AccessWork.User[FRK_Press_AccessWork.Index];]]></Line>
<Line Number="48"><![CDATA[            END_FOR;]]></Line>
<Line Number="49"><![CDATA[            FRK_Press_AccessState.LoginFailed := 0;]]></Line>
<Line Number="50"><![CDATA[            FRK_Press_AccessWork.IdleMs := 0;]]></Line>
<Line Number="51"><![CDATA[            FRK_Press_AccessWork.Rearmed := 1;]]></Line>
<Line Number="52"><![CDATA[            FRK_Press_AccessWork.AuditKey := 656;]]></Line>
<Line Number="53"><![CDATA[            FRK_Press_AccessWork.AuditKind := 1;]]></Line>
<Line Number="54"><![CDATA[            FRK_Press_AccessWork.AuditSequence := FRK_Press_AccessWork.Sequence;]]></Line>
<Line Number="55"><![CDATA[            FRK_Press_AccessWork.AuditAccepted := 1;]]></Line>
<Line Number="56"><![CDATA[            FRK_Press_AccessWork.AuditLength := FRK_Press_AccessWork.ActorLength;]]></Line>
<Line Number="57"><![CDATA[            FRK_Press_AccessWork.AuditSource := 0;]]></Line>
<Line Number="58"><![CDATA[            FRK_Press_AccessWork.AuditEventSource := 1;]]></Line>
<Line Number="59"><![CDATA[            FRK_Press_AccessWork.AuditGate := FRK_Press_AccessWork.Gate;]]></Line>
<Line Number="60"><![CDATA[            JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="61"><![CDATA[        ELSE]]></Line>
<Line Number="62"><![CDATA[            FRK_Press_AccessState.LoginFailed := 1;]]></Line>
<Line Number="63"><![CDATA[            FRK_Press_AccessWork.AuditKey := 657;]]></Line>
<Line Number="64"><![CDATA[            FRK_Press_AccessWork.AuditKind := 1;]]></Line>
<Line Number="65"><![CDATA[            FRK_Press_AccessWork.AuditSequence := FRK_Press_AccessWork.Sequence;]]></Line>
<Line Number="66"><![CDATA[            FRK_Press_AccessWork.AuditAccepted := 0;]]></Line>
<Line Number="67"><![CDATA[            FRK_Press_AccessWork.AuditLength := FRK_Press_AccessWork.ActorLength;]]></Line>
<Line Number="68"><![CDATA[            FRK_Press_AccessWork.AuditSource := 0;]]></Line>
<Line Number="69"><![CDATA[            FRK_Press_AccessWork.AuditEventSource := 1;]]></Line>
<Line Number="70"><![CDATA[            FRK_Press_AccessWork.AuditGate := FRK_Press_AccessWork.Gate;]]></Line>
<Line Number="71"><![CDATA[            JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="72"><![CDATA[        END_IF;]]></Line>
<Line Number="73"><![CDATA[        FRK_Press_AccessState.LoginResultSequence := FRK_Press_AccessWork.Sequence;]]></Line>
<Line Number="74"><![CDATA[        FRK_Press_AccessState.LoginBusy := 0;]]></Line>
<Line Number="75"><![CDATA[        FRK_Press_AccessWork.Remaining := 0;]]></Line>
<Line Number="76"><![CDATA[        FRK_Press_AccessWork.LoginValid := 0;]]></Line>
<Line Number="77"><![CDATA[        FRK_Press_AccessWork.HashPhase := 0;]]></Line>
<Line Number="78"><![CDATA[        FRK_Press_AccessWork.HashDone := 0;]]></Line>
<Line Number="79"><![CDATA[        FRK_Press_AccessWork.HashCursor := 0;]]></Line>
<Line Number="80"><![CDATA[        FOR FRK_Press_AccessWork.Index := 0 TO 63 DO]]></Line>
<Line Number="81"><![CDATA[            FRK_Press_AccessWork.Buffer[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="82"><![CDATA[            FRK_Press_AccessWork.Words[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="83"><![CDATA[        END_FOR;]]></Line>
<Line Number="84"><![CDATA[        FOR FRK_Press_AccessWork.Index := 0 TO 31 DO]]></Line>
<Line Number="85"><![CDATA[            FRK_Press_AccessWork.Digest[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="86"><![CDATA[            FRK_Press_AccessWork.User[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="87"><![CDATA[        END_FOR;]]></Line>
<Line Number="88"><![CDATA[        FOR FRK_Press_AccessWork.Index := 0 TO 15 DO]]></Line>
<Line Number="89"><![CDATA[            FRK_Press_AccessWork.Salt[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="90"><![CDATA[        END_FOR;]]></Line>
<Line Number="91"><![CDATA[        FOR FRK_Press_AccessWork.Index := 0 TO 7 DO]]></Line>
<Line Number="92"><![CDATA[            FRK_Press_AccessWork.H[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="93"><![CDATA[            FRK_Press_AccessWork.V[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="94"><![CDATA[        END_FOR;]]></Line>
<Line Number="95"><![CDATA[        FOR FRK_Press_AccessWork.Index := 0 TO 4 DO]]></Line>
<Line Number="96"><![CDATA[            FRK_Press_AccessWork.Temp[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="97"><![CDATA[        END_FOR;]]></Line>
<Line Number="98"><![CDATA[        FRK_Press_AccessLoginRequest.Secret.LEN := 0;]]></Line>
<Line Number="99"><![CDATA[        FOR FRK_Press_HmiWipe := 0 TO 31 DO]]></Line>
<Line Number="100"><![CDATA[            FRK_Press_AccessLoginRequest.Secret.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="101"><![CDATA[        END_FOR;]]></Line>
<Line Number="102"><![CDATA[        FRK_Press_AccessLoginRequest.TextValue.LEN := 0;]]></Line>
<Line Number="103"><![CDATA[        FOR FRK_Press_HmiWipe := 0 TO 254 DO]]></Line>
<Line Number="104"><![CDATA[            FRK_Press_AccessLoginRequest.TextValue.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="105"><![CDATA[        END_FOR;]]></Line>
<Line Number="106"><![CDATA[    END_IF;]]></Line>
<Line Number="107"><![CDATA[END_IF;]]></Line>
<Line Number="108"><![CDATA[IF (FRK_Press_AccessState.CurrentLevel > 0) AND (FRK_Press_AccessState.SessionTimeout > 0)]]></Line>
<Line Number="109"><![CDATA[    AND (FRK_Press_AccessWork.Rearmed = 0) THEN]]></Line>
<Line Number="110"><![CDATA[    IF FRK_Press_AccessWork.IdleMs < 604800000 THEN]]></Line>
<Line Number="111"><![CDATA[        FRK_Press_AccessWork.IdleMs := FRK_Press_AccessWork.IdleMs + 10;]]></Line>
<Line Number="112"><![CDATA[    END_IF;]]></Line>
<Line Number="113"><![CDATA[    IF FRK_Press_AccessWork.IdleMs >= FRK_Press_AccessState.SessionTimeout THEN]]></Line>
<Line Number="114"><![CDATA[        FRK_Press_AccessWork.AuditKey := 659;]]></Line>
<Line Number="115"><![CDATA[        FRK_Press_AccessWork.AuditKind := 2;]]></Line>
<Line Number="116"><![CDATA[        FRK_Press_AccessWork.AuditSequence := 0;]]></Line>
<Line Number="117"><![CDATA[        FRK_Press_AccessWork.AuditAccepted := 1;]]></Line>
<Line Number="118"><![CDATA[        FRK_Press_AccessWork.AuditLength := FRK_Press_AccessState.UserLength;]]></Line>
<Line Number="119"><![CDATA[        FRK_Press_AccessWork.AuditSource := 1;]]></Line>
<Line Number="120"><![CDATA[        FRK_Press_AccessWork.AuditEventSource := 1;]]></Line>
<Line Number="121"><![CDATA[        FRK_Press_AccessWork.AuditGate := FRK_Press_AccessWork.Gate;]]></Line>
<Line Number="122"><![CDATA[        JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="123"><![CDATA[        FRK_Press_AccessState.CurrentLevel := 0;]]></Line>
<Line Number="124"><![CDATA[        FRK_Press_AccessState.UserLength := 0;]]></Line>
<Line Number="125"><![CDATA[        FRK_Press_AccessWork.IdleMs := 0;]]></Line>
<Line Number="126"><![CDATA[        FOR FRK_Press_AccessWork.Index := 0 TO 31 DO]]></Line>
<Line Number="127"><![CDATA[            FRK_Press_AccessState.UserBytes[FRK_Press_AccessWork.Index] := 0;]]></Line>
<Line Number="128"><![CDATA[        END_FOR;]]></Line>
<Line Number="129"><![CDATA[    END_IF;]]></Line>
<Line Number="130"><![CDATA[END_IF;]]></Line>
<Line Number="131"><![CDATA[IF (FRK_Press_DataLevels.Count <> 30) OR (FRK_Press_DataWork.SessionLevel <> FRK_Press_AccessState.CurrentLevel) THEN]]></Line>
<Line Number="132"><![CDATA[    JSR(FRK_Press_DataRefreshLevels, 0);]]></Line>
<Line Number="133"><![CDATA[END_IF;]]></Line>
<Line Number="134"><![CDATA[FRK_Press_ConfigPersist.WindowMs := 5000;]]></Line>
<Line Number="135"><![CDATA[IF FRK_Press_ConfigPersist.Pending <> 0 THEN]]></Line>
<Line Number="136"><![CDATA[    IF (FRK_Press_HmiRequest.ConfigSet.StoreAck = FRK_Press_ConfigSetState.PendingSequence)]]></Line>
<Line Number="137"><![CDATA[        AND (FRK_Press_HmiRequest.ConfigSet.StoreResult <> 0) THEN]]></Line>
<Line Number="138"><![CDATA[        FRK_Press_ConfigPersist.Pending := 0;]]></Line>
<Line Number="139"><![CDATA[        FRK_Press_ConfigPersist.Failed := 0;]]></Line>
<Line Number="140"><![CDATA[        IF FRK_Press_HmiRequest.ConfigSet.StoreResult <> 1 THEN]]></Line>
<Line Number="141"><![CDATA[            FRK_Press_ConfigPersist.Failed := 1;]]></Line>
<Line Number="142"><![CDATA[        END_IF;]]></Line>
<Line Number="143"><![CDATA[    ELSIF FRK_Press_ConfigSetState.PendingMs >= 5000 THEN]]></Line>
<Line Number="144"><![CDATA[        FRK_Press_ConfigPersist.Pending := 0;]]></Line>
<Line Number="145"><![CDATA[        FRK_Press_ConfigPersist.Failed := 1;]]></Line>
<Line Number="146"><![CDATA[    ELSE]]></Line>
<Line Number="147"><![CDATA[        FRK_Press_ConfigSetState.PendingMs := FRK_Press_ConfigSetState.PendingMs + 10;]]></Line>
<Line Number="148"><![CDATA[    END_IF;]]></Line>
<Line Number="149"><![CDATA[    IF FRK_Press_ConfigPersist.Failed <> 0 THEN]]></Line>
<Line Number="150"><![CDATA[        IF FRK_Press_ConfigSetState.AuditSequence[FRK_Press_ConfigSetState.PendingSlot] = FRK_Press_ConfigSetState.PendingSequence THEN]]></Line>
<Line Number="151"><![CDATA[            FRK_Press_ConfigSetState.AuditAccepted[FRK_Press_ConfigSetState.PendingSlot] := 0;]]></Line>
<Line Number="152"><![CDATA[            FRK_Press_ConfigSetState.AuditReason[FRK_Press_ConfigSetState.PendingSlot] := 642;]]></Line>
<Line Number="153"><![CDATA[        END_IF;]]></Line>
<Line Number="154"><![CDATA[        FRK_Press_Unit.ReportedReason := 2041;]]></Line>
<Line Number="155"><![CDATA[        FRK_Press_Unit.ReportedSource := 0;]]></Line>
<Line Number="156"><![CDATA[        FRK_Press_Unit.ReportedCount := FRK_Press_Unit.ReportedCount + 1;]]></Line>
<Line Number="157"><![CDATA[        IF FRK_Press_HmiResponse.AckSequence = FRK_Press_ConfigSetState.PendingSequence THEN]]></Line>
<Line Number="158"><![CDATA[            FRK_Press_HmiResponse.Accepted := 0;]]></Line>
<Line Number="159"><![CDATA[            FRK_Press_HmiResponse.DiagnosticKey := 642;]]></Line>
<Line Number="160"><![CDATA[        END_IF;]]></Line>
<Line Number="161"><![CDATA[    END_IF;]]></Line>
<Line Number="162"><![CDATA[END_IF;]]></Line>
<Line Number="163"><![CDATA[(* Lower the one-shot requests raised by an earlier scan.]]></Line>
<Line Number="164"><![CDATA[]]></Line>
<Line Number="165"><![CDATA[   This runs unconditionally, before the sequence check, and that is the]]></Line>
<Line Number="166"><![CDATA[   whole fix for the latch found on the bench on 2026-09-22. The mailbox]]></Line>
<Line Number="167"><![CDATA[   routine is JSR'd first and the Unit AOI runs later in the SAME scan,]]></Line>
<Line Number="168"><![CDATA[   so a request raised below has already been sampled by the time this]]></Line>
<Line Number="169"><![CDATA[   clears it - a one-scan pulse, with no countdown needed.]]></Line>
<Line Number="170"><![CDATA[]]></Line>
<Line Number="171"><![CDATA[   The oracle does not need any of this: _M_HandleHmiRequest calls]]></Line>
<Line Number="172"><![CDATA[   Start() and Stop() directly. This binding maps the same commands onto]]></Line>
<Line Number="173"><![CDATA[   level-sensitive tags that something else samples, and the mapping]]></Line>
<Line Number="174"><![CDATA[   inherited the raise without the lower. While those tags were]]></Line>
<Line Number="175"><![CDATA[   externally writable every client wrote 1 then 0 and supplied the]]></Line>
<Line Number="176"><![CDATA[   deassert itself; closing AB 11.2.1 made the mailbox their only]]></Line>
<Line Number="177"><![CDATA[   writer, which is what turned a latent defect into a blocking one. *)]]></Line>
<Line Number="178"><![CDATA[FRK_Press_AbortRequest := 0;]]></Line>
<Line Number="179"><![CDATA[FRK_Press_ResetRequest := 0;]]></Line>
<Line Number="180"><![CDATA[FRK_Press_DecisionAnswer := 0;]]></Line>
<Line Number="181"><![CDATA[(* ModeRequest and RunRequest are NOT cleared here. ModeRequest is a]]></Line>
<Line Number="182"><![CDATA[   selection compared against Mode, so zeroing it would command AUTO]]></Line>
<Line Number="183"><![CDATA[   every scan. RunRequest is a genuine level - the chain stops when it]]></Line>
<Line Number="184"><![CDATA[   goes low - so STOP lowers it explicitly instead. *)]]></Line>
<Line Number="185"><![CDATA[(* Core 3.10/14: consume one committed request exactly once. *)]]></Line>
<Line Number="186"><![CDATA[IF FRK_Press_HmiRequest.Sequence <> FRK_Press_HmiLastSequence THEN]]></Line>
<Line Number="187"><![CDATA[    FRK_Press_HmiLastSequence := FRK_Press_HmiRequest.Sequence;]]></Line>
<Line Number="188"><![CDATA[    (* Clear the answer before dispatch: no part of the previous one may]]></Line>
<Line Number="189"><![CDATA[       be read as part of this one. *)]]></Line>
<Line Number="190"><![CDATA[    FRK_Press_HmiResponse.Accepted := 0;]]></Line>
<Line Number="191"><![CDATA[    FRK_Press_HmiResponse.DiagnosticKey := 0;]]></Line>
<Line Number="192"><![CDATA[    IF FRK_Press_HmiRequest.Kind <> 1 THEN]]></Line>
<Line Number="193"><![CDATA[        FRK_Press_HmiRequest.Secret.LEN := 0;]]></Line>
<Line Number="194"><![CDATA[        FOR FRK_Press_HmiWipe := 0 TO 31 DO]]></Line>
<Line Number="195"><![CDATA[            FRK_Press_HmiRequest.Secret.DATA[FRK_Press_HmiWipe] := 0;]]></Line>
<Line Number="196"><![CDATA[        END_FOR;]]></Line>
<Line Number="197"><![CDATA[    END_IF;]]></Line>
<Line Number="198"><![CDATA[    FRK_Press_DataLevels.RejectSequence := 0;]]></Line>
<Line Number="199"><![CDATA[    FRK_Press_DataLevels.RejectCapability := 0;]]></Line>
<Line Number="200"><![CDATA[    FRK_Press_DataLevels.RejectRequiredLevel := 0;]]></Line>
<Line Number="201"><![CDATA[    JSR(FRK_Press_DataRefreshLevels, 0);]]></Line>
<Line Number="202"><![CDATA[    FRK_Press_AccessWork.Gate := -1;]]></Line>
<Line Number="203"><![CDATA[    FRK_Press_AccessWork.Minimum := 0;]]></Line>
<Line Number="204"><![CDATA[    FRK_Press_AccessWork.Permitted := 1;]]></Line>
<Line Number="205"><![CDATA[    CASE FRK_Press_HmiRequest.Kind OF]]></Line>
<Line Number="206"><![CDATA[        3:]]></Line>
<Line Number="207"><![CDATA[            FRK_Press_AccessWork.Gate := 4;]]></Line>
<Line Number="208"><![CDATA[]]></Line>
<Line Number="209"><![CDATA[        4:]]></Line>
<Line Number="210"><![CDATA[            FRK_Press_AccessWork.Gate := 3;]]></Line>
<Line Number="211"><![CDATA[]]></Line>
<Line Number="212"><![CDATA[        5:]]></Line>
