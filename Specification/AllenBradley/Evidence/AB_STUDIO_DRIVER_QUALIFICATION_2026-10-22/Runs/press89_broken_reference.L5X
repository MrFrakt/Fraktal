<Line Number="213"><![CDATA[                    AND -65536) / 65536) + ((FRK_Press_AccessWork.Temp[4] AND -65536) / 65536);]]></Line>
<Line Number="214"><![CDATA[                FRK_Press_AccessWork.High := (FRK_Press_AccessWork.High + ((FRK_Press_AccessWork.Low]]></Line>
<Line Number="215"><![CDATA[                    AND -65536) / 65536)) AND 65535;]]></Line>
<Line Number="216"><![CDATA[                FRK_Press_AccessWork.V[0] := ((FRK_Press_AccessWork.High AND 32767) * 65536)]]></Line>
<Line Number="217"><![CDATA[                    OR (FRK_Press_AccessWork.Low AND 65535);]]></Line>
