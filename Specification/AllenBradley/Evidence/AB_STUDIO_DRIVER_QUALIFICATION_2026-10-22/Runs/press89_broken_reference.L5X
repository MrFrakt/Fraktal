</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* std.moduleType.digitalInput: a passive input, TC3's FB_DigitalInputCM. *)]]></Line>
<Line Number="1"><![CDATA[(* Generated from the declaration - never hand-edit. *)]]></Line>
<Line Number="2"><![CDATA[Ctx.ModuleScan := Scan;]]></Line>
<Line Number="3"><![CDATA[IF Ctx.RawValue <> 0 THEN]]></Line>
<Line Number="4"><![CDATA[    Ctx.OutImm_Value := 1;]]></Line>
<Line Number="5"><![CDATA[ELSE]]></Line>
<Line Number="6"><![CDATA[    Ctx.OutImm_Value := 0;]]></Line>
<Line Number="7"><![CDATA[END_IF;]]></Line>
<Line Number="8"><![CDATA[IF Ctx.RawQuality <> 0 THEN]]></Line>
<Line Number="9"><![CDATA[    Ctx.OutImm_Quality := 1;]]></Line>
<Line Number="10"><![CDATA[ELSE]]></Line>
<Line Number="11"><![CDATA[    Ctx.OutImm_Quality := 0;]]></Line>
<Line Number="12"><![CDATA[END_IF;]]></Line>
<Line Number="13"><![CDATA[(* Execute-drop reset: a terminal state clears only when Execute drops *)]]></Line>
<Line Number="14"><![CDATA[IF (Ctx.Execute = 0) AND (Ctx.ExecutePrev <> 0) THEN]]></Line>
<Line Number="15"><![CDATA[    IF (Ctx.Done <> 0) OR (Ctx.Error <> 0) OR (Ctx.Aborted <> 0) THEN]]></Line>
<Line Number="16"><![CDATA[        Ctx.ResetCount := Ctx.ResetCount + 1;]]></Line>
<Line Number="17"><![CDATA[    END_IF;]]></Line>
<Line Number="18"><![CDATA[    Ctx.Done := 0;]]></Line>
<Line Number="19"><![CDATA[    Ctx.Error := 0;]]></Line>
<Line Number="20"><![CDATA[    Ctx.Aborted := 0;]]></Line>
<Line Number="21"><![CDATA[    Ctx.ErrorID := 0;]]></Line>
<Line Number="22"><![CDATA[    Ctx.Busy := 0;]]></Line>
<Line Number="23"><![CDATA[    Ctx.OutImm_Held := 0;]]></Line>
<Line Number="24"><![CDATA[    Ctx.OutImm_Reason := 0;]]></Line>
<Line Number="25"><![CDATA[    Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="26"><![CDATA[    Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="27"><![CDATA[    Ctx.OutImm_ExecState := 0;]]></Line>
<Line Number="28"><![CDATA[END_IF;]]></Line>
<Line Number="29"><![CDATA[(* A passive module takes no command: refused, as TC3 refuses it *)]]></Line>
<Line Number="30"><![CDATA[IF (Ctx.Execute <> 0) AND (Ctx.ExecutePrev = 0) THEN]]></Line>
<Line Number="31"><![CDATA[    Ctx.RunCount := Ctx.RunCount + 1;]]></Line>
<Line Number="32"><![CDATA[    Ctx.Error := 1;]]></Line>
<Line Number="33"><![CDATA[    Ctx.Busy := 0;]]></Line>
<Line Number="34"><![CDATA[    Ctx.ErrorCount := Ctx.ErrorCount + 1;]]></Line>
<Line Number="35"><![CDATA[    Ctx.ErrorID := 2008;]]></Line>
<Line Number="36"><![CDATA[    Ctx.OutImm_Reason := 2008;]]></Line>
<Line Number="37"><![CDATA[    Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="38"><![CDATA[    Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="39"><![CDATA[    Ctx.OutImm_ExecState := 3;]]></Line>
<Line Number="40"><![CDATA[END_IF;]]></Line>
<Line Number="41"><![CDATA[Ctx.ExecutePrev := Ctx.Execute;]]></Line>
</STContent>
</Routine>
</Routines>
