<Line Number="364"><![CDATA[                    FRK_Press_AccessWork.Prior := FRK_Press_HmiRequest.User.LEN;]]></Line>
<Line Number="365"><![CDATA[                    IF (FRK_Press_AccessWork.Prior < 0) OR (FRK_Press_AccessWork.Prior > 32) THEN]]></Line>
<Line Number="366"><![CDATA[                        FRK_Press_AccessWork.Prior := 0;]]></Line>
<Line Number="367"><![CDATA[                    END_IF;]]></Line>
<Line Number="368"><![CDATA[                    FRK_Press_AccessWork.AuditKey := 657;]]></Line>
<Line Number="369"><![CDATA[                    FRK_Press_AccessWork.AuditKind := 1;]]></Line>
