<Member Name="LastWork" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[its WORK time: the real cycle time]]></Description></Member>
<Member Name="LastCycleTime" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[Core §8.11.1: the last cycle's time]]></Description></Member>
<Member Name="MinCycleTime" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[the shortest cycle since download; 0 = none]]></Description></Member>
