<Line Number="345"><![CDATA[            FRK_Press_ReleaseReport.Released := 1;]]></Line>
<Line Number="346"><![CDATA[        ELSE]]></Line>
<Line Number="347"><![CDATA[            FRK_Press_ReleaseReport.Released := 0;]]></Line>
<Line Number="348"><![CDATA[        END_IF;]]></Line>
<Line Number="349"><![CDATA[    ELSE]]></Line>
<Line Number="350"><![CDATA[        CASE FRK_Press_HmiRequest.Kind OF]]></Line>
<Line Number="351"><![CDATA[            1:]]></Line>
<Line Number="352"><![CDATA[                (* LOGIN *)]]></Line>
<Line Number="353"><![CDATA[                IF (FRK_Press_AccessState.LoginBusy <> 0) OR (FRK_Press_AccessWork.HashRan <> 0) THEN]]></Line>
<Line Number="354"><![CDATA[                    FRK_Press_HmiRequest.Secret.LEN := 0;]]></Line>
