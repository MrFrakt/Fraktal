<AddOnInstructionDefinition Name="FRK_M_TwoHand" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-09-07T00:00:00.000Z" CreatedBy="Fraktal" EditedDate="2026-09-07T00:00:00.000Z" EditedBy="Fraktal" SoftwareRevision="v38.00">
<RevisionNote><![CDATA[Fraktal/AB library type std.moduleType.twoHand: Fraktal two-hand start: a start edge from a certified result]]></RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Ctx" TagType="Base" DataType="FRK_T_TwoHandCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Scan" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* std.moduleType.twoHand: a start edge, TC3's FB_TwoHandStartCM. *)]]></Line>
<Line Number="1"><![CDATA[(* Generated from the declaration - never hand-edit. *)]]></Line>
<Line Number="2"><![CDATA[Ctx.ModuleScan := Scan;]]></Line>
<Line Number="3"><![CDATA[Ctx.OutImm_StartPulse := 0;]]></Line>
<Line Number="4"><![CDATA[Ctx.OutCmd_StartAccepted := 0;]]></Line>
<Line Number="5"><![CDATA[IF Ctx.RawLeft <> 0 THEN]]></Line>
<Line Number="6"><![CDATA[    Ctx.OutImm_LeftPressed := 1;]]></Line>
<Line Number="7"><![CDATA[ELSE]]></Line>
<Line Number="8"><![CDATA[    Ctx.OutImm_LeftPressed := 0;]]></Line>
<Line Number="9"><![CDATA[END_IF;]]></Line>
<Line Number="10"><![CDATA[IF Ctx.RawRight <> 0 THEN]]></Line>
<Line Number="11"><![CDATA[    Ctx.OutImm_RightPressed := 1;]]></Line>
<Line Number="12"><![CDATA[ELSE]]></Line>
<Line Number="13"><![CDATA[    Ctx.OutImm_RightPressed := 0;]]></Line>
<Line Number="14"><![CDATA[END_IF;]]></Line>
<Line Number="15"><![CDATA[IF Ctx.RawHealthy <> 0 THEN]]></Line>
<Line Number="16"><![CDATA[    Ctx.OutImm_FieldbusHealthy := 1;]]></Line>
<Line Number="17"><![CDATA[ELSE]]></Line>
<Line Number="18"><![CDATA[    Ctx.OutImm_FieldbusHealthy := 0;]]></Line>
<Line Number="19"><![CDATA[END_IF;]]></Line>
<Line Number="20"><![CDATA[(* SafeActive is the safety system's result, never computed here *)]]></Line>
<Line Number="21"><![CDATA[IF (Ctx.RawSafe <> 0) AND (Ctx.OutImm_FieldbusHealthy <> 0) THEN]]></Line>
<Line Number="22"><![CDATA[    Ctx.OutImm_SafeActive := 1;]]></Line>
<Line Number="23"><![CDATA[ELSE]]></Line>
<Line Number="24"><![CDATA[    Ctx.OutImm_SafeActive := 0;]]></Line>
<Line Number="25"><![CDATA[END_IF;]]></Line>
<Line Number="26"><![CDATA[IF Ctx.OutImm_FieldbusHealthy = 0 THEN]]></Line>
<Line Number="27"><![CDATA[    Ctx.OutImm_Armed := 0;]]></Line>
<Line Number="28"><![CDATA[ELSIF (Ctx.OutImm_LeftPressed = 0) AND (Ctx.OutImm_RightPressed = 0) AND (Ctx.RawSafe = 0) THEN]]></Line>
<Line Number="29"><![CDATA[    Ctx.OutImm_Armed := 1;]]></Line>
<Line Number="30"><![CDATA[END_IF;]]></Line>
<Line Number="31"><![CDATA[IF (Ctx.OutImm_SafeActive <> 0) AND (Ctx.SafePrev = 0) AND ((Ctx.OutImm_Armed <> 0)]]></Line>
<Line Number="32"><![CDATA[    OR (Ctx.Par_RequireRelease = 0)) THEN]]></Line>
<Line Number="33"><![CDATA[    Ctx.OutImm_StartPulse := 1;]]></Line>
<Line Number="34"><![CDATA[    Ctx.OutCmd_StartAccepted := 1;]]></Line>
<Line Number="35"><![CDATA[    Ctx.OutImm_Armed := 0;]]></Line>
<Line Number="36"><![CDATA[END_IF;]]></Line>
<Line Number="37"><![CDATA[Ctx.SafePrev := Ctx.OutImm_SafeActive;]]></Line>
<Line Number="38"><![CDATA[(* Execute-drop reset: a terminal state clears only when Execute drops *)]]></Line>
<Line Number="39"><![CDATA[IF (Ctx.Execute = 0) AND (Ctx.ExecutePrev <> 0) THEN]]></Line>
<Line Number="40"><![CDATA[    IF (Ctx.Done <> 0) OR (Ctx.Error <> 0) OR (Ctx.Aborted <> 0) THEN]]></Line>
<Line Number="41"><![CDATA[        Ctx.ResetCount := Ctx.ResetCount + 1;]]></Line>
<Line Number="42"><![CDATA[    END_IF;]]></Line>
<Line Number="43"><![CDATA[    Ctx.Done := 0;]]></Line>
<Line Number="44"><![CDATA[    Ctx.Error := 0;]]></Line>
<Line Number="45"><![CDATA[    Ctx.Aborted := 0;]]></Line>
<Line Number="46"><![CDATA[    Ctx.ErrorID := 0;]]></Line>
<Line Number="47"><![CDATA[    Ctx.Busy := 0;]]></Line>
<Line Number="48"><![CDATA[    Ctx.OutImm_Held := 0;]]></Line>
<Line Number="49"><![CDATA[    Ctx.OutImm_Reason := 0;]]></Line>
<Line Number="50"><![CDATA[    Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="51"><![CDATA[    Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="52"><![CDATA[    Ctx.OutImm_ExecState := 0;]]></Line>
<Line Number="53"><![CDATA[END_IF;]]></Line>
<Line Number="54"><![CDATA[(* A passive module takes no command: refused, as TC3 refuses it *)]]></Line>
<Line Number="55"><![CDATA[IF (Ctx.Execute <> 0) AND (Ctx.ExecutePrev = 0) THEN]]></Line>
<Line Number="56"><![CDATA[    Ctx.RunCount := Ctx.RunCount + 1;]]></Line>
<Line Number="57"><![CDATA[    Ctx.Error := 1;]]></Line>
<Line Number="58"><![CDATA[    Ctx.Busy := 0;]]></Line>
<Line Number="59"><![CDATA[    Ctx.ErrorCount := Ctx.ErrorCount + 1;]]></Line>
<Line Number="60"><![CDATA[    Ctx.ErrorID := 2008;]]></Line>
<Line Number="61"><![CDATA[    Ctx.OutImm_Reason := 2008;]]></Line>
<Line Number="62"><![CDATA[    Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="63"><![CDATA[    Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="64"><![CDATA[    Ctx.OutImm_ExecState := 3;]]></Line>
<Line Number="65"><![CDATA[END_IF;]]></Line>
<Line Number="66"><![CDATA[Ctx.ExecutePrev := Ctx.Execute;]]></Line>
</STContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="FRK_T_TwoHandCtx"/>
</Dependencies>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="FRK_M_AirPressure" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-09-07T00:00:00.000Z" CreatedBy="Fraktal" EditedDate="2026-09-07T00:00:00.000Z" EditedBy="Fraktal" SoftwareRevision="v38.00">
<RevisionNote><![CDATA[Fraktal/AB library type std.moduleType.airPressure: Fraktal air pressure monitor: two pressure switches]]></RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Ctx" TagType="Base" DataType="FRK_T_AirPressureCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Scan" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* std.moduleType.airPressure: two pressure switches, TC3's FB_AirPressureMonitorCM. *)]]></Line>
<Line Number="1"><![CDATA[(* Generated from the declaration - never hand-edit. *)]]></Line>
<Line Number="2"><![CDATA[Ctx.ModuleScan := Scan;]]></Line>
<Line Number="3"><![CDATA[IF Ctx.RawLow <> 0 THEN]]></Line>
<Line Number="4"><![CDATA[    Ctx.OutImm_LowPressure := 1;]]></Line>
<Line Number="5"><![CDATA[ELSE]]></Line>
<Line Number="6"><![CDATA[    Ctx.OutImm_LowPressure := 0;]]></Line>
<Line Number="7"><![CDATA[END_IF;]]></Line>
<Line Number="8"><![CDATA[IF Ctx.RawOperating <> 0 THEN]]></Line>
<Line Number="9"><![CDATA[    Ctx.OutImm_OperatingPressure := 1;]]></Line>
<Line Number="10"><![CDATA[ELSE]]></Line>
<Line Number="11"><![CDATA[    Ctx.OutImm_OperatingPressure := 0;]]></Line>
<Line Number="12"><![CDATA[END_IF;]]></Line>
<Line Number="13"><![CDATA[IF Ctx.RawQuality <> 0 THEN]]></Line>
<Line Number="14"><![CDATA[    Ctx.OutImm_Quality := 1;]]></Line>
<Line Number="15"><![CDATA[ELSE]]></Line>
<Line Number="16"><![CDATA[    Ctx.OutImm_Quality := 0;]]></Line>
<Line Number="17"><![CDATA[END_IF;]]></Line>
<Line Number="18"><![CDATA[(* TC3's _conflictTimer: both switches on, qualified over ConflictTime *)]]></Line>
<Line Number="19"><![CDATA[IF (Ctx.OutImm_LowPressure <> 0) AND (Ctx.OutImm_OperatingPressure <> 0) THEN]]></Line>
<Line Number="20"><![CDATA[    Ctx.ConflictMs := Ctx.ConflictMs + Ctx.Par_TaskPeriodMs;]]></Line>
<Line Number="21"><![CDATA[ELSE]]></Line>
<Line Number="22"><![CDATA[    Ctx.ConflictMs := 0;]]></Line>
<Line Number="23"><![CDATA[END_IF;]]></Line>
<Line Number="24"><![CDATA[IF (Ctx.OutImm_LowPressure <> 0) AND (Ctx.OutImm_OperatingPressure <> 0)]]></Line>
<Line Number="25"><![CDATA[    AND (Ctx.ConflictMs >= Ctx.Par_ConflictTimeMs) THEN]]></Line>
<Line Number="26"><![CDATA[    Ctx.OutImm_Contradictory := 1;]]></Line>
<Line Number="27"><![CDATA[ELSE]]></Line>
<Line Number="28"><![CDATA[    Ctx.OutImm_Contradictory := 0;]]></Line>
<Line Number="29"><![CDATA[END_IF;]]></Line>
<Line Number="30"><![CDATA[IF (Ctx.OutImm_OperatingPressure <> 0) AND (Ctx.OutImm_LowPressure = 0) AND (Ctx.OutImm_Quality <> 0) THEN]]></Line>
<Line Number="31"><![CDATA[    Ctx.OutImm_PressureOk := 1;]]></Line>
<Line Number="32"><![CDATA[ELSE]]></Line>
<Line Number="33"><![CDATA[    Ctx.OutImm_PressureOk := 0;]]></Line>
<Line Number="34"><![CDATA[END_IF;]]></Line>
<Line Number="35"><![CDATA[(* The conflict is a fault naming both switches, latched until an *)]]></Line>
<Line Number="36"><![CDATA[(* operator reset clears it once the switches agree again (TC3).  *)]]></Line>
<Line Number="37"><![CDATA[IF Ctx.OutImm_Contradictory <> 0 THEN]]></Line>
<Line Number="38"><![CDATA[    IF Ctx.Error = 0 THEN]]></Line>
<Line Number="39"><![CDATA[        Ctx.ErrorCount := Ctx.ErrorCount + 1;]]></Line>
<Line Number="40"><![CDATA[    END_IF;]]></Line>
<Line Number="41"><![CDATA[    Ctx.Error := 1;]]></Line>
<Line Number="42"><![CDATA[    Ctx.ErrorID := 10601;]]></Line>
<Line Number="43"><![CDATA[    Ctx.OutImm_Reason := 10601;]]></Line>
<Line Number="44"><![CDATA[    Ctx.OutImm_IoRoles := 3;]]></Line>
<Line Number="45"><![CDATA[    Ctx.OutImm_Severity := 1;]]></Line>
<Line Number="46"><![CDATA[    Ctx.OutImm_ExecState := 3;]]></Line>
<Line Number="47"><![CDATA[ELSIF (Ctx.ResetRequest <> 0) AND (Ctx.ErrorID = 10601) THEN]]></Line>
<Line Number="48"><![CDATA[    Ctx.ResetCount := Ctx.ResetCount + 1;]]></Line>
<Line Number="49"><![CDATA[    Ctx.Error := 0;]]></Line>
<Line Number="50"><![CDATA[    Ctx.ErrorID := 0;]]></Line>
<Line Number="51"><![CDATA[    Ctx.OutImm_Reason := 0;]]></Line>
<Line Number="52"><![CDATA[    Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="53"><![CDATA[    Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="54"><![CDATA[    Ctx.OutImm_ExecState := 0;]]></Line>
<Line Number="55"><![CDATA[END_IF;]]></Line>
<Line Number="56"><![CDATA[(* Execute-drop reset: a terminal state clears only when Execute drops *)]]></Line>
<Line Number="57"><![CDATA[IF (Ctx.Execute = 0) AND (Ctx.ExecutePrev <> 0) THEN]]></Line>
<Line Number="58"><![CDATA[    IF (Ctx.Done <> 0) OR (Ctx.Error <> 0) OR (Ctx.Aborted <> 0) THEN]]></Line>
<Line Number="59"><![CDATA[        Ctx.ResetCount := Ctx.ResetCount + 1;]]></Line>
<Line Number="60"><![CDATA[    END_IF;]]></Line>
<Line Number="61"><![CDATA[    Ctx.Done := 0;]]></Line>
<Line Number="62"><![CDATA[    Ctx.Error := 0;]]></Line>
<Line Number="63"><![CDATA[    Ctx.Aborted := 0;]]></Line>
<Line Number="64"><![CDATA[    Ctx.ErrorID := 0;]]></Line>
<Line Number="65"><![CDATA[    Ctx.Busy := 0;]]></Line>
<Line Number="66"><![CDATA[    Ctx.OutImm_Held := 0;]]></Line>
<Line Number="67"><![CDATA[    Ctx.OutImm_Reason := 0;]]></Line>
<Line Number="68"><![CDATA[    Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="69"><![CDATA[    Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="70"><![CDATA[    Ctx.OutImm_ExecState := 0;]]></Line>
<Line Number="71"><![CDATA[END_IF;]]></Line>
<Line Number="72"><![CDATA[(* A passive module takes no command: refused, as TC3 refuses it *)]]></Line>
<Line Number="73"><![CDATA[IF (Ctx.Execute <> 0) AND (Ctx.ExecutePrev = 0) THEN]]></Line>
<Line Number="74"><![CDATA[    Ctx.RunCount := Ctx.RunCount + 1;]]></Line>
<Line Number="75"><![CDATA[    Ctx.Error := 1;]]></Line>
<Line Number="76"><![CDATA[    Ctx.Busy := 0;]]></Line>
<Line Number="77"><![CDATA[    Ctx.ErrorCount := Ctx.ErrorCount + 1;]]></Line>
<Line Number="78"><![CDATA[    Ctx.ErrorID := 2008;]]></Line>
<Line Number="79"><![CDATA[    Ctx.OutImm_Reason := 2008;]]></Line>
<Line Number="80"><![CDATA[    Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="81"><![CDATA[    Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="82"><![CDATA[    Ctx.OutImm_ExecState := 3;]]></Line>
<Line Number="83"><![CDATA[END_IF;]]></Line>
<Line Number="84"><![CDATA[Ctx.ExecutePrev := Ctx.Execute;]]></Line>
</STContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="FRK_T_AirPressureCtx"/>
</Dependencies>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="FRK_U_Press" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-09-07T00:00:00.000Z" CreatedBy="Fraktal" EditedDate="2026-09-07T00:00:00.000Z" EditedBy="Fraktal" SoftwareRevision="v38.00">
<RevisionNote><![CDATA[Generated mode owner for Press: chains ['AUTO', 'HOME', 'CHANGEOVER']]]></RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Ctx" TagType="Base" DataType="FRK_T_PressUnitCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Chart" TagType="Base" DataType="FRK_T_PressChart" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Cfg" TagType="Base" DataType="FRK_T_PressParCfg" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="CtxPressRam" TagType="Base" DataType="FRK_T_CylinderCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="CtxDoor" TagType="Base" DataType="FRK_T_CylinderCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="CtxPartSlide" TagType="Base" DataType="FRK_T_CylinderCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="CtxPartPresentSensor" TagType="Base" DataType="FRK_T_DigitalInputCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="CtxTwoHand" TagType="Base" DataType="FRK_T_TwoHandCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="CtxAirPressureMonitor" TagType="Base" DataType="FRK_T_AirPressureCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Scan" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="InTwoHand" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="InPartPresent" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="InAirOk" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
<Parameter Name="InModelRequest" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* Press mode owner. Generated - never hand-edit. *)]]></Line>
<Line Number="1"><![CDATA[(* Ordering is self-checked: every child module must already have run *)]]></Line>
<Line Number="2"><![CDATA[(* this scan. S11 proved the rule for sequences, S16 for commands, and *)]]></Line>
<Line Number="3"><![CDATA[(* a generator that could not detect its own violation would be relying *)]]></Line>
<Line Number="4"><![CDATA[(* on the author having got the call order right. *)]]></Line>
<Line Number="5"><![CDATA[IF CtxPressRam.ModuleScan <> Scan THEN]]></Line>
<Line Number="6"><![CDATA[    Ctx.OrderFail := Ctx.OrderFail + 1;]]></Line>
<Line Number="7"><![CDATA[END_IF;]]></Line>
<Line Number="8"><![CDATA[IF CtxDoor.ModuleScan <> Scan THEN]]></Line>
<Line Number="9"><![CDATA[    Ctx.OrderFail := Ctx.OrderFail + 1;]]></Line>
<Line Number="10"><![CDATA[END_IF;]]></Line>
<Line Number="11"><![CDATA[IF CtxPartSlide.ModuleScan <> Scan THEN]]></Line>
<Line Number="12"><![CDATA[    Ctx.OrderFail := Ctx.OrderFail + 1;]]></Line>
<Line Number="13"><![CDATA[END_IF;]]></Line>
<Line Number="14"><![CDATA[IF CtxPartPresentSensor.ModuleScan <> Scan THEN]]></Line>
<Line Number="15"><![CDATA[    Ctx.OrderFail := Ctx.OrderFail + 1;]]></Line>
<Line Number="16"><![CDATA[END_IF;]]></Line>
<Line Number="17"><![CDATA[IF CtxTwoHand.ModuleScan <> Scan THEN]]></Line>
<Line Number="18"><![CDATA[    Ctx.OrderFail := Ctx.OrderFail + 1;]]></Line>
<Line Number="19"><![CDATA[END_IF;]]></Line>
<Line Number="20"><![CDATA[IF CtxAirPressureMonitor.ModuleScan <> Scan THEN]]></Line>
<Line Number="21"><![CDATA[    Ctx.OrderFail := Ctx.OrderFail + 1;]]></Line>
<Line Number="22"><![CDATA[END_IF;]]></Line>
<Line Number="23"><![CDATA[(* A mode change stands the chain down; it never resumes by itself *)]]></Line>
<Line Number="24"><![CDATA[IF Ctx.ModeRequest <> Ctx.Mode THEN]]></Line>
<Line Number="25"><![CDATA[    Ctx.ModeSwitches := Ctx.ModeSwitches + 1;]]></Line>
<Line Number="26"><![CDATA[    Ctx.Mode := Ctx.ModeRequest;]]></Line>
<Line Number="27"><![CDATA[    Ctx.Step := 0;]]></Line>
<Line Number="28"><![CDATA[    Ctx.PrevStep := -1;]]></Line>
<Line Number="29"><![CDATA[    Ctx.Running := 0;]]></Line>
<Line Number="30"><![CDATA[    Ctx.Complete := 0;]]></Line>
<Line Number="31"><![CDATA[    Chart.StallReason := 0;]]></Line>
<Line Number="32"><![CDATA[    (* Core 3.13: each mode builds its own chart (TC3 OnModeChanged) *)]]></Line>
<Line Number="33"><![CDATA[    Chart.RowEpoch := Chart.RowEpoch + 1;]]></Line>
<Line Number="34"><![CDATA[    Chart.RowCount := 0;]]></Line>
<Line Number="35"><![CDATA[    Ctx.StartLatched := 0;]]></Line>
<Line Number="36"><![CDATA[    IF CtxPressRam.ManualCmd <> 0 THEN]]></Line>
<Line Number="37"><![CDATA[        CtxPressRam.Execute := 0;]]></Line>
<Line Number="38"><![CDATA[        CtxPressRam.ManualCmd := 0;]]></Line>
<Line Number="39"><![CDATA[    END_IF;]]></Line>
<Line Number="40"><![CDATA[    IF CtxDoor.ManualCmd <> 0 THEN]]></Line>
<Line Number="41"><![CDATA[        CtxDoor.Execute := 0;]]></Line>
<Line Number="42"><![CDATA[        CtxDoor.ManualCmd := 0;]]></Line>
<Line Number="43"><![CDATA[    END_IF;]]></Line>
<Line Number="44"><![CDATA[    IF CtxPartSlide.ManualCmd <> 0 THEN]]></Line>
<Line Number="45"><![CDATA[        CtxPartSlide.Execute := 0;]]></Line>
<Line Number="46"><![CDATA[        CtxPartSlide.ManualCmd := 0;]]></Line>
<Line Number="47"><![CDATA[    END_IF;]]></Line>
<Line Number="48"><![CDATA[END_IF;]]></Line>
<Line Number="49"><![CDATA[IF Ctx.ResetRequest <> 0 THEN]]></Line>
<Line Number="50"><![CDATA[    Ctx.Step := 0;]]></Line>
<Line Number="51"><![CDATA[    Ctx.PrevStep := -1;]]></Line>
<Line Number="52"><![CDATA[    Ctx.Error := 0;]]></Line>
<Line Number="53"><![CDATA[    Ctx.ErrorID := 0;]]></Line>
<Line Number="54"><![CDATA[    Ctx.ErrorSource := 0;]]></Line>
<Line Number="55"><![CDATA[    Ctx.Aborted := 0;]]></Line>
<Line Number="56"><![CDATA[    Ctx.Complete := 0;]]></Line>
<Line Number="57"><![CDATA[    Ctx.Running := 0;]]></Line>
<Line Number="58"><![CDATA[    Ctx.StartLatched := 0;]]></Line>
<Line Number="59"><![CDATA[    IF CtxPressRam.ManualCmd <> 0 THEN]]></Line>
<Line Number="60"><![CDATA[        CtxPressRam.Execute := 0;]]></Line>
<Line Number="61"><![CDATA[        CtxPressRam.ManualCmd := 0;]]></Line>
<Line Number="62"><![CDATA[    END_IF;]]></Line>
<Line Number="63"><![CDATA[    IF CtxDoor.ManualCmd <> 0 THEN]]></Line>
<Line Number="64"><![CDATA[        CtxDoor.Execute := 0;]]></Line>
<Line Number="65"><![CDATA[        CtxDoor.ManualCmd := 0;]]></Line>
<Line Number="66"><![CDATA[    END_IF;]]></Line>
<Line Number="67"><![CDATA[    IF CtxPartSlide.ManualCmd <> 0 THEN]]></Line>
<Line Number="68"><![CDATA[        CtxPartSlide.Execute := 0;]]></Line>
<Line Number="69"><![CDATA[        CtxPartSlide.ManualCmd := 0;]]></Line>
<Line Number="70"><![CDATA[    END_IF;]]></Line>
<Line Number="71"><![CDATA[END_IF;]]></Line>
<Line Number="72"><![CDATA[IF Ctx.AbortRequest <> 0 THEN]]></Line>
<Line Number="73"><![CDATA[    Ctx.Aborted := 1;]]></Line>
<Line Number="74"><![CDATA[    Ctx.Running := 0;]]></Line>
<Line Number="75"><![CDATA[    Ctx.Step := 0;]]></Line>
<Line Number="76"><![CDATA[    Ctx.PrevStep := -1;]]></Line>
<Line Number="77"><![CDATA[    Ctx.StartLatched := 0;]]></Line>
<Line Number="78"><![CDATA[    IF CtxPressRam.ManualCmd <> 0 THEN]]></Line>
<Line Number="79"><![CDATA[        CtxPressRam.Execute := 0;]]></Line>
<Line Number="80"><![CDATA[        CtxPressRam.ManualCmd := 0;]]></Line>
<Line Number="81"><![CDATA[    END_IF;]]></Line>
<Line Number="82"><![CDATA[    IF CtxDoor.ManualCmd <> 0 THEN]]></Line>
<Line Number="83"><![CDATA[        CtxDoor.Execute := 0;]]></Line>
<Line Number="84"><![CDATA[        CtxDoor.ManualCmd := 0;]]></Line>
<Line Number="85"><![CDATA[    END_IF;]]></Line>
<Line Number="86"><![CDATA[    IF CtxPartSlide.ManualCmd <> 0 THEN]]></Line>
<Line Number="87"><![CDATA[        CtxPartSlide.Execute := 0;]]></Line>
<Line Number="88"><![CDATA[        CtxPartSlide.ManualCmd := 0;]]></Line>
<Line Number="89"><![CDATA[    END_IF;]]></Line>
<Line Number="90"><![CDATA[END_IF;]]></Line>
<Line Number="91"><![CDATA[(* A completed chain stays completed. Without the Complete guard the *)]]></Line>
<Line Number="92"><![CDATA[(* latch would re-arm the scan after a COMPLETE step stood the chain *)]]></Line>
<Line Number="93"><![CDATA[(* down, and Running would oscillate for as long as the run request  *)]]></Line>
<Line Number="94"><![CDATA[(* was held - a reader would see a different answer every scan.      *)]]></Line>
<Line Number="95"><![CDATA[IF (Ctx.RunRequest <> 0) AND (Ctx.Error = 0) AND (Ctx.Aborted = 0) AND (Ctx.Complete = 0) THEN]]></Line>
<Line Number="96"><![CDATA[    Ctx.Running := 1;]]></Line>
<Line Number="97"><![CDATA[END_IF;]]></Line>
<Line Number="98"><![CDATA[IF Ctx.RunRequest = 0 THEN]]></Line>
<Line Number="99"><![CDATA[    Ctx.Running := 0;]]></Line>
<Line Number="100"><![CDATA[END_IF;]]></Line>
<Line Number="101"><![CDATA[(* A start pulse latches the start the start step waits on - but only *)]]></Line>
<Line Number="102"><![CDATA[(* with what it requires already present, so a press made before the *)]]></Line>
<Line Number="103"><![CDATA[(* part was loaded never starts the stroke when the part arrives.     *)]]></Line>
<Line Number="104"><![CDATA[IF (CtxTwoHand.OutImm_StartPulse <> 0) THEN]]></Line>
<Line Number="105"><![CDATA[    IF (Ctx.Mode = 0) AND (Ctx.Running <> 0) AND (CtxPartPresentSensor.OutImm_Value <> 0)]]></Line>
<Line Number="106"><![CDATA[        AND (CtxPartPresentSensor.OutImm_Quality <> 0) AND (CtxAirPressureMonitor.OutImm_PressureOk <> 0) THEN]]></Line>
<Line Number="107"><![CDATA[        Ctx.StartLatched := 1;]]></Line>
<Line Number="108"><![CDATA[    ELSE]]></Line>
<Line Number="109"><![CDATA[        Ctx.StartLatched := 0;]]></Line>
<Line Number="110"><![CDATA[    END_IF;]]></Line>
<Line Number="111"><![CDATA[END_IF;]]></Line>
<Line Number="112"><![CDATA[(* Lower the pending decision before the chain runs, so only a step *)]]></Line>
<Line Number="113"><![CDATA[(* that is ACTIVE this scan re-raises it. A DECISION step sets      *)]]></Line>
<Line Number="114"><![CDATA[(* DecisionId and nothing else ever cleared it, so the id outlived  *)]]></Line>
<Line Number="115"><![CDATA[(* the step - a chain that had answered and moved on, or been stood *)]]></Line>
<Line Number="116"><![CDATA[(* down entirely, still published a question, and the operator was  *)]]></Line>
<Line Number="117"><![CDATA[(* shown a prompt for a decision that no longer existed. Same shape *)]]></Line>
<Line Number="118"><![CDATA[(* as the mailbox latch: raised on one path, lowered on none.       *)]]></Line>
<Line Number="119"><![CDATA[Ctx.DecisionId := 0;]]></Line>
<Line Number="120"><![CDATA[(* Core 7.6.1: manual commands, in the mode with no sequence *)]]></Line>
<Line Number="121"><![CDATA[IF Ctx.Mode = 1 THEN]]></Line>
<Line Number="122"><![CDATA[    IF CtxPressRam.ManualCmd <> 0 THEN]]></Line>
<Line Number="123"><![CDATA[        IF (CtxPressRam.Done <> 0) OR (CtxPressRam.Aborted <> 0) THEN]]></Line>
<Line Number="124"><![CDATA[            CtxPressRam.Execute := 0;]]></Line>
<Line Number="125"><![CDATA[            CtxPressRam.ManualCmd := 0;]]></Line>
<Line Number="126"><![CDATA[        ELSIF CtxPressRam.Error = 0 THEN]]></Line>
<Line Number="127"><![CDATA[            CtxPressRam.ParCmd_Command := CtxPressRam.ManualCmd;]]></Line>
<Line Number="128"><![CDATA[            IF CtxPressRam.ManualCmd = 1 THEN]]></Line>
<Line Number="129"><![CDATA[                CtxPressRam.ParCmd_Target := 100;]]></Line>
<Line Number="130"><![CDATA[            ELSIF CtxPressRam.ManualCmd = 2 THEN]]></Line>
<Line Number="131"><![CDATA[                CtxPressRam.ParCmd_Target := 0;]]></Line>
<Line Number="132"><![CDATA[            END_IF;]]></Line>
<Line Number="133"><![CDATA[            CtxPressRam.Execute := 1;]]></Line>
<Line Number="134"><![CDATA[        END_IF;]]></Line>
<Line Number="135"><![CDATA[    END_IF;]]></Line>
<Line Number="136"><![CDATA[    IF CtxDoor.ManualCmd <> 0 THEN]]></Line>
<Line Number="137"><![CDATA[        IF (CtxDoor.Done <> 0) OR (CtxDoor.Aborted <> 0) THEN]]></Line>
<Line Number="138"><![CDATA[            CtxDoor.Execute := 0;]]></Line>
<Line Number="139"><![CDATA[            CtxDoor.ManualCmd := 0;]]></Line>
<Line Number="140"><![CDATA[        ELSIF CtxDoor.Error = 0 THEN]]></Line>
<Line Number="141"><![CDATA[            CtxDoor.ParCmd_Command := CtxDoor.ManualCmd;]]></Line>
<Line Number="142"><![CDATA[            IF CtxDoor.ManualCmd = 1 THEN]]></Line>
<Line Number="143"><![CDATA[                CtxDoor.ParCmd_Target := 100;]]></Line>
<Line Number="144"><![CDATA[            ELSIF CtxDoor.ManualCmd = 2 THEN]]></Line>
<Line Number="145"><![CDATA[                CtxDoor.ParCmd_Target := 0;]]></Line>
<Line Number="146"><![CDATA[            END_IF;]]></Line>
<Line Number="147"><![CDATA[            CtxDoor.Execute := 1;]]></Line>
<Line Number="148"><![CDATA[        END_IF;]]></Line>
<Line Number="149"><![CDATA[    END_IF;]]></Line>
<Line Number="150"><![CDATA[    IF CtxPartSlide.ManualCmd <> 0 THEN]]></Line>
<Line Number="151"><![CDATA[        IF (CtxPartSlide.Done <> 0) OR (CtxPartSlide.Aborted <> 0) THEN]]></Line>
<Line Number="152"><![CDATA[            CtxPartSlide.Execute := 0;]]></Line>
<Line Number="153"><![CDATA[            CtxPartSlide.ManualCmd := 0;]]></Line>
<Line Number="154"><![CDATA[        ELSIF CtxPartSlide.Error = 0 THEN]]></Line>
<Line Number="155"><![CDATA[            CtxPartSlide.ParCmd_Command := CtxPartSlide.ManualCmd;]]></Line>
<Line Number="156"><![CDATA[            IF CtxPartSlide.ManualCmd = 1 THEN]]></Line>
<Line Number="157"><![CDATA[                CtxPartSlide.ParCmd_Target := 100;]]></Line>
<Line Number="158"><![CDATA[            ELSIF CtxPartSlide.ManualCmd = 2 THEN]]></Line>
<Line Number="159"><![CDATA[                CtxPartSlide.ParCmd_Target := 0;]]></Line>
<Line Number="160"><![CDATA[            END_IF;]]></Line>
<Line Number="161"><![CDATA[            CtxPartSlide.Execute := 1;]]></Line>
<Line Number="162"><![CDATA[        END_IF;]]></Line>
<Line Number="163"><![CDATA[    END_IF;]]></Line>
<Line Number="164"><![CDATA[END_IF;]]></Line>
<Line Number="165"><![CDATA[(* Core 3.4.2: run-style pacing (TC3 _M_StepGate). NON-SAFETY. *)]]></Line>
<Line Number="166"><![CDATA[IF Ctx.Running = 0 THEN]]></Line>
<Line Number="167"><![CDATA[    Ctx.StepPending := 0;]]></Line>
<Line Number="168"><![CDATA[    Ctx.HoldRun := 0;]]></Line>
<Line Number="169"><![CDATA[END_IF;]]></Line>
<Line Number="170"><![CDATA[IF Ctx.RunStyle = 1 THEN]]></Line>
<Line Number="171"><![CDATA[    Ctx.StepPermit := Ctx.StepPending;]]></Line>
<Line Number="172"><![CDATA[ELSIF Ctx.RunStyle = 2 THEN]]></Line>
<Line Number="173"><![CDATA[    Ctx.StepPermit := Ctx.HoldRun;]]></Line>
<Line Number="174"><![CDATA[ELSE]]></Line>
<Line Number="175"><![CDATA[    Ctx.StepPermit := 1;]]></Line>
<Line Number="176"><![CDATA[END_IF;]]></Line>
<Line Number="177"><![CDATA[IF Ctx.Running <> 0 THEN]]></Line>
<Line Number="178"><![CDATA[    (* AUTO: rendered in LD as program routines *)]]></Line>
<Line Number="179"><![CDATA[    IF Ctx.Mode = 2 THEN]]></Line>
<Line Number="180"><![CDATA[        Chart.ActiveChain := 2;]]></Line>
<Line Number="181"><![CDATA[        CASE Ctx.Step OF]]></Line>
<Line Number="182"><![CDATA[            0:]]></Line>
<Line Number="183"><![CDATA[                (* homeInitialize:  *)]]></Line>
<Line Number="184"><![CDATA[                IF Ctx.Step <> Ctx.PrevStep THEN]]></Line>
<Line Number="185"><![CDATA[                    Chart.StepCursor := 0;]]></Line>
<Line Number="186"><![CDATA[                    Chart.ActiveStepNumber := Ctx.Step;]]></Line>
<Line Number="187"><![CDATA[                    Chart.Visited[0] := 1;]]></Line>
<Line Number="188"><![CDATA[                    Chart.EnterCount[0] := Chart.EnterCount[0] + 1;]]></Line>
<Line Number="189"><![CDATA[                    Chart.CurrentStepMs := 0;]]></Line>
<Line Number="190"><![CDATA[                    Ctx.StepScan := Scan;]]></Line>
<Line Number="191"><![CDATA[                    Ctx.PrevStep := Ctx.Step;]]></Line>
<Line Number="192"><![CDATA[                    Chart.StallReason := 0;]]></Line>
<Line Number="193"><![CDATA[                    IF Chart.RowEpochOf[0] <> Chart.RowEpoch THEN]]></Line>
<Line Number="194"><![CDATA[                        Chart.RowEpochOf[0] := Chart.RowEpoch;]]></Line>
<Line Number="195"><![CDATA[                        Chart.RowCount := Chart.RowCount + 1;]]></Line>
<Line Number="196"><![CDATA[                        Chart.RowOf[0] := Chart.RowCount;]]></Line>
<Line Number="197"><![CDATA[                        Chart.LastMs[0] := 0;]]></Line>
<Line Number="198"><![CDATA[                    END_IF;]]></Line>
<Line Number="199"><![CDATA[                    Chart.WarnReason[0] := 0;]]></Line>
<Line Number="200"><![CDATA[                END_IF;]]></Line>
<Line Number="201"><![CDATA[                Chart.CurrentStepMs := (Scan - Ctx.StepScan) * 10;]]></Line>
<Line Number="202"><![CDATA[                Ctx.Complete := 0;]]></Line>
<Line Number="203"><![CDATA[                Chart.LastMs[0] := Chart.CurrentStepMs;]]></Line>
<Line Number="204"><![CDATA[                Ctx.Step := 900;]]></Line>
<Line Number="205"><![CDATA[]]></Line>
<Line Number="206"><![CDATA[            900:]]></Line>
<Line Number="207"><![CDATA[                (* homeRamUp:  *)]]></Line>
<Line Number="208"><![CDATA[                IF Ctx.Step <> Ctx.PrevStep THEN]]></Line>
<Line Number="209"><![CDATA[                    Chart.StepCursor := 18;]]></Line>
<Line Number="210"><![CDATA[                    Chart.ActiveStepNumber := Ctx.Step;]]></Line>
<Line Number="211"><![CDATA[                    Chart.Visited[18] := 1;]]></Line>
<Line Number="212"><![CDATA[                    Chart.EnterCount[18] := Chart.EnterCount[18] + 1;]]></Line>
<Line Number="213"><![CDATA[                    Chart.CurrentStepMs := 0;]]></Line>
<Line Number="214"><![CDATA[                    Ctx.StepScan := Scan;]]></Line>
<Line Number="215"><![CDATA[                    Ctx.PrevStep := Ctx.Step;]]></Line>
<Line Number="216"><![CDATA[                    Chart.StallReason := 0;]]></Line>
<Line Number="217"><![CDATA[                    IF Chart.RowEpochOf[18] <> Chart.RowEpoch THEN]]></Line>
<Line Number="218"><![CDATA[                        Chart.RowEpochOf[18] := Chart.RowEpoch;]]></Line>
<Line Number="219"><![CDATA[                        Chart.RowCount := Chart.RowCount + 1;]]></Line>
<Line Number="220"><![CDATA[                        Chart.RowOf[18] := Chart.RowCount;]]></Line>
<Line Number="221"><![CDATA[                        Chart.LastMs[18] := 0;]]></Line>
<Line Number="222"><![CDATA[                    END_IF;]]></Line>
<Line Number="223"><![CDATA[                    Chart.WarnReason[18] := 0;]]></Line>
<Line Number="224"><![CDATA[                END_IF;]]></Line>
<Line Number="225"><![CDATA[                Chart.CurrentStepMs := (Scan - Ctx.StepScan) * 10;]]></Line>
<Line Number="226"><![CDATA[                IF Scan = Ctx.StepScan THEN]]></Line>
<Line Number="227"><![CDATA[                    CtxPressRam.Execute := 0;]]></Line>
<Line Number="228"><![CDATA[                    Ctx.Issued := 0;]]></Line>
<Line Number="229"><![CDATA[                ELSE]]></Line>
<Line Number="230"><![CDATA[                    IF (Ctx.Issued = 0) AND (Ctx.StepPermit <> 0) THEN]]></Line>
<Line Number="231"><![CDATA[                        Ctx.Issued := 1;]]></Line>
<Line Number="232"><![CDATA[                        Ctx.StepPending := 0;]]></Line>
<Line Number="233"><![CDATA[                    END_IF;]]></Line>
<Line Number="234"><![CDATA[                    IF Ctx.Issued <> 0 THEN]]></Line>
<Line Number="235"><![CDATA[                        CtxPressRam.ParCmd_Command := 2;]]></Line>
<Line Number="236"><![CDATA[                        CtxPressRam.ParCmd_Target := 0;]]></Line>
<Line Number="237"><![CDATA[                        CtxPressRam.Execute := 1;]]></Line>
<Line Number="238"><![CDATA[                    END_IF;]]></Line>
<Line Number="239"><![CDATA[                    IF CtxPressRam.Done <> 0 THEN]]></Line>
<Line Number="240"><![CDATA[                        CtxPressRam.Execute := 0;]]></Line>
<Line Number="241"><![CDATA[                        Chart.LastMs[18] := Chart.CurrentStepMs;]]></Line>
<Line Number="242"><![CDATA[                        Ctx.Step := 902;]]></Line>
<Line Number="243"><![CDATA[                    ELSIF CtxPressRam.Error <> 0 THEN]]></Line>
<Line Number="244"><![CDATA[                        Chart.StallReason := CtxPressRam.ErrorID;]]></Line>
<Line Number="245"><![CDATA[                    END_IF;]]></Line>
<Line Number="246"><![CDATA[                END_IF;]]></Line>
<Line Number="247"><![CDATA[]]></Line>
<Line Number="248"><![CDATA[            902:]]></Line>
<Line Number="249"><![CDATA[                (* homeDoorOpen:  *)]]></Line>
<Line Number="250"><![CDATA[                IF Ctx.Step <> Ctx.PrevStep THEN]]></Line>
<Line Number="251"><![CDATA[                    Chart.StepCursor := 19;]]></Line>
<Line Number="252"><![CDATA[                    Chart.ActiveStepNumber := Ctx.Step;]]></Line>
<Line Number="253"><![CDATA[                    Chart.Visited[19] := 1;]]></Line>
<Line Number="254"><![CDATA[                    Chart.EnterCount[19] := Chart.EnterCount[19] + 1;]]></Line>
<Line Number="255"><![CDATA[                    Chart.CurrentStepMs := 0;]]></Line>
<Line Number="256"><![CDATA[                    Ctx.StepScan := Scan;]]></Line>
<Line Number="257"><![CDATA[                    Ctx.PrevStep := Ctx.Step;]]></Line>
<Line Number="258"><![CDATA[                    Chart.StallReason := 0;]]></Line>
<Line Number="259"><![CDATA[                    IF Chart.RowEpochOf[19] <> Chart.RowEpoch THEN]]></Line>
<Line Number="260"><![CDATA[                        Chart.RowEpochOf[19] := Chart.RowEpoch;]]></Line>
<Line Number="261"><![CDATA[                        Chart.RowCount := Chart.RowCount + 1;]]></Line>
<Line Number="262"><![CDATA[                        Chart.RowOf[19] := Chart.RowCount;]]></Line>
<Line Number="263"><![CDATA[                        Chart.LastMs[19] := 0;]]></Line>
<Line Number="264"><![CDATA[                    END_IF;]]></Line>
<Line Number="265"><![CDATA[                    Chart.WarnReason[19] := 0;]]></Line>
<Line Number="266"><![CDATA[                END_IF;]]></Line>
<Line Number="267"><![CDATA[                Chart.CurrentStepMs := (Scan - Ctx.StepScan) * 10;]]></Line>
<Line Number="268"><![CDATA[                IF Scan = Ctx.StepScan THEN]]></Line>
<Line Number="269"><![CDATA[                    CtxDoor.Execute := 0;]]></Line>
<Line Number="270"><![CDATA[                    Ctx.Issued := 0;]]></Line>
<Line Number="271"><![CDATA[                ELSE]]></Line>
<Line Number="272"><![CDATA[                    IF (Ctx.Issued = 0) AND (Ctx.StepPermit <> 0) THEN]]></Line>
<Line Number="273"><![CDATA[                        Ctx.Issued := 1;]]></Line>
<Line Number="274"><![CDATA[                        Ctx.StepPending := 0;]]></Line>
