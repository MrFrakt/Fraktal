<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="FRK_M_Cylinder" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-09-07T00:00:00.000Z" CreatedBy="Fraktal" EditedDate="2026-09-07T00:00:00.000Z" EditedBy="Fraktal" SoftwareRevision="v38.00">
<RevisionNote><![CDATA[Fraktal/AB library type std.moduleType.cylinder: Fraktal cylinder: Core §6.1 handshake over a positional plant]]></RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Ctx" TagType="Base" DataType="FRK_T_CylinderCtx" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="Scan" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0"><![CDATA[(* std.moduleType.cylinder: Core §6.1 handshake over a simulated plant. *)]]></Line>
<Line Number="1"><![CDATA[(* Generated from the declaration - never hand-edit. *)]]></Line>
<Line Number="2"><![CDATA[Ctx.ModuleScan := Scan;]]></Line>
<Line Number="3"><![CDATA[IF Ctx.Par_TaskPeriodMs > 0 THEN]]></Line>
<Line Number="4"><![CDATA[    Ctx.Par_TimeoutScans := Ctx.Par_TimeoutMs / Ctx.Par_TaskPeriodMs;]]></Line>
<Line Number="5"><![CDATA[ELSE]]></Line>
<Line Number="6"><![CDATA[    Ctx.Par_TimeoutScans := 0;]]></Line>
<Line Number="7"><![CDATA[END_IF;]]></Line>
<Line Number="8"><![CDATA[(* Execute-drop reset: a terminal state clears only when Execute drops *)]]></Line>
<Line Number="9"><![CDATA[IF Ctx.Execute = 0 THEN]]></Line>
<Line Number="10"><![CDATA[    IF (Ctx.Done <> 0) OR (Ctx.Error <> 0) OR (Ctx.Aborted <> 0) THEN]]></Line>
<Line Number="11"><![CDATA[        Ctx.ResetCount := Ctx.ResetCount + 1;]]></Line>
<Line Number="12"><![CDATA[    END_IF;]]></Line>
<Line Number="13"><![CDATA[    Ctx.Done := 0;]]></Line>
<Line Number="14"><![CDATA[    Ctx.Error := 0;]]></Line>
<Line Number="15"><![CDATA[    Ctx.Aborted := 0;]]></Line>
<Line Number="16"><![CDATA[    Ctx.ErrorID := 0;]]></Line>
<Line Number="17"><![CDATA[    Ctx.Busy := 0;]]></Line>
<Line Number="18"><![CDATA[    Ctx.OutImm_Held := 0;]]></Line>
<Line Number="19"><![CDATA[    Ctx.OutImm_Reason := 0;]]></Line>
<Line Number="20"><![CDATA[    Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="21"><![CDATA[    Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="22"><![CDATA[    Ctx.OutImm_ExecState := 0;]]></Line>
<Line Number="23"><![CDATA[    Ctx.ElapsedMs := 0;]]></Line>
<Line Number="24"><![CDATA[END_IF;]]></Line>
<Line Number="25"><![CDATA[(* Rising edge accepts the command and latches the request *)]]></Line>
<Line Number="26"><![CDATA[IF (Ctx.Execute <> 0) AND (Ctx.ExecutePrev = 0) THEN]]></Line>
<Line Number="27"><![CDATA[    Ctx.ParCmd_Latched := Ctx.ParCmd_Target;]]></Line>
<Line Number="28"><![CDATA[    Ctx.Busy := 1;]]></Line>
<Line Number="29"><![CDATA[    Ctx.OutImm_ExecState := 1;]]></Line>
<Line Number="30"><![CDATA[    Ctx.RunCount := Ctx.RunCount + 1;]]></Line>
<Line Number="31"><![CDATA[    Ctx.ElapsedMs := 0;]]></Line>
<Line Number="32"><![CDATA[    Ctx.TimMs := 0;]]></Line>
<Line Number="33"><![CDATA[END_IF;]]></Line>
<Line Number="34"><![CDATA[IF Ctx.Busy <> 0 THEN]]></Line>
<Line Number="35"><![CDATA[    (* 8.11.4(a): a command's time runs from acceptance to its end, holds *)]]></Line>
<Line Number="36"><![CDATA[    (* included - unlike ElapsedMs, which a hold must not time out. *)]]></Line>
<Line Number="37"><![CDATA[    IF Ctx.TimMs < 2000000000 THEN]]></Line>
<Line Number="38"><![CDATA[        Ctx.TimMs := Ctx.TimMs + Ctx.Par_TaskPeriodMs;]]></Line>
<Line Number="39"><![CDATA[    END_IF;]]></Line>
<Line Number="40"><![CDATA[    IF Ctx.Abort <> 0 THEN]]></Line>
<Line Number="41"><![CDATA[        Ctx.Aborted := 1;]]></Line>
<Line Number="42"><![CDATA[        Ctx.Busy := 0;]]></Line>
<Line Number="43"><![CDATA[        Ctx.AbortCount := Ctx.AbortCount + 1;]]></Line>
<Line Number="44"><![CDATA[        Ctx.OutImm_ExecState := 4;]]></Line>
<Line Number="45"><![CDATA[        Ctx.OutImm_Severity := 2;]]></Line>
<Line Number="46"><![CDATA[    ELSIF Ctx.Par_TaskPeriodMs <= 0 THEN]]></Line>
<Line Number="47"><![CDATA[        Ctx.Error := 1;]]></Line>
<Line Number="48"><![CDATA[        Ctx.Busy := 0;]]></Line>
<Line Number="49"><![CDATA[        Ctx.ErrorCount := Ctx.ErrorCount + 1;]]></Line>
<Line Number="50"><![CDATA[        Ctx.ErrorID := 10115;]]></Line>
<Line Number="51"><![CDATA[        Ctx.OutImm_Reason := 10115;]]></Line>
<Line Number="52"><![CDATA[        Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="53"><![CDATA[        Ctx.OutImm_Severity := 1;]]></Line>
<Line Number="54"><![CDATA[        Ctx.OutImm_ExecState := 3;]]></Line>
<Line Number="55"><![CDATA[    ELSIF (Ctx.HoldRequest <> 0) OR (Ctx.AreaSafe = 0) OR (Ctx.Permit = 0) THEN]]></Line>
<Line Number="56"><![CDATA[        (* Held: BUSY, a LOW named reason, and no Error. The elapsed clock is *)]]></Line>
<Line Number="57"><![CDATA[        (* deliberately NOT advanced here, so a held command never times out. *)]]></Line>
<Line Number="58"><![CDATA[        Ctx.OutImm_Held := 1;]]></Line>
<Line Number="59"><![CDATA[        Ctx.OutImm_Reason := 2003;]]></Line>
<Line Number="60"><![CDATA[        Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="61"><![CDATA[        Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="62"><![CDATA[        Ctx.OutImm_ExecState := 1;]]></Line>
<Line Number="63"><![CDATA[        Ctx.HeldScans := Ctx.HeldScans + 1;]]></Line>
<Line Number="64"><![CDATA[    ELSE]]></Line>
<Line Number="65"><![CDATA[        Ctx.OutImm_Held := 0;]]></Line>
<Line Number="66"><![CDATA[        Ctx.OutImm_Reason := 0;]]></Line>
<Line Number="67"><![CDATA[        Ctx.OutImm_IoRoles := 0;]]></Line>
<Line Number="68"><![CDATA[        Ctx.OutImm_Severity := 0;]]></Line>
<Line Number="69"><![CDATA[        Ctx.ElapsedMs := Ctx.ElapsedMs + Ctx.Par_TaskPeriodMs;]]></Line>
<Line Number="70"><![CDATA[        IF Ctx.FaultRequest <> 0 THEN]]></Line>
<Line Number="71"><![CDATA[            Ctx.FaultScans := Ctx.FaultScans + 1;]]></Line>
<Line Number="72"><![CDATA[        ELSIF Ctx.OutImm_Pos < Ctx.ParCmd_Latched THEN]]></Line>
<Line Number="73"><![CDATA[            Ctx.OutImm_Pos := Ctx.OutImm_Pos + Ctx.Par_Speed;]]></Line>
<Line Number="74"><![CDATA[            IF Ctx.OutImm_Pos > Ctx.ParCmd_Latched THEN]]></Line>
<Line Number="75"><![CDATA[                Ctx.OutImm_Pos := Ctx.ParCmd_Latched;]]></Line>
<Line Number="76"><![CDATA[            END_IF;]]></Line>
<Line Number="77"><![CDATA[        ELSIF Ctx.OutImm_Pos > Ctx.ParCmd_Latched THEN]]></Line>
<Line Number="78"><![CDATA[            Ctx.OutImm_Pos := Ctx.OutImm_Pos - Ctx.Par_Speed;]]></Line>
<Line Number="79"><![CDATA[            IF Ctx.OutImm_Pos < Ctx.ParCmd_Latched THEN]]></Line>
<Line Number="80"><![CDATA[                Ctx.OutImm_Pos := Ctx.ParCmd_Latched;]]></Line>
<Line Number="81"><![CDATA[            END_IF;]]></Line>
<Line Number="82"><![CDATA[        END_IF;]]></Line>
<Line Number="83"><![CDATA[        IF Ctx.OutImm_Pos = Ctx.ParCmd_Latched THEN]]></Line>
<Line Number="84"><![CDATA[            Ctx.Done := 1;]]></Line>
<Line Number="85"><![CDATA[            Ctx.Busy := 0;]]></Line>
<Line Number="86"><![CDATA[            Ctx.DoneCount := Ctx.DoneCount + 1;]]></Line>
<Line Number="87"><![CDATA[            Ctx.OutCmd_FinalPos := Ctx.OutImm_Pos;]]></Line>
<Line Number="88"><![CDATA[            Ctx.OutCmd_Ok := 1;]]></Line>
<Line Number="89"><![CDATA[            Ctx.OutImm_ExecState := 2;]]></Line>
<Line Number="90"><![CDATA[        ELSIF Ctx.ElapsedMs >= Ctx.Par_TimeoutMs THEN]]></Line>
<Line Number="91"><![CDATA[            Ctx.Error := 1;]]></Line>
<Line Number="92"><![CDATA[            Ctx.Busy := 0;]]></Line>
<Line Number="93"><![CDATA[            Ctx.ErrorCount := Ctx.ErrorCount + 1;]]></Line>
<Line Number="94"><![CDATA[            IF Ctx.ParCmd_Latched > Ctx.OutImm_Pos THEN]]></Line>
<Line Number="95"><![CDATA[                Ctx.ErrorID := 10101;]]></Line>
<Line Number="96"><![CDATA[                Ctx.OutImm_Reason := 10101;]]></Line>
<Line Number="97"><![CDATA[                Ctx.OutImm_IoRoles := 2;]]></Line>
<Line Number="98"><![CDATA[                Ctx.OutImm_Severity := 1;]]></Line>
<Line Number="99"><![CDATA[            ELSE]]></Line>
<Line Number="100"><![CDATA[                Ctx.ErrorID := 10102;]]></Line>
<Line Number="101"><![CDATA[                Ctx.OutImm_Reason := 10102;]]></Line>
<Line Number="102"><![CDATA[                Ctx.OutImm_IoRoles := 1;]]></Line>
<Line Number="103"><![CDATA[                Ctx.OutImm_Severity := 1;]]></Line>
<Line Number="104"><![CDATA[            END_IF;]]></Line>
<Line Number="105"><![CDATA[            Ctx.OutImm_ExecState := 3;]]></Line>
<Line Number="106"><![CDATA[        END_IF;]]></Line>
<Line Number="107"><![CDATA[    END_IF;]]></Line>
<Line Number="108"><![CDATA[END_IF;]]></Line>
<Line Number="109"><![CDATA[(* The end sensors, from where the plant is: TC3's ExtendedFb and *)]]></Line>
<Line Number="110"><![CDATA[(* RetractedFb, read by the permits of the modules around this one. *)]]></Line>
<Line Number="111"><![CDATA[IF Ctx.OutImm_Pos >= 100 THEN]]></Line>
<Line Number="112"><![CDATA[    Ctx.OutImm_Extended := 1;]]></Line>
<Line Number="113"><![CDATA[ELSE]]></Line>
<Line Number="114"><![CDATA[    Ctx.OutImm_Extended := 0;]]></Line>
<Line Number="115"><![CDATA[END_IF;]]></Line>
<Line Number="116"><![CDATA[IF Ctx.OutImm_Pos <= 0 THEN]]></Line>
<Line Number="117"><![CDATA[    Ctx.OutImm_Retracted := 1;]]></Line>
<Line Number="118"><![CDATA[ELSE]]></Line>
<Line Number="119"><![CDATA[    Ctx.OutImm_Retracted := 0;]]></Line>
<Line Number="120"><![CDATA[END_IF;]]></Line>
<Line Number="121"><![CDATA[(* Core 8.11.4(a): command timing (TC3 _M_RecordCmdTiming) *)]]></Line>
<Line Number="122"><![CDATA[IF (Ctx.DoneCount + Ctx.ErrorCount + Ctx.AbortCount) <> Ctx.TimSeen THEN]]></Line>
<Line Number="123"><![CDATA[    Ctx.TimSeen := Ctx.DoneCount + Ctx.ErrorCount + Ctx.AbortCount;]]></Line>
<Line Number="124"><![CDATA[    IF (Ctx.ParCmd_Command >= 1) AND (Ctx.ParCmd_Command <= 8) THEN]]></Line>
<Line Number="125"><![CDATA[        Ctx.TimSlot := Ctx.ParCmd_Command - 1;]]></Line>
<Line Number="126"><![CDATA[        Ctx.TimCount[Ctx.TimSlot] := Ctx.TimCount[Ctx.TimSlot] + 1;]]></Line>
<Line Number="127"><![CDATA[        Ctx.TimLast[Ctx.TimSlot] := Ctx.TimMs;]]></Line>
<Line Number="128"><![CDATA[        IF (Ctx.TimCount[Ctx.TimSlot] = 1) OR (Ctx.TimMs < Ctx.TimMin[Ctx.TimSlot]) THEN]]></Line>
<Line Number="129"><![CDATA[            Ctx.TimMin[Ctx.TimSlot] := Ctx.TimMs;]]></Line>
<Line Number="130"><![CDATA[        END_IF;]]></Line>
<Line Number="131"><![CDATA[        IF Ctx.TimMs > Ctx.TimMax[Ctx.TimSlot] THEN]]></Line>
<Line Number="132"><![CDATA[            Ctx.TimMax[Ctx.TimSlot] := Ctx.TimMs;]]></Line>
<Line Number="133"><![CDATA[        END_IF;]]></Line>
<Line Number="134"><![CDATA[        Ctx.TimAvg[Ctx.TimSlot] := Ctx.TimAvg[Ctx.TimSlot] + ((Ctx.TimMs - Ctx.TimAvg[Ctx.TimSlot]) / Ctx.TimCount[Ctx.TimSlot]);]]></Line>
<Line Number="135"><![CDATA[    ELSE]]></Line>
<Line Number="136"><![CDATA[        Ctx.TimTrunc := 1;]]></Line>
<Line Number="137"><![CDATA[    END_IF;]]></Line>
<Line Number="138"><![CDATA[END_IF;]]></Line>
<Line Number="139"><![CDATA[Ctx.ExecutePrev := Ctx.Execute;]]></Line>
</STContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="FRK_T_CylinderCtx"/>
</Dependencies>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="FRK_M_DigitalInput" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-09-07T00:00:00.000Z" CreatedBy="Fraktal" EditedDate="2026-09-07T00:00:00.000Z" EditedBy="Fraktal" SoftwareRevision="v38.00">
