<Line Number="593"><![CDATA[                    IF Chart.RowEpochOf[27] <> Chart.RowEpoch THEN]]></Line>
<Line Number="594"><![CDATA[                        Chart.RowEpochOf[27] := Chart.RowEpoch;]]></Line>
<Line Number="595"><![CDATA[                        Chart.RowCount := Chart.RowCount + 1;]]></Line>
<Line Number="596"><![CDATA[                        Chart.RowOf[27] := Chart.RowCount;]]></Line>
<Line Number="597"><![CDATA[                        Chart.LastMs[27] := 0;]]></Line>
<Line Number="598"><![CDATA[                    END_IF;]]></Line>
<Line Number="599"><![CDATA[                    Chart.WarnReason[27] := 0;]]></Line>
<Line Number="600"><![CDATA[                END_IF;]]></Line>
<Line Number="601"><![CDATA[                Chart.CurrentStepMs := (Scan - Ctx.StepScan) * 10;]]></Line>
<Line Number="602"><![CDATA[                IF Ctx.ModelRequest >= 1 THEN]]></Line>
<Line Number="603"><![CDATA[                    Ctx.CommitModel := Ctx.ModelRequest;]]></Line>
<Line Number="604"><![CDATA[                    Ctx.ModelOrdinal := Ctx.ModelRequest;]]></Line>
<Line Number="605"><![CDATA[                END_IF;]]></Line>
<Line Number="606"><![CDATA[                Chart.LastMs[27] := Chart.CurrentStepMs;]]></Line>
<Line Number="607"><![CDATA[                Ctx.Step := 798;]]></Line>
<Line Number="608"><![CDATA[]]></Line>
<Line Number="609"><![CDATA[            798:]]></Line>
<Line Number="610"><![CDATA[                (* changeoverComplete: the press is configured for the selected model *)]]></Line>
<Line Number="611"><![CDATA[                IF Ctx.Step <> Ctx.PrevStep THEN]]></Line>
<Line Number="612"><![CDATA[                    Chart.StepCursor := 28;]]></Line>
<Line Number="613"><![CDATA[                    Chart.ActiveStepNumber := Ctx.Step;]]></Line>
<Line Number="614"><![CDATA[                    Chart.Visited[28] := 1;]]></Line>
<Line Number="615"><![CDATA[                    Chart.EnterCount[28] := Chart.EnterCount[28] + 1;]]></Line>
<Line Number="616"><![CDATA[                    Chart.CurrentStepMs := 0;]]></Line>
<Line Number="617"><![CDATA[                    Ctx.StepScan := Scan;]]></Line>
<Line Number="618"><![CDATA[                    Ctx.PrevStep := Ctx.Step;]]></Line>
<Line Number="619"><![CDATA[                    Chart.StallReason := 0;]]></Line>
<Line Number="620"><![CDATA[                    IF Chart.RowEpochOf[28] <> Chart.RowEpoch THEN]]></Line>
<Line Number="621"><![CDATA[                        Chart.RowEpochOf[28] := Chart.RowEpoch;]]></Line>
<Line Number="622"><![CDATA[                        Chart.RowCount := Chart.RowCount + 1;]]></Line>
<Line Number="623"><![CDATA[                        Chart.RowOf[28] := Chart.RowCount;]]></Line>
<Line Number="624"><![CDATA[                        Chart.LastMs[28] := 0;]]></Line>
<Line Number="625"><![CDATA[                    END_IF;]]></Line>
<Line Number="626"><![CDATA[                    Chart.WarnReason[28] := 0;]]></Line>
<Line Number="627"><![CDATA[                END_IF;]]></Line>
<Line Number="628"><![CDATA[                Chart.CurrentStepMs := (Scan - Ctx.StepScan) * 10;]]></Line>
<Line Number="629"><![CDATA[                Ctx.Complete := 1;]]></Line>
<Line Number="630"><![CDATA[                Ctx.Running := 0;]]></Line>
<Line Number="631"><![CDATA[                Chart.StallReason := 0;]]></Line>
<Line Number="632"><![CDATA[            ELSE]]></Line>
<Line Number="633"><![CDATA[                (* CASE ELSE - undeclared step. A stall fallback, not a declared transition. *)]]></Line>
<Line Number="634"><![CDATA[                Chart.StallReason := 2005;]]></Line>
<Line Number="635"><![CDATA[                Ctx.Step := 0;]]></Line>
<Line Number="636"><![CDATA[        END_CASE;]]></Line>
<Line Number="637"><![CDATA[    END_IF;]]></Line>
<Line Number="638"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
</Routines>
