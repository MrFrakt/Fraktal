<Line Number="268"><![CDATA[]]></Line>
<Line Number="269"><![CDATA[        27:]]></Line>
<Line Number="270"><![CDATA[            FRK_Press_AccessWork.Gate := 1;]]></Line>
<Line Number="271"><![CDATA[]]></Line>
<Line Number="272"><![CDATA[        28:]]></Line>
<Line Number="273"><![CDATA[            FRK_Press_AccessWork.Gate := 11;]]></Line>
<Line Number="274"><![CDATA[]]></Line>
<Line Number="275"><![CDATA[        29:]]></Line>
<Line Number="276"><![CDATA[            FRK_Press_AccessWork.Gate := 11;]]></Line>
<Line Number="277"><![CDATA[]]></Line>
<Line Number="278"><![CDATA[        30:]]></Line>
<Line Number="279"><![CDATA[            FRK_Press_AccessWork.Gate := 11;]]></Line>
<Line Number="280"><![CDATA[]]></Line>
<Line Number="281"><![CDATA[        32:]]></Line>
<Line Number="282"><![CDATA[            FRK_Press_AccessWork.Gate := 11;]]></Line>
<Line Number="283"><![CDATA[]]></Line>
<Line Number="284"><![CDATA[        33:]]></Line>
<Line Number="285"><![CDATA[            FRK_Press_AccessWork.Gate := 11;]]></Line>
<Line Number="286"><![CDATA[]]></Line>
<Line Number="287"><![CDATA[        34:]]></Line>
<Line Number="288"><![CDATA[            FRK_Press_AccessWork.Gate := 2;]]></Line>
<Line Number="289"><![CDATA[]]></Line>
<Line Number="290"><![CDATA[        35:]]></Line>
<Line Number="291"><![CDATA[            FRK_Press_AccessWork.Gate := 11;]]></Line>
<Line Number="292"><![CDATA[]]></Line>
<Line Number="293"><![CDATA[        36:]]></Line>
<Line Number="294"><![CDATA[            FRK_Press_AccessWork.Gate := 8;]]></Line>
<Line Number="295"><![CDATA[]]></Line>
<Line Number="296"><![CDATA[        37:]]></Line>
<Line Number="297"><![CDATA[            FRK_Press_AccessWork.Gate := 11;]]></Line>
<Line Number="298"><![CDATA[]]></Line>
<Line Number="299"><![CDATA[        38:]]></Line>
<Line Number="300"><![CDATA[            FRK_Press_AccessWork.Gate := 11;]]></Line>
<Line Number="301"><![CDATA[        ELSE]]></Line>
<Line Number="302"><![CDATA[            (* LOGIN, LOGOUT and release queries are ungated. *)]]></Line>
<Line Number="303"><![CDATA[    END_CASE;]]></Line>
<Line Number="304"><![CDATA[    IF FRK_Press_AccessWork.Gate >= 0 THEN]]></Line>
<Line Number="305"><![CDATA[        IF (FRK_Press_HmiRequest.Kind <> 23) AND (FRK_Press_HmiRequest.Kind <> 19)]]></Line>
<Line Number="306"><![CDATA[            AND (FRK_Press_HmiRequest.Kind <> 27) THEN]]></Line>
<Line Number="307"><![CDATA[            IF NOT ((FRK_Press_AccessState.CurrentLevel >= 0) AND (FRK_Press_AccessState.CurrentLevel <= 4)]]></Line>
<Line Number="308"><![CDATA[                AND (FRK_Press_AccessState.Required[FRK_Press_AccessWork.Gate] >= 0)]]></Line>
<Line Number="309"><![CDATA[                AND (FRK_Press_AccessState.Required[FRK_Press_AccessWork.Gate] <= 4)]]></Line>
<Line Number="310"><![CDATA[                AND (FRK_Press_AccessState.CurrentLevel >= FRK_Press_AccessState.Required[FRK_Press_AccessWork.Gate])) THEN]]></Line>
<Line Number="311"><![CDATA[                FRK_Press_AccessWork.Permitted := 0;]]></Line>
<Line Number="312"><![CDATA[            END_IF;]]></Line>
<Line Number="313"><![CDATA[        END_IF;]]></Line>
<Line Number="314"><![CDATA[        IF FRK_Press_AccessState.CurrentLevel < FRK_Press_AccessWork.Minimum THEN]]></Line>
<Line Number="315"><![CDATA[            FRK_Press_AccessWork.Permitted := 0;]]></Line>
<Line Number="316"><![CDATA[        END_IF;]]></Line>
<Line Number="317"><![CDATA[    END_IF;]]></Line>
<Line Number="318"><![CDATA[    IF FRK_Press_HmiRequest.Kind = 31 THEN]]></Line>
<Line Number="319"><![CDATA[        FRK_Press_AccessWork.Gate := -2;]]></Line>
<Line Number="320"><![CDATA[        FRK_Press_AccessWork.Permitted := 0;]]></Line>
<Line Number="321"><![CDATA[        IF (FRK_Press_AccessState.CurrentLevel >= 3) AND (FRK_Press_AccessState.CurrentLevel <= 4) THEN]]></Line>
<Line Number="322"><![CDATA[            FRK_Press_AccessWork.Permitted := 1;]]></Line>
<Line Number="323"><![CDATA[        END_IF;]]></Line>
<Line Number="324"><![CDATA[    END_IF;]]></Line>
<Line Number="325"><![CDATA[    IF (FRK_Press_HmiRequest.Kind = 14) AND (FRK_Press_HmiRequest.BoolValue = 0) THEN]]></Line>
<Line Number="326"><![CDATA[        FRK_Press_AccessWork.Permitted := 1;]]></Line>
<Line Number="327"><![CDATA[    END_IF;]]></Line>
<Line Number="328"><![CDATA[    IF (FRK_Press_HmiRequest.Kind = 34) AND (FRK_Press_HmiRequest.BoolValue = 0) THEN]]></Line>
<Line Number="329"><![CDATA[        FRK_Press_AccessWork.Permitted := 1;]]></Line>
<Line Number="330"><![CDATA[    END_IF;]]></Line>
<Line Number="331"><![CDATA[    IF FRK_Press_AccessWork.Permitted = 0 THEN]]></Line>
<Line Number="332"><![CDATA[        FRK_Press_HmiResponse.DiagnosticKey := 653;]]></Line>
<Line Number="333"><![CDATA[        (* std.error.accessDenied *)]]></Line>
<Line Number="334"><![CDATA[        FRK_Press_ReleaseReport.Count := 0;]]></Line>
<Line Number="335"><![CDATA[        FRK_Press_ReleaseReport.Released := 0;]]></Line>
<Line Number="336"><![CDATA[        IF FRK_Press_ReleaseReport.Count < 8 THEN]]></Line>
<Line Number="337"><![CDATA[            FRK_Press_ReleaseReport.Key[FRK_Press_ReleaseReport.Count] := 653;]]></Line>
<Line Number="338"><![CDATA[            (* std.error.accessDenied *)]]></Line>
<Line Number="339"><![CDATA[            FRK_Press_ReleaseReport.Reason[FRK_Press_ReleaseReport.Count] := 0;]]></Line>
<Line Number="340"><![CDATA[            FRK_Press_ReleaseReport.Source[FRK_Press_ReleaseReport.Count] := 0;]]></Line>
<Line Number="341"><![CDATA[            FRK_Press_ReleaseReport.Kind[FRK_Press_ReleaseReport.Count] := 1;]]></Line>
<Line Number="342"><![CDATA[            FRK_Press_ReleaseReport.Count := FRK_Press_ReleaseReport.Count + 1;]]></Line>
<Line Number="343"><![CDATA[        END_IF;]]></Line>
