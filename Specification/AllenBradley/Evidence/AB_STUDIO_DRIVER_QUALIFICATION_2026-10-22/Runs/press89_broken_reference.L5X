<Line Number="20"><![CDATA[FRK_Press_AlarmRing.RingState[FRK_Press_AccessAudit.Head - 1] := 0;]]></Line>
<Line Number="21"><![CDATA[FRK_Press_AlarmRing.RingReasonCode[FRK_Press_AccessAudit.Head - 1] := 0;]]></Line>
<Line Number="22"><![CDATA[FRK_Press_AlarmRing.RingSeverity[FRK_Press_AccessAudit.Head - 1] := 0;]]></Line>
