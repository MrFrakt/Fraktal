<Routine Name="FRK_Press_ConfigSets" Type="ST">
<STContent>
<Line Number="0"><![CDATA[CPS(FRK_Press_HmiRequest.ConfigSet, FRK_Press_SetStaged, 1);]]></Line>
<Line Number="1"><![CDATA[(* immutable controller staging *)]]></Line>
<Line Number="2"><![CDATA[FRK_Press_ConfigSetState.Sequence := FRK_Press_HmiLastSequence;]]></Line>
<Line Number="3"><![CDATA[FRK_Press_ConfigSetState.Count := FRK_Press_SetStaged.Count;]]></Line>
<Line Number="4"><![CDATA[FRK_Press_ConfigSetState.RejectIndex := 0;]]></Line>
<Line Number="5"><![CDATA[FRK_Press_ConfigSetState.Reason := 0;]]></Line>
<Line Number="6"><![CDATA[IF (FRK_Press_SetStaged.Operation <> 30) AND (FRK_Press_SetStaged.Operation <> 32)]]></Line>
<Line Number="7"><![CDATA[    AND (FRK_Press_SetStaged.Operation <> 38) AND (FRK_Press_SetStaged.Operation <> 37) THEN]]></Line>
<Line Number="8"><![CDATA[    IF FRK_Press_Unit.Running <> 0 THEN]]></Line>
<Line Number="9"><![CDATA[        FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="10"><![CDATA[    END_IF;]]></Line>
<Line Number="11"><![CDATA[    IF FRK_Press_Unit.Error <> 0 THEN]]></Line>
<Line Number="12"><![CDATA[        FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="13"><![CDATA[    END_IF;]]></Line>
<Line Number="14"><![CDATA[    IF FRK_Press_Unit.Aborted <> 0 THEN]]></Line>
<Line Number="15"><![CDATA[        FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="16"><![CDATA[    END_IF;]]></Line>
<Line Number="17"><![CDATA[    IF FRK_Press_Unit.Complete <> 0 THEN]]></Line>
<Line Number="18"><![CDATA[        FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="19"><![CDATA[    END_IF;]]></Line>
<Line Number="20"><![CDATA[    IF FRK_Press_ConfigPersist.Pending <> 0 THEN]]></Line>
<Line Number="21"><![CDATA[        FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="22"><![CDATA[    END_IF;]]></Line>
<Line Number="23"><![CDATA[END_IF;]]></Line>
<Line Number="24"><![CDATA[IF (FRK_Press_SetStaged.Operation = 28) AND (FRK_T_PressStationCfgTag.SchemaVersion = 0) THEN]]></Line>
<Line Number="25"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="26"><![CDATA[END_IF;]]></Line>
<Line Number="27"><![CDATA[IF FRK_Press_SetStaged.SchemaVersion <> 1 THEN]]></Line>
<Line Number="28"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="29"><![CDATA[END_IF;]]></Line>
<Line Number="30"><![CDATA[IF FRK_Press_SetStaged.Sequence <> FRK_Press_HmiLastSequence THEN]]></Line>
<Line Number="31"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="32"><![CDATA[END_IF;]]></Line>
<Line Number="33"><![CDATA[IF FRK_Press_SetStaged.Operation <> FRK_Press_HmiRequest.Kind THEN]]></Line>
<Line Number="34"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="35"><![CDATA[END_IF;]]></Line>
<Line Number="36"><![CDATA[IF (FRK_Press_SetStaged.Commit < 0) OR (FRK_Press_SetStaged.Commit > 1) THEN]]></Line>
<Line Number="37"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="38"><![CDATA[END_IF;]]></Line>
<Line Number="39"><![CDATA[IF FRK_Press_SetStaged.Valid <> 1 THEN]]></Line>
<Line Number="40"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="41"><![CDATA[END_IF;]]></Line>
<Line Number="42"><![CDATA[IF (FRK_Press_SetStaged.Count < 0) OR (FRK_Press_SetStaged.Count > 64) THEN]]></Line>
<Line Number="43"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="44"><![CDATA[END_IF;]]></Line>
<Line Number="45"><![CDATA[IF (FRK_Press_SetStaged.NameLength < 0) OR (FRK_Press_SetStaged.NameLength > 80) THEN]]></Line>
<Line Number="46"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="47"><![CDATA[END_IF;]]></Line>
<Line Number="48"><![CDATA[IF (FRK_Press_HmiRequest.User.LEN < 0) OR (FRK_Press_HmiRequest.User.LEN > 32) THEN]]></Line>
<Line Number="49"><![CDATA[    FRK_Press_ConfigSetState.Reason := 644;]]></Line>
<Line Number="50"><![CDATA[END_IF;]]></Line>
<Line Number="51"><![CDATA[IF FRK_Press_SetStaged.Operation <> 30 THEN]]></Line>
