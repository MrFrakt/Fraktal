<Line Number="232"><![CDATA[]]></Line>
<Line Number="233"><![CDATA[        12:]]></Line>
<Line Number="234"><![CDATA[            FRK_Press_AccessWork.Gate := 4;]]></Line>
<Line Number="235"><![CDATA[]]></Line>
<Line Number="236"><![CDATA[        13:]]></Line>
<Line Number="237"><![CDATA[            FRK_Press_AccessWork.Gate := 5;]]></Line>
<Line Number="238"><![CDATA[]]></Line>
<Line Number="239"><![CDATA[        14:]]></Line>
<Line Number="240"><![CDATA[            FRK_Press_AccessWork.Gate := 5;]]></Line>
<Line Number="241"><![CDATA[]]></Line>
<Line Number="242"><![CDATA[        18:]]></Line>
<Line Number="243"><![CDATA[            FRK_Press_AccessWork.Gate := 1;]]></Line>
<Line Number="244"><![CDATA[]]></Line>
<Line Number="245"><![CDATA[        19:]]></Line>
<Line Number="246"><![CDATA[            FRK_Press_AccessWork.Gate := 1;]]></Line>
<Line Number="247"><![CDATA[]]></Line>
<Line Number="248"><![CDATA[        20:]]></Line>
<Line Number="249"><![CDATA[            FRK_Press_AccessWork.Gate := 9;]]></Line>
<Line Number="250"><![CDATA[]]></Line>
