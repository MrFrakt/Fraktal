<Line Number="381"><![CDATA[            FRK_Press_AlarmActive.ActResetClass[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="382"><![CDATA[            FRK_Press_AlarmActive.ActSourceModuleId[FRK_Press_AlmSlot] := 1;]]></Line>
<Line Number="383"><![CDATA[            FRK_Press_AlarmActive.ActIoRoles[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="384"><![CDATA[            FRK_Press_AlarmActive.HealthEvt[5] := FRK_Press_AlmSlot + 1;]]></Line>
<Line Number="385"><![CDATA[        END_IF;]]></Line>
<Line Number="386"><![CDATA[    END_IF;]]></Line>
<Line Number="387"><![CDATA[ELSIF FRK_Press_AlarmActive.HealthEvt[5] > 0 THEN]]></Line>
<Line Number="388"><![CDATA[    FRK_Press_AlmSlot := FRK_Press_AlarmActive.HealthEvt[5] - 1;]]></Line>
<Line Number="389"><![CDATA[    FRK_Press_AlarmActive.ActGoneDate[FRK_Press_AlmSlot] := FRK_Press_NowDate;]]></Line>
<Line Number="390"><![CDATA[    FRK_Press_AlarmActive.ActGoneTime[FRK_Press_AlmSlot] := FRK_Press_NowTime;]]></Line>
<Line Number="391"><![CDATA[    FRK_Press_AlarmActive.ActDurationMs[FRK_Press_AlmSlot] := (FRK_Press_ScanCount - FRK_Press_AlarmActive.ActComeScan[FRK_Press_AlmSlot]) * FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="392"><![CDATA[    JSR(FRK_Press_AlarmClose, 0);]]></Line>
<Line Number="393"><![CDATA[    FRK_Press_AlarmActive.HealthEvt[5] := 0;]]></Line>
<Line Number="394"><![CDATA[END_IF;]]></Line>
<Line Number="395"><![CDATA[(* Operator reset: WAIT_RESET and active manual events close (TC3 76) *)]]></Line>
<Line Number="396"><![CDATA[IF FRK_Press_ResetRequest <> 0 THEN]]></Line>
<Line Number="397"><![CDATA[    FOR FRK_Press_AlmI := 0 TO 15 DO]]></Line>
<Line Number="398"><![CDATA[        IF (FRK_Press_AlarmActive.ActState[FRK_Press_AlmI] = 2) OR ((FRK_Press_AlarmActive.ActState[FRK_Press_AlmI] = 1)]]></Line>
<Line Number="399"><![CDATA[            AND (FRK_Press_AlarmActive.ActResetClass[FRK_Press_AlmI] = 1)) THEN]]></Line>
<Line Number="400"><![CDATA[            IF FRK_Press_AlarmActive.ActState[FRK_Press_AlmI] = 1 THEN]]></Line>
<Line Number="401"><![CDATA[                FRK_Press_AlarmActive.ActGoneDate[FRK_Press_AlmI] := FRK_Press_NowDate;]]></Line>
<Line Number="402"><![CDATA[                FRK_Press_AlarmActive.ActGoneTime[FRK_Press_AlmI] := FRK_Press_NowTime;]]></Line>
<Line Number="403"><![CDATA[                FRK_Press_AlarmActive.ActDurationMs[FRK_Press_AlmI] := (FRK_Press_ScanCount - FRK_Press_AlarmActive.ActComeScan[FRK_Press_AlmI]) * FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="404"><![CDATA[            END_IF;]]></Line>
<Line Number="405"><![CDATA[            FRK_Press_AlmSlot := FRK_Press_AlmI;]]></Line>
<Line Number="406"><![CDATA[            JSR(FRK_Press_AlarmClose, 0);]]></Line>
<Line Number="407"><![CDATA[            IF FRK_Press_AlarmActive.FaultEvt = FRK_Press_AlmI + 1 THEN]]></Line>
<Line Number="408"><![CDATA[                FRK_Press_AlarmActive.FaultEvt := 0;]]></Line>
<Line Number="409"><![CDATA[            END_IF;]]></Line>
<Line Number="410"><![CDATA[        END_IF;]]></Line>
<Line Number="411"><![CDATA[    END_FOR;]]></Line>
<Line Number="412"><![CDATA[END_IF;]]></Line>
<Line Number="413"><![CDATA[(* 8.3(b): any manual event not closed blocks a restart *)]]></Line>
<Line Number="414"><![CDATA[FRK_Press_AlarmActive.Blocking := 0;]]></Line>
<Line Number="415"><![CDATA[FOR FRK_Press_AlmI := 0 TO 15 DO]]></Line>
<Line Number="416"><![CDATA[    IF (FRK_Press_AlarmActive.ActResetClass[FRK_Press_AlmI] = 1)]]></Line>
<Line Number="417"><![CDATA[        AND (FRK_Press_AlarmActive.ActState[FRK_Press_AlmI] <> 0) THEN]]></Line>
<Line Number="418"><![CDATA[        FRK_Press_AlarmActive.Blocking := 1;]]></Line>
<Line Number="419"><![CDATA[    END_IF;]]></Line>
<Line Number="420"><![CDATA[END_FOR;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ScanStatistics" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_LineWork.Valid := 1;]]></Line>
<Line Number="1"><![CDATA[IF (FRK_Press_Clock[0] < 1970) OR (FRK_Press_Clock[0] > 2099) THEN]]></Line>
<Line Number="2"><![CDATA[    FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="3"><![CDATA[END_IF;]]></Line>
<Line Number="4"><![CDATA[IF (FRK_Press_Clock[1] < 1) OR (FRK_Press_Clock[1] > 12) THEN]]></Line>
<Line Number="5"><![CDATA[    FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="6"><![CDATA[END_IF;]]></Line>
<Line Number="7"><![CDATA[IF (FRK_Press_Clock[2] < 1) OR (FRK_Press_Clock[2] > 31) THEN]]></Line>
<Line Number="8"><![CDATA[    FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="9"><![CDATA[END_IF;]]></Line>
<Line Number="10"><![CDATA[IF (FRK_Press_Clock[3] < 0) OR (FRK_Press_Clock[3] > 23) THEN]]></Line>
<Line Number="11"><![CDATA[    FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="12"><![CDATA[END_IF;]]></Line>
<Line Number="13"><![CDATA[IF (FRK_Press_Clock[4] < 0) OR (FRK_Press_Clock[4] > 59) THEN]]></Line>
<Line Number="14"><![CDATA[    FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="15"><![CDATA[END_IF;]]></Line>
<Line Number="16"><![CDATA[IF FRK_Press_LineWork.Valid <> 0 THEN]]></Line>
<Line Number="17"><![CDATA[    FRK_Press_LineWork.Year := FRK_Press_Clock[0] - 1;]]></Line>
<Line Number="18"><![CDATA[    FRK_Press_LineWork.Days := 365 * (FRK_Press_Clock[0] - 1970) + ((FRK_Press_LineWork.Year) - ((FRK_Press_LineWork.Year) MOD 4)) / 4 - ((FRK_Press_LineWork.Year) - ((FRK_Press_LineWork.Year) MOD 100)) / 100 + ((FRK_Press_LineWork.Year) - ((FRK_Press_LineWork.Year) MOD 400)) / 400 - 477;]]></Line>
<Line Number="19"><![CDATA[    CASE FRK_Press_Clock[1] OF]]></Line>
<Line Number="20"><![CDATA[        1:]]></Line>
<Line Number="21"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 0;]]></Line>
<Line Number="22"><![CDATA[]]></Line>
<Line Number="23"><![CDATA[        2:]]></Line>
<Line Number="24"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 31;]]></Line>
<Line Number="25"><![CDATA[]]></Line>
<Line Number="26"><![CDATA[        3:]]></Line>
<Line Number="27"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 59;]]></Line>
<Line Number="28"><![CDATA[]]></Line>
<Line Number="29"><![CDATA[        4:]]></Line>
<Line Number="30"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 90;]]></Line>
<Line Number="31"><![CDATA[]]></Line>
<Line Number="32"><![CDATA[        5:]]></Line>
<Line Number="33"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 120;]]></Line>
<Line Number="34"><![CDATA[]]></Line>
<Line Number="35"><![CDATA[        6:]]></Line>
<Line Number="36"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 151;]]></Line>
<Line Number="37"><![CDATA[]]></Line>
<Line Number="38"><![CDATA[        7:]]></Line>
<Line Number="39"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 181;]]></Line>
<Line Number="40"><![CDATA[]]></Line>
<Line Number="41"><![CDATA[        8:]]></Line>
<Line Number="42"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 212;]]></Line>
<Line Number="43"><![CDATA[]]></Line>
<Line Number="44"><![CDATA[        9:]]></Line>
<Line Number="45"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 243;]]></Line>
<Line Number="46"><![CDATA[]]></Line>
<Line Number="47"><![CDATA[        10:]]></Line>
<Line Number="48"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 273;]]></Line>
<Line Number="49"><![CDATA[]]></Line>
<Line Number="50"><![CDATA[        11:]]></Line>
<Line Number="51"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 304;]]></Line>
<Line Number="52"><![CDATA[]]></Line>
<Line Number="53"><![CDATA[        12:]]></Line>
<Line Number="54"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 334;]]></Line>
<Line Number="55"><![CDATA[    END_CASE;]]></Line>
<Line Number="56"><![CDATA[    IF FRK_Press_Clock[1] > 2 THEN]]></Line>
<Line Number="57"><![CDATA[        IF ((FRK_Press_Clock[0] MOD 4) = 0) AND (((FRK_Press_Clock[0] MOD 100) <> 0)]]></Line>
<Line Number="58"><![CDATA[            OR ((FRK_Press_Clock[0] MOD 400) = 0)) THEN]]></Line>
<Line Number="59"><![CDATA[            FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + 1;]]></Line>
<Line Number="60"><![CDATA[        END_IF;]]></Line>
<Line Number="61"><![CDATA[    END_IF;]]></Line>
<Line Number="62"><![CDATA[    FRK_Press_LineWork.Days := FRK_Press_LineWork.Days + FRK_Press_Clock[2] - 1;]]></Line>
<Line Number="63"><![CDATA[    FRK_Press_LineWork.NowMinute := FRK_Press_LineWork.Days * 1440 + FRK_Press_Clock[3] * 60 + FRK_Press_Clock[4];]]></Line>
<Line Number="64"><![CDATA[    IF FRK_Press_HealthProbe.TimeIsSynchronized = 0 THEN]]></Line>
<Line Number="65"><![CDATA[        FRK_Press_LineShift.TimeSynchronized := 0;]]></Line>
<Line Number="66"><![CDATA[    END_IF;]]></Line>
<Line Number="67"><![CDATA[    IF FRK_Press_LineWork.NowMinute < FRK_Press_LineShift.StartedMinute THEN]]></Line>
<Line Number="68"><![CDATA[        FRK_Press_LineShift.TimeSynchronized := 0;]]></Line>
<Line Number="69"><![CDATA[    END_IF;]]></Line>
<Line Number="70"><![CDATA[    IF FRK_Press_LineShift.Initialized = 0 THEN]]></Line>
<Line Number="71"><![CDATA[        JSR(FRK_Press_LineApply, 0);]]></Line>
<Line Number="72"><![CDATA[        JSR(FRK_Press_LineSearch, 0);]]></Line>
<Line Number="73"><![CDATA[        FRK_Press_LineShift.Current := FRK_Press_LineWork.Selected;]]></Line>
<Line Number="74"><![CDATA[        FRK_Press_LineShift.ProductionTarget := 0;]]></Line>
<Line Number="75"><![CDATA[        IF FRK_Press_LineShift.Current > 0 THEN]]></Line>
<Line Number="76"><![CDATA[            FRK_Press_LineWork.J := FRK_Press_LineShift.Current - 1;]]></Line>
<Line Number="77"><![CDATA[            FRK_Press_LineShift.ProductionTarget := FRK_Press_LineWork.AppliedTarget[FRK_Press_LineWork.J];]]></Line>
<Line Number="78"><![CDATA[        END_IF;]]></Line>
<Line Number="79"><![CDATA[        FRK_Press_LineShift.StartedMinute := FRK_Press_LineWork.NowMinute;]]></Line>
<Line Number="80"><![CDATA[        FRK_Press_LineShift.StartedMs := FRK_Press_NowTime MOD 100000;]]></Line>
<Line Number="81"><![CDATA[        FRK_Press_LineShift.EndsMinute := FRK_Press_LineWork.NextMinute;]]></Line>
<Line Number="82"><![CDATA[        FRK_Press_LineShift.TimeSynchronized := FRK_Press_HealthProbe.TimeIsSynchronized;]]></Line>
<Line Number="83"><![CDATA[        FRK_Press_LineShift.Initialized := 1;]]></Line>
<Line Number="84"><![CDATA[    ELSIF (FRK_Press_LineShift.EndsMinute > 0) AND (FRK_Press_LineWork.NowMinute >= FRK_Press_LineShift.EndsMinute) THEN]]></Line>
<Line Number="85"><![CDATA[        IF (FRK_Press_LineShift.EndsMinute > 0) AND (FRK_Press_LineWork.NowMinute > FRK_Press_LineShift.EndsMinute) THEN]]></Line>
<Line Number="86"><![CDATA[            FRK_Press_LineShift.TimeSynchronized := 0;]]></Line>
<Line Number="87"><![CDATA[        END_IF;]]></Line>
<Line Number="88"><![CDATA[        JSR(FRK_Press_LineClose, 0);]]></Line>
<Line Number="89"><![CDATA[        JSR(FRK_Press_LineApply, 0);]]></Line>
<Line Number="90"><![CDATA[        JSR(FRK_Press_LineSearch, 0);]]></Line>
<Line Number="91"><![CDATA[        FRK_Press_LineShift.Current := FRK_Press_LineWork.Selected;]]></Line>
<Line Number="92"><![CDATA[        FRK_Press_LineShift.ProductionTarget := 0;]]></Line>
<Line Number="93"><![CDATA[        IF FRK_Press_LineShift.Current > 0 THEN]]></Line>
<Line Number="94"><![CDATA[            FRK_Press_LineWork.J := FRK_Press_LineShift.Current - 1;]]></Line>
<Line Number="95"><![CDATA[            FRK_Press_LineShift.ProductionTarget := FRK_Press_LineWork.AppliedTarget[FRK_Press_LineWork.J];]]></Line>
<Line Number="96"><![CDATA[        END_IF;]]></Line>
<Line Number="97"><![CDATA[        FRK_Press_LineShift.StartedMinute := FRK_Press_LineWork.NowMinute;]]></Line>
<Line Number="98"><![CDATA[        FRK_Press_LineShift.StartedMs := FRK_Press_NowTime MOD 100000;]]></Line>
<Line Number="99"><![CDATA[        FRK_Press_LineShift.EndsMinute := FRK_Press_LineWork.NextMinute;]]></Line>
<Line Number="100"><![CDATA[        FRK_Press_LineShift.TimeSynchronized := FRK_Press_HealthProbe.TimeIsSynchronized;]]></Line>
<Line Number="101"><![CDATA[    ELSIF (FRK_Press_LineShift.EndsMinute = 0)]]></Line>
<Line Number="102"><![CDATA[        AND (FRK_Press_LineShift.AppliedRevision <> FRK_Press_LineState.Revision) THEN]]></Line>
<Line Number="103"><![CDATA[        JSR(FRK_Press_LineApply, 0);]]></Line>
<Line Number="104"><![CDATA[        JSR(FRK_Press_LineSearch, 0);]]></Line>
<Line Number="105"><![CDATA[        IF FRK_Press_LineWork.Selected <> FRK_Press_LineShift.Current THEN]]></Line>
<Line Number="106"><![CDATA[            JSR(FRK_Press_LineClose, 0);]]></Line>
<Line Number="107"><![CDATA[            FRK_Press_LineShift.StartedMinute := FRK_Press_LineWork.NowMinute;]]></Line>
<Line Number="108"><![CDATA[            FRK_Press_LineShift.StartedMs := FRK_Press_NowTime MOD 100000;]]></Line>
<Line Number="109"><![CDATA[            FRK_Press_LineShift.TimeSynchronized := FRK_Press_HealthProbe.TimeIsSynchronized;]]></Line>
<Line Number="110"><![CDATA[        END_IF;]]></Line>
<Line Number="111"><![CDATA[        FRK_Press_LineShift.Current := FRK_Press_LineWork.Selected;]]></Line>
<Line Number="112"><![CDATA[        FRK_Press_LineShift.ProductionTarget := 0;]]></Line>
<Line Number="113"><![CDATA[        IF FRK_Press_LineShift.Current > 0 THEN]]></Line>
<Line Number="114"><![CDATA[            FRK_Press_LineWork.J := FRK_Press_LineShift.Current - 1;]]></Line>
<Line Number="115"><![CDATA[            FRK_Press_LineShift.ProductionTarget := FRK_Press_LineWork.AppliedTarget[FRK_Press_LineWork.J];]]></Line>
<Line Number="116"><![CDATA[        END_IF;]]></Line>
<Line Number="117"><![CDATA[        FRK_Press_LineShift.EndsMinute := FRK_Press_LineWork.NextMinute;]]></Line>
<Line Number="118"><![CDATA[    END_IF;]]></Line>
<Line Number="119"><![CDATA[ELSE]]></Line>
<Line Number="120"><![CDATA[    FRK_Press_LineShift.TimeSynchronized := 0;]]></Line>
<Line Number="121"><![CDATA[END_IF;]]></Line>
<Line Number="122"><![CDATA[(* Core 8.5.1: OEE time accounting (TC3 _M_OeeUpdate). BUSY is run;  *)]]></Line>
<Line Number="123"><![CDATA[(* ERROR or a blocking alarm is down; everything else is idle.       *)]]></Line>
<Line Number="124"><![CDATA[IF FRK_Press_Unit.Running <> 0 THEN]]></Line>
<Line Number="125"><![CDATA[    FRK_Press_Oee.RunMs := FRK_Press_Oee.RunMs + FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="126"><![CDATA[    IF FRK_Press_Oee.RunMs >= 1000 THEN]]></Line>
<Line Number="127"><![CDATA[        FRK_Press_Oee.RunMs := FRK_Press_Oee.RunMs - 1000;]]></Line>
<Line Number="128"><![CDATA[        FRK_Press_Oee.RunS := FRK_Press_Oee.RunS + 1;]]></Line>
<Line Number="129"><![CDATA[    END_IF;]]></Line>
<Line Number="130"><![CDATA[ELSIF (FRK_Press_Unit.Error <> 0) OR (FRK_Press_AlarmActive.Blocking <> 0) THEN]]></Line>
<Line Number="131"><![CDATA[    FRK_Press_Oee.DownMs := FRK_Press_Oee.DownMs + FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="132"><![CDATA[    IF FRK_Press_Oee.DownMs >= 1000 THEN]]></Line>
<Line Number="133"><![CDATA[        FRK_Press_Oee.DownMs := FRK_Press_Oee.DownMs - 1000;]]></Line>
<Line Number="134"><![CDATA[        FRK_Press_Oee.DownS := FRK_Press_Oee.DownS + 1;]]></Line>
<Line Number="135"><![CDATA[    END_IF;]]></Line>
<Line Number="136"><![CDATA[ELSE]]></Line>
<Line Number="137"><![CDATA[    FRK_Press_Oee.IdleMs := FRK_Press_Oee.IdleMs + FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="138"><![CDATA[    IF FRK_Press_Oee.IdleMs >= 1000 THEN]]></Line>
<Line Number="139"><![CDATA[        FRK_Press_Oee.IdleMs := FRK_Press_Oee.IdleMs - 1000;]]></Line>
<Line Number="140"><![CDATA[        FRK_Press_Oee.IdleS := FRK_Press_Oee.IdleS + 1;]]></Line>
<Line Number="141"><![CDATA[    END_IF;]]></Line>
<Line Number="142"><![CDATA[END_IF;]]></Line>
<Line Number="143"><![CDATA[FRK_Press_Oee.SampleMs := FRK_Press_Oee.SampleMs + FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="144"><![CDATA[IF FRK_Press_Oee.SampleMs >= 60000 THEN]]></Line>
<Line Number="145"><![CDATA[    FRK_Press_Oee.SampleMs := 0;]]></Line>
<Line Number="146"><![CDATA[    FRK_Press_Oee.Head := (FRK_Press_Oee.Head MOD 60) + 1;]]></Line>
<Line Number="147"><![CDATA[    FRK_Press_Oee.SmpEpoch[FRK_Press_Oee.Head - 1] := FRK_Press_Oee.Epoch;]]></Line>
<Line Number="148"><![CDATA[    FRK_Press_Oee.SmpRunS[FRK_Press_Oee.Head - 1] := FRK_Press_Oee.RunS;]]></Line>
<Line Number="149"><![CDATA[    FRK_Press_Oee.SmpRunMs[FRK_Press_Oee.Head - 1] := FRK_Press_Oee.RunMs;]]></Line>
<Line Number="150"><![CDATA[    FRK_Press_Oee.SmpDownS[FRK_Press_Oee.Head - 1] := FRK_Press_Oee.DownS;]]></Line>
<Line Number="151"><![CDATA[    FRK_Press_Oee.SmpDownMs[FRK_Press_Oee.Head - 1] := FRK_Press_Oee.DownMs;]]></Line>
<Line Number="152"><![CDATA[    FRK_Press_Oee.SmpGood[FRK_Press_Oee.Head - 1] := FRK_Press_Unit.GoodCount - FRK_Press_Oee.GoodBase;]]></Line>
<Line Number="153"><![CDATA[    FRK_Press_Oee.SmpNok[FRK_Press_Oee.Head - 1] := FRK_Press_Unit.ScrapCount - FRK_Press_Oee.NokBase;]]></Line>
<Line Number="154"><![CDATA[    FRK_Press_Oee.SmpIdealMs[FRK_Press_Oee.Head - 1] := FRK_T_PressParCfgTag.IdealCycleMs;]]></Line>
<Line Number="155"><![CDATA[END_IF;]]></Line>
<Line Number="156"><![CDATA[(* Core 8.11.4: the cycle-time profile (TC3 FB_CycleProfiler), fed   *)]]></Line>
<Line Number="157"><![CDATA[(* from the record each step writes on entry, for every rendition.   *)]]></Line>
<Line Number="158"><![CDATA[IF FRK_Press_Unit.Running = 0 THEN]]></Line>
<Line Number="159"><![CDATA[    (* stood down inside a cycle: abandoned, never published *)]]></Line>
<Line Number="160"><![CDATA[    FRK_Press_Profiler.Open := 0;]]></Line>
<Line Number="161"><![CDATA[    FRK_Press_Profiler.CycleOpen := 0;]]></Line>
<Line Number="162"><![CDATA[    FRK_Press_Profiler.SeenCycles := FRK_Press_Unit.CycleCount;]]></Line>
<Line Number="163"><![CDATA[ELSE]]></Line>
<Line Number="164"><![CDATA[    IF FRK_Press_Unit.StepScan = FRK_Press_ScanCount THEN]]></Line>
<Line Number="165"><![CDATA[        (* a step was entered this scan: TC3's StepChanged *)]]></Line>
<Line Number="166"><![CDATA[        IF FRK_Press_Profiler.Open <> 0 THEN]]></Line>
<Line Number="167"><![CDATA[            (* close the open step: its row, the waterfall, the class split *)]]></Line>
<Line Number="168"><![CDATA[            FRK_Press_Profiler.StatCount[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.StatCount[FRK_Press_Profiler.OpenIdx] + 1;]]></Line>
<Line Number="169"><![CDATA[            FRK_Press_Profiler.StatLast[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="170"><![CDATA[            IF (FRK_Press_Profiler.StatCount[FRK_Press_Profiler.OpenIdx] = 1)]]></Line>
<Line Number="171"><![CDATA[                OR (FRK_Press_Profiler.OpenMs < FRK_Press_Profiler.StatMin[FRK_Press_Profiler.OpenIdx]) THEN]]></Line>
<Line Number="172"><![CDATA[                FRK_Press_Profiler.StatMin[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="173"><![CDATA[            END_IF;]]></Line>
<Line Number="174"><![CDATA[            IF FRK_Press_Profiler.OpenMs > FRK_Press_Profiler.StatMax[FRK_Press_Profiler.OpenIdx] THEN]]></Line>
<Line Number="175"><![CDATA[                FRK_Press_Profiler.StatMax[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="176"><![CDATA[            END_IF;]]></Line>
<Line Number="177"><![CDATA[            (* TC3's F_TimingUpdate running mean, in its integer arithmetic *)]]></Line>
<Line Number="178"><![CDATA[            FRK_Press_Profiler.StatAvg[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.StatAvg[FRK_Press_Profiler.OpenIdx] + ((FRK_Press_Profiler.OpenMs - FRK_Press_Profiler.StatAvg[FRK_Press_Profiler.OpenIdx]) / FRK_Press_Profiler.StatCount[FRK_Press_Profiler.OpenIdx]);]]></Line>
<Line Number="179"><![CDATA[            IF FRK_Press_Profiler.CurN < 32 THEN]]></Line>
<Line Number="180"><![CDATA[                FRK_Press_Profiler.Slot := (FRK_Press_Profiler.CurBuf * 32) + FRK_Press_Profiler.CurN;]]></Line>
<Line Number="181"><![CDATA[                FRK_Press_Profiler.WfStepNo[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.OpenNo;]]></Line>
<Line Number="182"><![CDATA[                FRK_Press_Profiler.WfDurMs[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="183"><![CDATA[                FRK_Press_Profiler.WfExpMs[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.OpenExp;]]></Line>
<Line Number="184"><![CDATA[                FRK_Press_Profiler.CurN := FRK_Press_Profiler.CurN + 1;]]></Line>
<Line Number="185"><![CDATA[            ELSE]]></Line>
<Line Number="186"><![CDATA[                FRK_Press_Profiler.CurTrunc := 1;]]></Line>
<Line Number="187"><![CDATA[            END_IF;]]></Line>
<Line Number="188"><![CDATA[            FRK_Press_Profiler.CurByClass[FRK_Press_Profiler.OpenCls] := FRK_Press_Profiler.CurByClass[FRK_Press_Profiler.OpenCls] + FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="189"><![CDATA[            FRK_Press_Profiler.Open := 0;]]></Line>
<Line Number="190"><![CDATA[        END_IF;]]></Line>
<Line Number="191"><![CDATA[        IF FRK_Press_Profiler.CycleOpen = 0 THEN]]></Line>
<Line Number="192"><![CDATA[            (* the first step opens the cycle (TC3's start marker) *)]]></Line>
<Line Number="193"><![CDATA[            FRK_Press_Profiler.CycleOpen := 1;]]></Line>
<Line Number="194"><![CDATA[            FRK_Press_Profiler.CycleMs := 0;]]></Line>
<Line Number="195"><![CDATA[            FRK_Press_Profiler.CurN := 0;]]></Line>
<Line Number="196"><![CDATA[            FRK_Press_Profiler.CurTrunc := 0;]]></Line>
<Line Number="197"><![CDATA[            FRK_Press_Profiler.CurByClass[0] := 0;]]></Line>
<Line Number="198"><![CDATA[            FRK_Press_Profiler.CurByClass[1] := 0;]]></Line>
<Line Number="199"><![CDATA[            FRK_Press_Profiler.CurByClass[2] := 0;]]></Line>
<Line Number="200"><![CDATA[            FRK_Press_Profiler.CurByClass[3] := 0;]]></Line>
<Line Number="201"><![CDATA[            FRK_Press_Profiler.CurByClass[4] := 0;]]></Line>
<Line Number="202"><![CDATA[        END_IF;]]></Line>
<Line Number="203"><![CDATA[        FRK_Press_Profiler.Open := 1;]]></Line>
<Line Number="204"><![CDATA[        FRK_Press_Profiler.OpenNo := FRK_Press_Chart.ActiveStepNumber;]]></Line>
<Line Number="205"><![CDATA[        FRK_Press_Profiler.OpenIdx := FRK_Press_Chart.StepCursor;]]></Line>
<Line Number="206"><![CDATA[        FRK_Press_Profiler.OpenMs := 0;]]></Line>
<Line Number="207"><![CDATA[        FRK_Press_Profiler.OpenExp := FRK_Press_Unit.StepExpectedMs;]]></Line>
<Line Number="208"><![CDATA[        FRK_Press_Profiler.OpenCls := 0;]]></Line>
<Line Number="209"><![CDATA[        IF (FRK_Press_Unit.Mode = 0) AND (FRK_Press_Chart.ActiveStepNumber = 100) THEN]]></Line>
<Line Number="210"><![CDATA[            FRK_Press_Profiler.OpenCls := 3;]]></Line>
<Line Number="211"><![CDATA[        END_IF;]]></Line>
<Line Number="212"><![CDATA[        IF (FRK_Press_Unit.Mode = 0) AND (FRK_Press_Chart.ActiveStepNumber = 210) THEN]]></Line>
<Line Number="213"><![CDATA[            FRK_Press_Profiler.OpenCls := 3;]]></Line>
<Line Number="214"><![CDATA[        END_IF;]]></Line>
<Line Number="215"><![CDATA[        IF (FRK_Press_Unit.Mode = 3) AND (FRK_Press_Chart.ActiveStepNumber = 700) THEN]]></Line>
<Line Number="216"><![CDATA[            FRK_Press_Profiler.OpenCls := 3;]]></Line>
<Line Number="217"><![CDATA[        END_IF;]]></Line>
<Line Number="218"><![CDATA[        IF (FRK_Press_Unit.Mode = 3) AND (FRK_Press_Chart.ActiveStepNumber = 780) THEN]]></Line>
<Line Number="219"><![CDATA[            FRK_Press_Profiler.OpenCls := 3;]]></Line>
<Line Number="220"><![CDATA[        END_IF;]]></Line>
<Line Number="221"><![CDATA[    END_IF;]]></Line>
<Line Number="222"><![CDATA[    (* this scan's time belongs to the step that ran in it *)]]></Line>
<Line Number="223"><![CDATA[    IF (FRK_Press_Profiler.Open <> 0) AND (FRK_Press_Profiler.OpenMs < 2000000000) THEN]]></Line>
<Line Number="224"><![CDATA[        FRK_Press_Profiler.OpenMs := FRK_Press_Profiler.OpenMs + FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="225"><![CDATA[    END_IF;]]></Line>
<Line Number="226"><![CDATA[    IF (FRK_Press_Profiler.CycleOpen <> 0) AND (FRK_Press_Profiler.CycleMs < 2000000000) THEN]]></Line>
<Line Number="227"><![CDATA[        FRK_Press_Profiler.CycleMs := FRK_Press_Profiler.CycleMs + FRK_Press_Unit.Par_TaskPeriodMs;]]></Line>
<Line Number="228"><![CDATA[    END_IF;]]></Line>
<Line Number="229"><![CDATA[    IF FRK_Press_Unit.CycleCount <> FRK_Press_Profiler.SeenCycles THEN]]></Line>
<Line Number="230"><![CDATA[        FRK_Press_Profiler.SeenCycles := FRK_Press_Unit.CycleCount;]]></Line>
<Line Number="231"><![CDATA[        IF FRK_Press_Profiler.CycleOpen <> 0 THEN]]></Line>
<Line Number="232"><![CDATA[            (* TC3's CycleComplete: close the finish step, publish the cycle *)]]></Line>
<Line Number="233"><![CDATA[            IF FRK_Press_Profiler.Open <> 0 THEN]]></Line>
<Line Number="234"><![CDATA[                (* close the open step: its row, the waterfall, the class split *)]]></Line>
<Line Number="235"><![CDATA[                FRK_Press_Profiler.StatCount[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.StatCount[FRK_Press_Profiler.OpenIdx] + 1;]]></Line>
<Line Number="236"><![CDATA[                FRK_Press_Profiler.StatLast[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="237"><![CDATA[                IF (FRK_Press_Profiler.StatCount[FRK_Press_Profiler.OpenIdx] = 1)]]></Line>
<Line Number="238"><![CDATA[                    OR (FRK_Press_Profiler.OpenMs < FRK_Press_Profiler.StatMin[FRK_Press_Profiler.OpenIdx]) THEN]]></Line>
<Line Number="239"><![CDATA[                    FRK_Press_Profiler.StatMin[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="240"><![CDATA[                END_IF;]]></Line>
<Line Number="241"><![CDATA[                IF FRK_Press_Profiler.OpenMs > FRK_Press_Profiler.StatMax[FRK_Press_Profiler.OpenIdx] THEN]]></Line>
<Line Number="242"><![CDATA[                    FRK_Press_Profiler.StatMax[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="243"><![CDATA[                END_IF;]]></Line>
<Line Number="244"><![CDATA[                (* TC3's F_TimingUpdate running mean, in its integer arithmetic *)]]></Line>
<Line Number="245"><![CDATA[                FRK_Press_Profiler.StatAvg[FRK_Press_Profiler.OpenIdx] := FRK_Press_Profiler.StatAvg[FRK_Press_Profiler.OpenIdx] + ((FRK_Press_Profiler.OpenMs - FRK_Press_Profiler.StatAvg[FRK_Press_Profiler.OpenIdx]) / FRK_Press_Profiler.StatCount[FRK_Press_Profiler.OpenIdx]);]]></Line>
<Line Number="246"><![CDATA[                IF FRK_Press_Profiler.CurN < 32 THEN]]></Line>
<Line Number="247"><![CDATA[                    FRK_Press_Profiler.Slot := (FRK_Press_Profiler.CurBuf * 32) + FRK_Press_Profiler.CurN;]]></Line>
<Line Number="248"><![CDATA[                    FRK_Press_Profiler.WfStepNo[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.OpenNo;]]></Line>
<Line Number="249"><![CDATA[                    FRK_Press_Profiler.WfDurMs[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="250"><![CDATA[                    FRK_Press_Profiler.WfExpMs[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.OpenExp;]]></Line>
<Line Number="251"><![CDATA[                    FRK_Press_Profiler.CurN := FRK_Press_Profiler.CurN + 1;]]></Line>
<Line Number="252"><![CDATA[                ELSE]]></Line>
<Line Number="253"><![CDATA[                    FRK_Press_Profiler.CurTrunc := 1;]]></Line>
<Line Number="254"><![CDATA[                END_IF;]]></Line>
<Line Number="255"><![CDATA[                FRK_Press_Profiler.CurByClass[FRK_Press_Profiler.OpenCls] := FRK_Press_Profiler.CurByClass[FRK_Press_Profiler.OpenCls] + FRK_Press_Profiler.OpenMs;]]></Line>
<Line Number="256"><![CDATA[                FRK_Press_Profiler.Open := 0;]]></Line>
<Line Number="257"><![CDATA[            END_IF;]]></Line>
<Line Number="258"><![CDATA[            FRK_Press_Profiler.LastCycleNo := FRK_Press_Profiler.LastCycleNo + 1;]]></Line>
<Line Number="259"><![CDATA[            FRK_Press_Profiler.LastN := FRK_Press_Profiler.CurN;]]></Line>
<Line Number="260"><![CDATA[            FRK_Press_Profiler.LastTrunc := FRK_Press_Profiler.CurTrunc;]]></Line>
<Line Number="261"><![CDATA[            FRK_Press_Profiler.LastTotal := FRK_Press_Profiler.CycleMs;]]></Line>
<Line Number="262"><![CDATA[            FRK_Press_Profiler.LastWork := FRK_Press_Profiler.CurByClass[0];]]></Line>
<Line Number="263"><![CDATA[            FRK_Press_Profiler.CurBuf := 1 - FRK_Press_Profiler.CurBuf;]]></Line>
<Line Number="264"><![CDATA[            FRK_Press_Profiler.LastCycleTime := FRK_Press_Profiler.CycleMs;]]></Line>
<Line Number="265"><![CDATA[            IF (FRK_Press_Profiler.MinCycleTime = 0)]]></Line>
<Line Number="266"><![CDATA[                OR (FRK_Press_Profiler.CycleMs < FRK_Press_Profiler.MinCycleTime) THEN]]></Line>
<Line Number="267"><![CDATA[                FRK_Press_Profiler.MinCycleTime := FRK_Press_Profiler.CycleMs;]]></Line>
<Line Number="268"><![CDATA[            END_IF;]]></Line>
<Line Number="269"><![CDATA[            FRK_Press_Profiler.HistoryHead := (FRK_Press_Profiler.HistoryHead MOD 60) + 1;]]></Line>
<Line Number="270"><![CDATA[            FRK_Press_Profiler.Slot := FRK_Press_Profiler.HistoryHead - 1;]]></Line>
<Line Number="271"><![CDATA[            FRK_Press_Profiler.HisCycleNo[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.LastCycleNo;]]></Line>
<Line Number="272"><![CDATA[            FRK_Press_Profiler.HisTotal[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.CycleMs;]]></Line>
<Line Number="273"><![CDATA[            FRK_Press_Profiler.HisWork[FRK_Press_Profiler.Slot] := FRK_Press_Profiler.CurByClass[0];]]></Line>
<Line Number="274"><![CDATA[            FRK_Press_Profiler.Slot := FRK_Press_Profiler.Slot * 5;]]></Line>
<Line Number="275"><![CDATA[            FRK_Press_Profiler.HisByClass[FRK_Press_Profiler.Slot + 0] := FRK_Press_Profiler.CurByClass[0];]]></Line>
<Line Number="276"><![CDATA[            FRK_Press_Profiler.HisByClass[FRK_Press_Profiler.Slot + 1] := FRK_Press_Profiler.CurByClass[1];]]></Line>
<Line Number="277"><![CDATA[            FRK_Press_Profiler.HisByClass[FRK_Press_Profiler.Slot + 2] := FRK_Press_Profiler.CurByClass[2];]]></Line>
<Line Number="278"><![CDATA[            FRK_Press_Profiler.HisByClass[FRK_Press_Profiler.Slot + 3] := FRK_Press_Profiler.CurByClass[3];]]></Line>
<Line Number="279"><![CDATA[            FRK_Press_Profiler.HisByClass[FRK_Press_Profiler.Slot + 4] := FRK_Press_Profiler.CurByClass[4];]]></Line>
<Line Number="280"><![CDATA[            (* Core 8.11.4(d): degradation is data, not downtime *)]]></Line>
<Line Number="281"><![CDATA[            IF FRK_T_PressParCfgTag.BaselineWorkMs <> FRK_Press_Profiler.DegradedBase THEN]]></Line>
<Line Number="282"><![CDATA[                FRK_Press_Profiler.DegradedBase := FRK_T_PressParCfgTag.BaselineWorkMs;]]></Line>
<Line Number="283"><![CDATA[                FRK_Press_Profiler.Degraded := 0;]]></Line>
<Line Number="284"><![CDATA[            END_IF;]]></Line>
<Line Number="285"><![CDATA[            IF FRK_T_PressParCfgTag.BaselineWorkMs > 0 THEN]]></Line>
<Line Number="286"><![CDATA[                IF FRK_Press_Profiler.CurByClass[0] > (FRK_T_PressParCfgTag.BaselineWorkMs + ((FRK_T_PressParCfgTag.BaselineWorkMs * 20) / 100)) THEN]]></Line>
<Line Number="287"><![CDATA[                    IF FRK_Press_Profiler.Degraded = 0 THEN]]></Line>
<Line Number="288"><![CDATA[                        FRK_Press_Profiler.Degraded := 1;]]></Line>
<Line Number="289"><![CDATA[                        FRK_Press_Profiler.DegradedCount := FRK_Press_Profiler.DegradedCount + 1;]]></Line>
<Line Number="290"><![CDATA[                        FRK_Press_Profiler.DegradedWorkMs := FRK_Press_Profiler.CurByClass[0];]]></Line>
<Line Number="291"><![CDATA[                    END_IF;]]></Line>
<Line Number="292"><![CDATA[                ELSE]]></Line>
<Line Number="293"><![CDATA[                    FRK_Press_Profiler.Degraded := 0;]]></Line>
<Line Number="294"><![CDATA[                END_IF;]]></Line>
<Line Number="295"><![CDATA[            END_IF;]]></Line>
<Line Number="296"><![CDATA[            FRK_Press_Profiler.CycleOpen := 0;]]></Line>
<Line Number="297"><![CDATA[        END_IF;]]></Line>
<Line Number="298"><![CDATA[    END_IF;]]></Line>
<Line Number="299"><![CDATA[END_IF;]]></Line>
<Line Number="300"><![CDATA[(* Core 3.12: derived state flags (TC3 _M_State) - TRUE right now, *)]]></Line>
<Line Number="301"><![CDATA[(* recomputed from the modules every scan, never latched.          *)]]></Line>
<Line Number="302"><![CDATA[(* project.state.pressAtLoadPosition *)]]></Line>
<Line Number="303"><![CDATA[FRK_Press_StateFlags.Ok := 1;]]></Line>
<Line Number="304"><![CDATA[IF NOT ((FRK_Press_CtxDoor.OutImm_Retracted <> 0) AND (FRK_Press_CtxDoor.OutImm_Extended = 0)) THEN]]></Line>
<Line Number="305"><![CDATA[    FRK_Press_StateFlags.Ok := 0;]]></Line>
<Line Number="306"><![CDATA[END_IF;]]></Line>
<Line Number="307"><![CDATA[IF NOT ((FRK_Press_CtxPartSlide.OutImm_Retracted <> 0) AND (FRK_Press_CtxPartSlide.OutImm_Extended = 0)) THEN]]></Line>
<Line Number="308"><![CDATA[    FRK_Press_StateFlags.Ok := 0;]]></Line>
<Line Number="309"><![CDATA[END_IF;]]></Line>
<Line Number="310"><![CDATA[IF NOT ((FRK_Press_CtxPressRam.OutImm_Retracted <> 0) AND (FRK_Press_CtxPressRam.OutImm_Extended = 0)) THEN]]></Line>
<Line Number="311"><![CDATA[    FRK_Press_StateFlags.Ok := 0;]]></Line>
<Line Number="312"><![CDATA[END_IF;]]></Line>
<Line Number="313"><![CDATA[IF (FRK_Press_StateFlags.Value[0] <> FRK_Press_StateFlags.Ok) OR (FRK_Press_StateFlags.SinceDate[0] = 0) THEN]]></Line>
<Line Number="314"><![CDATA[    FRK_Press_StateFlags.SinceDate[0] := FRK_Press_NowDate;]]></Line>
<Line Number="315"><![CDATA[    FRK_Press_StateFlags.SinceTime[0] := FRK_Press_NowTime;]]></Line>
<Line Number="316"><![CDATA[END_IF;]]></Line>
<Line Number="317"><![CDATA[FRK_Press_StateFlags.Value[0] := FRK_Press_StateFlags.Ok;]]></Line>
<Line Number="318"><![CDATA[(* project.state.pressTwoHandStartReady *)]]></Line>
<Line Number="319"><![CDATA[FRK_Press_StateFlags.Ok := 1;]]></Line>
<Line Number="320"><![CDATA[IF NOT ((FRK_Press_CtxTwoHand.OutImm_Armed <> 0)) THEN]]></Line>
<Line Number="321"><![CDATA[    FRK_Press_StateFlags.Ok := 0;]]></Line>
<Line Number="322"><![CDATA[END_IF;]]></Line>
<Line Number="323"><![CDATA[IF NOT ((FRK_Press_CtxPartPresentSensor.OutImm_Value <> 0)]]></Line>
<Line Number="324"><![CDATA[    AND (FRK_Press_CtxPartPresentSensor.OutImm_Quality <> 0)) THEN]]></Line>
<Line Number="325"><![CDATA[    FRK_Press_StateFlags.Ok := 0;]]></Line>
<Line Number="326"><![CDATA[END_IF;]]></Line>
<Line Number="327"><![CDATA[IF NOT ((FRK_Press_CtxAirPressureMonitor.OutImm_PressureOk <> 0)) THEN]]></Line>
<Line Number="328"><![CDATA[    FRK_Press_StateFlags.Ok := 0;]]></Line>
<Line Number="329"><![CDATA[END_IF;]]></Line>
<Line Number="330"><![CDATA[IF (FRK_Press_StateFlags.Value[1] <> FRK_Press_StateFlags.Ok) OR (FRK_Press_StateFlags.SinceDate[1] = 0) THEN]]></Line>
<Line Number="331"><![CDATA[    FRK_Press_StateFlags.SinceDate[1] := FRK_Press_NowDate;]]></Line>
<Line Number="332"><![CDATA[    FRK_Press_StateFlags.SinceTime[1] := FRK_Press_NowTime;]]></Line>
<Line Number="333"><![CDATA[END_IF;]]></Line>
<Line Number="334"><![CDATA[FRK_Press_StateFlags.Value[1] := FRK_Press_StateFlags.Ok;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ConfigWrite" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_SetCopy := -1;]]></Line>
<Line Number="1"><![CDATA[CASE FRK_Press_HmiRequest.IntValue OF]]></Line>
<Line Number="2"><![CDATA[    1:]]></Line>
<Line Number="3"><![CDATA[        FRK_Press_SetIndex := 0;]]></Line>
<Line Number="4"><![CDATA[        FRK_Press_SetPrior := 5000;]]></Line>
<Line Number="5"><![CDATA[        FRK_Press_SetCopy := 3;]]></Line>
<Line Number="6"><![CDATA[]]></Line>
<Line Number="7"><![CDATA[    2:]]></Line>
<Line Number="8"><![CDATA[        FRK_Press_SetIndex := 50;]]></Line>
<Line Number="9"><![CDATA[        FRK_Press_SetPrior := 10000;]]></Line>
<Line Number="10"><![CDATA[        FRK_Press_SetCopy := 3;]]></Line>
<Line Number="11"><![CDATA[]]></Line>
<Line Number="12"><![CDATA[    3:]]></Line>
<Line Number="13"><![CDATA[        FRK_Press_SetIndex := 0;]]></Line>
<Line Number="14"><![CDATA[        FRK_Press_SetPrior := 600000;]]></Line>
<Line Number="15"><![CDATA[        FRK_Press_SetCopy := 3;]]></Line>
<Line Number="16"><![CDATA[]]></Line>
<Line Number="17"><![CDATA[    4:]]></Line>
<Line Number="18"><![CDATA[        FRK_Press_SetIndex := 0;]]></Line>
<Line Number="19"><![CDATA[        FRK_Press_SetPrior := 600000;]]></Line>
<Line Number="20"><![CDATA[        FRK_Press_SetCopy := 7;]]></Line>
<Line Number="21"><![CDATA[]]></Line>
<Line Number="22"><![CDATA[    5:]]></Line>
<Line Number="23"><![CDATA[        FRK_Press_SetIndex := 1;]]></Line>
<Line Number="24"><![CDATA[        FRK_Press_SetPrior := 99;]]></Line>
<Line Number="25"><![CDATA[        FRK_Press_SetCopy := 1;]]></Line>
<Line Number="26"><![CDATA[]]></Line>
<Line Number="27"><![CDATA[    6:]]></Line>
<Line Number="28"><![CDATA[        FRK_Press_SetIndex := 200;]]></Line>
<Line Number="29"><![CDATA[        FRK_Press_SetPrior := 30000;]]></Line>
<Line Number="30"><![CDATA[        FRK_Press_SetCopy := 1;]]></Line>
<Line Number="31"><![CDATA[]]></Line>
<Line Number="32"><![CDATA[    7:]]></Line>
<Line Number="33"><![CDATA[        FRK_Press_SetIndex := 100;]]></Line>
<Line Number="34"><![CDATA[        FRK_Press_SetPrior := 1000;]]></Line>
<Line Number="35"><![CDATA[        FRK_Press_SetCopy := 1;]]></Line>
<Line Number="36"><![CDATA[]]></Line>
<Line Number="37"><![CDATA[    8:]]></Line>
<Line Number="38"><![CDATA[        FRK_Press_SetIndex := 0;]]></Line>
<Line Number="39"><![CDATA[        FRK_Press_SetPrior := 10000;]]></Line>
<Line Number="40"><![CDATA[        FRK_Press_SetCopy := 1;]]></Line>
<Line Number="41"><![CDATA[]]></Line>
<Line Number="42"><![CDATA[    9:]]></Line>
<Line Number="43"><![CDATA[        FRK_Press_SetIndex := 0;]]></Line>
<Line Number="44"><![CDATA[        FRK_Press_SetPrior := 1;]]></Line>
<Line Number="45"><![CDATA[        FRK_Press_SetCopy := 1;]]></Line>
<Line Number="46"><![CDATA[]]></Line>
<Line Number="47"><![CDATA[    10:]]></Line>
<Line Number="48"><![CDATA[        FRK_Press_SetIndex := -840;]]></Line>
<Line Number="49"><![CDATA[        FRK_Press_SetPrior := 840;]]></Line>
<Line Number="50"><![CDATA[        FRK_Press_SetCopy := 0;]]></Line>
<Line Number="51"><![CDATA[]]></Line>
<Line Number="52"><![CDATA[    11, 14, 17, 20, 23:]]></Line>
<Line Number="53"><![CDATA[        FRK_Press_SetIndex := -1;]]></Line>
<Line Number="54"><![CDATA[        FRK_Press_SetPrior := 1439;]]></Line>
<Line Number="55"><![CDATA[        FRK_Press_SetCopy := 0;]]></Line>
<Line Number="56"><![CDATA[]]></Line>
<Line Number="57"><![CDATA[    12, 15, 18, 21, 24:]]></Line>
<Line Number="58"><![CDATA[        FRK_Press_SetIndex := 1;]]></Line>
<Line Number="59"><![CDATA[        FRK_Press_SetPrior := 1440;]]></Line>
<Line Number="60"><![CDATA[        FRK_Press_SetCopy := 0;]]></Line>
<Line Number="61"><![CDATA[]]></Line>
<Line Number="62"><![CDATA[    13, 16, 19, 22, 25:]]></Line>
<Line Number="63"><![CDATA[        FRK_Press_SetIndex := 0;]]></Line>
<Line Number="64"><![CDATA[        FRK_Press_SetPrior := 127;]]></Line>
<Line Number="65"><![CDATA[        FRK_Press_SetCopy := 0;]]></Line>
<Line Number="66"><![CDATA[]]></Line>
<Line Number="67"><![CDATA[    26, 27, 28, 29, 30:]]></Line>
<Line Number="68"><![CDATA[        FRK_Press_SetIndex := 0;]]></Line>
<Line Number="69"><![CDATA[        FRK_Press_SetPrior := 2147483647;]]></Line>
<Line Number="70"><![CDATA[        FRK_Press_SetCopy := 0;]]></Line>
<Line Number="71"><![CDATA[    ELSE]]></Line>
<Line Number="72"><![CDATA[        FRK_Press_HmiResponse.DiagnosticKey := 613;]]></Line>
<Line Number="73"><![CDATA[        (* project.mailbox.refused.config_key_unknown *)]]></Line>
<Line Number="74"><![CDATA[END_CASE;]]></Line>
<Line Number="75"><![CDATA[IF FRK_Press_SetCopy >= 0 THEN]]></Line>
<Line Number="76"><![CDATA[    IF (FRK_T_PressStationCfgTag.SchemaVersion = 0) THEN]]></Line>
<Line Number="77"><![CDATA[        FRK_Press_HmiResponse.DiagnosticKey := 670;]]></Line>
<Line Number="78"><![CDATA[        (* std.release.configRestoring *)]]></Line>
<Line Number="79"><![CDATA[    END_IF;]]></Line>
<Line Number="80"><![CDATA[    FRK_Press_DataWork.Index := FRK_Press_HmiRequest.IntValue - 1;]]></Line>
<Line Number="81"><![CDATA[    IF NOT ((FRK_Press_DataLevels.WriteLevel[FRK_Press_DataWork.Index] >= 0)]]></Line>
<Line Number="82"><![CDATA[        AND (FRK_Press_DataLevels.WriteLevel[FRK_Press_DataWork.Index] <= 4)]]></Line>
<Line Number="83"><![CDATA[        AND (FRK_Press_AccessState.CurrentLevel >= FRK_Press_DataLevels.WriteLevel[FRK_Press_DataWork.Index])]]></Line>
<Line Number="84"><![CDATA[        AND (FRK_Press_AccessState.CurrentLevel <= 4)) THEN]]></Line>
<Line Number="85"><![CDATA[        FRK_Press_DataLevels.RejectSequence := FRK_Press_HmiLastSequence;]]></Line>
<Line Number="86"><![CDATA[        FRK_Press_DataLevels.RejectCapability := FRK_Press_HmiRequest.IntValue;]]></Line>
<Line Number="87"><![CDATA[        FRK_Press_DataLevels.RejectRequiredLevel := FRK_Press_DataLevels.WriteLevel[FRK_Press_DataWork.Index];]]></Line>
<Line Number="88"><![CDATA[        FRK_Press_AccessWork.Permitted := 0;]]></Line>
<Line Number="89"><![CDATA[        FRK_Press_HmiResponse.DiagnosticKey := 653;]]></Line>
<Line Number="90"><![CDATA[        (* std.error.accessDenied *)]]></Line>
<Line Number="91"><![CDATA[    END_IF;]]></Line>
<Line Number="92"><![CDATA[    IF FRK_Press_HmiResponse.DiagnosticKey = 0 THEN]]></Line>
<Line Number="93"><![CDATA[        FRK_Press_ConfigCandidate := FRK_Press_HmiRequest.BoolValue;]]></Line>
<Line Number="94"><![CDATA[        IF FRK_Press_HmiRequest.Kind = 27 THEN]]></Line>
<Line Number="95"><![CDATA[            IF FRK_Press_SetCopy < 4 THEN]]></Line>
<Line Number="96"><![CDATA[                FRK_Press_HmiResponse.DiagnosticKey := 611;]]></Line>
<Line Number="97"><![CDATA[                (* project.mailbox.refused.capture_not_registered *)]]></Line>
<Line Number="98"><![CDATA[            ELSE]]></Line>
<Line Number="99"><![CDATA[                CASE FRK_Press_HmiRequest.IntValue OF]]></Line>
<Line Number="100"><![CDATA[                    4:]]></Line>
<Line Number="101"><![CDATA[                        FRK_Press_ConfigCandidate := FRK_Press_Profiler.LastWork;]]></Line>
<Line Number="102"><![CDATA[                    ELSE]]></Line>
<Line Number="103"><![CDATA[                        (* The selected flag guarantees a registered source. *)]]></Line>
<Line Number="104"><![CDATA[                END_CASE;]]></Line>
<Line Number="105"><![CDATA[                IF FRK_Press_HmiRequest.DurationMs <> 15071508 THEN]]></Line>
<Line Number="106"><![CDATA[                    FRK_Press_HmiResponse.DiagnosticKey := 616;]]></Line>
<Line Number="107"><![CDATA[                    (* project.mailbox.refused.config_revision_stale *)]]></Line>
