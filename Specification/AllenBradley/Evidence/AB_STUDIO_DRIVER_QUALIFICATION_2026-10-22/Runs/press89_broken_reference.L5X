<Line Number="391"><![CDATA[                    IF FRK_Press_AccessLoginRequest.Sequence <> FRK_Press_AccessWork.Sequence THEN]]></Line>
<Line Number="392"><![CDATA[                        FRK_Press_AccessWork.LoginValid := 0;]]></Line>
