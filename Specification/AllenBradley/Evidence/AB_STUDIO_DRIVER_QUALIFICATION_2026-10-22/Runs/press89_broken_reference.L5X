<Routine Name="FRK_Press_AlarmOpen" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_AlmSlot := -1;]]></Line>
<Line Number="1"><![CDATA[FOR FRK_Press_AlmI := 0 TO 15 DO]]></Line>
<Line Number="2"><![CDATA[    IF (FRK_Press_AlmSlot < 0) AND (FRK_Press_AlarmActive.ActState[FRK_Press_AlmI] = 0) THEN]]></Line>
<Line Number="3"><![CDATA[        FRK_Press_AlmSlot := FRK_Press_AlmI;]]></Line>
<Line Number="4"><![CDATA[    END_IF;]]></Line>
<Line Number="5"><![CDATA[END_FOR;]]></Line>
<Line Number="6"><![CDATA[IF FRK_Press_AlmSlot < 0 THEN]]></Line>
<Line Number="7"><![CDATA[    FRK_Press_AlarmActive.Truncated := 1;]]></Line>
<Line Number="8"><![CDATA[ELSE]]></Line>
<Line Number="9"><![CDATA[    FRK_Press_AlarmActive.ActState[FRK_Press_AlmSlot] := 1;]]></Line>
<Line Number="10"><![CDATA[    FRK_Press_AlarmActive.ActComeDate[FRK_Press_AlmSlot] := FRK_Press_NowDate;]]></Line>
<Line Number="11"><![CDATA[    FRK_Press_AlarmActive.ActComeTime[FRK_Press_AlmSlot] := FRK_Press_NowTime;]]></Line>
<Line Number="12"><![CDATA[    FRK_Press_AlarmActive.ActGoneDate[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="13"><![CDATA[    FRK_Press_AlarmActive.ActGoneTime[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="14"><![CDATA[    FRK_Press_AlarmActive.ActComeScan[FRK_Press_AlmSlot] := FRK_Press_ScanCount;]]></Line>
<Line Number="15"><![CDATA[    FRK_Press_AlarmActive.ActDurationMs[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="16"><![CDATA[    FRK_Press_AlarmActive.ActShelved[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="17"><![CDATA[    FRK_Press_AlarmShelfWork.RemainingMs[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="18"><![CDATA[    FRK_Press_AlarmActive.NActive := FRK_Press_AlarmActive.NActive + 1;]]></Line>
<Line Number="19"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_AlarmClose" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_AlarmActive.RingHead := (FRK_Press_AlarmActive.RingHead MOD 64) + 1;]]></Line>
<Line Number="1"><![CDATA[FRK_Press_AlarmRing.RingReasonCode[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActReasonCode[FRK_Press_AlmSlot];]]></Line>
<Line Number="2"><![CDATA[FRK_Press_AlarmRing.RingSeverity[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActSeverity[FRK_Press_AlmSlot];]]></Line>
<Line Number="3"><![CDATA[FRK_Press_AlarmRing.RingResetClass[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActResetClass[FRK_Press_AlmSlot];]]></Line>
<Line Number="4"><![CDATA[FRK_Press_AlarmRing.RingSourceModuleId[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActSourceModuleId[FRK_Press_AlmSlot];]]></Line>
<Line Number="5"><![CDATA[FRK_Press_AlarmRing.RingComeDate[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActComeDate[FRK_Press_AlmSlot];]]></Line>
<Line Number="6"><![CDATA[FRK_Press_AlarmRing.RingComeTime[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActComeTime[FRK_Press_AlmSlot];]]></Line>
<Line Number="7"><![CDATA[FRK_Press_AlarmRing.RingGoneDate[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActGoneDate[FRK_Press_AlmSlot];]]></Line>
<Line Number="8"><![CDATA[FRK_Press_AlarmRing.RingGoneTime[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActGoneTime[FRK_Press_AlmSlot];]]></Line>
<Line Number="9"><![CDATA[FRK_Press_AlarmRing.RingComeScan[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActComeScan[FRK_Press_AlmSlot];]]></Line>
<Line Number="10"><![CDATA[FRK_Press_AlarmRing.RingDurationMs[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActDurationMs[FRK_Press_AlmSlot];]]></Line>
<Line Number="11"><![CDATA[FRK_Press_AlarmRing.RingIoRoles[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActIoRoles[FRK_Press_AlmSlot];]]></Line>
<Line Number="12"><![CDATA[FRK_Press_AlarmRing.RingShelved[FRK_Press_AlarmActive.RingHead - 1] := FRK_Press_AlarmActive.ActShelved[FRK_Press_AlmSlot];]]></Line>
<Line Number="13"><![CDATA[FRK_Press_AlarmRing.RingState[FRK_Press_AlarmActive.RingHead - 1] := 0;]]></Line>
<Line Number="14"><![CDATA[FRK_Press_AlarmActive.ActState[FRK_Press_AlmSlot] := 0;]]></Line>
<Line Number="15"><![CDATA[FRK_Press_AlarmActive.NActive := FRK_Press_AlarmActive.NActive - 1;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_LineStage" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_LineWork.CandidateOffset := FRK_T_LineCfgV3Tag.UtcOffsetMin;]]></Line>
<Line Number="1"><![CDATA[FRK_Press_LineWork.CandidateStart[0] := FRK_T_LineCfgV3Tag.StartMin1;]]></Line>
<Line Number="2"><![CDATA[FRK_Press_LineWork.CandidateDuration[0] := FRK_T_LineCfgV3Tag.DurationMin1;]]></Line>
<Line Number="3"><![CDATA[FRK_Press_LineWork.CandidateDays[0] := FRK_T_LineCfgV3Tag.ActiveDays1;]]></Line>
<Line Number="4"><![CDATA[FRK_Press_LineWork.CandidateTarget[0] := FRK_T_LineCfgV3Tag.ProductionTarget1;]]></Line>
<Line Number="5"><![CDATA[FRK_Press_LineWork.CandidateStart[1] := FRK_T_LineCfgV3Tag.StartMin2;]]></Line>
<Line Number="6"><![CDATA[FRK_Press_LineWork.CandidateDuration[1] := FRK_T_LineCfgV3Tag.DurationMin2;]]></Line>
<Line Number="7"><![CDATA[FRK_Press_LineWork.CandidateDays[1] := FRK_T_LineCfgV3Tag.ActiveDays2;]]></Line>
<Line Number="8"><![CDATA[FRK_Press_LineWork.CandidateTarget[1] := FRK_T_LineCfgV3Tag.ProductionTarget2;]]></Line>
<Line Number="9"><![CDATA[FRK_Press_LineWork.CandidateStart[2] := FRK_T_LineCfgV3Tag.StartMin3;]]></Line>
<Line Number="10"><![CDATA[FRK_Press_LineWork.CandidateDuration[2] := FRK_T_LineCfgV3Tag.DurationMin3;]]></Line>
<Line Number="11"><![CDATA[FRK_Press_LineWork.CandidateDays[2] := FRK_T_LineCfgV3Tag.ActiveDays3;]]></Line>
<Line Number="12"><![CDATA[FRK_Press_LineWork.CandidateTarget[2] := FRK_T_LineCfgV3Tag.ProductionTarget3;]]></Line>
<Line Number="13"><![CDATA[FRK_Press_LineWork.CandidateStart[3] := FRK_T_LineCfgV3Tag.StartMin4;]]></Line>
<Line Number="14"><![CDATA[FRK_Press_LineWork.CandidateDuration[3] := FRK_T_LineCfgV3Tag.DurationMin4;]]></Line>
<Line Number="15"><![CDATA[FRK_Press_LineWork.CandidateDays[3] := FRK_T_LineCfgV3Tag.ActiveDays4;]]></Line>
<Line Number="16"><![CDATA[FRK_Press_LineWork.CandidateTarget[3] := FRK_T_LineCfgV3Tag.ProductionTarget4;]]></Line>
<Line Number="17"><![CDATA[FRK_Press_LineWork.CandidateStart[4] := FRK_T_LineCfgV3Tag.StartMin5;]]></Line>
<Line Number="18"><![CDATA[FRK_Press_LineWork.CandidateDuration[4] := FRK_T_LineCfgV3Tag.DurationMin5;]]></Line>
<Line Number="19"><![CDATA[FRK_Press_LineWork.CandidateDays[4] := FRK_T_LineCfgV3Tag.ActiveDays5;]]></Line>
<Line Number="20"><![CDATA[FRK_Press_LineWork.CandidateTarget[4] := FRK_T_LineCfgV3Tag.ProductionTarget5;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_LineValidate" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_LineWork.Valid := 1;]]></Line>
<Line Number="1"><![CDATA[IF (FRK_Press_LineWork.CandidateOffset < -840) OR (FRK_Press_LineWork.CandidateOffset > 840) THEN]]></Line>
<Line Number="2"><![CDATA[    FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="3"><![CDATA[END_IF;]]></Line>
<Line Number="4"><![CDATA[FOR FRK_Press_LineWork.I := 0 TO 4 DO]]></Line>
<Line Number="5"><![CDATA[    IF (FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.I] < -1)]]></Line>
<Line Number="6"><![CDATA[        OR (FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.I] > 1439) THEN]]></Line>
<Line Number="7"><![CDATA[        FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="8"><![CDATA[    END_IF;]]></Line>
<Line Number="9"><![CDATA[    IF (FRK_Press_LineWork.CandidateDuration[FRK_Press_LineWork.I] < 1)]]></Line>
<Line Number="10"><![CDATA[        OR (FRK_Press_LineWork.CandidateDuration[FRK_Press_LineWork.I] > 1440) THEN]]></Line>
<Line Number="11"><![CDATA[        FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="12"><![CDATA[    END_IF;]]></Line>
<Line Number="13"><![CDATA[    IF (FRK_Press_LineWork.CandidateDays[FRK_Press_LineWork.I] < 0)]]></Line>
<Line Number="14"><![CDATA[        OR (FRK_Press_LineWork.CandidateDays[FRK_Press_LineWork.I] > 127) THEN]]></Line>
<Line Number="15"><![CDATA[        FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="16"><![CDATA[    END_IF;]]></Line>
<Line Number="17"><![CDATA[    IF FRK_Press_LineWork.CandidateTarget[FRK_Press_LineWork.I] < 0 THEN]]></Line>
<Line Number="18"><![CDATA[        FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="19"><![CDATA[    END_IF;]]></Line>
<Line Number="20"><![CDATA[END_FOR;]]></Line>
<Line Number="21"><![CDATA[IF FRK_Press_LineWork.Valid <> 0 THEN]]></Line>
<Line Number="22"><![CDATA[    FOR FRK_Press_LineWork.I := 0 TO 3 DO]]></Line>
<Line Number="23"><![CDATA[        FOR FRK_Press_LineWork.J := FRK_Press_LineWork.I + 1 TO 4 DO]]></Line>
<Line Number="24"><![CDATA[            IF (FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.I] >= 0)]]></Line>
<Line Number="25"><![CDATA[                AND (FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.J] >= 0) THEN]]></Line>
<Line Number="26"><![CDATA[                FRK_Press_LineWork.Selected := FRK_Press_LineWork.CandidateDays[FRK_Press_LineWork.I];]]></Line>
<Line Number="27"><![CDATA[                FRK_Press_LineWork.NextMinute := FRK_Press_LineWork.CandidateDays[FRK_Press_LineWork.J];]]></Line>
<Line Number="28"><![CDATA[                FRK_Press_LineWork.Start := FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.I] + FRK_Press_LineWork.CandidateDuration[FRK_Press_LineWork.I];]]></Line>
<Line Number="29"><![CDATA[                FRK_Press_LineWork.OtherStart := FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.J] + FRK_Press_LineWork.CandidateDuration[FRK_Press_LineWork.J];]]></Line>
<Line Number="30"><![CDATA[                IF (FRK_Press_LineWork.Selected AND FRK_Press_LineWork.NextMinute) <> 0 THEN]]></Line>
<Line Number="31"><![CDATA[                    IF (FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.I] < FRK_Press_LineWork.OtherStart)]]></Line>
<Line Number="32"><![CDATA[                        AND (FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.J] < FRK_Press_LineWork.Start) THEN]]></Line>
<Line Number="33"><![CDATA[                        FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="34"><![CDATA[                    END_IF;]]></Line>
<Line Number="35"><![CDATA[                END_IF;]]></Line>
<Line Number="36"><![CDATA[                FRK_Press_LineWork.Day := FRK_Press_LineWork.Selected * 2;]]></Line>
<Line Number="37"><![CDATA[                IF FRK_Press_LineWork.Day > 127 THEN]]></Line>
<Line Number="38"><![CDATA[                    FRK_Press_LineWork.Day := FRK_Press_LineWork.Day - 127;]]></Line>
<Line Number="39"><![CDATA[                END_IF;]]></Line>
<Line Number="40"><![CDATA[                IF (FRK_Press_LineWork.Day AND FRK_Press_LineWork.NextMinute) <> 0 THEN]]></Line>
<Line Number="41"><![CDATA[                    IF FRK_Press_LineWork.Start > (1440 + FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.J]) THEN]]></Line>
<Line Number="42"><![CDATA[                        FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="43"><![CDATA[                    END_IF;]]></Line>
<Line Number="44"><![CDATA[                END_IF;]]></Line>
<Line Number="45"><![CDATA[                FRK_Press_LineWork.OtherDay := FRK_Press_LineWork.NextMinute * 2;]]></Line>
<Line Number="46"><![CDATA[                IF FRK_Press_LineWork.OtherDay > 127 THEN]]></Line>
<Line Number="47"><![CDATA[                    FRK_Press_LineWork.OtherDay := FRK_Press_LineWork.OtherDay - 127;]]></Line>
<Line Number="48"><![CDATA[                END_IF;]]></Line>
<Line Number="49"><![CDATA[                IF (FRK_Press_LineWork.OtherDay AND FRK_Press_LineWork.Selected) <> 0 THEN]]></Line>
<Line Number="50"><![CDATA[                    IF FRK_Press_LineWork.OtherStart > (1440 + FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.I]) THEN]]></Line>
<Line Number="51"><![CDATA[                        FRK_Press_LineWork.Valid := 0;]]></Line>
<Line Number="52"><![CDATA[                    END_IF;]]></Line>
<Line Number="53"><![CDATA[                END_IF;]]></Line>
<Line Number="54"><![CDATA[            END_IF;]]></Line>
<Line Number="55"><![CDATA[        END_FOR;]]></Line>
<Line Number="56"><![CDATA[    END_FOR;]]></Line>
<Line Number="57"><![CDATA[END_IF;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_LineSearch" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_LineWork.Start := FRK_Press_LineWork.NowMinute + FRK_Press_LineWork.AppliedOffset;]]></Line>
<Line Number="1"><![CDATA[FRK_Press_LineWork.LocalDay := (FRK_Press_LineWork.Start - (FRK_Press_LineWork.Start MOD 1440)) / 1440;]]></Line>
<Line Number="2"><![CDATA[IF (FRK_Press_LineWork.Start MOD 1440) < 0 THEN]]></Line>
<Line Number="3"><![CDATA[    FRK_Press_LineWork.LocalDay := FRK_Press_LineWork.LocalDay - 1;]]></Line>
<Line Number="4"><![CDATA[END_IF;]]></Line>
<Line Number="5"><![CDATA[FRK_Press_LineWork.Selected := 0;]]></Line>
<Line Number="6"><![CDATA[FRK_Press_LineWork.NextMinute := 0;]]></Line>
<Line Number="7"><![CDATA[FOR FRK_Press_LineWork.I := 0 TO 4 DO]]></Line>
<Line Number="8"><![CDATA[    IF FRK_Press_LineWork.AppliedStart[FRK_Press_LineWork.I] >= 0 THEN]]></Line>
<Line Number="9"><![CDATA[        FOR FRK_Press_LineWork.Delta := -1 TO 7 DO]]></Line>
<Line Number="10"><![CDATA[            FRK_Press_LineWork.Day := (FRK_Press_LineWork.LocalDay + FRK_Press_LineWork.Delta + 3) MOD 7;]]></Line>
<Line Number="11"><![CDATA[            CASE FRK_Press_LineWork.Day OF]]></Line>
<Line Number="12"><![CDATA[                0:]]></Line>
<Line Number="13"><![CDATA[                    FRK_Press_LineWork.Weekday := FRK_Press_LineWork.AppliedDays[FRK_Press_LineWork.I] AND 1;]]></Line>
<Line Number="14"><![CDATA[]]></Line>
<Line Number="15"><![CDATA[                1:]]></Line>
<Line Number="16"><![CDATA[                    FRK_Press_LineWork.Weekday := FRK_Press_LineWork.AppliedDays[FRK_Press_LineWork.I] AND 2;]]></Line>
<Line Number="17"><![CDATA[]]></Line>
<Line Number="18"><![CDATA[                2:]]></Line>
<Line Number="19"><![CDATA[                    FRK_Press_LineWork.Weekday := FRK_Press_LineWork.AppliedDays[FRK_Press_LineWork.I] AND 4;]]></Line>
<Line Number="20"><![CDATA[]]></Line>
<Line Number="21"><![CDATA[                3:]]></Line>
<Line Number="22"><![CDATA[                    FRK_Press_LineWork.Weekday := FRK_Press_LineWork.AppliedDays[FRK_Press_LineWork.I] AND 8;]]></Line>
<Line Number="23"><![CDATA[]]></Line>
<Line Number="24"><![CDATA[                4:]]></Line>
<Line Number="25"><![CDATA[                    FRK_Press_LineWork.Weekday := FRK_Press_LineWork.AppliedDays[FRK_Press_LineWork.I] AND 16;]]></Line>
<Line Number="26"><![CDATA[]]></Line>
<Line Number="27"><![CDATA[                5:]]></Line>
<Line Number="28"><![CDATA[                    FRK_Press_LineWork.Weekday := FRK_Press_LineWork.AppliedDays[FRK_Press_LineWork.I] AND 32;]]></Line>
<Line Number="29"><![CDATA[]]></Line>
<Line Number="30"><![CDATA[                6:]]></Line>
<Line Number="31"><![CDATA[                    FRK_Press_LineWork.Weekday := FRK_Press_LineWork.AppliedDays[FRK_Press_LineWork.I] AND 64;]]></Line>
<Line Number="32"><![CDATA[            END_CASE;]]></Line>
<Line Number="33"><![CDATA[            IF FRK_Press_LineWork.Weekday <> 0 THEN]]></Line>
<Line Number="34"><![CDATA[                FRK_Press_LineWork.OtherStart := (FRK_Press_LineWork.LocalDay + FRK_Press_LineWork.Delta) * 1440 + FRK_Press_LineWork.AppliedStart[FRK_Press_LineWork.I] - FRK_Press_LineWork.AppliedOffset;]]></Line>
<Line Number="35"><![CDATA[                IF (FRK_Press_LineWork.OtherStart <= FRK_Press_LineWork.NowMinute)]]></Line>
<Line Number="36"><![CDATA[                    AND (FRK_Press_LineWork.NowMinute < (FRK_Press_LineWork.OtherStart + FRK_Press_LineWork.AppliedDuration[FRK_Press_LineWork.I])) THEN]]></Line>
<Line Number="37"><![CDATA[                    FRK_Press_LineWork.Selected := FRK_Press_LineWork.I + 1;]]></Line>
<Line Number="38"><![CDATA[                    FRK_Press_LineWork.NextMinute := FRK_Press_LineWork.OtherStart + FRK_Press_LineWork.AppliedDuration[FRK_Press_LineWork.I];]]></Line>
<Line Number="39"><![CDATA[                ELSIF ((FRK_Press_LineWork.OtherStart > FRK_Press_LineWork.NowMinute)]]></Line>
<Line Number="40"><![CDATA[                    AND ((FRK_Press_LineWork.NextMinute = 0)]]></Line>
<Line Number="41"><![CDATA[                    OR (FRK_Press_LineWork.OtherStart < FRK_Press_LineWork.NextMinute))) THEN]]></Line>
<Line Number="42"><![CDATA[                    FRK_Press_LineWork.NextMinute := FRK_Press_LineWork.OtherStart;]]></Line>
<Line Number="43"><![CDATA[                END_IF;]]></Line>
<Line Number="44"><![CDATA[            END_IF;]]></Line>
<Line Number="45"><![CDATA[        END_FOR;]]></Line>
<Line Number="46"><![CDATA[    END_IF;]]></Line>
<Line Number="47"><![CDATA[END_FOR;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_LineClose" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FOR FRK_Press_LineWork.I := 7 TO 1 BY -1 DO]]></Line>
<Line Number="1"><![CDATA[    FRK_Press_LineShift.HistoryIndex[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryIndex[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="2"><![CDATA[    FRK_Press_LineShift.HistoryStartMinute[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryStartMinute[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="3"><![CDATA[    FRK_Press_LineShift.HistoryStartMs[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryStartMs[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="4"><![CDATA[    FRK_Press_LineShift.HistoryEndMinute[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryEndMinute[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="5"><![CDATA[    FRK_Press_LineShift.HistoryEndMs[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryEndMs[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="6"><![CDATA[    FRK_Press_LineShift.HistoryTimeSynchronized[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryTimeSynchronized[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="7"><![CDATA[    FRK_Press_LineShift.HistoryManualReset[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryManualReset[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="8"><![CDATA[    FRK_Press_LineShift.HistoryGood[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryGood[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="9"><![CDATA[    FRK_Press_LineShift.HistoryNok[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryNok[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="10"><![CDATA[    FRK_Press_LineShift.HistoryRework[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryRework[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="11"><![CDATA[    FRK_Press_LineShift.HistoryOeeGood[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryOeeGood[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="12"><![CDATA[    FRK_Press_LineShift.HistoryOeeNok[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryOeeNok[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="13"><![CDATA[    FRK_Press_LineShift.HistoryRunS[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryRunS[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="14"><![CDATA[    FRK_Press_LineShift.HistoryRunMs[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryRunMs[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="15"><![CDATA[    FRK_Press_LineShift.HistoryDownS[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryDownS[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="16"><![CDATA[    FRK_Press_LineShift.HistoryDownMs[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryDownMs[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="17"><![CDATA[    FRK_Press_LineShift.HistoryIdleS[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryIdleS[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="18"><![CDATA[    FRK_Press_LineShift.HistoryIdleMs[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryIdleMs[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="19"><![CDATA[    FRK_Press_LineShift.HistoryIdealMs[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryIdealMs[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="20"><![CDATA[    FRK_Press_LineShift.HistoryProductionTarget[FRK_Press_LineWork.I] := FRK_Press_LineShift.HistoryProductionTarget[FRK_Press_LineWork.I - 1];]]></Line>
<Line Number="21"><![CDATA[END_FOR;]]></Line>
<Line Number="22"><![CDATA[IF FRK_Press_LineShift.Count < 8 THEN]]></Line>
<Line Number="23"><![CDATA[    FRK_Press_LineShift.Count := FRK_Press_LineShift.Count + 1;]]></Line>
<Line Number="24"><![CDATA[ELSE]]></Line>
<Line Number="25"><![CDATA[    FRK_Press_LineShift.Truncated := 1;]]></Line>
<Line Number="26"><![CDATA[END_IF;]]></Line>
<Line Number="27"><![CDATA[FRK_Press_LineShift.HistoryIndex[0] := FRK_Press_LineShift.Current;]]></Line>
<Line Number="28"><![CDATA[FRK_Press_LineShift.HistoryStartMinute[0] := FRK_Press_LineShift.StartedMinute;]]></Line>
<Line Number="29"><![CDATA[FRK_Press_LineShift.HistoryStartMs[0] := FRK_Press_LineShift.StartedMs;]]></Line>
<Line Number="30"><![CDATA[FRK_Press_LineShift.HistoryEndMinute[0] := FRK_Press_LineWork.NowMinute;]]></Line>
<Line Number="31"><![CDATA[FRK_Press_LineShift.HistoryEndMs[0] := FRK_Press_NowTime MOD 100000;]]></Line>
<Line Number="32"><![CDATA[FRK_Press_LineShift.HistoryTimeSynchronized[0] := FRK_Press_LineShift.TimeSynchronized;]]></Line>
<Line Number="33"><![CDATA[FRK_Press_LineShift.HistoryManualReset[0] := FRK_Press_LineShift.ManualReset;]]></Line>
<Line Number="34"><![CDATA[FRK_Press_LineShift.HistoryGood[0] := FRK_Press_Unit.GoodCount;]]></Line>
<Line Number="35"><![CDATA[FRK_Press_LineShift.HistoryNok[0] := FRK_Press_Unit.ScrapCount;]]></Line>
<Line Number="36"><![CDATA[FRK_Press_LineShift.HistoryRework[0] := FRK_Press_Unit.ReworkCount;]]></Line>
<Line Number="37"><![CDATA[FRK_Press_LineShift.HistoryOeeGood[0] := FRK_Press_Unit.GoodCount - FRK_Press_Oee.GoodBase;]]></Line>
<Line Number="38"><![CDATA[FRK_Press_LineShift.HistoryOeeNok[0] := FRK_Press_Unit.ScrapCount - FRK_Press_Oee.NokBase;]]></Line>
<Line Number="39"><![CDATA[FRK_Press_LineShift.HistoryRunS[0] := FRK_Press_Oee.RunS;]]></Line>
<Line Number="40"><![CDATA[FRK_Press_LineShift.HistoryRunMs[0] := FRK_Press_Oee.RunMs;]]></Line>
<Line Number="41"><![CDATA[FRK_Press_LineShift.HistoryDownS[0] := FRK_Press_Oee.DownS;]]></Line>
<Line Number="42"><![CDATA[FRK_Press_LineShift.HistoryDownMs[0] := FRK_Press_Oee.DownMs;]]></Line>
<Line Number="43"><![CDATA[FRK_Press_LineShift.HistoryIdleS[0] := FRK_Press_Oee.IdleS;]]></Line>
<Line Number="44"><![CDATA[FRK_Press_LineShift.HistoryIdleMs[0] := FRK_Press_Oee.IdleMs;]]></Line>
<Line Number="45"><![CDATA[FRK_Press_LineShift.HistoryIdealMs[0] := FRK_T_PressParCfgTag.IdealCycleMs;]]></Line>
<Line Number="46"><![CDATA[FRK_Press_LineShift.HistoryProductionTarget[0] := FRK_Press_LineShift.ProductionTarget;]]></Line>
<Line Number="47"><![CDATA[FRK_Press_LineShift.ClosedSequence := FRK_Press_LineShift.ClosedSequence + 1;]]></Line>
<Line Number="48"><![CDATA[IF FRK_Press_LineShift.ClosedSequence <= 0 THEN]]></Line>
<Line Number="49"><![CDATA[    FRK_Press_LineShift.ClosedSequence := 1;]]></Line>
<Line Number="50"><![CDATA[END_IF;]]></Line>
<Line Number="51"><![CDATA[FRK_Press_AccessWork.AuditKey := 649;]]></Line>
<Line Number="52"><![CDATA[FRK_Press_AccessWork.AuditKind := 0;]]></Line>
<Line Number="53"><![CDATA[FRK_Press_AccessWork.AuditSequence := FRK_Press_LineShift.ClosedSequence;]]></Line>
<Line Number="54"><![CDATA[FRK_Press_AccessWork.AuditAccepted := 1;]]></Line>
<Line Number="55"><![CDATA[FRK_Press_AccessWork.AuditLength := 0;]]></Line>
<Line Number="56"><![CDATA[FRK_Press_AccessWork.AuditSource := 1;]]></Line>
<Line Number="57"><![CDATA[FRK_Press_AccessWork.AuditEventSource := 1;]]></Line>
<Line Number="58"><![CDATA[FRK_Press_AccessWork.AuditGate := -1;]]></Line>
<Line Number="59"><![CDATA[JSR(FRK_Press_AccessRecordAudit, 0);]]></Line>
<Line Number="60"><![CDATA[FRK_Press_Unit.GoodCount := 0;]]></Line>
<Line Number="61"><![CDATA[FRK_Press_Unit.ScrapCount := 0;]]></Line>
<Line Number="62"><![CDATA[FRK_Press_Unit.ReworkCount := 0;]]></Line>
<Line Number="63"><![CDATA[FRK_Press_Oee.RunS := 0;]]></Line>
<Line Number="64"><![CDATA[FRK_Press_Oee.RunMs := 0;]]></Line>
<Line Number="65"><![CDATA[FRK_Press_Oee.DownS := 0;]]></Line>
<Line Number="66"><![CDATA[FRK_Press_Oee.DownMs := 0;]]></Line>
<Line Number="67"><![CDATA[FRK_Press_Oee.IdleS := 0;]]></Line>
<Line Number="68"><![CDATA[FRK_Press_Oee.IdleMs := 0;]]></Line>
<Line Number="69"><![CDATA[FRK_Press_Oee.GoodBase := FRK_Press_Unit.GoodCount;]]></Line>
<Line Number="70"><![CDATA[FRK_Press_Oee.NokBase := FRK_Press_Unit.ScrapCount;]]></Line>
<Line Number="71"><![CDATA[FRK_Press_LineShift.ManualReset := 0;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_LineApply" Type="ST">
<STContent>
<Line Number="0"><![CDATA[JSR(FRK_Press_LineStage, 0);]]></Line>
<Line Number="1"><![CDATA[FRK_Press_LineWork.AppliedOffset := FRK_Press_LineWork.CandidateOffset;]]></Line>
<Line Number="2"><![CDATA[FOR FRK_Press_LineWork.I := 0 TO 4 DO]]></Line>
<Line Number="3"><![CDATA[    FRK_Press_LineWork.AppliedStart[FRK_Press_LineWork.I] := FRK_Press_LineWork.CandidateStart[FRK_Press_LineWork.I];]]></Line>
<Line Number="4"><![CDATA[    FRK_Press_LineWork.AppliedDuration[FRK_Press_LineWork.I] := FRK_Press_LineWork.CandidateDuration[FRK_Press_LineWork.I];]]></Line>
<Line Number="5"><![CDATA[    FRK_Press_LineWork.AppliedDays[FRK_Press_LineWork.I] := FRK_Press_LineWork.CandidateDays[FRK_Press_LineWork.I];]]></Line>
<Line Number="6"><![CDATA[    FRK_Press_LineWork.AppliedTarget[FRK_Press_LineWork.I] := FRK_Press_LineWork.CandidateTarget[FRK_Press_LineWork.I];]]></Line>
<Line Number="7"><![CDATA[END_FOR;]]></Line>
<Line Number="8"><![CDATA[FRK_Press_LineShift.AppliedRevision := FRK_Press_LineState.Revision;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_Press_ConfigRecordAudit" Type="ST">
<STContent>
<Line Number="0"><![CDATA[FRK_Press_ConfigAudit.Head := (FRK_Press_ConfigAudit.Head MOD 16) + 1;]]></Line>
<Line Number="1"><![CDATA[IF FRK_Press_ConfigAudit.Count < 16 THEN]]></Line>
<Line Number="2"><![CDATA[    FRK_Press_ConfigAudit.Count := FRK_Press_ConfigAudit.Count + 1;]]></Line>
<Line Number="3"><![CDATA[END_IF;]]></Line>
<Line Number="4"><![CDATA[FRK_Press_ConfigAudit.Sequence[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_HmiRequest.Sequence;]]></Line>
<Line Number="5"><![CDATA[FRK_Press_ConfigAudit.Kind[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_HmiRequest.Kind;]]></Line>
<Line Number="6"><![CDATA[FRK_Press_ConfigAudit.Capability[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_HmiRequest.IntValue;]]></Line>
<Line Number="7"><![CDATA[FRK_Press_ConfigAudit.Value[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_ConfigCandidate;]]></Line>
<Line Number="8"><![CDATA[FRK_Press_ConfigAudit.Revision[FRK_Press_ConfigAudit.Head - 1] := 15071508;]]></Line>
<Line Number="9"><![CDATA[FRK_Press_ConfigAudit.ModelOrdinal[FRK_Press_ConfigAudit.Head - 1] := 0;]]></Line>
<Line Number="10"><![CDATA[FRK_Press_ConfigAudit.SourceKey[FRK_Press_ConfigAudit.Head - 1] := 0;]]></Line>
<Line Number="11"><![CDATA[CASE FRK_Press_HmiRequest.IntValue OF]]></Line>
<Line Number="12"><![CDATA[    1, 2, 3, 4:]]></Line>
<Line Number="13"><![CDATA[        FRK_Press_ConfigAudit.ModelOrdinal[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_Unit.ModelOrdinal;]]></Line>
<Line Number="14"><![CDATA[        IF (FRK_Press_HmiRequest.Kind = 19) AND (FRK_Press_HmiRequest.DurationMs <> 0) THEN]]></Line>
<Line Number="15"><![CDATA[            FRK_Press_ConfigAudit.ModelOrdinal[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_HmiRequest.DurationMs;]]></Line>
<Line Number="16"><![CDATA[        END_IF;]]></Line>
<Line Number="17"><![CDATA[    ELSE]]></Line>
<Line Number="18"><![CDATA[        (* Station values have no model ordinal. *)]]></Line>
<Line Number="19"><![CDATA[END_CASE;]]></Line>
<Line Number="20"><![CDATA[IF FRK_Press_HmiRequest.Kind = 27 THEN]]></Line>
<Line Number="21"><![CDATA[    CASE FRK_Press_HmiRequest.IntValue OF]]></Line>
<Line Number="22"><![CDATA[        4:]]></Line>
<Line Number="23"><![CDATA[            FRK_Press_ConfigAudit.SourceKey[FRK_Press_ConfigAudit.Head - 1] := 153;]]></Line>
<Line Number="24"><![CDATA[        ELSE]]></Line>
<Line Number="25"><![CDATA[            (* Only registered captures reach the audit. *)]]></Line>
<Line Number="26"><![CDATA[    END_CASE;]]></Line>
<Line Number="27"><![CDATA[END_IF;]]></Line>
<Line Number="28"><![CDATA[FRK_Press_ConfigAudit.Date[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_NowDate;]]></Line>
<Line Number="29"><![CDATA[FRK_Press_ConfigAudit.Clock[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_NowTime;]]></Line>
<Line Number="30"><![CDATA[FRK_Press_ConfigAudit.UserLength[FRK_Press_ConfigAudit.Head - 1] := FRK_Press_AccessState.UserLength;]]></Line>
