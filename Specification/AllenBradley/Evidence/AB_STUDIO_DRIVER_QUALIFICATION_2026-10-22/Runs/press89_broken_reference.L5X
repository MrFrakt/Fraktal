<DataType Name="FRK_T_Oee" Family="NoFamily" Class="User"><Description><![CDATA[Core §8.5.1 OEE time accounting and trend]]></Description>
<Members>
<Member Name="SchemaVersion" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"></Member>
<Member Name="Epoch" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[bumped by RESET_OEE; a sample of another epoch is gone]]></Description></Member>
<Member Name="RunS" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[BUSY seconds since the reset]]></Description></Member>
<Member Name="RunMs" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[and the milliseconds past them]]></Description></Member>
<Member Name="DownS" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[ERROR or blocking-alarm seconds since the reset]]></Description></Member>
<Member Name="DownMs" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[and the milliseconds past them]]></Description></Member>
<Member Name="IdleS" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[every other second since the reset]]></Description></Member>
<Member Name="IdleMs" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[and the milliseconds past them]]></Description></Member>
<Member Name="GoodBase" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[GoodCount at the reset]]></Description></Member>
<Member Name="NokBase" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[the NOK count at the reset]]></Description></Member>
<Member Name="SampleMs" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[time toward the next trend sample]]></Description></Member>
<Member Name="Head" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[1-based slot of the newest sample, 0 = none since the reset]]></Description></Member>
<Member Name="SmpEpoch" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[the reset epoch it was taken in; another epoch's is not shown]]></Description></Member>
<Member Name="SmpRunS" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[run seconds since the reset, at the sample]]></Description></Member>
<Member Name="SmpRunMs" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[and the milliseconds past them]]></Description></Member>
<Member Name="SmpDownS" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[down seconds since the reset, at the sample]]></Description></Member>
<Member Name="SmpDownMs" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[and the milliseconds past them]]></Description></Member>
<Member Name="SmpGood" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[good parts since the reset, at the sample]]></Description></Member>
<Member Name="SmpNok" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[NOK parts since the reset, at the sample]]></Description></Member>
<Member Name="SmpIdealMs" DataType="DINT" Dimension="60" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"><Description><![CDATA[the ideal cycle in force at the sample]]></Description></Member>
</Members>
</DataType>
