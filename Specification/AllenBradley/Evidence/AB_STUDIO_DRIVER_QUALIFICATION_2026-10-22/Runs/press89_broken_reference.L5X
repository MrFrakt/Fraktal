<Line Number="573"><![CDATA[            FRK_Press_ModelCfg[FRK_Press_ModelCatalog.Count].TransferSettleMs := FRK_Press_ConfigSetState.Snapshot[0];]]></Line>
<Line Number="574"><![CDATA[            FRK_Press_ModelCfg[FRK_Press_ModelCatalog.Count].PressDwellMs := FRK_Press_ConfigSetState.Snapshot[1];]]></Line>
<Line Number="575"><![CDATA[            FRK_Press_ModelCfg[FRK_Press_ModelCatalog.Count].IdealCycleMs := FRK_Press_ConfigSetState.Snapshot[2];]]></Line>
<Line Number="576"><![CDATA[            FRK_Press_ModelCfg[FRK_Press_ModelCatalog.Count].BaselineWorkMs := FRK_Press_ConfigSetState.Snapshot[3];]]></Line>
<Line Number="577"><![CDATA[            FRK_Press_ModelCfg[FRK_Press_ModelCatalog.Count].SchemaVersion := 4;]]></Line>
<Line Number="578"><![CDATA[            FRK_Press_ModelCatalog.CodeLength[FRK_Press_ModelCatalog.Count] := FRK_Press_SetStaged.NameLength;]]></Line>
<Line Number="579"><![CDATA[            FOR FRK_Press_SetCopy := 0 TO 79 DO]]></Line>
<Line Number="580"><![CDATA[                FRK_Press_ModelCatalog.CodeBytes[FRK_Press_ModelCatalog.Count * 80 + FRK_Press_SetCopy] := FRK_Press_SetStaged.NameBytes[FRK_Press_SetCopy];]]></Line>
<Line Number="581"><![CDATA[            END_FOR;]]></Line>
<Line Number="582"><![CDATA[            FRK_Press_ModelCatalog.Count := FRK_Press_ModelCatalog.Count + 1;]]></Line>
<Line Number="583"><![CDATA[            (* publication marker last; inactive *)]]></Line>
<Line Number="584"><![CDATA[]]></Line>
<Line Number="585"><![CDATA[        29:]]></Line>
<Line Number="586"><![CDATA[            (* Pass two: all checks finished; bounded, infallible commit. *)]]></Line>
<Line Number="587"><![CDATA[            FOR FRK_Press_SetIndex := 0 TO FRK_Press_SetStaged.Count - 1 DO]]></Line>
<Line Number="588"><![CDATA[                CASE FRK_Press_SetStaged.Ordinal[FRK_Press_SetIndex] OF]]></Line>
<Line Number="589"><![CDATA[                    1:]]></Line>
<Line Number="590"><![CDATA[                        FRK_Press_ModelCfg[FRK_Press_HmiRequest.DurationMs - 1].TransferSettleMs := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="591"><![CDATA[]]></Line>
<Line Number="592"><![CDATA[                    2:]]></Line>
<Line Number="593"><![CDATA[                        FRK_Press_ModelCfg[FRK_Press_HmiRequest.DurationMs - 1].PressDwellMs := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="594"><![CDATA[]]></Line>
<Line Number="595"><![CDATA[                    3:]]></Line>
<Line Number="596"><![CDATA[                        FRK_Press_ModelCfg[FRK_Press_HmiRequest.DurationMs - 1].IdealCycleMs := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="597"><![CDATA[]]></Line>
<Line Number="598"><![CDATA[                    4:]]></Line>
<Line Number="599"><![CDATA[                        FRK_Press_ModelCfg[FRK_Press_HmiRequest.DurationMs - 1].BaselineWorkMs := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="600"><![CDATA[]]></Line>
<Line Number="601"><![CDATA[                    5:]]></Line>
<Line Number="602"><![CDATA[                        FRK_T_PressStationCfgTag.StationNumber := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="603"><![CDATA[]]></Line>
<Line Number="604"><![CDATA[                    6:]]></Line>
<Line Number="605"><![CDATA[                        FRK_T_PressStationCfgTag.RamExtendLimitMs := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="606"><![CDATA[]]></Line>
<Line Number="607"><![CDATA[                    7:]]></Line>
<Line Number="608"><![CDATA[                        FRK_T_PressStationCfgTag.AirPressureMinKpa := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="609"><![CDATA[]]></Line>
<Line Number="610"><![CDATA[                    8:]]></Line>
<Line Number="611"><![CDATA[                        FRK_T_PressStationCfgTag.AirConflictTimeMs := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="612"><![CDATA[]]></Line>
<Line Number="613"><![CDATA[                    9:]]></Line>
<Line Number="614"><![CDATA[                        FRK_T_PressStationCfgTag.RequireTwoHandStart := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="615"><![CDATA[]]></Line>
<Line Number="616"><![CDATA[                    10:]]></Line>
<Line Number="617"><![CDATA[                        FRK_T_LineCfgV3Tag.UtcOffsetMin := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="618"><![CDATA[]]></Line>
<Line Number="619"><![CDATA[                    11:]]></Line>
<Line Number="620"><![CDATA[                        FRK_T_LineCfgV3Tag.StartMin1 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="621"><![CDATA[]]></Line>
<Line Number="622"><![CDATA[                    12:]]></Line>
<Line Number="623"><![CDATA[                        FRK_T_LineCfgV3Tag.DurationMin1 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="624"><![CDATA[]]></Line>
<Line Number="625"><![CDATA[                    13:]]></Line>
<Line Number="626"><![CDATA[                        FRK_T_LineCfgV3Tag.ActiveDays1 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="627"><![CDATA[]]></Line>
<Line Number="628"><![CDATA[                    14:]]></Line>
<Line Number="629"><![CDATA[                        FRK_T_LineCfgV3Tag.StartMin2 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="630"><![CDATA[]]></Line>
<Line Number="631"><![CDATA[                    15:]]></Line>
<Line Number="632"><![CDATA[                        FRK_T_LineCfgV3Tag.DurationMin2 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="633"><![CDATA[]]></Line>
<Line Number="634"><![CDATA[                    16:]]></Line>
<Line Number="635"><![CDATA[                        FRK_T_LineCfgV3Tag.ActiveDays2 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="636"><![CDATA[]]></Line>
<Line Number="637"><![CDATA[                    17:]]></Line>
<Line Number="638"><![CDATA[                        FRK_T_LineCfgV3Tag.StartMin3 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="639"><![CDATA[]]></Line>
<Line Number="640"><![CDATA[                    18:]]></Line>
<Line Number="641"><![CDATA[                        FRK_T_LineCfgV3Tag.DurationMin3 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="642"><![CDATA[]]></Line>
<Line Number="643"><![CDATA[                    19:]]></Line>
<Line Number="644"><![CDATA[                        FRK_T_LineCfgV3Tag.ActiveDays3 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="645"><![CDATA[]]></Line>
<Line Number="646"><![CDATA[                    20:]]></Line>
<Line Number="647"><![CDATA[                        FRK_T_LineCfgV3Tag.StartMin4 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="648"><![CDATA[]]></Line>
<Line Number="649"><![CDATA[                    21:]]></Line>
<Line Number="650"><![CDATA[                        FRK_T_LineCfgV3Tag.DurationMin4 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="651"><![CDATA[]]></Line>
<Line Number="652"><![CDATA[                    22:]]></Line>
<Line Number="653"><![CDATA[                        FRK_T_LineCfgV3Tag.ActiveDays4 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="654"><![CDATA[]]></Line>
<Line Number="655"><![CDATA[                    23:]]></Line>
<Line Number="656"><![CDATA[                        FRK_T_LineCfgV3Tag.StartMin5 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="657"><![CDATA[]]></Line>
<Line Number="658"><![CDATA[                    24:]]></Line>
<Line Number="659"><![CDATA[                        FRK_T_LineCfgV3Tag.DurationMin5 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="660"><![CDATA[]]></Line>
<Line Number="661"><![CDATA[                    25:]]></Line>
<Line Number="662"><![CDATA[                        FRK_T_LineCfgV3Tag.ActiveDays5 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="663"><![CDATA[]]></Line>
<Line Number="664"><![CDATA[                    26:]]></Line>
<Line Number="665"><![CDATA[                        FRK_T_LineCfgV3Tag.ProductionTarget1 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="666"><![CDATA[]]></Line>
<Line Number="667"><![CDATA[                    27:]]></Line>
<Line Number="668"><![CDATA[                        FRK_T_LineCfgV3Tag.ProductionTarget2 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="669"><![CDATA[]]></Line>
<Line Number="670"><![CDATA[                    28:]]></Line>
<Line Number="671"><![CDATA[                        FRK_T_LineCfgV3Tag.ProductionTarget3 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="672"><![CDATA[]]></Line>
<Line Number="673"><![CDATA[                    29:]]></Line>
<Line Number="674"><![CDATA[                        FRK_T_LineCfgV3Tag.ProductionTarget4 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="675"><![CDATA[]]></Line>
<Line Number="676"><![CDATA[                    30:]]></Line>
<Line Number="677"><![CDATA[                        FRK_T_LineCfgV3Tag.ProductionTarget5 := FRK_Press_SetStaged.Value[FRK_Press_SetIndex];]]></Line>
<Line Number="678"><![CDATA[                    ELSE]]></Line>
<Line Number="679"><![CDATA[                        (* Unreachable: pass one rejected unknown capabilities. *)]]></Line>
<Line Number="680"><![CDATA[                END_CASE;]]></Line>
<Line Number="681"><![CDATA[            END_FOR;]]></Line>
<Line Number="682"><![CDATA[            IF FRK_Press_SetStaged.Kind = 2 THEN]]></Line>
<Line Number="683"><![CDATA[                FRK_Press_LineState.Revision := FRK_Press_LineState.Revision + 1;]]></Line>
<Line Number="684"><![CDATA[                IF FRK_Press_LineState.Revision <= 0 THEN]]></Line>
<Line Number="685"><![CDATA[                    FRK_Press_LineState.Revision := 1;]]></Line>
<Line Number="686"><![CDATA[                END_IF;]]></Line>
<Line Number="687"><![CDATA[                FRK_Press_LineState.UpdatedDate := FRK_Press_NowDate;]]></Line>
<Line Number="688"><![CDATA[                FRK_Press_LineState.UpdatedClock := FRK_Press_NowTime;]]></Line>
<Line Number="689"><![CDATA[            END_IF;]]></Line>
<Line Number="690"><![CDATA[            IF (FRK_Press_SetStaged.Kind = 0) AND (FRK_Press_HmiRequest.DurationMs = FRK_Press_Unit.ModelOrdinal) THEN]]></Line>
<Line Number="691"><![CDATA[                FRK_Press_Unit.CommitModel := FRK_Press_HmiRequest.DurationMs;]]></Line>
<Line Number="692"><![CDATA[            END_IF;]]></Line>
<Line Number="693"><![CDATA[            IF (FRK_Press_SetStaged.Kind = 1) AND (FRK_T_PressStationCfgTag.SchemaVersion = 0) THEN]]></Line>
<Line Number="694"><![CDATA[                IF FRK_Press_SetStaged.StoreResult = 2 THEN]]></Line>
<Line Number="695"><![CDATA[                    FRK_Press_ConfigPersist.RestoreLost := 1;]]></Line>
<Line Number="696"><![CDATA[                    FRK_Press_ConfigPersist.LostModuleId := 1;]]></Line>
<Line Number="697"><![CDATA[                END_IF;]]></Line>
<Line Number="698"><![CDATA[                IF FRK_Press_HmiRequest.DurationMs <> 0 THEN]]></Line>
<Line Number="699"><![CDATA[                    FRK_Press_Unit.ModelOrdinal := FRK_Press_HmiRequest.DurationMs;]]></Line>
<Line Number="700"><![CDATA[                    FRK_Press_Unit.CommitModel := FRK_Press_HmiRequest.DurationMs;]]></Line>
<Line Number="701"><![CDATA[                END_IF;]]></Line>
<Line Number="702"><![CDATA[                FRK_T_PressStationCfgTag.SchemaVersion := 3;]]></Line>
<Line Number="703"><![CDATA[            END_IF;]]></Line>
<Line Number="704"><![CDATA[        ELSE]]></Line>
<Line Number="705"><![CDATA[            (* Document operations do not apply equipment values. *)]]></Line>
<Line Number="706"><![CDATA[    END_CASE;]]></Line>
<Line Number="707"><![CDATA[    FRK_Press_HmiResponse.Accepted := 1;]]></Line>
<Line Number="708"><![CDATA[    FRK_Press_ConfigPersist.StorePresent := 1;]]></Line>
<Line Number="709"><![CDATA[    FRK_Press_ConfigPersist.StoreKind := 1;]]></Line>
<Line Number="710"><![CDATA[    (* FILE_JSON *)]]></Line>
<Line Number="711"><![CDATA[    IF (FRK_Press_SetStaged.Operation = 28) OR (FRK_Press_SetStaged.Operation = 35) THEN]]></Line>
<Line Number="712"><![CDATA[        FRK_Press_ConfigPersist.Pending := 1;]]></Line>
<Line Number="713"><![CDATA[        FRK_Press_ConfigPersist.Failed := 0;]]></Line>
<Line Number="714"><![CDATA[        FRK_Press_ConfigPersist.PendingSince := FRK_Press_NowTime;]]></Line>
<Line Number="715"><![CDATA[        FRK_Press_ConfigSetState.PendingMs := 0;]]></Line>
<Line Number="716"><![CDATA[        FRK_Press_ConfigSetState.PendingSequence := FRK_Press_SetStaged.Sequence;]]></Line>
<Line Number="717"><![CDATA[        FRK_Press_ConfigSetState.PendingSlot := FRK_Press_ConfigSetState.Head MOD 16;]]></Line>
<Line Number="718"><![CDATA[    END_IF;]]></Line>
<Line Number="719"><![CDATA[    IF (FRK_Press_SetStaged.Operation = 33) AND (FRK_Press_SetStaged.Commit <> 0) THEN]]></Line>
<Line Number="720"><![CDATA[        FRK_Press_ConfigPersist.Pending := 1;]]></Line>
<Line Number="721"><![CDATA[        FRK_Press_ConfigPersist.Failed := 0;]]></Line>
<Line Number="722"><![CDATA[        FRK_Press_ConfigPersist.PendingSince := FRK_Press_NowTime;]]></Line>
<Line Number="723"><![CDATA[        FRK_Press_ConfigSetState.PendingMs := 0;]]></Line>
<Line Number="724"><![CDATA[        FRK_Press_ConfigSetState.PendingSequence := FRK_Press_SetStaged.Sequence;]]></Line>
<Line Number="725"><![CDATA[        FRK_Press_ConfigSetState.PendingSlot := FRK_Press_ConfigSetState.Head MOD 16;]]></Line>
<Line Number="726"><![CDATA[    END_IF;]]></Line>
<Line Number="727"><![CDATA[ELSE]]></Line>
<Line Number="728"><![CDATA[    FRK_Press_HmiResponse.DiagnosticKey := FRK_Press_ConfigSetState.Reason;]]></Line>
<Line Number="729"><![CDATA[END_IF;]]></Line>
<Line Number="730"><![CDATA[IF FRK_Press_ConfigSetState.Reason <> 0 THEN]]></Line>
<Line Number="731"><![CDATA[    FRK_Press_Unit.ReportedReason := 2042;]]></Line>
<Line Number="732"><![CDATA[    FRK_Press_Unit.ReportedSource := 0;]]></Line>
<Line Number="733"><![CDATA[    FRK_Press_Unit.ReportedCount := FRK_Press_Unit.ReportedCount + 1;]]></Line>
<Line Number="734"><![CDATA[ELSIF FRK_Press_SetStaged.Operation = 29 THEN]]></Line>
<Line Number="735"><![CDATA[    FRK_Press_Unit.ReportedReason := 2043;]]></Line>
<Line Number="736"><![CDATA[    FRK_Press_Unit.ReportedSource := 0;]]></Line>
<Line Number="737"><![CDATA[    FRK_Press_Unit.ReportedCount := FRK_Press_Unit.ReportedCount + 1;]]></Line>
<Line Number="738"><![CDATA[END_IF;]]></Line>
<Line Number="739"><![CDATA[FRK_Press_ConfigSetState.Head := (FRK_Press_ConfigSetState.Head MOD 16) + 1;]]></Line>
<Line Number="740"><![CDATA[IF FRK_Press_ConfigSetState.AuditCount < 16 THEN]]></Line>
<Line Number="741"><![CDATA[    FRK_Press_ConfigSetState.AuditCount := FRK_Press_ConfigSetState.AuditCount + 1;]]></Line>
<Line Number="742"><![CDATA[END_IF;]]></Line>
<Line Number="743"><![CDATA[FRK_Press_ConfigSetState.AuditSequence[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_SetStaged.Sequence;]]></Line>
<Line Number="744"><![CDATA[FRK_Press_ConfigSetState.AuditKind[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_SetStaged.Operation;]]></Line>
<Line Number="745"><![CDATA[FRK_Press_ConfigSetState.AuditRecords[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_ConfigSetState.Count;]]></Line>
<Line Number="746"><![CDATA[FRK_Press_ConfigSetState.AuditReason[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_ConfigSetState.Reason;]]></Line>
<Line Number="747"><![CDATA[FRK_Press_ConfigSetState.AuditAccepted[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_HmiResponse.Accepted;]]></Line>
<Line Number="748"><![CDATA[FRK_Press_ConfigSetState.AuditRejectIndex[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_ConfigSetState.RejectIndex;]]></Line>
<Line Number="749"><![CDATA[FRK_Press_ConfigSetState.AuditDate[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_NowDate;]]></Line>
<Line Number="750"><![CDATA[FRK_Press_ConfigSetState.AuditClock[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_NowTime;]]></Line>
<Line Number="751"><![CDATA[FRK_Press_ConfigSetState.AuditNameLength[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_SetStaged.NameLength;]]></Line>
<Line Number="752"><![CDATA[FRK_Press_ConfigSetState.AuditUserLength[FRK_Press_ConfigSetState.Head - 1] := FRK_Press_AccessState.UserLength;]]></Line>
<Line Number="753"><![CDATA[FOR FRK_Press_SetCopy := 0 TO 79 DO]]></Line>
<Line Number="754"><![CDATA[    IF FRK_Press_SetCopy < FRK_Press_SetStaged.NameLength THEN]]></Line>
<Line Number="755"><![CDATA[        FRK_Press_ConfigSetState.AuditNameBytes[(FRK_Press_ConfigSetState.Head - 1) * 80 + FRK_Press_SetCopy] := FRK_Press_SetStaged.NameBytes[FRK_Press_SetCopy];]]></Line>
<Line Number="756"><![CDATA[    ELSE]]></Line>
<Line Number="757"><![CDATA[        FRK_Press_ConfigSetState.AuditNameBytes[(FRK_Press_ConfigSetState.Head - 1) * 80 + FRK_Press_SetCopy] := 0;]]></Line>
<Line Number="758"><![CDATA[    END_IF;]]></Line>
<Line Number="759"><![CDATA[END_FOR;]]></Line>
<Line Number="760"><![CDATA[FOR FRK_Press_SetCopy := 0 TO 31 DO]]></Line>
<Line Number="761"><![CDATA[    IF FRK_Press_SetCopy < FRK_Press_AccessState.UserLength THEN]]></Line>
<Line Number="762"><![CDATA[        FRK_Press_ConfigSetState.AuditUserBytes[(FRK_Press_ConfigSetState.Head - 1) * 32 + FRK_Press_SetCopy] := FRK_Press_AccessState.UserBytes[FRK_Press_SetCopy];]]></Line>
<Line Number="763"><![CDATA[    ELSE]]></Line>
<Line Number="764"><![CDATA[        FRK_Press_ConfigSetState.AuditUserBytes[(FRK_Press_ConfigSetState.Head - 1) * 32 + FRK_Press_SetCopy] := 0;]]></Line>
<Line Number="765"><![CDATA[    END_IF;]]></Line>
<Line Number="766"><![CDATA[END_FOR;]]></Line>
</STContent>
</Routine>
<Routine Name="FRK_PressAutoLd" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[MOVE(0,FRK_Press_LdAdvanced)MOVE(0,FRK_Press_Chart.ActiveChain);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[SUB(FRK_Press_ScanCount,FRK_Press_Unit.StepScan,FRK_Press_LdScratch)MUL(FRK_Press_LdScratch,10,FRK_Press_Chart.CurrentStepMs);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[EQ(FRK_Press_Unit.Step,0)EQ(FRK_Press_LdAdvanced,0)[NE(FRK_Press_Unit.Step,FRK_Press_Unit.PrevStep)MOVE(0,FRK_Press_Chart.StepCursor)MOVE(FRK_Press_Unit.Step,FRK_Press_Chart.ActiveStepNumber)MOVE(1,FRK_Press_Chart.Visited[0])ADD(FRK_Press_Chart.EnterCount[0],1,FRK_Press_Chart.EnterCount[0])MOVE(0,FRK_Press_Chart.CurrentStepMs)MOVE(FRK_Press_ScanCount,FRK_Press_Unit.StepScan)MOVE(FRK_Press_Unit.Step,FRK_Press_Unit.PrevStep)MOVE(0,FRK_Press_Chart.StallReason)[NE(FRK_Press_Chart.RowEpochOf[0],FRK_Press_Chart.RowEpoch)MOVE(FRK_Press_Chart.RowEpoch,FRK_Press_Chart.RowEpochOf[0])ADD(FRK_Press_Chart.RowCount,1,FRK_Press_Chart.RowCount)MOVE(FRK_Press_Chart.RowCount,FRK_Press_Chart.RowOf[0])MOVE(0,FRK_Press_Chart.LastMs[0]),MOVE(0,FRK_Press_Chart.WarnReason[0])],MOVE(0,FRK_Press_Unit.Complete)MOVE(FRK_Press_Chart.CurrentStepMs,FRK_Press_Chart.LastMs[0])MOVE(100,FRK_Press_Unit.Step)MOVE(1,FRK_Press_LdAdvanced)];]]></Text></Rung>
