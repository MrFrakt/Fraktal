usage: python.exe -m unittest [-h] --expect-serial EXPECT_SERIAL [--slot SLOT]
                              [--host HOST] [--port PORT]
                              [--allow-origin ALLOW_ORIGIN]
                              [--access-level {none,operator,technician,engineer,admin}]
