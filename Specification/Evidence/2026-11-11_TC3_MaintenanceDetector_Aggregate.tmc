m><Name Static="true">EMPTY_SEVERITY</Name><Type GUID="{B57D3F4A-0836-49B0-81C3-BED5F4817EC9}">TcEventSeverity</Type><BitSize>16</BitSize><Default><EnumText>TcEventSeverity.Verbose</EnumText></Default></SubItem><SubItem><Name Static="true">SUCCESS_EVENT</Name><Type GUID="{6925E8D1-EDCA-47DD-B80C-A6329A85D63D}">TcEventEntry</Type><BitSize>192</BitSize><Default><SubItem><Name>.uuidEventClass.Data1</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data2</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data3</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data4[0]</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data4[1]</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data4[2]</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data4[3]</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data4[4]</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data4[5]</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data4[6]</Name><Value>0</Value></SubItem><SubItem><Name>.uuidEventClass.Data4[7]</Name><Value>0</Value></SubItem><SubItem><Name>.nEventID</Name><Value>0</Value></SubItem><SubItem><Name>.eSeverity</Name><EnumText>Global_Constants.EMPTY_SEVERITY</EnumText></SubItem></Default></SubItem></DataType><DataType><Name Namespace="Fraktal_Core.Tc3_IPCDiag.Tc3_EventLogger">GVL</Name><SubItem><Name Static="true">nLangId_OnlineMonitoring</Name><Type>DINT</Type><Comment><![CDATA[ language id for online monitoring; English(US)=1033 ; German(Germany)=1031]]></Comment><BitSize>32</BitSize><Default><Value>1033</Value></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core.Tc3_IPCDiag.Tc3_EventLogger">ParameterList</Name><SubItem><Name Static="true">cSourceNameSize</Name><Type>UDINT (81..10000)</Type><Comment><![CDATA[ size [bytes] for source names (recommended is a size between 128 and 512)]]></Comment><BitSize>32</BitSize><Default><Value>256</Value></Default></SubItem><Properties><Property><Name>parameterlist</Name></Property><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core.Tc3_IPCDiag.Tc3_EventLogger">GVL_INTERNAL</Name><SubItem><Name Static="true">UNINITIALIZED_CLASS_GUID</Name><Type GUID="{18071995-0000-0000-0000-000000000021}">GUID</Type><Comment><![CDATA[ {E7A4B1E0-F4CF-4733-95D5-73DF084B60F8}]]></Comment><BitSize>128</BitSize><Default><SubItem><Name>.Data1</Name><Value>3886330336</Value></SubItem><SubItem><Name>.Data2</Name><Value>62671</Value></SubItem><SubItem><Name>.Data3</Name><Value>18227</Value></SubItem><SubItem><Name>.Data4[0]</Name><Value>149</Value></SubItem><SubItem><Name>.Data4[1]</Name><Value>213</Value></SubItem><SubItem><Name>.Data4[2]</Name><Value>115</Value></SubItem><SubItem><Name>.Data4[3]</Name><Value>223</Value></SubItem><SubItem><Name>.Data4[4]</Name><Value>8</Value></SubItem><SubItem><Name>.Data4[5]</Name><Value>75</Value></SubItem><SubItem><Name>.Data4[6]</Name><Value>96</Value></SubItem><SubItem><Name>.Data4[7]</Name><Value>248</Value></SubItem></Default></SubItem></DataType><DataType><Name Namespace="Tc2_MC2">Global_Variables</Name><SubItem><Name Static="true">TcMcGlobal</Name><Type Namespace="Tc2_MC2">_TCMCGLOBAL</Type><BitSize>7168</BitSize></SubItem><SubItem><Name Static="true">DEFAULT_HOME_POSITION</Name><Type>LREAL</Type><BitSize>64</BitSize><Default><Value>1E+307</Value></Default></SubItem><SubItem><Name Static="true">DEFAULT_BACKLASHVALUE</Name><Type>LREAL</Type><BitSize>64</BitSize><Default><Value>1E+307</Value></Default></SubItem></DataType><DataType><Name Namespace="TcUnit">GVL_Param_TcUnit</Name><SubItem><Name Static="true">MaxNumberOfTestSuites</Name><Type>UINT</Type><BitSize>16</BitSize><Default><Value>1000</Value></Default></SubItem><SubItem><Name Static="true">MaxNumberOfTestsForEachTestSuite</Name><Type>UINT</Type><BitSize>16</BitSize><Default><Value>100</Value></Default></SubItem><SubItem><Name Static="true">MaxNumberOfAssertsForEachTestSuite</Name><Type>UINT</Type><BitSize>16</BitSize><Default><Value>1000</Value></Default></SubItem><SubItem><Name Static="true">LogExtendedResults</Name><Type>BOOL</Type><Comment><![CDATA[ TcUnit logs complete test results. These include:
         - Number of test suites
         - Number of tests
         - Number of successful tests
         - Number of failed tests
         - Any eventual failed assertion (with the expected & actual value plus an user defined message)
       These are all printed to the ADS logger (Visual Studio error list) marked with ERROR criticality

       On top of this TcUnit also reports some statistics/extended information with HINT/INFO criticality.
       These statistics are more detailed results of the tests. This information is used when results are
       being collected by an external software (such as TcUnit-Runner) to do for example Jenkins integration.
       This extra information however takes time to print, so by setting the following parameter to FALSE
       it will speed up TcUnit finishing. ]]></Comment><BitSize>8</BitSize><Default><Bool>true</Bool></Default></SubItem><SubItem><Name Static="true">xUnitEnablePublish</Name><Type>BOOL</Type><Comment><![CDATA[ Enable (TRUE) or disable (FALSE) publishing of the xUnit Xml report ]]></Comment><BitSize>8</BitSize><Default><Bool>false</Bool></Default></SubItem><SubItem><Name Static="true">AdsLogMessageFifoRingBufferSize</Name><Type>UINT</Type><Comment><![CDATA[ This is the maximum number of ADS-messages that can be stored for reporting at the same time.
       Having a size of 2000 means that it's possible to report up to ~400 test cases in one single
       PLC cycle. Each entry consumes around 500 bytes, so with an example of a ring buffer size of
       2000 it means that TcUnit will consume around 1 MB of router memory. ]]></Comment><BitSize>16</BitSize><Default><Value>2000</Value></Default></SubItem><SubItem><Name Static="true">xUnitBufferSize</Name><Type>UDINT</Type><Comment><![CDATA[ Default reserved PLC memory buffer used for composition of the xUnit xml file (64 kb default) ]]></Comment><BitSize>32</BitSize><Default><Value>65535</Value></Default></SubItem><SubItem><Name Static="true">xUnitFilePath</Name><Type Namespace="Tc2_System">T_MaxString</Type><Comment><![CDATA[ Default path and filename for the xunit testresults e.g.: for use with jenkins 

	   Use environment variables for a OS independent file path
	   - %TC_BOOTPRJPATH% -> 'C:\TwinCAT\3.1\Boot\' (Windows), '/usr/local/etc/TwinCAT/3.1/Boot/' (TC/BSD), '\Hard Disk\TwinCAT\3.1\Boot\' (Windows CE)
      - %TC_INSTALLPATH% -> 'C:\TwinCAT\3.1\' (Windows), '/usr/local/etc/TwinCAT/3.1/' (TC/BSD), '\Hard Disk\TwinCAT\3.1\' (Windows CE) ]]></Comment><BitSize>2048</BitSize><Default><String>%TC_BOOTPRJPATH%tcunit_xunit_testresults.xml</String></Default></SubItem><SubItem><Name Static="true">TimeBetweenTestSuitesExecution</Name><Type>TIME</Type><Comment><![CDATA[ Time delay between a test suite is finished and the execution of the next test suite starts
       if using RUN_IN_SEQUENCE() ]]></Comment><BitSize>32</BitSize><Default><DateTime>T#0MS</DateTime></Default></SubItem><Properties><Property><Name>parameterlist</Name></Property><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="TcUnit">GVL_TcUnit</Name><SubItem><Name Static="true">TcUnitRunner</Name><Type Namespace="TcUnit">FB_TcUnitRunner</Type><BitSize>629908672</BitSize></SubItem><SubItem><Name Static="true">TestSuiteIsRegistered</Name><Type>BOOL</Type><Comment><![CDATA[ Indication of whether the last instantiated test suite has an assert instance created ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">CurrentTestIsFinished</Name><Type>BOOL</Type><Comment><![CDATA[ Whether or not the current test being called has finished running ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">IgnoreCurrentTest</Name><Type>BOOL</Type><Comment><![CDATA[ This is a flag that indicates that the current test should be ignored, and
       thus that all assertions under it should be ignored as well. A test can be ignored either
       because the user has requested so, or because the test is a duplicate name ]]></Comment><BitSize>8</BitSize></SubItem><SubItem><Name Static="true">NumberOfInitializedTestSuites</Name><Type>UINT</Type><Comment><![CDATA[ The assert function block instance should be 1:1 mapped to
       the test suite instance path. ]]></Comment><BitSize>16</BitSize><Default><Value>0</Value></Default></SubItem><SubItem><Name Static="true">CurrentTestSuiteBeingCalled</Name><Type Namespace="TcUnit" PointerTo="1">FB_TestSuite</Type><Comment><![CDATA[ Pointer to current test suite being called ]]></Comment><BitSize>64</BitSize></SubItem><SubItem><Name Static="true">CurrentTestNameBeingCalled</Name><Type Namespace="Tc2_System">T_MaxString</Type><Comment><![CDATA[ Current name of test being called ]]></Comment><BitSize>2048</BitSize></SubItem><SubItem><Name Static="true">GetCpuCounter</Name><Type Namespace="Tc2_System">GETCPUCOUNTER</Type><Comment><![CDATA[ Used to get the current cpu cycle counter to calculate the duration of tests and test suits, respectively ]]></Comment><BitSize>256</BitSize></SubItem><SubItem><Name Static="true">StartedAt</Name><Type>LWORD</Type><Comment><![CDATA[ Stores the CPU cycle count with 100ns precision since the first entry into one of the Run methods (RUN, RUN_IN_SEQUENCE) ]]></Comment><BitSize>64</BitSize></SubItem><SubItem><Name Static="true">Duration</Name><Type>LREAL</Type><Comment><![CDATA[ Duration it took for a complete run, in seconds ]]></Comment><BitSize>64</BitSize></SubItem><SubItem><Name Static="true">TestSuiteAddresses</Name><Type Namespace="TcUnit" PointerTo="1">FB_TestSuite</Type><ArrayInfo><LBound>1</LBound><Elements>1000</Elements></ArrayInfo><BitSize>64000</BitSize></SubItem><SubItem><Name Static="true">CurrentlyRunningOrderedTestInTestSuite</Name><Type>UINT (UINT#1..GVL_Param_TcUnit.MaxNumberOfTestsForEachTestSuite)</Type><ArrayInfo><LBound>1</LBound><Elements>1000</Elements></ArrayInfo><Comment><![CDATA[ If the user is utilizing the TEST_ORDERED(), we need to keep track of which ordered test is currently running.
       We do this by defining an array, in where we can see which current TEST_ORDERED() is the one to be handled right now.
       The below array is only used for TEST_ORDERED()-tests.  ]]></Comment><BitSize>16000</BitSize></SubItem><SubItem><Name Static="true">AdsMessageQueue</Name><Type Namespace="TcUnit">FB_AdsLogStringMessageFifoQueue</Type><Comment><![CDATA[ Buffered ADS message queue for output to the error list ]]></Comment><BitSize>8321152</BitSize></SubItem><SubItem><Name Static="true">HundredNanosecondToSecond</Name><Type>LREAL</Type><Comment><![CDATA[ Multiply a value that is given in 100ns units by this value to
     convert the value to seconds ]]></Comment><BitSize>64</BitSize><Default><Value>1E-07</Value></Default></SubItem><Properties><Property><Name>no_assign</Name></Property><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name>TC_EVENT_CLASSES</Name><Properties><Property><Name>TcTypeSystem</Name></Property><Property><Name>global_init_slot</Name><Value>10002</Value></Property><Property><Name>update_if_necessary</Name></Property><Property><Name>qualified_only</Name></Property><Property><Name>TC_EVENT_CLASSES</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core">PL_Fraktal</Name><Comment><![CDATA[ Fraktal Core — framework constants (Core §7.2, §3.2, §6.5, §3.16, §6.11)]]></Comment><SubItem><Name Static="true">MAX_PERMINTLK_COND</Name><Type>INT</Type><Comment><![CDATA[ Core §7.2 (default 16)]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_EM_CHILDREN</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_SEQUENCES</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_SEQUENCE_STEPS</Name><Type>INT</Type><Comment><![CDATA[ Core §3.13 — rows in a published sequence flow chart. 32 covered the demo but
 not a real machine: a station chain of a hundred-odd steps is ordinary, and the
 overflow is SILENT (the row is dropped, the chart just stops growing).

 The cost is per Unit and it is nearly all strings: one row is ~1.16 kB, of which
 98% is the five localization-key and path fields. 128 rows is ~145 kB of PLC
 memory per Unit and 2176 OPC UA nodes, which is why SequenceSteps is an
 ON-DEMAND subtree on the HMI side (read while the Sequence tab is open, never in
 the cyclic snapshot) - see Specification/HMI_CONTRACT.md. Raising this further
 costs linearly in both; shortening the string fields is the lever if it matters.]]></Comment><BitSize>16</BitSize><Default><Value>128</Value></Default></SubItem><SubItem><Name Static="true">MAX_SEQUENCE_ANNOTATIONS</Name><Type>INT</Type><Comment><![CDATA[ Core §6.8 — chains attached to one Unit (incl. sub-chains)   // Core §3.2 / §8.2]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_STEP_CONDS</Name><Type>INT</Type><Comment><![CDATA[ Core §6.9(b) condition records per step]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_STATE_FLAGS</Name><Type>INT</Type><Comment><![CDATA[ Core §3.12 — derived state flags a module may publish. Statically sized
 per module like every other Fraktal table (§1.1 O10).]]></Comment><BitSize>16</BitSize><Default><Value>12</Value></Default></SubItem><SubItem><Name Static="true">MAX_GENEALOGY</Name><Type>INT</Type><Comment><![CDATA[ Core §3.16.1]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_RESULTS</Name><Type>INT</Type><Comment><![CDATA[ Core §3.16.1]]></Comment><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">NOK_WINDOW_MAX</Name><Type>INT</Type><Comment><![CDATA[ Core §3.16.5 — judged parts in a Unit's NOK-limit window]]></Comment><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">MAX_OPTIONS</Name><Type>INT</Type><Comment><![CDATA[ Core §6.11]]></Comment><BitSize>16</BitSize><Default><Value>6</Value></Default></SubItem><SubItem><Name Static="true">MAX_CMD_STATS</Name><Type>INT</Type><Comment><![CDATA[ Core §8.11.4(a) — distinct command ids per module]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_PROFILE_STEPS</Name><Type>INT</Type><Comment><![CDATA[ Core §8.11.4(b) — steps per cycle profile]]></Comment><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">MAX_RECIPES</Name><Type>INT</Type><Comment><![CDATA[ Core §3.8 — records per FB_LocalRecipeProvider]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_MODEL_FIELDS</Name><Type>INT</Type><Comment><![CDATA[ Core §3.8a — client-defined named model fields]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_MODEL_DATA_BYTES</Name><Type>UDINT</Type><Comment><![CDATA[ Core §3.8a — a Unit's own recipe record, edited per model]]></Comment><BitSize>32</BitSize><Default><Value>1024</Value></Default></SubItem><SubItem><Name Static="true">MAX_ALARM_ACTIVE</Name><Type>INT</Type><Comment><![CDATA[ Core §8.3 — concurrently open events per Unit]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_ALARM_RING</Name><Type>INT</Type><Comment><![CDATA[ Core §8.3 — closed-event history ring per Unit]]></Comment><BitSize>16</BitSize><Default><Value>64</Value></Default></SubItem><SubItem><Name Static="true">MAX_HOST_EVENTS</Name><Type>INT</Type><Comment><![CDATA[ Core §11.6 — per-Unit north-bound event ring]]></Comment><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">MAX_USERS</Name><Type>INT</Type><Comment><![CDATA[ Core §7.7 — FB_LocalAccessProvider user table]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">PIN_HASH_ROUNDS</Name><Type>UINT</Type><Comment><![CDATA[ §14 — extra SHA-256 rounds per stored PIN (one login ~1 ms)]]></Comment><BitSize>16</BitSize><Default><Value>256</Value></Default></SubItem><SubItem><Name Static="true">MAX_POS_SENSORS</Name><Type>INT</Type><Comment><![CDATA[ redundant sensors per cylinder position (duplex; raise for 2oo3)]]></Comment><BitSize>16</BitSize><Default><Value>2</Value></Default></SubItem><SubItem><Name Static="true">MAX_NODE_CHANNELS</Name><Type>INT</Type><Comment><![CDATA[ Core §10.5.1 — I/O channels per fieldbus node]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_BUS_NODES</Name><Type>INT</Type><Comment><![CDATA[ Core §10.5.1 — nodes in the flat topology table]]></Comment><BitSize>16</BitSize><Default><Value>64</Value></Default></SubItem><SubItem><Name Static="true">MAX_ENGINEERING_GATES</Name><Type>INT</Type><Comment><![CDATA[ Core §7.5.1 — commissioning/engineering gates one station may declare.
 Small on purpose: a station carrying more than a handful of deliberate
 departures from its production configuration has a process problem, not a
 table-size problem. Overflow sets FB_EngineeringMode.Truncated (§5.6).]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_CMD_CATALOG</Name><Type>INT</Type><Comment><![CDATA[ Core §7.6.1 — manual commands a module may publish]]></Comment><BitSize>16</BitSize><Default><Value>12</Value></Default></SubItem><SubItem><Name Static="true">MODE_COUNT</Name><Type>INT</Type><Comment><![CDATA[ Core §3.4 — E_Mode entries (AUTO..ADJUSTMENT), for policy array]]></Comment><BitSize>16</BitSize><Default><Value>7</Value></Default></SubItem><SubItem><Name Static="true">MAX_RELEASE_REASONS</Name><Type>INT</Type><Comment><![CDATA[ Core §7.8 — entries in a release report]]></Comment><BitSize>16</BitSize><Default><Value>24</Value></Default></SubItem><SubItem><Name Static="true">MAX_OEE_SAMPLES</Name><Type>INT</Type><Comment><![CDATA[ Core §8.5.1 — trend ring length]]></Comment><BitSize>16</BitSize><Default><Value>60</Value></Default></SubItem><SubItem><Name Static="true">MAX_CYCLE_HISTORY</Name><Type>INT</Type><Comment><![CDATA[ Core §8.11.4 — per-cycle summary ring (trend charts)]]></Comment><BitSize>16</BitSize><Default><Value>60</Value></Default></SubItem><SubItem><Name Static="true">OEE_SAMPLE_MS</Name><Type>UDINT</Type><Comment><![CDATA[ Core §8.5.1 — sample period (1 min)]]></Comment><BitSize>32</BitSize><Default><Value>60000</Value></Default></SubItem><SubItem><Name Static="true">MAX_ALARM_META</Name><Type>INT</Type><Comment><![CDATA[ Core §8.9 — rationalization records per log]]></Comment><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">MAX_DIAG_RING</Name><Type>INT</Type><Comment><![CDATA[ Core §6.9(a) — Unit diagnostic history depth]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_SHELF_S</Name><Type>UDINT</Type><Comment><![CDATA[ Core §8.10 — shelf cap (8h)]]></Comment><BitSize>32</BitSize><Default><Value>28800</Value></Default></SubItem><SubItem><Name Static="true">MAX_CONFIG_PAGE</Name><Type>INT</Type><Comment><![CDATA[ Core §3.10.2 — config-manifest entries per mailbox page]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_CONFIG_WRITES</Name><Type>INT</Type><Comment><![CDATA[ Core §3.8b — editable values one module may register]]></Comment><BitSize>16</BitSize><Default><Value>12</Value></Default></SubItem><SubItem><Name Static="true">MAX_CONFIG_SETS</Name><Type>INT</Type><Comment><![CDATA[ Core §3.8b — named parameter sets held by FB_LocalConfigStore, and records
 per set. Both cost PERSISTENT memory directly: one record is ~340 B, so the
 shipped 4 × 32 reserves roughly 44 kB of the controller's persistent budget.
 A deployment needing more sizes the PLC persistent area to match, or wires a
 FILE_JSON/EXTERNAL store instead — the framework never grows this at run time.]]></Comment><BitSize>16</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">MAX_DATA_CLASSES</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_LINE_RECORDS</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">MAX_WEEKLY_SHIFTS</Name><Type>INT</Type><Comment><![CDATA[ additive V3 capacity; daily layout stays four]]></Comment><BitSize>16</BitSize><Default><Value>5</Value></Default></SubItem><SubItem><Name Static="true">MAX_SHIFTS</Name><Type>INT</Type><Comment><![CDATA[ §8.5.2 shifts in a line's calendar]]></Comment><BitSize>16</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">MAX_SHIFT_HISTORY</Name><Type>INT</Type><Comment><![CDATA[ §8.5.2 closed shifts a Unit keeps  // §3.8e values one line carries   // §3.8d project-declared data classes per root]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_SET_RECORDS</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">MAX_PERSIST_QUEUE</Name><Type>INT</Type><Comment><![CDATA[ requests one medium holds at once (FIFO)]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">CONFIG_PERSIST_WINDOW_MS</Name><Type>UDINT</Type><Comment><![CDATA[ Core §3.8b — the DECLARED bounded window an accepted configuration write has
 to reach non-volatile storage. Publishing the number is the point: "durability
 is a stated property, not a hope", and a station whose store cannot meet it
 says so through PersistFailed instead of reverting silently at the next start.]]></Comment><BitSize>32</BitSize><Default><Value>5000</Value></Default></SubItem><SubItem><Name Static="true">MAX_PERSIST_DOC_BYTES</Name><Type>UDINT</Type><Comment><![CDATA[ Core §3.8b — one retained DOCUMENT on an I_PersistMedium: a rendered set (a
 header and MAX_SET_RECORDS lines of at most 480 characters fit) or the user
 table's image. Every FB_ConfigSetDocument holds one buffer of this size.]]></Comment><BitSize>32</BitSize><Default><Value>16384</Value></Default></SubItem><SubItem><Name Static="true">MAX_PERSIST_KEYS</Name><Type>INT</Type><Comment><![CDATA[ documents a file medium vouches for (loss detection)]]></Comment><BitSize>16</BitSize><Default><Value>48</Value></Default></SubItem><SubItem><Name Static="true">MAX_RETAIN_DOCUMENTS</Name><Type>INT</Type><Comment><![CDATA[ FB_RetainPersistMedium pool: 8 x 16 kB persistent]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MANUAL_HELD_REFRESH_MS</Name><Type>DWORD</Type><Comment><![CDATA[ Core §7.6.1a — how long a latched hold-to-run request survives without a
 refresh from the client. Long enough to ride out transport jitter, short
 enough that a closed HMI or a dead link lets go rather than leaving the
 machine moving. The module's own JogTimeout is the second, shorter net.]]></Comment><BitSize>32</BitSize><Default><Value>750</Value></Default></SubItem><SubItem><Name Static="true">CHART_REV_SETTLE_MS</Name><Type>DWORD</Type><Comment><![CDATA[ Core §3.13/§3.10.2 — how long the flow chart must stop growing before the
 manifest revision is raised for it.

 §3.13 rows are discovered by VISIT, one at a time, while the manifest is
 invalidated ALL AT ONCE. A per-row bump therefore asked a client to
 refetch the entire manifest once per row: entering AUTO on the press
 discovers 15 rows where HOME discovers 2, which is why HOME->AUTO stalled
 and HOME->HOME did not.

 Waiting for the burst to settle is strictly better than bumping per row,
 on BOTH counts: far fewer refetches, and the client fetches AFTER the
 chart stops growing rather than during it - which is the very failure the
 per-row bump was written to avoid ("a chart that grows after the HMI's
 fetch would render every new row with StepNo 0 and no text").]]></Comment><BitSize>32</BitSize><Default><Value>1000</Value></Default></SubItem><SubItem><Name Static="true">MAX_SAFETY_DEVICES</Name><Type>INT</Type><Comment><![CDATA[ Core §9 — published safety aliases per module/zone]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_POWER_GROUPS</Name><Type>INT</Type><Comment><![CDATA[ Core §9 — independently controlled energy groups]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_CONTROL_DOMAIN_UNITS</Name><Type>INT</Type><Comment><![CDATA[ Core §9.8 — root Units sharing one arrangement]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_PARALLEL_BRANCHES</Name><Type>INT</Type><Comment><![CDATA[ Core §6.12 — concurrent legs one chain may run at once. It bounds the
 per-leg transition results AND every per-leg step-scoped latch, so it is a
 real memory cost per chain, not a loop limit (§1.1 O10: statically sized,
 no run-time allocation). Legs are numbered 1..n; 0 is the main line and is
 always available on top of these.]]></Comment><BitSize>16</BitSize><Default><Value>9</Value></Default></SubItem><SubItem><Name Static="true">WINDOWS_CLOCK_SAMPLE_FILE</Name><Type>STRING(255)</Type><Comment><![CDATA[ TC3 Windows observer default, also emitted into the observer package.]]></Comment><BitSize>2048</BitSize><Default><String>C:\ProgramData\Fraktal\Clock\quality.bin</String></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core">PL_ReasonCatalog</Name><Comment><![CDATA[ GENERATED FILE — DO NOT EDIT. §8.8/§8.9 catalog size.]]></Comment><SubItem><Name Static="true">COUNT</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>97</Value></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core">PL_FraktalEngineering</Name><Comment><![CDATA[ Fraktal Core — the framework's own commissioning/engineering build gates
 (Core §7.5.1, TC3 §7.5).

 ---------------------------------------------------------------------------
 WHY THESE ARE VAR_GLOBAL CONSTANT
 ---------------------------------------------------------------------------
 §7.5.1 requires a gate to be a BUILD constant, never a runtime variable:
 defeating one must be a source change plus a download — a reviewable, auditable
 act — and never an online write from an HMI, an ADS client or any other data
 path. The compiler also inlines a constant, so there is usually no symbol for a
 client to write at all. Do not "helpfully" convert these to writable variables,
 and do not add a writable mirror with a consumer in control logic.

 The application's own gates (USE_SIMULATION, CONTROL_CIRCUIT_MAPPING_CONFIRMED,
 …) stay where they are — in that project's MAIN — and are declared into the
 same register through FB_EngineeringMode.M_Declare. This GVL holds only the
 gates the FRAMEWORK owns.

 ---------------------------------------------------------------------------
 HOW TO BUILD A COMMISSIONING (ENGINEERING) IMAGE
 ---------------------------------------------------------------------------
 Add the define to EVERY PLC project in the solution — a conditional pragma is
 evaluated per compiled project, so the library and the application must agree:

   XAE: PLC project -> Properties -> Compile -> "Compiler Defines"
        enter:  FRAKTAL_ENGINEERING

   or in the .plcproj PropertyGroup:
        <CompilerDefines>FRAKTAL_ENGINEERING</CompilerDefines>

 A production image is simply one built WITHOUT that define. It is not a
 configuration a commissioning engineer can change on the machine.]]></Comment><SubItem><Name Static="true">OUTPUT_FORCING</Name><Type>BOOL</Type><Comment><![CDATA[ Core §10.5.1 rule 1 — may this image force fieldbus OUTPUT channels from
 the HMI at all? FALSE keeps Forceable FALSE on every channel, so the HMI
 renders no force affordance whatsoever (§3.9), and FB_UnitBase.ForceChannel
 refuses every request before the resolver is ever reached.

 Forcing an INPUT is not offered by this surface in either build (§10.5.1
 rule 2): lying to the logic to bypass a sensor or an interlock is an
 engineering-tool act under separate authority, never an operating practice.]]></Comment><BitSize>8</BitSize><Default><Bool>false</Bool></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core">PL_TcpDevReasons</Name><Comment><![CDATA[ Core §3.15.1a / §8.8 — TCP/ASCII device CM base band 10401-10406 (registered).
 Device profiles extend within 10401-10499.]]></Comment><SubItem><Name Static="true">DEV_CHANNEL_FAULT</Name><Type>DINT</Type><Comment><![CDATA[ transport reported FAULT]]></Comment><BitSize>32</BitSize><Default><Value>10401</Value></Default></SubItem><SubItem><Name Static="true">DEV_RESP_TIMEOUT</Name><Type>DINT</Type><Comment><![CDATA[ no terminated response within RespTimeout]]></Comment><BitSize>32</BitSize><Default><Value>10402</Value></Default></SubItem><SubItem><Name Static="true">DEV_PROTOCOL</Name><Type>DINT</Type><Comment><![CDATA[ profile parse rejected the response]]></Comment><BitSize>32</BitSize><Default><Value>10403</Value></Default></SubItem><SubItem><Name Static="true">DEV_NOT_CONNECTED</Name><Type>DINT</Type><Comment><![CDATA[ request issued while channel not OPEN]]></Comment><BitSize>32</BitSize><Default><Value>10404</Value></Default></SubItem><SubItem><Name Static="true">DEV_CFG_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ missing host/port/channel at Setup]]></Comment><BitSize>32</BitSize><Default><Value>10405</Value></Default></SubItem><SubItem><Name Static="true">DEV_RX_OVERFLOW</Name><Type>DINT</Type><Comment><![CDATA[ response exceeded the RX buffer]]></Comment><BitSize>32</BitSize><Default><Value>10406</Value></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core">GVL_FraktalTime</Name><SubItem><Name Static="true">Current</Name><Type Namespace="Fraktal_Core">ST_TimeQuality</Type><Comment><![CDATA[ One PLC-wide clock-quality authority. Hidden here; each root republishes
 the validated value beside its system-health surface.]]></Comment><BitSize>384</BitSize><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">PL_Curve</Name><Comment><![CDATA[ FB_CurveMonitor sizing. A spec is embedded in its owner's ParCfg, so these
 bound every owner's recipe record: four windows and two envelopes of 32
 points each judge a press or joining curve without a sample buffer.]]></Comment><SubItem><Name Static="true">MAX_WINDOWS</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">MAX_POINTS</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><SubItem><Name Static="true">SPEC_SCHEMA</Name><Type>UINT</Type><Comment><![CDATA[ ST_CurveSpec.SchemaVersion this helper judges]]></Comment><BitSize>16</BitSize><Default><Value>1</Value></Default></SubItem><SubItem><Name Static="true">MAX_SAMPLES</Name><Type>INT</Type><Comment><![CDATA[ samples a published ST_CurveRecord keeps (the verdict needs none)]]></Comment><BitSize>16</BitSize><Default><Value>256</Value></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">PL_Axis</Name><Comment><![CDATA[ Axis CM sizing (S1.6): position 1 is StationCfg.TaughtPosition, so the
 teach image holds 2..MAX_POSITIONS and the registration budget stays
 2 standing + manualStep + up to 7 positions = 10 of 12 (S3.8b).]]></Comment><SubItem><Name Static="true">MAX_POSITIONS</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">AXIS_TEACHCFG_SCHEMA</Name><Type>UINT</Type><BitSize>16</BitSize><Default><Value>1</Value></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">PL_RobotPlanner</Name><Comment><![CDATA[ Annex I - bounds for the declarative routing model. Every structure the
 planner touches is statically sized (Core S1.1 O10): a route that would
 exceed MAX_ROUTE_POINTS is refused, never allocated.]]></Comment><SubItem><Name Static="true">MAX_HELPS</Name><Type>INT</Type><Comment><![CDATA[ transit / wait positions]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_NESTS</Name><Type>INT</Type><Comment><![CDATA[ work positions, per gripper]]></Comment><BitSize>16</BitSize><Default><Value>16</Value></Default></SubItem><SubItem><Name Static="true">MAX_GRIPPERS</Name><Type>INT</Type><Comment><![CDATA[ nests are per-gripper (I.12); 1 is the trivial case]]></Comment><BitSize>16</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">MAX_HELPS_PER_NEST</Name><Type>INT</Type><Comment><![CDATA[ serving corridors on one nest (I.10)]]></Comment><BitSize>16</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">MAX_APPROACH_STEPS</Name><Type>INT</Type><Comment><![CDATA[ offset steps in one corridor (I.10.2)]]></Comment><BitSize>16</BitSize><Default><Value>4</Value></Default></SubItem><SubItem><Name Static="true">MAX_ROUTE_POINTS</Name><Type>INT</Type><Comment><![CDATA[ generated route length]]></Comment><BitSize>16</BitSize><Default><Value>32</Value></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">PL_Robot</Name><Comment><![CDATA[ Robot CM sizing (Annex I). The user channel is a small DECLARED set, not a
 mailbox: eight signals cover a gripper, a program flag or two and a counter,
 and a bound is what keeps it from becoming a second command surface.]]></Comment><SubItem><Name Static="true">MAX_USER_SIGNALS</Name><Type>INT</Type><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MAX_JOG_AXES</Name><Type>INT</Type><Comment><![CDATA[ joint jog addresses axes 1..7; Cartesian/tool 1..6]]></Comment><BitSize>16</BitSize><Default><Value>7</Value></Default></SubItem><SubItem><Name Static="true">MAX_MANUAL_MOVES</Name><Type>INT</Type><Comment><![CDATA[ Declared one-press manual moves (M_DeclareManualMove). Eight, because the
 catalog holds MAX_CMD_CATALOG (12) and the type publishes four of its own:
 two held jogs, the brake test and the safe reference run.]]></Comment><BitSize>16</BitSize><Default><Value>8</Value></Default></SubItem><SubItem><Name Static="true">MANUAL_MOVE_BASE</Name><Type>DINT</Type><Comment><![CDATA[ Catalog value of manual move n is MANUAL_MOVE_BASE + n: clear of every
 E_RobotCommand value, so a press can never be read as another command.]]></Comment><BitSize>32</BitSize><Default><Value>100</Value></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">PL_ModuleReasons</Name><Comment><![CDATA[ Core §8.8 band constants (band-extensibility rule): cylinder CM 10100-10199,
 clamp EM 11000-11999 — registered in the Core §8.8 registry.]]></Comment><SubItem><Name Static="true">CYL_NOT_EXTENDED</Name><Type>DINT</Type><BitSize>32</BitSize><Default><Value>10101</Value></Default></SubItem><SubItem><Name Static="true">CYL_NOT_RETRACTED</Name><Type>DINT</Type><BitSize>32</BitSize><Default><Value>10102</Value></Default></SubItem><SubItem><Name Static="true">CYL_BOTH_SENSORS</Name><Type>DINT</Type><BitSize>32</BitSize><Default><Value>10103</Value></Default></SubItem><SubItem><Name Static="true">CLAMP_NOT_CONFIRMED</Name><Type>DINT</Type><BitSize>32</BitSize><Default><Value>11001</Value></Default></SubItem><SubItem><Name Static="true">CYL_HOME_NOT_REACHED</Name><Type>DINT</Type><Comment><![CDATA[ timeout moving to home]]></Comment><BitSize>32</BitSize><Default><Value>10111</Value></Default></SubItem><SubItem><Name Static="true">CYL_WORK_NOT_REACHED</Name><Type>DINT</Type><Comment><![CDATA[ timeout moving to work]]></Comment><BitSize>32</BitSize><Default><Value>10112</Value></Default></SubItem><SubItem><Name Static="true">CYL_POS_IMPLAUSIBLE</Name><Type>DINT</Type><Comment><![CDATA[ home AND work sensor confirmed at once (implausible)]]></Comment><BitSize>32</BitSize><Default><Value>10113</Value></Default></SubItem><SubItem><Name Static="true">CYL_SENSOR_LOST</Name><Type>DINT</Type><Comment><![CDATA[ confirmed position sensor dropped while holding]]></Comment><BitSize>32</BitSize><Default><Value>10114</Value></Default></SubItem><SubItem><Name Static="true">CYL_DISCREPANCY</Name><Type>DINT</Type><Comment><![CDATA[ redundant sensors for one position disagree > DiscrepancyTime]]></Comment><BitSize>32</BitSize><Default><Value>10116</Value></Default></SubItem><SubItem><Name Static="true">CYL_CFG_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ both cylinder types: timing the move timeout cannot contain (TravelTime/SettleTime/MinOutputTime), PulsingWidth >= PulsingPeriod, or no sensor+no travel]]></Comment><BitSize>32</BitSize><Default><Value>10115</Value></Default></SubItem><SubItem><Name Static="true">AXIS_TARGET_OOR</Name><Type>DINT</Type><Comment><![CDATA[ target outside soft limits (rejected)]]></Comment><BitSize>32</BitSize><Default><Value>10201</Value></Default></SubItem><SubItem><Name Static="true">AXIS_MOVE_TIMEOUT</Name><Type>DINT</Type><Comment><![CDATA[ MC move did not complete within the timeout]]></Comment><BitSize>32</BitSize><Default><Value>10202</Value></Default></SubItem><SubItem><Name Static="true">AXIS_DRIVE_FAULT</Name><Type>DINT</Type><Comment><![CDATA[ MC_* .Error / drive fault]]></Comment><BitSize>32</BitSize><Default><Value>10203</Value></Default></SubItem><SubItem><Name Static="true">AXIS_NOT_HOMED</Name><Type>DINT</Type><Comment><![CDATA[ MOVE_TO before a valid home]]></Comment><BitSize>32</BitSize><Default><Value>10204</Value></Default></SubItem><SubItem><Name Static="true">AXIS_JOG_NOT_ENABLED</Name><Type>DINT</Type><Comment><![CDATA[ teach jog asked with no enabling device held]]></Comment><BitSize>32</BitSize><Default><Value>10205</Value></Default></SubItem><SubItem><Name Static="true">AXIS_JOG_RELEASED</Name><Type>DINT</Type><Comment><![CDATA[ the held jog request stopped arriving]]></Comment><BitSize>32</BitSize><Default><Value>10206</Value></Default></SubItem><SubItem><Name Static="true">AXIS_POSITION_UNDECLARED</Name><Type>DINT</Type><Comment><![CDATA[ ParCmd.PositionIdx names no declared taught position]]></Comment><BitSize>32</BitSize><Default><Value>10207</Value></Default></SubItem><SubItem><Name Static="true">AXIS_PARAM_OOR</Name><Type>DINT</Type><Comment><![CDATA[ a command parameter outside its band (speed scale, manual step unset)]]></Comment><BitSize>32</BitSize><Default><Value>10208</Value></Default></SubItem><SubItem><Name Static="true">AXIS_CFG_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ speed-scale band the type cannot honour]]></Comment><BitSize>32</BitSize><Default><Value>10209</Value></Default></SubItem><SubItem><Name Static="true">POWER_ENABLE_WITHHELD</Name><Type>DINT</Type><Comment><![CDATA[ power-group CM 10500-10599]]></Comment><BitSize>32</BitSize><Default><Value>10501</Value></Default></SubItem><SubItem><Name Static="true">POWER_FEEDBACK_TIMEOUT</Name><Type>DINT</Type><BitSize>32</BitSize><Default><Value>10502</Value></Default></SubItem><SubItem><Name Static="true">SEP_NO_CARRIER_AT</Name><Type>DINT</Type><Comment><![CDATA[ carrier never present at the separator]]></Comment><BitSize>32</BitSize><Default><Value>10001</Value></Default></SubItem><SubItem><Name Static="true">SEP_CARRIER_NOT_CLEARED</Name><Type>DINT</Type><Comment><![CDATA[ CarrierAt did not clear after opening]]></Comment><BitSize>32</BitSize><Default><Value>10002</Value></Default></SubItem><SubItem><Name Static="true">SEP_CARRIER_NOT_ARRIVED</Name><Type>DINT</Type><Comment><![CDATA[ CarrierAfter did not arrive in time]]></Comment><BitSize>32</BitSize><Default><Value>10003</Value></Default></SubItem><SubItem><Name Static="true">SEP_NOT_OPENED_FB</Name><Type>DINT</Type><Comment><![CDATA[ open feedback missing]]></Comment><BitSize>32</BitSize><Default><Value>10004</Value></Default></SubItem><SubItem><Name Static="true">SEP_SON_NOT_CLEARED</Name><Type>DINT</Type><Comment><![CDATA[ CarrierAfter did not clear after close]]></Comment><BitSize>32</BitSize><Default><Value>10005</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_POINT_UNREACHABLE</Name><Type>DINT</Type><Comment><![CDATA[ taught point not reachable with the active tool/frame]]></Comment><BitSize>32</BitSize><Default><Value>10301</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_POINT_UNKNOWN</Name><Type>DINT</Type><Comment><![CDATA[ point/list/pallet ID not taught, or none given (never a zero pose)]]></Comment><BitSize>32</BitSize><Default><Value>10302</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_MOVE_TIMEOUT</Name><Type>DINT</Type><Comment><![CDATA[ motion did not complete within ParCfg timeout]]></Comment><BitSize>32</BitSize><Default><Value>10303</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_CONTROLLER_FAULT</Name><Type>DINT</Type><Comment><![CDATA[ drive/controller fault reported by the robot itself]]></Comment><BitSize>32</BitSize><Default><Value>10304</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_NOT_REFERENCED</Name><Type>DINT</Type><Comment><![CDATA[ motion commanded before a valid home/reference]]></Comment><BitSize>32</BitSize><Default><Value>10305</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_SAFETY_DROPPED</Name><Type>DINT</Type><Comment><![CDATA[ S9 alias lost mid-command, or absent at POWER_ON/motion (read-only)]]></Comment><BitSize>32</BitSize><Default><Value>10307</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_NO_ROUTE</Name><Type>DINT</Type><Comment><![CDATA[ help graph defines no path between the two positions]]></Comment><BitSize>32</BitSize><Default><Value>10308</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_NO_HELP_FOR_NEST</Name><Type>DINT</Type><Comment><![CDATA[ no help point resolves for a nest given the move endpoints]]></Comment><BitSize>32</BitSize><Default><Value>10310</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_MODE_NOT_PERMITTED</Name><Type>DINT</Type><Comment><![CDATA[ controller mode does not permit this command]]></Comment><BitSize>32</BitSize><Default><Value>10311</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_PROTECTIVE_STOP</Name><Type>DINT</Type><Comment><![CDATA[ collision/crash device tripped - NOT a S9 safety function]]></Comment><BitSize>32</BitSize><Default><Value>10313</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_PARAM_OOR</Name><Type>DINT</Type><Comment><![CDATA[ a command parameter is outside its configured band]]></Comment><BitSize>32</BitSize><Default><Value>10314</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_RESUME_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ resume after hold, but the arm left the retained path]]></Comment><BitSize>32</BitSize><Default><Value>10315</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_CFG_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ speed band, ceilings, default mode or timeouts the type cannot honour]]></Comment><BitSize>32</BitSize><Default><Value>10316</Value></Default></SubItem><SubItem><Name Static="true">ROBOT_ROUTINE_FAILED</Name><Type>DINT</Type><Comment><![CDATA[ brake test / safe reference run ended with its demand still standing]]></Comment><BitSize>32</BitSize><Default><Value>10317</Value></Default></SubItem><SubItem><Name Static="true">AIR_SWITCH_CONFLICT</Name><Type>DINT</Type><Comment><![CDATA[ air-pressure monitor CM 10600-10699]]></Comment><BitSize>32</BitSize><Default><Value>10601</Value></Default></SubItem><SubItem><Name Static="true">AI_UNDER_RANGE</Name><Type>DINT</Type><Comment><![CDATA[ a stable measured value below ParCfg.UnderRange]]></Comment><BitSize>32</BitSize><Default><Value>10701</Value></Default></SubItem><SubItem><Name Static="true">AI_OVER_RANGE</Name><Type>DINT</Type><Comment><![CDATA[ a stable measured value above ParCfg.OverRange]]></Comment><BitSize>32</BitSize><Default><Value>10702</Value></Default></SubItem><SubItem><Name Static="true">AI_SIGNAL_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ quality lost, bad ParCfg or a dead reference at MEASURE]]></Comment><BitSize>32</BitSize><Default><Value>10703</Value></Default></SubItem><SubItem><Name Static="true">AI_ADJUSTMENT_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ the retained two-point adjustment is implausible]]></Comment><BitSize>32</BitSize><Default><Value>10704</Value></Default></SubItem><SubItem><Name Static="true">AI_NOT_STABLE</Name><Type>DINT</Type><Comment><![CDATA[ the value never entered the stability band within MeasureTimeout]]></Comment><BitSize>32</BitSize><Default><Value>10705</Value></Default></SubItem><SubItem><Name Static="true">AO_TARGET_OOR</Name><Type>DINT</Type><Comment><![CDATA[ a SET target outside [Minimum, Maximum] (rejected before writing)]]></Comment><BitSize>32</BitSize><Default><Value>10801</Value></Default></SubItem><SubItem><Name Static="true">AO_CFG_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ scaling/band/safe-value configuration the type cannot honour]]></Comment><BitSize>32</BitSize><Default><Value>10802</Value></Default></SubItem><SubItem><Name Static="true">CURVE_WINDOW_VIOLATED</Name><Type>DINT</Type><Comment><![CDATA[ a window missed, or crossed through a wrong edge]]></Comment><BitSize>32</BitSize><Default><Value>10901</Value></Default></SubItem><SubItem><Name Static="true">CURVE_ENVELOPE_VIOLATED</Name><Type>DINT</Type><Comment><![CDATA[ a sample on the wrong side of an envelope]]></Comment><BitSize>32</BitSize><Default><Value>10902</Value></Default></SubItem><SubItem><Name Static="true">CURVE_INCOMPLETE</Name><Type>DINT</Type><Comment><![CDATA[ the curve stopped before every rule's reach]]></Comment><BitSize>32</BitSize><Default><Value>10903</Value></Default></SubItem><SubItem><Name Static="true">CURVE_SPEC_INVALID</Name><Type>DINT</Type><Comment><![CDATA[ a spec the helper cannot judge (refused at prepare)]]></Comment><BitSize>32</BitSize><Default><Value>10904</Value></Default></SubItem><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name>PRG_TcUnitRunner</Name><Comment><![CDATA[ Core §5.7 / TC3 §5.7 — one open-ended gate: every suite joins unchanged (§6.8, H.6)
