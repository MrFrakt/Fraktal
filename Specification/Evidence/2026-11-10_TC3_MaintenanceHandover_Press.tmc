rameter><Parameter><Name>HalRef</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">ST_PowerGroupHal</Type><BitSize>64</BitSize></Parameter></Method><Method><Name>OnAbort</Name><ReturnType>DINT</ReturnType><ReturnBitSize>32</ReturnBitSize></Method><Method><Name>OnCyclic</Name><ReturnType>DINT</ReturnType><ReturnBitSize>32</ReturnBitSize><Local><Name>busMustDrop</Name><Type>BOOL</Type><BitSize>8</BitSize></Local></Method><Method><Name>_M_Dispatch</Name></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">ST_DigitalInputParCfg</Name><Comment><![CDATA[ Core §3.8 ParCfg (SchemaVersion first). The composition root assigns it; the
 type has no recipe provider, so this initializer is the layout FB_DigitalInputCM
 checks against. v2 appended DebounceTime; its default reproduces v1.]]></Comment><BitSize>64</BitSize><SubItem><Name>SchemaVersion</Name><Type>UINT</Type><BitSize>16</BitSize><BitOffs>0</BitOffs><Default><Value>2</Value></Default></SubItem><SubItem><Name>DebounceTime</Name><Type>TIME</Type><Comment><![CDATA[ How long the HAL value must differ from the published Value, continuously,
 before Value follows it. T#0MS passes it through in the same scan. Above
 FB_DigitalInputCM.DI_DEBOUNCE_MAX it is a configuration defect, not a filter.]]></Comment><BitSize>32</BitSize><BitOffs>32</BitOffs><Default><DateTime>T#0MS</DateTime></Default></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_DigitalInputParCmd</Name><BitSize>8</BitSize><SubItem><Name>Reserved</Name><Type>BOOL</Type><Comment><![CDATA[ passive monitor: physical four-structure contract, no command payload]]></Comment><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_DigitalInputOutCmd</Name><BitSize>8</BitSize><SubItem><Name>Reserved</Name><Type>BOOL</Type><Comment><![CDATA[ passive monitor: no command result]]></Comment><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_DigitalInputOutImm</Name><BitSize>664</BitSize><SubItem><Name>Value</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>Quality</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>8</BitOffs></SubItem><SubItem><Name>IoTag</Name><Type>STRING(80)</Type><BitSize>648</BitSize><BitOffs>16</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">FB_DigitalInputCM</Name><Comment><![CDATA[ Basic passive digital-input CM. Owning logic consumes semantic Value; the
 project catalog injects the physical identity separately from the HAL.
 A bouncing contact is settled here, at the signal's owner (§7.2.1), through
 ParCfg.DebounceTime - never by a sequence that happens to read it. Bad quality
 or a configuration the type cannot honour publishes Value FALSE, Quality FALSE
 (§5.6): an input that is silently slow or stale is worse than one that is off.]]></Comment><BitSize>273344</BitSize><ExtendsType Namespace="Fraktal_Core">FB_ControlModuleBase</ExtendsType><SubItem><Name>ParCfg</Name><Type Namespace="Fraktal_Modules">ST_DigitalInputParCfg</Type><BitSize>64</BitSize><BitOffs>265472</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>ParCmd</Name><Type Namespace="Fraktal_Modules">ST_DigitalInputParCmd</Type><BitSize>8</BitSize><BitOffs>265536</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>OutCmd</Name><Type Namespace="Fraktal_Modules">ST_DigitalInputOutCmd</Type><BitSize>8</BitSize><BitOffs>265544</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>OutImm</Name><Type Namespace="Fraktal_Modules">ST_DigitalInputOutImm</Type><BitSize>664</BitSize><BitOffs>265552</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>_hal</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">ST_DigitalInputHal</Type><BitSize>64</BitSize><BitOffs>266240</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_identity</Name><Type Namespace="Fraktal_Core">ST_IoPointIdentity</Type><BitSize>6680</BitSize><BitOffs>266304</BitOffs></SubItem><SubItem><Name>_debounce</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ runs while the HAL value differs from the published Value]]></Comment><BitSize>256</BitSize><BitOffs>273024</BitOffs></SubItem><SubItem><Name>DI_DEBOUNCE_MAX</Name><Type>TIME</Type><BitSize>32</BitSize><BitOffs>273280</BitOffs><Default><DateTime>T#10S</DateTime></Default></SubItem><Method><Name>ConfigureIoIdentity</Name><Parameter><Name>Identity</Name><Type Namespace="Fraktal_Core">ST_IoPointIdentity</Type><BitSize>6680</BitSize></Parameter></Method><Method><Name>_M_ParCfgValid</Name><Comment><![CDATA[ §3.8/§5.6 - the layout this type was compiled against, and a debounce short
 enough to be a filter rather than a delay. Anything else is refused, never
 clamped. The DUT's own initializer is the layout version, so it is stated once.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Local><Name>compiled</Name><Type Namespace="Fraktal_Modules">ST_DigitalInputParCfg</Type><BitSize>64</BitSize></Local></Method><Method><Name>Setup</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Name</Name><Type>STRING(80)</Type><BitSize>648</BitSize></Parameter><Parameter><Name>HalRef</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">ST_DigitalInputHal</Type><BitSize>64</BitSize></Parameter><Parameter><Name>DisplayNameKey</Name><Type>STRING(160)</Type><BitSize>1288</BitSize></Parameter><Parameter><Name>DescriptionKey</Name><Type>STRING(160)</Type><BitSize>1288</BitSize></Parameter></Method><Method><Name>OnCyclic</Name><ReturnType>DINT</ReturnType><ReturnBitSize>32</ReturnBitSize></Method><Method><Name>_M_Dispatch</Name></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AirPressureParCfg</Name><Comment><![CDATA[ v2 moved ConflictTime to ST_AirPressureStationCfg: it varies per
 deployment, not per model, and §3.8a places such a value in station
 configuration. This monitor has no model data of its own, so what remains
 is the versioned shell the §3.12 contract asks every module to carry.]]></Comment><BitSize>16</BitSize><SubItem><Name>SchemaVersion</Name><Type>UINT</Type><Comment><![CDATA[ §3.8: MUST remain first]]></Comment><BitSize>16</BitSize><BitOffs>0</BitOffs><Default><Value>2</Value></Default></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AirPressureParCmd</Name><BitSize>8</BitSize><SubItem><Name>Reserved</Name><Type>BOOL</Type><Comment><![CDATA[ passive monitor: physical four-structure contract, no command payload]]></Comment><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AirPressureOutCmd</Name><BitSize>8</BitSize><SubItem><Name>Reserved</Name><Type>BOOL</Type><Comment><![CDATA[ passive monitor: no command result]]></Comment><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AirPressureOutImm</Name><BitSize>1336</BitSize><SubItem><Name>LowPressure</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>OperatingPressure</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>8</BitOffs></SubItem><SubItem><Name>PressureOk</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>16</BitOffs></SubItem><SubItem><Name>Contradictory</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>24</BitOffs></SubItem><SubItem><Name>Quality</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>32</BitOffs></SubItem><SubItem><Name>LowSensorTag</Name><Type>STRING(80)</Type><BitSize>648</BitSize><BitOffs>40</BitOffs></SubItem><SubItem><Name>OperatingSensorTag</Name><Type>STRING(80)</Type><BitSize>648</BitSize><BitOffs>688</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AirPressureStationCfg</Name><Comment><![CDATA[ Core §3.8a/§3.8b — deployment data for this monitor. The qualification time
 depends on the physical switches and the air system they sit in, not on the
 product being made, so it is station configuration and NOT part of any model
 recipe: it must not change at changeover, and it must survive a restart.
 SchemaVersion stays first (§3.8b) so a retained image from another layout is
 rejected and re-initialized instead of read by field position.]]></Comment><BitSize>64</BitSize><SubItem><Name>SchemaVersion</Name><Type>UINT</Type><BitSize>16</BitSize><BitOffs>0</BitOffs><Default><Value>1</Value></Default></SubItem><SubItem><Name>ConflictTime</Name><Type>TIME</Type><Comment><![CDATA[ qualify contradictory mechanical switches]]></Comment><BitSize>32</BitSize><BitOffs>32</BitOffs><Default><DateTime>T#500MS</DateTime></Default></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">FB_AirPressureMonitorCM</Name><Comment><![CDATA[ Basic passive two-threshold pneumatic-pressure CM. Both switches active is
 implausible and faults with both exact tags; neither/high-only are status states.]]></Comment><BitSize>281920</BitSize><ExtendsType Namespace="Fraktal_Core">FB_ControlModuleBase</ExtendsType><SubItem><Name>ParCfg</Name><Type Namespace="Fraktal_Modules">ST_AirPressureParCfg</Type><BitSize>16</BitSize><BitOffs>265472</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>ParCmd</Name><Type Namespace="Fraktal_Modules">ST_AirPressureParCmd</Type><BitSize>8</BitSize><BitOffs>265488</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>OutCmd</Name><Type Namespace="Fraktal_Modules">ST_AirPressureOutCmd</Type><BitSize>8</BitSize><BitOffs>265496</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>OutImm</Name><Type Namespace="Fraktal_Modules">ST_AirPressureOutImm</Type><BitSize>1336</BitSize><BitOffs>265504</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>_hal</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">ST_AirPressureHal</Type><BitSize>64</BitSize><BitOffs>266880</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_lowIdentity</Name><Type Namespace="Fraktal_Core">ST_IoPointIdentity</Type><BitSize>6680</BitSize><BitOffs>266944</BitOffs></SubItem><SubItem><Name>_operatingIdentity</Name><Type Namespace="Fraktal_Core">ST_IoPointIdentity</Type><BitSize>6680</BitSize><BitOffs>273624</BitOffs></SubItem><SubItem><Name>_bothTags</Name><Type>STRING(80)</Type><BitSize>648</BitSize><BitOffs>280304</BitOffs></SubItem><SubItem><Name>_bothAddresses</Name><Type>STRING(80)</Type><BitSize>648</BitSize><BitOffs>280952</BitOffs></SubItem><SubItem><Name>_conflictTimer</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ Both switches reading active is only a genuine wiring/sensor fault when it
 PERSISTS. The two mechanical switches trip at different pressures and have
 their own response delays, so while the system pressurises a brief overlap
 is normal physics, not a defect. Because the fault latches (an operator
 reset is required to clear it), a single spurious cycle would otherwise
 block Control On indefinitely — observed on the press, where the sensors
 read consistently in steady state yet the conflict fault stayed raised.
 Same idiom as ST_ConfigurableCylinderParCfg.DiscrepancyTime.]]></Comment><BitSize>256</BitSize><BitOffs>281600</BitOffs></SubItem><SubItem><Name>StationCfg</Name><Type Namespace="Fraktal_Modules">ST_AirPressureStationCfg</Type><Comment><![CDATA[ §3.8a/§3.8b — deployment data: editable from the HMI, retained across
 a restart, and never part of a model recipe. The Setup registration,
 not this declaration, is what permits a write (§3.10.2).]]></Comment><BitSize>64</BitSize><BitOffs>281856</BitOffs><Properties><Property><Name>TcPersistent</Name></Property></Properties></SubItem><Method><Name>ConfigureIoIdentity</Name><Parameter><Name>LowSensor</Name><Type Namespace="Fraktal_Core">ST_IoPointIdentity</Type><BitSize>6680</BitSize></Parameter><Parameter><Name>OperatingSensor</Name><Type Namespace="Fraktal_Core">ST_IoPointIdentity</Type><BitSize>6680</BitSize></Parameter></Method><Method><Name>Setup</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Name</Name><Type>STRING(80)</Type><BitSize>648</BitSize></Parameter><Parameter><Name>HalRef</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">ST_AirPressureHal</Type><BitSize>64</BitSize></Parameter></Method><Method><Name>OnCyclic</Name><ReturnType>DINT</ReturnType><ReturnBitSize>32</ReturnBitSize></Method><Method><Name>_M_Dispatch</Name></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">E_AxisCommand</Name><Comment><![CDATA[ Annex G motion CM. NONE is the unset value: dispatch rejects it (S5.6).]]></Comment><BitSize>32</BitSize><BaseType>DINT</BaseType><EnumInfo><Text>NONE</Text><Enum>0</Enum></EnumInfo><EnumInfo><Text>HOME</Text><Enum>1</Enum></EnumInfo><EnumInfo><Text>MOVE_TO</Text><Enum>2</Enum></EnumInfo><EnumInfo><Text>JOG_POS</Text><Enum>3</Enum><Comment><![CDATA[ HELD commands (§7.6.1). Two entries rather than one plus a direction, so
 the generic HMI renders two hold-buttons with no axis-specific code.
 They never reach _M_Dispatch: a jog is not an Execute/Done command, and
 PLCopen models it with level inputs for the same reason.]]></Comment></EnumInfo><EnumInfo><Text>JOG_NEG</Text><Enum>4</Enum></EnumInfo><EnumInfo><Text>MOVE_REL</Text><Enum>5</Enum><Comment><![CDATA[ Relative move (sequence-only: it needs a distance, so it is not in the
 manual catalog) and the manual step commands, which move by the retained
 ManualStep in either direction (WP3.2).]]></Comment></EnumInfo><EnumInfo><Text>STEP_POS</Text><Enum>6</Enum></EnumInfo><EnumInfo><Text>STEP_NEG</Text><Enum>7</Enum></EnumInfo><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AxisParCfg</Name><Comment><![CDATA[ Core S3.8: SchemaVersion FIRST. Soft limits and dynamics are recipe/config,
 never sequence literals (S10.3) - scaling and hard limits stay in the axis
 configuration where the drive integrator owns them.]]></Comment><BitSize>704</BitSize><SubItem><Name>SchemaVersion</Name><Type>UINT</Type><Comment><![CDATA[ v2 appended SpeedScaleMin/SpeedScaleMax]]></Comment><BitSize>16</BitSize><BitOffs>0</BitOffs><Default><Value>2</Value></Default></SubItem><SubItem><Name>SoftMin</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>64</BitOffs><Default><Value>0</Value></Default></SubItem><SubItem><Name>SoftMax</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>128</BitOffs><Default><Value>100</Value></Default></SubItem><SubItem><Name>Velocity</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>192</BitOffs><Default><Value>50</Value></Default></SubItem><SubItem><Name>Acceleration</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>256</BitOffs><Default><Value>500</Value></Default></SubItem><SubItem><Name>Deceleration</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>320</BitOffs><Default><Value>500</Value></Default></SubItem><SubItem><Name>MoveTimeout</Name><Type>TIME</Type><BitSize>32</BitSize><BitOffs>384</BitOffs><Default><DateTime>T#10S</DateTime></Default></SubItem><SubItem><Name>HomeTimeout</Name><Type>TIME</Type><BitSize>32</BitSize><BitOffs>416</BitOffs><Default><DateTime>T#30S</DateTime></Default></SubItem><SubItem><Name>JogVelocity</Name><Type>LREAL</Type><Comment><![CDATA[ Teach jog (§7.6.1). JogVelocity is DEFENCE IN DEPTH, not the protection:
 the safety-rated reduced speed is the drive's own SLS or the cell's safe
 speed monitor, because a scan overrun or a download must not be able to
 remove the limit that keeps a person safe (§9).]]></Comment><BitSize>64</BitSize><BitOffs>448</BitOffs><Default><Value>5</Value></Default></SubItem><SubItem><Name>JogAcceleration</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>512</BitOffs><Default><Value>100</Value></Default></SubItem><SubItem><Name>JogTimeout</Name><Type>TIME</Type><Comment><![CDATA[ How long a held request may go unheard before the axis stops. This is the
 backstop for a stalled transport, NOT the normal stop: releasing the
 control sends Dir=0 and stops immediately (O10).]]></Comment><BitSize>32</BitSize><BitOffs>576</BitOffs><Default><DateTime>T#200MS</DateTime></Default></SubItem><SubItem><Name>SpeedScaleMin</Name><Type>REAL</Type><Comment><![CDATA[ Speed-scale band (WP3.3): a command's SpeedScale is a percentage of
 ParCfg.Velocity, and one outside this band is refused before motion
 (AXIS_PARAM_OOR), never clamped. REAL and percent, as ST_RobotParCfg.]]></Comment><BitSize>32</BitSize><BitOffs>608</BitOffs><Default><Value>1</Value></Default></SubItem><SubItem><Name>SpeedScaleMax</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>640</BitOffs><Default><Value>100</Value></Default></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AxisParCmd</Name><Comment><![CDATA[ Latched by the base on the Execute rising edge (S6.1).]]></Comment><BitSize>256</BitSize><SubItem><Name>Target</Name><Type>LREAL</Type><Comment><![CDATA[ absolute target for MOVE_TO, in axis units]]></Comment><BitSize>64</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>PositionIdx</Name><Type>INT</Type><Comment><![CDATA[ MOVE_TO position selector: 0 = Target, 1 = the taught position,
 2..MAX_POSITIONS = a declared named position (WP3.1).]]></Comment><BitSize>16</BitSize><BitOffs>64</BitOffs><Default><Value>0</Value></Default></SubItem><SubItem><Name>Distance</Name><Type>LREAL</Type><Comment><![CDATA[ Relative distance for MOVE_REL and the speed scale in percent of
 ParCfg.Velocity for MOVE_TO / MOVE_REL (WP3.2/WP3.3).]]></Comment><BitSize>64</BitSize><BitOffs>128</BitOffs><Default><Value>0</Value></Default></SubItem><SubItem><Name>SpeedScale</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>192</BitOffs><Default><Value>100</Value></Default></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AxisOutCmd</Name><Comment><![CDATA[ Valid on Done (S3.12).]]></Comment><BitSize>16</BitSize><SubItem><Name>InPosition</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>Homed</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>8</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AxisOutImm</Name><Comment><![CDATA[ Cyclic live status plus the first-out diagnostic (S3.12, S6.9).]]></Comment><BitSize>384</BitSize><SubItem><Name>ActPos</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>ActVelocity</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>64</BitOffs></SubItem><SubItem><Name>Homed</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>128</BitOffs></SubItem><SubItem><Name>DriveEnabled</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>136</BitOffs></SubItem><SubItem><Name>TaughtPosition</Name><Type>LREAL</Type><Comment><![CDATA[ The stored taught position (S3.8b PERSISTENT), published beside the live
 ActPos so an operator can compare what is stored with where the axis is
 before capturing over it (S3.8c(b)).]]></Comment><BitSize>64</BitSize><BitOffs>192</BitOffs></SubItem><SubItem><Name>Jogging</Name><Type>BOOL</Type><Comment><![CDATA[ a held jog is driving the axis right now (§7.6.1)]]></Comment><BitSize>8</BitSize><BitOffs>256</BitOffs></SubItem><SubItem><Name>JogStopReason</Name><Type>DINT</Type><Comment><![CDATA[ Why the last jog stopped: 0 = released normally, otherwise the §8.8 reason.
 Published status, deliberately NOT an alarm - a jog that stops because the
 operator let go is the designed behaviour, and filing it as a fault would
 fill the record with events that were never faults (§6.1).]]></Comment><BitSize>32</BitSize><BitOffs>288</BitOffs></SubItem><SubItem><Name>Override</Name><Type>LREAL</Type><Comment><![CDATA[ The accepted set-and-hold speed override in percent (SetOverride); an
 owner that goes silent can only leave an already accepted value.]]></Comment><BitSize>64</BitSize><BitOffs>320</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AxisStationCfg</Name><Comment><![CDATA[ Core §3.8a/§3.8b - deployment data for one axis: what this MACHINE is, as
 opposed to what the current product needs. A taught position belongs here and
 not in ParCfg, because I_RecipeProvider loads and never stores: the next
 changeover would overwrite a number an operator spent time teaching.

 SchemaVersion is FIRST and is mandatory (§3.8b). Version 0 means never
 written - a first boot has lost nothing. Any OTHER unrecognized version means
 a real image was rejected, which is annunciated, because the difference
 between an empty machine and one that has just lost its commissioning is
 exactly what an operator needs told.]]></Comment><BitSize>192</BitSize><SubItem><Name>SchemaVersion</Name><Type>UINT</Type><Comment><![CDATA[ 0 = never written; 2 = this layout]]></Comment><BitSize>16</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>TaughtPosition</Name><Type>LREAL</Type><Comment><![CDATA[ captured from the live ActPos (§3.8c)]]></Comment><BitSize>64</BitSize><BitOffs>64</BitOffs></SubItem><SubItem><Name>JogRequiresEnable</Name><Type>BOOL</Type><Comment><![CDATA[ v2. Does THIS INSTALLATION have a safety-rated enabling device for manual
 motion? A deployment fact, not a preference, which is why it is station
 configuration (§3.8a) rather than a recipe value or a compiled-in
 assumption in the reusable type.

 TRUE - the default, and what every restore that predates this member and
 every rejected image falls back to - keeps the §G.4a rule: no enabling
 device permitting, no jog. FALSE says this installation has none, and a
 station shall declare that only when it is true AND the consequence has
 been assessed: a bench with a low-force motor on a desk is the case it
 exists for, a cell with a person inside it is not. A station declaring
 FALSE should declare a §7.5 engineering gate with it, so the machine
 annunciates the departure instead of hiding it in a value nobody reads.]]></Comment><BitSize>8</BitSize><BitOffs>128</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Modules">ST_AxisTeachCfg</Name><Comment><![CDATA[ Core S3.8a/S3.8b - the axis's SECOND retained image: the named taught
 positions and the manual step. Position 1 is StationCfg.TaughtPosition
 (kept unchanged so no deployed image is lost); this image holds 2..N and
 a first boot of the upgrade (version 0) initializes silently. SchemaVersion
 first (S3.8b): 0 = never written, 1 = this layout.]]></Comment><BitSize>576</BitSize><SubItem><Name>SchemaVersion</Name><Type>UINT</Type><BitSize>16</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>ManualStep</Name><Type>LREAL</Type><Comment><![CDATA[ one manual STEP_POS / STEP_NEG]]></Comment><BitSize>64</BitSize><BitOffs>64</BitOffs></SubItem><SubItem><Name>Positions</Name><Type>LREAL</Type><ArrayInfo><LBound>2</LBound><Elements>7</Elements></ArrayInfo><Comment><![CDATA[ 1 = TaughtPosition]]></Comment><BitSize>448</BitSize><BitOffs>128</BitOffs></SubItem></DataType><DataType><Name Namespace="Tc2_MC2">MC_BufferMode</Name><BitSize>16</BitSize><BaseType>UINT</BaseType><EnumInfo><Text>MC_Aborting</Text><Enum>0</Enum></EnumInfo><EnumInfo><Text>MC_Buffered</Text><Enum>1</Enum></EnumInfo><EnumInfo><Text>MC_BlendingLow</Text><Enum>18</Enum></EnumInfo><EnumInfo><Text>MC_BlendingPrevious</Text><Enum>19</Enum></EnumInfo><EnumInfo><Text>MC_BlendingNext</Text><Enum>20</Enum></EnumInfo><EnumInfo><Text>MC_BlendingHigh</Text><Enum>21</Enum></EnumInfo></DataType><DataType><Name Namespace="Tc2_MC2">ST_PowerOptions</Name><BitSize>8</BitSize><SubItem><Name>reserved</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>0</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem></DataType><DataType><Name Namespace="Tc2_Standard">TP</Name><Comment><![CDATA[
	Pulse Timer.
	Q produces a High-Signal with the length of PT on every rising edge on IN.
]]></Comment><BitSize>256</BitSize><SubItem><Name>IN</Name><Type>BOOL</Type><Comment><![CDATA[ Trigger for Start of the Signal ]]></Comment><BitSize>8</BitSize><BitOffs>64</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>PT</Name><Type>TIME</Type><Comment><![CDATA[ The length of the High-Signal in 10ms ]]></Comment><BitSize>32</BitSize><BitOffs>96</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>Q</Name><Type>BOOL</Type><Comment><![CDATA[ The pulse ]]></Comment><BitSize>8</BitSize><BitOffs>128</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>ET</Name><Type>TIME</Type><Comment><![CDATA[ The current phase of the High-Signal ]]></Comment><BitSize>32</BitSize><BitOffs>160</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>StartTime</Name><Type>TIME</Type><BitSize>32</BitSize><BitOffs>192</BitOffs></SubItem><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name Namespace="Tc2_MC2">MC_Power</Name><BitSize>960</BitSize><SubItem><Name>Axis</Name><Type Namespace="Tc2_MC2" ReferenceTo="true">AXIS_REF</Type><Comment><![CDATA[Reference to an axis]]></Comment><BitSize>64</BitSize><BitOffs>64</BitOffs><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></SubItem><SubItem><Name>Enable</Name><Type>BOOL</Type><Comment><![CDATA[ B ]]></Comment><BitSize>8</BitSize><BitOffs>128</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>Enable_Positive</Name><Type>BOOL</Type><Comment><![CDATA[ E ]]></Comment><BitSize>8</BitSize><BitOffs>136</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem