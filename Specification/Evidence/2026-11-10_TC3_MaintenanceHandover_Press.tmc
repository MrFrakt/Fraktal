 that names nobody.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Path</Name><Type>STRING(80)</Type><BitSize>648</BitSize><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></Parameter><Parameter><Name>Expected</Name><Type>UINT</Type><BitSize>16</BitSize><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></Parameter><Parameter><Name>Found</Name><Type>UINT</Type><BitSize>16</BitSize><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></Parameter><Local><Name>i</Name><Type>INT</Type><BitSize>16</BitSize></Local><Local><Name>iCfg</Name><Type Namespace="Fraktal_Core">I_ConfigSource</Type><BitSize>64</BitSize></Local></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core">E_Mode</Name><Comment><![CDATA[ Core §3.4 baseline modes + §3.17 optional modes]]></Comment><BitSize>32</BitSize><BaseType>DINT</BaseType><EnumInfo><Text>AUTO</Text><Enum>0</Enum></EnumInfo><EnumInfo><Text>MANUAL</Text><Enum>1</Enum></EnumInfo><EnumInfo><Text>HOME</Text><Enum>2</Enum></EnumInfo><EnumInfo><Text>CHANGEOVER</Text><Enum>3</Enum></EnumInfo><EnumInfo><Text>CALIBRATION</Text><Enum>4</Enum></EnumInfo><EnumInfo><Text>CAPABILITY</Text><Enum>5</Enum><Comment><![CDATA[ Core §3.17 (optional)]]></Comment></EnumInfo><EnumInfo><Text>ADJUSTMENT</Text><Enum>6</Enum><Comment><![CDATA[ Core §3.17 (optional)]]></Comment></EnumInfo><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core">I_Unit</Name><BitSize>64</BitSize><ExtendsType Namespace="Fraktal_Core">I_Module</ExtendsType><Method><Name>__getModeActive</Name><ReturnType Namespace="Fraktal_Core">E_Mode</ReturnType><ReturnBitSize>32</ReturnBitSize><Properties><Property><Name>property</Name></Property></Properties></Method><Method><Name>Se