mType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>OutCmd</Name><Type ReferenceTo="true">ST_PneumaticPressOutCmd</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>StartLatched</Name><Type ReferenceTo="true">BOOL</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Method><Name>OnChainReset</Name><Comment><![CDATA[ §6.8 - the chain's own state on a restart (the base resets the flow state).]]></Comment></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_PressDemoReleaseState</Name><Comment><![CDATA[ The state the press's two release renditions (ST FB_PressDemoRelease, LD
 FB_LD_PressDemoRelease) share. Both declared this block word for word; it is
 declared once here and each rendition keeps only its LOGIC, which is the
 part the bench exists to carry twice (§1.1 O9). Not a Fraktal module.]]></Comment><BitSize>42496</BitSize><SubItem><Name>ModeStart</Name><Type Namespace="Fraktal_Core">FB_PermIntlk</Type><BitSize>40320</BitSize><BitOffs>64</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>ModeStartAirPressureOk</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>40384</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>RamGuardClosed</Name><Type>BOOL</Type><Comment><![CDATA[ Ram-extend permissive, split into individually named conditions. A single
 composite permit could only ever report one composite key, so releasing
 the two-hand button - the NORMAL way an operator stops a stroke - was
 indistinguishable from a guard fault, an air loss or a power loss.]]></Comment><BitSize>8</BitSize><BitOffs>40392</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>RamSlideInside</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>40400</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>RamDevicesHealthy</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>40408</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>RamAirPressureOk</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>40416</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>RamTwoHandHeld</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>40424</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>RamControlPowerOn</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>40432</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>_unitPath</Name><Type>STRING(255)</Type><BitSize>2048</BitSize><BitOffs>40440</BitOffs></SubItem><Method><Name>M_PublishTo</Name><Comment><![CDATA[ Copy the evaluated conditions into the Unit's published record. Called for
 the SELECTED rendition only, straight after it evaluated, every scan.]]></Comment><Parameter><Name>Conditions</Name><Type ReferenceTo="true">ST_PressDemoReleaseConditions</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_PressDemoRelease</Name><Comment><![CDATA[ Project-owned release engineering for the pneumatic press.
 This FB is not a Fraktal module: it exposes named condition state and fills
 the Unit's authoritative release reports without adding an OPC UA tree node.]]></Comment><BitSize>44608</BitSize><ExtendsType>FB_PressDemoReleaseState</ExtendsType><SubItem><Name>_ramExtendOk</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>42496</BitOffs></SubItem><SubItem><Name>_ramExtendKey</Name><Type>STRING(255)</Type><BitSize>2048</BitSize><BitOffs>42504</BitOffs></SubItem><Method><Name>Setup</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>UnitPath</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter></Method><Method><Name>M_AppendStart</Name><Parameter><Name>Report</Name><Type Namespace="Fraktal_Core" ReferenceTo="true">ST_ReleaseReport</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Method><Name>M_AppendManual</Name><Parameter><Name>TargetPath</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter><Parameter><Name>Value</Name><Type>DINT</Type><BitSize>32</BitSize></Parameter><Parameter><Name>PressRam</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Door</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PartSlide</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Report</Name><Type Namespace="Fraktal_Core" ReferenceTo="true">ST_ReleaseReport</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Method><Name>M_Evaluate</Name><Parameter><Name>PressRam</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Door</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PartSlide</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>TwoHand</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_TwoHandStartCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PneumaticPower</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_PowerGroupCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>AirPressure</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_AirPressureMonitorCM</Type><BitSize>64</BitSize></Parameter></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_LD_PressDemoRelease</Name><Comment><![CDATA[ Project-owned release engineering for the pneumatic press, authored in LADDER.

 This is an O2 DEMONSTRATION IN THE BENCH, not a per-project pattern. Core
 §6.8/§7.2 permit a sequence or an interlock to be authored in ST, SFC or LD,
 and the only way that claim is testable is to carry a rendition and compile
 it. Two renditions of one interlock is duplication §1.1 O9 would otherwise
 forbid outright - it is justified here, and ONLY here, because demonstrating
 the language choice IS this project's purpose, exactly as the three AUTO
 chain renditions are. A real project writes this once, in one language.
 FB_PressDemoUnit.RELEASE_LANGUAGE selects which one is evaluated.

 Same public surface as FB_PressDemoRelease so the Unit binds either without
 any other difference, and like it this is not a Fraktal module: it exposes
 named condition state and fills the Unit's authoritative release reports
 without adding an OPC UA tree node.]]></Comment><BitSize>44608</BitSize><ExtendsType>FB_PressDemoReleaseState</ExtendsType><SubItem><Name>_ramExtendOk</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>42496</BitOffs></SubItem><SubItem><Name>_ramExtendKey</Name><Type>STRING(255)</Type><BitSize>2048</BitSize><BitOffs>42504</BitOffs></SubItem><SubItem><Name>_appendCount</Name><Type>INT</Type><Comment><![CDATA[ AppendFailed returns the new report count. ST may discard a return value;
 a rung has to land it somewhere, and the ENO slot is not that somewhere.]]></Comment><BitSize>16</BitSize><BitOffs>44560</BitOffs></SubItem><Method><Name>Setup</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>UnitPath</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter></Method><Method><Name>M_AppendStart</Name><Parameter><Name>Report</Name><Type Namespace="Fraktal_Core" ReferenceTo="true">ST_ReleaseReport</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Method><Name>M_AppendManual</Name><Comment><![CDATA[ Deliberately ST, in a POU whose interlocks are ladder. This method is TARGET
 DISPATCH and bounded-report bookkeeping - matching a path against three child
 names and, failing that, writing five fields of one report row. None of that
 is condition logic, which is what O2's choice of language is about, and a
 ladder rendition of it would be longer, harder to read and no more
 demonstrative. Per-method language choice is exactly what TwinCAT offers.]]></Comment><Parameter><Name>TargetPath</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter><Parameter><Name>Value</Name><Type>DINT</Type><BitSize>32</BitSize></Parameter><Parameter><Name>PressRam</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Door</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PartSlide</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Report</Name><Type Namespace="Fraktal_Core" ReferenceTo="true">ST_ReleaseReport</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Method><Name>M_Evaluate</Name><Parameter><Name>PressRam</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Door</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PartSlide</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>TwoHand</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_TwoHandStartCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PneumaticPower</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_PowerGroupCM</Type><BitSize>64</BitSize></Parameter><Parameter><Name>AirPressure</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_AirPressureMonitorCM</Type><BitSize>64</BitSize></Parameter></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>E_RenditionLanguage</Name><Comment><![CDATA[ Which language a parallel rendition of the same engineering is written in.
 The internal press bench carries the AUTO chain three times and the release
 engineering twice — the same behaviour in a second language is a
 demonstration of §5.5/§6.8 language parity, not §1.1 O9 duplication.
 FB_PressDemoUnit selects one of each; the compiler folds the branches the
 selection does not take, so the unselected renditions are inert.

 ONE type for both selections on purpose: a value has to mean the same
 language wherever it appears. The release engineering has no
 SEQUENTIAL_FUNCTION_CHART rendition — SFC is a sequence language and has
 nothing to say about a permissive — so that member is simply never selected
 there. The gap is deliberate; it is not an invitation to reuse the value for
 something else.

 The members are spelled out rather than abbreviated because 'ST' is a
 reserved word (the IL store operator). As an enumeration member it desyncs
 the parser and cascades misleading errors onto innocent lines (lint C2).]]></Comment><BitSize>32</BitSize><BaseType>DINT</BaseType><EnumInfo><Text>STRUCTURED_TEXT</Text><Enum>0</Enum><Comment><![CDATA[ §6.8 reference form: CASE _step OF + M_Advance]]></Comment></EnumInfo><EnumInfo><Text>SEQUENTIAL_FUNCTION_CHART</Text><Enum>1</Enum><Comment><![CDATA[ native XAE chart; sequences only]]></Comment></EnumInfo><EnumInfo><Text>LADDER_DIAGRAM</Text><Enum>2</Enum><Comment><![CDATA[ rung-per-state integer machine over _step]]></Comment></EnumInfo><Properties><Property><Name>qualified_only</Name></Property><Property><Name>generate_implicit_init_function</Name></Property></Properties></DataType><DataType><Name>FB_PressDemoUnit</Name><Comment><![CDATA[ Project-owned Unit: pneumatic press + access door + transfer slide + two-hand request.
 Cylinder interlocks prevent the two documented collisions in AUTO and MANUAL.
 Certified E-stop, two-hand evaluation and safe valve outputs remain external.]]></Comment><BitSize>5444608</BitSize><ExtendsType Namespace="Fraktal_Core">FB_UnitBase</ExtendsType><SubItem><Name>ParCfg</Name><Type>ST_PneumaticPressParCfg</Type><BitSize>160</BitSize><BitOffs>2776512</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>ParCmd</Name><Type>ST_PneumaticPressParCmd</Type><BitSize>8</BitSize><BitOffs>2776672</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>PressRam</Name><Type Namespace="Fraktal_Modules">FB_CylinderCM</Type><BitSize>327744</BitSize><BitOffs>2776704</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>Door</Name><Type Namespace="Fraktal_Modules">FB_CylinderCM</Type><BitSize>327744</BitSize><BitOffs>3104448</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>PartSlide</Name><Type Namespace="Fraktal_Modules">FB_CylinderCM</Type><BitSize>327744</BitSize><BitOffs>3432192</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>TwoHand</Name><Type Namespace="Fraktal_Modules">FB_TwoHandStartCM</Type><BitSize>265856</BitSize><BitOffs>3759936</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>PneumaticPower</Name><Type Namespace="Fraktal_Modules">FB_PowerGroupCM</Type><BitSize>272512</BitSize><BitOffs>4025792</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>PartPresentSensor</Name><Type Namespace="Fraktal_Modules">FB_DigitalInputCM</Type><BitSize>273344</BitSize><BitOffs>4298304</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>AirPressureMonitor</Name><Type Namespace="Fraktal_Modules">FB_AirPressureMonitorCM</Type><BitSize>281920</BitSize><BitOffs>4571648</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>PartFeed</Name><Type Namespace="Fraktal_Modules">FB_AxisCM</Type><Comment><![CDATA[ Jenny Science XENAX Xvi servo (Annex G, PLCopen Motion). NOT CABINET
 HARDWARE - read the note on PartFeedAxis before looking for it there.]]></Comment><BitSize>414784</BitSize><BitOffs>4853568</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>ReleaseConditions</Name><Type>ST_PressDemoReleaseConditions</Type><Comment><![CDATA[ Project-owned, browseable condition state of the rendition that RUNS.]]></Comment><BitSize>56</BitSize><BitOffs>5268352</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>OutCmd</Name><Type>ST_PneumaticPressOutCmd</Type><BitSize>16</BitSize><BitOffs>5268408</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>OutImm</Name><Type>ST_PneumaticPressOutImm</Type><BitSize>16</BitSize><BitOffs>5268424</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>_recipe</Name><Type Namespace="Fraktal_Core">I_RecipeProvider</Type><BitSize>64</BitSize><BitOffs>5268480</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>PartFeedAxis</Name><Type Namespace="Tc2_MC2">AXIS_REF</Type><Comment><![CDATA[ The NC axis this Unit feeds parts with. Until an axis is actually linked
 in the System Manager, _partFeedConfigured stays FALSE and the module is
 never called: MC_Power against an unlinked AXIS_REF would otherwise run
 every scan on a bench whose eight tests are green. Absent hardware is
 absent, not silently pretended.

 WHAT THIS AXIS IS, AND IS NOT (2026-08-25). The delivered CX2030 cabinet
 has NO SERVO. Its approved I/O list is five Beckhoff terminals
 (=000+S-K010: EK1200 / EL1809 / EL2809 / EL6001 / EL9011 -- see
 Specification/Reports/CX2030_PRESS_IO_MAPPING.md), and the part feeder in
 that cabinet is PNEUMATIC: PartSlide above, driven by the digital outputs
 _101K301A/_101K301B. Do not go looking for this axis on the cabinet bus.

 The drive behind it is a Jenny Science XENAX Xvi (vendor #x557, product
 #x7508) on a SECOND EtherCAT device, =000+S-A620 (EtherCAT), kept in its
 own XTI beside the cabinet's. It is outside the press entirely and stands
 in for a feed axis so a real process can be simulated against real motion
 hardware. Anything it teaches (S3.8c) or persists (S3.8b) is BENCH data,
 not commissioning data for the press -- which is why =000+S-A610-A1
 (EtherCAT).xti, the faithful record of the delivered cabinet, does not
 mention it and must not be made to.]]></Comment><BitSize>9088</BitSize><BitOffs>5268544</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_partFeedConfigured</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>5277632</BitOffs></SubItem><SubItem><Name>_partFeedArmed</Name><Type>BOOL</Type><Comment><![CDATA[ last arming attempt's result (S5.6: no discarded return)]]></Comment><BitSize>8</BitSize><BitOffs>5277640</BitOffs></SubItem><SubItem><Name>_ioCatalog</Name><Type ReferenceTo="true">FB_PressIoCatalog</Type><Comment><![CDATA[ §10.5.1 - the project I/O catalog owns the approved channel identity join
 (§10.2.1), so it, not this Unit, resolves a force request to a physical
 channel. Absent = no force routing, which is the fail-closed default.]]></Comment><BitSize>64</BitSize><BitOffs>5277696</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_parCfgStaged</Name><Type>ST_PneumaticPressParCfg</Type><BitSize>160</BitSize><BitOffs>5277760</BitOffs></SubItem><SubItem><Name>_parCfgApplied</Name><Type>ST_PneumaticPressParCfg</Type><Comment><![CDATA[ §3.8a - the ParCfg last applied (commit or accepted edit); a difference is an
 edit of the active model's recipe to take effect and to write back.]]></Comment><BitSize>160</BitSize><BitOffs>5277920</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_recipePrepared</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>5278080</BitOffs></SubItem><SubItem><Name>_startLatched</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>5278088</BitOffs></SubItem><SubItem><Name>_powerRequestPending</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>5278096</BitOffs></SubItem><SubItem><Name>_powerTargetOn</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>5278104</BitOffs></SubItem><SubItem><Name>_homeSequence</Name><Type>FB_PressDemoHome</Type><Comment><![CDATA[ §6.8 ST chain on FB_SequenceBase owns HOME steps]]></Comment><BitSize>8192</BitSize><BitOffs>5278144</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_changeoverSequence</Name><Type>FB_PressDemoChangeover</Type><BitSize>15552</BitSize><BitOffs>5286336</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_autoSequence</Name><Type>FB_PressDemoAuto</Type><Comment><![CDATA[ §6.8 / O2 — the SAME AUTO chain in all three permitted languages. This is a
 demo bench: carrying three renditions is the point (O2 says sequences and
 interlocks may be ST, SFC or Ladder), not something a real project would do.
 AUTO_SEQUENCE_LANGUAGE below picks which one the Unit binds and runs; the
 other two are inert. They are excluded from OPC UA for the same reason the
 bound one is: a chain is not a module and publishes no Status.]]></Comment><BitSize>16192</BitSize><BitOffs>5301888</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_sfcAutoSequence</Name><Type>FB_SFC_PressDemoAuto</Type><BitSize>18816</BitSize><BitOffs>5318080</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_ldAutoSequence</Name><Type>FB_LD_PressDemoAuto</Type><BitSize>17600</BitSize><BitOffs>5336896</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_stReleaseConditions</Name><Type>FB_PressDemoRelease</Type><Comment><![CDATA[ §7.2 / O2 — the SAME release engineering in a second language. Only the
 rendition RELEASE_LANGUAGE selects is set up, evaluated, and allowed to
 write the directional permits and the release report; the other is inert.
 Neither rendition is published itself: the selected one fills
 ReleaseConditions (a VAR_OUTPUT above) every scan, so the browseable
 record is always the one being evaluated. Publishing the ST instance
 directly left it frozen at FALSE whenever LD was selected (§3.12).]]></Comment><BitSize>44608</BitSize><BitOffs>5354496</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_ldReleaseConditions</Name><Type>FB_LD_PressDemoRelease</Type><BitSize>44608</BitSize><BitOffs>5399104</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_station</Name><Type>ST_PneumaticPressStationCfg</Type><Comment><![CDATA[ §3.8b - this station's deployment data. PERSISTENT is the BACKING, not the
 architecture: the values are reached as (Scope, WriteKey) capabilities like
