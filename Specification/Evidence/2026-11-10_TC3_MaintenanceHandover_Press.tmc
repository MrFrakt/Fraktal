espace="Tc2_MC2">_ST_FunctionBlockResults</Type><BitSize>96</BitSize><BitOffs>51328</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem><SubItem><Name>ExecuteJogMove</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>51424</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem><SubItem><Name>StartType</Name><Type Namespace="Tc2_MC2">_E_TcNC_StartPosType</Type><BitSize>16</BitSize><BitOffs>51440</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem><SubItem><Name>JogMoveOut</Name><Type Namespace="Tc2_MC2">ST_McOutputs</Type><BitSize>96</BitSize><BitOffs>51456</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem><SubItem><Name>JogEnd</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>51552</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem><SubItem><Name>TargetPosition</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>51584</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem><SubItem><Name>modulo</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>51648</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem><SubItem><Name>moduloremainder</Name><Type>LREAL</Type><BitSize>64</BitSize><BitOffs>51712</BitOffs><Properties><Property><Name>conditionalshow</Name></Property></Properties></SubItem><Action><Name>ActJogMove</Name></Action><Action><Name>ActCheckJogEnd</Name></Action><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property><Property><Name>conditionalshow_all_locals</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Modules">FB_AxisCM</Name><Comment><![CDATA[ Annex G worked example on the base class: PLCopen Motion behind the standard
 handshake (§10.6). The parent Unit commands MOVE_TO exactly as it commands a
 cylinder EXTEND - it neither knows nor cares that a servo is involved (§6.1).

 The drive is reached ONLY through AXIS_REF and Tc2_MC2. That is what makes the
 type drive-agnostic: a Jenny Science XENAX linked as a CiA402 EtherCAT axis, a
 Beckhoff AX5000, or a simulated NC axis are the same code here. Any
 vendor-specific facility belongs in the driver layer (§10.2), never in a
 reusable CM.

 Like FB_SeparatorCM this type declares NO interlocks of its own (§7.2.1). Safe
 motion lives in the certified system; this module only READS its status, and
 the application supplies that status - and any station policy - through
 DeclareCondition/SetCondition. A library cannot name "STO cleared" for a
 station it has never seen.]]></Comment><BitSize>414784</BitSize><ExtendsType Namespace="Fraktal_Core">FB_ControlModuleBase</ExtendsType><SubItem><Name>Command</Name><Type Namespace="Fraktal_Modules">E_AxisCommand</Type><BitSize>32</BitSize><BitOffs>265472</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>ParCfg</Name><Type Namespace="Fraktal_Modules">ST_AxisParCfg</Type><BitSize>704</BitSize><BitOffs>265536</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>ParCmd</Name><Type Namespace="Fraktal_Modules">ST_AxisParCmd</Type><BitSize>256</BitSize><BitOffs>266240</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>OutCmd</Name><Type Namespace="Fraktal_Modules">ST_AxisOutCmd</Type><BitSize>16</BitSize><BitOffs>266496</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>OutImm</Name><Type Namespace="Fraktal_Modules">ST_AxisOutImm</Type><BitSize>384</BitSize><BitOffs>266560</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>Intlk</Name><Type Namespace="Fraktal_Core">FB_PermIntlk</Type><BitSize>40320</BitSize><BitOffs>266944</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>AXIS_STATIONCFG_SCHEMA</Name><Type>UINT</Type><Comment><![CDATA[ v2 added JogRequiresEnable]]></Comment><BitSize>16</BitSize><BitOffs>307264</BitOffs><Default><Value>2</Value></Default></SubItem><SubItem><Name>_station</Name><Type Namespace="Fraktal_Modules">ST_AxisStationCfg</Type><Comment><![CDATA[ §3.8b - the retained image. PERSISTENT is the BACKING, not the architecture:
 the value is registered per (Scope, WriteKey) like every other editable
 value, so when a set store (file/JSON/XML, MES, asset system) is wired it
 projects this through the same walk with no change here.
 Only the VALUE is persistent - the registry's pTarget stays in ordinary
 VAR, because a retained POINTER names nothing after a restart
 (ST_ConfigWriteDef, TC3 §3.8b).]]></Comment><BitSize>192</BitSize><BitOffs>307328</BitOffs><Properties><Property><Name>TcPersistent</Name></Property></Properties></SubItem><SubItem><Name>_teach</Name><Type Namespace="Fraktal_Modules">ST_AxisTeachCfg</Type><Comment><![CDATA[ §3.8b - the second retained image: named positions 2..N and the manual
 step. A separate image, so the v2 axis StationCfg (TaughtPosition,
 JogRequiresEnable) is unchanged and no deployed image is lost.]]></Comment><BitSize>576</BitSize><BitOffs>307520</BitOffs><Properties><Property><Name>TcPersistent</Name></Property></Properties></SubItem><SubItem><Name>_axis</Name><Type Namespace="Tc2_MC2" ReferenceTo="true">AXIS_REF</Type><BitSize>64</BitSize><BitOffs>308096</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_recipe</Name><Type Namespace="Fraktal_Core">I_RecipeProvider</Type><BitSize>64</BitSize><BitOffs>308160</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_power</Name><Type Namespace="Tc2_MC2">MC_Power</Type><BitSize>960</BitSize><BitOffs>308224</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_homeFb</Name><Type Namespace="Tc2_MC2">MC_Home</Type><BitSize>8064</BitSize><BitOffs>309184</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_moveFb</Name><Type Namespace="Tc2_MC2">MC_MoveAbsolute</Type><BitSize>10304</BitSize><BitOffs>317248</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_stopFb</Name><Type Namespace="Tc2_MC2">MC_Stop</Type><BitSize>11840</BitSize><BitOffs>327552</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_resetFb</Name><Type Namespace="Tc2_MC2">MC_Reset</Type><BitSize>2496</BitSize><BitOffs>339392</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_jogFb</Name><Type Namespace="Tc2_MC2">MC_Jog</Type><BitSize>51776</BitSize><BitOffs>341888</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_jogSeen</Name><Type>BOOL</Type><Comment><![CDATA[ a held request arrived THIS scan (freshness, O10)]]></Comment><BitSize>8</BitSize><BitOffs>393664</BitOffs></SubItem><SubItem><Name>_jogReqDir</Name><Type>INT</Type><Comment><![CDATA[ +1 / -1 / 0 as last asked]]></Comment><BitSize>16</BitSize><BitOffs>393680</BitOffs></SubItem><SubItem><Name>_jogEnabled</Name><Type>BOOL</Type><Comment><![CDATA[ an enabling device was held when it was asked]]></Comment><BitSize>8</BitSize><BitOffs>393696</BitOffs></SubItem><SubItem><Name>_jogDriving</Name><Type>BOOL</Type><Comment><![CDATA[ the axis is being jogged right now]]></Comment><BitSize>8</BitSize><BitOffs>393704</BitOffs></SubItem><SubItem><Name>_tJogStale</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize><BitOffs>393728</BitOffs></SubItem><SubItem><Name>_tMove</Name><Type Namespace="Tc2_Standard">TON</Type><BitSize>256</BitSize><BitOffs>393984</BitOffs></SubItem><SubItem><Name>_homed</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>394240</BitOffs></SubItem><SubItem><Name>_parCfgStaged</Name><Type Namespace="Fraktal_Modules">ST_AxisParCfg</Type><BitSize>704</BitSize><BitOffs>394304</BitOffs></SubItem><SubItem><Name>_recipePrepared</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>395008</BitOffs></SubItem><SubItem><Name>_appCond</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>16</Elements></ArrayInfo><BitSize>128</BitSize><BitOffs>395016</BitOffs></SubItem><SubItem><Name>_moveRelFb</Name><Type Namespace="Tc2_MC2">MC_MoveRelative</Type><BitSize>10304</BitSize><BitOffs>395200</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_positionLabel</Name><Type>STRING(160)</Type><ArrayInfo><LBound>2</LBound><Elements>7</Elements></ArrayInfo><BitSize>9016</BitSize><BitOffs>405504</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_positionDeclared</Name><Type>BOOL</Type><ArrayInfo><LBound>2</LBound><Elements>7</Elements></ArrayInfo><BitSize>56</BitSize><BitOffs>414520</BitOffs></SubItem><SubItem><Name>_override</Name><Type>LREAL</Type><Comment><![CDATA[ accepted set-and-hold speed override, percent]]></Comment><BitSize>64</BitSize><BitOffs>414592</BitOffs><Default><Value>100</Value></Default></SubItem><SubItem><Name>_relDistance</Name><Type>LREAL</Type><Comment><![CDATA[ a relative move's distance, resolved once when it starts]]></Comment><BitSize>64</BitSize><BitOffs>414656</BitOffs></SubItem><SubItem><Name>_setupDone</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>414720</BitOffs></SubItem><Method><Name>SetJogRequiresEnable</Name><Comment><![CDATA[ §3.8a/§G.4a - declare whether this INSTALLATION has a safety-rated enabling
 device for manual motion. Called by the composition root; it also stamps the
 schema version forward, so a call made before Setup survives the restore
 (a matching version is restored as-is rather than defaulted).

 FALSE relaxes exactly one requirement - the enabling device - and nothing
 else: interlocks, the freshness deadline and the command handshake all still
 apply, and jog still refuses a stale request. A station that declares FALSE
 should declare a §7.5 engineering gate with it, so the machine says out loud
 that it is jogging without one.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Required</Name><Type>BOOL</Type><BitSize>8</BitSize></Parameter></Method><Method><Name>_M_Home</Name></Method><Method><Name>M_DeclarePosition</Name><Comment><![CDATA[ §3.8a - declare a named taught position (index 2..MAX_POSITIONS) BEFORE
 Setup, the SetJogRequiresEnable idiom: the composition root names the
 positions this installation actually has, and Setup turns each declaration
 into an editable value with a capture. Refused out of range, for an empty
 label, for a second declaration of the same index, or after Setup - a
 position that arrives too late is silently unregistered and uneditable,
 which is worse than a visible refusal. Position 1 is the standing taught
 position and is never declared here.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Index</Name><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>LabelKey</Name><Type>STRING(160)</Type><BitSize>1288</BitSize></Parameter></Method><Method><Name>CommitRecipe</Name></Method><Method><Name>WithdrawOutputs</Name><Comment><![CDATA[ Functional stop used by an owning sequence on abort/interlock loss. This is a
 controlled MC_Stop, NOT a certified safe stop: the safety system remains
 authoritative and STO is its business, not this module's (§9).]]></Comment></Method><Method><Name>OnAbort</Name><ReturnType>DINT</ReturnType><ReturnBitSize>32</ReturnBitSize></Method><Method><Name>SetCondition</Name><Comment><![CDATA[ Drive a condition declared by DeclareCondition, every scan.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Index</Name><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>Ok</Name><Type>BOOL</Type><BitSize>8</BitSize></Parameter></Method><Method><Name>_M_JogCyclic</Name><Comment><![CDATA[ The one place a jog is allowed to start, continue, or stop. Runs every scan
 from OnCyclic, whether or not anybody asked - because "nobody asked" is
 precisely the condition that has to stop the axis.]]></Comment><Local><Name>drive</Name><Type>BOOL</Type><BitSize>8</BitSize></Local></Method><Method><Name>_M_MoveRel</Name><Comment><![CDATA[ WP3.2 - relative and step moves on MC_MoveRelative, behind the same
 handshake mapping as MOVE_TO (G.3). Validation order mirrors _M_MoveTo:
 the request (step set, distance, resolved target, speed scale) before the
 state (datum, bound axis), so every rejection is provable without a
 licensed NC axis. A zero distance commands nothing and needs no datum.]]></Comment><Local><Name>target</Name><Type>LREAL</Type><BitSize>64</BitSize></Local></Method><Method><Name>_M_ApplyConditions</Name><Local><Name>i</Name><Type>INT</Type><BitSize>16</BitSize></Local></Method><Method><Name>Setup</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Name</Name><Type>STRING(80)</Type><BitSize>648</BitSize></Parameter><Parameter><Name>AxisRef</Name><Type Namespace="Tc2_MC2" ReferenceTo="true">AXIS_REF</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Recipe</Name><Type Namespace="Fraktal_Core">I_RecipeProvider</Type><BitSize>64</BitSize></Parameter><Local><Name>InitialModel</Name><Type Namespace="Fraktal_Core">ST_ModelId</Type><BitSize>7856</BitSize></Local><Local><Name>i</Name><Type>INT</Type><BitSize>16</BitSize></Local></Method><Method><Name>RequestHeldCommand</Name><Comment><![CDATA[ §7.6.1 held command - JOG_POS / JOG_NEG. Called EVERY SCAN while the
 operator holds the button; silence stops the axis (see _M_JogCyclic).

 This method only RECORDS the request. Nothing moves from here: the decision to
 drive is taken once per scan in _M_JogCyclic, where the interlock, the enabling
 device, the freshness deadline and the command handshake are all weighed
 together. Keeping the decision in one place is what makes it reviewable.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Value</Name><Type>DINT</Type><BitSize>32</BitSize></Parameter><Parameter><Name>Enable</Name><Type Namespace="Fraktal_Core">ST_ManualEnableStatus</Type><BitSize>664</BitSize></Parameter></Method><Method><Name>_M_MoveTo</Name><Local><Name>target</Name><Type>LREAL</Type><BitSize>64</BitSize></Local></Method><Method><Name>AbortRecipe</Name></Method><Method><Name>_M_Dispatch</Name><Local><Name>dg</Name><Type Namespace="Fraktal_Core">ST_Diagnostic</Type><BitSize>5568</BitSize></Local></Method><Method><Name>DeclareCondition</Name><Comment><![CDATA[ Core §7.2.1 - the application names its own conditions on this module; the
 library declares none. Safe-motion status (§9.2) is read-only application
 input, so "STO cleared" is declared here by the station that can see it.
 Declared conditions start FALSE: declaring one states an intent to gate.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Index</Name><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>DescriptionKey</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter><Parameter><Name>Reason</Name><Type Namespace="Fraktal_Core">E_Reason</Type><BitSize>32</BitSize></Parameter><Parameter><Name>Bypassable</Name><Type>BOOL</Type><BitSize>8</BitSize></Parameter></Method><Method><Name>PrepareRecipe</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Model</Name><Type Namespace="Fraktal_Core">ST_ModelId</Type><BitSize>7856</BitSize></Parameter></Method><Method><Name>_M_FaultStopped</Name><Comment><![CDATA[ Stop the axis, THEN fault. _M_FaultN raises the reason without touching
 motion, so faulting mid-move would leave the drive commanded - the same defect
 the separator's _M_FaultClosed exists to prevent, and worse here because the
 load is moving.]]></Comment><Parameter><Name>Code</Name><Type>DINT</Type><BitSize>32</BitSize></Parameter><Parameter><Name>Text</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter></Method><Method><Name>OnCyclic</Name><ReturnType>DINT</ReturnType><ReturnBitSize>32</ReturnBitSize></Method><Method><Name>SetOverride</Name><Comment><![CDATA[ §6.1/WP3.3 - the set-and-hold speed override in percent. It scales motion
 through _power's Override, so it acts on a running move and on jog. Refused
 (and the previous value kept) outside 0..100: an override nobody accepted is
 not a value the axis inherits. No freshness fallback: a silent owner can
 only leave an already accepted, lower-or-equal value.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Percent</Name><Type>LREAL</Type><BitSize>64</BitSize></Parameter></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>ST_PressDemoReleaseConditions</Name><Comment><![CDATA[ Core §7.2/§3.12 - the press's named release conditions, as PUBLISHED.
 Filled every scan from whichever rendition RELEASE_LANGUAGE selects, so a
 browsing client always reads the conditions that are actually being
 evaluated. Before this, the ST component was the published one and was
 never evaluated while LADDER_DIAGRAM was selected: every flag sat at its
 initial FALSE whatever the machine was doing - state nobody computes,
 published as if it were a claim.]]></Comment><BitSize>56</BitSize><SubItem><Name>ModeStartAirPressureOk</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>RamGuardClosed</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>8</BitOffs></SubItem><SubItem><Name>RamSlideInside</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>16</BitOffs></SubItem><SubItem><Name>RamDevicesHealthy</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>24</BitOffs></SubItem><SubItem><Name>RamAirPressureOk</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>32</BitOffs></SubItem><SubItem><Name>RamTwoHandHeld</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>40</BitOffs></SubItem><SubItem><Name>RamControlPowerOn</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>48</BitOffs></SubItem></DataType><DataType><Name>ST_PneumaticPressOutCmd</Name><BitSize>16</BitSize><SubItem><Name>CycleCompleted</Name><Type>BOOL</Type><Comment><![CDATA[ §3.12 — OutCmd is what a COMMAND PRODUCED, latched until the next command.
 Both of these are genuine command results: a cycle ran, a changeover ran.
 `Homed` used to live here and does not any more - being at the home position
 is not something a command produced, it is something that is either true now
 or not, so it is derived state (OutImm.Homed) recomputed every scan.]]></Comment><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>ChangeoverCompleted</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>8</BitOffs></SubItem></DataType><DataType><Name>ST_PneumaticPressOutImm</Name><BitSize>16</BitSize><SubItem><Name>Homed</Name><Type>BOOL</Type><Comment><![CDATA[ Only facts the Unit DERIVES. A child's own state is read on the child
 (PressRam.OutImm.Retracted, ...), never copied here under a second name (O9).

 §3.12 derived state: TRUE while the machine IS at its reference position.
 As a latched command result it went on claiming "homed" after an operator
 jogged an axis off home in MANUAL, because no sequence ran to clear it.]]></Comment><BitSize>8</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>TwoHandStartReady</Name><Type>BOOL</Type><Comment><![CDATA[ TRUE while a two-hand press would start a cycle: buttons armed, the control
 domain ready, a part loaded and air present. Drives the pushbutton lamps.]]></Comment><BitSize>8</BitSize><BitOffs>8</BitOffs></SubItem></DataType><DataType><Name Namespace="Fraktal_Core">E_StepResult</Name><Comment><![CDATA[ Core §6.8/§6.10 — the shared step transition result of FB_SequenceBase.
 The ACTIVE step's action is the only writer; every chart transition reads it;
 the step's exit action clears it back to NONE (single token => no ambiguity).
 ADVANCE takes the normal successor; JUMP1..JUMP3 select declared alternative
 branches (§6.10 decisions/skips/retries) — a chart maps each to one target.]]></Comment><BitSize>32</BitSize><BaseType>DINT</BaseType><EnumInfo><Text>NONE</Text><Enum>0</Enum><Comment><![CDATA[ stay in this step (still working/waiting)]]></Comment></EnumInfo><EnumInfo><Text>ADVANCE</Text><Enum>1</Enum><Comment><![CDATA[ standard transition: the awaited work is done]]></Comment></EnumInfo><EnumInfo><Text>JUMP1</Text><Enum>2</Enum><Comment><![CDATA[ first declared alternative branch]]></Comment></EnumInfo><EnumInfo><Text>JUMP2</Text><Enum>3</Enum><Comment><![CDATA[ second declared alternative branch]]></Comment></EnumInfo><EnumInfo><Text>JUMP3</Text><Enum>4</Enum><Comment><![CDATA[ third declared alternative branch]]></Comment></EnumInfo><Properties><Property><Name>qualified_only</Name></Property></Properties></DataType><DataType><Name Namespace="Fraktal_Core">FB_SequenceBase</Name><Comment><![CDATA[ Core §6.8 — THE provided step-chain base: an SFC/ST/LD sequence POU extends
 this and gets the step record, condition waits, run-style pacing, the child
 PLCopen drive, delays, and the shared transition result — without re-declaring
 host plumbing per chain. The derived chart's actions are the only writers of
 _retVal; every chart transition reads it; one shared exit action calls
 M_ClearTransition. Framework flow-control lives here ONCE (§6.8(a)); the
 application's command/wait/decision logic stays visible in each step action.]]></Comment><BitSize>3968</BitSize><Implements Namespace="Fraktal_Core">I_Sequence</Implements><SubItem><Name>ActiveStep</Name><Type>INT</Type><Comment><![CDATA[ §6.5 mirror of the step record (chart-local view)]]></Comment><BitSize>16</BitSize><BitOffs>128</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>Done</Name><Type>BOOL</Type><Comment><![CDATA[ finite chains: TRUE at their finish step]]></Comment><BitSize>8</BitSize><BitOffs>144</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>_step</Name><Type>INT</Type><Comment><![CDATA[ §6.5 active step index (the ST `CASE _step OF` token)]]></Comment><BitSize>16</BitSize><BitOffs>160</BitOffs></SubItem><SubItem><Name>_retVal</Name><Type Namespace="Fraktal_Core">E_StepResult</Type><Comment><![CDATA[ Shared transition result (§6.10). ONE-SCAN signal: the active step's action
 is its only writer, every chart transition reads it, and it is cleared before
 the next scan's actions run - by M_Advance on commit in an ST chart, or by
 M_BeginScan when the chart runtime owns the transition (SFC/LD/FBD).]]></Comment><BitSize>32</BitSize><BitOffs>192</BitOffs></SubItem><SubItem><Name>_conRetVal</Name><Type Namespace="Fraktal_Core">E_StepResult</Type><ArrayInfo><LBound>1</LBound><Elements>9</Elements></ArrayInfo><Comment><![CDATA[ §6.12 — the same one-scan signal as _retVal, but one per CONCURRENT LEG.
 A parallel divergence has several active steps at once, so a single shared
 result cannot work: whichever leg wrote last would decide every leg's
 transition. Index n belongs to leg n; the main line keeps _retVal, so a
 chain with no parallel branch never touches this array.

 A leg's step action writes `_conRetVal[n] := E_StepResult.ADVANCE;` and its
 transition reads `_conRetVal[n] = E_StepResult.ADVANCE`; the join reads every
 leg plus the main line. Cleared with _retVal once per scan (M_BeginScan), and
 per leg on that leg's step exit (M_ClearTransition) - never across legs,
 which would let one leg's commit erase another's result mid-motion.]]></Comment><BitSize>288</BitSize><BitOffs>224</BitOffs></SubItem><SubItem><Name>_restart</Name><Type>BOOL</Type><Comment><![CDATA[ a step may request a chart restart (M_Run applies it)]]></Comment><BitSize>8</BitSize><BitOffs>512</BitOffs></SubItem><SubItem><Name>SFCReset</Name><Type>BOOL</Type><Comment><![CDATA[ Native chart restart, consumed by the initial step's mandatory M_Step.
 SFC POUs enable Reset/use-inherited in their archive; ST/LD ignore it.]]></Comment><BitSize>8</BitSize><BitOffs>520</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_host</Name><Type Namespace="Fraktal_Core">I_SequenceHost</Type><Comment><![CDATA[ owning module's framework services (§6.7)]]></Comment><BitSize>64</BitSize><BitOffs>576</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_attached</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>640</BitOffs></SubItem><SubItem><Name>_delay</Name><Type Namespace="Tc2_Standard">TON</Type><ArrayInfo><LBound>0</LBound><Elements>10</Elements></ArrayInfo><Comment><![CDATA[ §6.12 — every STEP-scoped latch is per CONCURRENT BRANCH, because two legs of
 a parallel divergence are two active steps in the same POU at the same time.
 Sharing one latch let leg A's issue consume leg B's, and let leg A's step exit
 wipe leg B's transition result. Index 0 is the main line, which is what a chain
 without any parallel branch uses throughout.]]></Comment><BitSize>2560</BitSize><BitOffs>704</BitOffs></SubItem><SubItem><Name>_driveIssued</Name><Type>BOOL</Type><ArrayInfo><LBound>0</LBound><Elements>10</Elements></ArrayInfo><BitSize>80</BitSize><BitOffs>3264</BitOffs></SubItem><SubItem><Name>_subRunning</Name><Type>BOOL</Type><ArrayInfo><LBound>0</LBound><Elements>10</Elements></ArrayInfo><BitSize>80</BitSize><BitOffs>3344</BitOffs></SubItem><SubItem><Name>_branch</Name><Type>INT</Type><Comment><![CDATA[ Which leg the step action executing RIGHT NOW belongs to. Set by M_Step from
 its `Branch` input, so it is always in step with the record just published,
 and reset to _branchBase every scan - a chain that never names a leg is
 therefore always on its own, which for a top-level chain is the main line.]]></Comment><BitSize>16</BitSize><BitOffs>3424</BitOffs></SubItem><SubItem><Name>_branchBase</Name><Type>INT</Type><Comment><![CDATA[ This chain's own leg index when the chain IS a leg (assigned by M_RunPar at
 the fork). 0 for a top-level chain. It is what lets a leg written as its own
 chain tag every one of its rows without naming a branch anywhere.]]></Comment><BitSize>16</BitSize><BitOffs>3440</BitOffs></SubItem><SubItem><Name>_lastStep</Name><Type>INT</Type><ArrayInfo><LBound>0</LBound><Elements>10</Elements></ArrayInfo><BitSize>160</BitSize><BitOffs>3456</BitOffs></SubItem><SubItem><Name>_stepSeen</Name><Type>BOOL</Type><ArrayInfo><LBound>0</LBound><Elements>10</Elements></ArrayInfo><BitSize>80</BitSize><BitOffs>3616</BitOffs></SubItem><SubItem><Name>_parStarted</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>9</Elements></ArrayInfo><BitSize>72</BitSize><BitOffs>3696</BitOffs></SubItem><SubItem><Name>_parLegs</Name><Type>INT</Type><Comment><![CDATA[ M_RunPar calls made this scan]]></Comment><BitSize>16</BitSize><BitOffs>3776</BitOffs></SubItem><SubItem><Name>_parDone</Name><Type>INT</Type><Comment><![CDATA[ how many of them reported Done]]></Comment><BitSize>16</BitSize><BitOffs>3792</BitOffs></SubItem><SubItem><Name>_errorRaised</Name><Type>BOOL</Type><Comment><![CDATA[ this chain raised the active fault (§6.9)]]></Comment><BitSize>8</BitSize><BitOffs>3808</BitOffs></SubItem><SubItem><Name>_warnRaised</Name><Type>BOOL</Type><ArrayInfo><LBound>0</LBound><Elements>10</Elements></ArrayInfo><Comment><![CDATA[ §6.9(e) one message per step visit]]></Comment><BitSize>80</BitSize><BitOffs>3816</BitOffs></SubItem><SubItem><Name>_baseStepNo</Name><Type>INT</Type><Comment><![CDATA[ §6.5 step-record offset when run as a sub-chain]]></Comment><BitSize>16</BitSize><BitOffs>3904</BitOffs></SubItem><Method><Name>M_BeginScan</Name><Comment><![CDATA[ Core §6.10 - scan-scoped reset of the shared transition result.

 `_retVal` is a ONE-SCAN signal: the active step's action writes it, the chart's
 transition reads it in the same scan, and it must not survive into the next.
 In an ST chart M_Advance is itself the transition, so it commits and clears in
 one call. In a chart language the RUNTIME evaluates transitions (SFC/LD/FBD),
 so nothing in the chart is positioned to clear afterwards - call this once per
 PLC cycle immediately BEFORE executing the chart. Clearing at the top of the
 scan is equivalent to clearing after the previous scan's transitions, and it
 forces every step action to re-assert its own result each scan, which is the
 property that makes a stale ADVANCE impossible.

 It deliberately clears ONLY the result. `_driveIssued` (M_TryIssue's one-shot)
 and `_delay` (M_Delay's timer) are STEP-scoped, not scan-scoped: resetting them
 every scan would re-issue a child command every cycle and stop any delay from
 ever elapsing. Those re-arm on step change, through M_ClearTransition.]]></Comment><Local><Name>Idx</Name><Type>INT</Type><BitSize>16</BitSize></Local></Method><Method><Name>M_PartStarted</Name></Method><Method><Name>M_RaiseWarning</Name><Comment><![CDATA[ §6.9(e) — a custom message that informs and lets the chain carry on.

 For designed behaviour with a consequence worth recording: an operator
 releasing a two-hand control mid-motion, a retry, a value drifting inside its
 band. It is NOT the error path - the chain is not stopped, no fault is
 adopted, and the step keeps whatever recovery it already routes to.

 Raised at most ONCE per visit to a step, however many scans the step runs and
 however many times this is called (§1.1 O1: a project shall never have to
 remember an edge latch for correctness). Committing the step re-arms it.

 Severity/Category are the caller's for a project band code; a reason in the
 §8.8 registry is rationalized to the registry's values like any other.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Reason</Name><Type Namespace="Fraktal_Core">E_Reason</Type><BitSize>32</BitSize></Parameter><Parameter><Name>DescriptionKey</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter><Parameter><Name>Severity</Name><Type Namespace="Fraktal_Core">E_Severity</Type><BitSize>32</BitSize></Parameter><Parameter><Name>Category</Name><Type Namespace="Fraktal_Core">E_Category</Type><BitSize>32</BitSize></Parameter><Local><Name>diag</Name><Type Namespace="Fraktal_Core">ST_Diagnostic</Type><BitSize>5568</BitSize></Local></Method><Method><Name>M_ClearTransition</Name><Comment><![CDATA[ the ONE shared STEP-EXIT action: a completed step's result never leaks into
 the next step, and the step-scoped helpers (delay, drive latch) re-arm.
 §6.12 — it re-arms THE CURRENT BRANCH only. Clearing every branch here is what
 made a parallel divergence misbehave: one leg committing a step wiped the other
 leg's transition result and its issue latch mid-motion.
 ST charts reach this through M_Advance on commit. A chart language whose
 engine owns the transition (SFC/LD/FBD) wires this as the step exit action,
 which the runtime executes AFTER the transition condition was evaluated -
 so the transition still sees the result the step action produced.]]></Comment><Local><Name>Idx</Name><Type>INT</Type><BitSize>16</BitSize></Local></Method><Method><Name>M_Restart</Name><Comment><![CDATA[ §6.8 I_Sequence - start over at N000 with the chain's own state cleared. The
 owning Unit calls this for every attached chain on first scan, mode change and
 both abort paths, and a project calls it (through _M_RestartSequences) where
 its own restart-or-resume policy says so. A chain puts the state it owns in
 OnChainReset and writes no reset method of its own (§1.1 O1).]]></Comment></Method><Method><Name>M_AskDecision</Name><Comment><![CDATA[ §6.11 forward]]></Comment><Parameter><Name>Req</Name><Type Namespace="Fraktal_Core">ST_DecisionRequest</Type><BitSize>7264</BitSize></Parameter></Method><Method><Name>M_Delay</Name><Comment><![CDATA[ a declared process wait in ONE step (settle/dwell). The timer runs while the
 step is active and re-arms through the shared exit action.]]></Comment><ReturnType Namespace="Fraktal_Core">E_StepResult</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>PT</Name><Type>TIME</Type><BitSize>32</BitSize></Parameter></Method><Method><Name>M_PartReceived</Name><Comment><![CDATA[ §3.16.3 forward (framework plumbing stays out of step actions).]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize></Method><Method><Name>M_StopNow</Name><Comment><![CDATA[ §3.4/§8.11 — accept the stop between cycles (forward to the host).]]></Comment></Method><Method><Name>M_RunSub</Name><Comment><![CDATA[ §6.8 run another chain as ONE composite step. Returns NONE while the
 sub-chain works and ADVANCE on the scan it finishes, so a step action reads:

     _retVal := M_RunSub(Chain := _loadPosition, BaseStepNo := 240);

 The entry latch is step-scoped and re-arms through M_ClearTransition, so a
 chain re-entered later restarts correctly. The sub-chain inherits the leg of
 the step that runs it (§6.12), so a composite step inside a parallel branch
 publishes its sub-steps under that leg without saying so. Hand-written, this was eight lines
 per composite step and one forgotten latch reset left a chain that never ran
 again (§1.1 O1: the framework owns repeated flow control, not the project).]]></Comment><ReturnType Namespace="Fraktal_Core">E_StepResult</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>Chain</Name><Type Namespace="Fraktal_Core" ReferenceTo="true">FB_SequenceBase</Type><BitSize>64</BitSize></Parameter><Parameter><Name>BaseStepNo</Name><Type>INT</Type><BitSize>16</BitSize></Parameter></Method><Method><Name>M_ParJoin</Name><Comment><![CDATA[ §6.12 — the join of a parallel step: ADVANCE on the scan every leg run this
 scan has reported Done, NONE while any is still working. The counts are
 scan-scoped, so the join always reflects the legs the step actually ran -
 there is no leg list to register, and none to forget to update (§1.1 O1).]]></Comment><ReturnType Namespace="Fraktal_Core">E_StepResult</ReturnType><ReturnBitSize>32</ReturnBitSize></Method><Method><Name>M_RaiseFromChild</Name><Comment><![CDATA[ §6.9 — adopt a child's first-out from inside conditional step logic.

 `Awaits` rolls a child fault up automatically, but only for a step that hands
 the child to the framework. A step that decides for itself - anything with an
 IF or CASE around the command - calls this instead, and gets the same result:
 the child's reason verbatim, the child's path as the §3.13 drill-down link,
 and the chain stopped until the error is cleared.

 Returns TRUE only when a fault was actually raised, so the usual shape is
     IF M_RaiseFromChild(Source := _pressRam) THEN RETURN; END_IF]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Source</Name><Type Namespace="Fraktal_Core">I_Module</Type><BitSize>64</BitSize></Parameter></Method><Method><Name>M_Step</Name><Comment><![CDATA[ §6.5 step record + the chart-local ActiveStep mirror, one call.]]></Comment><Parameter><Name>StepNo</Name><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>StepName</Name><Type>STRING(120)</Type><BitSize>968</BitSize></Parameter><Parameter><Name>Awaits</Name><Type Namespace="Fraktal_Core">I_Module</Type><BitSize>64</BitSize></Parameter><Parameter><Name>AwaitingLabel</Name><Type>STRING(120)</Type><BitSize>968</BitSize></Parameter><Parameter><Name>TimeClass</Name><Type Namespace="Fraktal_Core">E_TimeClass</Type><BitSize>32</BitSize></Parameter><Parameter><Name>ExpectedTime</Name><Type>TIME</Type><BitSize>32</BitSize></Parameter><Parameter><Name>Branch</Name><Comment><![CDATA[ §6.12 — the concurrent leg this step belongs to, which a step on the main
 line never mentions. Folding it into the step record rather than a separate
 call is what makes it impossible to declare a leg without recording a step,
 or to record a step under the wrong leg because the declaration was
 forgotten (§1.1 O1: the framework owns the bookkeeping, not the project).
 0 means "this chain's own leg", which is the main line for a top-level chain
 and the index the fork assigned for a chain running as a leg (M_RunPar) -
 so a leg written as its own chain never mentions a branch either.]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter></Method><Method><Name>M_ClearDecision</Name></Method><Method><Name>M_ResetBase</Name><Comment><![CDATA[ clear the base flow state to the first step. The derived M_Reset calls this.]]></Comment><Parameter><Name>FirstStep</Name><Comment><![CDATA[ the chain's initial step number (N000 = 0)]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter><Local><Name>Idx</Name><Type>INT</Type><BitSize>16</BitSize></Local></Method><Method><Name>M_TakeDecision</Name><ReturnType>INT</ReturnType><ReturnBitSize>16</ReturnBitSize></Method><Method><Name>M_ChainRun</Name><Comment><![CDATA[ One scan of this chain. An ST chart overrides this with its
 `CASE _step OF` body; a chart-language POU leaves it alone because its own body
 IS the chart and the runtime executes it. Only a chain that is used as a
 composite step (M_RunSub) has to override it.]]></Comment></Method><Method><Name>M_ResumeAfterError</Name><Comment><![CDATA[ §6.9 — the owning Unit left ERROR. The chain's _step was never touched, so it
 resumes exactly where it stopped; re-arming the step-scoped latches here is
 what makes it RE-EVALUATE the command rather than resume mid-handshake with a
 spent M_TryIssue one-shot and a half-run delay.]]></Comment></Method><Method><Name>M_Await</Name><Comment><![CDATA[ §6.9(b) named plain-condition wait (forward to the host).]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Idx</Name><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>Label</Name><Type>STRING(120)</Type><BitSize>968</BitSize></Parameter><Parameter><Name>Ok</Name><Type>BOOL</Type><BitSize>8</BitSize></Parameter></Method><Method><Name>M_CountGood</Name></Method><Method><Name>M_Advance</Name><Comment><![CDATA[ §6.8 ST-skeleton progression: at the END of a `CASE _step OF` body, commit the
 step's shared transition result. On ADVANCE (or a declared JUMPn) go to the
 mapped next step and clear the step-scoped latches so the new step re-arms — the
 exact guarantee the SFC exit action gave, in one call. NONE stays put. The caller
 passes its successor map; an unmapped result holds the step (safe, visible).]]></Comment><Parameter><Name>OnAdvance</Name><Comment><![CDATA[ next step for E_StepResult.ADVANCE]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>OnJump1</Name><Comment><![CDATA[ next step for JUMP1 (-1 = not used)]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>OnJump2</Name><Comment><![CDATA[ next step for JUMP2 (-1 = not used)]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>OnJump3</Name><Comment><![CDATA[ next step for JUMP3 (-1 = not used)]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter><Local><Name>target</Name><Type>INT</Type><BitSize>16</BitSize></Local></Method><Method><Name>M_PartRecord</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>RecordName</Name><Type>STRING(64)</Type><BitSize>520</BitSize></Parameter><Parameter><Name>Value</Name><Type>LREAL</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Minimum</Name><Type>LREAL</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Maximum</Name><Type>LREAL</Type><BitSize>64</BitSize></Parameter><Parameter><Name>Target</Name><Type>LREAL</Type><BitSize>64</BitSize></Parameter><Parameter><Name>EngUnit</Name><Type>STRING(16)</Type><BitSize>136</BitSize></Parameter></Method><Method><Name>M_TryIssue</Name><Comment><![CDATA[ §6.1 issue+await in ONE step: TRUE exactly once per step visit, when the
 run-style gate permits (§3.4.2). The action then sets the child's typed
 Command and raises Execute — visibly, in the step (§6.8). The child's Done
 releases the handshake and sets _retVal := ADVANCE; a child Error needs no
 step code — the owning Unit adopts it instantly via the §8.2 rollup.
 The latch re-arms through the shared exit action (M_ClearTransition).]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Steppable</Name><Type>BOOL</Type><BitSize>8</BitSize></Parameter></Method><Method><Name>M_RunPar</Name><Comment><![CDATA[ §6.12 — run one leg of a parallel step. THE portable form of a parallel
 divergence, and the only one available to an ST chain.

     M_Step(StepNo := 500, StepName := 'project.step.bothPositions', ...);
     M_RunPar(Chain := _positionA, BaseStepNo := 500, Branch := 1);
     M_RunPar(Chain := _positionB, BaseStepNo := 600, Branch := 2);
     _retVal := M_ParJoin();
     M_Advance(OnAdvance := 999);

 Each leg is an ordinary FB_SequenceBase chain, so it brings its own step
 pointer, its own transition result and its own step-scoped latches - the
 collisions §6.12 has to manage inside one POU simply cannot arise (§1.1 O4:
 the model scales structurally rather than by decoration). Its steps are
 recorded under BaseStepNo and tagged with Branch, so the §3.13 flow chart
 groups them and the §6.9 walk still names one continuous chain.

 Returns TRUE on the scans this leg reports Done. The entry latch is
 step-scoped, so re-entering the fork step later restarts every leg.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Chain</Name><Type Namespace="Fraktal_Core" ReferenceTo="true">FB_SequenceBase</Type><BitSize>64</BitSize></Parameter><Parameter><Name>BaseStepNo</Name><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>Branch</Name><Type>INT</Type><BitSize>16</BitSize></Parameter></Method><Method><Name>M_Gate</Name><Comment><![CDATA[ §3.4.2 run-style pacing gate (forward to the host).]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Steppable</Name><Type>BOOL</Type><BitSize>8</BitSize></Parameter></Method><Method><Name>M_ChainReset</Name><Comment><![CDATA[ Restart this chain as a sub-chain of a composite step: its step records are
 offset by the owning step number (§6.5) so the stall walk still reports one
 continuous chain. OnChainReset carries any application state.]]></Comment><Parameter><Name>BaseStepNo</Name><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>Branch</Name><Comment><![CDATA[ §6.12 the leg index this chain runs as, assigned by the fork. 0 = not a leg.
 Every step it records is tagged with it, so the project writes it once per
 leg instead of once per step (§1.1 O1).]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter></Method><Method><Name>M_RaiseCustom</Name><Comment><![CDATA[ §6.9/§8.8 — raise a message this step defines itself.

 For a condition the framework cannot see: a measured value out of band, a
 disagreement between two children, an application rule. LinkPath is the module
 the §3.13 chart should drill into ('' = this Unit).

 Severity and Category are a PROPOSAL, not the last word: adoption runs the §8.8
 rationalization, so a reason that is in the registry gets the registry's priority
 and category and these inputs are ignored. They survive for a project band code
 (10000+) the registry does not know - which is exactly where a custom message of
 a different level belongs.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Reason</Name><Type Namespace="Fraktal_Core">E_Reason</Type><BitSize>32</BitSize></Parameter><Parameter><Name>DescriptionKey</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter><Parameter><Name>Severity</Name><Type Namespace="Fraktal_Core">E_Severity</Type><BitSize>32</BitSize></Parameter><Parameter><Name>Category</Name><Type Namespace="Fraktal_Core">E_Category</Type><BitSize>32</BitSize></Parameter><Parameter><Name>LinkPath</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter><Local><Name>diag</Name><Type Namespace="Fraktal_Core">ST_Diagnostic</Type><BitSize>5568</BitSize></Local></Method><Method><Name>M_Fault</Name><Comment><![CDATA[ §6.9 first-out fault from a step (forward to the host).]]></Comment><Parameter><Name>Reason</Name><Type Namespace="Fraktal_Core">E_Reason</Type><BitSize>32</BitSize></Parameter><Parameter><Name>DescriptionKey</Name><Type>STRING(255)</Type><BitSize>2048</BitSize></Parameter></Method><Method><Name>M_PartProcessed</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Verdict</Name><Type Namespace="Fraktal_Core">E_Verdict</Type><BitSize>32</BitSize></Parameter><Parameter><Name>Reason</Name><Type Namespace="Fraktal_Core">E_Reason</Type><BitSize>32</BitSize></Parameter></Method><Method><Name>M_Attach</Name><Comment><![CDATA[ bind the owner's host bridge; the derived Setup adds its typed child bindings.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Host</Name><Type Namespace="Fraktal_Core">I_SequenceHost</Type><BitSize>64</BitSize></Parameter></Method><Method><Name>OnChainReset</Name><Comment><![CDATA[ §3.14 hook: clear application-owned chain state on restart. Empty by default
 so a chain that has none writes nothing.]]></Comment></Method><Method><Name>M_StopPending</Name><Comment><![CDATA[ §3.4 — poll at the between-cycles wait step (forward to the host).]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize></Method><Method><Name>M_EndOfCycle</Name><Comment><![CDATA[ §8.11.1 cycle-complete marker forward; FALSE = stop granted (do not loop)]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize></Method><Method><Name>M_Complete</Name><Comment><![CDATA[ §6.1 one-shot completion forward (finite chains)]]></Comment></Method><Method><Name>M_ReportFromChild</Name><Comment><![CDATA[ §6.9(e) — publish a child's failure WITHOUT adopting it.

 The counterpart of M_RaiseFromChild, for a step that already owns the
 recovery: the child's first-out reaches the alarm ring and the §3.13 chart
 (marked on this step, click-through to the child), but nothing faults and the
 chain keeps the branch it was going to take anyway. Press AUTO N200 is the
 case: the ram not reaching is handled by an operator confirmation and a scrap,
 so stopping there would replace a designed recovery with a hard fault - while
 saying nothing left the failure invisible on the Unit.

 Reported once per visit to the step, so calling it every scan is correct.]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Source</Name><Type Namespace="Fraktal_Core">I_Module</Type><BitSize>64</BitSize></Parameter></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_PressDemoLoadPosition</Name><Comment><![CDATA[ Shared load-safe-position sub-sequence (Core §6.7): ram up, door open, slide
 outside. HOME and CHANGEOVER both embed it as one composite step, passing a
 BaseStepNo window so its detailed progress projects through the Unit's normal
 §6.5 step record. Implemented as a Core §6.8 ST `CASE _step OF` skeleton on
 FB_SequenceBase — the step actions issue child commands only through the §6.1
 handshake (M_TryIssue), and progression rides the shared _retVal via M_Advance.]]></Comment><BitSize>4160</BitSize><ExtendsType Namespace="Fraktal_Core">FB_SequenceBase</ExtendsType><SubItem><Name>_pressRam</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><BitOffs>3968</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_door</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><BitOffs>4032</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_partSlide</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><BitOffs>4096</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><Method><Name>Setup</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Host</Name><Type Namespace="Fraktal_Core">I_SequenceHost</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PressRam</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>Door</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>PartSlide</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Method><Name>M_ChainRun</Name><Comment><![CDATA[ §6.8 ST step skeleton. One M_Step per step, one commit via M_Advance.]]></Comment></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_PressDemoHome</Name><Comment><![CDATA[ HOME mode chain (Core §6.2/§6.8 ST skeleton on FB_SequenceBase): establish the
 shared load-safe position, then complete. Finite (does not loop).]]></Comment><BitSize>8192</BitSize><ExtendsType Namespace="Fraktal_Core">FB_SequenceBase</ExtendsType><SubItem><Name>_outCmd</Name><Type ReferenceTo="true">ST_PneumaticPressOutCmd</Type><BitSize>64</BitSize><BitOffs>3968</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_loadPosition</Name><Type>FB_PressDemoLoadPosition</Type><BitSize>4160</BitSize><BitOffs>4032</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><Method><Name>M_Run</Name></Method><Method><Name>Setup</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Host</Name><Type Namespace="Fraktal_Core">I_SequenceHost</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PressRam</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>Door</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>PartSlide</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>OutCmd</Name><Type ReferenceTo="true">ST_PneumaticPressOutCmd</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_PressDemoChangeover</Name><Comment><![CDATA[ CHANGEOVER mode chain (Core §6.2/§6.8 ST skeleton on FB_SequenceBase): validate
 the selected model, establish the shared load-safe position, then ask the
 operator (§6.11) to confirm tooling/material match before completing. The
 'repeat position' answer restarts the guided move via a backward jump (§6.10).]]></Comment><BitSize>15552</BitSize><ExtendsType Namespace="Fraktal_Core">FB_SequenceBase</ExtendsType><SubItem><Name>_decisionRequest</Name><Type Namespace="Fraktal_Core">ST_DecisionRequest</Type><BitSize>7264</BitSize><BitOffs>3968</BitOffs></SubItem><SubItem><Name>_answer</Name><Type>INT</Type><BitSize>16</BitSize><BitOffs>11232</BitOffs></SubItem><SubItem><Name>_modelSelected</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>11248</BitOffs></SubItem><SubItem><Name>_outCmd</Name><Type ReferenceTo="true">ST_PneumaticPressOutCmd</Type><BitSize>64</BitSize><BitOffs>11264</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_model</Name><Type Namespace="Fraktal_Core" ReferenceTo="true">ST_ModelId</Type><BitSize>64</BitSize><BitOffs>11328</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><SubItem><Name>_loadPosition</Name><Type>FB_PressDemoLoadPosition</Type><BitSize>4160</BitSize><BitOffs>11392</BitOffs><Properties><Property><Name>OPC.UA.DA</Name><Value>0</Value></Property></Properties></SubItem><Method><Name>Setup</Name><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>Host</Name><Type Namespace="Fraktal_Core">I_SequenceHost</Type><BitSize>64</BitSize></Parameter><Parameter><Name>PressRam</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>Door</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>PartSlide</Name><Type Namespace="Fraktal_Modules" ReferenceTo="true">FB_CylinderCM</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>OutCmd</Name><Type ReferenceTo="true">ST_PneumaticPressOutCmd</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter><Parameter><Name>Model</Name><Type Namespace="Fraktal_Core" ReferenceTo="true">ST_ModelId</Type><BitSize>64</BitSize><Properties><Property><Name>ItemType</Name><Value>InOut</Value></Property></Properties></Parameter></Method><Method><Name>OnChainReset</Name><Comment><![CDATA[ §6.8 - the chain's own state on a restart (the base resets the flow state).]]></Comment></Method><Method><Name>M_Run</Name></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>ST_PneumaticPressStationCfg</Name><Comment><![CDATA[ Core §3.8a/§3.8b — what this PRESS is, as opposed to what the current product
 needs. Both members were assessed against one question: does the value change
 when the MODEL changes?

   RequireTwoHandStart came OUT of ST_PneumaticPressParCfg. It was recipe data
   in name only - all four catalog records set it TRUE - and it answers a
   question about the CELL: does this installation's risk assessment demand a
   two-hand start? A model recipe able to switch it off would let a changeover
   quietly remove a required operator protection, which is not a decision a
   product record should be able to take. (The certified two-hand evaluation
   stays in TwinSAFE regardless, §9.8; this flag selects whether the AUTO cycle
   WAITS for it, and can never weaken the safety function itself.)

   StallGuardMs is the step guard for a step that declares no ExpectedTime
   (§6.9). How long a pneumatic motion may take before it counts as stalled is
   a fact about this machine's cylinders and air supply, not about the part.

 SchemaVersion is FIRST and mandatory (§3.8b). Version 0 means never written, so
 a first boot initializes silently; any other unrecognized version means a real
 image was rejected, and FB_ModuleBase.M_RestoreStationCfg reports it for the
 root to annunciate with this Unit's canonical path.]]></Comment><BitSize>64</BitSize><SubItem><Name>SchemaVersion</Name><Type>UINT</Type><Comment><![CDATA[ 0 = never written; 1 = this layout]]></Comment><BitSize>16</BitSize><BitOffs>0</BitOffs></SubItem><SubItem><Name>RequireTwoHandStart</Name><Type>BOOL</Type><Comment><![CDATA[ cell risk-assessment policy, not recipe data]]></Comment><BitSize>8</BitSize><BitOffs>16</BitOffs></SubItem><SubItem><Name>StallGuardMs</Name><Type>UDINT</Type><Comment><![CDATA[ §6.9 step guard when a step declares none]]></Comment><BitSize>32</BitSize><BitOffs>32</BitOffs></SubItem></DataType><DataType><Name>FB_PressDemoAuto</Name><Comment><![CDATA[ AUTO mode chain (Core §6.2/§6.8 ST skeleton on FB_SequenceBase): the continuous
 production cycle — await a fresh two-hand start with part+air present, transfer
 the part in, press for the recipe dwell, return to load position, count the good
 part, and loop until Stop. A Stop requested at the between-cycles wait is honored
 there (M_StopNow) so no phantom cycle is charged. Every child motion goes through
 the §6.1 handshake (M_TryIssue); progression rides the shared _retVal.]]></Comment><BitSize>16192</BitSize><ExtendsType Namespace="Fraktal_Core">FB_SequenceBase</ExtendsType><SubItem><Name>_partReady</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>3968</BitOffs></SubItem><SubItem><Name>_airReady</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>3976</BitOffs></SubItem><SubItem><Name>_startReady</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>3984</BitOffs></SubItem><SubItem><Name>_dwellTwoHandHeld</Name><Type>BOOL</Type><Comment><![CDATA[ N220 named wait: two-hand held through the dwell]]></Comment><BitSize>8</BitSize><BitOffs>3992</BitOffs></SubItem><SubItem><Name>_decisionRequest</Name><Type Namespace="Fraktal_Core">ST_DecisionRequest</Type><Comment><![CDATA[ §6.11 not-reached confirmation]]></Comment><BitSize>7264</BitSize><BitOffs>4000</BitOffs></SubItem><SubItem><Name>_answer</Name><Type>INT</Type><BitSize>16</BitSize><BitOffs>11264</BitOffs></SubItem><SubItem><Name>_ramReached</Name><Type>BOOL</Type><Comment><![CDATA[ N200/N210 named waits]]></Comment><BitSize>8</BitSize><BitOffs>11280</BitOffs></SubItem><SubItem><Name>_failureConfirmed</Name><Type>BOOL</Type><Comment><![CDATA[ N200/N210 named waits]]></Comment><BitSize>8</BitSize><BitOffs>11288</BitOffs></SubItem><SubItem><Name>_twoHandHeldDuringClose</Name><Type>BOOL</Type><Comment><![CDATA[ N180 named wait]]></Comment><BitSize>8</BitSize><BitOffs>11296</BitOffs></SubItem><SubItem><Name>_closeAbortWarned</Name><Type>BOOL</Type><Comment><![CDATA[ N180 §6.9(e) message result]]></Comment><BitSize>8</BitSize><BitOffs>11304</BitOffs></SubItem><SubItem><Name>_ramFailureReported</Name><Type>BOOL</Type><Comment><![CDATA[ N200 §6.9(e) message result]]></Comment><BitSize>8</BitSize><BitOffs>11312</BitOffs></SubItem><SubItem><Name>_partInMachine</Name><Type>BOOL</Type><Comment><![CDATA[ §3.16.3 the part is already received]]></Comment><BitSize>8</BitSize><BitOffs>11320</BitOffs></SubItem><SubItem><Name>_part